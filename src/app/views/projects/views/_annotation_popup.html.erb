<!-- Annotation Popup Overlay -->
<div id="annotation-popup-overlay" data-annotable="<%= annotable?(@project) %>" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: rgba(0,0,0,0.15); z-index: 10000; align-items: center; justify-content: center;" onclick="if(event.target === this) closeAnnotationPopup()">
  <div id="annotation-popup-dialog" style="width: 560px; max-width: 90vw; height: 500px; max-height: 80vh; background-color: white; border-radius: 12px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); display: flex; flex-direction: column; overflow: hidden;">
    <div id="annotation-popup-header" style="display: flex; align-items: center; justify-content: space-between; padding: 12px 20px; border-bottom: 1px solid #e5e7eb; background-color: #f9fafb; cursor: grab; user-select: none; border-radius: 12px 12px 0 0;">
      <div id="annot-popup-title" style="font-size: 15px; font-weight: 600; color: #111827; display: flex; align-items: center;">Annotations</div>
      <button onclick="closeAnnotationPopup()" style="background: none; border: none; cursor: pointer; color: #6b7280; padding: 4px; border-radius: 4px; transition: color 0.2s;" onmouseover="this.style.color='#111827'" onmouseout="this.style.color='#6b7280'">
        <i class="fas fa-times" style="font-size: 18px;"></i>
      </button>
    </div>
    <div id="annot-popup-panel" style="flex: 1; display: flex; flex-direction: column; overflow: hidden;"></div>
  </div>
</div>

<template id="annot-new-tab-template">
  <div style="border: 1px solid #e5e7eb; border-radius: 8px; padding: 10px; background: #fff;">
    <div style="font-size: 13px; font-weight: 600; color: #111827; margin-bottom: 8px;">New annotation</div>
    <div style="display: grid; grid-template-columns: 1fr; gap: 8px;">
      <div>
        <label style="display:block;font-size:12px;color:#374151;margin-bottom:4px;">Annotation type</label>
        <select id="annot-new-annotation-type" style="width:100%;padding: 6px 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px;background:#fff;">__ANNOTATION_TYPE_OPTIONS__</select>
      </div>
      <input type="text" id="annot-new-name-input" placeholder="Name of the annotation" value="__NAME__" style="padding: 6px 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px; background:#fff;" />
      <div style="position:relative;">
        <input type="text" id="annot-new-ontology-input" placeholder="Cell ontology term" style="width:100%;padding: 6px 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px; background:#fff;" />
        <div id="annot-new-ontology-suggestions" style="display:none;position:absolute;top:100%;left:0;right:0;background:#fff;border:1px solid #d1d5db;border-top:none;max-height:160px;overflow-y:auto;z-index:1001;"></div>
      </div>
      <div style="min-height:22px;">__ONTOLOGY_BADGES__</div>
      <div style="position:relative;">
        <input type="text" id="annot-new-up-input" placeholder="Up-regulated gene" style="width:100%;padding: 6px 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px; background:#fff;" />
        <div id="annot-new-up-suggestions" style="display:none;position:absolute;top:100%;left:0;right:0;background:#fff;border:1px solid #d1d5db;border-top:none;max-height:160px;overflow-y:auto;z-index:1001;"></div>
      </div>
      <div style="min-height:22px;">__UP_BADGES__</div>
      <div style="position:relative;">
        <input type="text" id="annot-new-down-input" placeholder="Down-regulated gene" style="width:100%;padding: 6px 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px; background:#fff;" />
        <div id="annot-new-down-suggestions" style="display:none;position:absolute;top:100%;left:0;right:0;background:#fff;border:1px solid #d1d5db;border-top:none;max-height:160px;overflow-y:auto;z-index:1001;"></div>
      </div>
      <div style="min-height:22px;">__DOWN_BADGES__</div>
    </div>
    <textarea id="annot-new-comment-input" placeholder="Comment" style="margin-top: 8px; width: 100%; min-height: 64px; padding: 6px 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px; background:#fff;">__COMMENT__</textarea>
    <!--<div style="margin-top: 8px; font-size: 11px; color: #6b7280;">Use this form as guidance with evidences in the dedicated tab.</div>
    <div style="margin-top: 8px; font-size: 11px; color: #6b7280;">Autocomplete uses the same gene index and ontology search as the original annotation workflow.</div>-->
    <div style="display:flex;flex-direction:column;align-items:flex-start;gap:8px;margin-top:10px;">
      __SUBMIT_SECTION__
    </div>
    __STATUS__
  </div>
</template>

<template id="annot-existing-tab-template">
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
    <div style="font-size: 13px; font-weight: 600; color: #111827;">Existing annotations</div>
    <div style="font-size: 12px; color: #6b7280;">__TOTAL__ total</div>
  </div>
  __CONTENT__
</template>

<template id="annot-evidences-tab-template">
  <div style="font-size: 13px; font-weight: 600; color: #111827; margin-bottom: 8px;">Identify markers</div>
  __CONTENT__
</template>
