<%= form_with model: project_type, class: "space-y-6" do |form| %>
  <% if project_type.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-400/50 dark:bg-red-950/30 dark:text-red-100">
      <p class="font-semibold"><%= pluralize(project_type.errors.count, "error") %> prevented saving:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% project_type.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-4 md:grid-cols-2">
    <div>
      <%= form.label :name, class: "block text-sm font-medium text-gray-700 dark:text-gray-200" %>
      <%= form.text_field :name, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100", placeholder: "Name of the project type" %>
    </div>
    <div>
      <%= form.label :tag, class: "block text-sm font-medium text-gray-700 dark:text-gray-200" %>
      <%= form.text_field :tag, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100", placeholder: "Tag of the project type" %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div>
      <%= form.label :row_label, "Row Label", class: "block text-sm font-medium text-gray-700 dark:text-gray-200" %>
      <%= form.text_field :row_label, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100", placeholder: "Label for rows (e.g., genes)" %>
    </div>
    <div>
      <%= form.label :col_label, "Col Label", class: "block text-sm font-medium text-gray-700 dark:text-gray-200" %>
      <%= form.text_field :col_label, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100", placeholder: "Label for columns (e.g., cells, samples)" %>
    </div>
  </div>

  <div>
    <label class="inline-flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200">
      <%= form.check_box :admin_report_only, class: "rounded border-gray-300 text-gray-900 focus:ring-gray-900" %>
      <span>Only ADMIN_REPORT_EMAILS users may select this type</span>
    </label>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit class: "inline-flex items-center rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-gray-800 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-gray-800 dark:bg-gray-100 dark:text-black dark:hover:bg-gray-200" %>
    <%= link_to "Cancel", project_types_path, class: "text-sm text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-gray-100" %>
  </div>
<% end %>
