<% if @step %>
  <div class="step-results h-full flex flex-col" 
       data-controller="slide-in-form"
       data-slide-in-form-form-url-value="<%= step_results_project_path(@project, step_id: @step.id, show_form: 1, format: :html) %>"
       data-slide-in-form-step-id-value="<%= @step.id %>"
       data-slide-in-form-project-id-value="<%= @project.id %>"
       data-step-id="<%= @step.id %>"
       data-project-id="<%= @project.id %>">
    <% unless @show_form %>
    <!-- Step Results Section -->
    <% if @step.has_std_view && @step.name == 'parsing' %>
      <!-- Render parsing-specific view -->
      <%= render 'projects/views/parsing' %>
    <% end %>
    <% end %>
    
    <!-- Standard Form (when no runs exist) -->
    <% if @show_form %>
      <%= render 'projects/views/std_form' %>
    <% end %>
    
    <% unless @show_form %>
    <!-- Custom Form (when std_form is false for single-run steps) -->
    <% if @show_custom_form %>
      <% custom_form_partial = "projects/views/#{@step.name}_form" %>
      <% begin %>
        <%= render custom_form_partial %>
      <% rescue ActionView::MissingTemplate => e %>
        <!-- Custom form partial not found: <%= custom_form_partial %> -->
      <% end %>
    <% end %>
    
    <!-- Standard Dashboard (for multiple runs) -->
    <% if @show_dashboard %>
      <%= render 'projects/views/std_dashboard' %>
    <% end %>
    
    <!-- Standard Run View (for single run) -->
    <% if @show_view %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 flex flex-col" id="result_summary" style="max-height: calc(100vh - 200px); overflow-y: auto;">
        <div class="border-b border-gray-200 px-6 py-4 sticky top-0 z-10 flex-shrink-0" style="background: linear-gradient(to right, #eff6ff, #eef2ff); background-color: #ffffff;">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
              <%= @step.label.presence || @step.name %> results
            </h3>
            <div class="flex items-center gap-3">
              <!-- New Run Button -->
              <% if @step.has_std_form && @step.multiple_runs %>
                <button type="button" 
                        class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-medium transition-colors cursor-pointer" 
                        data-action="click->slide-in-form#open"
                        style="flex-shrink: 0;">
                  + New run
                </button>
              <% end %>
              <!-- Restart Button -->
              <% if @project_step && @step && !@step.multiple_runs && (@project_step.status_id == 3 || @project_step.status_id == 4) %>
                <button type="button" 
                        class="px-4 py-2 bg-orange-600 hover:bg-orange-700 text-white rounded-md font-medium transition-colors cursor-pointer" 
                        data-controller="restart-step"
                        data-restart-step-project-id-value="<%= @project.id %>"
                        data-restart-step-step-id-value="<%= @step.id %>"
                        data-restart-step-restart-url-value="<%= restart_step_project_path(@project) %>"
                        data-action="click->restart-step#restart"
                        style="flex-shrink: 0;">
                  Restart
                </button>
              <% end %>
            </div>
          </div>
        </div>
        <div class="px-6 py-5 space-y-6 flex-1">
          <%= render 'projects/views/std_run_view' %>
        </div>
      </div>
    <% end %>
    
    <!-- Debug info: Show what display mode is active -->
    <% if @show_dashboard || @show_view || @show_form || @show_custom_form %>
      <div class="mb-3">
        <div class="alert alert-secondary">
          <strong>Step Configuration:</strong> multiple_runs=<%= @step.multiple_runs %>, has_std_view=<%= @step.has_std_view %>, has_std_dashboard=<%= @step.has_std_dashboard %>, has_std_form=<%= @step.has_std_form %> | 
          <strong>Display Flags:</strong> show_dashboard=<%= @show_dashboard %>, show_view=<%= @show_view %>, show_form=<%= @show_form %>, show_custom_form=<%= @show_custom_form %> | 
          <strong>Runs:</strong> <%= @runs ? @runs.size : 0 %>
        </div>
      </div>
    <% end %>

    <!-- Runs Section (fallback if no standard dashboard/view) -->
    <% unless @show_dashboard || @show_view %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 flex flex-col" style="max-height: calc(100vh - 200px); overflow-y: auto;">
        <div class="border-b border-gray-200 px-6 py-4 sticky top-0 z-10 flex-shrink-0" style="background: linear-gradient(to right, #eff6ff, #eef2ff); background-color: #ffffff;">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
              <%= @step.label.presence || @step.name %> results
            </h3>
            <div class="flex items-center gap-3">
              <!-- New Run Button -->
              <% if @step.has_std_form && @step.multiple_runs %>
                <button type="button" 
                        class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-medium transition-colors cursor-pointer" 
                        data-action="click->slide-in-form#open"
                        style="flex-shrink: 0;">
                  + New run
                </button>
              <% end %>
            </div>
          </div>
        </div>
        <div class="flex-1 flex flex-col min-h-0">
          <div class="px-6 py-5 flex-shrink-0">
            <div class="runs-section">
              <h4 class="mb-4 text-sm font-semibold text-gray-700 uppercase tracking-wide">
                <i class="fas fa-list me-2"></i>Runs
                <span class="badge badge-info"><%= @runs.count %></span>
              </h4>
            </div>
          </div>
        
        <% if @runs.any? %>
          <%# Load std_methods for method labels %>
          <% unless defined?(@h_std_methods) && @h_std_methods %>
            <% std_method_ids = @runs.map(&:std_method_id).compact.uniq %>
            <% @h_std_methods = {} %>
            <% StdMethod.where(id: std_method_ids).each { |m| @h_std_methods[m.id] = m } if std_method_ids.any? %>
          <% end %>
          
          <div class="flex-1 min-h-0 px-6 pb-5 overflow-x-hidden">
            <table class="w-full divide-y divide-gray-200 bg-white" style="table-layout: auto;">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-16">#</th>
                  <% if admin? %>
                    <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-20">ID</th>
                  <% end %>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Method</th>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider max-w-xs">Parameters</th>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-24">Status</th>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-32">Created</th>
                  <th scope="col" class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider w-32">Actions</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @runs.each do |run| %>
                  <% run_status = case run.status_id
                                  when 1 then { name: 'waiting', class: 'warning', bg: 'bg-yellow-100', text: 'text-yellow-800' }
                                  when 2 then { name: 'running', class: 'info', bg: 'bg-blue-100', text: 'text-blue-800' }
                                  when 3 then { name: 'complete', class: 'success', bg: 'bg-green-100', text: 'text-green-800' }
                                  when 4 then { name: 'failed', class: 'danger', bg: 'bg-red-100', text: 'text-red-800' }
                                  else { name: 'unknown', class: 'secondary', bg: 'bg-gray-100', text: 'text-gray-800' }
                                  end %>
                  <% std_method = (@h_std_methods && run.std_method_id) ? @h_std_methods[run.std_method_id] : nil %>
                  <% method_label = std_method ? (std_method.label.presence || std_method.name.presence || 'N/A') : 'N/A' %>
                  <%# Parse run attributes for parameters %>
                  <% h_run_attrs = run.attrs_json.present? ? Basic.safe_parse_json(run.attrs_json, {}) : {} %>
                  <% params_display = h_run_attrs.map { |k, v| "#{k}: #{v}" }.join(", ") %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-3 py-4 whitespace-nowrap">
                      <div class="text-sm font-semibold text-gray-900">#<%= run.num || run.id %></div>
                    </td>
                    <% if admin? %>
                      <td class="px-3 py-4 whitespace-nowrap">
                        <div class="text-xs text-gray-600 font-mono"><%= run.id %></div>
                      </td>
                    <% end %>
                    <td class="px-3 py-4">
                      <div class="text-sm text-gray-900 truncate" style="max-width: 120px;" title="<%= method_label %>"><%= method_label %></div>
                    </td>
                    <td class="px-3 py-4">
                      <div class="text-xs text-gray-600">
                        <% if params_display.present? %>
                          <div class="truncate" style="max-width: 150px;" title="<%= params_display %>">
                            <%= truncate(params_display, length: 35) %>
                          </div>
                        <% else %>
                          <span class="text-gray-400">-</span>
                        <% end %>
                      </div>
                    </td>
                    <td class="px-3 py-4 whitespace-nowrap">
                      <div class="flex flex-col gap-1">
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= run_status[:bg] %> <%= run_status[:text] %>">
                          <%= run_status[:name].humanize %>
                        </span>
                        <% if run.status_id == 4 && run.error.present? %>
                          <div class="text-xs text-red-600 truncate" style="max-width: 120px;" title="<%= run.error %>">
                            <i class="fas fa-exclamation-triangle"></i>
                          </div>
                        <% end %>
                      </div>
                    </td>
                    <td class="px-3 py-4 whitespace-nowrap">
                      <div class="text-xs text-gray-900">
                        <% if run.created_at %>
                          <%= run.created_at.strftime("%Y-%m-%d<br>%H:%M").html_safe %>
                        <% else %>
                          <span class="text-gray-400">N/A</span>
                        <% end %>
                      </div>
                    </td>
                    <td class="px-3 py-4 whitespace-nowrap text-right text-sm font-medium">
                      <div class="flex items-center justify-end gap-1.5">
                        <%= link_to run_path(run), class: 'inline-flex items-center px-2 py-1 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500', title: 'View' do %>
                          <i class="fas fa-eye"></i>
                        <% end %>
                        <% if editable?(@project) %>
                          <%= button_to run_path(run, format: :json), 
                              method: :delete,
                              remote: true,
                              form: {
                                data: {
                                  controller: 'delete-run',
                                  action: 'submit->delete-run#deleteRun',
                                  'delete-run-step-id-value': @step.id,
                                  'delete-run-run-num-value': (run.num || run.id).to_s
                                }
                              },
                              class: 'inline-flex items-center px-2 py-1 border border-red-300 shadow-sm text-xs font-medium rounded text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500', 
                              title: 'Delete' do %>
                            <i class="fas fa-trash"></i>
                          <% end %>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                  <% if run.status_id == 4 && run.error.present? %>
                    <tr class="bg-red-50">
                      <td colspan="<%= admin? ? 7 : 6 %>" class="px-3 py-4">
                        <div class="bg-white border border-red-200 rounded-lg p-4">
                          <div class="flex items-start">
                            <i class="fas fa-exclamation-circle text-red-600 mt-0.5 mr-3"></i>
                            <div class="flex-1">
                              <strong class="text-red-800 text-sm block mb-2">Error Details:</strong>
                              <div class="text-red-700 text-xs font-mono whitespace-pre-wrap break-words">
                                <%= run.error %>
                              </div>
                            </div>
                          </div>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="flex-1 flex items-center justify-center">
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 text-center">
              <i class="fas fa-info-circle text-blue-600 mb-2"></i>
              <p class="text-blue-800 mb-0">No runs found for this step.</p>
            </div>
          </div>
        <% end %>
          </div>
        </div>
      </div>
    <% end %>
    <% end %>
    
    <!-- Slide-in Form Panel -->
    <div data-slide-in-form-target="overlay" 
         class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden transition-opacity duration-300"
         data-action="click->slide-in-form#overlayClick"
         style="display: none;"></div>
    
    <div data-slide-in-form-target="panel" 
         class="fixed top-0 right-0 h-full w-full max-w-2xl bg-white shadow-2xl z-50 hidden overflow-y-auto transition-transform duration-300 ease-out"
         style="display: none; transform: translateX(100%);">
      <div class="sticky top-0 bg-white border-b border-gray-200 px-6 py-4 z-10 flex items-center justify-between" style="background: linear-gradient(to right, #eff6ff, #eef2ff); background-color: #ffffff;">
        <h3 class="text-lg font-semibold text-gray-900">
          New <%= @step.label.presence || @step.name.humanize %>
        </h3>
        <button type="button" 
                class="text-gray-500 hover:text-gray-700 transition-colors"
                data-action="click->slide-in-form#close">
          <i class="fas fa-times text-xl"></i>
        </button>
      </div>
      <div data-slide-in-form-target="content" class="p-6">
        <!-- Form content will be loaded here -->
      </div>
    </div>
  </div>

<% else %>
  <div class="alert alert-warning">
    <i class="fas fa-exclamation-triangle me-2"></i>Step not found.
  </div>
<% end %>

