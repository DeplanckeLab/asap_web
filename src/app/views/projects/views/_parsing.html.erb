<%# Parsing Status Section (when waiting or running, before results are available) %>
<%# Also show if status is complete but results are missing (after restart) %>
<%# Show status section if no results OR if results exist but have displayed_error (so we show status + error) %>
<%# Also show if parsing_run exists with status_id 4 (failed) even if @results is nil %>
<% can_reset_parsing = @step && !@step.multiple_runs && ((@project_step && [3, 4].include?(@project_step.status_id)) || (@parsing_run && [3, 4].include?(@parsing_run.status_id))) %>
<% if @step && @step.name == 'parsing' && (!@results || (@results && @results['displayed_error']) || (@parsing_run && @parsing_run.status_id == 4)) %>
  <%# Always show something when there are no results %>
  <%# Use ONLY the run's status_id, matching the left panel logic %>
  <% status_id = @parsing_run&.status_id %>
  <%# Determine display name: use std_method label if available (e.g. "Integration"), otherwise "Parsing" %>
  <% step_display_name = if @parsing_run&.std_method
       @parsing_run.std_method.label.presence || @parsing_run.std_method.name.titleize
     else
       "Parsing"
     end %>
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-6 overflow-hidden"
       data-parsing-status-panel="true"
       data-current-status-id="<%= status_id || '' %>">
    <div class="px-6 py-8 text-center">
      <% if status_id.nil? || status_id == 1 %>
        <div class="flex flex-col items-center justify-center"
             <% if @parsing_run && @parsing_run.slurm_job_id %>
               data-controller="queue-position"
               data-queue-position-run-id-value="<%= @parsing_run.id %>"
               data-queue-position-slurm-job-id-value="<%= @parsing_run.slurm_job_id %>"
               data-queue-position-project-id-value="<%= @project.key %>"
               <% if @parsing_run.submitted_at %>
                 data-queue-position-submitted-at-value="<%= @parsing_run.submitted_at.iso8601 %>"
               <% end %>
             <% end %>>
          <i class="fas fa-clock text-yellow-500 text-5xl mb-4"></i>
          <h3 class="text-xl font-semibold text-gray-900 mb-2"><%= step_display_name %> is waiting</h3>
          <p class="text-gray-600 mb-4">The <%= step_display_name.downcase %> job is queued and will start shortly.</p>
          <% if @parsing_run && @parsing_run.slurm_job_id %>
            <% if @parsing_run.submitted_at %>
              <div class="text-sm text-gray-600 mb-3">
                <span class="font-medium">Waiting time:</span>
                <span data-queue-position-target="waitingTime" class="ml-2 font-mono">--:--</span>
              </div>
            <% end %>
            <div data-queue-position-target="queueInfo" class="text-gray-600">
              <span>Position in the queue: </span>
              <span data-queue-position-target="position" class="inline-block">
                <i class="fas fa-spinner fa-spin"></i>
              </span>
            </div>
            <div data-queue-position-target="emptyQueue" class="text-gray-600 hidden">
              Nothing in the queue, will start shortly...
            </div>
          <% end %>
        </div>
      <% elsif status_id == 2 %>
        <div class="flex flex-col items-center justify-center" 
             data-controller="parsing-timer"
             <% if @parsing_run&.start_time %>
               data-parsing-timer-start-time-value="<%= @parsing_run.start_time.iso8601 %>"
             <% end %>
             <% if @parsing_run&.pred_process_duration %>
               data-parsing-timer-expected-duration-value="<%= @parsing_run.pred_process_duration %>"
             <% end %>>
          <i class="fas fa-spinner fa-spin text-blue-500 text-5xl mb-4"></i>
          <h3 class="text-xl font-semibold text-gray-900 mb-2"><%= step_display_name %> is running</h3>
          <p class="text-gray-600 mb-4">The <%= step_display_name.downcase %> job is currently processing your data. Results will appear here when complete.</p>
          
          <%# Time counter section %>
          <div class="mt-4 space-y-2">
            <div class="text-sm text-gray-700">
              <span class="font-medium">Elapsed time:</span>
              <span data-parsing-timer-target="elapsedTime" class="ml-2 font-mono">--:--:--</span>
            </div>
            <% if @parsing_run&.pred_process_duration %>
              <div class="text-sm text-gray-600">
                <span class="font-medium">Expected time:</span>
                <span data-parsing-timer-target="expectedTime" class="ml-2 font-mono"><%= duration(@parsing_run.pred_process_duration.to_i) %></span>
              </div>
            <% end %>
          </div>

          <div class="mt-6">
            <% if editable?(@project) %>
              <%= button_to 'Stop',
                    stop_parsing_project_path(@project),
                    method: :post,
                    form: { data: { turbo_confirm: 'Stop parsing now? The run will be marked as failed.' } },
                    class: 'px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-md font-medium text-sm transition-colors cursor-pointer' %>
            <% else %>
              <button type="button" disabled class="px-4 py-2 bg-gray-300 text-gray-500 rounded-md font-medium text-sm cursor-not-allowed" title="You need edit rights to stop parsing">
                Stop
              </button>
            <% end %>
          </div>
        </div>
      <% elsif status_id == 3 %>
        <%# Status says complete but no results - likely after restart %>
        <div class="flex flex-col items-center justify-center">
          <i class="fas fa-clock text-yellow-500 text-5xl mb-4"></i>
          <h3 class="text-xl font-semibold text-gray-900 mb-2"><%= step_display_name %> is waiting</h3>
          <p class="text-gray-600 mb-4">The <%= step_display_name.downcase %> job has been restarted and is queued. Results will appear here when complete.</p>
        </div>
      <% elsif status_id == 4 %>
        <%# Parsing failed - show error message %>
        <div class="flex flex-col items-center justify-center">
          <i class="fas fa-exclamation-circle text-red-500 text-5xl mb-4"></i>
          <h3 class="text-xl font-semibold text-red-900 mb-2"><%= step_display_name %> Failed</h3>
          <p class="text-gray-600 mb-4">
            <% if @results && @results['displayed_error'] %>
              <%# Show error from output.json if available %>
              <% if @results['displayed_error'].is_a?(Array) %>
                <%= @results['displayed_error'].first %>
              <% else %>
                <%= @results['displayed_error'] %>
              <% end %>
            <% elsif @parsing_run && @parsing_run.error.present? %>
              <%= @parsing_run.error %>
            <% else %>
              The parsing job failed. Please check the logs or try restarting the parsing step.
            <% end %>
          </p>
          <% if can_reset_parsing %>
            <% if editable?(@project) %>
              <%= link_to reset_parsing_project_path(@project),
                    class: "mt-2 px-3 py-1.5 bg-orange-600 hover:bg-orange-700 text-white rounded-md font-medium text-sm transition-colors cursor-pointer inline-block" do %>
                <i class="fas fa-redo sm:mr-1"></i><span class="hidden sm:inline"> Reset</span>
              <% end %>
            <% else %>
              <span class="mt-2 px-3 py-1.5 bg-gray-300 text-gray-500 rounded-md font-medium text-sm cursor-not-allowed inline-block" title="You need edit rights to reset parsing">
                <i class="fas fa-redo sm:mr-1"></i><span class="hidden sm:inline"> Reset</span>
              </span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <%# Fallback for any other status (including nil project_step) %>
        <div class="flex flex-col items-center justify-center">
          <i class="fas fa-clock text-yellow-500 text-5xl mb-4"></i>
          <h3 class="text-xl font-semibold text-gray-900 mb-2"><%= step_display_name %> is waiting</h3>
          <p class="text-gray-600 mb-4">The <%= step_display_name.downcase %> step is being initialized. Results will appear here when ready.</p>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%# Parsing Results Section %>
<% if @step && @step.name == 'parsing' && @results && !@results['displayed_error'] && (@parsing_run.nil? || @parsing_run.status_id == 3) %>
  <style>
    [data-step-selector-target="content"] > * {
      max-width: 100% !important;
      width: 100% !important;
      box-sizing: border-box !important;
    }
    #result_summary, #result_summary * {
      max-width: 100% !important;
      box-sizing: border-box !important;
    }
    #result_summary {
      overflow-x: hidden !important;
      width: 100% !important;
      max-width: 100% !important;
    }
  </style>
  <div class="bg-white rounded-lg shadow-sm flex flex-col" id="result_summary" style="max-height: calc(100vh - 200px); overflow-y: auto; overflow-x: hidden !important; max-width: 100% !important; box-sizing: border-box !important; min-width: 0; width: 100% !important;">
    <div class="border-b border-gray-200 px-6 py-4 sticky top-0 z-10 flex-shrink-0" style="background: linear-gradient(to right, #eff6ff, #eef2ff); background-color: #ffffff;">
      <div class="flex items-center justify-between min-w-0">
        <div class="flex items-center gap-3 min-w-0 flex-1">
          <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2 min-w-0 truncate">
            Parsing results
          </h3>
          <% if @parsing_run && @parsing_run.status_id %>
            <% status_name = @parsing_run.status&.name&.humanize || 'Unknown' %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= case @parsing_run.status_id
                                                                                                        when 1 then 'bg-yellow-100 text-yellow-800'
                                                                                                        when 2 then 'bg-blue-100 text-blue-800'
                                                                                                        when 3 then 'bg-green-100 text-green-800'
                                                                                                        when 4 then 'bg-red-100 text-red-800'
                                                                                                        else 'bg-gray-100 text-gray-800'
                                                                                                        end %>">
              <%= status_name %>
            </span>
          <% end %>
          
        <!--  <% if @parsing_warnings && @parsing_warnings.any? %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
              <i class="fas fa-exclamation-triangle mr-1"></i>
              <%= @parsing_warnings.size == 1 ? 'Warning' : "#{@parsing_warnings.size} Warnings" %>
            </span>
          <% end %>
          <% if @parsing_errors && @parsing_errors.any? %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
              <i class="fas fa-exclamation-circle mr-1"></i>
              <%= @parsing_errors.size == 1 ? 'Error' : "#{@parsing_errors.size} Errors" %>
            </span>
          <% end %>-->
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
          <!-- Reset Button -->
          <% if can_reset_parsing %>
            <% if editable?(@project) %>
              <%= link_to reset_parsing_project_path(@project),
                    class: "px-3 py-1.5 bg-orange-600 hover:bg-orange-700 text-white rounded-md font-medium text-sm transition-colors cursor-pointer inline-block",
                    style: "flex-shrink: 0;" do %>
                <i class="fas fa-redo sm:mr-1"></i><span class="hidden sm:inline"> Reset</span>
              <% end %>
            <% else %>
              <span class="px-3 py-1.5 bg-gray-300 text-gray-500 rounded-md font-medium text-sm cursor-not-allowed inline-block" style="flex-shrink: 0;" title="You need edit rights to reset parsing">
                <i class="fas fa-redo sm:mr-1"></i><span class="hidden sm:inline"> Reset</span>
              </span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
    <div id="run_metadata_sticky_parsing" class="sticky z-10 flex-shrink-0 bg-white" style="top: 73px;">
      <%= render partial: 'projects/views/run_metadata', locals: { run: @parsing_run, results: @results, queue_position: @queue_position } %>
    </div>
    <% if @parsing_run %>
      <div class="px-6 pt-2">
        <%# render partial: 'runs/run_information', locals: { run: @parsing_run, step: @step, std_method: @std_method } %>
      </div>
    <% end %>
    <div class="px-6 py-5 space-y-6 flex-1 min-w-0 overflow-x-hidden">

      <!-- Warnings and Errors -->


      <% if @parsing_errors && @parsing_errors.any? %>
        <% @parsing_errors.each do |error| %>
          <div class="alert alert-danger flex items-start gap-3 min-w-0">
            <i class="fas fa-exclamation-circle text-red-600 mt-0.5 flex-shrink-0"></i>
            <span class="min-w-0 break-words"><%= error %></span>
          </div>
        <% end %>
      <% end %>

      <% if @parsing_warnings && @parsing_warnings.any? %>
        <% @parsing_warnings.each do |warning| %>
          <div class="alert alert-warning flex items-start gap-3 min-w-0">
            <i class="fas fa-exclamation-triangle text-yellow-600 mt-0.5 flex-shrink-0"></i>
            <span class="min-w-0 break-words"><%= warning %></span>
          </div>
        <% end %>
      <% end %>

      <% if @parsing_infos && @parsing_infos.any? %>
        <% @parsing_infos.each do |info| %>
          <div class="alert alert-info flex items-start gap-3 min-w-0">
            <i class="fas fa-info-circle text-blue-600 mt-0.5 flex-shrink-0"></i>
            <span class="min-w-0 break-words"><%= info %></span>
          </div>
        <% end %>
      <% end %>

      <!-- Parameters (for non-LOOM/H5_10x/MEX formats) -->
      <% if @results && !['LOOM', 'H5_10x', 'MEX'].include?(@results["detected_format"]) && @project.parsing_attrs_json %>
        <% h_attrs = Basic.safe_parse_json(@project.parsing_attrs_json, {}) %>
        <div class="pt-4 relative overflow-hidden">
          <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3 flex items-center gap-2">
            <i class="fas fa-cog text-gray-500"></i>
            Parameters
          </h4>
          <!-- File Format - Right Floating -->
          <div class="absolute top-4 right-6 max-w-[calc(100%-3rem)] overflow-hidden">
            <% if @h_formats && @results && @results["detected_format"] && @h_formats[@results["detected_format"]] %>
              <%= raw display_file_format(@h_formats[@results["detected_format"]]) %>
            <% elsif @results && @results["detected_format"] %>
              <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-md text-sm font-medium whitespace-nowrap"><%= @results["detected_format"] %></span>
            <% end %>
          </div>
          <div class="flex flex-wrap gap-2 items-center">
            <% h_delimiter = {"\\t" => 'Tab', "\t" => "Tab", " " => "Space", "," => "Comma", ":" => "Colon"} %>
            <% selected_dataset = h_attrs['sel_name'].presence || h_attrs['sel'].presence %>
            <% if selected_dataset %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                Dataset: <%= selected_dataset %>
              </span>
            <% end %>
            <% if h_attrs['delimiter'] && h_attrs['delimiter'] != '' %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                Delimiter: <%= h_delimiter[h_attrs['delimiter']] || h_attrs['delimiter'] %>
              </span>
            <% end %>
            <% h_gene_name_col = {"0" => "First", "first" => "First", "-1" => "Last", "last" => "Last", "NA" => "None", 'none' => "None"} %>
            <% if h_attrs['gene_name_col'] %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                Gene name column: <%= h_gene_name_col[h_attrs['gene_name_col']] || h_attrs['gene_name_col'] %>
              </span>
            <% end %>
            <% if h_attrs['skip_line'] %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                Skip lines: <%= h_attrs['skip_line'] %>
              </span>
            <% end %>
            <% if h_attrs['has_header'] %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                Has header: <%= (h_attrs['has_header'] == "1" || h_attrs['has_header'] == true) ? 'Yes' : 'No' %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Integration section (if applicable) -->
      <% if @project.parsing_attrs_json %>
        <% h_attrs = Basic.safe_parse_json(@project.parsing_attrs_json, {}) %>
        <% if h_attrs['integrate_batch_paths'] %>
          <div class="border-t border-gray-200 pt-4">
            <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-4 flex items-center gap-2">
              <i class="fas fa-layer-group text-gray-500"></i>
              Integration
            </h4>
            <% integrated_projects = Project.where(key: h_attrs['integrate_batch_paths'].keys).all %>
            <div class="bg-gray-50 rounded-lg p-4 space-y-4">
              <div class="flex items-center justify-between py-2 border-b border-gray-200">
                <span class="text-sm font-medium text-gray-700">Number of PCs taken into account</span>
                <span class="text-sm text-gray-900 font-semibold"><%= h_attrs["integrate_n_pcs"] %></span>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-700 mb-3">Integrated projects</p>
                <div class="overflow-x-auto max-w-full w-full">
                  <table id="integration_projects" class="w-full divide-y divide-gray-200" style="table-layout: auto; max-width: 100%;">
                    <thead class="bg-gray-100">
                      <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Project key</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Project name</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Batch metadata</th>
                      </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                      <% integrated_projects.each do |p| %>
                        <tr class="hover:bg-gray-50">
                          <td class="px-4 py-3 text-sm text-gray-900"><%= p.key %></td>
                          <td class="px-4 py-3 text-sm text-gray-900"><%= p.name %></td>
                          <td class="px-4 py-3 text-sm text-gray-900">
                            <%= (h_attrs['integrate_batch_paths'][p.key] == 'null') ? 'None' : h_attrs['integrate_batch_paths'][p.key] %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>

      <!-- Output Summary -->
      <div class="border-t border-gray-200 pt-4">
        <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-2 flex items-center gap-2">
          <i class="fas fa-chart-bar text-gray-500"></i>
          Output summary
        </h4>
        <div class="flex flex-wrap gap-3">
          <% if @results['nber_rows'] %>
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-blue-50 border border-blue-200 rounded-lg">
              <i class="fas fa-dna text-blue-600"></i>
              <span class="text-sm font-medium text-blue-900"><%= row_label(@project).capitalize %>: <span class="font-bold"><%= @results['nber_rows'] %></span></span>
            </div>
          <% end %>
          <% if @results['nber_cols'] %>
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-purple-50 border border-purple-200 rounded-lg">
              <i class="fas fa-circle text-purple-600"></i>
              <span class="text-sm font-medium text-purple-900"><%= col_label(@project).capitalize %>: <span class="font-bold"><%= @results['nber_cols'] %></span></span>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Validation Success Messages -->
      <% if @results %>
        <% 
          nber_not_found_genes = @results['nber_not_found_genes']
          has_success_messages = false
          # Check if any success messages should be displayed
          if (@results['is_count_table'] == 1 || @results['is_count_table'] == true) ||
             (nber_not_found_genes.nil? || nber_not_found_genes == 0) && @results['nber_rows']
            has_success_messages = true
          end
        %>
        <% if has_success_messages %>
          <div class="pt-4 space-y-3">
            <!-- Count Matrix Status -->
            <% if @results['is_count_table'] == 1 || @results['is_count_table'] == true %>
              <div class="alert alert-success flex items-start gap-3 min-w-0">
                <i class="fas fa-check-circle text-green-600 mt-0.5 flex-shrink-0"></i>
                <span class="min-w-0 break-words">The original matrix contains only counts</span>
              </div>
            <% end %>

            <!-- Ensembl Mapping Status -->
            <% if (nber_not_found_genes.nil? || nber_not_found_genes == 0) && @results['nber_rows'] %>
              <div class="alert alert-success flex items-start gap-3 min-w-0">
                <i class="fas fa-check-circle text-green-600 mt-0.5 flex-shrink-0"></i>
                <span class="min-w-0 break-words">All <strong><%= @results['nber_rows'] %></strong> <%= row_label(@project) %> were found in Ensembl</span>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <!-- Results Files -->
      <div class="border-t border-gray-200 pt-4">
        <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3 flex items-center gap-2">
          <i class="fas fa-download text-gray-500"></i>
          Download Results
        </h4>
        <div class="flex flex-wrap gap-3">
          <% project_dir = Pathname.new(ENV.fetch('USER_DATA_DIR')) + @project.user_id.to_s + @project.key %>
          <% loom_file = project_dir + 'parsing' + 'output.loom' %>
          <% if File.exist?(loom_file) && exportable?(@project) %>
            <%= link_to(get_file_project_path(@project, step: 'parsing', filename: 'output.loom'), 
                target: '_blank',
                class: 'inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors') do %>
              <i class="fas fa-file"></i>
              <span>Loom file</span>
              <i class="fas fa-external-link-alt text-xs"></i>
            <% end %>
            <span class="link_to_loom_tuto inline-flex items-center justify-center w-6 h-6 rounded-full bg-blue-100 text-blue-600 hover:bg-blue-200 cursor-pointer transition-colors">
              <i class="fas fa-info-circle text-xs"></i>
            </span>
          <% end %>
          <% if admin? %>
            <% json_file = project_dir + 'parsing' + 'output.json' %>
            <% if File.exist?(json_file) && exportable?(@project) %>
              <%= link_to(get_file_project_path(@project, step: 'parsing', filename: 'output.json'), 
                  target: '_blank',
                  class: 'inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors') do %>
                <i class="fas fa-file"></i>
                <span>JSON file</span>
                <i class="fas fa-external-link-alt text-xs"></i>
              <% end %>
            <% end %>
            <% log_file = project_dir + 'parsing' + 'output.log' %>
            <% if File.exist?(log_file) && exportable?(@project) %>
              <%= link_to(get_file_project_path(@project, step: 'parsing', filename: 'output.log'), 
                  target: '_blank',
                  class: 'inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors') do %>
                <i class="fas fa-file-alt"></i>
                <span>Log file</span>
                <i class="fas fa-external-link-alt text-xs"></i>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
       <% if @parsing_run %>
      
      <%# Admin debug card - show run data in JSON format %>
      <% if admin? && @parsing_run %>
        <div class="bg-yellow-50 border-t border-yellow-200 px-6 py-4 mt-4 overflow-x-hidden">
          <div class="mb-2 min-w-0">
            <h4 class="text-sm font-semibold text-yellow-900 mb-2">Debug: Run Data (Admin Only)</h4>
            <div class="bg-white border border-yellow-300 rounded p-3 overflow-x-auto overflow-y-auto max-h-96 max-w-full">
              <pre class="text-xs text-gray-800 whitespace-pre-wrap break-words max-w-full overflow-x-auto"><code class="block max-w-full overflow-x-auto"><%= JSON.pretty_generate(@parsing_run.as_json) %></code></pre>
            </div>
          </div>
        </div>
      <% end %>
      <% end %>
    </div>
  </div>
  
  <%= javascript_tag do %>
    <% project_dir = Pathname.new(ENV.fetch('USER_DATA_DIR')) + @project.user_id.to_s + @project.key %>
    <% loom_file = project_dir + 'parsing' + 'output.loom' %>
    <% if File.exist?(loom_file) && exportable?(@project) %>
      $(".link_to_loom_tuto").click(function(e){
        var url = '<%= tutorial_home_index_path(t: 'loom') rescue '#' %>'
        var win = window.open(url, '_blank');
        if (win) win.focus();
        e.stopPropagation();
        e.preventDefault();
        return false;
      })
    <% end %>
    
    <% if @project.parsing_attrs_json %>
      <% h_attrs = Basic.safe_parse_json(@project.parsing_attrs_json, {}) %>
      <% if h_attrs['integrate_batch_paths'] %>
        if (typeof $.fn.DataTable !== 'undefined') {
          $("#integration_projects").DataTable()
        }
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%# Parsing Error Display (separate conditional so it always shows when there's an error) %>
<% if @step && @step.name == 'parsing' && @results && @results['displayed_error'] %>
  <!-- Parsing Error Display -->
  <div class="bg-white rounded-lg shadow-sm border border-red-200 mb-6 overflow-hidden w-full max-w-full" style="width: 100%; max-width: 100%; min-width: 0; overflow-x: hidden; box-sizing: border-box;">
    <div class="bg-gradient-to-r from-red-50 to-pink-50 border-b border-red-200 px-6 py-4 overflow-x-hidden">
      <div class="flex items-center justify-between min-w-0">
        <h3 class="text-lg font-semibold text-red-900 flex items-center gap-2 min-w-0 truncate">
          <i class="fas fa-exclamation-circle text-red-600 flex-shrink-0"></i>
          Parsing Error
        </h3>
        <% if can_reset_parsing %>
          <% if editable?(@project) %>
            <%= link_to reset_parsing_project_path(@project),
                  class: "px-3 py-1.5 bg-orange-600 hover:bg-orange-700 text-white rounded-md font-medium text-sm transition-colors cursor-pointer inline-block",
                  style: "flex-shrink: 0;" do %>
              <i class="fas fa-redo sm:mr-1"></i><span class="hidden sm:inline"> Reset</span>
            <% end %>
          <% else %>
            <span class="px-3 py-1.5 bg-gray-300 text-gray-500 rounded-md font-medium text-sm cursor-not-allowed inline-block" style="flex-shrink: 0;" title="You need edit rights to reset parsing">
              <i class="fas fa-redo sm:mr-1"></i><span class="hidden sm:inline"> Reset</span>
            </span>
          <% end %>
        <% end %>
      </div>
    </div>
    <div class="px-6 py-5 overflow-x-hidden min-w-0">
      <div class="bg-red-50 border border-red-200 rounded-md p-4 overflow-x-hidden min-w-0">
        <% if @results['displayed_error'].is_a?(Array) %>
          <% @results['displayed_error'].each do |error| %>
            <p class="text-red-800 mb-2 break-words min-w-0" title="<%= error %>"><%= error %></p>
          <% end %>
        <% else %>
          <p class="text-red-800 break-words min-w-0"><%= @results['displayed_error'] %></p>
        <% end %>
        <% if admin? && @results['original_error'] %>
          <div class="mt-3 pt-3 border-t border-red-300 overflow-x-auto">
            <p class="text-sm text-red-600 font-mono break-words whitespace-pre-wrap"><%= @results['original_error'] %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

