<div class="flex flex-col h-full" data-guided-tour="project-data-main" data-controller="data-view" data-data-view-project-id-value="<%= @project.key %>">
  <!-- Header -->
  <div class="mb-4 flex-shrink-0">
    <h2 class="text-2xl font-bold text-gray-900">Data summary</h2>
  </div>

  <!-- Loom File Selector for Narrow Screens (Mobile/Tablet) -->
  <% if @available_loom_files && @available_loom_files.any? %>
    <div class="mb-4 lg:hidden relative" data-controller="dropdown">
      <button type="button" 
              class="w-full bg-white rounded-lg shadow-sm border border-gray-200 px-4 py-3 text-left flex items-center justify-between"
              style="border-left: 4px solid #007bff !important; border-top-left-radius: 0.5rem; border-bottom-left-radius: 0.5rem;"
              data-action="click->dropdown#toggle"
              data-dropdown-target="button">
        <div class="flex items-center flex-1 min-w-0">
          <span class="font-semibold text-gray-900 truncate">
            <%= @selected_loom_file ? loom_file_label(@selected_loom_file) : 'Select loom file' %>
          </span>
        </div>
        <i class="fas fa-chevron-down ml-3 text-gray-400 flex-shrink-0" data-dropdown-target="icon"></i>
      </button>
      
      <div class="hidden absolute top-full left-0 right-0 mt-1 bg-white rounded-lg shadow-lg border border-gray-200 max-h-96 overflow-y-auto z-50" 
           data-dropdown-target="menu">
        <div>
          <% @available_loom_files.each do |filepath| %>
            <% is_selected = @selected_loom_file == filepath %>
            <% download_url = loom_file_download_url(filepath) %>
            <div class="flex items-center px-4 py-3 border-b border-gray-200 <%= is_selected ? 'bg-blue-50' : 'bg-white hover:bg-gray-50' %>"
                 style="<%= is_selected ? 'border-left: 4px solid #007bff !important;' : 'border-left: 4px solid transparent;' %>">
              <div class="flex-grow cursor-pointer"
                   data-action="click->dropdown#close click->data-view#selectLoomFile"
                   data-loom-file="<%= filepath %>"
                   data-data-type="<%= @selected_data_type %>">
                <span class="<%= is_selected ? 'text-blue-900 font-semibold' : 'text-gray-900' %> truncate">
                  <%= loom_file_label(filepath) %>
                </span>
              </div>
              <% if download_url %>
                <div class="flex-shrink-0 ml-3">
                  <%= link_to download_url, 
                      target: '_blank',
                      class: 'inline-flex items-center justify-center w-8 h-8 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-colors',
                      onclick: 'event.stopPropagation();',
                      title: 'Download loom file' do %>
                    <i class="fas fa-download"></i>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Two Column Layout: Loom Files Panel (Left) and Data Content (Right) -->
  <div class="flex flex-row gap-4 flex-1 min-h-0">
    <!-- Left Panel: Loom Files Navigation (Hidden on narrow screens) -->
    <div class="hidden lg:flex w-64 flex-shrink-0 flex flex-col min-h-0" data-guided-tour="data-loom-files-panel">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 flex flex-col h-full overflow-hidden">
        <div class="flex flex-col h-full">
          <div class="bg-gray-600 text-white px-4 py-3 border-b-2 border-gray-700 flex-shrink-0">
            <h5 class="mb-0 font-bold text-lg flex items-center gap-2">
              <i class="fas fa-folder-open"></i>
              Loom Files
            </h5>
          </div>
          <div class="flex-1 overflow-y-auto">
            <% if @available_loom_files && @available_loom_files.any? %>
              <% @available_loom_files.each do |filepath| %>
                <% is_selected = @selected_loom_file == filepath %>
                <% download_url = loom_file_download_url(filepath) %>
                <div class="flex items-center px-4 py-3 border-b border-gray-200 <%= is_selected ? 'bg-blue-50' : 'bg-white' %> cursor-pointer hover:bg-gray-50"
                     style="<%= is_selected ? 'border-left: 4px solid #007bff;' : 'border-left: 4px solid transparent;' %>"
                     data-action="click->data-view#selectLoomFile"
                     data-loom-file="<%= filepath %>"
                     data-data-type="<%= @selected_data_type %>">
                  <div class="flex-grow">
                    <div>
                      <strong class="block <%= is_selected ? 'text-blue-900' : 'text-gray-900' %>"><%= loom_file_label(filepath) %></strong>
                    </div>
                  </div>
                  <% if download_url %>
                    <div class="flex-shrink-0 ml-3">
                      <%= link_to download_url, 
                          target: '_blank',
                          class: 'inline-flex items-center justify-center w-8 h-8 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-colors',
                          onclick: 'event.stopPropagation();',
                          title: 'Download loom file' do %>
                        <i class="fas fa-download"></i>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            <% else %>
              <div class="text-center py-8 px-4">
                <p class="text-gray-500 mb-0">No loom files available</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Right Panel: Data Content -->
    <div class="flex-1 flex flex-col min-h-0">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 flex flex-col h-full overflow-hidden">
        <!-- Loading State -->
        <div data-data-view-target="loading" style="display: none;" class="flex-1 flex items-center justify-center">
          <div class="text-center py-12 px-6">
            <i class="fas fa-spinner fa-spin text-3xl text-blue-600 mb-4"></i>
            <p class="text-gray-600 mb-0">Loading data...</p>
          </div>
        </div>
        
        <!-- Content Container -->
        <div data-data-view-target="content" class="flex flex-col h-full">
          <%= render partial: 'projects/views/data_content' %>
        </div>
      </div>
    </div>
  </div>

  <%= render 'projects/views/add_metadata_modal' %>
</div>
