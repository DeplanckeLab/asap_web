<%# Standard Form for Creating New Runs %>
<% obj_name = 'req' %>

<% 
  h_methods = {}
  @std_methods.each { |f| h_methods[f.id] = [(f.speed_id rescue nil), f.description, (f.link rescue '')] }
%>

<%= form_for(@req, method: 'post', 
    html: { 
      id: @step.name + '_form',
      'data-controller' => 'form-req',
      'data-form-req-project-id-value' => @project.id,
      'data-form-req-project-key-value' => @project.key,
      'data-form-req-step-id-value' => @step.id,
      'data-form-req-step-name-value' => @step.name,
      'data-form-req-action-button-label-value' => (@h_step_attrs['action_button_label'] || 'Submit'),
      'data-form-req-submit-url-value' => reqs_path,
      'data-form-req-step-results-url-value' => step_results_project_path(@project),
      'data-form-req-unavailable-methods-value' => @h_unavailable_methods.to_json,
      'data-form-req-methods-value' => h_methods.to_json
    }
  ) do |f| %>
  <% if @project.errors.any? %>
    <div id="error_explanation" class="alert alert-danger flex items-start gap-3 mb-4">
      <i class="fas fa-exclamation-circle text-red-600 mt-0.5"></i>
      <div>
        <h4 class="font-semibold mb-2"><%= pluralize(@project.errors.count, "error") %> prohibited this from being saved:</h4>
        <ul class="list-disc list-inside space-y-1">
          <% @project.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <% available_methods = @std_methods.select { |s| !@h_unavailable_methods[s.id] } %>
  <% unavailable_methods = @std_methods.select { |s| @h_unavailable_methods[s.id] } %>
  <% default_methods = (@h_step_attrs['default_std_method'] || []).map { |method_name| @h_std_methods_by_name[method_name] }.compact & available_methods %>

  <% if @step.description.present? %>
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
      <div class="flex items-start gap-3">
        <i class="fas fa-info-circle text-blue-600 mt-0.5"></i>
        <div class="text-sm text-blue-800">
          <%= raw @step.description %>
        </div>
      </div>
    </div>
  <% end %>

  <% unless @h_step_attrs['hide_method'] %>
    <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 mb-6 space-y-4">
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0 w-24">
          <%= label_tag 'std_method_id', "Method", { class: 'block text-sm font-medium text-gray-700 pt-2', 'data-toggle' => 'tooltip', 'title' => "" } %>
        </div>
        <div class="flex-1">
          <% l = @std_methods.select { |s| 
            method_attrs = @h_obj_attrs_by_std_method[s.id] || {}
            project_types = method_attrs["project_types"] || []
            project_types.empty? || project_types.include?((@project.project_type) ? @project.project_type.tag : nil)
          }.map { |e| [e.label, e.id] }.sort %>
          <%= f.select :std_method_id, options_for_select(l, ((d = default_methods.first) ? d.id : ((d = available_methods.first) ? d.id : nil))), {}, { 
              class: 'w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 bg-white',
              data: { form_req_target: 'methodSelect' }
            } %>
        </div>
      </div>
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0 w-24">
          <% if defined?(Speed) %>
            <% Speed.all.each do |s| %>
              <%= image_tag 'speed_' + s.name + '.png', id: 'speed_' + s.id.to_s, class: 'speed_image hidden', width: '25px' %>
            <% end %>
          <% end %>
        </div>
        <div class="flex-1">
          <div id="method_desc" class="text-sm text-gray-700 mb-1" data-form-req-target="methodDesc"></div>
          <div id="method_pred" class="text-xs text-gray-500" data-form-req-target="methodPred"></div>
          <%= hidden_field_tag :pred_process_duration %>
          <%= hidden_field_tag :pred_max_ram %>
        </div>
      </div>
    </div>
  <% else %>
    <%= f.hidden_field :std_method_id, value: ((d = default_methods.first) ? d.id : ((d = available_methods.first) ? d.id : nil)) %>
  <% end %>

  <div id="attrs_container" class="space-y-4" data-form-req-target="attrsContainer"></div>

  <%= f.hidden_field :step_id, value: @step.id %>
  <%= hidden_field_tag :format, 'json' %>

  <% unless @h_step_attrs["hide_submit_btns"] %>
    <div class="flex items-center gap-3 pt-4 border-t border-gray-200">
      <div id="prevent_req_messages" class="alert alert-danger hidden flex items-start gap-3" data-form-req-target="errorMessages"></div>
      <button id="<%= @step.name %>_button" type="button" 
              class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-medium transition-colors cursor-pointer req_submit"
              data-form-req-target="submitButton"
              data-action="click->form-req#submit">
        <%= @h_step_attrs['action_button_label'] || 'Submit' %>
      </button>
      <button id="form_req_cancel" type="button" 
              class="px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-md font-medium transition-colors cursor-pointer"
              data-action="click->form-req#cancel">Cancel</button>
    </div>
  <% end %>
<% end %>

