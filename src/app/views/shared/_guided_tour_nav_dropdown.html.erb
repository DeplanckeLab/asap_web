<% tours = guided_tours_for_menu %>
<% return if tours.empty? %>

<div class="relative inline-block text-left"
     id="guided-tour-nav-dropdown"
     data-controller="nav-dropdown">
  <button type="button"
          class="<%= tw_menu_item %> nav-top-dropdown-button cursor-pointer"
          title="Guided tours"
          aria-expanded="false"
          data-nav-dropdown-toggle>
    Guided tours
    <svg class="duration-300 shrink-0 size-4 ms-1" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m6 9 6 6 6-6"/>
    </svg>
  </button>
  <div class="hidden absolute right-0 mt-2 w-56 bg-white shadow-md rounded-lg p-2 dark:bg-gray-800 dark:border dark:border-gray-700 z-[1000] top-full"
       data-nav-menu>
    <% tours.each do |tour| %>
      <%= link_to tour.name,
                  guided_tour_start_url(tour.id),
                  class: "flex items-center rounded-lg px-3 py-2 text-sm text-gray-800 hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-gray-700",
                  data: { controller: "nav-item", action: "click->nav-item#navigate" } %>
    <% end %>
  </div>
</div>
