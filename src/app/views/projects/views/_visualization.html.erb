    <div style="display: flex; justify-content: flex-end; gap: 8px; padding: 12px 16px; border-top: 1px solid #e5e7eb;">
      <button type="button"
              style="border: 1px solid #d1d5db; background: #fff; color: #374151; border-radius: 6px; padding: 6px 12px; cursor: pointer; font-size: 13px;"
              onclick="if (window.visualizationController) window.visualizationController.closeSaveCheckpointDialog()">
