<% ge_view = params[:view].presence || 'ge_filter' %>
<% base_url = step_results_project_path(@project, step_id: @step.id, format: :html) %>

<% if ge_view == 'dashboard' %>

  <%# === DASHBOARD VIEW === %>
  <% @extra_header_buttons = capture do %>
    <button type="button"
            class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-md font-medium text-sm transition-colors cursor-pointer"
            onclick="loadFormInRightPanel('<%= base_url %>&view=ge_filter')"
            style="flex-shrink: 0;">
      <i class="fas fa-filter sm:mr-1"></i><span class="hidden sm:inline"> GE results</span>
    </button>
  <% end %>
  <%= render 'projects/views/std_step' %>

<% else %>

  <%# === GE FILTER VIEW (default) === %>
  <% completed_runs = @runs&.select { |r| r.status_id == 3 } || [] %>

  <%
    @h_ge_filter ||= Basic.safe_parse_json(@project.ge_filter_json, { 'fdr_cutoff' => 0.05 })
    @h_ge_filter['fdr_cutoff'] = params[:ge_fdr] if params[:ge_fdr].present?
    # Normalize legacy stored default used in older GE configs.
    if @h_ge_filter['fdr_cutoff'].to_f == 0.001
      @h_ge_filter['fdr_cutoff'] = 0.05
    end
    project_dir = Pathname.new(ENV.fetch('USER_DATA_DIR')) + @project.user_id.to_s + @project.key
    @h_stats ||= {}

    unless @h_std_methods
      asap_docker_image = Basic.get_asap_docker(@project.version_for_docker_image)
      @h_std_methods = {}
      StdMethod.where(docker_image_id: asap_docker_image.id).each { |s| @h_std_methods[s.id] = s } if asap_docker_image
    end

    fdr_cutoff = @h_ge_filter['fdr_cutoff'].to_f
    completed_runs.each do |run|
      output_file = project_dir + 'ge' + run.id.to_s + 'output.json'
      next unless File.exist?(output_file)
      raw_output = File.binread(output_file)
      sanitized_output = raw_output.gsub("\\N", "\\\\N")
      sanitized_output = sanitized_output.gsub(/\\(?!["\\\/bfnrtu])/) { '\\\\' }
      h_output = {}
      begin
        h_output = JSON.parse(sanitized_output)
      rescue JSON::ParserError, Encoding::UndefinedConversionError, Encoding::InvalidByteSequenceError
        begin
          utf8_output = sanitized_output.encode('UTF-8', invalid: :replace, undef: :replace, replace: '')
          h_output = JSON.parse(utf8_output)
        rescue JSON::ParserError, Encoding::UndefinedConversionError, Encoding::InvalidByteSequenceError
          h_output = {}
        end
      end
      headers = h_output['headers'] || []
      h_fields = {}
      headers.each_index { |i| h_fields[headers[i]] = i }
      fdr_idx = h_fields['fdr']
      next unless fdr_idx
      up_count = 0
      down_count = 0
      (h_output['up'] || []).each { |e| up_count += 1 if e[fdr_idx].to_f <= fdr_cutoff }
      (h_output['down'] || []).each { |e| down_count += 1 if e[fdr_idx].to_f <= fdr_cutoff }
      @h_stats[run.id.to_s] = { 'up' => up_count, 'down' => down_count }
    end
  %>

  <div class="bg-white rounded-lg shadow-sm flex flex-col" style="max-height: calc(100vh - 200px);"
       id="ge-filter-root"
       data-ge-filter-url="<%= filter_ge_results_project_path(@project, format: :json) %>"
  >
    <div class="sticky top-0 z-10 flex-shrink-0" style="background: linear-gradient(to right, #eff6ff, #eef2ff); background-color: #ffffff;">
      <div class="border-b border-gray-200 px-6 py-4">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
            Filtered GE results
          </h3>
          <div class="flex items-center gap-2">
            <button type="button" id="ge-toggle-filters"
                    class="px-2 py-1.5 bg-white hover:bg-gray-100 text-gray-600 rounded-md font-medium text-sm transition-colors cursor-pointer border border-gray-300"
                    title="Toggle filters"
                    onclick="var p=document.getElementById('ge-filters-panel'); if(p){p.classList.toggle('hidden'); this.classList.toggle('bg-gray-200',!p.classList.contains('hidden'));}">
              <i class="fas fa-sliders-h"></i>
            </button>
            <button type="button"
                    class="px-3 py-1.5 bg-white hover:bg-gray-100 text-gray-700 rounded-md font-medium text-sm transition-colors cursor-pointer border border-gray-300"
                    title="Copy direct link to clipboard"
                    style="flex-shrink: 0;"
                    onclick="(function(btn) { var base = window.location.origin + '<%= project_path(@project, view: 'analysis', step_id: @step.id, sub_view: 'ge_filter') %>'; var p = []; var el = document.querySelector('[data-ge-filter-target=&quot;fdrCutoff&quot;]'); if(el) p.push('ge_fdr=' + encodeURIComponent(el.value)); var url = base + (p.length ? '&' + p.join('&') : ''); navigator.clipboard.writeText(url).then(function() { btn.title = 'Copied!'; setTimeout(function() { btn.title = 'Copy direct link to clipboard'; }, 2000); }).catch(function() { prompt('Copy this URL:', url); }); })(this);">
              <i class="fas fa-link sm:mr-1"></i><span class="hidden sm:inline"> Direct link</span>
            </button>
            <button type="button"
                    class="px-3 py-1.5 bg-gray-600 hover:bg-gray-700 text-white rounded-md font-medium text-sm transition-colors cursor-pointer"
                    onclick="loadFormInRightPanel('<%= base_url %>&view=dashboard')">
              <i class="fas fa-th-list sm:mr-1"></i><span class="hidden sm:inline"> Dashboard</span>
            </button>
          </div>
        </div>
      </div>
      <% if completed_runs.any? %>
        <div id="ge-filters-panel" class="border-b border-gray-200 px-6 py-3 bg-white">
          <div class="flex items-center gap-3 flex-wrap">
            <label class="text-sm font-medium text-gray-700 cursor-help" title="False Discovery Rate - adjusted p-value controlling for multiple testing">FDR &lt;=</label>
            <input type="text" value="<%= @h_ge_filter['fdr_cutoff'] %>"
                   id="ge-fdr-cutoff"
                   oninput="scheduleGeFilterNow()"
                   onblur="runGeFilterNow()"
                   onchange="runGeFilterNow()"
                   onkeydown="if(event.key==='Enter'){event.preventDefault();runGeFilterNow();}"
                   class="form-input rounded border border-gray-300 bg-white text-sm w-24 px-2 py-1 shadow-inner focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
            <span id="ge-filter-spinner"
                  class="ml-2 hidden inline-flex items-center text-sm text-gray-600">
              <i class="fas fa-spinner fa-spin mr-1"></i>Refreshing
            </span>
          </div>
        </div>
      <% end %>
    </div>
    <div class="px-6 py-5 flex-1 overflow-y-auto">
      <% if completed_runs.any? %>
        <div id="ge-results-container">
          <%= render partial: 'projects/views/ge_results_table' %>
        </div>
      <% else %>
        <div class="text-gray-500 text-center py-8">No completed GE runs found.</div>
      <% end %>
    </div>
  </div>

  <script>
  var geFilterTimer = null;

  function scheduleGeFilterNow() {
    if (geFilterTimer) clearTimeout(geFilterTimer);
    geFilterTimer = setTimeout(function() {
      runGeFilterNow();
    }, 350);
  }

  function runGeFilterNow() {
    if (geFilterTimer) {
      clearTimeout(geFilterTimer);
      geFilterTimer = null;
    }

    var root = document.getElementById('ge-filter-root');
    if (!root) return;
    var url = root.getAttribute('data-ge-filter-url');
    var container = document.getElementById('ge-results-container');
    var fdrInput = document.getElementById('ge-fdr-cutoff');
    var spinner = document.getElementById('ge-filter-spinner');
    if (!url || !container || !fdrInput) return;

    var csrfToken = document.querySelector('meta[name="csrf-token"]');
    var formData = new FormData();
    formData.append('filter[fdr_cutoff]', fdrInput.value);
    var runRows = document.querySelectorAll('tr[data-ge-run-id]');
    runRows.forEach(function(row) {
      var runId = row.getAttribute('data-ge-run-id');
      if (runId) formData.append('filter[run_ids][]', runId);
    });
    var requestedRunIds = Array.from(runRows).map(function(row) {
      return row.getAttribute('data-ge-run-id');
    }).filter(function(v) { return !!v; });
    console.log('[ge-filter] request', { fdr: fdrInput.value, runIds: requestedRunIds });
    if (spinner) spinner.classList.remove('hidden');

    fetch(url, {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'X-CSRF-Token': csrfToken ? csrfToken.getAttribute('content') : ''
      },
      body: formData,
      credentials: 'same-origin'
    })
    .then(function(response) {
      if (!response.ok) throw new Error('HTTP ' + response.status);
      return response.json();
    })
    .then(function(payload) {
      var stats = payload && payload.h_stats ? payload.h_stats : {};
      console.log('[ge-filter] response', {
        statRunIds: Object.keys(stats),
        stats: stats
      });
      Object.keys(stats).forEach(function(runId) {
        var up = (stats[runId] && stats[runId].up != null) ? parseInt(stats[runId].up, 10) : 0;
        var down = (stats[runId] && stats[runId].down != null) ? parseInt(stats[runId].down, 10) : 0;

        var upBadge = document.getElementById('ge-up-badge-' + runId);
        console.log('[ge-filter] up badge lookup', {
          runId: runId,
          found: !!upBadge,
          targetId: 'ge-up-badge-' + runId,
          value: up
        });
        if (upBadge) {
          upBadge.textContent = up + ' gene sets';
          if (upBadge.parentElement) upBadge.parentElement.setAttribute('data-sort-value', String(up));
          upBadge.classList.remove('bg-green-100', 'text-green-800', 'hover:bg-green-200', 'bg-gray-100', 'text-gray-500');
          if (up > 0) {
            upBadge.classList.add('bg-green-100', 'text-green-800', 'hover:bg-green-200');
          } else {
            upBadge.classList.add('bg-gray-100', 'text-gray-500');
          }
        }

        var downBadge = document.getElementById('ge-down-badge-' + runId);
        console.log('[ge-filter] down badge lookup', {
          runId: runId,
          found: !!downBadge,
          targetId: 'ge-down-badge-' + runId,
          value: down
        });
        if (downBadge) {
          downBadge.textContent = down + ' gene sets';
          if (downBadge.parentElement) downBadge.parentElement.setAttribute('data-sort-value', String(down));
          downBadge.classList.remove('bg-red-100', 'text-red-800', 'hover:bg-red-200', 'bg-gray-100', 'text-gray-500');
          if (down > 0) {
            downBadge.classList.add('bg-red-100', 'text-red-800', 'hover:bg-red-200');
          } else {
            downBadge.classList.add('bg-gray-100', 'text-gray-500');
          }
        }
      });
    })
    .catch(function(error) {
      console.error('[ge-filter] request failed', error);
    })
    .finally(function() {
      if (spinner) spinner.classList.add('hidden');
    });
  }

  function shouldRefreshGeStatsOnLoad() {
    return document.querySelectorAll('tr[data-ge-run-id]').length > 0;
  }

  if (shouldRefreshGeStatsOnLoad()) {
    setTimeout(function() {
      runGeFilterNow();
    }, 0);
  }
  </script>

<% end %>
