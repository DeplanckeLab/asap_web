<div id="compose-selection-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.45); z-index: 12100; justify-content: center; align-items: center;" onclick="if (event.target === this && window.visualizationController) window.visualizationController.closeComposeSelectionModal()">
  <div style="width: 900px; max-width: 95vw; max-height: 90vh; background: #fff; border-radius: 10px; box-shadow: 0 20px 40px rgba(0,0,0,0.2); display: flex; flex-direction: column; overflow: hidden;">
    <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; border-bottom: 1px solid #e5e7eb; background: #f9fafb;">
      <div style="font-size: 16px; font-weight: 600; color: #111827;">Compose selection</div>
      <button type="button"
              style="background: none; border: none; color: #6b7280; cursor: pointer; font-size: 18px; line-height: 1;"
              onclick="if (window.visualizationController) window.visualizationController.closeComposeSelectionModal()">
        ×
      </button>
    </div>
    <div style="padding: 16px; overflow-y: auto; min-height: 0;">
      <div style="display: grid; grid-template-columns: 1fr; gap: 8px; margin-bottom: 12px;">
        <div>
          <label style="display: block; font-size: 12px; color: #6b7280; margin-bottom: 4px;">Preview embedding</label>
          <select id="compose-selection-embedding"
                  onchange="if (window.visualizationController) window.visualizationController.onComposeSelectionEmbeddingChanged()"
                  style="width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px;"></select>
        </div>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 180px 1fr auto; gap: 10px; align-items: end; margin-bottom: 14px;">
        <div>
          <label style="display: block; font-size: 12px; color: #6b7280; margin-bottom: 4px;">Operand A</label>
          <select id="compose-selection-operand-a"
                  onchange="if (window.visualizationController) window.visualizationController.updateComposeSelectionPreview()"
                  style="width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px;"></select>
        </div>
        <div>
          <label style="display: block; font-size: 12px; color: #6b7280; margin-bottom: 4px;">Operation</label>
          <select id="compose-selection-operation"
                  onchange="if (window.visualizationController) window.visualizationController.updateComposeSelectionPreview()"
                  style="width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px;">
            <option value="union">UNION</option>
            <option value="intersection">INTERSECTION</option>
            <option value="difference_ab">A \ B</option>
            <option value="difference_ba">B \ A</option>
            <option value="xor">SYMMETRIC DIFFERENCE</option>
          </select>
        </div>
        <div>
          <label style="display: block; font-size: 12px; color: #6b7280; margin-bottom: 4px;">Operand B</label>
          <select id="compose-selection-operand-b"
                  onchange="if (window.visualizationController) window.visualizationController.updateComposeSelectionPreview()"
                  style="width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px;"></select>
        </div>
        <div>
          <button type="button"
                  style="padding: 8px 12px; background: #2563eb; color: #fff; border: none; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer;"
                  onclick="if (window.visualizationController) window.visualizationController.applyComposeSelectionOperation()">
            Add operation
          </button>
        </div>
      </div>
      <div id="compose-selection-status" style="display: none; margin-bottom: 12px; padding: 8px 10px; border-radius: 6px; font-size: 12px;"></div>
      <div id="compose-selection-preview" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-bottom: 16px;"></div>
      <div>
        <div style="font-size: 13px; font-weight: 600; color: #111827; margin-bottom: 8px;">Composition steps</div>
        <div id="compose-selection-steps" style="max-height: 220px; overflow-y: auto; border: 1px solid #e5e7eb; border-radius: 8px; background: #fff; padding: 8px;"></div>
      </div>
    </div>
  </div>
</div>
