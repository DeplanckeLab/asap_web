<div class="max-w-5xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-gray-900">ASAP Releases</h1>
    <% if admin? %>
      <%= link_to 'New Version', new_version_path, class: 'inline-flex items-center px-3 py-2 rounded-md bg-gray-900 text-white text-sm font-medium hover:bg-gray-800 transition' %>
    <% end %>
  </div>

  <% if notice.present? %>
    <div class="rounded-md bg-green-100 px-4 py-3 text-sm text-green-700"><%= notice %></div>
  <% end %>

  <% @versions.each do |version| %>
    <% env_data = @env_data_by_version_id[version.id] || {} %>
    <% tool_versions = tool_versions_from(env_data) %>
    <% docker_images = docker_images_from(env_data) %>

    <div class="rounded-lg border border-gray-200 bg-white shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-gray-100 px-4 py-3">
        <div>
          <div class="flex items-center gap-3">
            <span class="text-sm font-medium text-gray-500">Release <%= version.id %></span>
            <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-700">
              <%= format_version_release_date(version) %>
            </span>
            <% if version.activated? %>
              <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700">
                Activated
              </span>
            <% end %>
            <% if version.beta? %>
              <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-700">
                Beta
              </span>
            <% end %>
          </div>
          <p class="mt-1 text-sm text-gray-700 whitespace-pre-line"><%= version.description %></p>
        </div>
        <div class="flex items-center gap-2 text-sm text-gray-500">
          <%= link_to 'View details', version_path(version), class: 'inline-flex items-center gap-1 rounded-md border border-gray-200 px-3 py-1.5 hover:bg-gray-50' %>
          <% if admin? %>
            <%= link_to 'Edit', edit_version_path(version), class: 'inline-flex items-center gap-1 rounded-md border border-gray-200 px-3 py-1.5 hover:bg-gray-50' %>
          <% end %>
        </div>
      </div>

      <% if tool_versions.present? || docker_images.present? %>
        <div class="px-4 py-4 space-y-6">
          <% if tool_versions.present? %>
            <div>
              <h3 class="text-sm font-medium text-gray-700 mb-2">Tool Versions</h3>
              <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 text-sm">
                  <thead class="bg-gray-50">
                    <tr>
                      <th scope="col" class="px-3 py-2 text-left font-semibold text-gray-600">Tool</th>
                      <th scope="col" class="px-3 py-2 text-left font-semibold text-gray-600">Version</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-100">
                    <% tool_versions.each do |tool_name, tool_version| %>
                      <tr>
                        <td class="px-3 py-2 text-gray-700"><%= tool_name %></td>
                        <td class="px-3 py-2 text-gray-500"><%= tool_version %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          <% end %>

          <% if docker_images.present? %>
            <div>
              <h3 class="text-sm font-medium text-gray-700 mb-2">Docker Images</h3>
              <div class="space-y-4">
                <% docker_images.each do |name, metadata| %>
                  <% record = docker_image_record_for(name, metadata) %>
                  <% metadata_hash = docker_image_metadata_hash(metadata, record) %>
                  <% tools = docker_image_tools(metadata_hash, record) %>
                  <% grouped_tools = grouped_tools_by_language(tools, metadata_hash, record: record) { |tool_name| tool_metadata_for(tool_name) } %>
                  <details class="bg-gray-50 border-b border-gray-200 px-4 py-2 text-xs text-gray-600">
                    <summary class="cursor-pointer text-gray-500 select-none">Raw metadata</summary>
                    <pre class="mt-2 max-h-48 overflow-x-auto whitespace-pre-wrap"><%= JSON.pretty_generate(metadata_hash) %></pre>
                  </details>
                  <div class="rounded-md border border-gray-200 overflow-hidden">
                    <div class="flex items-center justify-between bg-gray-50 px-4 py-2">
                      <span class="text-sm font-semibold text-gray-800"><%= docker_image_label(name, metadata_hash, record) %></span>
                      <% tag = metadata_hash['tag'] || record&.tag %>
                      <% if tag.present? %>
                        <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">
                          Tag: <%= tag %>
                        </span>
                      <% end %>
                    </div>
                    <% if grouped_tools.present? %>
                      <div class="divide-y divide-gray-100 text-sm">
                        <% grouped_tools.each do |language, tool_list| %>
                          <div class="px-4 py-3">
                            <div class="mb-2 text-sm font-semibold text-gray-600 uppercase tracking-wide"><%= language %></div>
                            <div class="flex flex-wrap gap-2">
                              <% tool_list.each do |tool| %>
                                <div class="inline-flex items-center gap-2 rounded-md border border-gray-200 px-3 py-1.5 bg-white shadow-sm">
                                  <span class="font-medium text-gray-700"><%= tool[:package] %></span>
                                  <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700">
                                    <%= tool[:version] || 'NA' %>
                                  </span>
                                  <% if tool[:url].present? %>
                                    <%= link_to raw("<i class='fas fa-link text-gray-400 text-xs'></i>"), tool[:url], target: "_blank", rel: "noopener", class: "text-gray-400 hover:text-gray-600 transition" %>
                                  <% end %>
                                </div>
                              <% end %>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    <% else %>
                      <div class="px-4 py-3 text-sm text-gray-500 italic">No tool versions listed for this image.</div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @versions.empty? %>
    <div class="rounded-lg border border-dashed border-gray-300 bg-white px-6 py-10 text-center text-gray-500">
      No versions have been recorded yet.
    </div>
  <% end %>
</div>

