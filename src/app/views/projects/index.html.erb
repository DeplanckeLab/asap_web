<% content_for :title, "Browse Projects" %>

<div class="min-h-screen bg-gray-50">
  <div class="w-full mx-auto px-3 sm:px-4 lg:px-6 py-8">
    <% if notice.present? %>
      <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg">
        <p class="text-green-800"><%= notice %></p>
      </div>
    <% end %>

    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Search projects</h1>
      <p class="text-gray-600">Search and explore ASAP projects</p>
    </div>

    <!-- Search Form -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-8">
      <%= form_with url: projects_path, method: :get, local: true, class: "space-y-6" do |form| %>
        <!-- Search Bar -->
        <div>
          <label for="q" class="block text-sm font-medium text-gray-700 mb-2">Search Projects</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <%= form.text_field :q, value: @query, placeholder: "Search by name, description, technology...", 
                class: "block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-blue-500 focus:border-blue-500" %>
          </div>
        </div>

        <!-- Filters Row -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          <!-- Organism Filter -->
          <div data-controller="organism-selector">
            <label class="block text-sm font-medium text-gray-700 mb-2">Organism</label>
            <div class="relative" data-test="organism-selector-container">
              <% selected_organism_id = @filters[:organism_id].present? ? @filters[:organism_id].to_i : nil %>
              <input type="hidden" name="organism_id" value="<%= selected_organism_id || '' %>" data-organism-selector-target="hiddenInput" />

              <!-- Dropdown button -->
              <button type="button"
                      class="w-full px-3 py-2 text-left border border-gray-300 rounded-md bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 flex items-center justify-between"
                      data-organism-selector-target="dropdownButton"
                      data-action="click->organism-selector#toggleDropdown">
                <span data-organism-selector-target="selectedText">
                  <% if selected_organism_id.present? %>
                    <% selected_org = @organisms.find { |o| o.id == selected_organism_id } %>
                    <%= selected_org&.display_name || "All organisms" %>
                  <% else %>
                    All organisms
                  <% end %>
                </span>
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-organism-selector-target="chevron">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>

              <!-- Dropdown menu -->
              <div class="hidden absolute z-10 w-full mt-1 bg-white border border-gray-200 rounded-md shadow-lg max-h-96 overflow-y-auto"
                   data-organism-selector-target="dropdownMenu">
                <!-- All organisms option -->
                <button type="button"
                        class="w-full px-4 py-2 text-left text-sm text-gray-700 hover:bg-blue-50 transition-colors font-medium border-b border-gray-100 <%= 'bg-blue-50' unless selected_organism_id.present? %>"
                        data-organism-id=""
                        data-organism-selector-target="option"
                        data-action="click->organism-selector#selectOrganism">
                  All organisms
                </button>
                <% (@grouped_organisms || {}).each do |domain, organisms| %>
                  <div class="organism-group">
                    <!-- Group header (collapsible) -->
                    <button type="button"
                            class="w-full px-4 py-2 text-left text-sm font-semibold text-gray-700 bg-gray-50 hover:bg-gray-100 flex items-center"
                            data-organism-selector-target="groupHeader"
                            data-action="click->organism-selector#toggleGroup">
                      <div class="mr-3" style="color: #9ca3af;">
                        <i class="fas fa-chevron-right" style="font-size: 14px; transition: transform 0.3s ease-out;" data-organism-selector-target="groupChevron"></i>
                      </div>
                      <span class="flex-1"><%= domain %></span>
                      <span class="inline-flex items-center justify-center px-2 py-1 text-xs font-semibold rounded-full bg-gray-200 text-gray-700 ml-2">
                        <%= organisms.count %>
                      </span>
                    </button>

                    <!-- Group content (collapsible) -->
                    <div class="hidden" data-organism-selector-target="groupContent">
                      <% organisms.each do |organism_data| %>
                        <%
                          display_name = organism_data[0]
                          organism_id = organism_data[1]
                          tax_id = organism_data[2]
                        %>
                        <button type="button"
                                class="w-full px-6 py-2 text-left text-sm text-gray-700 hover:bg-blue-50 transition-colors <%= 'bg-blue-50 font-medium' if organism_id == selected_organism_id %>"
                                data-organism-id="<%= organism_id %>"
                                data-organism-selector-target="option"
                                data-action="click->organism-selector#selectOrganism">
                          <span><%= display_name %></span>
                          <% if tax_id.present? %>
                            <span class="text-gray-500 ml-2 text-xs"><%= tax_id %></span>
                          <% end %>
                        </button>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Technology Filter -->
          <div>
            <label for="technology" class="block text-sm font-medium text-gray-700 mb-2">Technology</label>
            <%= form.select :technology, 
                options_for_select(@technologies, @filters[:technology]), 
                { prompt: "All technologies" }, 
                { class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" } %>
          </div>

          <!-- Tissue Filter -->
          <div>
            <label for="tissue" class="block text-sm font-medium text-gray-700 mb-2">Tissue</label>
            <%= form.select :tissue, 
                options_for_select(@tissues, @filters[:tissue]), 
                { prompt: "All tissues" }, 
                { class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" } %>
          </div>

          <!-- Status Filter -->
          <div>
            <label for="status_id" class="block text-sm font-medium text-gray-700 mb-2">Status</label>
            <%= form.select :status_id, 
                options_from_collection_for_select(@statuses, :id, :display_name, @filters[:status_id]), 
                { prompt: "All statuses" }, 
                { class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" } %>
          </div>
        </div>

        <!-- Additional Filters Row -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <!-- Public Only Filter -->
          <div class="flex items-center">
            <%= form.check_box :public_only, { checked: @filters[:public_only] == 'true', class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" }, 'true', 'false' %>
            <label for="public_only" class="ml-2 block text-sm text-gray-900">Public projects only</label>
          </div>

          <!-- Sort Options -->
          <div>
            <label for="sort" class="block text-sm font-medium text-gray-700 mb-2">Sort by</label>
            <%= form.select :sort, 
                options_for_select([
                  ['Most Recent', 'created_at'],
                  ['Name (A-Z)', 'name'],
                  ['Most Views', 'views'],
                  ['Last Updated', 'updated_at']
                ], @filters[:sort]), 
                {}, 
                { class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" } %>
          </div>

          <!-- Action Buttons -->
          <div class="flex items-end space-x-3">
            <%= form.submit "Search", class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
            <%= link_to "Clear", projects_path, class: "px-4 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Results Header and Projects Container -->
    <div data-controller="view-toggle">
      <div class="flex justify-between items-center mb-6">
        <div class="text-sm text-gray-600">
          <% if @projects.any? %>
            Showing <%= (@current_page - 1) * @per_page + 1 %>-<%= [@current_page * @per_page, @total_count].min %> of <%= @total_count %> projects
          <% else %>
            No projects found
          <% end %>
        </div>
        
        <div class="flex items-center space-x-4">
          <!-- View Toggle Buttons -->
          <div class="flex items-center border border-gray-300 rounded-md overflow-hidden">
            <button type="button" 
                    data-view-toggle-target="cardBtn" 
                    data-action="click->view-toggle#showCards"
                    class="px-3 py-1.5 text-sm font-medium bg-blue-600 text-white focus:outline-none" 
                    title="Card View">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
              </svg>
            </button>
            <button type="button" 
                    data-view-toggle-target="listBtn" 
                    data-action="click->view-toggle#showList"
                    class="px-3 py-1.5 text-sm font-medium bg-white text-gray-600 hover:bg-gray-50 focus:outline-none" 
                    title="List View">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
              </svg>
            </button>
          </div>
          
          <%= link_to "New Project", new_project_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        </div>
      </div>

      <!-- Projects Container -->
    <% if @projects.any? %>
      <!-- Cards View -->
      <div data-view-toggle-target="cardView" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @projects.each do |project| %>
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow duration-200">
            <!-- Project Header -->
            <div class="p-6 border-b border-gray-100">
              <div class="flex items-start justify-between">
                <h3 class="text-lg font-semibold text-gray-900 mb-2">
                  <%= link_to project.display_name, project_path(project), class: "hover:text-blue-600" %>
                </h3>
                <div class="flex items-center gap-1.5 shrink-0">
                  <% if project.version_id.present? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700"
                          title="ASAP release">
                      v<%= project.version_id %>
                    </span>
                  <% end %>
                  <% if project.archive_status.present? && project.archive_status.icon_class.present? %>
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-gray-100 text-gray-700"
                          title="Archive status: <%= project.archive_status.display_name %>">
                      <i class="<%= project.archive_status.icon_class %>"></i>
                    </span>
                  <% end %>
                  <% if project.project_type.present? && project.project_type.tag.present? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800"
                          title="<%= project.project_type.name %>">
                      <%= project.project_type.tag %>
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800"
                          title="Project type not set">
                      ?
                    </span>
                  <% end %>
                  <% if project.is_public? %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      Public
                    </span>
                  <% end %>
                </div>
              </div>
              
              <% if project.description.present? %>
                <p class="text-sm text-gray-600 line-clamp-2"><%= truncate(project.description, length: 120) %></p>
              <% end %>
            </div>

            <!-- Project Stats -->
            <div class="p-6">
              <div class="grid grid-cols-2 gap-4 text-sm">
                <div>
                  <span class="text-gray-500">Cells:</span>
                  <span class="font-medium text-gray-900"><%= number_with_delimiter(project.cell_count) %></span>
                </div>
                <div>
                  <span class="text-gray-500">Genes:</span>
                  <span class="font-medium text-gray-900"><%= number_with_delimiter(project.gene_count) %></span>
                </div>
                <div>
                  <span class="text-gray-500">Technology:</span>
                  <span class="font-medium text-gray-900"><%= project.technology_display %></span>
                </div>
                <div>
                  <span class="text-gray-500">Tissue:</span>
                  <span class="font-medium text-gray-900"><%= project.tissue_display %></span>
                </div>
              </div>

              <!-- Project Meta -->
              <div class="mt-4 pt-4 border-t border-gray-100">
                <div class="flex items-center justify-between text-xs text-gray-500">
                  <span>Updated <%= time_ago_in_words(project.updated_at) %> ago</span>
                  <span><%= pluralize(project.view_count, 'view') %></span>
                </div>
              </div>
            </div>

            <!-- Project Actions -->
            <div class="px-6 py-3 bg-gray-50 border-t border-gray-100">
              <div class="flex space-x-2">
                <%= link_to "View", project_path(project), class: "flex-1 text-center px-3 py-2 text-sm font-medium text-blue-600 hover:text-blue-700 focus:outline-none" %>
                <% if clonable?(project) %>
                  <%= button_to "Clone",
                      clone_project_path(project),
                      method: :post,
                      class: "flex-1 text-center px-3 py-2 text-sm font-medium text-gray-600 hover:text-gray-700 focus:outline-none bg-transparent border-0 cursor-pointer",
                      form: { class: "flex-1" } %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- List View -->
      <div data-view-toggle-target="listView" class="hidden" data-controller="project-selection delete-projects integrate-projects" data-delete-projects-url-value="<%= bulk_destroy_projects_path %>" data-integrate-projects-url-value="<%= prepare_integrate_projects_path %>">
        <!-- Action Bar -->
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-3">
            <span class="text-sm text-gray-500" data-project-selection-target="selectedCount"></span>
            <button type="button"
                    class="hidden text-sm text-blue-600 hover:text-blue-800 underline"
                    data-project-selection-target="clearButton"
                    data-action="click->project-selection#clearSelection">
              Clear selection
            </button>
          </div>
          <div class="flex items-center gap-2">
            <button type="button"
                    class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-green-600 rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-green-600 hover:bg-green-700"
                    data-project-selection-target="integrateButton"
                    data-action="click->integrate-projects#integrateSelected"
                    disabled>
              <i class="fas fa-object-group mr-2"></i>
              <span data-project-selection-target="integrateButtonText">Integrate selected</span>
            </button>
            <button type="button"
                    class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-red-600 hover:bg-red-700"
                    data-project-selection-target="deleteButton"
                    data-action="click->delete-projects#deleteSelected"
                    disabled>
              <i class="fas fa-trash-alt mr-2"></i>
              <span data-project-selection-target="deleteButtonText">Delete selected</span>
            </button>
          </div>
        </div>

        <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="pl-4 pr-2 py-3 w-10">
                  <input type="checkbox"
                         class="rounded border-gray-300 text-red-600 focus:ring-red-500"
                         data-action="change->project-selection#toggleAll"
                         data-project-selection-target="selectAll">
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Project</th>
                <% if admin? %>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User</th>
                <% end %>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Organism</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Technology</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cells</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Genes</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Runs</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Updated</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @projects.each do |project| %>
                <tr class="hover:bg-gray-100 cursor-pointer transition-colors">
                  <td class="pl-4 pr-2 py-4 w-10" onclick="event.stopPropagation()">
                    <input type="checkbox"
                           class="rounded border-gray-300 text-red-600 focus:ring-red-500"
                           value="<%= project.id %>"
                           data-single-cell="<%= project.single_cell? %>"
                           data-action="change->project-selection#updateSelection"
                           data-project-selection-target="checkbox">
                  </td>
                  <td class="px-6 py-4" onclick="window.location='<%= project_path(project) %>'">
                    <div>
                      <div class="text-sm font-medium text-gray-900">
                        <%= project.display_name %>
                      </div>
                      <div class="flex items-center gap-2 mt-0.5">
                        <% if project.archive_status.present? && project.archive_status.icon_class.present? %>
                          <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-gray-100 text-gray-700"
                                title="Archive status: <%= project.archive_status.display_name %>">
                            <i class="<%= project.archive_status.icon_class %> text-xs"></i>
                          </span>
                        <% end %>
                        <% if project.key.present? %>
                          <span class="text-xs text-gray-400 font-mono"><%= project.key %></span>
                        <% end %>
                        <% if project.public_id.present? %>
                          <span class="inline-flex items-center px-1.5 py-0 rounded text-xs font-medium bg-green-100 text-green-800">ASAP<%= project.public_id %></span>
                        <% end %>
                        <% if project.version_id.present? %>
                          <span class="inline-flex items-center px-1.5 py-0 rounded text-xs font-medium bg-gray-100 text-gray-700"
                                title="ASAP release">
                            v<%= project.version_id %>
                          </span>
                        <% end %>
                      </div>
                    </div>
                  </td>
                  <% if admin? %>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" onclick="window.location='<%= project_path(project) %>'">
                      <%= project.user&.email.presence || '-' %>
                    </td>
                  <% end %>
                  <td class="px-6 py-4 whitespace-nowrap text-sm" onclick="window.location='<%= project_path(project) %>'">
                    <% if project.project_type.present? && project.project_type.tag.present? %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800"
                            title="<%= project.project_type.name %>">
                        <%= project.project_type.tag %>
                      </span>
                    <% else %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800"
                            title="Project type not set">
                        ?
                      </span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" onclick="window.location='<%= project_path(project) %>'">
                    <%= project.organism_display %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" onclick="window.location='<%= project_path(project) %>'">
                    <%= project.technology_display %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" onclick="window.location='<%= project_path(project) %>'">
                    <%= number_with_delimiter(project.cell_count) %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" onclick="window.location='<%= project_path(project) %>'">
                    <%= number_with_delimiter(project.gene_count) %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap" onclick="window.location='<%= project_path(project) %>'">
                    <% run_counts = project_run_counts(project) %>
                    <div class="flex items-center gap-2">
                      <% [:waiting, :running, :completed, :failed].each do |key| %>
                        <% 
                          config = status_icons_by_key[key]
                          count = run_counts[key]
                          is_active = count > 0
                          icon_class = config[:icon_base]
                          icon_class += " #{config[:icon_spin]}" if is_active && config[:icon_spin].present?
                          color_class = is_active ? config[:active_color] : 'text-gray-300'
                        %>
                        <div class="flex flex-col items-center" title="<%= config[:label] %>">
                          <i class="<%= icon_class %> text-sm <%= color_class %>"></i>
                          <span class="text-[9px] leading-tight text-gray-400 mt-0.5"><%= count %></span>
                        </div>
                      <% end %>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" onclick="window.location='<%= project_path(project) %>'">
                    <%= project.updated_at&.strftime("%b %d, %Y") %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap" onclick="window.location='<%= project_path(project) %>'">
                    <% if project.is_public? %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Public</span>
                    <% else %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">Private</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Simple Pagination -->
      <% if @total_count > @per_page %>
        <div class="mt-8 flex justify-center">
          <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
            <% if @current_page > 1 %>
              <%= link_to "Previous", projects_path(page: @current_page - 1, q: @query, organism_id: @filters[:organism_id], technology: @filters[:technology], tissue: @filters[:tissue], status_id: @filters[:status_id], public_only: @filters[:public_only], sort: @filters[:sort]), class: "relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50" %>
            <% end %>
            
            <% total_pages = (@total_count.to_f / @per_page).ceil %>
            <% start_page = [@current_page - 2, 1].max %>
            <% end_page = [@current_page + 2, total_pages].min %>
            
            <% (start_page..end_page).each do |page| %>
              <% if page == @current_page %>
                <span class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-blue-50 text-sm font-medium text-blue-600">
                  <%= page %>
                </span>
              <% else %>
                <%= link_to page, projects_path(page: page, q: @query, organism_id: @filters[:organism_id], technology: @filters[:technology], tissue: @filters[:tissue], status_id: @filters[:status_id], public_only: @filters[:public_only], sort: @filters[:sort]), class: "relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50" %>
              <% end %>
            <% end %>
            
            <% if @current_page < total_pages %>
              <%= link_to "Next", projects_path(page: @current_page + 1, q: @query, organism_id: @filters[:organism_id], technology: @filters[:technology], tissue: @filters[:tissue], status_id: @filters[:status_id], public_only: @filters[:public_only], sort: @filters[:sort]), class: "relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50" %>
            <% end %>
          </nav>
        </div>
      <% end %>
    </div>
    <% else %>
      <!-- Empty State -->
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No projects found</h3>
        <p class="mt-1 text-sm text-gray-500">
          <% if @query.present? || @filters.values.any?(&:present?) %>
            Try adjusting your search criteria or filters.
          <% else %>
            Get started by creating a new project.
          <% end %>
        </p>
        <div class="mt-6">
          <%= link_to "New Project", new_project_path, class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
