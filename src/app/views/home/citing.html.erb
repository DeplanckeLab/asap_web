<% content_for :title, "Citing ASAP" %>
<% content_for :meta_description, "How to cite ASAP, publications citing ASAP, and references in bioinformatics tool databases." %>

<div class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="mb-8">
    <h1 class="text-3xl font-semibold text-gray-900 dark:text-white">Citing ASAP</h1>
    <p class="mt-2 text-gray-600 dark:text-gray-300">
      This page centralizes citation information for ASAP and external references.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-6">
    <section class="rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900 overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950/40">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white">1) How to cite us</h2>
      </div>
      <div class="px-6 py-5">
          <p class="text-gray-700 dark:text-gray-300">
            Please cite ASAP using these publications:
          </p>
          <p class="mt-3 text-gray-900 dark:text-gray-100">
            Gardeux V, David FP, Shajkofci A, Schwalie PC, Deplancke B. ASAP: a web-based platform for the analysis and interactive visualization of single-cell RNA-seq data. <em>Bioinformatics</em>. 2017;33(19):3123-3125.
          </p>
          <p class="mt-2">
            <a class="text-blue-600 hover:underline" href="https://doi.org/10.1093/bioinformatics/btx337" target="_blank" rel="noopener noreferrer">
              DOI: 10.1093/bioinformatics/btx337
            </a>
          </p>
          <p class="mt-4 text-gray-900 dark:text-gray-100">
            David FPA, Litovchenko M, Deplancke B, Gardeux V. ASAP 2020 update: an open, scalable and interactive web-based portal for (single-cell) omics analyses. <em>Nucleic Acids Research</em>. 2020;48(W1):W403-W414.
          </p>
          <p class="mt-2">
            <a class="text-blue-600 hover:underline" href="https://doi.org/10.1093/nar/gkaa412" target="_blank" rel="noopener noreferrer">
              DOI: 10.1093/nar/gkaa412
            </a>
          </p>
          <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
            If you cite ASAP in a publication, feel free to contact us so we can include it below.
          </p>
      </div>
    </section>

    <section class="rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900 overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950/40">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white">2) Citations of ASAP in publications</h2>
      </div>
      <div class="px-6 py-5">
        <p class="text-gray-700 dark:text-gray-300">
          We keep an internal list of publications that cite ASAP. This list will be displayed here.
        </p>
      </div>
    </section>

    <section class="rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900 overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950/40">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white">3) ASAP references and links in tool databases</h2>
      </div>
      <div class="px-6 py-5">
        <ul class="space-y-3 text-gray-800 dark:text-gray-200">
          <li>
            <a class="inline-flex items-center gap-3 text-blue-600 hover:underline" href="https://bio.tools/asap_pipeline" target="_blank" rel="noopener noreferrer">
              <%= image_tag "citing/biotools_header.svg", class: "w-[100px] h-auto rounded-md object-contain bg-[#005472] p-1", alt: "bio.tools logo" %>
              <span>bio.tools</span>
            </a>
          </li>
          <li>
            <a class="inline-flex items-center gap-3 text-blue-600 hover:underline" href="https://www.sib.swiss/activities/open-software-and-databases" target="_blank" rel="noopener noreferrer">
              <%= image_tag "citing/sib.svg", class: "w-[100px] h-auto rounded-md object-contain bg-white p-0.5", alt: "SIB logo" %>
              <span>SIB Resources</span>
            </a>
          </li>
          <li>
            <a class="inline-flex items-center gap-3 text-blue-600 hover:underline" href="https://doi.org/10.25504/FAIRsharing.1ff8d5" target="_blank" rel="noopener noreferrer">
              <%= image_tag "citing/fairsharing.svg", class: "w-[100px] h-auto rounded-md object-contain bg-white p-0.5", alt: "FAIRsharing logo" %>
              <span>FAIRsharing</span>
            </a>
          </li>
        </ul>
      </div>
    </section>
  </div>
</div>
