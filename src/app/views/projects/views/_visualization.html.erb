          <div id="global-filter-panel"
               style="display: none; position: absolute; top: calc(100% + 8px); left: 0; min-width: 260px; max-width: 320px; padding: 12px; border: 1px solid #d1d5db; border-radius: 6px; background-color: white; box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1); z-index: 3000;">
