<% content_for :title, "Standard Methods - ASAP" %>
<div class="max-w-5xl mx-auto py-10 px-4 sm:px-6 lg:px-8 space-y-6" data-controller="confirm-delete">
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-semibold text-gray-900 dark:text-white">Standard Methods</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-300">
        Manage standard methods available in ASAP.
      </p>
    </div>
    <% if can_edit_synced_reference_data? %>
      <%
        new_std_method_query = {}
        new_std_method_query[:version_id] = @selected_version_id if @selected_version_id.present?
      %>
      <%= link_to 'New Standard Method', new_std_method_path(new_std_method_query), class: 'inline-flex items-center px-3 py-2 rounded-md bg-gray-900 text-white text-sm font-medium hover:bg-gray-800 transition' %>
    <% end %>
  </div>

  <% if notice.present? %>
    <div class="rounded-md bg-green-100 px-4 py-3 text-sm text-green-700"><%= notice %></div>
  <% end %>

  <div class="rounded-lg border border-gray-200 bg-white shadow-sm p-4">
    <%= form_with url: std_methods_path, method: :get, local: true, class: "flex flex-col gap-4 sm:flex-row sm:items-end" do %>
      <div class="w-full sm:w-72">
        <label class="block text-sm font-medium text-gray-700 mb-1" for="version_id">Release (version_id)</label>
        <%= select_tag :version_id,
                       options_for_select(
                         @versions.map { |v| [ "Release #{v.id}", v.id ] },
                         @selected_version_id
                       ),
                       class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" %>
      </div>
      <div class="flex gap-2">
        <%= submit_tag "Filter", class: "inline-flex items-center px-4 py-2 rounded-md bg-gray-900 text-white text-sm font-medium hover:bg-gray-800 transition" %>
        <% if params[:version_id].present? %>
          <%= link_to "Clear", std_methods_path, class: "inline-flex items-center px-4 py-2 rounded-md border border-gray-200 text-sm text-gray-700 hover:bg-gray-50" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div
    class="space-y-3"
    data-controller="table-row-filter"
    data-table-row-filter-save-url-value="<%= index_filters_std_methods_path %>"
    data-table-row-filter-initial-filter-value="<%= h(@table_filter) %>"
    data-table-row-filter-initial-columns-only-value="<%= @columns_only %>"
  >
    <div class="rounded-lg border border-gray-200 bg-white shadow-sm p-4">
      <label class="block text-sm font-medium text-gray-700 mb-1" for="std_methods_table_filter">Filter table</label>
      <input
        type="search"
        id="std_methods_table_filter"
        autocomplete="off"
        placeholder="Type to filter by any text in standard method or step fields"
        value="<%= h(@table_filter) %>"
        class="w-full max-w-xl rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900"
        data-table-row-filter-target="input"
        data-action="input->table-row-filter#filter"
      />
      <div class="mt-3 flex items-start gap-2">
        <input
          type="checkbox"
          id="std_methods_table_filter_columns_only"
          class="mt-1 rounded border-gray-300 text-gray-900 focus:ring-gray-900"
          <%= 'checked' if @columns_only %>
          data-table-row-filter-target="columnsOnly"
          data-action="change->table-row-filter#filter"
        />
        <label for="std_methods_table_filter_columns_only" class="text-sm text-gray-700">
          Only search the columns shown in the table (ID, Step, Name, Label, Program, Speed, Used)
        </label>
      </div>
    </div>

    <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50 text-xs font-semibold uppercase tracking-wide text-gray-600">
          <tr>
            <th scope="col" class="px-3 py-2 text-left">ID</th>
            <th scope="col" class="px-3 py-2 text-left">Step</th>
            <th scope="col" class="px-3 py-2 text-left">Name</th>
            <th scope="col" class="px-3 py-2 text-left">Label</th>
            <th scope="col" class="px-3 py-2 text-left">Program</th>
            <th scope="col" class="px-3 py-2 text-left">Speed</th>
            <th scope="col" class="px-3 py-2 text-left">Used</th>
            <th scope="col" class="px-3 py-2 text-right"></th>
          </tr>
        </thead>
        <tbody
          class="divide-y divide-gray-100 text-sm text-gray-700"
          data-table-row-filter-target="tbody"
        >
          <% @std_methods.each do |std_method| %>
            <%= tag.tr data: {
              row_filter_text: std_method_index_row_filter_text(std_method),
              row_filter_columns: std_method_index_row_filter_text_table_columns(std_method)
            } do %>
              <td class="px-3 py-2"><%= std_method.id %></td>
              <td class="px-3 py-2">
                <% if std_method.step %>
                  <%= link_to std_method.step.label || std_method.step.name, step_path(std_method.step), class: 'text-gray-600 hover:text-gray-800' %>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="px-3 py-2">
                <span class="font-medium text-gray-900"><%= std_method.name.presence || '—' %></span>
              </td>
              <td class="px-3 py-2 text-gray-700"><%= std_method.label.presence || '—' %></td>
              <td class="px-3 py-2 text-gray-700"><%= std_method.command_program.presence || '—' %></td>
              <td class="px-3 py-2 text-gray-700"><%= std_method.speed_id.presence || '—' %></td>
              <td class="px-3 py-2">
                <% if std_method.obsolete == false %>
                  <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">yes</span>
                <% else %>
                  <span class="inline-flex items-center rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700">no</span>
                <% end %>
              </td>
              <td class="px-3 py-2 text-right">
                <%= link_to 'Show', std_method_path(std_method), class: 'text-gray-600 hover:text-gray-800' %>
                <% if can_edit_synced_reference_data? %>
                  <span class="mx-2 text-gray-300">|</span>
                  <%= link_to 'Edit', edit_std_method_path(std_method), class: 'text-gray-600 hover:text-gray-800' %>
                  <span class="mx-2 text-gray-300">|</span>
                  <button type="button"
                          class="text-red-600 hover:text-red-700 bg-transparent border-0 p-0 cursor-pointer text-sm font-normal"
                          data-action="click->confirm-delete#open"
                          data-confirm-delete-url-param="<%= std_method_path(std_method) %>"
                          data-confirm-delete-label-param="<%= std_method.label.presence || std_method.name.presence || "Standard method ##{std_method.id}" %>">
                    Destroy
                  </button>
                <% end %>
              </td>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% if @std_methods.empty? %>
    <div class="rounded-lg border border-dashed border-gray-300 bg-white px-6 py-10 text-center text-gray-500">
      No standard methods have been recorded yet.
    </div>
  <% end %>

  <%= render "shared/confirm_delete_modal" %>
</div>

