      </button>
      <button type="button"
              style="border: 1px solid #2563eb; background: #2563eb; color: #fff; border-radius: 6px; padding: 6px 12px; cursor: pointer; font-size: 13px;"
              onclick="if (window.visualizationController) window.visualizationController.confirmSaveCheckpoint(event)">
        Save
      </button>
    </div>
  </div>
</div>

