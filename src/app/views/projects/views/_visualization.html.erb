    _annotPopupData.evidences.loading = false
    if (data && data.message != null) _annotPopupData.evidences.message = data.message
    if (data && data.run_id != null) _annotPopupData.evidences.runId = data.run_id
    if (state === 'queued' && data) {
      _annotPopupData.evidences.markersQueueBase = data.markers_queue_base != null ? data.markers_queue_base : ''
      _annotPopupData.evidences.markersQueueNote = data.markers_queue_note != null ? data.markers_queue_note : ''
