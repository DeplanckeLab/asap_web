<%# Standard Form for Creating New Runs %>
<% obj_name = 'req' %>

<% 
  h_methods = {}
  asap_docker_image = Basic.get_asap_docker(@project.version)
  tool_versions = if asap_docker_image
    Basic.safe_parse_json(asap_docker_image.tool_versions_json.presence || asap_docker_image.tools_json, {})
  else
    {}
  end
  @std_methods.each do |f|
    label = f.label.presence || f.name
    logo_url = method_package_logo_url(label, tool_versions)
    h_methods[f.id] = [(f.speed_id rescue nil), f.description, (f.link rescue ''), logo_url]
  end
%>

<%= form_for(@req, method: 'post', 
    html: { 
      id: @step.name + '_form',
      class: 'std-form-req flex flex-col flex-1 min-h-0',
      'data-controller' => 'form-req',
      'data-form-req-project-id-value' => @project.id,
      'data-form-req-project-key-value' => @project.key,
      'data-form-req-step-id-value' => @step.id,
      'data-form-req-step-name-value' => @step.name,
      'data-form-req-action-button-label-value' => (@h_step_attrs['action_button_label'] || 'Submit'),
      'data-form-req-submit-url-value' => reqs_path,
      'data-form-req-upd-pred-url-value' => upd_pred_project_path(@project),
      'data-form-req-step-results-url-value' => step_results_project_path(@project),
      'data-form-req-unavailable-methods-value' => @h_unavailable_methods.to_json,
      'data-form-req-methods-value' => h_methods.to_json
    }
  ) do |f| %>
  <div class="std-form-req-body flex-1 min-h-0 overflow-y-auto overflow-x-hidden px-6 py-5 space-y-6">
  <% if @project.errors.any? %>
    <div id="error_explanation" class="alert alert-danger flex items-start gap-3 mb-4">
      <i class="fas fa-exclamation-circle text-red-600 mt-0.5"></i>
      <div>
        <h4 class="font-semibold mb-2"><%= pluralize(@project.errors.count, "error") %> prohibited this from being saved:</h4>
        <ul class="list-disc list-inside space-y-1">
          <% @project.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <% 
    # Debug: Check if @std_methods is set
    if @std_methods.nil?
      Rails.logger.error("[_form_req] @std_methods is nil!")
    elsif @std_methods.empty?
      Rails.logger.warn("[_form_req] @std_methods is empty for step #{@step&.id} (#{@step&.name})")
    end
    
    @std_methods ||= []
    @h_unavailable_methods ||= {}
    @h_std_methods_by_name ||= {}
    @h_step_attrs ||= {}
  %>
  <% available_methods = @std_methods.select { |s| !@h_unavailable_methods[s.id] } %>
  <% unavailable_methods = @std_methods.select { |s| @h_unavailable_methods[s.id] } %>
  <% @h_obj_attrs_by_std_method ||= {} %>
  <% default_std_method = Basic.resolve_default_std_method(
       project: @project,
       default_method_names: @h_step_attrs['default_std_method'],
       std_methods_by_name: @h_std_methods_by_name,
       h_obj_attrs_by_std_method: @h_obj_attrs_by_std_method,
       available_methods: available_methods
     ) %>

  <% if @step.description.present? %>
    <div class="bg-blue-50 rounded-lg p-4 mb-6">
      <div class="flex items-start gap-3">
        <i class="fas fa-info-circle text-blue-600 mt-0.5"></i>
        <div class="text-sm text-blue-800">
          <%= raw @step.description %>
        </div>
      </div>
    </div>
  <% end %>

  <% if @de_large_dataset_method_notice.present? %>
    <div class="bg-amber-50 rounded-lg p-4 mb-6">
      <div class="text-sm text-amber-900">
        <%= @de_large_dataset_method_notice %>
      </div>
    </div>
  <% end %>

  <% unless @h_step_attrs['hide_method'] %>
    <div class="bg-gray-50 rounded-lg p-4 mb-6 space-y-4">
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0 w-24">
          <%= label_tag 'std_method_id', "Method", { class: 'block text-sm font-medium text-gray-700 pt-2', 'data-toggle' => 'tooltip', 'title' => "" } %>
        </div>
        <div class="flex-1">
          <% 
            # Debug logging
            Rails.logger.info("[_form_req] @std_methods count: #{@std_methods&.count || 0}")
            Rails.logger.info("[_form_req] @h_obj_attrs_by_std_method keys: #{@h_obj_attrs_by_std_method&.keys&.inspect}")
            Rails.logger.info("[_form_req] @h_unavailable_methods: #{@h_unavailable_methods&.inspect}")
            
            filtered_methods = @std_methods.select { |s|
              Basic.std_method_project_type_compatible?(@project, std_method: s, obj_attrs: @h_obj_attrs_by_std_method[s.id])
            }.sort_by { |m| m.label }
            
            Rails.logger.info("[_form_req] Filtered methods count: #{filtered_methods.count}")
            
            # Set default value (must be in filtered_methods)
            default_value = if default_std_method && filtered_methods.include?(default_std_method)
              default_std_method.id
            else
              filtered_methods.find { |m| !@h_unavailable_methods[m.id] }&.id
            end
          %>
          <% if filtered_methods.empty? %>
            <div class="text-red-600 text-sm p-2">
              No methods available for this step.
            </div>
          <% else %>
            <%
              selected_method = filtered_methods.find { |m| m.id == default_value }
              selected_label = selected_method ? (selected_method.label || selected_method.name).to_s : 'Select a method'
              selected_is_recommended = selected_method.present? && default_std_method.present? && selected_method.id == default_std_method.id
            %>
            <div class="flex items-center gap-3">
              <div class="relative flex-1 min-w-0">
                <button type="button"
                        data-form-req-target="methodDropdownButton"
                        data-action="click->form-req#toggleMethodDropdown"
                        class="w-full rounded-md border border-gray-300 px-3 py-2 text-left shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 bg-white flex items-center justify-between">
                  <span class="text-gray-900 font-medium flex items-center gap-2 flex-wrap min-w-0"
                        data-form-req-target="methodDropdownText">
                    <% if selected_is_recommended %>
                      <span data-recommendation-badge="1"
                            class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-medium text-emerald-800">Recommended</span>
                    <% end %>
                    <span data-option-label="1"><%= selected_label %></span>
                  </span>
                  <span class="ml-2 text-gray-400 flex-shrink-0">▼</span>
                </button>
                <div data-form-req-target="methodDropdownMenu"
                     class="hidden absolute z-50 top-full left-0 w-full max-h-96 overflow-auto rounded-md border border-gray-300 bg-white shadow-lg mt-1">
                  <div class="py-1">
                    <% filtered_methods.each do |method| %>
                      <%
                        is_unavailable = @h_unavailable_methods[method.id] == true
                        is_recommended = default_std_method.present? && method.id == default_std_method.id
                        is_selected = method.id == default_value
                        label = method.label || method.name
                        logo_url = method_package_logo_url(label, tool_versions)
                        option_classes = ['w-full text-left flex items-start px-4 py-3 border-b border-gray-100 last:border-b-0']
                        if is_unavailable
                          option_classes << 'opacity-60 cursor-not-allowed bg-gray-50'
                        else
                          option_classes << 'hover:bg-gray-50 cursor-pointer'
                        end
                        option_classes << 'bg-blue-50' if is_selected
                      %>
                      <button type="button"
                              data-form-req-target="methodOption"
                              data-action="click->form-req#selectMethod"
                              data-method-id="<%= method.id %>"
                              data-method-label="<%= label %>"
                              data-recommended="<%= is_recommended ? '1' : '0' %>"
                              data-unavailable="<%= is_unavailable ? '1' : '0' %>"
                              <%= 'disabled' if is_unavailable %>
                              class="<%= option_classes.join(' ') %>">
                        <div class="flex-1 min-w-0">
                          <div class="font-medium text-gray-900 flex items-center gap-2 flex-wrap">
                            <% if is_recommended %>
                              <span data-recommendation-badge="1"
                                    class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-medium text-emerald-800">Recommended</span>
                            <% end %>
                            <span data-option-label="1" class="<%= 'text-red-600 italic' if is_unavailable %>"><%= label %></span>
                            <% if is_unavailable %>
                              <span class="text-xs text-red-600 italic">(not available)</span>
                            <% end %>
                          </div>
                        </div>
                        <% if logo_url.present? %>
                          <img src="<%= logo_url %>" alt="" class="ml-3 h-8 w-auto max-w-[4.5rem] flex-shrink-0 object-contain" />
                        <% end %>
                      </button>
                    <% end %>
                  </div>
                </div>
                <%= f.hidden_field :std_method_id,
                      value: default_value,
                      id: 'req_std_method_id',
                      data: { form_req_target: 'methodSelect' } %>
              </div>
              <img data-form-req-target="methodLogo" class="hidden h-10 w-auto max-w-[6rem] flex-shrink-0 object-contain" alt="" />
            </div>
          <% end %>
        </div>
      </div>
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0 w-24">
          <% if defined?(Speed) %>
            <% Speed.all.each do |s| %>
              <%= image_tag 'speed_' + s.name + '.png', id: 'speed_' + s.id.to_s, class: 'speed_image hidden', width: '25px', alt: "Estimated run speed: #{s.name}" %>
            <% end %>
          <% end %>
        </div>
        <div class="flex-1">
          <div id="method_desc" class="text-sm text-gray-700 mb-1" data-form-req-target="methodDesc"></div>
          <div id="method_pred" class="text-xs text-gray-500 mt-1" data-form-req-target="methodPred"></div>
          <div class="hidden mt-2 text-sm text-amber-800 border border-amber-200 bg-amber-50 rounded-md px-3 py-2" data-form-req-target="predictionPrevent" role="alert"></div>
          <%= hidden_field_tag :pred_process_duration %>
          <%= hidden_field_tag :pred_max_ram %>
        </div>
      </div>
    </div>
  <% else %>
    <%= f.hidden_field :std_method_id, value: default_std_method&.id %>
  <% end %>

  <div id="attrs_container" class="space-y-4" data-form-req-target="attrsContainer"></div>

  <%= f.hidden_field :step_id, value: @step.id %>
  <%= hidden_field_tag :format, 'json' %>
  </div>

  <% unless @h_step_attrs["hide_submit_btns"] %>
    <div class="std-form-req-footer flex-shrink-0 border-t border-gray-200 px-6 bg-white z-10">
      <div id="prevent_req_messages" class="alert alert-danger hidden mb-2" data-form-req-target="errorMessages"></div>
      <div class="flex flex-wrap items-center justify-end gap-x-3 gap-y-2 leading-none">
        <% if analyzable?(@project) %>
          <button id="<%= @step.name %>_button" type="button" 
                  class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-medium transition-colors opacity-50 cursor-not-allowed req_submit"
                  disabled
                  data-form-req-target="submitButton"
                  data-action="click->form-req#submit">
            <%= @h_step_attrs['action_button_label'] || 'Submit' %>
          </button>
        <% else %>
          <button id="<%= @step.name %>_button" type="button" disabled
                  class="px-4 py-2 bg-gray-300 text-gray-500 rounded-md font-medium cursor-not-allowed"
                  title="You need analysis rights to run new analyses">
            <%= @h_step_attrs['action_button_label'] || 'Submit' %>
          </button>
        <% end %>
        <button id="form_req_cancel" type="button" 
                class="px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-md font-medium transition-colors cursor-pointer"
                data-action="click->form-req#cancel">Cancel</button>
      </div>
    </div>
  <% end %>
<% end %>

