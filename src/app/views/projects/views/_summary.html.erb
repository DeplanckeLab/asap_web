<div class='row mt-3'>
  <!-- Main Content (no left panel on summary page) -->
  <div class="col-md-12">
    <div class="card shadow-sm" style="border: 1px solid #dee2e6;">
      <div class="card-header bg-primary text-white" style="border-bottom: 2px solid #0056b3;">
        <h5 class="mb-0 font-weight-bold">
          <i class="fas fa-list-ol me-2"></i>Pipeline Steps
        </h5>
      </div>
      <div class="list-group list-group-flush">
        <% if @steps_with_status && @steps_with_status.any? %>
          <% @steps_with_status.each do |step_info| %>
            <% step = step_info[:step] %>
            <% is_current = step_info[:is_current] %>
            <% is_available = step_info[:is_available] %>
            <% is_complete = step_info[:is_complete] %>
            <% status = step_info[:status] %>
            
            <% 
              # Determine CSS classes
              item_classes = 'list-group-item'
              item_style = ''
              if is_current
                item_classes += ' active'
                item_style = 'background-color: #007bff; border-left: 4px solid #0056b3;'
              elsif !is_available
                item_classes += ' disabled'
                item_style = 'opacity: 0.5; cursor: not-allowed; background-color: #f8f9fa;'
              else
                item_style = 'border-left: 4px solid transparent;'
              end
              
              # Determine text color
              text_class = if is_current
                            'text-white'
                          elsif !is_available
                            'text-muted'
                          elsif is_complete
                            'text-success'
                          else
                            'text-dark'
                          end
            %>
            
            <div class="<%= item_classes %> <%= text_class %>" style="<%= item_style %> padding: 12px 16px; border-bottom: 1px solid #e9ecef;">
              <div class="d-flex align-items-start">
                <div class="flex-shrink-0 me-3 mt-1">
                  <% if is_current %>
                    <i class="fas fa-arrow-right fa-lg"></i>
                  <% elsif is_complete %>
                    <i class="fas fa-check-circle fa-lg text-success"></i>
                  <% elsif status == 'running' %>
                    <i class="fas fa-spinner fa-spin fa-lg text-info"></i>
                  <% elsif status == 'waiting' %>
                    <i class="fas fa-clock fa-lg text-warning"></i>
                  <% elsif status == 'failed' %>
                    <i class="fas fa-exclamation-circle fa-lg text-danger"></i>
                  <% else %>
                    <i class="far fa-circle fa-lg" style="opacity: 0.3;"></i>
                  <% end %>
                </div>
                <div class="flex-grow-1">
                  <div class="mb-1">
                    <strong class="d-block"><%= step.label.presence || step.name %></strong>
                    <% if step.rank %>
                      <small class="text-muted">Rank: <%= step.rank %></small>
                    <% end %>
                  </div>
                  <% if status != 'not_started' && status.present? %>
                    <div class="mt-2">
                      <span class="badge badge-<%= case status
                                                    when 'complete' then 'success'
                                                    when 'running' then 'info'
                                                    when 'waiting' then 'warning'
                                                    when 'failed' then 'danger'
                                                    else 'secondary'
                                                    end %>">
                        <%= status.humanize %>
                      </span>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="list-group-item text-center py-4">
            <p class="text-muted mb-0">No steps available</p>
            <% if admin? %>
              <small class="text-muted d-block mt-2">
                Debug info:<br/>
                @steps_with_status present: <%= @steps_with_status.present? %><br/>
                @steps_with_status count: <%= @steps_with_status&.count || 0 %><br/>
                @pretreatment_steps count: <%= @pretreatment_steps&.count || 0 %><br/>
                @all_project_steps count: <%= @all_project_steps&.count || 0 %>
              </small>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    <div class="card shadow-sm mb-4" style="border: 1px solid #dee2e6;">
      <div class="card-body">
            <h4 class="mb-3">
              <i class="fas fa-cog me-2"></i>Reproducibility
            </h4>
            <div class="mb-4">
              <%= link_to(raw("<button class='btn btn-outline-info me-2 mb-2'><i class='fas fa-book me-1'></i>Instructions</button>"), instructions_project_path(@project.key), "target" => "_blank") %>
              <%= link_to raw("<button class='btn btn-outline-secondary me-2 mb-2'><i class='fas fa-list me-1'></i>List of commands</button>"), get_commands_project_path(@project.key), {:class => 'btn btn-outline-secondary'} %>
              <%= link_to(raw("<button class='btn btn-outline-secondary me-2 mb-2'><i class='fas fa-file me-1'></i>Initial Loom file</button>"), get_file_project_path(@project.key, :step => 'parsing', :filename => 'output.loom'), "target" => "_blank") if exportable?(@project) %>
            </div>
            
            <h4 class='mt-4 mb-3'>
              <i class="fas fa-download me-2"></i>Programmatic access & Downloads
            </h4>
            <div class="mb-4">
              <%= link_to raw("<button class='btn btn-outline-secondary me-2 mb-2'><i class='fas fa-code me-1'></i>List of Loom files (JSON)</button>"), get_loom_files_json_project_path(@project.key, {:download => 1}), {:class => 'btn btn-outline-secondary'} %>
              <button id='loom_files_btn' class='btn btn-outline-secondary me-2 mb-2'>
                <i class="fas fa-download me-1"></i>Downloads (Loom/H5AD)
              </button>
            </div>
            
            <h4 class='mt-4 mb-3'>
              <i class="fas fa-project-diagram me-2"></i>Pipeline
              <% if session[:activated_filter] && session[:activated_filter][@project.id] == true %>
                <span class="badge badge-info">(filtered)</span>
              <% end %>
            </h4>
            <div id="cy" class="cy mb-4" style="min-height: 300px; border: 1px solid #dee2e6; border-radius: 4px; background-color: #f8f9fa;"></div>
