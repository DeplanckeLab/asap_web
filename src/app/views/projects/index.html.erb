<% content_for :title, "Browse Projects" %>
<% content_for :meta_description, "Search and browse public single-cell transcriptomics projects on ASAP." %>
<% sandbox_idle_days = ENV.fetch('SANDBOX_DELETE_IDLE_DAYS', '1').to_i %>

<div class="min-h-screen bg-gray-50">
  <% gt_demo = guided_tour_demo_project_for_highlight %>
  <div class="w-full mx-auto px-3 sm:px-4 lg:px-6 py-8">
    <% if notice.present? %>
      <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg">
        <p class="text-green-800"><%= notice %></p>
      </div>
    <% end %>

    <!-- Header -->
    <div class="mb-8 flex items-start justify-between gap-4" data-guided-tour="projects-browse-header">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Search projects</h1>
        <p class="text-gray-600">Search and explore ASAP projects</p>
      </div>
      <% if user_signed_in? %>
        <%= link_to "New Project", new_project_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 whitespace-nowrap", data: { guided_tour: "projects-new-project-link" } %>
      <% else %>
        <%= render "shared/guest_sandbox_cta", variant: :compact %>
      <% end %>
    </div>

    <!-- Search Form -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-8 relative">
      <%= form_with url: projects_path, method: :get, local: true, class: "space-y-6", data: { controller: "search-form", guided_tour: "projects-search-form-section" } do |form| %>
        <div class="absolute top-6 right-6">
          <%= link_to "Clear form", projects_path, class: "text-xs text-gray-500 hover:text-gray-700 underline" %>
        </div>
        <!-- Search Bar -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
          <div class="<%= current_user.present? ? 'md:col-span-8' : 'md:col-span-12' %>">
            <label for="q" class="block text-sm font-medium text-gray-700 mb-2">Search Projects</label>
            <div class="flex items-stretch">
              <div class="relative flex-1">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                </div>
                <%= form.text_field :q, value: @query, placeholder: "Search by name, description, technology...",
                    class: "block w-full h-10 pl-10 pr-3 border border-gray-300 rounded-l-md rounded-r-none leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-blue-500 focus:border-blue-500" %>
              </div>
              <%= form.submit "Search", class: "h-10 px-4 border border-l-0 border-gray-300 rounded-r-md bg-blue-600 text-white hover:bg-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500 whitespace-nowrap", data: { guided_tour: "projects-search-submit" } %>
            </div>
          </div>
          <% if current_user.present? %>
            <div class="md:col-span-4">
              <label class="block text-sm font-medium text-gray-700 mb-2">Visibility</label>
              <% visibility = @filters[:visibility].presence || 'all' %>
              <div class="inline-flex rounded-md shadow-sm border border-gray-300 overflow-hidden">
                <label class="cursor-pointer">
                  <%= form.radio_button :visibility, 'all', checked: visibility == 'all', class: "sr-only peer", data: { action: "change->search-form#submitNow" } %>
                  <span class="inline-flex items-center px-3 py-2 text-sm font-medium text-gray-700 bg-white border-r border-gray-300 peer-checked:bg-blue-600 peer-checked:text-white">All</span>
                </label>
                <label class="cursor-pointer">
                  <%= form.radio_button :visibility, 'private', checked: visibility == 'private', class: "sr-only peer", data: { action: "change->search-form#submitNow" } %>
                  <span class="inline-flex items-center px-3 py-2 text-sm font-medium text-gray-700 bg-white border-r border-gray-300 peer-checked:bg-blue-600 peer-checked:text-white">Private</span>
                </label>
                <label class="cursor-pointer">
                  <%= form.radio_button :visibility, 'public', checked: visibility == 'public', class: "sr-only peer", data: { action: "change->search-form#submitNow" } %>
                  <span class="inline-flex items-center px-3 py-2 text-sm font-medium text-gray-700 bg-white peer-checked:bg-blue-600 peer-checked:text-white">Public</span>
                </label>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Filters Row -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4" data-guided-tour="projects-filter-row">
          <!-- Organism Filter -->
          <div data-controller="organism-selector">
            <label class="block text-sm font-medium text-gray-700 mb-2">Organism</label>
            <div class="relative" data-test="organism-selector-container">
              <% selected_organism_id = @filters[:organism_id].present? ? @filters[:organism_id].to_i : nil %>
              <input type="hidden" name="organism_id" value="<%= selected_organism_id || '' %>" data-organism-selector-target="hiddenInput" data-action="change->search-form#submitNow" />

              <!-- Dropdown button -->
              <button type="button"
                      class="w-full px-3 py-2 text-left border border-gray-300 rounded-md bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 flex items-center justify-between"
                      data-organism-selector-target="dropdownButton"
                      data-action="click->organism-selector#toggleDropdown">
                <span data-organism-selector-target="selectedText">
                  <% if selected_organism_id.present? %>
                    <% selected_org = @organisms.find { |o| o.id == selected_organism_id } %>
                    <%= selected_org&.display_name || "All organisms" %>
                  <% else %>
                    All organisms
                  <% end %>
                </span>
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-organism-selector-target="chevron">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>

              <!-- Dropdown menu -->
              <div class="hidden absolute z-10 w-full mt-1 bg-white border border-gray-200 rounded-md shadow-lg max-h-96 overflow-y-auto"
                   data-organism-selector-target="dropdownMenu">
                <div class="sticky top-0 z-10 bg-white border-b border-gray-200 p-2">
                  <input type="text"
                         class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                         placeholder="Search organisms..."
                         autocomplete="off"
                         data-organism-selector-target="searchInput"
                         data-action="input->organism-selector#filterOptions click->organism-selector#preventDropdownCloseOnInput keydown->organism-selector#preventDropdownCloseOnInput">
                </div>
                <!-- All organisms option -->
                <button type="button"
                        class="w-full px-4 py-2 text-left text-sm text-gray-700 hover:bg-blue-50 transition-colors font-medium border-b border-gray-100 <%= 'bg-blue-50' unless selected_organism_id.present? %>"
                        data-organism-id=""
                        data-organism-selector-target="option"
                        data-action="click->organism-selector#selectOrganism">
                  All organisms
                </button>
                <% (@grouped_organisms || {}).each do |domain, organisms| %>
                  <div class="organism-group">
                    <!-- Group header (collapsible) -->
                    <button type="button"
                            class="w-full px-4 py-2 text-left text-sm font-semibold text-gray-700 bg-gray-50 hover:bg-gray-100 flex items-center"
                            data-organism-selector-target="groupHeader"
                            data-action="click->organism-selector#toggleGroup">
                      <div class="mr-3" style="color: #9ca3af;">
                        <i class="fas fa-chevron-right" style="font-size: 14px; transition: transform 0.3s ease-out;" data-organism-selector-target="groupChevron"></i>
                      </div>
                      <span class="flex-1"><%= domain %></span>
                      <span class="inline-flex items-center justify-center px-2 py-1 text-xs font-semibold rounded-full bg-gray-200 text-gray-700 ml-2"
                            data-organism-selector-target="groupCount"
                            data-total-count="<%= organisms.count %>">
                        <%= organisms.count %>
                      </span>
                    </button>

                    <!-- Group content (collapsible) -->
                    <div class="hidden" data-organism-selector-target="groupContent">
                      <% organisms.each do |organism_data| %>
                        <%
                          display_name = organism_data[0]
                          organism_id = organism_data[1]
                          tax_id = organism_data[2]
                        %>
                        <button type="button"
                                class="w-full px-6 py-2 text-left text-sm text-gray-700 hover:bg-blue-50 transition-colors <%= 'bg-blue-50 font-medium' if organism_id == selected_organism_id %>"
                                data-organism-id="<%= organism_id %>"
                                data-search-text="<%= [display_name, tax_id].compact.join(' ').downcase %>"
                                data-organism-selector-target="option"
                                data-action="click->organism-selector#selectOrganism">
                          <span><%= display_name %></span>
                          <% if tax_id.present? %>
                            <span class="text-gray-500 ml-2 text-xs"><%= tax_id %></span>
                          <% end %>
                        </button>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Project Type Filter -->
          <div>
            <label for="project_type_id" class="block text-sm font-medium text-gray-700 mb-2">Project type</label>
            <%= form.select :project_type_id,
                options_from_collection_for_select(@project_types, :id, :name, @filters[:project_type_id]),
                { prompt: "All project types" },
                { class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500", data: { action: "change->search-form#submitNow" } } %>
          </div>

          <!-- Tissue Filter -->
          <div>
            <label for="tissue" class="block text-sm font-medium text-gray-700 mb-2">Tissue</label>
            <%= form.select :tissue, 
                options_for_select(@tissues, @filters[:tissue]), 
                { prompt: "All tissues" }, 
                { class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500", data: { action: "change->search-form#submitNow" } } %>
          </div>

          <!-- Status Filter -->
          <div>
            <label for="status_id" class="block text-sm font-medium text-gray-700 mb-2">Status</label>
            <%= form.select :status_id, 
                options_from_collection_for_select(@statuses, :id, :display_name, @filters[:status_id]), 
                { prompt: "All statuses" }, 
                { class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500", data: { action: "change->search-form#submitNow" } } %>
          </div>
        </div>

        <!-- Additional Filters Row -->
      <% end %>
    </div>

    <!-- Results Header and Projects Container -->
    <h2 class="text-xl font-semibold text-gray-900 mb-4" data-guided-tour="projects-results-section">Search results</h2>
    <div data-controller="project-selection delete-projects integrate-projects search-run-status search-projects-refresh"
         data-delete-projects-url-value="<%= bulk_destroy_projects_path %>"
         data-integrate-projects-url-value="<%= prepare_integrate_projects_path %>"
         data-search-projects-refresh-url-value="<%= search_snapshot_projects_path(q: @query, organism_id: @filters[:organism_id], project_type_id: @filters[:project_type_id], tissue: @filters[:tissue], status_id: @filters[:status_id], visibility: @filters[:visibility], sort: @filters[:sort], page: @current_page) %>"
         data-search-projects-refresh-total-count-value="<%= @total_count %>"
         data-search-projects-refresh-ids-value="<%= @projects.map(&:id).join(',') %>"
         data-search-projects-refresh-interval-value="10000">
      <div class="flex flex-col gap-3 md:flex-row md:justify-between md:items-center mb-6">
        <div class="text-sm text-gray-600">
          <% if @projects.any? %>
            Showing <%= (@current_page - 1) * @per_page + 1 %>-<%= [@current_page * @per_page, @total_count].min %> of <%= @total_count %> projects
          <% else %>
            No projects found
          <% end %>
        </div>
        
        <div class="flex flex-wrap items-center gap-3" data-guided-tour="projects-results-toolbar">
          <%= form_with url: projects_path, method: :get, local: true, class: "flex flex-wrap items-center gap-2 max-w-full" do |sort_form| %>
            <%= hidden_field_tag :q, @query %>
            <%= hidden_field_tag :organism_id, @filters[:organism_id] %>
            <%= hidden_field_tag :project_type_id, @filters[:project_type_id] %>
            <%= hidden_field_tag :tissue, @filters[:tissue] %>
            <%= hidden_field_tag :status_id, @filters[:status_id] %>
            <%= hidden_field_tag :visibility, @filters[:visibility] %>
            <label for="sort_toolbar" class="text-sm font-medium text-gray-700 whitespace-nowrap">Sort by</label>
            <%= sort_form.select :sort,
                options_for_select([
                  ['Most Recent', 'created_at'],
                  ['Name (A-Z)', 'name'],
                  ['Most Views', 'views'],
                  ['Last Updated', 'updated_at']
                ], @filters[:sort]),
                {},
                {
                  id: "sort_toolbar",
                  class: "block w-full sm:w-56 px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500",
                  onchange: "this.form.requestSubmit()"
                } %>
          <% end %>
          <% if @v8_active_for_integration %>
            <button type="button"
                    class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-green-600 rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-green-600 hover:bg-green-700"
                    data-project-selection-target="integrateButton"
                    data-action="click->integrate-projects#integrateSelected"
                    disabled>
              <i class="fas fa-object-group mr-2"></i>
              <span data-project-selection-target="integrateButtonText">Integrate selected</span>
            </button>
          <% end %>
          <button type="button"
                  class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-red-600 hover:bg-red-700"
                  data-project-selection-target="deleteButton"
                  data-action="click->delete-projects#deleteSelected"
                  disabled>
            <i class="fas fa-trash-alt mr-2"></i>
            <span data-project-selection-target="deleteButtonText">Delete selected</span>
          </button>
        </div>
      </div>

      <!-- Projects Container -->
    <% if @projects.any? %>
      <div>
        <!-- Action Bar -->
        <div class="flex items-center gap-3 mb-3">
          <span class="text-sm text-gray-500" data-project-selection-target="selectedCount"></span>
          <button type="button"
                  class="hidden text-sm text-blue-600 hover:text-blue-800 underline"
                  data-project-selection-target="clearButton"
                  data-action="click->project-selection#clearSelection">
            Clear selection
          </button>
        </div>

        <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="pl-4 pr-2 py-3 w-10">
                  <input type="checkbox"
                         class="rounded border-gray-300 text-red-600 focus:ring-red-500"
                         data-action="change->project-selection#toggleAll"
                         data-project-selection-target="selectAll">
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Project</th>
                <% if admin? %>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User</th>
                <% end %>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Organism</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Technology</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Columns</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Rows</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Runs</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Updated</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @projects.each do |project| %>
                <tr class="hover:bg-gray-100 cursor-pointer transition-colors">
                  <td class="pl-4 pr-2 py-4 w-10" onclick="event.stopPropagation()">
                    <input type="checkbox"
                           class="rounded border-gray-300 text-red-600 focus:ring-red-500"
                           value="<%= project.id %>"
                           data-single-cell="<%= project.single_cell? %>"
                           data-project-type-unknown="<%= project.project_type_id.nil? %>"
                           data-project-name="<%= project.display_name %>"
                           data-settings-url="<%= project_path(project, view: 'settings') %>"
                           data-action="change->project-selection#updateSelection"
                           data-project-selection-target="checkbox">
                  </td>
                  <td class="px-6 py-4" onclick="window.location='<%= project_path(project) %>'">
                    <div>
                      <div class="text-sm font-medium text-gray-900">
                        <%= project.display_name %>
                      </div>
                      <div class="flex items-center gap-2 mt-0.5">
                        <% archive_icon = project.archive_status_icon_class_for_display %>
                        <% if archive_icon.present? %>
                          <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-gray-100 text-gray-700"
                                title="Archive status: <%= project.archive_status_label_for_display %>">
                            <i class="<%= archive_icon %> text-xs"></i>
                          </span>
                        <% end %>
                        <% if project.key.present? %>
                          <span class="text-xs text-gray-400 font-mono"><%= project.key %></span>
                        <% end %>
                        <% if project.public_id.present? %>
                          <span class="inline-flex items-center px-1.5 py-0 rounded text-xs font-medium bg-green-100 text-green-800">ASAP<%= project.public_id %></span>
                        <% end %>
                        <% if project.version_id.present? %>
                          <span class="inline-flex items-center px-1.5 py-0 rounded text-xs font-medium bg-gray-100 text-gray-700"
                                title="ASAP release">
                            v<%= project.version_id %>
                          </span>
                        <% end %>
                        <% project.provider_projects.filter_map(&:provider).uniq(&:id).each do |provider| %>
                          <span class="inline-flex items-center px-1.5 py-0 rounded text-xs font-medium bg-teal-100 text-teal-800"
                                title="Origin: <%= provider.display_name %>">
                            <%= provider.tag.presence || provider.display_name %>
                          </span>
                        <% end %>
                      </div>
                    </div>
                  </td>
                  <% if admin? %>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" onclick="window.location='<%= project_path(project) %>'">
                      <%= project.user&.email.presence || '-' %>
                    </td>
                  <% end %>
                  <td class="px-6 py-4 whitespace-nowrap text-sm" onclick="window.location='<%= project_path(project) %>'">
                    <% if project.project_type.present? && project.project_type.tag.present? %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800"
                            title="<%= project.project_type.name %>">
                        <%= project.project_type.tag %>
                      </span>
                    <% else %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800"
                            title="Project type not set">
                        ?
                      </span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" onclick="window.location='<%= project_path(project) %>'">
                    <%= project.organism_display %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" onclick="window.location='<%= project_path(project) %>'">
                    <%= project.technology_display %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" onclick="window.location='<%= project_path(project) %>'">
                    <span class="block font-medium text-gray-900"><%= number_with_delimiter(project.cell_count) %></span>
                    <span class="block text-xs text-gray-500"><%= col_label(project) %></span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" onclick="window.location='<%= project_path(project) %>'">
                    <span class="block font-medium text-gray-900"><%= number_with_delimiter(project.gene_count) %></span>
                    <span class="block text-xs text-gray-500"><%= row_label(project) %></span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap" onclick="window.location='<%= project_path(project) %>'"
                      data-search-run-status-target="statusCell"
                      data-project-id="<%= project.id %>">
                    <% run_counts = project_run_counts(project) %>
                    <div class="flex items-center gap-2">
                      <% [:pending, :running, :success, :failed].each do |key| %>
                        <% 
                          config = status_icons_by_key[key]
                          count = run_counts[key]
                          is_active = count > 0
                          icon_class = config[:icon_base]
                          icon_class += " #{config[:icon_spin]}" if is_active && config[:icon_spin].present?
                          color_class = is_active ? config[:active_color] : (config[:inactive_color].presence || 'text-gray-300')
                        %>
                        <div class="flex flex-col items-center" title="<%= run_summary_tooltip_label(key) %>">
                          <i class="<%= icon_class %> text-sm <%= color_class %>"
                             data-search-run-status-target="statusIcon"
                             data-status-key="<%= key %>"
                             data-icon-base="<%= config[:icon_base] %>"
                             data-icon-spin="<%= config[:icon_spin] %>"
                             data-active-color="<%= config[:active_color] %>"
                             data-inactive-color="<%= config[:inactive_color].presence || 'text-gray-300' %>"></i>
                          <span class="text-[9px] leading-tight text-gray-400 mt-0.5"
                                data-search-run-status-target="statusCount"
                                data-status-key="<%= key %>"><%= count %></span>
                        </div>
                      <% end %>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" onclick="window.location='<%= project_path(project) %>'">
                    <%= project.updated_at&.strftime("%b %d, %Y") %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" onclick="event.stopPropagation()">
      		    <div class="flex flex-col items-start gap-2">
		      <div class="flex items-center gap-2">
			<%= link_to "View", project_path(project),
			    class: "inline-flex items-center px-2.5 py-1.5 text-xs font-medium rounded-md text-blue-700 bg-blue-50 hover:bg-blue-100",
			    data: (gt_demo && project.id == gt_demo.id ? { guided_tour: "demo-project-view-list", turbo_prefetch: false } : { turbo_prefetch: false }) %>
			<%= link_to project_path(project, view: 'summary'),
			    class: "inline-flex items-center px-2.5 py-1.5 text-xs font-medium rounded-md text-gray-700 bg-gray-100 hover:bg-gray-200",
			    title: "Summary page (always available, even for archived projects)",
			    onclick: "event.stopPropagation();",
			    data: { turbo_prefetch: false },
			    aria: { label: "Summary page" } do %>
			  <i class="fas fa-circle-info"></i>
			<% end %>

			<% if clonable?(project) && project.version_id.to_i >= 4 %>
			<%= button_to raw('<i class="fas fa-clone mr-1"></i><span>Clone</span>'),
			    clone_project_path(project),
			    method: :post,
			    class: "inline-flex items-center px-2.5 py-1.5 text-xs font-medium rounded-md text-gray-700 bg-gray-100 hover:bg-gray-200 border-0 cursor-pointer",
			    data: {
			      controller: "clone-overlay",
			      action: "click->clone-overlay#handleClick",
			      clone_overlay_confirm_value: "Clone project \"#{project.name.presence || project.key}\"?"
			    },
			    form: { class: "inline-block" } %>
			<% end %>
		      </div>
		      
		      <% if project.sandbox? %>
		      <% sandbox_last_seen_at = project.viewed_at || project.updated_at || project.created_at || Time.current %>
		      <% sandbox_destroy_at = sandbox_last_seen_at + sandbox_idle_days.days %>
		      <% countdown = sandbox_self_destruct_countdown(sandbox_destroy_at) %>
		      
		      <span class="inline-flex items-center px-1.5 py-0 rounded text-xs font-medium bg-amber-100 text-amber-800 border border-amber-200"
			    data-controller="countdown"
			    data-countdown-end-ms-value="<%= (sandbox_destroy_at.to_f * 1000).to_i %>"
			    data-countdown-idle-days-value="<%= sandbox_idle_days %>"
			    title="Sandbox project auto-delete countdown">
			<i class="fas fa-bomb text-[11px]"></i>
			<span class="ml-1 font-semibold font-mono tabular-nums" data-countdown-target="display"><%= countdown %></span>
		      </span>
		      <% end %>
		    </div>
		  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Simple Pagination -->
      <% if @total_count > @per_page %>
        <div class="mt-8 flex justify-center">
          <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
            <% if @current_page > 1 %>
              <%= link_to "Previous", projects_path(page: @current_page - 1, q: @query, organism_id: @filters[:organism_id], project_type_id: @filters[:project_type_id], tissue: @filters[:tissue], status_id: @filters[:status_id], visibility: @filters[:visibility], sort: @filters[:sort]), class: "relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50" %>
            <% end %>
            
            <% total_pages = (@total_count.to_f / @per_page).ceil %>
            <% start_page = [@current_page - 2, 1].max %>
            <% end_page = [@current_page + 2, total_pages].min %>
            
            <% (start_page..end_page).each do |page| %>
              <% if page == @current_page %>
                <span class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-blue-50 text-sm font-medium text-blue-600">
                  <%= page %>
                </span>
              <% else %>
                <%= link_to page, projects_path(page: page, q: @query, organism_id: @filters[:organism_id], project_type_id: @filters[:project_type_id], tissue: @filters[:tissue], status_id: @filters[:status_id], visibility: @filters[:visibility], sort: @filters[:sort]), class: "relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50" %>
              <% end %>
            <% end %>
            
            <% if @current_page < total_pages %>
              <%= link_to "Next", projects_path(page: @current_page + 1, q: @query, organism_id: @filters[:organism_id], project_type_id: @filters[:project_type_id], tissue: @filters[:tissue], status_id: @filters[:status_id], visibility: @filters[:visibility], sort: @filters[:sort]), class: "relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50" %>
            <% end %>
          </nav>
        </div>
      <% end %>
    <% else %>
      <!-- Empty State -->
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No projects found</h3>
        <p class="mt-1 text-sm text-gray-500">
          <% if @query.present? || @filters.values.any?(&:present?) %>
            Try adjusting your search criteria or filters.
          <% else %>
            Get started by creating a <%= user_signed_in? ? 'new project' : 'sandbox project' %>.
          <% end %>
        </p>
        <div class="mt-6">
          <% if user_signed_in? %>
            <%= link_to "New Project", new_project_path, class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          <% else %>
            <div class="inline-flex justify-center">
              <%= render "shared/guest_sandbox_cta", variant: :compact, align: :center %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
