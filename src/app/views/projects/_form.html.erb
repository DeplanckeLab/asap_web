<% file_formats_for_js = (@file_formats || FileFormat.all).each_with_object({}) do |ff, hash| %>
<%   key = ff.name.to_s.upcase %>
<%   next if key.blank? %>
<%   extensions = ff.ext.presence ? ff.ext.split(',').map(&:strip).reject(&:blank?) : [] %>
<%   hash[key] = { color: ff.color.presence || '#6B7280', label: ff.label.presence || key, extensions: extensions } %>
<% end %>
<% file_formats_for_js["UNKNOWN"] ||= { color: '#6B7280', label: '?', extensions: [] } %>
<%= form_with(model: project, local: true, data: { turbo: false }, class: "contents") do |form| %>
  <% if project.errors.any? %>
    <div id="error_explanation" class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-md mb-6">
      <h2 class="font-semibold mb-2"><%= pluralize(project.errors.count, "error") %> prohibited this project from being saved:</h2>
      <ul class="list-disc ml-6">
        <% project.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6" data-guided-tour="project-new-form" data-controller="file-upload organism-selector" data-file-upload-is-admin-value="<%= admin? ? 'true' : 'false' %>" data-file-upload-row-label-value="<%= row_label(project) %>" data-file-upload-col-label-value="<%= col_label(project) %>"<% if defined?(@existing_fu_id) && @existing_fu_id %> data-file-upload-existing-fu-id-value="<%= @existing_fu_id %>" data-file-upload-existing-filename-value="<%= @existing_filename %>"<% end %>>
    <script type="application/json" data-file-upload-target="fileFormatsData">
      <%= raw(file_formats_for_js.to_json) %>
    </script>
    <script type="application/json" data-file-upload-target="projectTypesData">
      <%= raw((@project_types || ProjectType.all).each_with_object({}) { |pt, hash| 
        # Create a temporary project to use the helper methods for proper pluralization
        temp_project = Project.new(project_type: pt)
        hash[pt.id.to_s] = { row_label: row_label(temp_project), col_label: col_label(temp_project) }
      }.to_json) %>
    </script>
    <!-- Project Information Section -->
    <div class="mb-8" data-guided-tour="project-new-project-info">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Project Information</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Project Name -->
        <div class="md:col-span-2" data-guided-tour="project-new-field-name">
          <%= form.label :name, "Project Name", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
          <%= form.text_field :name, 
                class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white #{'border-red-500' if project.errors[:name].any?}", 
                data: { file_upload_target: 'projectName' },
                placeholder: "Name of the project",
                required: true %>
          <% if project.errors[:name].any? %>
            <p class="mt-1 text-sm text-red-600"><%= project.errors[:name].first %></p>
          <% else %>
            <p class="mt-1 text-xs text-red-600 dark:text-red-400">Mandatory</p>
          <% end %>
        </div>

        <div class="md:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-6" data-guided-tour="project-new-type-and-release">
        <!-- Project Type -->
        <div>
          <%= form.label :project_type_id, "Project Type", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
          <% if @integrate_mode %>
            <%= form.select :project_type_id,
                  options_from_collection_for_select(@project_types || [], :id, :name, project.project_type_id),
                  {},
                  { class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-gray-100 dark:bg-gray-600 text-gray-500 dark:text-gray-400 cursor-not-allowed", disabled: true } %>
            <%= form.hidden_field :project_type_id %>
          <% else %>
            <%= form.select :project_type_id,
                  options_from_collection_for_select(@project_types || [], :id, :name, project.project_type_id),
                  { prompt: "Select project type" },
                  { class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white", data: { action: "change->file-upload#checkSubmitButton change->file-upload#updateProjectTypeLabels" } } %>
          <% end %>
          <p class="mt-1 text-xs text-red-600 dark:text-red-400">Mandatory</p>
        </div>

        <!-- ASAP Release -->
        <div>
          <%= form.label :version_id, "ASAP Release", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
          <%= form.select :version_id,
                options_from_collection_for_select(@versions || [], :id, lambda { |v| v.respond_to?(:beta) && v.beta ? "#{v.id} (beta)" : v.id.to_s }, project.version_id),
                { prompt: "Select ASAP release" },
                { class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white", data: { action: "change->file-upload#checkSubmitButton change->organism-selector#reloadOrganisms" } } %>
        </div>
        </div>

        <!-- Organism -->
        <div class="md:col-span-2" data-guided-tour="project-new-field-organism">
          <%= form.label :organism_id, "Organism", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
          <div class="relative" data-test="organism-selector-container">
            <% 
              # Treat organism_id of 1 (database default) as nil for new projects, except in integration mode
              effective_organism_id = (project.new_record? && project.organism_id == 1 && !@integrate_mode) ? nil : project.organism_id
              show_short_name = project.version_id.to_i < 8
            %>
            <%= form.hidden_field :organism_id, value: effective_organism_id || "", data: { organism_selector_target: "hiddenInput", action: "change->file-upload#checkSubmitButton change->organism-selector#syncSelectionFromHiddenInput" } %>
            
            <!-- Dropdown button -->
            <button type="button"
                    class="w-full px-3 py-2 text-left border border-gray-300 dark:border-gray-600 rounded-md <%= @integrate_mode ? 'bg-gray-100 dark:bg-gray-600 text-gray-500 dark:text-gray-400 cursor-not-allowed' : 'bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500' %> flex items-center justify-between"
                    data-organism-selector-target="dropdownButton"
                    <%= 'disabled' if @integrate_mode %>
                    data-action="click->organism-selector#toggleDropdown">
              <span data-organism-selector-target="selectedText">
                <% if effective_organism_id.present? %>
                  <% 
                    selected_org = nil
                    if @organisms.is_a?(Array)
                      # Remote organisms (array of hashes)
                      selected_org = @organisms.find { |o| o.is_a?(Hash) ? o['id'] == effective_organism_id : o.id == effective_organism_id }
                      selected_display = if selected_org.is_a?(Hash)
                        if show_short_name && selected_org['short_name'].present?
                          "#{selected_org['name']} (#{selected_org['short_name']})"
                        else
                          selected_org['name']
                        end
                      else
                        show_short_name && selected_org&.short_name.present? ? "#{selected_org.name} (#{selected_org.short_name})" : selected_org&.name
                      end
                    else
                      # Local organisms (ActiveRecord relation)
                      selected_org = @organisms.find { |o| o.id == effective_organism_id }
                      selected_display = show_short_name && selected_org&.short_name.present? ? "#{selected_org.name} (#{selected_org.short_name})" : selected_org&.name
                    end
                  %>
                  <%= selected_display || "Please select an organism" %>
                <% else %>
                  Please select an organism
                <% end %>
              </span>
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-organism-selector-target="chevron">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            
            <!-- Dropdown menu -->
            <div class="hidden absolute z-10 w-full mt-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-md shadow-lg max-h-96 overflow-y-auto"
                 data-organism-selector-target="dropdownMenu">
              <div class="sticky top-0 z-10 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 p-2">
                <input type="text"
                       class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
                       placeholder="Search organisms..."
                       autocomplete="off"
                       data-organism-selector-target="searchInput"
                       data-action="input->organism-selector#filterOptions click->organism-selector#preventDropdownCloseOnInput keydown->organism-selector#preventDropdownCloseOnInput">
              </div>
              <% (@grouped_organisms || {}).each do |domain, organisms| %>
                <div class="organism-group">
                  <!-- Group header (collapsible) -->
                  <button type="button"
                          class="w-full px-4 py-2 text-left text-sm font-semibold text-gray-700 dark:text-gray-300 bg-gray-50 dark:bg-gray-900 hover:bg-gray-100 dark:hover:bg-gray-800 flex items-center"
                          data-organism-selector-target="groupHeader"
                          data-action="click->organism-selector#toggleGroup">
                    <div class="mr-3" style="color: #9ca3af;">
                      <i class="fas fa-chevron-right" style="font-size: 14px; transition: transform 0.3s ease-out;" data-organism-selector-target="groupChevron"></i>
                    </div>
                    <span class="flex-1"><%= domain %></span>
                    <span class="inline-flex items-center justify-center px-2 py-1 text-xs font-semibold rounded-full bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 ml-2">
                      <%= organisms.count %>
                    </span>
                  </button>
                  
                  <!-- Group content (collapsible) -->
                  <div class="hidden" data-organism-selector-target="groupContent">
                    <% organisms.each do |organism_data| %>
                      <% 
                        # Handle array format: [display_name, organism_id, tax_id]
                        display_name = organism_data[0]
                        organism_id = organism_data[1]
                        tax_id = organism_data[2]
                      %>
                      <button type="button"
                              class="w-full px-6 py-2 text-left text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-900/30 transition-colors <%= 'bg-blue-50 dark:bg-blue-900/30 font-medium' if organism_id == effective_organism_id %>"
                              data-organism-id="<%= organism_id %>"
                              data-search-text="<%= [display_name, tax_id].compact.join(' ').downcase %>"
                              data-organism-selector-target="option"
                              data-action="click->organism-selector#selectOrganism">
                        <span><%= display_name %></span>
                        <% if tax_id.present? %>
                          <span class="text-gray-500 dark:text-gray-400 ml-2 text-xs"><%= tax_id %></span>
                        <% end %>
                      </button>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
          <p class="mt-1 text-xs text-red-600 dark:text-red-400">Mandatory</p>
        </div>

      </div>
    </div>

    <% if @integrate_mode && @integrate_projects&.any? %>
      <!-- Integration Section (replaces file upload) -->
      <%= render 'integrate_form' %>
      <%= hidden_field_tag 'integrate', '1' %>
    <% else %>
    <!-- File Upload Section -->
    <div class="mb-8 pt-6 border-t border-gray-200 dark:border-gray-700" data-guided-tour="project-new-upload-intro">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white">Upload Data File</h2>
        <button 
          type="button"
          data-file-upload-target="resetButton"
          data-action="click->file-upload#resetForm"
          class="px-4 py-2 text-white bg-orange-500 hover:bg-orange-600 dark:bg-orange-500 dark:hover:bg-orange-600 rounded-md font-medium transition-colors hidden"
        >
          Reset
        </button>
      </div>
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
        Supported formats: 10x (.h5), loom, text (.csv, .tsv, .txt), H5AD, RDS, archives (.zip, .tar, .tgz), MEX/MTX formats, and compressed variants (.zip, .gz, .bz2, .xz).
      <%= link_to "Learn more about file formats", file_format_home_index_path, class: "text-blue-600 dark:text-blue-400 hover:underline" %>
      </p>
      
      <!-- File Upload Container -->
      <div id="file-upload-container" data-guided-tour="project-new-file-upload-local" data-file-upload-target="fileUploadContainer" class="border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg p-6 text-center hover:border-blue-400 transition-colors">
        <div data-file-upload-target="dropzone" class="space-y-4">
          <div id="upload-icon" class="mx-auto text-gray-400">
            <svg class="mx-auto h-12 w-12" stroke="currentColor" fill="none" viewBox="0 0 48 48">
              <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <div>
            <label for="file-input" class="cursor-pointer">
              <span class="mt-2 block text-sm font-medium text-gray-900 dark:text-white">
                Click to upload or drag and drop
              </span>
              <span class="mt-1 block text-xs text-gray-500 dark:text-gray-400">
                Uploads can be resumed if interrupted
              </span>
            </label>
            <input id="file-input" data-file-upload-target="fileInput" type="file" class="hidden" accept=".txt,.loom,.h5,.h5ad,.zip,.tar,.gz,.tgz,.xz,.mtx,application/octet-stream" />
          </div>
        </div>

        <div data-file-upload-target="downloadForm" data-guided-tour="project-new-file-url" class="mt-6 text-center">
          <div class="text-sm uppercase tracking-wide text-gray-400 dark:text-gray-500">or</div>
          <div class="mt-3 flex flex-col sm:flex-row gap-3 justify-center">
            <input
              type="url"
              id="file-url"
              data-file-upload-target="urlInput"
              class="flex-1 sm:max-w-md px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
              placeholder="Paste an URL"
            />
            <button
              type="button"
              data-file-upload-target="downloadUrlButton"
              data-action="click->file-upload#downloadFromUrl"
              class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors"
            >
              Download
            </button>
          </div>
          <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">Download the file directly from our server (faster than uploading).</p>
        </div>
        
        <div data-file-upload-target="progress" class="hidden mt-4">
          <div class="flex items-center justify-between mb-2">
            <span data-file-upload-target="filename" class="text-sm font-medium text-gray-900 dark:text-white"></span>
            <span data-file-upload-target="percentage" class="text-sm text-gray-600 dark:text-gray-400">0%</span>
          </div>
          <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
            <div data-file-upload-target="progressBar" class="bg-blue-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
          </div>
          <div data-file-upload-target="status" class="mt-2 text-sm text-gray-600 dark:text-gray-400"></div>
        </div>
      </div>

      <div data-file-upload-target="uploadInfoFrame" class="hidden mt-6 text-center">
        <div class="inline-flex items-center gap-3 rounded-lg border border-green-200 dark:border-green-800 bg-green-50 dark:bg-green-900/30 px-4 py-3 text-sm text-green-900 dark:text-green-100">
          <span data-file-upload-target="uploadInfoText" class="text-left"></span>
        </div>
      </div>
      
      <%= hidden_field_tag 'input_filename', '', id: 'input_filename', data: { file_upload_target: 'inputFilename' } %>
      <%= hidden_field_tag 'nber_cols', 0 %>
      <%= hidden_field_tag 'nber_rows', 0 %>

      <div id="preparsing-panel" data-guided-tour="project-new-preparsing-panel" data-file-upload-target="preparsingPanel" class="mt-6 hidden">
        <div class="rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/40 p-4">
          <div class="flex flex-wrap items-center gap-2 text-sm">
            <span class="font-medium text-gray-900 dark:text-white">Preparsing status:</span>
            <span class="flex items-center gap-2">
              <svg data-file-upload-target="preparsingSpinner" class="hidden text-gray-700 dark:text-gray-300" style="width: 16px; height: 16px; animation: spin 1s linear infinite;" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-dasharray="12.566" stroke-dashoffset="12.566" opacity="0.25"/>
                <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-dasharray="12.566" stroke-dashoffset="12.566">
                  <animate attributeName="stroke-dashoffset" dur="1.5s" values="12.566;0;12.566" repeatCount="indefinite"/>
                </circle>
              </svg>
              <span data-file-upload-target="preparsingStatus" class="text-gray-700 dark:text-gray-300">Waiting for upload</span>
            </span>
          </div>
          <div data-file-upload-target="preparsingResult" data-guided-tour="project-new-preparsing-results" class="mt-4 space-y-4"></div>
        </div>
      </div>
    </div>
    <% end %>

    <!-- Hidden Fields -->
    <%= form.hidden_field :key, value: project.key || '' %>
    <%= form.hidden_field :step_id, value: project.step_id || 1 %>
    <%= form.hidden_field :status_id, value: project.status_id || 1 %>
    <% if @is_resetting_parsing %>
      <%= hidden_field_tag :reset_parsing, '1' %>
    <% end %>

    <!-- Actions -->
    <div class="flex items-center justify-end gap-4 pt-6 border-t border-gray-200 dark:border-gray-700" data-guided-tour="project-new-form-actions">
      <% if @is_resetting_parsing && @original_project %>
        <% parsing_step = Step.find_by(name: 'parsing') %>
        <% cancel_path = parsing_step ? project_path(@original_project, view: 'analysis', step_id: parsing_step.id) : project_path(@original_project, view: 'analysis') %>
        <%= link_to "Cancel parsing reset", cancel_path, class: "px-4 py-2 text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded-md font-medium transition-colors" %>
      <% else %>
        <%= link_to "Back to projects", projects_browse_url, class: "px-4 py-2 text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded-md font-medium transition-colors" %>
      <% end %>
      <% submit_label = @is_resetting_parsing ? "Recreate project" : (@integrate_mode ? "Create integrated project" : "Create project") %>
      <% submit_disabled = @integrate_mode ? false : true %>
      <%= form.submit submit_label, id: "submit-button", data: { file_upload_target: 'submitButton', guided_tour: 'project-new-submit' }, class: "px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-medium cursor-pointer transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed", disabled: submit_disabled %>
    </div>
  </div>
<% end %>
