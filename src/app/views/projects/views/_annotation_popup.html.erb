  window.addAnnotEvidenceGenesToGenePanel = async function() {
    var apd = window.annotEvidenceEnsureSelectionStore()
    if (!apd || !apd.evidencesSelectedOrder || apd.evidencesSelectedOrder.length === 0) {
      alert('Select at least one gene (Plot checkbox).')
      return
    }
    var vc = window.visualizationController
    var gm = window.geneManager
    if (!vc || typeof vc.resolveAnnotEvidenceRowToGeneSelectPayload !== 'function') {
      alert('Gene visualization is not available on this page.')
      return
    }
    if (!gm || typeof gm.replaceGenesFromGeneSet !== 'function') {
      alert('Gene panel is not available.')
      return
    }

    var maxGenes = (typeof vc.getMaxGenePanelGenes === 'function')
      ? vc.getMaxGenePanelGenes()
      : ((typeof gm.getMaxGenePanelGenes === 'function') ? gm.getMaxGenePanelGenes() : 1000)
    if (apd.evidencesSelectedOrder.length > maxGenes) {
      var limitMsg = (gm.constructor && typeof gm.constructor.genePanelLimitMessage === 'function')
        ? gm.constructor.genePanelLimitMessage(
          'You can add at most ' + maxGenes + ' genes to the gene panel at once.',
          maxGenes
        )
        : ('You can add at most ' + maxGenes + ' genes to the gene panel at once.')
      alert(limitMsg)
      return
    }

    if (typeof gm.isGenePanelContentUnsaved === 'function' && gm.isGenePanelContentUnsaved()) {
      var ok = window.confirm(
        'The current genes in the gene panel will be removed. Continue?\n\n' +
        '(No confirmation is needed when the gene panel is empty or its genes were already saved as a gene set.)'
      )
      if (!ok) return
    }

    var resolved = []
    var failed = []
    apd.evidencesSelectedOrder.forEach(function(key) {
      var r = apd.evidencesSelectedRows[key]
      if (!r) return
      var row = { gene_id: r.gene_id, gene: r.gene }
      var payload = vc.resolveAnnotEvidenceRowToGeneSelectPayload(row)
      if (payload) resolved.push(payload)
      else failed.push((r.gene && String(r.gene).trim()) || (r.gene_id && String(r.gene_id)) || key)
    })

    if (resolved.length === 0) {
      alert('Could not resolve any selected genes in the project index.')
      return
    }

    try {
      await gm.replaceGenesFromGeneSet(resolved)
      if (failed.length > 0) {
        var preview = failed.slice(0, 10).join(', ')
        if (failed.length > 10) preview += ', ...'
        alert('Added ' + resolved.length + ' gene(s) to the gene panel. Could not resolve: ' + preview)
      }
    } catch (error) {
      alert((error && error.message) || 'Failed to update the gene panel.')
    }
  }

