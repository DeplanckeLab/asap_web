<%# 
  Partial for displaying a version
  Locals:
    - version: Version object
    - env_data: Hash of environment data (required)
    - show_actions: Boolean, whether to show action buttons in header (default: false)
    - action_buttons: Array of button configs [{text: 'Show', path: ..., class: ...}]
%>
<% tool_versions = tool_versions_from(env_data) %>
<% docker_images = docker_images_from(env_data) %>

<div class="rounded-lg border border-gray-200 bg-white shadow-sm">
  <div class="flex flex-wrap items-center gap-3 border-b border-gray-100 px-4 py-3">
    <span class="text-sm font-medium text-gray-500">Release <%= version.id %></span>
    <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-700">
      <%= format_version_release_date(version) %>
    </span>
    <% if version.activated? %>
      <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700">
        Activated
      </span>
    <% end %>
    <% if version.beta? %>
      <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-700">
        Beta
      </span>
    <% end %>
    <% if show_actions && action_buttons.present? %>
      <div class="ml-auto flex items-center gap-2">
        <% action_buttons.each do |button| %>
          <%= link_to button[:text], button[:path], class: button[:class] || 'inline-flex items-center gap-1 rounded-md border border-gray-200 px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50' %>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="px-4 py-5 space-y-6 text-sm text-gray-700">
    <% if version.description.present? %>
      <div>
        <h2 class="text-sm font-semibold text-gray-800 mb-1">Description</h2>
        <p class="whitespace-pre-line"><%= version.description %></p>
      </div>
    <% end %>

    <!-- Compliance Schemas -->
    <div>
      <h2 class="text-sm font-semibold text-gray-800 mb-2">Compliance Schemas</h2>
      
      <% all_compliance_schemas = ComplianceSchema.order(active: :desc, started_at: :desc) %>
      <% if all_compliance_schemas.any? %>
        <% grouped = all_compliance_schemas.group_by(&:project_type_tags) %>
        <% grouped.each do |tags, schemas| %>
          <div class="mb-4">
            <div class="text-xs text-gray-500 mb-2"><%= tags %></div>
            <% schemas.each do |cs| %>
            <% schema = cs.to_config_hash %>
              <div class="flex flex-wrap items-center gap-3 mb-2">
                <span class="inline-flex items-center rounded-full bg-purple-100 px-3 py-1 text-sm font-medium text-purple-800">
                  <%= schema['name'] %><%= " v#{schema['version']}" if schema['version'].present? %>
                </span>
                <% if schema['source_schema_name'].present? %>
                  <span class="text-xs text-gray-500">(<%= schema['source_schema_name'] %><%= " v#{schema['version']}" if schema['version'].present? %>)</span>
                <% end %>
                <% if schema['source_url'].present? %>
                  <%= link_to schema['source_url'],
                              target: "_blank", rel: "noopener",
                              class: "inline-flex items-center gap-1 text-sm text-blue-600 hover:text-blue-800" do %>
                    Schema reference
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  <% end %>
                <% end %>
                <% if schema['url'].present? %>
                  <%= link_to schema['url'],
                              target: "_blank", rel: "noopener",
                              class: "inline-flex items-center gap-1 text-sm text-blue-600 hover:text-blue-800" do %>
                    Website
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  <% end %>
                <% end %>
                <% if schema['version'].present? %>
                  <%= link_to compliance_schema_docs_path(version: schema['version']), 
                              class: "inline-flex items-center gap-1 text-sm text-blue-600 hover:text-blue-800" do %>
                    Loom Path Translation
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                  <% end %>
                <% end %>
                <% if schema['if_compliant']&.include?('allow_public') %>
                  <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700">
                    Required for publishing
                  </span>
                <% end %>
              </div>
              <% if schema['description'].present? %>
                <div class="text-xs text-gray-500 mb-2 ml-2"><%= schema['description'] %></div>
              <% end %>
              <% if schema['compliant_icon'].present? || schema['not_compliant_icon'].present? %>
                <div class="flex items-center gap-2 mb-2 ml-2">
                  <span class="text-xs text-gray-400">Badges:</span>
                  <% [schema['compliant_icon'], schema['not_compliant_icon']].compact.each do |icon| %>
                    <%= image_tag icon, alt: icon, class: 'h-5' rescue nil %>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="text-sm text-gray-500 italic">No compliance schemas configured.</p>
      <% end %>

      <div class="mt-2">
        <%= link_to compliance_index_path, 
                    class: "inline-flex items-center gap-1 text-sm text-gray-600 hover:text-gray-800" do %>
          Validate Files
        <% end %>
      </div>
    </div>

    <% if tool_versions.present? %>
    
      <div>
        <h2 class="text-sm font-semibold text-gray-800 mb-2">Tool Versions</h2>
        <div class="overflow-x-auto rounded-lg border border-gray-200">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50 text-xs font-semibold uppercase tracking-wide text-gray-600">
              <tr>
                <th scope="col" class="px-3 py-2 text-left">Tool</th>
                <th scope="col" class="px-3 py-2 text-left">Version</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-sm text-gray-700">
              <% tool_versions.each do |name, version| %>
                <tr>
                  <td class="px-3 py-2"><%= name %></td>
                  <td class="px-3 py-2 text-gray-500"><%= version %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <% if docker_images.present? %>
      <div>
        <h2 class="text-sm font-semibold text-gray-800 mb-3">Docker Images</h2>
        <div class="space-y-4">
          <% docker_images.each do |key, metadata| %>
            <%# 
              Structure: docker_images = {
                "asap_run" => {
                  "name" => "fabdavid/asap_run",
                  "tag" => "v8",
                  "version" => 8
                }
              }
              We use metadata["name"] and metadata["tag"] to find the DockerImage record
            %>
            <% image_name = metadata.is_a?(Hash) ? metadata["name"] : key %>
            <% record = docker_image_record_for(image_name, metadata, version.id) %>
            <% metadata_hash = docker_image_metadata_hash(metadata, record) %>
            <%# Extract tools directly from DockerImage record's tools_json %>
            <% tools = {} %>
            <% if record&.tools_json.present? %>
              <% tools = Basic.safe_parse_json(record.tools_json, {}) %>
            <% elsif metadata_hash['tool_versions'].present? %>
              <% tools = metadata_hash['tool_versions'].is_a?(Hash) ? metadata_hash['tool_versions'] : Basic.safe_parse_json(metadata_hash['tool_versions'], {}) %>
            <% end %>
            <% grouped_tools = grouped_tools_by_language(tools, metadata_hash, record: record) { |tool_name| tool_metadata_for(tool_name) } %>
            <details class="bg-gray-50 border-b border-gray-200 px-4 py-2 text-xs text-gray-600">
              <summary class="cursor-pointer text-gray-500 select-none">Raw metadata</summary>
              <pre class="mt-2 max-h-48 overflow-x-auto whitespace-pre-wrap"><%= JSON.pretty_generate(metadata_hash) %></pre>
            </details>
            <% if record&.tools_json.present? %>
              <details class="bg-gray-50 border-b border-gray-200 px-4 py-2 text-xs text-gray-600">
                <summary class="cursor-pointer text-gray-500 select-none">DockerImage.tools_json</summary>
                <pre class="mt-2 max-h-48 overflow-x-auto whitespace-pre-wrap"><%= JSON.pretty_generate(Basic.safe_parse_json(record.tools_json, {})) %></pre>
              </details>
            <% end %>
            <div class="rounded-md border border-gray-200 overflow-hidden">
              <div class="flex items-center justify-between bg-gray-50 px-4 py-2">
                <div>
                  <p class="text-sm font-semibold text-gray-800"><%= docker_image_label(image_name, metadata_hash, record) %></p>
                  <% description = metadata_hash['description'] %>
                  <% if description.present? %>
                    <p class="text-xs text-gray-500"><%= description %></p>
                  <% end %>
                </div>
                <% tag = metadata_hash['tag'] || record&.tag %>
                <% if tag.present? %>
                  <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">
                    Tag: <%= tag %>
                  </span>
                <% end %>
              </div>
              <% if tools.present? %>
                <% if grouped_tools.present? %>
                  <div class="divide-y divide-gray-100">
                    <% grouped_tools.each do |language, tool_list| %>
                      <div class="px-4 py-3">
                        <div class="mb-3 text-sm font-semibold text-gray-800"><%= language %></div>
                        <div class="flex flex-wrap gap-2">
                          <% tool_list.each do |tool| %>
                            <div class="inline-flex items-center gap-1.5">
                              <% tool_link = tool[:tool_id] ? tool_path(tool[:tool_id]) : (tool[:url].present? ? tool[:url] : nil) %>
                              <% if tool_link.present? %>
                                <%= link_to tool_link, target: (tool[:url].present? ? "_blank" : nil), rel: (tool[:url].present? ? "noopener" : nil), class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-gray-500 transition" do %>
                                  <%= tool[:package] %>
                                  <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700">
                                    <%= tool[:version] || 'NA' %>
                                  </span>
                                  <% if tool[:url].present? %>
                                    <i class="fas fa-link text-gray-400 text-xs"></i>
                                  <% end %>
                                <% end %>
                              <% else %>
                                <button type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-gray-500">
                                  <%= tool[:package] %>
                                  <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700">
                                    <%= tool[:version] || 'NA' %>
                                  </span>
                                </button>
                              <% end %>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% else %>
                  <%# Fallback: display tools even if not grouped by language %>
                  <div class="px-4 py-3">
                    <div class="mb-3 text-sm font-semibold text-gray-800">Tools</div>
                    <div class="flex flex-wrap gap-2">
                      <% tools.each do |tool_name, version| %>
                        <% tool_metadata = tool_metadata_for(tool_name) %>
                        <% tool_link = tool_metadata[:id] ? tool_path(tool_metadata[:id]) : (tool_metadata[:url].present? ? tool_metadata[:url] : nil) %>
                        <div class="inline-flex items-center gap-1.5">
                          <% if tool_link.present? %>
                            <%= link_to tool_link, target: (tool_metadata[:url].present? ? "_blank" : nil), rel: (tool_metadata[:url].present? ? "noopener" : nil), class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-gray-500 transition" do %>
                              <%= tool_name %>
                              <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700">
                                <%= version || 'NA' %>
                              </span>
                              <% if tool_metadata[:url].present? %>
                                <i class="fas fa-link text-gray-400 text-xs"></i>
                              <% end %>
                            <% end %>
                          <% else %>
                            <button type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-gray-500">
                              <%= tool_name %>
                              <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700">
                                <%= version || 'NA' %>
                              </span>
                            </button>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              <% else %>
                <div class="px-4 py-3 text-sm text-gray-500 italic">No tool versions listed for this image.</div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if version.env_json.present? %>
      <details class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-600">
        <summary class="cursor-pointer font-medium text-gray-700">Raw environment JSON</summary>
        <pre class="mt-2 max-h-64 overflow-x-auto whitespace-pre-wrap text-xs text-gray-600"><%= version.env_json %></pre>
      </details>
    <% end %>
  </div>
</div>

