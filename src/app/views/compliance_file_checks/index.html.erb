<div class="max-w-6xl mx-auto px-4 py-8"
     data-controller="isolated-compliance"
     data-isolated-compliance-upload-type-name-value="compliance_file_check">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Standalone scFAIR Compliance Check</h1>
    <p class="mt-2 text-gray-600">
      Upload a single <code>.loom</code> or <code>.h5ad</code> file and run compliance checks.
    </p>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div class="grid md:grid-cols-2 gap-4 mb-5">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Schema</label>
        <select class="w-full border border-gray-300 rounded-md px-3 py-2"
                data-isolated-compliance-target="schemaSelect">
          <% @available_schemas.each do |schema| %>
            <option value="<%= schema[:id] %>" <%= 'selected' if schema[:id] == @default_schema_id %>>
              <%= schema[:label] %>
            </option>
          <% end %>
        </select>
      </div>
      <div class="text-sm text-gray-600 md:pt-8">
      </div>
    </div>

    <div class="mb-4">
      <label class="mr-4">
        <input type="radio" name="source_mode" value="upload" checked
               data-isolated-compliance-target="sourceUpload"
               data-action="change->isolated-compliance#sourceChanged">
        Upload from browser
      </label>
      <label>
        <input type="radio" name="source_mode" value="url"
               data-isolated-compliance-target="sourceUrl"
               data-action="change->isolated-compliance#sourceChanged">
        Download from URL
      </label>
    </div>

    <div class="border-2 border-dashed border-gray-300 rounded-lg p-8 text-center hover:border-blue-400 transition-colors"
         data-isolated-compliance-target="dropzone">
      <p class="text-gray-700 font-medium">Choose a `.loom` or `.h5ad` file</p>
      <p class="text-gray-500 text-sm mt-1">or drag and drop here</p>
      <input type="file"
             accept=".loom,.h5ad"
             class="hidden"
             data-isolated-compliance-target="fileInput"
             data-action="change->isolated-compliance#fileSelected">
      <button type="button"
              class="mt-4 px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700"
              data-action="click->isolated-compliance#openPicker">
        Select File
      </button>
    </div>

    <div class="hidden mb-4" data-isolated-compliance-target="urlWrap">
      <input type="url"
             placeholder="https://example.org/data.h5ad"
             class="w-full border rounded p-2"
             data-isolated-compliance-target="urlInput"
             data-action="input->isolated-compliance#urlChanged">
    </div>

    <div class="mt-4 hidden" data-isolated-compliance-target="fileInfo"></div>

    <div class="mt-6 flex items-center justify-between gap-4">
      <div class="text-sm text-gray-700 flex-1 min-h-[1.25rem]" data-isolated-compliance-target="statusText">Waiting for file selection</div>
      <button type="button"
              class="shrink-0 px-5 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 disabled:opacity-50 disabled:cursor-not-allowed"
              data-isolated-compliance-target="runButton"
              data-action="click->isolated-compliance#run"
              disabled>
        Run Compliance Test
      </button>
    </div>

    <div class="mt-4 hidden" data-isolated-compliance-target="progressWrap">
      <div class="text-sm font-medium mb-1 flex items-center gap-2 text-gray-700">
        <span class="hidden" data-isolated-compliance-target="progressSpinner">
          <i class="fas fa-spinner fa-spin" aria-hidden="true"></i>
        </span>
        <span data-isolated-compliance-target="progressTitle">Validation in progress...</span>
      </div>
      <div class="h-2 bg-gray-200 rounded">
        <div class="h-2 bg-blue-600 rounded transition-all" style="width: 0%" data-isolated-compliance-target="progressBar"></div>
      </div>
      <div class="text-xs text-gray-600 mt-1" data-isolated-compliance-target="progressDetail"></div>
    </div>

    <div class="mt-6 hidden border-t border-gray-200 pt-6" data-isolated-compliance-target="resultWrap">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Validation Results</h2>
      <div data-isolated-compliance-target="resultBody"></div>
    </div>
  </div>

  <div data-isolated-compliance-target="detailModal"
       class="hidden fixed inset-0 z-50"
       role="dialog"
       aria-modal="true"
       aria-labelledby="compliance-check-detail-title"
       data-action="click->isolated-compliance#closeCheckDetailOnBackdrop keydown@window->isolated-compliance#closeCheckDetailOnEscape">
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="absolute inset-0 overflow-y-auto pointer-events-none">
      <div class="flex min-h-full items-center justify-center p-4">
        <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-[85vh] overflow-hidden flex flex-col border border-gray-200 pointer-events-auto"
             data-action="click->isolated-compliance#stopCheckDetailPanelClick">
          <div class="px-5 py-4 border-b border-gray-200 flex items-center justify-between gap-3">
            <h2 id="compliance-check-detail-title"
                data-isolated-compliance-target="detailTitle"
                class="text-base font-semibold text-gray-900 m-0 pr-2">
              Rule details
            </h2>
            <button type="button"
                    class="px-3 py-1.5 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
                    data-action="click->isolated-compliance#closeCheckDetail"
                    aria-label="Close">
              Close
            </button>
          </div>
          <div data-isolated-compliance-target="detailBody"
               class="px-5 py-4 overflow-y-auto text-sm text-gray-700">
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

