  function renderEvidencesTab() {
    var ev = _annotPopupData.evidences || {};
    var content = '';
    if (ev.state === 'loading') {
      content += '<div style="display:flex;align-items:center;gap:8px;padding:12px;border:1px solid #e5e7eb;border-radius:8px;color:#6b7280;background:#fff;"><i class="fas fa-spinner fa-spin"></i><span>' + escapeHtml(ev.message || 'Loading evidences...') + '</span></div>';
      return templateHtml('annot-evidences-tab-template').replace('__CONTENT__', content);
    }
    if (ev.state === 'completed') {
      var upRows = Array.isArray(ev.rowsUp) ? ev.rowsUp : [];
      var downRows = Array.isArray(ev.rowsDown) ? ev.rowsDown : [];
      if (upRows.length === 0 && downRows.length === 0) {
        content += '<div style="text-align:center;padding:18px;border:1px solid #e5e7eb;border-radius:8px;color:#6b7280;background:#fff;">No marker evidence matched the current thresholds.</div>';
      } else {
        var sub = _annotPopupData.evidencesSubTab || 'up';
        if (sub !== 'up' && sub !== 'down') sub = 'up';
        var evidSubNavStyle = function(dir) {
          var active = sub === dir;
          var accent = dir === 'up' ? '#16a34a' : '#dc2626';
          var color = active ? accent : '#6b7280';
          var border = active ? ('2px solid ' + accent) : '2px solid transparent';
          return 'background:none;border:none;border-bottom:' + border + ';color:' + color + ';font-size:12px;font-weight:600;padding:8px 12px;cursor:pointer;margin-bottom:-1px;';
        };
        content += '<div style="display:flex;gap:0;border-bottom:1px solid #e5e7eb;margin-bottom:10px;">';
        content += '<button type="button" onclick="setEvidencesSubTab(\'up\')" style="' + evidSubNavStyle('up') + '">Up-regulated genes (' + upRows.length + ')</button>';
        content += '<button type="button" onclick="setEvidencesSubTab(\'down\')" style="' + evidSubNavStyle('down') + '">Down-regulated genes (' + downRows.length + ')</button>';
        content += '</div>';
        content += renderEvidenceMarkersToolbarHtml();
        if (sub === 'up') {
          content += renderEvidenceGeneTableBlock(upRows, 'up', 'No up-regulated genes for this category at the current thresholds.');
        } else {
          content += renderEvidenceGeneTableBlock(downRows, 'down', 'No down-regulated genes for this category at the current thresholds.');
        }
      }
      return templateHtml('annot-evidences-tab-template').replace('__CONTENT__', content);
    }
    if (ev.state === 'running') {
      content += '<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px;border:1px solid #bfdbfe;border-radius:8px;color:#1e3a8a;background:#fff;">';
      content += '<div><i class="fas fa-spinner fa-spin" style="margin-right:8px;"></i>' + escapeHtml(ev.message || 'FindMarkers is running for this metadata.') + '</div>';
      content += '<div style="display:flex;gap:6px;flex-shrink:0;">';
      if (ev.runId) {
        content += '<button type="button" onclick="stopAnnotationMarkers()" style="border:1px solid #fca5a5;background:#fff;color:#b91c1c;border-radius:6px;padding:5px 10px;font-size:12px;cursor:pointer;">Stop</button>';
      }
      content += '<button type="button" onclick="loadAnnotationEvidences()" style="border:1px solid #93c5fd;background:#fff;color:#1d4ed8;border-radius:6px;padding:5px 10px;font-size:12px;cursor:pointer;">Refresh</button>';
      content += '</div></div>';
      return templateHtml('annot-evidences-tab-template').replace('__CONTENT__', content);
    }
    if (ev.state === 'queued') {
      content += '<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:12px;border:1px solid #d1d5db;border-radius:8px;color:#374151;background:#fff;">';
      content += '<div style="flex:1;min-width:0;">';
      var qNote = (ev.markersQueueNote || '').toString();
      var qBase = (ev.markersQueueBase || '').toString();
      var qHover = (ev.slurmQueueHover || '').toString();
      var qp = ev.queuePosition;
      if (qNote && qBase) {
        var mid = _annotPopupData.metadataId != null ? String(_annotPopupData.metadataId) : '';
        var rid = ev.runId != null ? String(ev.runId) : '';
        var iconWrapOpen = qHover ? ('<span data-slurm-queue-waiting-icon="true" title="' + escapeAttr(qHover) + '" aria-label="' + escapeAttr(qHover) + '" class="cursor-help">') : '<span>';
        content += '<div>' + iconWrapOpen + '<i class="fas fa-hourglass-half" style="margin-right:8px;" aria-hidden="true"></i></span>' + escapeHtml(qBase) + '</div>';
        if (qp != null && qp !== '' && Number(qp) > 0) {
          content += '<div style="margin-top:6px;font-size:12px;color:#374151;"><span data-slurm-queue-position-label>Slurm queue position:</span> <span data-slurm-queue-position="' + escapeAttr(String(qp)) + '">' + escapeHtml(String(qp)) + '</span></div>';
        }
        content += '<div style="margin-top:8px;font-size:12px;color:#6b7280;line-height:1.45;" data-slurm-queue-explanation data-markers-queue-live data-annot-id="' + escapeHtml(mid) + '" data-run-id="' + escapeHtml(rid) + '">' + escapeHtml(qNote) + '</div>';
      } else {
        var iconOnlyOpen = qHover ? ('<span data-slurm-queue-waiting-icon="true" title="' + escapeAttr(qHover) + '" aria-label="' + escapeAttr(qHover) + '" class="cursor-help">') : '<span>';
        content += '<div>' + iconOnlyOpen + '<i class="fas fa-hourglass-half" style="margin-right:8px;" aria-hidden="true"></i></span>' + escapeHtml(ev.message || 'FindMarkers is queued for execution.') + '</div>';
      }
      content += '</div>';
      content += '<div style="display:flex;gap:6px;flex-shrink:0;">';
      if (ev.runId) {
        content += '<button type="button" onclick="stopAnnotationMarkers()" style="border:1px solid #fca5a5;background:#fff;color:#b91c1c;border-radius:6px;padding:5px 10px;font-size:12px;cursor:pointer;">Stop</button>';
      }
      content += '<button type="button" onclick="loadAnnotationEvidences()" style="border:1px solid #d1d5db;background:#fff;color:#374151;border-radius:6px;padding:5px 10px;font-size:12px;cursor:pointer;">Refresh</button>';
      content += '</div></div>';
      return templateHtml('annot-evidences-tab-template').replace('__CONTENT__', content);
    }
    if (ev.state === 'analyze_forbidden') {
      content += '<div style="display:flex;align-items:flex-start;gap:8px;padding:12px;border:1px solid #d1d5db;border-radius:8px;color:#374151;background:#fff;"><i class="fas fa-info-circle" style="margin-top:2px;"></i><div>' + escapeHtml(ev.message || 'FindMarkers requires analyze permission on this project.') + '</div></div>';
      return templateHtml('annot-evidences-tab-template').replace('__CONTENT__', content);
    }
    if (ev.state === 'stopped') {
      content += '<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px;border:1px solid #e5e7eb;border-radius:8px;color:#374151;background:#fff;">';
      content += '<div>' + escapeHtml(ev.message || 'FindMarkers was stopped for this metadata.') + '</div>';
      content += '<button type="button" onclick="loadAnnotationEvidences(true, { restart: true })" style="border:1px solid #d1d5db;background:#fff;color:#374151;border-radius:6px;padding:5px 10px;font-size:12px;cursor:pointer;">Retry</button>';
      content += '</div>';
      return templateHtml('annot-evidences-tab-template').replace('__CONTENT__', content);
    }
    if (ev.state === 'error' || ev.state === 'failed' || ev.state === 'unsupported') {
      content += '<div style="padding:12px;border:1px solid #fecaca;border-radius:8px;color:#991b1b;background:#fff;">' + escapeHtml(ev.message || 'Failed to load evidences.') + '</div>';
      return templateHtml('annot-evidences-tab-template').replace('__CONTENT__', content);
    }
    content += '<div style="text-align:center;padding:18px;border:1px solid #e5e7eb;border-radius:8px;color:#6b7280;background:#fff;">No evidence request has been made yet.</div>';
    return templateHtml('annot-evidences-tab-template').replace('__CONTENT__', content);
  }

  function loadAnnotationEvidences(force, opts) {
    var ev = _annotPopupData.evidences || {};
    if (!force && ev.loading) return;
    if (!_annotPopupData.evidencesUrl || !_annotPopupData.metadataId) return;
    _annotPopupData.evidences = { state: 'loading', loading: true, message: 'Checking FindMarkers run...', runId: null, rowsUp: [], rowsDown: [] };
    updateMarkersStatusInMetadataPanel(_annotPopupData.metadataId, _annotPopupData.catIdx, 'loading', null);
    refreshAnnotPopupTitle();
    renderAnnotationPanel();
    var url = _annotPopupData.evidencesUrl + '?annot_id=' + encodeURIComponent(_annotPopupData.metadataId) + '&cat_idx=' + encodeURIComponent(_annotPopupData.catIdx);
    if (opts && opts.restart) url += '&restart=1';
    fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
      .then(function(r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      })
      .then(function(data) {
        _annotPopupData.evidences = {
          state: data.state || 'error',
          loading: false,
          message: data.message || '',
          runId: data.run_id || null,
          rowsUp: Array.isArray(data.rows_up) ? data.rows_up : [],
          rowsDown: Array.isArray(data.rows_down) ? data.rows_down : [],
          markersQueueBase: data.markers_queue_base || '',
          markersQueueNote: data.markers_queue_note || '',
          slurmQueueHover: data.slurm_queue_hover || '',
          queuePosition: data.queue_position,
          queuePendingTotal: data.queue_pending_total,
          queuePartition: data.queue_partition
        };
        if ((_annotPopupData.evidences.state || '') === 'completed') {
          normalizeEvidencesSubTabAfterLoad(_annotPopupData.evidences.rowsUp, _annotPopupData.evidences.rowsDown);
        }
        syncMarkersStatusFromResponse(_annotPopupData.metadataId, _annotPopupData.catIdx, data);
      })
      .catch(function(err) {
        _annotPopupData.evidences = { state: 'error', loading: false, message: 'Error loading evidences: ' + err.message, runId: null, rowsUp: [], rowsDown: [] };
        syncMarkersStatusFromResponse(_annotPopupData.metadataId, _annotPopupData.catIdx, { state: 'error' });
      });
  }

  function stopAnnotationMarkers() {
    var ev = _annotPopupData.evidences || {};
    var runId = ev.runId;
    if (!runId) {
      alert('No FindMarkers run to stop.');
      return;
    }
    if (!confirm('Stop FindMarkers for this metadata? Any running Docker container or SLURM job will be cancelled.')) {
      return;
    }
    var csrfToken = document.querySelector('meta[name="csrf-token"]');
    var headers = { 'Accept': 'application/json' };
    if (csrfToken) headers['X-CSRF-Token'] = csrfToken.getAttribute('content');

    _annotPopupData.evidences = {
      state: 'loading',
      loading: true,
      message: 'Stopping FindMarkers...',
      runId: runId,
      rowsUp: [],
      rowsDown: []
    };
    updateMarkersStatusInMetadataPanel(_annotPopupData.metadataId, _annotPopupData.catIdx, 'loading', null);
    refreshAnnotPopupTitle();
    renderAnnotationPanel();

    fetch('/runs/' + encodeURIComponent(String(runId)) + '/stop', {
      method: 'POST',
      headers: headers,
      credentials: 'same-origin'
    })
      .then(function(r) {
        return r.json().then(function(body) { return { ok: r.ok, body: body }; });
      })
      .then(function(res) {
        if (!res.ok || !res.body || res.body.status !== 'ok') {
          var message = (res.body && res.body.message) ? res.body.message : 'Could not stop FindMarkers.';
          _annotPopupData.evidences = {
            state: 'error',
            loading: false,
            message: message,
            runId: runId,
            rowsUp: [],
            rowsDown: []
          };
          syncMarkersStatusFromResponse(_annotPopupData.metadataId, _annotPopupData.catIdx, { state: 'error' });
          return;
        }
        loadAnnotationEvidences(true);
      })
      .catch(function(err) {
        _annotPopupData.evidences = {
          state: 'error',
          loading: false,
          message: 'Could not stop FindMarkers: ' + err.message,
          runId: runId,
          rowsUp: [],
          rowsDown: []
        };
        syncMarkersStatusFromResponse(_annotPopupData.metadataId, _annotPopupData.catIdx, { state: 'error' });
      });
  }

  window.loadAnnotationEvidences = loadAnnotationEvidences;
  window.stopAnnotationMarkers = stopAnnotationMarkers;
  window.peekAnnotationMarkersStatus = peekAnnotationMarkersStatus;

  function prefetchMarkersStatusForVisibleMetadata() {
    if (typeof window.peekAnnotationMarkersStatus !== 'function') return;
    var seen = {};
    document.querySelectorAll('.category-annot-btn[data-metadata-id][data-annot-evidences-url]').forEach(function(btn) {
      var mid = btn.dataset.metadataId;
      if (!mid || seen[mid]) return;
      seen[mid] = true;
      var evidencesUrl = btn.dataset.annotEvidencesUrl;
      if (!evidencesUrl) return;
      var catIdx = parseInt(btn.dataset.catIdx, 10);
      if (Number.isNaN(catIdx)) catIdx = 0;
      window.peekAnnotationMarkersStatus(mid, catIdx, evidencesUrl);
    });
  }
  window.prefetchMarkersStatusForVisibleMetadata = prefetchMarkersStatusForVisibleMetadata;

  function schedulePrefetchMarkersStatusOnLoad() {
    function run() {
      prefetchMarkersStatusForVisibleMetadata();
    }
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(run, 0);
    } else {
      document.addEventListener('DOMContentLoaded', function() { setTimeout(run, 0); });
    }
    document.addEventListener('turbo:load', function() { setTimeout(run, 0); });
  }
  schedulePrefetchMarkersStatusOnLoad();

  (function bindAnnotationEvidencesWebsocketRefresh() {
    if (window.__asapAnnotEvidencesWsBound) return;
    window.__asapAnnotEvidencesWsBound = true;
    var evidencesWsTimer = null;
    document.addEventListener('asap:project-step-runs-changed', function(ev) {
      var d = ev.detail || {};
      if (d.step_name !== 'markers') return;
      if (typeof window.prefetchMarkersStatusForVisibleMetadata !== 'function' || typeof window.loadAnnotationEvidences !== 'function' || typeof window.peekAnnotationMarkersStatus !== 'function') return;
      if (evidencesWsTimer) clearTimeout(evidencesWsTimer);
      evidencesWsTimer = setTimeout(function() {
        evidencesWsTimer = null;
        window.prefetchMarkersStatusForVisibleMetadata();
        var overlay = document.getElementById('annotation-popup-overlay');
        var visible = overlay && overlay.style.display !== 'none' && window.getComputedStyle(overlay).display !== 'none';
        if (!visible) return;
        var apd = window._annotPopupData;
        if (!apd || apd.metadataId == null) return;
        if (apd.activeTab === 'evidences') {
          window.loadAnnotationEvidences(true);
        } else {
          window.peekAnnotationMarkersStatus(apd.metadataId, apd.catIdx, apd.evidencesUrl);
        }
      }, 200);
    });
  })();

  function renderAnnotationPanel() {
    var panel = document.getElementById('annot-popup-panel');
    if (!panel) return;
    var clas = _annotPopupData.clas || [];
    var activeTab = _annotPopupData.activeTab || 'existing';
    var navButtonStyle = function(tab) {
      var isActive = activeTab === tab;
      var color = isActive ? '#1d4ed8' : '#6b7280';
      var border = isActive ? '2px solid #1d4ed8' : '2px solid transparent';
      return 'background:none;border:none;color:' + color + ';font-size:12px;font-weight:600;padding:8px 10px;cursor:pointer;border-bottom:' + border + ';';
    };
    var html = '';
    html += '<div style="display:flex;align-items:center;border-bottom:1px solid #e5e7eb;padding:0 12px;background:#fff;">';
    html += '<button type="button" onclick="setAnnotationTab(\'existing\')" style="' + navButtonStyle('existing') + '">Existing annotations <span style="display:inline-flex;align-items:center;justify-content:center;min-width:18px;height:18px;padding:0 5px;margin-left:6px;border-radius:999px;background:#e5e7eb;color:#374151;font-size:11px;font-weight:600;line-height:1;">' + clas.length + '</span></button>';
    html += '<button type="button" onclick="setAnnotationTab(\'evidences\')" style="' + navButtonStyle('evidences') + '" title="' + escapeHtml(markersStatusTooltip((_annotPopupData.evidences && _annotPopupData.evidences.loading) ? 'loading' : ((_annotPopupData.evidences && _annotPopupData.evidences.state) || 'idle'))) + '">' + identifyMarkersTabLeadingIconHtml() + 'Identify markers</button>';
    var boxN = (typeof window.annotEvidenceSelectedCount === 'function') ? window.annotEvidenceSelectedCount() : 0;
    html += '<button type="button" data-annot-tab="evidence_boxplot" onclick="setAnnotationTab(\'evidence_boxplot\')" style="' + navButtonStyle('evidence_boxplot') + '">Violin (' + boxN + ' selected)</button>';
    html += '</div>';
    html += '<div style="overflow-y:auto;flex:1;padding:12px 16px;">';
    if (activeTab === 'evidences') {
      html += renderEvidencesTab();
    } else if (activeTab === 'evidence_boxplot') {
      html += renderEvidenceBoxplotTab();
    } else {
      html += renderExistingAnnotationsTab(clas);
    }
    html += '</div>';
    panel.innerHTML = html;
    if (activeTab === 'evidence_boxplot' && typeof window.scheduleAnnotEvidenceBoxplotRender === 'function') {
      window.scheduleAnnotEvidenceBoxplotRender();
    }
  }

  window._annotPopupRenderPanel = renderAnnotationPanel;
}
</script>

<%= render 'projects/views/annotation_popup' if annotation_tool_available %>
<script>
(function() {
  if (typeof window.scheduleAnnotEvidenceBoxplotRender !== 'function') {
    window.scheduleAnnotEvidenceBoxplotRender = function() {};
  }
  if (typeof window.scheduleAnnotEvidenceViolinResizeRedraw !== 'function') {
    window.scheduleAnnotEvidenceViolinResizeRedraw = function() {};
  }
})();
</script>

<% else %>
  <div class="text-gray-500 text-center py-8">No marker genes found with the current filter criteria.</div>
<% end %>
