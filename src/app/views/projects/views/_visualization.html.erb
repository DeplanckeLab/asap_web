<script>
// Global range slider drag functionality
let isDragging = false
let dragHandle = null

// Modal drag functionality
let isModalDragging = false
let modalDragStartX = 0
let modalDragStartY = 0
let modalStartLeft = 0
let modalStartTop = 0

function startRangeSliderDrag(event, handleType) {
  event.preventDefault()
  event.stopPropagation()
  
  console.log('🎚️ Global startRangeSliderDrag called for:', handleType)
  
  isDragging = true
  dragHandle = handleType
  
  // Get the main visualization controller
  const mainController = document.querySelector('[data-controller*="visualization"]:not(#range-slider-modal)')
  if (!mainController) {
    console.error('❌ Main visualization controller not found')
    return
  }
  
  // Get the controller using the global variable
  const controller = window.visualizationController
  if (!controller) {
    console.error('❌ Controller not found')
    return
  }
  
  if (!controller.rangeSliderData) {
    console.error('❌ rangeSliderData not found')
    console.error('Controller properties:', Object.keys(controller))
    console.error('Current metadata vector:', controller.currentMetadataVector)
    console.error('Current metadata ID:', controller.currentMetadataId)
    
    // Check if this is the same controller instance that was used to show the modal
    console.log('🎚️ Checking controller instance...')
    console.log('🎚️ Global controller:', window.visualizationController)
    console.log('🎚️ Are they the same?', controller === window.visualizationController)
    
    if (controller !== window.visualizationController) {
      console.log('🎚️ Using global controller instead...')
      const globalController = window.visualizationController
      if (globalController && globalController.rangeSliderData) {
        console.log('🎚️ Found rangeSliderData on global controller!')
        controller = globalController
      } else {
        console.error('❌ Global controller also missing rangeSliderData')
      }
    }
    
    // Check if we have global range slider data as fallback
    if (window.globalRangeSliderData) {
      console.log('🎚️ Found global range slider data as fallback!')
      controller.rangeSliderData = window.globalRangeSliderData
    } else {
      // Try to initialize range slider data if modal is visible but data is missing
      console.log('🎚️ Attempting to initialize range slider data...')
      const modal = document.getElementById('range-slider-modal')
      if (modal && modal.style.display !== 'none') {
        console.log('🎚️ Modal is visible, trying to reinitialize...')
        // Try to get metadata info from the modal
        const metadataName = document.getElementById('range-slider-metadata-name')?.textContent
        const metadataId = controller.currentRangeSliderMetadataId
        
        if (metadataId && metadataName) {
          console.log('🎚️ Found metadata info, calling showRangeSlider...')
          controller.showRangeSlider(metadataId, metadataName)
          return
        } else {
          console.error('❌ Cannot reinitialize - missing metadata info')
        }
      }
      
      return
    }
  }
  
  // Cache slider dimensions for better performance
  window.cachedSliderRange = controller.rangeSliderData.max - controller.rangeSliderData.min
  window.cachedSliderMin = controller.rangeSliderData.min
  
  console.log('🎚️ Drag started - handle:', handleType)
  
  document.addEventListener('mousemove', handleRangeSliderDrag)
  document.addEventListener('mouseup', stopRangeSliderDrag)
  document.addEventListener('touchmove', handleRangeSliderDrag)
  document.addEventListener('touchend', stopRangeSliderDrag)
  
  // Change cursor
  document.body.style.cursor = 'grabbing'
}

function handleRangeSliderDrag(event) {
  if (!isDragging) return
  
  event.preventDefault()
  
  // Get the controller using the global variable
  const controller = window.visualizationController
  if (!controller || !controller.rangeSliderData) return
  
  const currentX = event.type === 'mousemove' ? event.clientX : event.touches[0].clientX
  
  // Get the slider track element and its position
  const slider = document.getElementById('range-slider-modal')
  const sliderTrack = document.getElementById('range-slider-track')
  const trackRect = sliderTrack.getBoundingClientRect()
  
  // Calculate position relative to the track
  const relativeX = currentX - trackRect.left
  const trackWidth = trackRect.width
  
  // Use cached values for better performance
  const range = window.cachedSliderRange || 1
  const min = window.cachedSliderMin || 0
  const max = min + range
  
  // Calculate value based on position within the track
  const percent = Math.max(0, Math.min(1, relativeX / trackWidth))
  let newValue = min + (percent * range)
  newValue = Math.max(min, Math.min(max, newValue))
  
  if (dragHandle === 'min') {
    newValue = Math.min(newValue, controller.rangeSliderData.currentMax)
    controller.rangeSliderData.currentMin = newValue
    // Update input field immediately
    document.getElementById('range-min-input').value = newValue.toFixed(3)
  } else {
    newValue = Math.max(newValue, controller.rangeSliderData.currentMin)
    controller.rangeSliderData.currentMax = newValue
    // Update input field immediately
    document.getElementById('range-max-input').value = newValue.toFixed(3)
  }
  
  // Keep global fallback in sync
  if (window.globalRangeSliderData) {
    window.globalRangeSliderData.currentMin = controller.rangeSliderData.currentMin
    window.globalRangeSliderData.currentMax = controller.rangeSliderData.currentMax
  }
  
  // Update handles immediately for smooth dragging (no throttling)
  controller.updateRangeSliderHandles()
  
  // Throttle plot updates to reduce lag
  if (!window.plotUpdateScheduled) {
    window.plotUpdateScheduled = true
    requestAnimationFrame(() => {
      controller.updatePlot()
      window.plotUpdateScheduled = false
    })
  }
}

function stopRangeSliderDrag() {
  isDragging = false
  dragHandle = null
  
  document.removeEventListener('mousemove', handleRangeSliderDrag)
  document.removeEventListener('mouseup', stopRangeSliderDrag)
  document.removeEventListener('touchmove', handleRangeSliderDrag)
  document.removeEventListener('touchend', stopRangeSliderDrag)
  
  // Reset cursor
  document.body.style.cursor = ''
}

// Modal drag functions
function startModalDrag(event) {
  event.preventDefault()
  event.stopPropagation()
  
  isModalDragging = true
  modalDragStartX = event.type === 'mousedown' ? event.clientX : event.touches[0].clientX
  modalDragStartY = event.type === 'mousedown' ? event.clientY : event.touches[0].clientY
  
  const modal = document.getElementById('range-slider-modal')
  const modalContent = modal.querySelector('div')
  const rect = modalContent.getBoundingClientRect()
  
  modalStartLeft = rect.left
  modalStartTop = rect.top
  
  document.addEventListener('mousemove', handleModalDrag)
  document.addEventListener('mouseup', stopModalDrag)
  document.addEventListener('touchmove', handleModalDrag)
  document.addEventListener('touchend', stopModalDrag)
  document.body.style.cursor = 'grabbing'
}

function handleModalDrag(event) {
  if (!isModalDragging) return
  event.preventDefault()
  
  const currentX = event.type === 'mousemove' ? event.clientX : event.touches[0].clientX
  const currentY = event.type === 'mousemove' ? event.clientY : event.touches[0].clientY
  
  const deltaX = currentX - modalDragStartX
  const deltaY = currentY - modalDragStartY
  
  const modal = document.getElementById('range-slider-modal')
  const modalContent = modal.querySelector('div')
  
  const newLeft = modalStartLeft + deltaX
  const newTop = modalStartTop + deltaY
  
  // Keep modal within viewport bounds
  const viewportWidth = window.innerWidth
  const viewportHeight = window.innerHeight
  const modalWidth = modalContent.offsetWidth
  const modalHeight = modalContent.offsetHeight
  
  const boundedLeft = Math.max(0, Math.min(newLeft, viewportWidth - modalWidth))
  const boundedTop = Math.max(0, Math.min(newTop, viewportHeight - modalHeight))
  
  modalContent.style.position = 'fixed'
  modalContent.style.left = boundedLeft + 'px'
  modalContent.style.top = boundedTop + 'px'
  modalContent.style.transform = 'none'
  modalContent.style.margin = '0'
}

function stopModalDrag() {
  isModalDragging = false
  document.removeEventListener('mousemove', handleModalDrag)
  document.removeEventListener('mouseup', stopModalDrag)
  document.removeEventListener('touchmove', handleModalDrag)
  document.removeEventListener('touchend', stopModalDrag)
  document.body.style.cursor = ''
}


function handleInlineRangeSliderDrag(event) {
  if (!isInlineDragging) return
  event.preventDefault()
  
  const controller = window.visualizationController
  if (!controller || !controller.inlineRangeSliderData || !controller.inlineRangeSliderData[inlineDragMetadataId]) {
    console.error('❌ Missing controller or inline range slider data')
    return
  }
  
  const currentX = event.type === 'mousemove' ? event.clientX : event.touches[0].clientX
  
  // Get the slider track element
  const metadataCard = document.querySelector(`[data-metadata-item="${inlineDragMetadataId}"]`)
  if (!metadataCard) {
    console.error('❌ Metadata card not found:', inlineDragMetadataId)
    return
  }
  
  const sliderTrack = metadataCard.querySelector('.range-slider-track')
  if (!sliderTrack) {
    console.error('❌ Slider track not found')
    return
  }
  
  const trackRect = sliderTrack.getBoundingClientRect()
  
  // Calculate position relative to the track
  const relativeX = currentX - trackRect.left
  const trackWidth = trackRect.width
  
  const sliderData = controller.inlineRangeSliderData[inlineDragMetadataId]
  const range = sliderData.max - sliderData.min
  const min = sliderData.min
  
  // Calculate value based on position within the track
  const percent = Math.max(0, Math.min(1, relativeX / trackWidth))
  let newValue = min + (percent * range)
  newValue = Math.max(min, Math.min(sliderData.max, newValue))
  
  if (inlineDragHandle === 'min') {
    newValue = Math.min(newValue, sliderData.currentMax)
    sliderData.currentMin = newValue
  } else {
    newValue = Math.max(newValue, sliderData.currentMin)
    sliderData.currentMax = newValue
  }
  
  // Update UI
  updateInlineRangeSlider(inlineDragMetadataId)
  
  // Update the density plot to show the new range selection
  if (controller && controller.inlineRangeSliderData && controller.inlineRangeSliderData[inlineDragMetadataId]) {
    const values = controller.inlineRangeSliderData[inlineDragMetadataId].values
    drawInlineDensityPlot(inlineDragMetadataId, values)
  }
}

function stopInlineRangeSliderDrag() {
  isInlineDragging = false
  inlineDragHandle = null
  inlineDragMetadataId = null
  document.removeEventListener('mousemove', handleInlineRangeSliderDrag)
  document.removeEventListener('mouseup', stopInlineRangeSliderDrag)
  document.removeEventListener('touchmove', handleInlineRangeSliderDrag)
  document.removeEventListener('touchend', stopInlineRangeSliderDrag)
  document.body.style.cursor = ''
}

function updateInlineRangeSlider(metadataId) {
  const controller = window.visualizationController
  if (!controller || !controller.inlineRangeSliderData || !controller.inlineRangeSliderData[metadataId]) {
    console.error('❌ Cannot update inline range slider - missing data')
    return
  }
  
  const sliderData = controller.inlineRangeSliderData[metadataId]
  const { min, max, currentMin, currentMax } = sliderData
  const range = max - min
  
  const minPercent = ((currentMin - min) / range) * 100
  const maxPercent = ((currentMax - min) / range) * 100
  
  const metadataCard = document.querySelector(`[data-metadata-item="${metadataId}"]`)
  if (!metadataCard) {
    console.error('❌ Metadata card not found for update:', metadataId)
    return
  }
  
  const minHandle = metadataCard.querySelector('.range-slider-min-handle')
  const maxHandle = metadataCard.querySelector('.range-slider-max-handle')
  const activeTrack = metadataCard.querySelector('.range-slider-active')
  const minInput = metadataCard.querySelector('.range-min-input')
  const maxInput = metadataCard.querySelector('.range-max-input')
  
  if (minHandle) minHandle.style.left = `${minPercent}%`
  if (maxHandle) maxHandle.style.left = `${maxPercent}%`
  if (activeTrack) {
    activeTrack.style.left = `${minPercent}%`
    activeTrack.style.width = `${maxPercent - minPercent}%`
  }
  if (minInput) minInput.value = currentMin.toFixed(3)
  if (maxInput) maxInput.value = currentMax.toFixed(3)
  
  console.log('🎚️ Updated inline range slider:', { minPercent, maxPercent, currentMin, currentMax })
}

function drawInlineDensityPlot(metadataId, values) {
  const metadataCard = document.querySelector(`[data-metadata-item="${metadataId}"]`)
  const canvas = metadataCard.querySelector('.density-plot-canvas')
  const ctx = canvas.getContext('2d')
  
  // Set canvas size
  canvas.width = canvas.offsetWidth * window.devicePixelRatio
  canvas.height = canvas.offsetHeight * window.devicePixelRatio
  ctx.scale(window.devicePixelRatio, window.devicePixelRatio)
  
  const width = canvas.offsetWidth
  const height = canvas.offsetHeight
  
  // Clear canvas
  ctx.clearRect(0, 0, width, height)
  
  // Create histogram
  const bins = 30
  const min = Math.min(...values)
  const max = Math.max(...values)
  const binWidth = (max - min) / bins
  const histogram = new Array(bins).fill(0)
  
  values.forEach(value => {
    const binIndex = Math.min(Math.floor((value - min) / binWidth), bins - 1)
    histogram[binIndex]++
  })
  
  const maxCount = Math.max(...histogram)
  
  // Draw histogram
  ctx.fillStyle = '#3b82f6'
  ctx.strokeStyle = '#1d4ed8'
  ctx.lineWidth = 1
  
  histogram.forEach((count, i) => {
    const x = (i / bins) * width
    const barWidth = width / bins
    const barHeight = (count / maxCount) * (height - 20)
    const y = height - 10 - barHeight
    
    ctx.fillRect(x, y, barWidth - 1, barHeight)
    ctx.strokeRect(x, y, barWidth - 1, barHeight)
  })
  
  // Draw range selection
  const controller = window.visualizationController
  if (controller && controller.inlineRangeSliderData && controller.inlineRangeSliderData[metadataId]) {
    const { currentMin, currentMax } = controller.inlineRangeSliderData[metadataId]
    const minX = ((currentMin - min) / (max - min)) * width
    const maxX = ((currentMax - min) / (max - min)) * width
    
    ctx.fillStyle = 'rgba(59, 130, 246, 0.2)'
    ctx.fillRect(minX, 0, maxX - minX, height)
    
    ctx.strokeStyle = '#ef4444'
    ctx.lineWidth = 2
    ctx.beginPath()
    ctx.moveTo(minX, 0)
    ctx.lineTo(minX, height)
    ctx.moveTo(maxX, 0)
    ctx.lineTo(maxX, height)
    ctx.stroke()
  }
}

