        <div id="checkpoint-save-existing-fields" style="display: none; flex-direction: column; gap: 6px; padding: 8px 0 0 24px;">
          <label for="checkpoint-save-existing-select" style="font-size: 12px; color: #4b5563;">Checkpoint</label>
          <select id="checkpoint-save-existing-select"
                  style="border: 1px solid #d1d5db; border-radius: 6px; padding: 7px 8px; font-size: 13px; background: #fff;">
          </select>
