<%= form_with(model: version, class: "space-y-6") do |form| %>
  <% if version.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <p class="font-semibold"><%= pluralize(version.errors.count, "error") %> prohibited this version from being saved:</p>
      <ul class="mt-2 list-disc pl-5">
        <% version.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :release_date, class: "block text-sm font-medium text-gray-700" %>
    <div class="mt-1">
      <%= form.datetime_select :release_date, { include_seconds: false }, class: "rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" %>
    </div>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-medium text-gray-700" %>
    <div class="mt-1">
      <%= form.text_area :description, rows: 4, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" %>
    </div>
  </div>

  <div>
    <%= form.label :env_json, "Environment JSON", class: "block text-sm font-medium text-gray-700" %>
    <div class="mt-1">
      <%= form.text_area :env_json, rows: 8, class: "w-full font-mono text-xs rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" %>
    </div>
    <p class="mt-1 text-xs text-gray-500">Include keys such as <code>tool_versions</code> or <code>docker_images</code> to populate the release summary.</p>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div class="flex items-center gap-2">
      <%= form.check_box :activated, class: "rounded border-gray-300 text-gray-900 focus:ring-gray-900" %>
      <%= form.label :activated, class: "text-sm text-gray-700" %>
    </div>
    <div class="flex items-center gap-2">
      <%= form.check_box :beta, class: "rounded border-gray-300 text-gray-900 focus:ring-gray-900" %>
      <%= form.label :beta, class: "text-sm text-gray-700" %>
    </div>
  </div>

  <div>
    <%= form.label :tools_json, class: "block text-sm font-medium text-gray-700" %>
    <div class="mt-1">
      <%= form.text_area :tools_json, rows: 3, class: "w-full font-mono text-xs rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" %>
    </div>
  </div>

  <div>
    <%= form.label :docker_json, class: "block text-sm font-medium text-gray-700" %>
    <div class="mt-1">
      <%= form.text_area :docker_json, rows: 3, class: "w-full font-mono text-xs rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" %>
    </div>
  </div>

  <div>
    <%= form.label :activated_at, class: "block text-sm font-medium text-gray-700" %>
    <div class="mt-1">
      <%= form.datetime_select :activated_at, { include_seconds: false, include_blank: true }, class: "rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" %>
    </div>
  </div>

  <div class="flex items-center justify-end gap-2">
    <%= link_to 'Cancel', versions_path, class: 'inline-flex items-center px-3 py-2 rounded-md border border-gray-200 text-sm text-gray-700 hover:bg-gray-50' %>
    <%= form.submit class: "inline-flex items-center px-3 py-2 rounded-md bg-gray-900 text-white text-sm font-medium hover:bg-gray-800 transition" %>
  </div>
<% end %>

