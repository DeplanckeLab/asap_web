<% if @step %>
  <div class="step-results h-full flex flex-col">
    <!-- Step Header -->
    <div class="mb-4">
      <h3 class="mb-2">
        <i class="fas fa-tasks me-2"></i><%= @step.label.presence || @step.name %>
      </h3>
      <% if @step.description.present? %>
        <p class="text-muted mb-2"><%= @step.description %></p>
      <% end %>
      
      <!-- Step Status -->
      <% if @project_step %>
        <% status_id = @project_step.status_id %>
        <% status = case status_id
                    when 1 then { name: 'waiting', class: 'warning', icon: 'clock' }
                    when 2 then { name: 'running', class: 'info', icon: 'spinner fa-spin' }
                    when 3 then { name: 'complete', class: 'success', icon: 'check-circle' }
                    when 4 then { name: 'failed', class: 'danger', icon: 'exclamation-circle' }
                    else { name: 'not started', class: 'secondary', icon: 'circle' }
                    end %>
        <div class="mb-3">
          <span class="badge badge-<%= status[:class] %>">
            <i class="fas fa-<%= status[:icon] %> me-1"></i><%= status[:name].humanize %>
          </span>
          <% if @step.rank %>
            <span class="badge badge-secondary ml-2">Rank: <%= @step.rank %></span>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Runs Section -->
    <div class="runs-section">
      <h4 class="mb-3">
        <i class="fas fa-list me-2"></i>Runs
        <span class="badge badge-info"><%= @runs.count %></span>
      </h4>
      
      <% if @runs.any? %>
        <div class="table-responsive">
          <table class="table table-hover">
            <thead class="thead-light">
              <tr>
                <th>Run #</th>
                <th>Status</th>
                <th>Created</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @runs.each do |run| %>
                <% run_status = case run.status_id
                                when 1 then { name: 'waiting', class: 'warning' }
                                when 2 then { name: 'running', class: 'info' }
                                when 3 then { name: 'complete', class: 'success' }
                                when 4 then { name: 'failed', class: 'danger' }
                                else { name: 'unknown', class: 'secondary' }
                                end %>
                <tr>
                  <td>
                    <strong>#<%= run.num || run.id %></strong>
                  </td>
                  <td>
                    <span class="badge badge-<%= run_status[:class] %>">
                      <%= run_status[:name].humanize %>
                    </span>
                  </td>
                  <td>
                    <% if run.created_at %>
                      <%= run.created_at.strftime("%Y-%m-%d %H:%M") %>
                    <% else %>
                      <span class="text-muted">N/A</span>
                    <% end %>
                  </td>
                  <td>
                    <%= link_to project_path(@project, view: 'data'), class: 'btn btn-sm btn-outline-primary' do %>
                      <i class="fas fa-eye me-1"></i>View
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="flex-1 flex items-center justify-center">
          <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 text-center">
            <i class="fas fa-info-circle text-blue-600 mb-2"></i>
            <p class="text-blue-800 mb-0">No runs found for this step.</p>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Step Information -->
    <div class="step-info mt-4 flex-shrink-0 border-t border-gray-200 pt-4">
      <h4 class="mb-3 text-lg font-semibold text-gray-900">
        <i class="fas fa-info-circle me-2"></i>Step Information
      </h4>
      <div class="grid grid-cols-2 gap-4">
        <dl class="grid grid-cols-2 gap-x-4 gap-y-2">
          <dt class="text-sm font-medium text-gray-500">Name:</dt>
          <dd class="text-sm text-gray-900"><%= @step.name %></dd>
          
          <% if @step.label.present? %>
            <dt class="text-sm font-medium text-gray-500">Label:</dt>
            <dd class="text-sm text-gray-900"><%= @step.label %></dd>
          <% end %>
          
          <% if @step.rank.present? %>
            <dt class="text-sm font-medium text-gray-500">Rank:</dt>
            <dd class="text-sm text-gray-900"><%= @step.rank %></dd>
          <% end %>
          
          <% if @step.group_name.present? %>
            <dt class="text-sm font-medium text-gray-500">Group:</dt>
            <dd class="text-sm text-gray-900"><%= @step.group_name %></dd>
          <% end %>
        </dl>
      </div>
    </div>
  </div>
<% else %>
  <div class="alert alert-warning">
    <i class="fas fa-exclamation-triangle me-2"></i>Step not found.
  </div>
<% end %>

