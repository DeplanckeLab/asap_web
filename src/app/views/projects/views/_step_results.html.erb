<% if @step %>
  <div class="step-results h-full flex flex-col">
    <!-- Step Header -->
    <div class="mb-4">
      <h3 class="mb-2">
        <i class="fas fa-tasks me-2"></i><%= @step.label.presence || @step.name %>
      </h3>
      <% if @step.description.present? %>
        <p class="text-muted mb-2"><%= @step.description %></p>
      <% end %>
      
      <!-- Step Status -->
      <% if @project_step %>
        <% status_id = @project_step.status_id %>
        <% status = case status_id
                    when 1 then { name: 'waiting', class: 'warning', icon: 'clock' }
                    when 2 then { name: 'running', class: 'info', icon: 'spinner fa-spin' }
                    when 3 then { name: 'complete', class: 'success', icon: 'check-circle' }
                    when 4 then { name: 'failed', class: 'danger', icon: 'exclamation-circle' }
                    else { name: 'not started', class: 'secondary', icon: 'circle' }
                    end %>
        <div class="mb-3">
          <span class="badge badge-<%= status[:class] %>">
            <i class="fas fa-<%= status[:icon] %> me-1"></i><%= status[:name].humanize %>
          </span>
          <% if @step.rank %>
            <span class="badge badge-secondary ml-2">Rank: <%= @step.rank %></span>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Error Display Section -->
    <% if @project_step && @project_step.status_id == 4 && @project_step.error_message.present? %>
      <div class="mb-4">
        <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg shadow-sm">
          <div class="flex items-start">
            <div class="flex-shrink-0">
              <i class="fas fa-exclamation-circle text-red-600 text-xl"></i>
            </div>
            <div class="ml-3 flex-1">
              <h4 class="text-red-800 font-semibold mb-2">
                <i class="fas fa-times-circle me-2"></i>Step Failed
              </h4>
              <div class="text-red-700 text-sm whitespace-pre-wrap break-words">
                <%= @project_step.error_message %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Parsing Results Section (only for parsing step) -->
    <% if @step.name == 'parsing' && @parsing_run && @parsing_run.status_id == 3 && @results && !@results['displayed_error'] %>
      <div class="card mb-2" id="result_summary">
        <div class="card-header">
          Parsing results
        </div>
        <div class="card-body">
          <!-- File Format (float-right like original) -->
          <div class="float-right">
            <% if @h_formats && @results && @results["detected_format"] && @h_formats[@results["detected_format"]] %>
              <%= raw display_file_format(@h_formats[@results["detected_format"]]) %>
            <% elsif @results && @results["detected_format"] %>
              <%= @results["detected_format"] %>
            <% end %>
          </div>

          <!-- Warnings and Errors (using helper methods if available) -->
          <% if @results['warnings'] %>
            <% warnings = @results['warnings'].is_a?(Array) ? @results['warnings'] : [@results['warnings']].compact %>
            <% if warnings.any? %>
              <% warnings.each do |warning| %>
                <% next if warning.blank? %>
                <div class="alert alert-warning mb-2">
                  <i class="fas fa-exclamation-triangle me-2"></i><%= warning %>
                </div>
              <% end %>
            <% end %>
          <% end %>

          <% if @results['errors'] %>
            <% errors = @results['errors'].is_a?(Array) ? @results['errors'] : [@results['errors']].compact %>
            <% if errors.any? %>
              <% errors.each do |error| %>
                <% next if error.blank? %>
                <div class="alert alert-danger mb-2">
                  <i class="fas fa-exclamation-circle me-2"></i><%= error %>
                </div>
              <% end %>
            <% end %>
          <% end %>
          
          <!-- Also check for any error messages that might be stored in other fields -->
          <% if @results['error'] && @results['error'].present? && !@results['displayed_error'] %>
            <div class="alert alert-danger mb-2">
              <i class="fas fa-exclamation-circle me-2"></i><%= @results['error'] %>
            </div>
          <% end %>
          
          <% if @results['warning'] && @results['warning'].present? %>
            <div class="alert alert-warning mb-2">
              <i class="fas fa-exclamation-triangle me-2"></i><%= @results['warning'] %>
            </div>
          <% end %>

          <!-- Parameters (for non-LOOM/H5_10x/MEX formats) -->
          <% if @results && !['LOOM', 'H5_10x', 'MEX'].include?(@results["detected_format"]) && @project.parsing_attrs_json %>
            <% h_attrs = Basic.safe_parse_json(@project.parsing_attrs_json, {}) %>
            <p class="sub-run_card">Parameters</p>
            <% h_delimiter = {"\\t" => 'Tab', "\t" => "Tab", " " => "Space", "," => "Comma", ":" => "Colon"} %>
            <% if h_attrs['delimiter'] && h_attrs['delimiter'] != '' %>
              <p>
                <span class="badge badge-secondary">Delimiter: <%= h_delimiter[h_attrs['delimiter']] || h_attrs['delimiter'] %></span>
            <% end %>
            <% h_gene_name_col = {"0" => "First", "first" => "First", "-1" => "Last", "last" => "Last", "NA" => "None", 'none' => "None"} %>
            <% if h_attrs['gene_name_col'] %>
              <span class="badge badge-secondary">Gene name column: <%= h_gene_name_col[h_attrs['gene_name_col']] || h_attrs['gene_name_col'] %></span>
            <% end %>
            <% if h_attrs['skip_line'] %>
              <span class="badge badge-secondary">Skip lines: <%= h_attrs['skip_line'] %></span>
            <% end %>
            <% if h_attrs['has_header'] %>
              <span class="badge badge-secondary">Has header: <%= (h_attrs['has_header'] == "1" || h_attrs['has_header'] == true) ? 'Yes' : 'No' %></span>
            <% end %>
            </p>
          <% end %>

          <!-- Integration section (if applicable) -->
          <% if @project.parsing_attrs_json %>
            <% h_attrs = Basic.safe_parse_json(@project.parsing_attrs_json, {}) %>
            <% if h_attrs['integrate_batch_paths'] %>
              <p class="sub-run_card">Integration</p>
              <% integrated_projects = Project.where(key: h_attrs['integrate_batch_paths'].keys).all %>
              <table id="integration_params">
                <tbody>
                  <tr>
                    <td>Number of PCs taken into account</td>
                    <td><%= h_attrs["integrate_n_pcs"] %></td>
                  </tr>
                  <tr>
                    <td>Integrated projects</td>
                    <td>
                      <table id="integration_projects">
                        <thead>
                          <tr>
                            <th>Project key</th>
                            <th>Project name</th>
                            <th>Batch metadata</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% integrated_projects.each do |p| %>
                            <tr>
                              <td><%= p.key %></td>
                              <td><%= p.name %></td>
                              <td>
                                <%= (h_attrs['integrate_batch_paths'][p.key] == 'null') ? 'None' : h_attrs['integrate_batch_paths'][p.key] %>
                              </td>
                            </tr>
                          <% end %>
                        </tbody>
                      </table>
                    </td>
                  </tr>
                </tbody>
              </table>
            <% end %>
          <% end %>

          <!-- Output Summary -->
          <p class="sub-run_card">Output summary</p>
          <p>
            <% if @results['nber_rows'] %>
              <span class="badge badge-info">genes:<%= @results['nber_rows'] %></span>
            <% end %>
            <% if @results['nber_cols'] %>
              <span class="badge badge-info">cells:<%= @results['nber_cols'] %></span>
            <% end %>
          </p>

          <!-- Validation Warnings -->
          <% if @results['nber_rows'] && @results['nber_rows'] < 3 %>
            <i class="fas fa-exclamation-triangle warning-icon"></i>
            <div class="alert alert-danger">
              For many steps of the pipeline at least three genes are required
            </div>
          <% end %>

          <% if @results['nber_cols'] && @results['nber_cols'] == 0 %>
            <div class="alert alert-danger">
              You may have selected wrong parameters for the parsing, in particular not the appropriated delimiter
            </div>
          <% elsif @results['nber_cols'] && @results['nber_cols'] < 3 %>
            <div class="alert alert-danger">
              <i class="fas fa-exclamation-triangle warning-icon"></i>
              Original dataset has less than 3 cells
              <span class="badge badge-danger">
                For many steps of the pipeline at least three cells are required
              </span>
            </div>
          <% end %>

          <!-- Count Matrix Status -->
          <% if @results['is_count_table'] == 1 || @results['is_count_table'] == true %>
            <div class="alert alert-success">
              <i class="fas fa-check-circle"></i>
              The original matrix contains only counts
            </div>
          <% else %>
            <div class="alert alert-danger">
              <i class="fas fa-exclamation-triangle warning-icon"></i>
              The original matrix contains floats
              <span class="badge badge-danger">
                Many methods will NOT be available if your original file is not a count matrix
              </span>
            </div>
          <% end %>

          <!-- Zero Values Percentage -->
          <% if @results['nber_zeros'] && @results['nber_rows'] && @results['nber_cols'] %>
            <% total_values = @results['nber_rows'].to_f * @results['nber_cols'].to_f %>
            <% if total_values > 0 %>
              <% zero_percentage = ((@results['nber_zeros'].to_f * 100) / total_values).round(2) %>
              <div class="alert alert-info">
                <%= zero_percentage %>% of values are zeros
              </div>
            <% end %>
          <% end %>

          <!-- Ensembl Mapping Status -->
          <% if nber_not_found_genes = @results['nber_not_found_genes'] && nber_not_found_genes > 0 %>
            <% total_genes = @results['nber_rows'] || 1 %>
            <% not_found_percentage = (nber_not_found_genes.to_f * 100 / total_genes).round(2) %>
            <div class="alert alert-danger">
              <i class="fas fa-exclamation-triangle warning-icon"></i>
              <%= nber_not_found_genes %> (<%= not_found_percentage %>%) genes were not found in Ensembl
              <span class="badge badge-danger">
                <i class="fas fa-lightbulb"></i>
                Did you select the right species (now <%= @project.organism&.name || 'Unknown' %>)? If not, create a new project
              </span>
            </div>
          <% else %>
            <% if @results['nber_rows'] %>
              <div class="alert alert-success">
                <i class="fas fa-check-circle"></i>
                All <%= @results['nber_rows'] %> genes were found in Ensembl
              </div>
            <% end %>
          <% end %>

          <!-- Results Files -->
          <p class="sub-run_card">Results</p>
          <p>
            <% project_dir = Pathname.new(ENV.fetch('USER_DATA_DIR')) + @project.user_id.to_s + @project.key %>
            <% loom_file = project_dir + 'parsing' + 'output.loom' %>
            <% if File.exist?(loom_file) && exportable?(@project) %>
              <%= link_to(raw("<button class='btn btn-outline-secondary btn-sm'>Loom file</button>"), 
                  get_file_project_path(@project.key, step: 'parsing', filename: 'output.loom'), 
                  target: '_blank') %>
              <span class="link_to_loom_tuto info-btn pointer">
                <sup><i class="fas fa-info-circle fa-lg"></i></sup>
              </span>
            <% end %>
          </p>
          <% if admin? %>
            <% json_file = project_dir + 'parsing' + 'output.json' %>
            <% if File.exist?(json_file) && exportable?(@project) %>
              <p>
                <%= link_to(raw("<button class='btn btn-outline-secondary btn-sm'>JSON file</button>"), 
                    get_file_project_path(@project.key, step: 'parsing', filename: 'output.json'), 
                    target: '_blank') %>
              </p>
            <% end %>
            <% log_file = project_dir + 'parsing' + 'output.log' %>
            <% if File.exist?(log_file) && exportable?(@project) %>
              <p>
                <%= link_to(raw("<button class='btn btn-outline-secondary btn-sm'>Log file</button>"), 
                    get_file_project_path(@project.key, step: 'parsing', filename: 'output.log'), 
                    target: '_blank') %>
              </p>
            <% end %>
          <% end %>
        </div>
        <div class="card-footer">
          <small class="text-muted">
            <% metadata_parts = [] %>
            <% if admin? %>
              <% metadata_parts << "##{@parsing_run.id}" %>
            <% end %>
            <% if @parsing_run.created_at %>
              <% metadata_parts << "<span class='nowrap'>#{display_date_short(@parsing_run.created_at)}</span>" %>
              <% if @parsing_run.submitted_at %>
                <% metadata_parts << "<span id='created_time_#{@parsing_run.id}' class='hidden'>#{@parsing_run.submitted_at.strftime('%Y-%m-%d %H:%M:%S')}</span>" %>
              <% end %>
              <% if @parsing_run.start_time %>
                <% metadata_parts << "<span id='start_time_#{@parsing_run.id}' class='hidden'>#{@parsing_run.start_time.strftime('%Y-%m-%d %H:%M:%S')}</span>" %>
              <% end %>
            <% end %>
            <% if @parsing_run.waiting_duration %>
              <% metadata_parts << "<span class='nowrap'>Wait #{duration(@parsing_run.waiting_duration.to_i)}</span>" %>
            <% elsif @parsing_run.status_id == 1 && @parsing_run.submitted_at %>
              <% wait_time = (Time.now - @parsing_run.submitted_at).to_i %>
              <% metadata_parts << "<span id='ongoing_wait_#{@parsing_run.id}' class='nowrap'>Wait #{duration(wait_time)}</span>" %>
            <% end %>
            <% if @parsing_run.duration %>
              <% metadata_parts << "<span class='nowrap'>Run #{duration(@parsing_run.duration.to_i)}</span>" %>
            <% elsif @parsing_run.status_id == 2 && @parsing_run.start_time %>
              <% run_time = (Time.now - @parsing_run.start_time).to_i %>
              <% metadata_parts << "<span id='ongoing_run_#{@parsing_run.id}' class='nowrap'>Run #{duration(run_time)}</span>" %>
            <% end %>
            <% if @results && @results['time_idle'] %>
              <% metadata_parts << "<span class='nowrap'>Idle #{@results['time_idle']}</span>" %>
            <% end %>
            <% if @parsing_run.max_ram %>
              <% ram_mb = (@parsing_run.max_ram * 1000).to_f %>
              <% ram_display = display_mem(ram_mb) %>
              <% metadata_parts << "<span class='nowrap'>Max. RAM #{ram_display}</span>" %>
            <% end %>
            <%= raw metadata_parts.compact.join(", ") %>
          </small>
        </div>
      </div>
      
      <%= javascript_tag do %>
        <% project_dir = Pathname.new(ENV.fetch('USER_DATA_DIR')) + @project.user_id.to_s + @project.key %>
        <% loom_file = project_dir + 'parsing' + 'output.loom' %>
        <% if File.exist?(loom_file) && exportable?(@project) %>
          $(".link_to_loom_tuto").click(function(e){
            var url = '<%= tutorial_home_index_path(t: 'loom') rescue '#' %>'
            var win = window.open(url, '_blank');
            if (win) win.focus();
            e.stopPropagation();
            e.preventDefault();
            return false;
          })
        <% end %>
        
        <% if @project.parsing_attrs_json %>
          <% h_attrs = Basic.safe_parse_json(@project.parsing_attrs_json, {}) %>
          <% if h_attrs['integrate_batch_paths'] %>
            if (typeof $.fn.DataTable !== 'undefined') {
              $("#integration_projects").DataTable()
            }
          <% end %>
        <% end %>
      <% end %>
    <% elsif @step.name == 'parsing' && @results && @results['displayed_error'] %>
      <!-- Parsing Error Display -->
      <div class="mb-4">
        <% if @results['displayed_error'].is_a?(Array) %>
          <% @results['displayed_error'].each do |error| %>
            <p class="text-danger text-truncate" title="<%= error %>"><%= error %></p>
          <% end %>
        <% else %>
          <p class="text-danger"><%= @results['displayed_error'] %></p>
        <% end %>
        <% if admin? && @results['original_error'] %>
          <br/><span class="text-muted"><%= @results['original_error'] %></span>
        <% end %>
      </div>
    <% end %>

    <!-- Runs Section -->
    <div class="runs-section">
      <h4 class="mb-3">
        <i class="fas fa-list me-2"></i>Runs
        <span class="badge badge-info"><%= @runs.count %></span>
      </h4>
      
      <% if @runs.any? %>
        <div class="table-responsive">
          <table class="table table-hover">
            <thead class="thead-light">
              <tr>
                <th>Run #</th>
                <th>Status</th>
                <th>Created</th>
                <th>Error</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @runs.each do |run| %>
                <% run_status = case run.status_id
                                when 1 then { name: 'waiting', class: 'warning' }
                                when 2 then { name: 'running', class: 'info' }
                                when 3 then { name: 'complete', class: 'success' }
                                when 4 then { name: 'failed', class: 'danger' }
                                else { name: 'unknown', class: 'secondary' }
                                end %>
                <tr>
                  <td>
                    <strong>#<%= run.num || run.id %></strong>
                  </td>
                  <td>
                    <span class="badge badge-<%= run_status[:class] %>">
                      <%= run_status[:name].humanize %>
                    </span>
                  </td>
                  <td>
                    <% if run.created_at %>
                      <%= run.created_at.strftime("%Y-%m-%d %H:%M") %>
                    <% else %>
                      <span class="text-muted">N/A</span>
                    <% end %>
                  </td>
                  <td>
                    <% if run.status_id == 4 && run.error.present? %>
                      <div class="text-red-600 text-xs max-w-xs truncate" title="<%= run.error %>">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        <%= truncate(run.error, length: 50) %>
                      </div>
                    <% else %>
                      <span class="text-muted">-</span>
                    <% end %>
                  </td>
                  <td>
                    <%= link_to project_path(@project, view: 'data'), class: 'btn btn-sm btn-outline-primary' do %>
                      <i class="fas fa-eye me-1"></i>View
                    <% end %>
                  </td>
                </tr>
                <% if run.status_id == 4 && run.error.present? %>
                  <tr class="bg-red-50">
                    <td colspan="5" class="p-3">
                      <div class="bg-white border border-red-200 rounded p-3">
                        <div class="flex items-start">
                          <i class="fas fa-exclamation-circle text-red-600 mt-1 mr-2"></i>
                          <div class="flex-1">
                            <strong class="text-red-800 text-sm block mb-1">Error Details:</strong>
                            <div class="text-red-700 text-xs font-mono whitespace-pre-wrap break-words">
                              <%= run.error %>
                            </div>
                          </div>
                        </div>
                      </div>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="flex-1 flex items-center justify-center">
          <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 text-center">
            <i class="fas fa-info-circle text-blue-600 mb-2"></i>
            <p class="text-blue-800 mb-0">No runs found for this step.</p>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Step Information -->
    <div class="step-info mt-4 flex-shrink-0 border-t border-gray-200 pt-4">
      <h4 class="mb-3 text-lg font-semibold text-gray-900">
        <i class="fas fa-info-circle me-2"></i>Step Information
      </h4>
      <div class="grid grid-cols-2 gap-4">
        <dl class="grid grid-cols-2 gap-x-4 gap-y-2">
          <dt class="text-sm font-medium text-gray-500">Name:</dt>
          <dd class="text-sm text-gray-900"><%= @step.name %></dd>
          
          <% if @step.label.present? %>
            <dt class="text-sm font-medium text-gray-500">Label:</dt>
            <dd class="text-sm text-gray-900"><%= @step.label %></dd>
          <% end %>
          
          <% if @step.rank.present? %>
            <dt class="text-sm font-medium text-gray-500">Rank:</dt>
            <dd class="text-sm text-gray-900"><%= @step.rank %></dd>
          <% end %>
          
          <% if @step.group_name.present? %>
            <dt class="text-sm font-medium text-gray-500">Group:</dt>
            <dd class="text-sm text-gray-900"><%= @step.group_name %></dd>
          <% end %>
        </dl>
      </div>
    </div>
  </div>
<% else %>
  <div class="alert alert-warning">
    <i class="fas fa-exclamation-triangle me-2"></i>Step not found.
  </div>
<% end %>

