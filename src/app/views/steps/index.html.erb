<% content_for :title, "Steps - ASAP" %>
<div class="max-w-5xl mx-auto py-10 px-4 sm:px-6 lg:px-8 space-y-6">
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-semibold text-gray-900 dark:text-white">Steps</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-300">
        Manage analysis steps available in ASAP.
      </p>
    </div>
    <% if admin? %>
      <%= link_to 'New Step', new_step_path, class: 'inline-flex items-center px-3 py-2 rounded-md bg-gray-900 text-white text-sm font-medium hover:bg-gray-800 transition' %>
    <% end %>
  </div>

  <% if notice.present? %>
    <div class="rounded-md bg-green-100 px-4 py-3 text-sm text-green-700"><%= notice %></div>
  <% end %>

  <div class="rounded-lg border border-gray-200 bg-white shadow-sm p-4">
    <%= form_with url: steps_path, method: :get, local: true, class: "flex flex-col gap-4 sm:flex-row sm:items-end" do %>
      <div class="w-full sm:w-72">
        <label class="block text-sm font-medium text-gray-700 mb-1" for="version_id">Release (version_id)</label>
        <%= select_tag :version_id,
                       options_for_select(
                         @versions.map { |v| [ "Release #{v.id}", v.id ] },
                         @selected_version_id
                       ),
                       class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" %>
      </div>
      <div class="flex gap-2">
        <%= submit_tag "Filter", class: "inline-flex items-center px-4 py-2 rounded-md bg-gray-900 text-white text-sm font-medium hover:bg-gray-800 transition" %>
        <% if params[:version_id].present? %>
          <%= link_to "Clear", steps_path, class: "inline-flex items-center px-4 py-2 rounded-md border border-gray-200 text-sm text-gray-700 hover:bg-gray-50" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="space-y-3" data-controller="table-row-filter">
    <div class="rounded-lg border border-gray-200 bg-white shadow-sm p-4">
      <label class="block text-sm font-medium text-gray-700 mb-1" for="steps_table_filter">Filter table</label>
      <input
        type="search"
        id="steps_table_filter"
        autocomplete="off"
        placeholder="Type to filter by any text in step or docker image fields"
        class="w-full max-w-xl rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900"
        data-table-row-filter-target="input"
        data-action="input->table-row-filter#filter"
      />
      <div class="mt-3 flex items-start gap-2">
        <input
          type="checkbox"
          id="steps_table_filter_columns_only"
          class="mt-1 rounded border-gray-300 text-gray-900 focus:ring-gray-900"
          data-table-row-filter-target="columnsOnly"
          data-action="change->table-row-filter#filter"
        />
        <label for="steps_table_filter_columns_only" class="text-sm text-gray-700">
          Only search the columns shown in the table (ID, Rank, Object Name, Name, Label)
        </label>
      </div>
    </div>

    <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50 text-xs font-semibold uppercase tracking-wide text-gray-600">
          <tr>
            <% if admin? %>
              <th scope="col" class="w-10 px-3 py-2 text-left"></th>
            <% end %>
            <th scope="col" class="px-3 py-2 text-left">ID</th>
            <th scope="col" class="px-3 py-2 text-left">Rank</th>
            <th scope="col" class="px-3 py-2 text-left">Object Name</th>
            <th scope="col" class="px-3 py-2 text-left">Name</th>
            <th scope="col" class="px-3 py-2 text-left">Label</th>
            <th scope="col" class="px-3 py-2 text-right"></th>
          </tr>
        </thead>
        <tbody
          class="divide-y divide-gray-100 text-sm text-gray-700"
          data-table-row-filter-target="tbody"
          <% if admin? %>
            data-controller="sortable-list"
            data-sortable-list-url-value="<%= reorder_steps_path %>"
            data-sortable-list-item-selector-value="tr[data-id]"
          <% end %>
        >
          <% @steps.each do |step| %>
            <% row_data = {
              id: step.id,
              row_filter_text: step_index_row_filter_text(step),
              row_filter_columns: step_index_row_filter_text_table_columns(step)
            } %>
            <% row_data[:action] = "dragover->sortable-list#dragover drop->sortable-list#drop" if admin? %>
            <%= tag.tr data: row_data, class: ("hover:bg-gray-50" if admin?) do %>
              <% if admin? %>
                <td class="px-3 py-2">
                  <span
                    draggable="true"
                    class="inline-flex cursor-grab select-none items-center text-gray-400 hover:text-gray-600"
                    title="Drag to reorder"
                    data-action="dragstart->sortable-list#dragstart dragend->sortable-list#dragend"
                  >
                    <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <circle cx="6" cy="5" r="1.25"></circle>
                      <circle cx="14" cy="5" r="1.25"></circle>
                      <circle cx="6" cy="10" r="1.25"></circle>
                      <circle cx="14" cy="10" r="1.25"></circle>
                      <circle cx="6" cy="15" r="1.25"></circle>
                      <circle cx="14" cy="15" r="1.25"></circle>
                    </svg>
                    <span class="sr-only">Drag to reorder</span>
                  </span>
                </td>
              <% end %>
              <td class="px-3 py-2"><%= step.id %></td>
              <td class="px-3 py-2" data-rank-label><%= step.rank.presence || '—' %></td>
              <td class="px-3 py-2"><%= step.obj_name.presence || '—' %></td>
              <td class="px-3 py-2">
                <span class="font-medium text-gray-900"><%= step.name.presence || '—' %></span>
              </td>
              <td class="px-3 py-2 text-gray-700"><%= step.label.presence || '—' %></td>
              <td class="px-3 py-2 text-right">
                <%= link_to 'Show', step_path(step), class: 'text-gray-600 hover:text-gray-800' %>
                <% if admin? %>
                  <span class="mx-2 text-gray-300">|</span>
                  <%= link_to 'Edit', edit_step_path(step), class: 'text-gray-600 hover:text-gray-800' %>
                  <span class="mx-2 text-gray-300">|</span>
                  <%= link_to 'Destroy', step_path(step),
                              method: :delete,
                              data: { confirm: 'Are you sure?' },
                              class: 'text-red-600 hover:text-red-700' %>
                <% end %>
              </td>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% if @steps.empty? %>
    <div class="rounded-lg border border-dashed border-gray-300 bg-white px-6 py-10 text-center text-gray-500">
      No steps have been recorded yet.
    </div>
  <% end %>
</div>

