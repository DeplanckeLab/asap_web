<div class="flex flex-col h-full p-6">
  <div class="mb-4">
    <button type="button"
            class="float-right inline-flex items-center gap-2 rounded-md border border-gray-300 bg-white px-3 py-2 text-xs font-medium text-gray-700 transition-colors hover:bg-gray-50 cursor-pointer"
            onclick="openPipelineGraphOrRunDetails()">
      <i class="fas fa-arrow-left text-xs" aria-hidden="true"></i>
      <span>Back to step results</span>
    </button>
    <h3 class="text-lg font-semibold text-gray-900 mb-2">Analysis Graph</h3>
    <p class="text-gray-600 text-xs">Visual representation of the analysis pipeline and runs</p>
  </div>
  
  <div id="cy" class="cy flex-1" style="min-height: 400px; border: 1px solid #e5e7eb; border-radius: 0.5rem; background-color: #f9fafb; cursor: default;"></div>
</div>

<style>
  #cy canvas {
    cursor: default;
  }
  #cy .cy-node {
    cursor: pointer !important;
  }
  /* Make nodes more visually distinct and clickable */
  #cy {
    cursor: default;
  }
  /* Add a visual indicator that nodes are interactive */
  #cy::before {
    content: '';
    position: absolute;
    pointer-events: none;
  }
</style>

<!-- Load Cytoscape.js -->
<script src="https://cdn.jsdelivr.net/npm/cytoscape@3.26.0/dist/cytoscape.min.js"></script>

<%= javascript_tag do %>
(function() {
  function initializeGraph() {
    // Check if container exists
    var container = document.getElementById('cy');
    if (!container) {
      console.log('Waiting for graph container...');
      setTimeout(initializeGraph, 100);
      return;
    }
    
    // Check if Cytoscape is loaded
    if (typeof cytoscape === 'undefined') {
      console.log('Waiting for Cytoscape.js to load...');
      setTimeout(initializeGraph, 100);
      return;
    }
    
    var data = <%= raw @klay_data.to_json %>;
    // Safety guard: never draw edges between runs of the same logical step.
    // This protects the UI even if upstream lineage fields are inconsistent.
    var nodeById = {};
    data.forEach(function(item) {
      if (item && item.data && item.data.id && !item.data.source && !item.data.target) {
        nodeById[item.data.id] = item.data;
      }
    });
    var removedSameStepEdges = 0;
    data = data.filter(function(item) {
      if (!item || !item.data || !item.data.source || !item.data.target) {
        return true;
      }
      var sourceNode = nodeById[item.data.source];
      var targetNode = nodeById[item.data.target];
      if (!sourceNode || !targetNode) {
        return true;
      }
      var sourceStepName = sourceNode.step_name != null ? String(sourceNode.step_name).trim().toLowerCase() : '';
      var targetStepName = targetNode.step_name != null ? String(targetNode.step_name).trim().toLowerCase() : '';
      var sourceStepId = sourceNode.step_id != null ? String(sourceNode.step_id) : '';
      var targetStepId = targetNode.step_id != null ? String(targetNode.step_id) : '';
      var sameLogicalStep = sourceStepName !== '' && targetStepName !== '' && sourceStepName === targetStepName;
      var sameInternalStep = sourceStepId !== '' && sourceStepId === targetStepId;
      if (sameLogicalStep || sameInternalStep) {
        removedSameStepEdges += 1;
        return false;
      }
      return true;
    });
    if (removedSameStepEdges > 0) {
      console.warn('[Graph] Removed same-step edges:', removedSameStepEdges);
    }
    // Debug: list edges that will actually be rendered in the browser
    try {
      var edgesForDebug = data.filter(function(item) {
        return item && item.data && item.data.source && item.data.target;
      });
      console.log('[Graph][debug] rendered_edges_count=', edgesForDebug.length);
      edgesForDebug.forEach(function(edgeItem) {
        var sourceNode = nodeById[edgeItem.data.source] || {};
        var targetNode = nodeById[edgeItem.data.target] || {};
        console.log(
          '[Graph][debug][edge]',
          edgeItem.data.id,
          'source_run=', sourceNode.run_id,
          'source_step_id=', sourceNode.step_id,
          'source_step_name=', sourceNode.step_name,
          'target_run=', targetNode.run_id,
          'target_step_id=', targetNode.step_id,
          'target_step_name=', targetNode.step_name
        );
      });
    } catch (e) {
      console.warn('[Graph][debug] failed to log rendered edges', e);
    }

    var style = [
      {
        selector: 'node',
        style: {
          label: 'data(label)',
          'font-size': '20px',
          'font-weight': '700',
          'color': '#111827',
          'text-outline-color': '#ffffff',
          'text-outline-width': '3px',
          'background-color': 'data(color)',
          'width': 'label',
          'height': 'label',
          'shape': 'roundrectangle',
          'padding': '16px 18px',
          'text-valign': 'center',
          'text-halign': 'center',
          'cursor': 'pointer',
          'border-width': '2px',
          'border-color': '#ffffff',
          'border-opacity': '0.8',
          'border-style': 'solid',
          'opacity': '0.95'
        }
      },
      {
        selector: 'node.selected-step-node',
        style: {
          'border-width': '6px',
          'border-color': '#facc15',
          'border-opacity': '1',
          'opacity': '1',
          'text-outline-width': '4px',
          'text-outline-color': '#ffffff',
          // Yellow glow (layered tones for gradient-like effect)
          'shadow-color': '#fde047',
          'shadow-blur': '64',
          'shadow-opacity': '1',
          'shadow-offset-x': '0',
          'shadow-offset-y': '0'
        }
      },
      {
        selector: 'node:active',
        style: {
          'cursor': 'pointer'
        }
      },
      {
        selector: 'edge',
        style: {
          'curve-style': 'bezier',
          'target-arrow-shape': 'triangle',
          'line-color': '#aaa',
          'target-arrow-color': '#aaa',
          'opacity': 0.5,
          'width': 2
        }
      },
      {
        selector: 'edge[edge_type = "expression_matrix"]',
        style: {
          'line-color': '#3b82f6',
          'target-arrow-color': '#3b82f6',
          'opacity': 0.9,
          'width': 3
        }
      },
      {
        selector: 'edge[edge_type = "cell_metadata"]',
        style: {
          'line-color': '#22c55e',
          'target-arrow-color': '#22c55e',
          'opacity': 0.9,
          'width': 3
        }
      },
      {
        selector: 'edge[edge_type = "gene_metadata"]',
        style: {
          'line-color': '#f59e0b',
          'target-arrow-color': '#f59e0b',
          'opacity': 0.9,
          'width': 3
        }
      }
    ];

    try {
      // Build a lane-style preset layout: one horizontal lane per logical step
      // to avoid visual ambiguity from crossing edges.
      var nodeElements = data.filter(function(item) {
        return item && item.data && item.data.id && !item.data.source && !item.data.target;
      });
      var stepMetaByName = {};
      nodeElements.forEach(function(item) {
        var stepName = (item.data.step_name || '').toString();
        if (!stepName) return;
        var rank = item.data.step_rank == null ? 9999 : Number(item.data.step_rank);
        if (!stepMetaByName[stepName]) {
          stepMetaByName[stepName] = { rank: rank, nodes: [] };
        }
        if (rank < stepMetaByName[stepName].rank) {
          stepMetaByName[stepName].rank = rank;
        }
        stepMetaByName[stepName].nodes.push(item.data);
      });
      var orderedSteps = Object.keys(stepMetaByName).sort(function(a, b) {
        var ar = stepMetaByName[a].rank;
        var br = stepMetaByName[b].rank;
        if (ar !== br) return ar - br;
        return a.localeCompare(b);
      });
      var positionsByNodeId = {};
      var laneYStart = 110;
      var laneYGap = 130;
      var laneXStart = 130;
      var laneXGap = 210;
      orderedSteps.forEach(function(stepName, stepIdx) {
        var laneNodes = stepMetaByName[stepName].nodes.slice().sort(function(a, b) {
          var an = Number(a.run_num || a.run_id || 0);
          var bn = Number(b.run_num || b.run_id || 0);
          if (an !== bn) return an - bn;
          return Number(a.run_id || 0) - Number(b.run_id || 0);
        });
        laneNodes.forEach(function(nodeData, nodeIdx) {
          positionsByNodeId[nodeData.id] = {
            x: laneXStart + (nodeIdx * laneXGap),
            y: laneYStart + (stepIdx * laneYGap)
          };
        });
      });

      var cy = window.cy = cytoscape({
        container: container,
        layout: {
          name: 'preset',
          fit: true,
          padding: 30,
          positions: function(node) {
            return positionsByNodeId[node.id()] || { x: 100, y: 100 };
          }
        },
        style: style,
        elements: data
      });

      // Store original dimensions for reset
      cy.nodes().forEach(function(node) {
        var renderedStyle = node.renderedStyle();
        node.data('originalWidth', renderedStyle.width);
        node.data('originalHeight', renderedStyle.height);
      });
      
      // Add hover styles for better interactivity and clickability indication
      cy.nodes().on('mouseover', function(e){
        var node = e.target;
        if (node.hasClass('selected-step-node')) {
          // Keep selected nodes in yellow highlight mode, with stronger glow on hover
          node.style('border-width', '7px');
          node.style('border-color', '#facc15');
          node.style('border-opacity', '1');
          node.style('shadow-color', '#fef08a');
          node.style('shadow-blur', '76');
          node.style('shadow-opacity', '1');
        } else {
          // Non-selected node hover style
          node.style('border-width', '4px');
          node.style('border-color', '#2563eb');
          node.style('border-opacity', '1');
        }
        // Enhance text outline for better readability
        node.style('text-outline-width', '4px');
        node.style('text-outline-color', '#ffffff');
        // Increase opacity to full
        node.style('opacity', '1');
        // Scale up noticeably (10% larger)
        var currentWidth = parseFloat(node.style('width')) || parseFloat(node.data('originalWidth') || 100);
        var currentHeight = parseFloat(node.style('height')) || parseFloat(node.data('originalHeight') || 50);
        node.style('width', (currentWidth * 1.1) + 'px');
        node.style('height', (currentHeight * 1.1) + 'px');
        // Make text slightly larger on hover
        node.style('font-size', '22px');
      });
      
      cy.nodes().on('mouseout', function(e){
        var node = e.target;
        // Reset to default styles
        if (node.hasClass('selected-step-node')) {
          node.style('border-width', '6px');
          node.style('border-color', '#facc15');
          node.style('border-opacity', '1');
          node.style('text-outline-width', '4px');
          node.style('opacity', '1');
          node.style('shadow-color', '#fde047');
          node.style('shadow-blur', '64');
          node.style('shadow-opacity', '1');
          node.style('shadow-offset-x', '0');
          node.style('shadow-offset-y', '0');
        } else {
          node.style('border-width', '2px');
          node.style('border-color', '#ffffff');
          node.style('border-opacity', '0.8');
          node.style('text-outline-width', '3px');
          node.style('opacity', '0.95');
          node.style('shadow-opacity', '0');
        }
        node.style('font-size', '20px');
        // Reset size to label-based
        node.style('width', 'label');
        node.style('height', 'label');
      });
      
      // Set cursor to pointer for all nodes
      cy.nodes().style('cursor', 'pointer');
      
      // Add click feedback animation
      cy.nodes().on('tap', function(e){
        var node = e.target;
        // Brief scale animation on click for feedback
        var currentWidth = parseFloat(node.style('width')) || 100;
        var currentHeight = parseFloat(node.style('height')) || 50;
        node.animate({
          style: {
            width: (currentWidth * 0.95) + 'px',
            height: (currentHeight * 0.95) + 'px'
          }
        }, {
          duration: 100,
          complete: function() {
            node.animate({
              style: {
                width: (currentWidth * 1.1) + 'px',
                height: (currentHeight * 1.1) + 'px'
              }
            }, {
              duration: 100
            });
          }
        });
      });
      
      cy.nodes().on('click', function(e){
        var node = e.target;
        var nodeData = node.data();
        console.log('Clicked node:', node.id(), nodeData);
        
        // Check if this is a run node
        if (nodeData.run_id) {
          // Load the run in the right panel
          var runUrl = '<%= runs_path %>/' + nodeData.run_id;
          if (typeof loadRunInRightPanel === 'function') {
            loadRunInRightPanel(runUrl, nodeData.step_id);
          } else {
            // Fallback: select the step
            const stepSelectorElement = document.querySelector('[data-controller*="step-selector"]');
            if (stepSelectorElement && window.Stimulus) {
              const controller = window.Stimulus.getControllerForElementAndIdentifier(stepSelectorElement, 'step-selector');
              if (controller && typeof controller.selectStep === 'function' && nodeData.step_id) {
                controller.selectStep({ params: { stepId: nodeData.step_id } });
              }
            }
          }
        } else if (nodeData.step_id) {
          // Fallback for step nodes (shouldn't happen with new implementation, but just in case)
          const stepSelectorElement = document.querySelector('[data-controller*="step-selector"]');
          if (stepSelectorElement && window.Stimulus) {
            const controller = window.Stimulus.getControllerForElementAndIdentifier(stepSelectorElement, 'step-selector');
            if (controller && typeof controller.selectStep === 'function') {
              controller.selectStep({ params: { stepId: nodeData.step_id } });
            }
          }
        }
      });

      function normalizeStepKey(rawValue) {
        if (rawValue == null) return '';
        return String(rawValue)
          .trim()
          .toLowerCase()
          .replace(/[_-]+/g, ' ')
          .replace(/\s+/g, ' ');
      }

      function applySelectedStepHighlight(stepId) {
        cy.nodes().removeClass('selected-step-node');
        if (!stepId) return;
        const normalizedSelectedStepId = String(stepId);

        // Highlight by logical step name so all internal step IDs for that step
        // are selected together and unrelated runs are excluded.
        const stepItems = Array.from(document.querySelectorAll('[data-step-id][data-step-name]'));
        const selectedStepItem = stepItems.find((el) => String(el.getAttribute('data-step-id')) === normalizedSelectedStepId);
        const selectedStepName = selectedStepItem ? selectedStepItem.getAttribute('data-step-name') : null;
        const normalizedSelectedStepName = normalizeStepKey(selectedStepName);
        if (!normalizedSelectedStepName) return;

        cy.nodes().forEach(function(node) {
          const nodeStepName = normalizeStepKey(node.data('step_name'));
          if (nodeStepName === normalizedSelectedStepName) {
            node.addClass('selected-step-node');
          }
        });
      }

      // Expose a global updater so left-panel step changes can refresh highlight in graph mode
      window.updatePipelineGraphStepHighlight = function(stepId) {
        applySelectedStepHighlight(stepId);
      };

      // Highlight graph nodes that belong to the currently selected step in analysis view
      var stepSelectorElement = document.querySelector('[data-controller*="step-selector"]');
      var selectedStepId = stepSelectorElement ? stepSelectorElement.getAttribute('data-current-step-id') : null;
      applySelectedStepHighlight(selectedStepId);
    } catch (error) {
      console.error('Error initializing Cytoscape graph:', error);
      container.innerHTML = '<div class="p-4 text-red-600">Error loading graph visualization: ' + error.message + '</div>';
    }
  }

  // Start initialization after a short delay to ensure DOM is ready
  setTimeout(initializeGraph, 200);
})();
<% end %>

