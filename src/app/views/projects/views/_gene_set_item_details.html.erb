<% if @gsi %>
<%
  identifier = @gsi.identifier.to_s
  is_obsolete = ActiveModel::Type::Boolean.new.cast(@gsi.obsolete)
  redirected_from = @gsi_redirected_from.to_s.presence
%>
<div class="space-y-4">
  <% if redirected_from.present? %>
  <div class="rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
    Redirected from obsolete term
    <span class="font-mono font-medium"><%= redirected_from %></span>
    to current term
    <span class="font-mono font-medium"><%= identifier %></span>.
  </div>
  <% end %>
  <div class="flex items-center gap-2 flex-wrap">
    <span class="text-sm text-gray-500 w-28 flex-shrink-0">Identifier</span>
    <span class="inline-flex items-center px-2.5 py-0.5 rounded text-sm font-medium bg-gray-800 text-white"><%= identifier %></span>
    <% if is_obsolete && redirected_from.blank? %>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800" title="Not present in the latest Ensembl annotation for this organism">Obsolete in latest Ensembl</span>
    <% end %>
  </div>
  <div class="flex items-start gap-2">
    <span class="text-sm text-gray-500 w-28 flex-shrink-0">Description</span>
    <span class="text-gray-800 text-sm"><%= @gsi.name %></span>
  </div>
  <div class="flex items-start gap-2">
    <span class="text-sm text-gray-500 w-28 flex-shrink-0">Genes (<%= @genes.size %>)</span>
    <div>
      <div class="flex flex-wrap gap-1 text-xs mb-3">
        <span class="inline-flex items-center px-2 py-0.5 rounded bg-gray-100 text-gray-500">Not in dataset</span>
        <span class="inline-flex items-center px-2 py-0.5 rounded bg-blue-100 text-blue-700">In dataset</span>
        <span class="inline-flex items-center px-2 py-0.5 rounded bg-green-100 text-green-700">Enriched in related DE</span>
      </div>
      <div class="flex flex-wrap gap-1">
        <% @genes.each do |gene| %>
          <%
            if @h_enriched_genes[gene.ensembl_id]
              badge_class = "bg-green-100 text-green-700 hover:bg-green-200"
            elsif @h_all_genes[gene.ensembl_id]
              badge_class = "bg-blue-100 text-blue-700 hover:bg-blue-200"
            else
              badge_class = "bg-gray-100 text-gray-500 hover:bg-gray-200"
            end
          %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium cursor-pointer transition-colors gsi-gene-badge <%= badge_class %>"
                data-ensembl-id="<%= gene.ensembl_id %>"><%= gene.name %></span>
        <% end %>
      </div>
    </div>
  </div>
</div>
<% else %>
<div class="text-gray-500 text-sm">Gene set item not found.</div>
<% end %>
