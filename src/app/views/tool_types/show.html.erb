<div class="max-w-4xl mx-auto space-y-6">
  <% if notice.present? %>
    <div class="rounded-md bg-green-100 px-4 py-3 text-sm text-green-700"><%= notice %></div>
  <% end %>

  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-gray-900"><%= @tool_type.name %></h1>
    <div class="flex items-center gap-2">
      <%= link_to 'Back to list', tool_types_path, class: 'inline-flex items-center px-3 py-2 rounded-md border border-gray-200 text-sm text-gray-700 hover:bg-gray-50' %>
      <% if admin? %>
        <%= link_to 'Edit', edit_tool_type_path(@tool_type), class: 'inline-flex items-center px-3 py-2 rounded-md border border-gray-200 text-sm text-gray-700 hover:bg-gray-50' %>
      <% end %>
    </div>
  </div>

  <div class="rounded-lg border border-gray-200 bg-white shadow-sm">
    <div class="px-4 py-3 border-b border-gray-100">
      <h2 class="text-sm font-semibold text-gray-800">Tools</h2>
    </div>
    <% if @tool_type.tools.any? %>
      <div class="divide-y divide-gray-100">
        <% @tool_type.tools.order(:name).each do |tool| %>
          <div class="px-4 py-3">
            <%= link_to tool_path(tool), class: "flex items-center justify-between hover:bg-gray-50 -mx-4 -my-3 px-4 py-3 rounded" do %>
              <div>
                <span class="font-medium text-gray-900"><%= tool.name %></span>
                <% if tool.label.present? %>
                  <span class="ml-2 text-sm text-gray-500">(<%= tool.label %>)</span>
                <% end %>
                <% if tool.package.present? %>
                  <span class="ml-2 text-sm text-gray-500">Package: <%= tool.package %></span>
                <% end %>
              </div>
              <i class="fas fa-chevron-right text-gray-400 text-xs"></i>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-4 py-3 text-sm text-gray-500 italic">No tools in this category.</div>
    <% end %>
  </div>
</div>

