function updateInlineRangeSlider(metadataId) {
  const controller = window.visualizationController
  if (!controller || !controller.inlineRangeSliderData || !controller.inlineRangeSliderData[metadataId]) {
    console.error('❌ Missing controller or inline range slider data for update')
    return
  }
  
  const sliderData = controller.inlineRangeSliderData[metadataId]
  const metadataCard = document.querySelector(`[data-metadata-item="${metadataId}"]`)
  if (!metadataCard) return
  
  const sliderTrack = metadataCard.querySelector('.range-slider-track')
  const activeTrack = metadataCard.querySelector('.range-slider-active')
  const minHandle = metadataCard.querySelector('.range-slider-min-handle')
  const maxHandle = metadataCard.querySelector('.range-slider-max-handle')
  const minInput = metadataCard.querySelector('.range-min-input')
  const maxInput = metadataCard.querySelector('.range-max-input')
  
  if (!sliderTrack || !activeTrack || !minHandle || !maxHandle) return
  
  const range = sliderData.max - sliderData.min
  const minPercent = (sliderData.currentMin - sliderData.min) / range
  const maxPercent = (sliderData.currentMax - sliderData.min) / range
  
  minHandle.style.left = `${minPercent * 100}%`
  maxHandle.style.left = `${maxPercent * 100}%`
  activeTrack.style.left = `${minPercent * 100}%`
  activeTrack.style.width = `${(maxPercent - minPercent) * 100}%`
  
  if (minInput) minInput.value = sliderData.currentMin.toFixed(3)
  if (maxInput) maxInput.value = sliderData.currentMax.toFixed(3)
}

function drawInlineDensityPlot(metadataId, values) {
  const controller = window.visualizationController
  if (!controller || !controller.inlineRangeSliderData || !controller.inlineRangeSliderData[metadataId]) {
    console.error('❌ Missing controller or inline range slider data for plot')
    return
  }
  
  const sliderData = controller.inlineRangeSliderData[metadataId]
  const metadataCard = document.querySelector(`[data-metadata-item="${metadataId}"]`)
  if (!metadataCard) return
  
  const canvas = metadataCard.querySelector('.density-plot-canvas')
  if (!canvas) return
  
  const ctx = canvas.getContext('2d')
  const rect = canvas.getBoundingClientRect()
  const dpr = window.devicePixelRatio || 1
  
  canvas.width = rect.width * dpr
  canvas.height = rect.height * dpr
  ctx.scale(dpr, dpr)
  canvas.style.width = rect.width + 'px'
  canvas.style.height = rect.height + 'px'
  
  ctx.clearRect(0, 0, canvas.width, canvas.height)
  
  // Create histogram
  const numBins = 50
  const binWidth = (sliderData.max - sliderData.min) / numBins
  const bins = new Array(numBins).fill(0)
  
  values.forEach(value => {
    const binIndex = Math.min(Math.floor((value - sliderData.min) / binWidth), numBins - 1)
    bins[binIndex]++
  })
  
  const maxCount = Math.max(...bins)
  const barWidth = rect.width / numBins
  
  // Draw bars
  ctx.fillStyle = '#e0e0e0'
  bins.forEach((count, i) => {
    const barHeight = (count / maxCount) * (rect.height - 20)
    const x = i * barWidth
    const y = rect.height - barHeight - 10
    ctx.fillRect(x, y, barWidth - 1, barHeight)
  })
  
  // Draw range selection overlay
  const range = sliderData.max - sliderData.min
  const minPercent = (sliderData.currentMin - sliderData.min) / range
  const maxPercent = (sliderData.currentMax - sliderData.min) / range
  
  ctx.fillStyle = 'rgba(0, 123, 255, 0.3)'
  const overlayX = minPercent * rect.width
  const overlayWidth = (maxPercent - minPercent) * rect.width
  ctx.fillRect(overlayX, 10, overlayWidth, rect.height - 20)
}

