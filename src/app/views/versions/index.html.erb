<div class="max-w-5xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-gray-900">ASAP Releases</h1>
    <% if admin? %>
      <%= link_to 'New Version', new_version_path, class: 'inline-flex items-center px-3 py-2 rounded-md bg-gray-900 text-white text-sm font-medium hover:bg-gray-800 transition' %>
    <% end %>
  </div>

  <% if notice.present? %>
    <div class="rounded-md bg-green-100 px-4 py-3 text-sm text-green-700"><%= notice %></div>
  <% end %>

  <% @versions.each do |version| %>
    <% env_data = @env_data_by_version_id[version.id] || {} %>
    <% action_buttons = [
         { text: 'Show', path: version_path(version) }
       ] %>
    <% action_buttons << { text: 'Edit', path: edit_version_path(version) } if admin? %>
    <%= render 'version', version: version, env_data: env_data, show_actions: true, action_buttons: action_buttons %>
  <% end %>

  <% if @versions.empty? %>
    <div class="rounded-lg border border-dashed border-gray-300 bg-white px-6 py-10 text-center text-gray-500">
      No versions have been recorded yet.
    </div>
  <% end %>
</div>

