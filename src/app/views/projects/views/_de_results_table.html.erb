<% completed_runs = @runs&.select { |r| r.status_id == 3 } || [] %>
<% if completed_runs.any? %>

<div class="overflow-x-auto">
  <table id="de_table" class="min-w-full divide-y divide-gray-200 text-sm">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">#</th>
        <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">Method</th>
        <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">Parameters</th>
        <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">Up-regulated</th>
        <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">Down-regulated</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% completed_runs.each do |run| %>
        <% run_id = run.id.to_s %>
        <% std_method = @h_std_methods && run.std_method_id ? @h_std_methods[run.std_method_id] : nil %>
        <% method_label = std_method ? (std_method.label.presence || std_method.name.presence || 'N/A') : 'N/A' %>
        <% h_attrs = run.attrs_json.present? ? Basic.safe_parse_json(run.attrs_json, {}) : {} %>
        <tr class="hover:bg-gray-50">
          <td class="px-3 py-2 text-gray-900 font-semibold">#<%= run.num || run.id %></td>
          <td class="px-3 py-2 text-gray-900"><%= method_label %></td>
          <td class="px-3 py-2 text-gray-600 text-xs">
            <% h_attrs.each do |k, v| %>
              <% next if v.is_a?(Hash) || v.is_a?(Array) %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 mr-1 mb-1">
                <span class="font-semibold"><%= k %>:</span> <span class="ml-1"><%= v.to_s.truncate(30) %></span>
              </span>
            <% end %>
          </td>
          <td class="px-3 py-2">
            <% if @h_stats && @h_stats[run_id] && @h_stats[run_id]['up'] %>
              <span class="cursor-pointer inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= @h_stats[run_id]['up'] > 0 ? 'bg-green-100 text-green-800 hover:bg-green-200' : 'bg-gray-100 text-gray-500' %>"
                    onclick="loadFormInRightPanel('<%= get_de_gene_list_run_path(run) %>?type=up')">
                <%= @h_stats[run_id]['up'] %> genes
              </span>
            <% end %>
          </td>
          <td class="px-3 py-2">
            <% if @h_stats && @h_stats[run_id] && @h_stats[run_id]['down'] %>
              <span class="cursor-pointer inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= @h_stats[run_id]['down'] > 0 ? 'bg-red-100 text-red-800 hover:bg-red-200' : 'bg-gray-100 text-gray-500' %>"
                    onclick="loadFormInRightPanel('<%= get_de_gene_list_run_path(run) %>?type=down')">
                <%= @h_stats[run_id]['down'] %> genes
              </span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% else %>
<div class="text-gray-500 text-center py-4">No completed DE runs found.</div>
<% end %>
