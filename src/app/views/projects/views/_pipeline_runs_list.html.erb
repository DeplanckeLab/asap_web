<% if @runs && @runs.any? %>
  <div class="space-y-3">
    <% @runs.each do |run| %>
      <% run_status = run_status_badge_for(run, @h_statuses) %>
      <% step = @h_steps[run.step_id] if defined?(@h_steps) %>
      <% std_method = (@h_std_methods && run.std_method_id) ? @h_std_methods[run.std_method_id] : nil %>
      <% h_method_attrs = (std_method && step) ? (Basic.get_std_method_attrs(std_method, step)[:h_attrs] rescue Basic.safe_parse_json(std_method.attrs_json, {})) : {} %>
      <% run_title = run_card_title(run, step, std_method) %>
      
      <%# Parse run attributes for parameters %>
      <% h_run_attrs = run.attrs_json.present? ? Basic.safe_parse_json(run.attrs_json, {}) : {} %>
      <% params_array = h_run_attrs.to_a %>
      
      <div class="border rounded-lg p-3 transition-colors cursor-pointer <%= run.id == @immediate_parent_run_id ? 'border-blue-500 bg-blue-50 hover:bg-blue-100' : 'border-gray-200 hover:bg-gray-50' %>"
           onclick="event.preventDefault(); window.location.href = '<%= run_view_url(run, @project, step) %>'; return false;"
           title="Click to view run details">
        <div class="flex items-center justify-between mb-2">
          <div class="flex-1">
            <div class="font-semibold text-gray-900 flex items-center gap-1 flex-wrap">
              <%= run_title %>
              <%= publication_visibility_badge(@project, run, full_read_access: !publication_snapshot_reader?(@project)) %>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="flex flex-col items-end gap-1">
              <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium <%= run_status[:bg] %> <%= run_status[:text] %>">
                <%= run_status[:ui_label] %>
              </span>
              <% if [1, 6].include?(run.status_id) && run.slurm_job_id.present? %>
                <div class="text-xs text-gray-500"
                     data-controller="queue-position"
                     data-queue-position-run-id-value="<%= run.id %>"
                     data-queue-position-slurm-job-id-value="<%= run.slurm_job_id %>"
                     data-queue-position-project-id-value="<%= @project.key %>"
                     <% if run.submitted_at %>
                       data-queue-position-submitted-at-value="<%= run.submitted_at.iso8601 %>"
                     <% end %>>
                  <span data-queue-position-target="queueLine">
                    <span data-slurm-queue-position-label class="text-gray-400">Slurm queue position:</span>
                    <span data-queue-position-target="position" class="font-mono text-xs ml-0.5 inline-block">
                      <i class="fas fa-spinner fa-spin"></i>
                    </span>
                  </span>
                </div>
              <% end %>
            </div>
            <% if run.created_at %>
              <span class="text-xs text-gray-500"><%= run.created_at.strftime("%Y-%m-%d %H:%M") %></span>
            <% end %>
          </div>
        </div>
        
        <%# Parameters section - same style as std_step %>
        <% if params_array.any? %>
          <div class="flex flex-wrap gap-1.5 items-center mt-2">
            <% params_array.each do |key, value| %>
              <%# Check if value is a dataset (annot object) or array of datasets %>
              <% annot_id = nil %>
              <% if value.is_a?(Hash) %>
                <% annot_id = value['annot_id'] || value[:annot_id] %>
              <% end %>
              <% if annot_id.present? %>
                <% annot = @h_annots_for_params[annot_id.to_i] if defined?(@h_annots_for_params) %>
                <% if annot %>
                  <% ori_run = @h_ori_runs_for_params[annot.ori_run_id] if annot.ori_run_id.present? && defined?(@h_ori_runs_for_params) %>
                  <% ori_step = (ori_run && ori_run.step_id && defined?(@h_steps_for_params) && @h_steps_for_params[ori_run.step_id]) ? @h_steps_for_params[ori_run.step_id] : nil %>
                  <% step_name = ori_step ? (ori_step.label.presence || ori_step.name.presence || 'N/A') : 'N/A' %>
                  <% if ori_step && ori_step.multiple_runs && ori_run %>
                    <% run_num = ori_run.num || ori_run.id %>
                    <% dataset_display = "#{step_name} ##{run_num} #{annot.name}" %>
                  <% else %>
                    <% dataset_display = "#{step_name} #{annot.name}" %>
                  <% end %>
                  <% truncated_dataset = dataset_display.length > 30 ? dataset_display[0..26] + "..." : dataset_display %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700 border border-blue-200 cursor-help" title="<%= param_tooltip(key, h_method_attrs) %>">
                    <span class="font-semibold text-blue-800"><%= key %>:</span>
                    <span class="text-blue-600"><%= truncated_dataset %></span>
                  </span>
                <% else %>
                  <%# annot_id present but annot not found - check if run_id is available %>
                  <% direct_run_id = value['run_id'] || value[:run_id] %>
                  <% if direct_run_id.present? %>
                    <% direct_run = @h_ori_runs_for_params[direct_run_id.to_i] if defined?(@h_ori_runs_for_params) %>
                    <% if direct_run %>
                      <% direct_step = @h_steps_for_params[direct_run.step_id] if direct_run.step_id.present? && defined?(@h_steps_for_params) %>
                      <% step_name = direct_step ? (direct_step.label.presence || direct_step.name.presence || 'N/A') : 'N/A' %>
                      <% dataset_name = value['output_dataset'] || value[:output_dataset] || '/matrix' %>
                      <% if direct_step && direct_step.multiple_runs %>
                        <% run_num = direct_run.num || direct_run.id %>
                        <% dataset_display = "#{step_name} ##{run_num} #{dataset_name}" %>
                      <% else %>
                        <% dataset_display = "#{step_name} #{dataset_name}" %>
                      <% end %>
                      <% truncated_dataset = dataset_display.length > 30 ? dataset_display[0..26] + "..." : dataset_display %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700 border border-blue-200 cursor-help" title="<%= param_tooltip(key, h_method_attrs) %>">
                        <span class="font-semibold text-blue-800"><%= key %>:</span>
                        <span class="text-blue-600"><%= truncated_dataset %></span>
                      </span>
                    <% else %>
                      <% value_str = value.to_json %>
                      <% truncated_value = value_str.length > 20 ? value_str[0..16] + "..." : value_str %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200 cursor-help" title="<%= param_tooltip(key, h_method_attrs) %>">
                        <span class="font-semibold text-gray-800"><%= key %>:</span>
                        <span class="text-gray-600"><%= truncated_value %></span>
                      </span>
                    <% end %>
                  <% else %>
                    <% value_str = value.to_json %>
                    <% truncated_value = value_str.length > 20 ? value_str[0..16] + "..." : value_str %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200 cursor-help" title="<%= param_tooltip(key, h_method_attrs) %>">
                      <span class="font-semibold text-gray-800"><%= key %>:</span>
                      <span class="text-gray-600"><%= truncated_value %></span>
                    </span>
                  <% end %>
                <% end %>
              <% elsif value.is_a?(Hash) && (value['run_id'].present? || value[:run_id].present?) %>
                <%# Hash with run_id but no annot_id %>
                <% direct_run_id = value['run_id'] || value[:run_id] %>
                <% direct_run = @h_ori_runs_for_params[direct_run_id.to_i] if defined?(@h_ori_runs_for_params) %>
                <% if direct_run %>
                  <% direct_step = @h_steps_for_params[direct_run.step_id] if direct_run.step_id.present? && defined?(@h_steps_for_params) %>
                  <% step_name = direct_step ? (direct_step.label.presence || direct_step.name.presence || 'N/A') : 'N/A' %>
                  <% dataset_name = value['output_dataset'] || value[:output_dataset] || '/matrix' %>
                  <% if direct_step && direct_step.multiple_runs %>
                    <% run_num = direct_run.num || direct_run.id %>
                    <% dataset_display = "#{step_name} ##{run_num} #{dataset_name}" %>
                  <% else %>
                    <% dataset_display = "#{step_name} #{dataset_name}" %>
                  <% end %>
                  <% truncated_dataset = dataset_display.length > 30 ? dataset_display[0..26] + "..." : dataset_display %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700 border border-blue-200 cursor-help" title="<%= param_tooltip(key, h_method_attrs) %>">
                    <span class="font-semibold text-blue-800"><%= key %>:</span>
                    <span class="text-blue-600"><%= truncated_dataset %></span>
                  </span>
                <% else %>
                  <% value_str = value.to_json %>
                  <% truncated_value = value_str.length > 20 ? value_str[0..16] + "..." : value_str %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200 cursor-help" title="<%= param_tooltip(key, h_method_attrs) %>">
                    <span class="font-semibold text-gray-800"><%= key %>:</span>
                    <span class="text-gray-600"><%= truncated_value %></span>
                  </span>
                <% end %>
              <% elsif value.is_a?(Array) && value.any? && value.first.is_a?(Hash) %>
                <%# Array of datasets - show first dataset and count %>
                <% first_annot_id = value.first['annot_id'] || value.first[:annot_id] %>
                <% if first_annot_id.present? %>
                  <% first_annot = @h_annots_for_params[first_annot_id.to_i] if defined?(@h_annots_for_params) %>
                  <% if first_annot %>
                    <% ori_run = @h_ori_runs_for_params[first_annot.ori_run_id] if first_annot.ori_run_id.present? && defined?(@h_ori_runs_for_params) %>
                    <% ori_step = (ori_run && ori_run.step_id && defined?(@h_steps_for_params) && @h_steps_for_params[ori_run.step_id]) ? @h_steps_for_params[ori_run.step_id] : nil %>
                    <% step_name = ori_step ? (ori_step.label.presence || ori_step.name.presence || 'N/A') : 'N/A' %>
                    <% if ori_step && ori_step.multiple_runs && ori_run %>
                      <% run_num = ori_run.num || ori_run.id %>
                      <% dataset_display = "#{step_name} ##{run_num} #{first_annot.name}" %>
                    <% else %>
                      <% dataset_display = "#{step_name} #{first_annot.name}" %>
                    <% end %>
                    <% array_display = value.size > 1 ? "#{dataset_display} (+#{value.size - 1} more)" : dataset_display %>
                    <% truncated_array = array_display.length > 30 ? array_display[0..26] + "..." : array_display %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700 border border-blue-200 cursor-help" title="<%= param_tooltip(key, h_method_attrs) %>">
                      <span class="font-semibold text-blue-800"><%= key %>:</span>
                      <span class="text-blue-600"><%= truncated_array %></span>
                    </span>
                  <% else %>
                    <% value_str = "[#{value.size} datasets]" %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200 cursor-help" title="<%= param_tooltip(key, h_method_attrs) %>">
                      <span class="font-semibold text-gray-800"><%= key %>:</span>
                      <span class="text-gray-600"><%= value_str %></span>
                    </span>
                  <% end %>
                <% else %>
                  <% value_str = value.to_s %>
                  <% truncated_value = value_str.length > 20 ? value_str[0..16] + "..." : value_str %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200 cursor-help" title="<%= param_tooltip(key, h_method_attrs) %>">
                    <span class="font-semibold text-gray-800"><%= key %>:</span>
                    <span class="text-gray-600"><%= truncated_value %></span>
                  </span>
                <% end %>
              <% else %>
                <% value_str = value.to_s %>
                <% truncated_value = value_str.length > 20 ? value_str[0..16] + "..." : value_str %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200 cursor-help" title="<%= param_tooltip(key, h_method_attrs) %>">
                  <span class="font-semibold text-gray-800"><%= key %>:</span>
                  <span class="text-gray-600"><%= truncated_value %></span>
                </span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center text-gray-500 py-8">
    <p>No runs found in this pipeline.</p>
  </div>
<% end %>

