// Global variables for inline range slider dragging
let isInlineDragging = false
let inlineDragHandle = null
let inlineDragMetadataId = null

// Global functions for inline range slider
function startInlineRangeSliderDrag(event, handleType, metadataId) {
  console.log('🎚️ Inline startRangeSliderDrag called for:', handleType, 'metadata:', metadataId)
  
  event.preventDefault()
  event.stopPropagation()
  
  const controller = window.visualizationController
  if (!controller) {
    console.error('❌ Controller not found')
    return
  }
  
  // Check if we have the data for this metadata
  if (!controller.inlineRangeSliderData || !controller.inlineRangeSliderData[metadataId]) {
    console.warn('⚠️ Missing inline range slider data for metadata:', metadataId)
    console.log('🎚️ Available data:', controller.inlineRangeSliderData)
    
    // Try to load the metadata if not already loaded
    controller.loadSingleMetadataVector(metadataId).then(vectorData => {
      if (vectorData && vectorData.values) {
        console.log('🎚️ Successfully loaded metadata, initializing inline range slider...')
        const values = vectorData.values
        const minVal = Math.min(...values)
        const maxVal = Math.max(...values)
        
        // Initialize the inline range slider data
        controller.inlineRangeSliderData[metadataId] = {
          min: minVal,
          max: maxVal,
          currentMin: minVal,
          currentMax: maxVal,
          values: values
        }
        
        // Copy to global controller if different instance
        if (controller !== window.visualizationController) {
          window.visualizationController.inlineRangeSliderData[metadataId] = controller.inlineRangeSliderData[metadataId]
        }
        
        // Now start the drag
        startInlineRangeSliderDrag(event, handleType, metadataId)
      } else {
        console.error('❌ Failed to load metadata for inline range slider')
      }
    }).catch(error => {
      console.error('❌ Error loading metadata for inline range slider:', error)
    })
    return
  }
  
  isInlineDragging = true
  inlineDragHandle = handleType
  inlineDragMetadataId = metadataId
  
  console.log('🎚️ Inline drag started for', handleType, 'on metadata', metadataId)
  
  // Add event listeners for mouse/touch events
  document.addEventListener('mousemove', handleInlineRangeSliderDrag)
  document.addEventListener('mouseup', stopInlineRangeSliderDrag)
  document.addEventListener('touchmove', handleInlineRangeSliderDrag)
  document.addEventListener('touchend', stopInlineRangeSliderDrag)
}

function handleInlineRangeSliderDrag(event) {
  if (!isInlineDragging) return
  
  event.preventDefault()
  
  const controller = window.visualizationController
  if (!controller || !controller.inlineRangeSliderData || !controller.inlineRangeSliderData[inlineDragMetadataId]) {
    console.error('❌ Missing controller or inline range slider data')
    return
  }
  
  const sliderData = controller.inlineRangeSliderData[inlineDragMetadataId]
  const currentX = event.type === 'mousemove' ? event.clientX : event.touches[0].clientX
  
  // Find the metadata card and slider track
  const metadataCard = document.querySelector(`[data-metadata-item="${inlineDragMetadataId}"]`)
  if (!metadataCard) {
    console.error('❌ Could not find metadata card for:', inlineDragMetadataId)
    return
  }
  
  const sliderTrack = metadataCard.querySelector('.range-slider-track')
  if (!sliderTrack) {
    console.error('❌ Could not find slider track in metadata card')
    return
  }
  
  const trackRect = sliderTrack.getBoundingClientRect()
  const relativeX = currentX - trackRect.left
  const trackWidth = trackRect.width
  
  const range = sliderData.max - sliderData.min
  const percent = Math.max(0, Math.min(1, relativeX / trackWidth))
  let newValue = sliderData.min + (percent * range)
  newValue = Math.max(sliderData.min, Math.min(sliderData.max, newValue))
  
  if (inlineDragHandle === 'min') {
    newValue = Math.min(newValue, sliderData.currentMax)
    sliderData.currentMin = newValue
  } else {
    newValue = Math.max(newValue, sliderData.currentMin)
    sliderData.currentMax = newValue
  }
  
  // Update the UI
