<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
  <div class="mb-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Settings</h2>
    <p class="text-gray-600">Project configuration and management options</p>
  </div>

  <!-- Settings Sections -->
  <div class="space-y-6">
    <!-- General Settings -->
    <div class="bg-gray-50 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">General Settings</h3>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Project Name -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Project Name</label>
          <input type="text" value="<%= @project.display_name %>" 
                 class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        
        <!-- Project Key -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Project Key</label>
          <input type="text" value="<%= @project.key || '' %>" 
                 class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        
        <!-- Description -->
        <div class="lg:col-span-2">
          <label class="block text-sm font-medium text-gray-700 mb-2">Description</label>
          <textarea rows="3" 
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"><%= @project.description || '' %></textarea>
        </div>
      </div>
    </div>

    <!-- Data Settings -->
    <div class="bg-gray-50 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Data Settings</h3>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Technology -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Technology</label>
          <select class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="10x" <%= 'selected' if @project.technology == '10x' %>>10x Genomics</option>
            <option value="smart-seq" <%= 'selected' if @project.technology == 'smart-seq' %>>Smart-seq2</option>
            <option value="drop-seq" <%= 'selected' if @project.technology == 'drop-seq' %>>Drop-seq</option>
            <option value="other" <%= 'selected' if @project.technology == 'other' %>>Other</option>
          </select>
        </div>
        
        <!-- Tissue -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Tissue</label>
          <input type="text" value="<%= @project.tissue || '' %>" 
                 class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        
        <!-- Organism -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Organism</label>
          <select class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="">Select organism...</option>
            <option value="human" <%= 'selected' if @project.organism&.name == 'Human' %>>Human</option>
            <option value="mouse" <%= 'selected' if @project.organism&.name == 'Mouse' %>>Mouse</option>
            <option value="drosophila" <%= 'selected' if @project.organism&.name == 'Drosophila' %>>Drosophila</option>
            <option value="zebrafish" <%= 'selected' if @project.organism&.name == 'Zebrafish' %>>Zebrafish</option>
          </select>
        </div>
        
        <!-- Status -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
          <select class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="">Select status...</option>
            <option value="active" <%= 'selected' if @project.status&.name == 'Active' %>>Active</option>
            <option value="archived" <%= 'selected' if @project.status&.name == 'Archived' %>>Archived</option>
            <option value="processing" <%= 'selected' if @project.status&.name == 'Processing' %>>Processing</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Privacy Settings -->
    <div class="bg-gray-50 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Privacy Settings</h3>
      
      <div class="space-y-4">
        <!-- Public Access -->
        <div class="flex items-center justify-between">
          <div>
            <h4 class="text-sm font-medium text-gray-900">Public Access</h4>
            <p class="text-sm text-gray-600">Allow other users to view and clone this project</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" <%= 'checked' if @project.is_public? %> class="sr-only peer">
            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
          </label>
        </div>
        
        <!-- Download Access -->
        <div class="flex items-center justify-between">
          <div>
            <h4 class="text-sm font-medium text-gray-900">Download Access</h4>
            <p class="text-sm text-gray-600">Allow public users to download project data</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" class="sr-only peer">
            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
          </label>
        </div>
      </div>
    </div>

    <!-- Advanced Settings -->
    <div class="bg-gray-50 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Advanced Settings</h3>
      
      <div class="space-y-4">
        <!-- Auto-processing -->
        <div class="flex items-center justify-between">
          <div>
            <h4 class="text-sm font-medium text-gray-900">Auto-processing</h4>
            <p class="text-sm text-gray-600">Automatically process new data files</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" checked class="sr-only peer">
            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
          </label>
        </div>
        
        <!-- Backup -->
        <div class="flex items-center justify-between">
          <div>
            <h4 class="text-sm font-medium text-gray-900">Automatic Backup</h4>
            <p class="text-sm text-gray-600">Create daily backups of project data</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" checked class="sr-only peer">
            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
          </label>
        </div>
      </div>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="mt-8 flex justify-between">
    <div class="flex space-x-3">
      <button class="px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700">
        <i class="fas fa-trash mr-2"></i>Delete Project
      </button>
      <button class="px-4 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400">
        <i class="fas fa-download mr-2"></i>Export Settings
      </button>
    </div>
    
    <div class="flex space-x-3">
      <button class="px-4 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400">
        Cancel
      </button>
      <button class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">
        <i class="fas fa-save mr-2"></i>Save Changes
      </button>
    </div>
  </div>
</div>
