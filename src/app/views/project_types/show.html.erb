<% content_for :title, "Project Type - ASAP" %>
<% show_counts = admin? %>
<% show_actions = can_edit_synced_reference_data? %>
<div class="max-w-3xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <% if notice.present? %>
    <div class="rounded-md bg-green-100 px-4 py-3 text-sm text-green-700 dark:bg-green-950/30 dark:text-green-100 mb-4"><%= notice %></div>
  <% end %>

  <div class="mb-6">
    <h1 class="text-3xl font-semibold text-gray-900 dark:text-white">
      Project Type
    </h1>
  </div>

  <% if admin? && !synced_reference_data_writable? %>
    <div class="mb-6 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-400/50 dark:bg-amber-950/30 dark:text-amber-100">
      Project types are synced from development and are read-only on production.
    </div>
  <% end %>

  <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-900">
    <dl class="grid gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Name</dt>
        <dd class="mt-1 text-sm text-gray-900 dark:text-white"><%= @project_type.name %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Tag</dt>
        <dd class="mt-1 text-sm font-mono text-gray-900 dark:text-white"><%= @project_type.tag.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Row Label</dt>
        <dd class="mt-1 text-sm text-gray-900 dark:text-white"><%= @project_type.row_label.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Col Label</dt>
        <dd class="mt-1 text-sm text-gray-900 dark:text-white"><%= @project_type.col_label.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Admin report only</dt>
        <dd class="mt-1 text-sm text-gray-900 dark:text-white"><%= @project_type.admin_report_only? ? "yes" : "no" %></dd>
      </div>
      <% if show_counts %>
        <div>
          <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Public projects</dt>
          <dd class="mt-1 text-sm text-gray-900 dark:text-white" data-role="public-projects-count"><%= @project_counts[:public] %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Private projects</dt>
          <dd class="mt-1 text-sm text-gray-900 dark:text-white" data-role="private-projects-count"><%= @project_counts[:private] %></dd>
        </div>
      <% end %>
    </dl>

    <div class="mt-6 flex items-center gap-3">
      <% if show_actions %>
        <%= link_to "Edit details",
                    edit_project_type_path(@project_type),
                    class: "inline-flex items-center rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-gray-800 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-gray-800 dark:bg-gray-100 dark:text-black dark:hover:bg-gray-200" %>
        <% if @project_counts[:public].zero? && @project_counts[:private].zero? %>
          <%= button_to "Delete",
                        project_type_path(@project_type),
                        method: :delete,
                        form: { data: { turbo_confirm: "Delete #{@project_type.name}?" }, class: "inline" },
                        class: "inline-flex items-center rounded-lg border border-red-300 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-50 dark:border-red-500/50 dark:text-red-300 dark:hover:bg-red-950/30" %>
        <% end %>
      <% end %>
      <%= link_to "Back",
                  project_types_path,
                  class: "text-sm text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-gray-100" %>
    </div>
  </div>
</div>
