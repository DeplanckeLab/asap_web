<%= form_with model: ontology_term_type, class: "space-y-6" do |form| %>
  <% if ontology_term_type.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-400/50 dark:bg-red-950/30 dark:text-red-100">
      <p class="font-semibold"><%= pluralize(ontology_term_type.errors.count, "error") %> prevented saving:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% ontology_term_type.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-4 md:grid-cols-2">
    <div>
      <%= form.label :name, class: "block text-sm font-medium text-gray-700 dark:text-gray-200" %>
      <%= form.text_field :name, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100" %>
    </div>

    <div>
      <%= form.label :label, class: "block text-sm font-medium text-gray-700 dark:text-gray-200" %>
      <%= form.text_field :label, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100" %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div>
      <%= form.label :cell_ontology_ids, "Applicable ontology IDs (comma separated)", class: "block text-sm font-medium text-gray-700 dark:text-gray-200" %>
      <%= form.text_field :cell_ontology_ids, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100" %>
    </div>
    <div>
      <%= form.label :rank, class: "block text-sm font-medium text-gray-700 dark:text-gray-200" %>
      <%= form.number_field :rank, in: 1..999, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100" %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div>
      <%= form.label :in_lineage_term_ids, "Lineage term IDs (comma separated)", class: "block text-sm font-medium text-gray-700 dark:text-gray-200" %>
      <%= form.text_area :in_lineage_term_ids, rows: 3, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100" %>
    </div>
    <div>
      <%= form.label :term_ids, "Direct term IDs (comma separated)", class: "block text-sm font-medium text-gray-700 dark:text-gray-200" %>
      <%= form.text_area :term_ids, rows: 3, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100" %>
    </div>
  </div>

  <div>
    <%= form.label :free_text_json, "Free-text terms JSON", class: "block text-sm font-medium text-gray-700 dark:text-gray-200" %>
    <%= form.text_area :free_text_json, rows: 4, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 font-mono" %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit class: "inline-flex items-center rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-gray-800 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-gray-800 dark:bg-gray-100 dark:text-black dark:hover:bg-gray-200" %>
    <%= link_to "Cancel", ontology_term_types_path, class: "text-sm text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-gray-100" %>
  </div>
<% end %>


