<% scheme = news_item.color_scheme %>
<div id="news-item-<%= news_item.id %>"
     class="<%= news_item_card_classes(news_item) %> scroll-mt-40 transition duration-500 ring-2 ring-offset-2 ring-transparent"
     data-news-highlight-target="card"
     data-news-filter-target="card"
     data-news-type="<%= news_item.news_type %>"
     data-highlight-ring="<%= news_item_highlight_ring_class(news_item) %>">
  <div class="flex items-start gap-3">
    <div class="shrink-0 mt-0.5">
      <%= news_item_icon_tag(news_item, size_class: 'text-xl') %>
    </div>
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2 mb-1">
        <%= news_item_type_badge(news_item) %>
        <span class="text-xs text-gray-500 dark:text-gray-400"><%= format_news_published_at(news_item) %></span>
        <% unless news_item.published? %>
          <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-600 dark:bg-gray-700 dark:text-gray-300">
            Draft
          </span>
        <% end %>
        <% if news_item.show_on_welcome? && admin? %>
          <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-600 dark:bg-gray-700 dark:text-gray-300">
            Welcome
          </span>
        <% end %>
      </div>
      <h2 class="text-sm font-semibold <%= scheme[:title] %>">
        <%= link_to raw(news_item.title), news_item_path(news_item), class: "hover:underline" %>
      </h2>
      <p class="mt-1 text-sm whitespace-pre-line <%= scheme[:body] %>"><%= raw news_item.body %></p>
      <% if news_item.github_synced? %>
        <p class="mt-2 text-xs">
          <%= link_to "GitHub discussion ##{news_item.github_discussion_number}",
                      news_item.github_discussion_url,
                      target: "_blank",
                      rel: "noopener noreferrer",
                      class: "text-blue-700 hover:underline dark:text-blue-400" %>
          <% if news_item.github_synced_at.present? %>
            <span class="text-gray-500 dark:text-gray-400">
              (synced <%= news_item.github_synced_at.strftime('%Y-%m-%d %H:%M') %>)
            </span>
          <% end %>
        </p>
      <% end %>
      <% if local_assigns.fetch(:show_actions, false) && admin? %>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <%= link_to 'Edit', edit_news_item_path(news_item), class: 'inline-flex items-center rounded-md border border-gray-200 px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-800' %>
          <% if news_item.github_syncable? %>
            <%= button_to (news_item.github_synced? ? 'Update on GitHub' : 'Post to GitHub'),
                          sync_to_github_news_item_path(news_item),
                          method: :post,
                          class: 'inline-flex items-center rounded-md border border-gray-200 px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-800' %>
          <% end %>
          <%= button_to 'Delete', news_item_path(news_item), method: :delete, form: { data: { turbo_confirm: 'Delete this news item?' } }, class: 'inline-flex items-center rounded-md border border-red-200 px-3 py-1.5 text-sm text-red-700 hover:bg-red-50 dark:border-red-500/40 dark:text-red-300 dark:hover:bg-red-500/10' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
