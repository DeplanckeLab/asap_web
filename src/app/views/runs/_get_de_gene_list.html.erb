<% if @step && @run %>
<% numeric_fields = ['Gene index', 'logFC', 'P-value', 'FDR', 'Avg group1', 'Avg group2'] %>
<% is_up_regulated = params[:type].to_s == 'up' %>
<% gene_badge_cls = is_up_regulated ? 'bg-green-100 text-green-800 hover:bg-green-200' : 'bg-red-100 text-red-800 hover:bg-red-200' %>

<div class="bg-white rounded-lg shadow-sm flex flex-col"
     style="max-height: calc(100vh - 200px);"
     data-analysis-direct-link-path="<%= project_path(@project, { view: 'analysis', step_id: @step.id, sub_view: 'de_filter', gene_list_run_id: @run.id, gene_list_type: params[:type].to_s, gene_list_de_annot_id: @de_gene_list_annot_id }.compact) %>">
  <div class="border-b border-gray-200 px-6 py-4 sticky top-0 z-10 flex-shrink-0" style="background: linear-gradient(to right, #eff6ff, #eef2ff); background-color: #ffffff;">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900">
        #<%= @run.num || @run.id %> - <%= @nber_genes %> <%= params[:type] %>-regulated genes
      </h3>
      <div class="flex items-center gap-2">
        <% if exportable?(@project) %>
          <button type="button"
                  class="px-3 py-1.5 bg-white hover:bg-gray-100 text-gray-700 rounded-md font-medium text-sm transition-colors cursor-pointer border border-gray-300"
                  onclick="downloadDeGeneList('json')">
            <i class="fas fa-download sm:mr-1"></i><span class="hidden sm:inline"> JSON</span>
          </button>
          <button type="button"
                  class="px-3 py-1.5 bg-white hover:bg-gray-100 text-gray-700 rounded-md font-medium text-sm transition-colors cursor-pointer border border-gray-300"
                  onclick="downloadDeGeneList('tsv')">
            <i class="fas fa-file-alt sm:mr-1"></i><span class="hidden sm:inline"> TSV</span>
          </button>
        <% end %>
        <button type="button"
                class="px-3 py-1.5 bg-gray-600 hover:bg-gray-700 text-white rounded-md font-medium text-sm transition-colors cursor-pointer"
                onclick="loadFormInRightPanel('<%= step_results_project_path(@project, step_id: @step.id, format: :html) %>')">
          <i class="fas fa-arrow-left sm:mr-1"></i><span class="hidden sm:inline"> Back to DE results</span>
        </button>
      </div>
    </div>
  </div>

  <% if @limit < @nber_genes %>
    <div class="px-6 py-2 bg-yellow-50 border-b border-yellow-200 text-yellow-800 text-sm">
      Only <%= @limit %> genes with highest fold change displayed
    </div>
  <% end %>

  <div class="px-6 py-2 border-b border-gray-200 bg-white flex items-center gap-2">
    <input type="text" id="de-genelist-search" placeholder="Filter by any value"
           class="form-input rounded border border-gray-300 bg-white text-sm w-64 px-2 py-1 shadow-inner focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
           oninput="(function(input){var q=input.value.toLowerCase();var c=document.getElementById('de-genelist-container');if(!c)return;var rows=c.querySelectorAll('tbody tr');var count=0;rows.forEach(function(r){var txt=r.textContent.toLowerCase();var show=!q||txt.indexOf(q)!==-1;r.style.display=show?'':'none';if(show)count++;});var info=document.getElementById('de-genelist-count');if(info)info.textContent=count+' / '+rows.length+' genes';})(this)">
    <span id="de-genelist-count" class="text-xs text-gray-500"></span>
  </div>

  <div id="de-genelist-container" class="flex-1 overflow-y-auto">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50 sticky top-0">
        <tr>
          <% @fields.each_with_index do |f, idx| %>
            <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase whitespace-nowrap cursor-pointer hover:text-gray-700 select-none"
                data-col="<%= idx %>"
                data-numeric="<%= numeric_fields.include?(f) %>"
                onclick="(function(th){var c=document.getElementById('de-genelist-container');if(!c)return;var tbody=c.querySelector('tbody');if(!tbody)return;var col=parseInt(th.dataset.col);var num=th.dataset.numeric==='true';var rows=Array.from(tbody.querySelectorAll('tr'));var cur=th.dataset.sortDir||'none';var asc=(cur!=='asc');th.dataset.sortDir=asc?'asc':'desc';c.querySelectorAll('th[data-col]').forEach(function(h){if(h!==th){h.dataset.sortDir='none';var si=h.querySelector('.sort-indicator');if(si)si.textContent='';}});var si=th.querySelector('.sort-indicator');if(si)si.textContent=asc?' \u25B2':' \u25BC';rows.sort(function(a,b){var av=a.cells[col]?a.cells[col].textContent.trim():'';var bv=b.cells[col]?b.cells[col].textContent.trim():'';if(num){var an=parseFloat(av)||0;var bn=parseFloat(bv)||0;return asc?an-bn:bn-an;}return asc?av.localeCompare(bv):bv.localeCompare(av);});rows.forEach(function(r){tbody.appendChild(r);});})(this)">
              <%= f %> <span class="sort-indicator"></span>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @data.each do |e| %>
          <tr class="hover:bg-gray-50">
            <% @fields.each_index do |i| %>
              <td class="px-3 py-1.5 text-gray-700 whitespace-nowrap">
                <% if @fields[i] == 'EnsemblID' && e[i].present? %>
                  <span class="text-blue-600 cursor-pointer hover:underline gene-link" data-ensembl-id="<%= e[i] %>"><%= e[i] %></span>
                <% elsif @fields[i] == 'Gene name' %>
                  <% gene_name = e[i].presence || e[1] %>
                  <% ensembl_id = e[1].to_s %>
                  <span class="gene-badge cursor-pointer inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= gene_badge_cls %>"
                        data-ensembl-id="<%= ensembl_id %>"
                        <% if gene_name.present? && gene_name != ensembl_id %>data-gene-symbol="<%= gene_name %>"<% end %>
                        title="<%= ensembl_id.presence || gene_name %>"><%= gene_name %></span>
                <% else %>
                  <%= e[i] %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%= render 'projects/views/annotation_popup' %>

<script>
(function() {
  var container = document.getElementById('de-genelist-container');
  var searchGeneUrl = '<%= search_gene_project_path(@project) %>';
  if (!container) return;
  container.addEventListener('click', function(e) {
    var badge = e.target.closest('.gene-badge');
    var link = e.target.closest('.gene-link');
    var el = badge || link;
    if (!el) return;
    if (window.openAnnotationPopupGeneModal) {
      var ens = el.getAttribute('data-ensembl-id') || '';
      var sym = el.getAttribute('data-gene-symbol') || '';
      if (ens || sym) {
        window.openAnnotationPopupGeneModal(ens, searchGeneUrl, sym, '');
      }
    }
  });
})();

(function() {
  var c = document.getElementById('de-genelist-container');
  if (!c) return;
  var ths = c.querySelectorAll('th[data-col]');
  ths.forEach(function(th) {
    if (th.textContent.trim().toLowerCase().indexOf('logfc') === 0) {
      th.dataset.sortDir = 'asc';
      th.click();
    }
  });
})();

window.downloadDeGeneList = function(fmt) {
  var c = document.getElementById('de-genelist-container');
  if (!c) return;
  var headers = [];
  c.querySelectorAll('thead th').forEach(function(th) {
    headers.push(th.textContent.replace(/\s*[\u25B2\u25BC]\s*$/, '').trim());
  });
  var rows = [];
  c.querySelectorAll('tbody tr').forEach(function(tr) {
    if (tr.style.display === 'none') return;
    var row = [];
    tr.querySelectorAll('td').forEach(function(td) { row.push(td.textContent.trim()); });
    rows.push(row);
  });
  var content, filename, mime;
  if (fmt === 'json') {
    content = JSON.stringify(rows);
    filename = '<%= @project.key %>_run<%= @run.num %>_de_<%= params[:type] %>.json';
    mime = 'application/json';
  } else {
    content = headers.join('\t') + '\n' + rows.map(function(r) { return r.join('\t'); }).join('\n');
    filename = '<%= @project.key %>_run<%= @run.num %>_de_<%= params[:type] %>.txt';
    mime = 'text/tab-separated-values';
  }
  var blob = new Blob([content], { type: mime });
  var a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = filename;
  a.click();
  URL.revokeObjectURL(a.href);
};
</script>

<% else %>
<div class="text-red-600 p-4">Could not load gene list data.</div>
<% end %>
