<%# Storage quota display
   locals:
   - user_storage_quota: UserStorageQuota::Result (optional; computed from current_user if omitted)
   - variant: :page (default), :menu, or :toolbar
   - dark_mode: boolean for menu styling (default false)
%>
<%
  user_storage_quota = local_assigns[:user_storage_quota]
  if user_storage_quota.nil? && user_signed_in? && !current_user.guest_account?
    user_storage_quota = UserStorageQuota.status_for(current_user)
  end
  variant = local_assigns.fetch(:variant, :page).to_sym
  dark_mode = local_assigns.fetch(:dark_mode, false)
%>
<% if user_storage_quota.present? %>
  <%
    used_label = display_mem(user_storage_quota.used_bytes)
    quota_label = display_mem(user_storage_quota.quota_bytes)
    remaining_label = display_mem(user_storage_quota.remaining_bytes)
    percent = user_storage_quota.used_percent
    bar_class =
      if percent >= 95
        'bg-red-600'
      elsif percent >= 60
        'bg-amber-500'
      else
        'bg-emerald-500'
      end
  %>
  <% if variant == :menu %>
    <div class="px-4 py-3 border-b border-gray-200 <%= 'dark:border-gray-700' if dark_mode %>"
         data-testid="user-storage-quota-menu">
      <div class="flex items-baseline justify-between gap-2 text-xs">
        <span class="font-medium text-gray-700 <%= 'dark:text-gray-200' if dark_mode %>">Storage</span>
        <span class="tabular-nums text-gray-600 <%= 'dark:text-gray-300' if dark_mode %>">
          <%= used_label %> / <%= quota_label %>
        </span>
      </div>
      <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-gray-200 <%= 'dark:bg-gray-700' if dark_mode %>"
           role="progressbar"
           aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= percent %>"
           aria-label="Storage used <%= used_label %> of <%= quota_label %>">
        <div class="<%= bar_class %> h-1.5 rounded-full" style="width: <%= percent %>%"></div>
      </div>
      <p class="mt-1 text-xs text-gray-500 <%= 'dark:text-gray-400' if dark_mode %>">
        <%= remaining_label %> remaining (<%= percent %>%)
      </p>
    </div>
  <% elsif variant == :toolbar %>
    <div class="inline-flex items-center gap-2 min-w-[10rem] max-w-[14rem]"
         data-testid="user-storage-quota"
         title="<%= remaining_label %> remaining across your projects (disk or S3 archive)">
      <span class="text-xs text-gray-600 whitespace-nowrap tabular-nums">
        <%= used_label %> / <%= quota_label %>
      </span>
      <div class="h-1.5 w-16 sm:w-20 shrink-0 overflow-hidden rounded-full bg-gray-200" role="progressbar"
           aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= percent %>"
           aria-label="Storage used <%= used_label %> of <%= quota_label %>">
        <div class="<%= bar_class %> h-1.5 rounded-full" style="width: <%= percent %>%"></div>
      </div>
    </div>
  <% else %>
    <div class="mt-3 max-w-md" data-testid="user-storage-quota">
      <div class="flex items-baseline justify-between gap-3 text-sm">
        <span class="font-medium text-gray-800">Storage quota</span>
        <span class="text-gray-600 tabular-nums">
          <%= used_label %> / <%= quota_label %>
          <span class="text-gray-400">(<%= percent %>%)</span>
        </span>
      </div>
      <div class="mt-1.5 h-2 w-full overflow-hidden rounded-full bg-gray-200" role="progressbar"
           aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= percent %>"
           aria-label="Storage used <%= used_label %> of <%= quota_label %>">
        <div class="<%= bar_class %> h-2 rounded-full transition-all duration-300" style="width: <%= percent %>%"></div>
      </div>
      <p class="mt-1 text-xs text-gray-500">
        <%= remaining_label %> remaining across your projects (disk or S3 archive).
      </p>
    </div>
  <% end %>
<% end %>
