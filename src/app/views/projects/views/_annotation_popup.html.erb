  window.populateAnnotViolinMatrixSelect = function() {
    var sel = document.getElementById('annot-violin-matrix-select')
    if (!sel) return
    var apd = window._annotPopupData
    var gm = window.geneManager
    sel.innerHTML = ''
    function addOpt(value, label, annotId) {
      var o = document.createElement('option')
      o.value = value || '/matrix'
      o.textContent = label || value || '/matrix'
      if (annotId) o.setAttribute('data-annot-id', String(annotId))
      sel.appendChild(o)
    }
    var src = document.getElementById('gene-expression-matrix-select')
    if (src && src.options && src.options.length) {
      for (var i = 0; i < src.options.length; i++) {
        var opt = src.options[i]
        var aid = opt.getAttribute('data-annot-id') || ''
        addOpt(opt.value, opt.textContent || opt.value, aid)
      }
    } else {
      var menu = document.getElementById('matrix-selection-menu')
      if (menu) {
        menu.querySelectorAll('div[data-value]').forEach(function(el) {
          addOpt(el.getAttribute('data-value'), el.getAttribute('data-label') || el.getAttribute('data-value'), el.getAttribute('data-annot-id'))
        })
      }
      if (sel.options.length === 0) {
        addOpt('/matrix', '/matrix', '')
      }
    }
    if (gm && typeof gm.syncMatrixSelectionFromUI === 'function') gm.syncMatrixSelectionFromUI()
    var wantLayer = (apd && apd.violinMatrixLayer != null && apd.violinMatrixLayer !== '') ? apd.violinMatrixLayer : (gm ? gm.currentMatrixLayer : '/matrix')
    var wantAnnot = ''
    if (apd && apd.violinMatrixAnnotId != null && String(apd.violinMatrixAnnotId) !== '') {
      wantAnnot = String(apd.violinMatrixAnnotId)
    } else if (gm && gm.currentMatrixAnnotId) {
      wantAnnot = String(gm.currentMatrixAnnotId)
    }
    var matched = false
    for (var j = 0; j < sel.options.length; j++) {
      var o = sel.options[j]
      var oa = o.getAttribute('data-annot-id') ? String(o.getAttribute('data-annot-id')) : ''
      if (String(o.value) === String(wantLayer) && oa === wantAnnot) {
        sel.selectedIndex = j
        matched = true
        break
      }
    }
    if (!matched && sel.options.length) sel.selectedIndex = 0
    var cur = sel.options[sel.selectedIndex]
    if (cur && apd) {
      apd.violinMatrixLayer = cur.value
      apd.violinMatrixAnnotId = cur.getAttribute('data-annot-id') && cur.getAttribute('data-annot-id') !== '' ? cur.getAttribute('data-annot-id') : null
    }
    if (typeof window.populateAnnotViolinSortSelect === 'function') {
      window.populateAnnotViolinSortSelect()
    }
  }

