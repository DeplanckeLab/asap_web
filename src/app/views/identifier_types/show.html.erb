<% plural_label = @identifier_type.pluralizable? ? @identifier_type.name.pluralize : "#{@identifier_type.name} items" %>
<% content_for :title, "#{plural_label} - Cross References" %>

<div class="max-w-5xl mx-auto py-10 px-4 sm:px-6 lg:px-8 space-y-8">
  <div>
    <%= link_to "← Back to Cross-references", cross_references_home_index_path,
                class: "text-sm font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-300 dark:hover:text-indigo-200" %>
    <h1 class="mt-3 text-3xl font-semibold text-gray-900 dark:text-white">
      <%= plural_label %>
    </h1>
    <p class="mt-2 text-gray-600 dark:text-gray-300">
      Identifiers associated with the <%= @identifier_type.display_name %> catalog.
    </p>
  </div>

  <% if @exp_entries.present? %>
    <div class="rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
      <div class="border-b border-gray-100 px-6 py-4 dark:border-gray-800">
        <h2 class="text-lg font-medium text-gray-900 dark:text-white">
          Linked experimental entries
        </h2>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          Entries explicitly attached to this identifier type.
        </p>
      </div>
      <ul class="divide-y divide-gray-100 dark:divide-gray-800">
        <% @exp_entries.each do |entry| %>
          <li class="px-6 py-5">
            <div class="grid gap-4 md:grid-cols-[minmax(0,1fr)_230px] md:items-center">
              <div class="min-w-0">
                <p class="font-semibold text-gray-900 dark:text-white">
                  <%= entry.display_title %>
                </p>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  <span class="font-mono text-indigo-600 dark:text-indigo-300"><%= entry.display_identifier %></span>
                </p>
                <% if entry.doi.present? %>
                  <p class="text-sm text-gray-500 dark:text-gray-400">DOI: <%= entry.doi %></p>
                <% end %>
              </div>
              <div class="flex flex-wrap gap-3 text-sm md:justify-end">
                <%= link_to "Search projects",
                            projects_path(q: entry.identifier),
                            class: "inline-flex items-center rounded-md border border-indigo-200 px-3 py-1.5 font-medium text-indigo-700 hover:bg-indigo-50 dark:border-indigo-500/40 dark:text-indigo-200 dark:hover:bg-indigo-900/40" %>
                <%= link_to "Entry details",
                            exp_entry_path(entry),
                            class: "inline-flex items-center rounded-md border border-gray-200 px-3 py-1.5 font-medium text-gray-600 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-800" %>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  <% elsif @exp_entry_identifiers.present? %>
    <div class="rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
      <div class="border-b border-gray-100 px-6 py-4 dark:border-gray-800">
        <h2 class="text-lg font-medium text-gray-900 dark:text-white">
          Linked identifiers
        </h2>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          Identifiers referencing experiments associated with this catalog.
        </p>
      </div>
      <ul class="divide-y divide-gray-100 dark:divide-gray-800">
        <% @exp_entry_identifiers.each do |entry_identifier| %>
          <% entry = @exp_entries_map[entry_identifier.exp_entry_id] %>
          <li class="px-6 py-5">
            <div class="grid gap-4 md:grid-cols-[minmax(0,1fr)_230px] md:items-center">
              <div class="min-w-0">
                <p class="font-semibold text-gray-900 dark:text-white">
                  <%= entry&.display_title || "Experimental entry ##{entry_identifier.exp_entry_id}" %>
                </p>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  <span class="font-mono text-indigo-600 dark:text-indigo-300"><%= entry_identifier.identifier %></span>
                </p>
              </div>
              <div class="flex flex-wrap gap-3 text-sm md:justify-end">
                <%= link_to "Search projects",
                            projects_path(q: entry_identifier.identifier),
                            class: "inline-flex items-center rounded-md border border-indigo-200 px-3 py-1.5 font-medium text-indigo-700 hover:bg-indigo-50 dark:border-indigo-500/40 dark:text-indigo-200 dark:hover:bg-indigo-900/40" %>
                <% if entry.present? %>
                  <%= link_to "Entry details",
                              exp_entry_path(entry),
                              class: "inline-flex items-center rounded-md border border-gray-200 px-3 py-1.5 font-medium text-gray-600 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-800" %>
                <% end %>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center dark:border-gray-700 dark:bg-gray-900">
      <p class="text-gray-600 dark:text-gray-300">
        No identifiers are currently linked to <%= @identifier_type.display_name %>.
      </p>
    </div>
  <% end %>
</div>

