<div class="<%= local_assigns[:wrapper_classes] || 'py-2 text-sm' %>"
     <%= (local_assigns[:data_attributes] || {}).map { |key, value| %(data-#{key.to_s.tr('_', '-')}="#{value}") }.join(' ') %>>
  <% admin_menu_links.each do |link| %>
    <%= link_to link[:path],
                class: ["flex items-center gap-2 px-3 py-2 hover:bg-gray-100", link[:class]].compact.join(" ") do %>
      <% if link[:icon].present? %>
        <i class="<%= link[:icon] %> text-xs text-gray-500"></i>
      <% end %>
      <span><%= link[:label] %></span>
    <% end %>
  <% end %>
</div>

