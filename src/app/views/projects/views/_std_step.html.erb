<% if @step %>
  <div class="step-results h-full flex flex-col" 
       data-step-id="<%= @step.id %>"
       data-project-id="<%= @project.id %>">
    <% unless @show_form %>
    <!-- Step Results Section -->
    <% if @step.has_std_view && @step.name == 'parsing' %>
      <!-- Render parsing-specific view -->
      <%= render 'projects/views/parsing' %>
    <% end %>
    <% end %>
    
    <!-- Standard Form (when no runs exist) -->
    <% if @show_form %>
      <%= render 'projects/views/std_form' %>
    <% end %>
    
    <% unless @show_form %>
    <!-- Custom Form (when std_form is false for single-run steps) -->
    <% if @show_custom_form %>
      <% custom_form_partial = "projects/views/#{@step.name}" %>
      <% begin %>
        <%= render custom_form_partial %>
      <% rescue ActionView::MissingTemplate => e %>
        <!-- Custom form partial not found: <%= custom_form_partial %> -->
      <% end %>
    <% end %>
    
    <!-- Standard Dashboard (for multiple runs) now uses the same table layout below -->
    
    <!-- Standard Run View (for single run) -->
    <% if @show_view %>
      <div class="bg-white rounded-lg shadow-sm flex flex-col" id="result_summary" style="max-height: calc(100vh - 200px); overflow-y: auto;">
        <div class="border-b border-gray-200 px-6 py-4 sticky top-0 z-10 flex-shrink-0" style="background: linear-gradient(to right, #eff6ff, #eef2ff); background-color: #ffffff;">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
              <%= @step.label.presence || @step.name %> results
            </h3>
            <div class="flex items-center gap-2">
              <!-- Extra header buttons injected by step-specific views -->
              <% if defined?(@extra_header_buttons) && @extra_header_buttons %>
                <%= raw @extra_header_buttons %>
              <% end %>
              <!-- Visualization Button -->
              <% if @step.name.in?(['dim_reduction', 'pca', 'tsne', 'umap']) && @runs %>
                <% successful_run_ids = @runs.select { |r| r.status_id == 3 }.map(&:id) %>
                <% if successful_run_ids.any? && Annot.where(project_id: @project.id, ori_run_id: successful_run_ids, nber_rows: 2).exists? %>
                  <%= link_to project_path(@project, view: 'visualization'),
                      class: "px-3 py-1.5 bg-white hover:bg-gray-100 text-gray-700 rounded-md font-medium text-sm transition-colors cursor-pointer border border-gray-300",
                      title: "Visualization",
                      style: "flex-shrink: 0;" do %>
                    <i class="fas fa-chart-line sm:mr-1"></i><span class="hidden sm:inline"> Visualization</span>
                  <% end %>
                <% end %>
              <% end %>
              <!-- Compare Clusters Button -->
              <% if analyzable?(@project) && @step.name == 'clustering' && @runs&.select { |r| r.status_id == 3 }&.size.to_i >= 2 %>
                <button type="button"
                        class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-md font-medium text-sm transition-colors cursor-pointer"
                        onclick="loadFormInRightPanel('<%= step_results_project_path(@project, step_id: @step.id, view: 'compare_clusters', format: :html) %>')"
                        style="flex-shrink: 0;">
                  <i class="fas fa-arrows-alt-h sm:mr-1"></i><span class="hidden sm:inline"> Compare clusters</span>
                </button>
              <% end %>
              <!-- New Run Button -->
              <% if analyzable?(@project) && @step.has_std_form && @step.multiple_runs %>
                <button type="button" 
                        class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-medium text-sm transition-colors cursor-pointer" 
                        onclick="loadFormInRightPanel('<%= step_results_project_path(@project, step_id: @step.id, show_form: 1, format: :html) %>')"
                        style="flex-shrink: 0;">
                  <i class="fas fa-plus sm:mr-1"></i><span class="hidden sm:inline"> New run</span>
                </button>
              <% end %>
              <!-- Delete All / Delete Selected Button -->
              <% if editable?(@project) && @runs && @runs.any? %>
                <%= button_to delete_all_runs_from_step_project_path(@project, step_id: @step.id), 
                    method: :post,
                    form: {
                      data: {
                        controller: 'delete-all-runs',
                        action: 'submit->delete-all-runs#deleteAllRuns',
                        'delete-all-runs-step-id-value': @step.id,
                        'delete-all-runs-project-id-value': @project.key,
                        'run-selection-target': 'deleteButton',
                        confirm: "Are you sure you want to delete all runs from this step? This will delete all subsequent analyses down the pipeline. This action cannot be undone."
                      }
                    },
                    class: 'px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded-md font-medium text-sm transition-colors cursor-pointer',
                    style: 'flex-shrink: 0;',
                    id: 'delete-runs-button-top' do %>
                  <i class="fas fa-trash-alt sm:mr-1"></i><span class="hidden sm:inline" data-run-selection-target="deleteButtonText"> Delete all</span>
                <% end %>
              <% end %>
              <!-- Restart Button -->
              <% if editable?(@project) && @project_step && @step && !@step.multiple_runs && (@project_step.status_id == 3 || @project_step.status_id == 4) %>
                <button type="button" 
                        class="px-3 py-1.5 bg-orange-600 hover:bg-orange-700 text-white rounded-md font-medium text-sm transition-colors cursor-pointer" 
                        data-controller="restart-step"
                        data-restart-step-project-id-value="<%= @project.id %>"
                        data-restart-step-step-id-value="<%= @step.id %>"
                        data-restart-step-restart-url-value="<%= restart_step_project_path(@project) %>"
                        data-action="click->restart-step#restart"
                        style="flex-shrink: 0;">
                  <i class="fas fa-redo sm:mr-1"></i><span class="hidden sm:inline"> Restart</span>
                </button>
              <% end %>
            </div>
          </div>
        </div>
        <div class="px-6 py-5 space-y-6 flex-1">
          <%= render 'projects/views/std_run_view' %>
        </div>
      </div>
    <% end %>
    
    <!-- Debug info: Show what display mode is active -->
    <% if Rails.env.development? && admin? && (@show_dashboard || @show_view || @show_form || @show_custom_form) %>
      <div class="mb-3">
        <div class="alert alert-secondary">
          <strong>Step Configuration:</strong> multiple_runs=<%= @step.multiple_runs %>, has_std_view=<%= @step.has_std_view %>, has_std_dashboard=<%= @step.has_std_dashboard %>, has_std_form=<%= @step.has_std_form %> | 
          <strong>Display Flags:</strong> show_dashboard=<%= @show_dashboard %>, show_view=<%= @show_view %>, show_form=<%= @show_form %>, show_custom_form=<%= @show_custom_form %> | 
          <strong>Runs:</strong> <%= @runs ? @runs.size : 0 %>
        </div>
      </div>
    <% end %>

    <!-- Runs Section (used for dashboard mode and fallback when no other mode is active) -->
    <% unless @show_view || @show_form || @show_custom_form %>
      <div class="bg-white rounded-lg shadow-sm flex flex-col" style="max-height: calc(100vh - 200px); overflow-y: auto;" data-controller="run-selection">
        <div class="border-b border-gray-200 px-6 py-4 sticky top-0 z-10 flex-shrink-0" style="background: linear-gradient(to right, #eff6ff, #eef2ff); background-color: #ffffff;">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
              <%= @step.label.presence || @step.name %> results
            </h3>
            <div class="flex items-center gap-2">
              <!-- Extra header buttons injected by step-specific views -->
              <% if defined?(@extra_header_buttons) && @extra_header_buttons %>
                <%= raw @extra_header_buttons %>
              <% end %>
              <!-- Visualization Button -->
              <% if @step.name.in?(['dim_reduction', 'pca', 'tsne', 'umap']) && @runs %>
                <% successful_run_ids = @runs.select { |r| r.status_id == 3 }.map(&:id) %>
                <% if successful_run_ids.any? && Annot.where(project_id: @project.id, ori_run_id: successful_run_ids, nber_rows: 2).exists? %>
                  <%= link_to project_path(@project, view: 'visualization'),
                      class: "px-3 py-1.5 bg-white hover:bg-gray-100 text-gray-700 rounded-md font-medium text-sm transition-colors cursor-pointer border border-gray-300",
                      title: "Visualization",
                      style: "flex-shrink: 0;" do %>
                    <i class="fas fa-chart-line sm:mr-1"></i><span class="hidden sm:inline"> Visualization</span>
                  <% end %>
                <% end %>
              <% end %>
              <!-- Compare Clusters Button -->
              <% if analyzable?(@project) && @step.name == 'clustering' && @runs&.select { |r| r.status_id == 3 }&.size.to_i >= 2 %>
                <button type="button"
                        class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-md font-medium text-sm transition-colors cursor-pointer"
                        onclick="loadFormInRightPanel('<%= step_results_project_path(@project, step_id: @step.id, view: 'compare_clusters', format: :html) %>')"
                        style="flex-shrink: 0;">
                  <i class="fas fa-arrows-alt-h sm:mr-1"></i><span class="hidden sm:inline"> Compare clusters</span>
                </button>
              <% end %>
              <!-- New Run Button -->
              <% if analyzable?(@project) && @step.has_std_form && @step.multiple_runs %>
                <button type="button" 
                        class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-medium text-sm transition-colors cursor-pointer" 
                        onclick="loadFormInRightPanel('<%= step_results_project_path(@project, step_id: @step.id, show_form: 1, format: :html) %>')"
                        style="flex-shrink: 0;">
                  <i class="fas fa-plus sm:mr-1"></i><span class="hidden sm:inline"> New run</span>
                </button>
              <% end %>
              <!-- Delete All / Delete Selected Button -->
              <% if editable?(@project) && @runs && @runs.any? %>
                <%= button_to delete_all_runs_from_step_project_path(@project, step_id: @step.id), 
                    method: :post,
                    form: {
                      data: {
                        controller: 'delete-all-runs',
                        action: 'submit->delete-all-runs#deleteAllRuns',
                        'delete-all-runs-step-id-value': @step.id,
                        'delete-all-runs-project-id-value': @project.key,
                        'run-selection-target': 'deleteButton',
                        confirm: "Are you sure you want to delete all runs from this step? This will delete all subsequent analyses down the pipeline. This action cannot be undone."
                      }
                    },
                    class: 'px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded-md font-medium text-sm transition-colors cursor-pointer',
                    style: 'flex-shrink: 0;',
                    id: 'delete-runs-button' do %>
                  <i class="fas fa-trash-alt sm:mr-1"></i><span class="hidden sm:inline" data-run-selection-target="deleteButtonText"> Delete all</span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
        <div class="flex-1 flex flex-col min-h-0">
        
        <% if @runs.any? %>
          <%# Load std_methods for method labels %>
          <% unless defined?(@h_std_methods) && @h_std_methods %>
            <% std_method_ids = @runs.map(&:std_method_id).compact.uniq %>
            <% @h_std_methods = {} %>
            <% StdMethod.where(id: std_method_ids).each { |m| @h_std_methods[m.id] = m } if std_method_ids.any? %>
          <% end %>
          
          <%# Pre-load annots and their associated runs/steps for dataset parameters %>
          <% unless defined?(@h_annots_for_params) && @h_annots_for_params %>
            <% @h_annots_for_params = {} %>
            <% @h_ori_runs_for_params = {} %>
            <% @h_steps_for_params = {} %>
            <% annot_ids = [] %>
            <% direct_run_ids = [] %>
            <% @runs.each do |run| %>
              <% h_attrs = run.attrs_json.present? ? Basic.safe_parse_json(run.attrs_json, {}) : {} %>
              <% h_attrs.each_value do |v| %>
                <% if v.is_a?(Hash) %>
                  <% if v['annot_id'].present? || v[:annot_id].present? %>
                    <% annot_ids << (v['annot_id'] || v[:annot_id]) %>
                  <% elsif v['run_id'].present? || v[:run_id].present? %>
                    <% direct_run_ids << (v['run_id'] || v[:run_id]) %>
                  <% end %>
                <% elsif v.is_a?(Array) %>
                  <% v.each do |item| %>
                    <% if item.is_a?(Hash) %>
                      <% if item['annot_id'].present? || item[:annot_id].present? %>
                        <% annot_ids << (item['annot_id'] || item[:annot_id]) %>
                      <% elsif item['run_id'].present? || item[:run_id].present? %>
                        <% direct_run_ids << (item['run_id'] || item[:run_id]) %>
                      <% end %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
            <% if annot_ids.any? %>
              <% Annot.where(id: annot_ids.uniq).each do |annot| %>
                <% @h_annots_for_params[annot.id] = annot %>
                <% if annot.ori_run_id.present? && !@h_ori_runs_for_params[annot.ori_run_id] %>
                  <% ori_run = Run.find_by(id: annot.ori_run_id) %>
                  <% if ori_run %>
                    <% @h_ori_runs_for_params[annot.ori_run_id] = ori_run %>
                    <% if ori_run.step_id.present? && !@h_steps_for_params[ori_run.step_id] %>
                      <% step = Step.find_by(id: ori_run.step_id) %>
                      <% @h_steps_for_params[ori_run.step_id] = step if step %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
            <%# Also load runs that are directly referenced by run_id without annot_id %>
            <% if direct_run_ids.any? %>
              <% Run.where(id: direct_run_ids.uniq).each do |direct_run| %>
                <% @h_ori_runs_for_params[direct_run.id] = direct_run unless @h_ori_runs_for_params[direct_run.id] %>
                <% if direct_run.step_id.present? && !@h_steps_for_params[direct_run.step_id] %>
                  <% step = Step.find_by(id: direct_run.step_id) %>
                  <% @h_steps_for_params[direct_run.step_id] = step if step %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
          
          <div class="px-6 py-2">
            <input type="text" id="runs-search" placeholder="Filter runs"
                   class="form-input rounded border border-gray-300 bg-white text-sm w-full px-3 py-1.5 shadow-inner focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
          </div>
          <div class="flex-1 min-h-0 px-6 pb-5 overflow-x-auto">
            <table id="runs-table" class="w-full divide-y divide-gray-200 bg-white" style="table-layout: auto;">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-12">
                    <input type="checkbox" 
                           class="rounded border-gray-300 text-red-600 focus:ring-red-500" 
                           data-action="change->run-selection#toggleAll"
                           data-run-selection-target="selectAll">
                  </th>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-16 cursor-pointer whitespace-nowrap select-none" data-sort-col="0" data-sort-numeric="true" onclick="sortRunsTable(this)"># <span class="sort-indicator"></span></th>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider cursor-pointer whitespace-nowrap select-none" data-sort-col="1" onclick="sortRunsTable(this)">Method <span class="sort-indicator"></span></th>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Parameters</th>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-24 cursor-pointer whitespace-nowrap select-none" data-sort-col="3" onclick="sortRunsTable(this)">Status <span class="sort-indicator"></span></th>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-32 cursor-pointer whitespace-nowrap select-none" data-sort-col="4" onclick="sortRunsTable(this)">Created <span class="sort-indicator"></span></th>
                  <th scope="col" class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider w-32">Actions</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @runs.each do |run| %>
                  <% run_status = case run.status_id
                                  when 1 then { name: 'waiting', class: 'warning', bg: 'bg-yellow-100', text: 'text-yellow-800' }
                                  when 2 then { name: 'running', class: 'info', bg: 'bg-blue-100', text: 'text-blue-800' }
                                  when 3 then { name: 'complete', class: 'success', bg: 'bg-green-100', text: 'text-green-800' }
                                  when 4 then { name: 'failed', class: 'danger', bg: 'bg-red-100', text: 'text-red-800' }
                                  else { name: 'unknown', class: 'secondary', bg: 'bg-gray-100', text: 'text-gray-800' }
                                  end %>
                  <% std_method = (@h_std_methods && run.std_method_id) ? @h_std_methods[run.std_method_id] : nil %>
                  <% method_label = std_method ? (std_method.label.presence || std_method.name.presence || 'N/A') : 'N/A' %>
                  <% h_method_attrs = (std_method && @step) ? (Basic.get_std_method_attrs(std_method, @step)[:h_attrs] rescue Basic.safe_parse_json(std_method.attrs_json, {})) : {} %>
                  <%# Parse run attributes for parameters %>
                  <% h_run_attrs = run.attrs_json.present? ? Basic.safe_parse_json(run.attrs_json, {}) : {} %>
                  <% params_array = h_run_attrs.to_a %>
                  <% params_display = params_array.map { |k, v| "#{k}: #{v}" }.join(", ") %>
                  <tr class="hover:bg-gray-50 cursor-pointer" 
                      data-run-id="<%= run.id %>"
                      onclick="if (typeof loadRunInRightPanel === 'function') { loadRunInRightPanel('<%= run_path(run) %>', '<%= @step.id %>'); } else { window.location.href = '<%= run_view_url(run, @project, @step) %>'; }"
                      style="cursor: pointer;">
                    <td class="px-3 py-4 whitespace-nowrap" onclick="event.stopPropagation();">
                      <input type="checkbox" 
                             class="rounded border-gray-300 text-red-600 focus:ring-red-500 run-checkbox" 
                             value="<%= run.id %>"
                             data-action="change->run-selection#updateSelection"
                             data-run-selection-target="checkbox">
                    </td>
                    <td class="px-3 py-4 whitespace-nowrap" data-sort-value="<%= run.num || run.id %>">
                      <div class="text-sm font-semibold text-gray-900">#<%= run.num || run.id %></div>
                      <% if admin? %>
                        <div class="text-xs text-gray-500 font-mono" style="font-size: 0.7rem;"><%= run.id %></div>
                      <% end %>
                    </td>
                    <td class="px-3 py-4" style="max-width: 0;" data-sort-value="<%= method_label.downcase %>">
                      <div class="text-sm text-gray-900 truncate" title="<%= method_label %>" style="width: 100%;"><%= method_label %></div>
                    </td>
                    <td class="px-3 py-4">
                      <% if params_array.any? %>
                        <%= raw display_run_attrs(
                          run,
                          h_run_attrs,
                          { run.std_method_id => h_method_attrs },
                          {
                            h_annots: (defined?(@h_annots_for_params) ? @h_annots_for_params : {}),
                            h_runs: (defined?(@h_ori_runs_for_params) ? @h_ori_runs_for_params : {}),
                            h_steps: (defined?(@h_steps_for_params) ? @h_steps_for_params : {})
                          }
                        ) %>
                      <% else %>
                        <span class="text-gray-400 text-xs">-</span>
                      <% end %>
                    </td>
                    <td class="px-3 py-4 whitespace-nowrap" data-sort-value="<%= run.status_id %>">
                      <div class="flex flex-col gap-1">
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= run_status[:bg] %> <%= run_status[:text] %>">
                          <%= run_status[:name].humanize %>
                        </span>
                        <%# Duration/Timer below status %>
                        <% if run.status_id == 3 && run.duration %>
                          <%# Completed: show duration %>
                          <div class="text-xs text-gray-500 mt-0.5">
                            <i class="fas fa-clock text-gray-400 mr-1"></i>
                            <span><%= duration(run.duration.to_i) %></span>
                          </div>
                        <% elsif run.status_id == 2 && run.start_time %>
                          <%# Running: show live timer %>
                          <div class="text-xs text-gray-500 mt-0.5"
                               data-controller="run-timer"
                               data-run-timer-start-time-value="<%= run.start_time.iso8601 %>">
                            <i class="fas fa-clock text-gray-400 mr-1"></i>
                            <span data-run-timer-target="elapsedTime">--:--</span>
                          </div>
                        <% elsif run.status_id == 1 %>
                          <%# Waiting: show waiting timer and queue position %>
                          <div class="text-xs text-gray-500 mt-0.5 space-y-0.5">
                            <% if run.submitted_at %>
                              <div data-controller="run-timer"
                                   data-run-timer-submitted-at-value="<%= run.submitted_at.iso8601 %>">
                                <i class="fas fa-clock text-gray-400 mr-1"></i>
                                <span data-run-timer-target="elapsedTime">--:--</span>
                              </div>
                            <% end %>
                            <% if run.slurm_job_id %>
                              <div data-controller="queue-position"
                                   data-queue-position-run-id-value="<%= run.id %>"
                                   data-queue-position-slurm-job-id-value="<%= run.slurm_job_id %>"
                                   data-queue-position-project-id-value="<%= @project.key %>"
                                   <% if run.submitted_at %>
                                     data-queue-position-submitted-at-value="<%= run.submitted_at.iso8601 %>"
                                   <% end %>>
                                <span class="text-gray-400">Queue: </span>
                                <span data-queue-position-target="position" class="font-mono text-xs">
                                  <i class="fas fa-spinner fa-spin"></i>
                                </span>
                              </div>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    </td>
                    <td class="px-3 py-4 whitespace-nowrap" data-sort-value="<%= run.created_at&.to_i || 0 %>">
                      <div class="text-xs text-gray-900">
                        <% if run.created_at %>
                          <%= run.created_at.strftime("%Y-%m-%d<br>%H:%M").html_safe %>
                        <% else %>
                          <span class="text-gray-400">N/A</span>
                        <% end %>
                      </div>
                    </td>
                    <td class="px-3 py-4 whitespace-nowrap text-right text-sm font-medium">
                      <div class="flex items-center justify-end gap-1.5" onclick="event.stopPropagation();">
                        <% if @step && @step.name.in?(['dim_reduction', 'pca', 'tsne', 'umap']) %>
                          <%# Find 2D embedding annotation for this run %>
                          <% embedding_annot = Annot.where(project_id: @project.id, ori_run_id: run.id, nber_rows: 2).order(:name).first %>
                          <% if embedding_annot %>
                            <%= link_to project_path(@project, view: 'visualization', embedding_id: embedding_annot.id), 
                                class: 'inline-flex items-center px-3 py-2 border border-blue-300 shadow-sm text-sm font-medium rounded text-blue-700 bg-white hover:bg-blue-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500', 
                                title: 'Visualization' do %>
                              <i class="fas fa-chart-line text-xs"></i>
                            <% end %>
                          <% end %>
                        <% end %>
                        <% if editable?(@project) %>
                          <%= button_to run_path(run, format: :json), 
                              method: :delete,
                              remote: true,
                              form: {
                                data: {
                                  controller: 'delete-run',
                                  action: 'submit->delete-run#deleteRun',
                                  'delete-run-step-id-value': @step.id,
                                  'delete-run-run-num-value': (run.num || run.id).to_s
                                }
                              },
                              class: 'inline-flex items-center px-3 py-2 border border-red-300 shadow-sm text-sm font-medium rounded text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500', 
                              title: 'Delete' do %>
                            <i class="fas fa-trash text-xs"></i>
                          <% end %>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <div id="runs-pagination" class="px-6 py-2 flex items-center justify-between text-sm text-gray-600 border-t border-gray-200" style="display: none;">
            <div>
              <span id="runs-page-info"></span>
              <select id="runs-page-size" class="ml-2 rounded border border-gray-300 text-xs px-1 py-0.5">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
              </select>
              <span class="text-xs text-gray-500">per page</span>
            </div>
            <div class="flex items-center gap-1">
              <button id="runs-prev" class="px-2 py-1 rounded border border-gray-300 bg-white hover:bg-gray-50 disabled:opacity-40 disabled:cursor-not-allowed text-xs">&laquo; Prev</button>
              <span id="runs-page-numbers" class="flex items-center gap-1"></span>
              <button id="runs-next" class="px-2 py-1 rounded border border-gray-300 bg-white hover:bg-gray-50 disabled:opacity-40 disabled:cursor-not-allowed text-xs">Next &raquo;</button>
            </div>
          </div>
          <script>
          (function() {
            var table = document.getElementById('runs-table');
            var search = document.getElementById('runs-search');
            if (!table || !search) return;
            var tbody = table.querySelector('tbody');
            var allRows = Array.from(tbody.querySelectorAll('tr'));
            var currentCol = null, currentDir = 'asc';
            var currentPage = 1;
            var filteredRows = allRows.slice();

            var paginationEl = document.getElementById('runs-pagination');
            var pageSizeSelect = document.getElementById('runs-page-size');
            var pageInfo = document.getElementById('runs-page-info');
            var pageNumbers = document.getElementById('runs-page-numbers');
            var prevBtn = document.getElementById('runs-prev');
            var nextBtn = document.getElementById('runs-next');

            function getPageSize() { return parseInt(pageSizeSelect.value) || 25; }
            function totalPages() { return Math.max(1, Math.ceil(filteredRows.length / getPageSize())); }

            function renderPage() {
              var ps = getPageSize();
              var tp = totalPages();
              if (currentPage > tp) currentPage = tp;
              if (currentPage < 1) currentPage = 1;
              var start = (currentPage - 1) * ps;
              var end = start + ps;

              allRows.forEach(function(r) { r.style.display = 'none'; });
              filteredRows.forEach(function(r, i) {
                r.style.display = (i >= start && i < end) ? '' : 'none';
              });

              if (filteredRows.length > 0) {
                paginationEl.style.display = 'flex';
                pageInfo.textContent = (start + 1) + '-' + Math.min(end, filteredRows.length) + ' of ' + filteredRows.length;
              } else {
                paginationEl.style.display = 'none';
              }

              prevBtn.disabled = currentPage <= 1;
              nextBtn.disabled = currentPage >= tp;

              pageNumbers.innerHTML = '';
              var maxBtns = 5;
              var startP = Math.max(1, currentPage - Math.floor(maxBtns / 2));
              var endP = Math.min(tp, startP + maxBtns - 1);
              if (endP - startP < maxBtns - 1) startP = Math.max(1, endP - maxBtns + 1);
              for (var p = startP; p <= endP; p++) {
                var btn = document.createElement('button');
                btn.textContent = p;
                btn.className = 'px-2 py-1 rounded border text-xs ' + (p === currentPage ? 'bg-blue-600 text-white border-blue-600' : 'border-gray-300 bg-white hover:bg-gray-50');
                btn.setAttribute('data-page', p);
                btn.addEventListener('click', function() { currentPage = parseInt(this.getAttribute('data-page')); renderPage(); });
                pageNumbers.appendChild(btn);
              }
            }

            function applyFilter() {
              var q = search.value.toLowerCase();
              filteredRows = allRows.filter(function(row) {
                return row.textContent.toLowerCase().indexOf(q) >= 0;
              });
              currentPage = 1;
              renderPage();
            }

            search.addEventListener('input', applyFilter);

            pageSizeSelect.addEventListener('change', function() { currentPage = 1; renderPage(); });
            prevBtn.addEventListener('click', function() { if (currentPage > 1) { currentPage--; renderPage(); } });
            nextBtn.addEventListener('click', function() { if (currentPage < totalPages()) { currentPage++; renderPage(); } });

            window.sortRunsTable = function(th) {
              var col = parseInt(th.getAttribute('data-sort-col'));
              var numeric = th.getAttribute('data-sort-numeric') === 'true';
              if (currentCol === col) {
                currentDir = currentDir === 'asc' ? 'desc' : 'asc';
              } else {
                currentCol = col;
                currentDir = 'asc';
              }
              var colIdx = col + 1;
              var sortFn = function(a, b) {
                var cellA = a.querySelectorAll('td')[colIdx];
                var cellB = b.querySelectorAll('td')[colIdx];
                var vA = cellA ? (cellA.getAttribute('data-sort-value') || cellA.textContent.trim()) : '';
                var vB = cellB ? (cellB.getAttribute('data-sort-value') || cellB.textContent.trim()) : '';
                if (numeric) { vA = parseFloat(vA) || 0; vB = parseFloat(vB) || 0; }
                else { vA = vA.toLowerCase(); vB = vB.toLowerCase(); }
                var cmp = vA < vB ? -1 : vA > vB ? 1 : 0;
                return currentDir === 'asc' ? cmp : -cmp;
              };
              allRows.sort(sortFn);
              filteredRows.sort(sortFn);
              allRows.forEach(function(row) { tbody.appendChild(row); });
              table.querySelectorAll('thead th .sort-indicator').forEach(function(el) { el.textContent = ''; });
              th.querySelector('.sort-indicator').textContent = currentDir === 'asc' ? ' \u25B2' : ' \u25BC';
              renderPage();
            };

            var idTh = table.querySelector('thead th[data-sort-col="0"]');
            if (idTh) { sortRunsTable(idTh); sortRunsTable(idTh); }
          })();
          </script>
        <% else %>
          <div class="flex-1 flex items-center justify-center">
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 text-center">
              <i class="fas fa-info-circle text-blue-600 mb-2"></i>
              <p class="text-blue-800 mb-0">No runs found for this step.</p>
            </div>
          </div>
        <% end %>
          </div>
        </div>
      </div>
    <% end %>
    <% end %>
  </div>

<% else %>
  <div class="alert alert-warning">
    <i class="fas fa-exclamation-triangle me-2"></i>Step not found.
  </div>
<% end %>


