<%= form_with(model: step, class: "space-y-6") do |form| %>
  <% if step.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <p class="font-semibold"><%= pluralize(step.errors.count, "error") %> prohibited this step from being saved:</p>
      <ul class="mt-2 list-disc pl-5">
        <% step.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="rounded-lg border border-gray-200 bg-white shadow-sm p-6 space-y-6">
    <div>
      <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= form.text_field :name, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" %>
      </div>
    </div>

    <div>
      <%= form.label :label, class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= form.text_field :label, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" %>
      </div>
    </div>

    <div>
      <%= form.label :obj_name, "Object Name", class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= form.text_field :obj_name, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" %>
      </div>
    </div>

    <div>
      <%= form.label :rank, class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= form.number_field :rank, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" %>
      </div>
    </div>

    <div>
      <%= form.label :group_name, "Group Name", class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= form.text_field :group_name, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" %>
      </div>
    </div>

    <div>
      <%= form.label :description, class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= form.text_area :description, rows: 6, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" %>
      </div>
    </div>

    <div>
      <%= form.label :warnings, class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= form.text_area :warnings, rows: 3, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" %>
      </div>
    </div>

    <div>
      <%= form.label :tag, class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= form.text_field :tag, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" %>
      </div>
    </div>

    <div>
      <%= form.label :version_id, "Version ID", class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= form.number_field :version_id, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" %>
      </div>
    </div>

    <div>
      <%= form.label :docker_image_id, "Docker Image ID", class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= form.number_field :docker_image_id, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" %>
      </div>
    </div>

    <div>
      <%= form.label :attrs_json, "Optional Attributes (JSON)", class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= form.text_area :attrs_json, rows: 4, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 font-mono text-xs" %>
      </div>
    </div>

    <div>
      <%= form.label :method_attrs_json, "Method Attributes (JSON)", class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= form.text_area :method_attrs_json, rows: 4, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 font-mono text-xs" %>
      </div>
    </div>

    <div>
      <%= form.label :command_json, "Command JSON", class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= form.text_area :command_json, rows: 4, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 font-mono text-xs" %>
      </div>
    </div>

    <div>
      <%= form.label :output_json, "Output JSON (expected_outputs, finish_run)", class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= form.text_area :output_json, rows: 8, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 font-mono text-xs" %>
      </div>
    </div>

    <div>
      <%= form.label :dashboard_card_json, "Dashboard card JSON", class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= form.text_area :dashboard_card_json, rows: 6, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 font-mono text-xs" %>
      </div>
    </div>

    <div>
      <%= form.label :show_view_json, "Show view JSON (std run panel layout)", class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= form.text_area :show_view_json, rows: 6, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 font-mono text-xs" %>
      </div>
    </div>

    <div class="flex items-center gap-4">
      <%= form.check_box :multiple_runs, class: "rounded border-gray-300 text-gray-900 focus:ring-gray-900" %>
      <%= form.label :multiple_runs, "Multiple Runs", class: "text-sm font-medium text-gray-700" %>
    </div>

    <div class="flex items-center gap-4">
      <%= form.check_box :has_std_dashboard, class: "rounded border-gray-300 text-gray-900 focus:ring-gray-900" %>
      <%= form.label :has_std_dashboard, "Has Standard Dashboard", class: "text-sm font-medium text-gray-700" %>
    </div>

    <div class="flex items-center gap-4">
      <%= form.check_box :has_std_view, class: "rounded border-gray-300 text-gray-900 focus:ring-gray-900" %>
      <%= form.label :has_std_view, "Has Standard View", class: "text-sm font-medium text-gray-700" %>
    </div>

    <div class="flex items-center gap-4">
      <%= form.check_box :has_std_form, class: "rounded border-gray-300 text-gray-900 focus:ring-gray-900" %>
      <%= form.label :has_std_form, "Has Standard Form", class: "text-sm font-medium text-gray-700" %>
    </div>

    <div class="flex items-center gap-4">
      <%= form.check_box :hidden, class: "rounded border-gray-300 text-gray-900 focus:ring-gray-900" %>
      <%= form.label :hidden, "Hidden", class: "text-sm font-medium text-gray-700" %>
    </div>
  </div>

  <div class="flex items-center justify-end gap-2">
    <%= link_to 'Cancel', steps_path, class: 'inline-flex items-center px-3 py-2 rounded-md border border-gray-200 text-sm text-gray-700 hover:bg-gray-50' %>
    <%= form.submit class: "inline-flex items-center px-3 py-2 rounded-md bg-gray-900 text-white text-sm font-medium hover:bg-gray-800 transition" %>
  </div>
<% end %>

