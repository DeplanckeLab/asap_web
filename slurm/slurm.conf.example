# SLURM cluster configuration (template in repo; production copy is usually /etc/slurm/slurm.conf).
# For adding compute nodes, see docs/SLURM_ADD_COMPUTE_NODES.md
ClusterName=asap_cluster
ControlMachine=slurmctld
SlurmUser=slurm
SlurmdUser=root
SlurmctldPort=6817
SlurmdPort=6818
AuthType=auth/munge
StateSaveLocation=/var/spool/slurmctld
SlurmdSpoolDir=/var/spool/slurmd
SwitchType=switch/none
MpiDefault=none
SlurmctldPidFile=/var/run/slurmctld.pid
SlurmdPidFile=/var/run/slurmd.pid
ProctrackType=proctrack/pgid
TaskPlugin=task/none
PluginDir=/usr/lib/slurm
# Force slurmd to not auto-detect cgroup
LaunchParameters=disable_cgroup
ReturnToService=1
SlurmctldTimeout=300
SlurmdTimeout=300
InactiveLimit=0
MinJobAge=300
KillWait=30
Waittime=0
SchedulerType=sched/backfill
# Allow multiple jobs on the same node using consumable CPU + memory (not whole-node linear).
# Requires RealMemory and CPUs on each NodeName line. See docs/SLURM_CONCURRENT_JOBS.md
SelectType=select/cons_tres
SelectTypeParameters=CR_Core_Memory
# Backfill: keep scanning the queue so pending jobs can start when resources free.
SchedulerParameters=bf_continue
PriorityType=priority/multifactor
# Strong fair-share between associations (e.g. user_1 vs user_2) so one account cannot
# dominate priority; modest job-size weight so huge requests do not always win the queue.
PriorityWeightFairShare=50000
PriorityWeightAge=5000
PriorityWeightPartition=100
PriorityWeightJobSize=50
PriorityWeightQOS=0
PriorityMaxAge=7-0
PriorityDecayHalfLife=7-0
PriorityFavorSmall=NO
PriorityFlags=FAIR_TREE
SlurmctldDebug=info
SlurmdDebug=info
JobCompType=jobcomp/none
JobAcctGatherType=jobacct_gather/none
JobAcctGatherFrequency=30
AccountingStorageType=accounting_storage/slurmdbd
AccountingStorageHost=slurmdbd
AccountingStoragePort=6819
AccountingStorageUser=root
AccountingStoragePass=REPLACE_WITH_SAFE_SECRET

# Node definitions
# Hardware: 4 Sockets, 18 Cores per Socket, 2 Threads per Core = 144 CPUs total
# Host node (slurmd running on host)
NodeName=compute01.example.org NodeAddr=10.0.0.10 CPUs=64 Boards=1 SocketsPerBoard=2 CoresPerSocket=16 ThreadsPerCore=2 RealMemory=256000 State=UNKNOWN

# Example: second compute node (uncomment and set hostname, IP, CPUs, RealMemory after the host is ready).
# Same munge key, Slurm version, shared USER_DATA_DIR, and Docker must be available on that host.
# NodeName=compute02.example.org NodeAddr=10.0.0.12 CPUs=64 Boards=1 SocketsPerBoard=2 CoresPerSocket=16 ThreadsPerCore=2 RealMemory=257000 State=UNKNOWN

# Partition definitions
# List all NodeName values that should run ASAP jobs, comma-separated.
PartitionName=debug Nodes=compute01.example.org Default=YES MaxTime=INFINITE State=UP
# After adding nodes: PartitionName=debug Nodes=compute01.example.org,compute02.example.org Default=YES MaxTime=INFINITE State=UP

