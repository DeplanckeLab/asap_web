<div id="annotation-popup-gene-modal-overlay" class="hidden" style="display: none; position: fixed; top: 80px; left: 50%; transform: translateX(-50%); width: min(760px, calc(100vw - 32px)); height: min(560px, 80vh); min-width: 420px; min-height: 280px; max-width: 90vw; max-height: 90vh; background: white; border: 1px solid #d1d5db; border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); z-index: 13000; overflow: hidden; flex-direction: column;">
  <div id="annotation-popup-gene-modal-header" style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-bottom: 1px solid #e5e7eb; background: linear-gradient(to right, #f0fdf4, #ecfdf5); cursor: move; user-select: none; flex-shrink: 0; border-radius: 12px 12px 0 0;">
    <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
      <i class="fas fa-grip-vertical" style="cursor: move; font-size: 14px; color: #9ca3af; flex-shrink: 0;"></i>
      <h3 style="margin: 0; font-size: 18px; font-weight: 600; color: #111827; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" id="annotation-popup-gene-modal-title">Gene details</h3>
    </div>
    <button type="button" onclick="closeAnnotationPopupGeneModal()" style="background: none; border: none; cursor: pointer; color: #6b7280; padding: 4px; border-radius: 4px; transition: color 0.2s; flex-shrink: 0;" onmouseover="this.style.color='#111827'" onmouseout="this.style.color='#6b7280'">
      <i class="fas fa-times" style="font-size: 18px;"></i>
    </button>
  </div>
  <div class="px-6 py-5 overflow-auto" style="flex: 1; min-height: 0;" id="annotation-popup-gene-modal-body">
    <div class="text-gray-500 text-sm">Loading...</div>
  </div>
  <div id="annotation-popup-gene-modal-resize-right" style="position: absolute; top: 0; right: 0; width: 4px; height: 100%; cursor: col-resize; z-index: 1; background-color: transparent;" onmouseover="this.style.backgroundColor='#3b82f6'" onmouseout="this.style.backgroundColor='transparent'"></div>
  <div id="annotation-popup-gene-modal-resize-bottom" style="position: absolute; bottom: 0; left: 0; width: 100%; height: 4px; cursor: row-resize; z-index: 1; background-color: transparent;" onmouseover="this.style.backgroundColor='#3b82f6'" onmouseout="this.style.backgroundColor='transparent'"></div>
  <div id="annotation-popup-gene-modal-resize-corner" style="position: absolute; bottom: 0; right: 0; width: 12px; height: 12px; cursor: nwse-resize; z-index: 1; background-color: transparent;" onmouseover="this.style.backgroundColor='#3b82f6'" onmouseout="this.style.backgroundColor='transparent'"></div>
</div>

<script>
(function() {
  function escAttr(s) {
    return String(s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;')
  }

  // Annotation bookmark status (category-annot-btn + popup title prefix).
  // FindMarkers run state stays on the separate check/spinner icon.
  //
  // loading      — status not known yet (spinner)
  // none         — no annotations yet
  // markers_ready — FindMarkers done for this metadata, still no annotation
  // annotated    — at least one CLA exists
  // consensus    — best CLA has real agreement (not only the creator auto-agree)
  var ANNOT_BOOKMARK_STATUS = {
    loading: {
      color: '#9ca3af',
      tip: 'Loading annotation status...',
      iconClass: 'fas fa-spinner fa-spin'
    },
    none: {
      color: '#d1d5db',
      tip: 'No annotations yet',
      iconClass: 'fas fa-bookmark'
    },
    markers_ready: {
      color: '#f59e0b',
      tip: 'Markers available — no annotation yet',
      iconClass: 'fas fa-bookmark'
    },
    annotated: {
      color: '#2563eb',
      tip: 'Has annotations — click to view',
      iconClass: 'fas fa-bookmark'
    },
    consensus: {
      color: '#16a34a',
      tip: 'Consensus annotation available — click to view',
      iconClass: 'fas fa-bookmark'
    }
  }
  window.ANNOT_BOOKMARK_STATUS = ANNOT_BOOKMARK_STATUS

  window.normalizeAnnotBookmarkStatus = function(status) {
    var s = String(status || '').trim()
    if (ANNOT_BOOKMARK_STATUS[s]) return s
    return 'none'
  }

  window.annotBookmarkStatusMeta = function(status) {
    return ANNOT_BOOKMARK_STATUS[window.normalizeAnnotBookmarkStatus(status)]
  }

  window.isAnnotBookmarkConsensusCla = function(cla) {
    if (!cla) return false
    var agree = Number(cla.nber_agree)
    var disagree = Number(cla.nber_disagree)
    if (!Number.isFinite(agree)) agree = 0
    if (!Number.isFinite(disagree)) disagree = 0
    var score = agree - disagree
    if (cla.score != null && Number.isFinite(Number(cla.score))) {
      score = Number(cla.score)
    }
    // Creator auto-agree starts at 1; require broader agreement for "consensus".
    return agree >= 2 && score > 0
  }

  window.resolveAnnotBookmarkStatus = function(opts) {
    opts = opts || {}
    if (opts.loading) return 'loading'
    var clas = Array.isArray(opts.clas) ? opts.clas : null
    if (clas) {
      if (clas.length === 0) {
        return opts.markersCompleted ? 'markers_ready' : 'none'
      }
      var best = clas[0]
      var i
      for (i = 1; i < clas.length; i++) {
        var a = Number(clas[i].nber_agree) || 0
        var d = Number(clas[i].nber_disagree) || 0
        var ba = Number(best.nber_agree) || 0
        var bd = Number(best.nber_disagree) || 0
        if ((a - d) > (ba - bd)) best = clas[i]
      }
      return window.isAnnotBookmarkConsensusCla(best) ? 'consensus' : 'annotated'
    }
    if (opts.hasConsensus) return 'consensus'
    if (opts.hasAnnotations) return 'annotated'
    if (opts.markersCompleted) return 'markers_ready'
    if (opts.status) return window.normalizeAnnotBookmarkStatus(opts.status)
    return 'none'
  }

  window.annotBookmarkIconMarkup = function(status) {
    var meta = window.annotBookmarkStatusMeta(status)
    return '<span style="display:inline-flex;align-items:center;justify-content:center;margin-right:8px;flex-shrink:0;" title="' +
      escAttr(meta.tip) + '" aria-label="' + escAttr(meta.tip) + '">' +
      '<i class="' + meta.iconClass + '" style="font-size:11px;color:' + meta.color + ';"></i></span>'
  }

  window.applyAnnotBookmarkButtonStatus = function(btn, status) {
    if (!btn) return
    var st = window.normalizeAnnotBookmarkStatus(status)
    var meta = window.annotBookmarkStatusMeta(st)
    btn.dataset.annotBookmarkStatus = st
    btn.dataset.categoryHasAnnots = (st === 'annotated' || st === 'consensus') ? 'true' : 'false'
    btn.style.color = meta.color
    btn.title = meta.tip
    var icon = btn.querySelector('i')
    if (icon) {
      icon.className = meta.iconClass
      icon.style.fontSize = '11px'
      icon.style.color = meta.color
    }
  }

  window.claGeneBadgesRowHtml = function(genes, kind) {
    if (!genes || genes.length === 0) return ''
    var isUp = kind === 'up'
    var label = isUp ? 'Up genes: ' : 'Down genes: '
    var highlightCls = isUp ? 'bg-green-100 text-green-800 hover:bg-green-200' : 'bg-red-100 text-red-800 hover:bg-red-200'
    var html = ''
    html += '<div style="margin-bottom: 6px;">'
    html += '<span style="font-size: 12px; color: #6b7280; font-weight: 500;">' + escAttr(label) + '</span>'
    html += '<div class="flex flex-wrap gap-1 mt-1">'
    genes.forEach(function(g) {
      var symRaw = String(g.symbol != null ? g.symbol : (g.gene_id || '-')).trim()
      var sym = escAttr(symRaw)
      var ens = g.ensembl_id != null ? String(g.ensembl_id).trim() : ''
      var symLookup = (g.symbol != null && String(g.symbol).trim() !== '') ? String(g.symbol).trim() : ''
      if (!symLookup && g.gene_id != null && !/^ENS[0-9A-Za-z._-]+$/i.test(String(g.gene_id).trim())) {
        symLookup = String(g.gene_id).trim()
      }
      var remoteGid = ''
      var st = g.stable_id != null ? String(g.stable_id).trim() : ''
      var gidRaw = g.gene_id != null ? String(g.gene_id).trim() : ''
      if (/^\d+$/.test(st)) remoteGid = st
      else if (/^\d+$/.test(gidRaw)) remoteGid = gidRaw
      var canOpen = !!(remoteGid || ens || symLookup)
      var cls = highlightCls
      var curs = canOpen ? 'cursor-pointer' : 'cursor-default'
      html += '<span class="annot-popup-gene-badge gene-badge ' + cls + ' ' + curs + ' inline-flex items-center px-2 py-0.5 rounded text-xs font-medium"'
      if (remoteGid) html += ' data-remote-gene-id="' + escAttr(remoteGid) + '"'
      if (ens) html += ' data-ensembl-id="' + escAttr(ens) + '"'
      if (symLookup) html += ' data-gene-symbol="' + escAttr(symLookup) + '"'
      html += ' title="' + escAttr(ens || symRaw || symLookup) + '">' + sym + '</span>'
    })
    html += '</div></div>'
    return html
  }

  window.openAnnotationPopupGeneModal = function(ensemblId, searchUrl, geneSymbol, remoteGeneId, extras) {
    var modal = document.getElementById('annotation-popup-gene-modal-overlay')
    var body = document.getElementById('annotation-popup-gene-modal-body')
    var title = document.getElementById('annotation-popup-gene-modal-title')
    if (!modal || !body || !title) return
    extras = extras || {}
    var ens = ensemblId != null ? String(ensemblId).trim() : ''
    var sym = geneSymbol != null ? String(geneSymbol).trim() : ''
    var rid = remoteGeneId != null ? String(remoteGeneId).trim() : ''
    var featureName = extras.featureName != null ? String(extras.featureName).trim() : ''
    var stableId = extras.stableId != null ? String(extras.stableId).trim() : ''
    var loomFile = extras.loomFile != null ? String(extras.loomFile).trim() : ''
    var ensemblRelease = extras.ensemblRelease != null ? String(extras.ensemblRelease).trim() : ''
    var ensemblRe = /\b((?:ENS[A-Z]{0,4}G|MGP_[A-Za-z0-9]+_G)\d+)(?:\.\d+)?\b/i
    if (ensemblRe.test(ens)) {
      ens = ens.match(ensemblRe)[1]
    } else if (ens) {
      // Keep non-Ensembl-style IDs (e.g. AAEL004591) for backend lookup.
    } else {
      var fromSym = sym.match(ensemblRe)
      if (fromSym) {
        ens = fromSym[1]
        sym = sym.replace(fromSym[0], ' ').replace(/\s+/g, ' ').trim()
      }
    }
    if (sym.indexOf('[') >= 0) {
      sym = sym.replace(/\[.*?\]/g, ' ').replace(/\s+/g, ' ').trim()
    }
    var parts = []
    if (ens) parts.push('ensembl_id=' + encodeURIComponent(ens))
    if (sym) parts.push('gene_symbol=' + encodeURIComponent(sym))
    if (featureName) parts.push('feature_name=' + encodeURIComponent(featureName))
    if (stableId) parts.push('stable_id=' + encodeURIComponent(stableId))
    if (loomFile) parts.push('loom_file=' + encodeURIComponent(loomFile))
    if (ensemblRelease) parts.push('ensembl_release=' + encodeURIComponent(ensemblRelease))
    if (parts.length === 0) return
    if (sym) title.textContent = sym
    else if (ens) title.textContent = ens
    else title.textContent = rid
    body.textContent = ''
    var loadWrap = document.createElement('div')
    loadWrap.className = 'space-y-2'
    var headLine = document.createElement('p')
    headLine.className = 'text-gray-800 text-sm font-medium'
    headLine.textContent = sym || ens || rid
    var subLine = document.createElement('p')
    subLine.className = 'text-gray-500 text-sm'
    subLine.textContent = 'Loading reference gene details from the annotation database...'
    loadWrap.appendChild(headLine)
    loadWrap.appendChild(subLine)
    body.appendChild(loadWrap)
    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal)
    }
    modal.classList.remove('hidden')
    modal.style.display = 'flex'
    modal.style.flexDirection = 'column'
    if (!modal.dataset.positioned && typeof window.centerAnnotationPopupGeneModal === 'function') {
      window.centerAnnotationPopupGeneModal()
    }
    if (typeof window.bringVisualizationPopupToFront === 'function') {
      window.bringVisualizationPopupToFront(modal)
    }
    var csrfMeta = document.querySelector('meta[name="csrf-token"]')
    var csrfToken = csrfMeta ? csrfMeta.getAttribute('content') : ''
    var url = searchUrl + (searchUrl.indexOf('?') >= 0 ? '&' : '?') + parts.join('&') + '&_ts=' + Date.now()
    var t0 = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now()
    console.info('[gene-details.timing] search_gene fetch start', { ens: ens, sym: sym, url: url })
    fetch(url, { headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'text/html', 'Cache-Control': 'no-cache' }, credentials: 'same-origin' })
      .then(function(r) { return r.text().then(function(html) { return { ok: r.ok, status: r.status, html: html } }) })
      .then(function(result) {
        var t1 = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now()
        console.info('[gene-details.timing] search_gene fetch done', {
          status: result.status,
          ms: Math.round(t1 - t0),
          html_bytes: result.html ? result.html.length : 0
        })
        if (!result.ok) {
          body.innerHTML = '<div class="text-red-600 text-sm">Failed to load gene details (HTTP ' + result.status + ').</div>'
          return
        }
        body.innerHTML = result.html
        var afterMemberships = function() {
          var t3 = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now()
          console.info('[gene-details.timing] popup ready (details+memberships)', { ms_from_start: Math.round(t3 - t0) })
          if (window.bindGeneDetailsMembershipExpanders) {
            window.bindGeneDetailsMembershipExpanders(body)
          }
        }
        if (window.loadGeneDetailsMemberships) {
          window.loadGeneDetailsMemberships(body).then(afterMemberships).catch(afterMemberships)
        } else {
          afterMemberships()
        }
      })
      .catch(function(err) {
        var tErr = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now()
