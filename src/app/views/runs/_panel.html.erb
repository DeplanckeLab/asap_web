<!-- Run panel - for display in right panel and standalone show view -->
<div class="bg-white rounded-lg shadow-sm flex flex-col" id="run_result_summary_panel" style="max-height: calc(100vh - 200px); overflow-y: auto; overflow-x: hidden !important; max-width: 100% !important; box-sizing: border-box !important; min-width: 0; width: 100% !important;">
  <!-- Header with title and status - Sticky -->
  <div class="border-b border-gray-200 px-6 py-4 sticky top-0 z-10 flex-shrink-0" style="background: linear-gradient(to right, #eff6ff, #eef2ff); background-color: #ffffff;">
    <div class="flex items-center justify-between min-w-0">
      <div class="flex items-center gap-3 min-w-0 flex-1">
        <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2 min-w-0 truncate">
          <%= run_card_title(@run, @step, @std_method) %>
        </h3>
        <% if @status %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= case @run.status_id
                                                                                                    when 1 then 'bg-yellow-100 text-yellow-800'
                                                                                                    when 2 then 'bg-blue-100 text-blue-800'
                                                                                                    when 3 then 'bg-green-100 text-green-800'
                                                                                                    when 4 then 'bg-red-100 text-red-800'
                                                                                                    else 'bg-gray-100 text-gray-800'
                                                                                                    end %>">
            <%= @status.name.humanize %>
          </span>
        <% end %>
      </div>
      <div class="flex items-center gap-2 flex-shrink-0">
        <% if @run && @step %>
          <button type="button"
                  class="px-3 py-1.5 bg-white hover:bg-gray-100 text-gray-700 rounded-md font-medium text-sm transition-colors cursor-pointer border border-gray-300"
                  title="Copy direct link to clipboard"
                  style="flex-shrink: 0;"
                  onclick="(function(btn) { var url = window.location.origin + '<%= project_path(@project, view: 'analysis', step_id: @step.id, run_id: @run.id) %>'; navigator.clipboard.writeText(url).then(function() { btn.title = 'Copied!'; setTimeout(function() { btn.title = 'Copy direct link to clipboard'; }, 2000); }).catch(function() { prompt('Copy this URL:', url); }); })(this);">
            <i class="fas fa-link sm:mr-1"></i><span class="hidden sm:inline"> Direct link</span>
          </button>
          <button type="button"
                  class="px-3 py-1.5 bg-white hover:bg-gray-100 text-gray-700 rounded-md font-medium text-sm transition-colors cursor-pointer border border-gray-300"
                  title="Refresh"
                  style="flex-shrink: 0;"
                  onclick="if (typeof loadRunInRightPanel === 'function') { loadRunInRightPanel('<%= run_path(@run) %>', '<%= @step&.id %>'); }">
            <i class="fas fa-sync sm:mr-1"></i><span class="hidden sm:inline"> Refresh</span>
          </button>
          <button type="button"
                  class="px-3 py-1.5 bg-gray-600 hover:bg-gray-700 text-white rounded-md font-medium text-sm transition-colors cursor-pointer"
                  style="flex-shrink: 0;"
                  onclick="loadFormInRightPanel('<%= step_results_project_path(@project, step_id: @step.id, format: :html) %>')">
            <i class="fas fa-arrow-left sm:mr-1"></i><span class="hidden sm:inline"> Back to runs</span>
          </button>
        <% end %>
        <% if @step && @step.name.in?(['dim_reduction', 'pca', 'tsne', 'umap']) %>
          <%= link_to project_path(@project, view: 'visualization'), 
              class: "px-3 py-1.5 bg-white hover:bg-gray-100 text-gray-700 rounded-md font-medium text-sm transition-colors cursor-pointer border border-gray-300",
              title: "Visualization",
              style: "flex-shrink: 0;" do %>
            <i class="fas fa-chart-line sm:mr-1"></i><span class="hidden sm:inline"> Visualization</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
  <div id="run_metadata_sticky_panel" class="sticky z-10 flex-shrink-0 bg-white" style="top: 60px;">
    <%= render partial: 'projects/views/run_metadata', locals: { run: @run, results: @h_res } %>
  </div>
  <% if @run %>

    <script>
      // Dynamically calculate the top position for run_information based on actual heights
      (function() {
        const container = document.querySelector('#run_result_summary_panel');
        if (!container) return;
        
        const header = container.querySelector('[class*="sticky top-0"]');
        const metadata = container.querySelector('#run_metadata_sticky_panel');
        const runInfo = container.querySelector('#run_information_sticky_panel');
        
        if (header && metadata && runInfo) {
          const updateTop = () => {
            const headerHeight = header.offsetHeight;
            const metadataHeight = metadata.offsetHeight;
            runInfo.style.top = (headerHeight + metadataHeight) + 'px';
          };
          
          // Update on load and resize
          updateTop();
          window.addEventListener('resize', updateTop);
          
          // Also update after delays to account for dynamic content
          setTimeout(updateTop, 100);
          setTimeout(updateTop, 500);
        }
      })();
    </script>
  <% end %>
  <!-- Scrollable content area -->
  <div class="px-6 py-5 space-y-6 flex-1 min-w-0 overflow-x-hidden">

      <!-- Error Display -->
      <% if @run.status_id == 4 && (@run.error.present? || (@h_res && @h_res['displayed_error'])) %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4">
          <div class="flex items-start gap-3">
            <i class="fas fa-exclamation-circle text-red-600 mt-0.5"></i>
            <div class="flex-1">
              <h4 class="text-sm font-semibold text-red-800 mb-2">Error</h4>
              <% 
                error_messages = []
                if @h_res && @h_res['displayed_error']
                  displayed_errors = @h_res['displayed_error'].is_a?(Array) ? @h_res['displayed_error'] : [@h_res['displayed_error']]
                  error_messages.concat(displayed_errors.compact)
                end
                if @run.error.present?
                  run_error = @run.error.strip
                  unless error_messages.any? { |msg| msg.to_s.strip == run_error }
                    error_messages << run_error
                  end
                end
                error_messages.uniq.each do |error_msg|
              %>
                <p class="text-red-800 mb-1" title="<%= error_msg %>"><%= error_msg %></p>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Filtering Summary -->
      <% if @step && ["gene_filtering", "cell_filtering"].include?(@step.name) && @run.status_id == 3 && @h_res %>
        <div class="pt-4 relative">
          <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-2 flex items-center gap-2">
            <i class="fas fa-chart-bar text-gray-500"></i>
            Filtering summary
          </h4>
          <div class="flex flex-wrap gap-3">
            <% if @h_res['nber_rows'] %>
              <div class="inline-flex items-center gap-2 px-4 py-2 bg-blue-50 border border-blue-200 rounded-lg">
                <i class="fas fa-dna text-blue-600"></i>
                <span class="text-sm font-medium text-blue-900"><%= row_label(@project).capitalize %>: <span class="font-bold"><%= @h_res['nber_rows'] %></span></span>
              </div>
            <% end %>
            <% if @h_res['nber_cols'] %>
              <div class="inline-flex items-center gap-2 px-4 py-2 bg-purple-50 border border-purple-200 rounded-lg">
                <i class="fas fa-circle text-purple-600"></i>
                <span class="text-sm font-medium text-purple-900"><%= col_label(@project).capitalize %>: <span class="font-bold"><%= @h_res['nber_cols'] %></span></span>
              </div>
            <% end %>
            <% if @step && @h_dashboard_card[@step.id] && @h_dashboard_card[@step.id]["output_values"] && @h_dashboard_card[@step.id]["output_values"].any? %>
            <% @h_dashboard_card[@step.id]["output_values"].each do |output| %>
                <% if @h_res[output["key"]] && output["key"] != 'nber_rows' && output["key"] != 'nber_cols' %>
                  <div class="inline-flex items-center gap-2 px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg">
                    <span class="text-sm font-medium text-gray-900"><%= output["label"] %>: <span class="font-bold"><%= @h_res[output["key"]] %></span></span>
                  </div>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Warnings -->
      <% if @run.status_id == 3 && @h_res && @h_res['warnings'] && @h_res['warnings'].any? %>
        <div class="alert alert-warning flex items-start gap-3">
          <i class="fas fa-exclamation-triangle text-yellow-600 mt-0.5"></i>
          <div class="flex-1">
            <h4 class="text-sm font-semibold text-yellow-800 mb-2">Warnings</h4>
            <% @h_res['warnings'].each do |warning| %>
              <% if warning.is_a?(Hash) %>
                <p class="text-yellow-800 mb-1">
                  <strong><%= warning['name'] %></strong>
                  <% if warning['description'] %>
                    <span class="block text-sm mt-1"><%= warning['description'] %></span>
                  <% end %>
                </p>
              <% else %>
                <p class="text-yellow-800 mb-1"><%= warning %></p>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @step && @step.has_std_view %>
        <%# Use std_view structure for additional content %>
        <% if @layout && @layout.any? %>
          <% @layout.each do |vertical_el| %>
            <% if (!vertical_el['admin'] || admin?) %>
              <%# Check if there are any visible cards in this row %>
              <% has_visible_cards = vertical_el["horiz_elements"].any? do |horiz_element|
                   id = horiz_element['id'].to_s
                   horiz_element['type'] == 'card' && (@h_el[id] || (horiz_element['partial'] && @h_outputs && @h_outputs[horiz_element['output_name']] && (!horiz_element['admin'] || admin?)))
                 end %>
              <% if has_visible_cards %>
                <div class="vert_element <%= tw_class('row') %>">
                <% vertical_el["horiz_elements"].each do |horiz_element| %>
                  <% id = horiz_element['id'].to_s %>
                  <%# Only render the container if the card will actually be displayed %>
                  <% if horiz_element['type'] == 'card' && (@h_el[id] || (horiz_element['partial'] && @h_outputs && @h_outputs[horiz_element['output_name']] && (!horiz_element['admin'] || admin?))) %>
                    <% container_class_str = horiz_element['container_class'] || '' %>
                    <%# Swap col-md-4 and col-md-8 for params and downloads to fix layout %>
                    <% if id == 'card-params' && container_class_str == 'col-md-4' %>
                      <% container_class_str = 'col-md-8' %>
                    <% elsif id == 'card-downloads' && container_class_str == 'col-md-8' %>
                      <% container_class_str = 'col-md-4' %>
                    <% end %>
                    <% container_classes = container_class_str.present? ? tw_class(container_class_str) : 'w-full flex-[1_1_100%] min-w-full' %>
                      <div class="horiz_element <%= container_classes %>">
                        <% card_class_str = horiz_element['class'] || '' %>
                        <% card_classes = card_class_str.present? ? tw_class(card_class_str) : '' %>
                        <div class="<%= tw_class('card') %> <%= card_classes %>">
                          <% if @h_el[id] %>
                            <% if @h_el[id][:card_header] %>
                              <div class="<%= tw_class('card-header') %>">
                                <% if id == 'card-params' %>
                                  <i class="fas fa-cog text-gray-500"></i>
                                <% elsif id == 'card-downloads' %>
                                  <i class="fas fa-download text-gray-500"></i>
                                <% elsif id == 'card-results' %>
                                  <i class="fas fa-chart-bar text-gray-500"></i>
                                <% end %>
                                <%= raw translate_bootstrap_in_html(@h_el[id][:card_header]) %>
                                <% if id == 'card-results' && @h_annots_by_dim && @h_annots_by_dim.any? %>
                                  <%# Get Loom file path from first annotation %>
                                  <% loom_filepath = nil %>
                                  <% loom_onum = nil %>
                                  <% matrix_annot = nil %>
                                  <% @h_annots_by_dim.each_value do |annots| %>
                                    <% annots.each do |annot| %>
                                      <% if annot.name == '/matrix' %>
                                        <% matrix_annot = annot %>
                                        <% break %>
                                      <% end %>
                                    <% end %>
                                    <% break if matrix_annot %>
                                  <% end %>
                                  <%# Fallback to first matrix (dim == 3) if /matrix not found %>
                                  <% unless matrix_annot %>
                                    <% @h_annots_by_dim.each_value do |annots| %>
                                      <% annots.each do |annot| %>
                                        <% if annot.dim == 3 %>
                                          <% matrix_annot = annot %>
                                          <% break %>
                                        <% end %>
                                      <% end %>
                                      <% break if matrix_annot %>
                                    <% end %>
                                  <% end %>

                                  <% @h_annots_by_dim.each_value do |annots| %>
                                    <% if annots.any? && annots.first.filepath.present? %>
                                      <% loom_filepath = annots.first.filepath %>
                                      <%# Find onum in @h_outputs for this filepath %>
                                      <% if @h_outputs %>
                                        <% @h_outputs.each do |output_key, output_data| %>
                                          <% if output_data.is_a?(Hash) %>
                                            <% output_data.each do |file_key, file_info| %>
                                              <% if file_info.is_a?(Hash) %>
                                                <% relative_path = file_key.split(":").first %>
                                                <% if relative_path == loom_filepath && file_info['onum'] %>
                                                  <% loom_onum = file_info['onum'] %>
                                                  <% break %>
                                                <% end %>
                                              <% end %>
                                            <% end %>
                                          <% end %>
                                          <% break if loom_onum %>
                                        <% end %>
                                      <% end %>
                                      <% break %>
                                    <% end %>
                                  <% end %>
                                  <% if loom_filepath %>
                                    <span class="text-xs font-normal text-gray-500 normal-case">
                                      (stored in
                                      <% if loom_onum %>
                                        <%= link_to loom_filepath, get_file_project_path(@project, onum: loom_onum, run_id: @run.id), class: 'text-blue-600 hover:text-blue-800 underline' %>
                                      <% else %>
                                        <%= loom_filepath %>
                                      <% end %>
                                      )
                                    </span>
                                  <% end %>
                                <% end %>
                              </div>
                            <% end %>
                            <div class="<%= tw_class('card-body') %> <%= 'space-y-1' if id == 'card-downloads' %>">
                              <% if id == 'card-params' && @h_run_attrs && @h_run_attrs.any? %>
                                <% h_method_attrs = (@std_method && @step) ? (Basic.get_std_method_attrs(@std_method, @step)[:h_attrs] rescue Basic.safe_parse_json(@std_method.attrs_json, {})) : {} %>
                                <div class="flex flex-wrap gap-1.5 items-center">
                                  <% params_array = @h_run_attrs.to_a %>
                                  <% params_array.each do |key, value| %>
                                    <% annot_id = nil %>
                                    <% if value.is_a?(Hash) %>
                                      <% annot_id = value['annot_id'] || value[:annot_id] %>
                                    <% end %>
                                    <% if annot_id.present? %>
                                      <% annot = @h_annots_for_params[annot_id.to_i] if defined?(@h_annots_for_params) %>
                                      <% if annot %>
                                        <% ori_run = @h_ori_runs_for_params[annot.ori_run_id] if annot.ori_run_id.present? && defined?(@h_ori_runs_for_params) %>
                                        <% ori_step = (ori_run && ori_run.step_id && defined?(@h_steps_for_params) && @h_steps_for_params[ori_run.step_id]) ? @h_steps_for_params[ori_run.step_id] : nil %>
                                        <% step_name = ori_step ? (ori_step.label.presence || ori_step.name.presence || 'N/A') : 'N/A' %>
                                        <% if ori_step && ori_step.multiple_runs && ori_run %>
                                          <% run_num = ori_run.num || ori_run.id %>
                                          <% dataset_display = "#{step_name} ##{run_num} #{annot.name}" %>
                                        <% else %>
                                          <% dataset_display = "#{step_name} #{annot.name}" %>
                                        <% end %>
                                        <% truncated_dataset = dataset_display.length > 30 ? dataset_display[0..26] + "..." : dataset_display %>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700 border border-blue-200 cursor-pointer hover:bg-blue-200 transition-colors"
                                              data-controller="pipeline-runs"
                                              data-pipeline-runs-annot-id-value="<%= annot_id %>"
                                              data-pipeline-runs-project-id-value="<%= @project.id %>"
                                              data-pipeline-runs-url-value="<%= pipeline_runs_project_path(@project) %>"
                                              data-action="click->pipeline-runs#showPipeline"
                                              onclick="event.stopPropagation();"
                                              title="<%= param_tooltip(key, h_method_attrs) %>">
                                          <span class="font-semibold text-blue-800"><%= key %>:</span>
                                          <span class="text-blue-600"><%= truncated_dataset %></span>
                                        </span>
                                      <% else %>
                                        <%# annot_id present but annot not found - check if run_id is available %>
                                        <% direct_run_id = value['run_id'] || value[:run_id] %>
                                        <% if direct_run_id.present? %>
                                          <% direct_run = @h_ori_runs_for_params[direct_run_id.to_i] if defined?(@h_ori_runs_for_params) %>
                                          <% if direct_run %>
                                            <% direct_step = @h_steps_for_params[direct_run.step_id] if direct_run.step_id.present? && defined?(@h_steps_for_params) %>
                                            <% step_name = direct_step ? (direct_step.label.presence || direct_step.name.presence || 'N/A') : 'N/A' %>
                                            <% dataset_name = value['output_dataset'] || value[:output_dataset] || '/matrix' %>
                                            <% if direct_step && direct_step.multiple_runs %>
                                              <% run_num = direct_run.num || direct_run.id %>
                                              <% dataset_display = "#{step_name} ##{run_num} #{dataset_name}" %>
                                            <% else %>
                                              <% dataset_display = "#{step_name} #{dataset_name}" %>
                                            <% end %>
                                            <% truncated_dataset = dataset_display.length > 30 ? dataset_display[0..26] + "..." : dataset_display %>
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700 border border-blue-200 cursor-pointer hover:bg-blue-200 transition-colors"
                                                  data-controller="pipeline-runs"
                                                  data-pipeline-runs-run-id-value="<%= direct_run_id %>"
                                                  data-pipeline-runs-project-id-value="<%= @project.id %>"
                                                  data-pipeline-runs-url-value="<%= pipeline_runs_project_path(@project) %>"
                                                  data-action="click->pipeline-runs#showPipeline"
                                                  onclick="event.stopPropagation();"
                                                  title="<%= param_tooltip(key, h_method_attrs) %>">
                                              <span class="font-semibold text-blue-800"><%= key %>:</span>
                                              <span class="text-blue-600"><%= truncated_dataset %></span>
                                            </span>
                                          <% else %>
                                            <% value_str = value.to_json %>
                                            <% truncated_value = value_str.length > 20 ? value_str[0..16] + "..." : value_str %>
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200 cursor-help" title="<%= param_tooltip(key, h_method_attrs) %>">
                                              <span class="font-semibold text-gray-800"><%= key %>:</span>
                                              <span class="text-gray-600"><%= truncated_value %></span>
                                            </span>
                                          <% end %>
                                        <% else %>
                                          <% value_str = value.to_json %>
                                          <% truncated_value = value_str.length > 20 ? value_str[0..16] + "..." : value_str %>
                                          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200 cursor-help" title="<%= param_tooltip(key, h_method_attrs) %>">
                                            <span class="font-semibold text-gray-800"><%= key %>:</span>
                                            <span class="text-gray-600"><%= truncated_value %></span>
                                          </span>
                                        <% end %>
                                      <% end %>
                                    <% elsif value.is_a?(Hash) && (value['run_id'].present? || value[:run_id].present?) %>
                                      <%# Hash with run_id but no annot_id %>
                                      <% direct_run_id = value['run_id'] || value[:run_id] %>
                                      <% direct_run = @h_ori_runs_for_params[direct_run_id.to_i] if defined?(@h_ori_runs_for_params) %>
                                      <% if direct_run %>
                                        <% direct_step = @h_steps_for_params[direct_run.step_id] if direct_run.step_id.present? && defined?(@h_steps_for_params) %>
                                        <% step_name = direct_step ? (direct_step.label.presence || direct_step.name.presence || 'N/A') : 'N/A' %>
                                        <% dataset_name = value['output_dataset'] || value[:output_dataset] || '/matrix' %>
                                        <% if direct_step && direct_step.multiple_runs %>
                                          <% run_num = direct_run.num || direct_run.id %>
                                          <% dataset_display = "#{step_name} ##{run_num} #{dataset_name}" %>
                                        <% else %>
                                          <% dataset_display = "#{step_name} #{dataset_name}" %>
                                        <% end %>
                                        <% truncated_dataset = dataset_display.length > 30 ? dataset_display[0..26] + "..." : dataset_display %>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700 border border-blue-200 cursor-pointer hover:bg-blue-200 transition-colors"
                                              data-controller="pipeline-runs"
                                              data-pipeline-runs-run-id-value="<%= direct_run_id %>"
                                              data-pipeline-runs-project-id-value="<%= @project.id %>"
                                              data-pipeline-runs-url-value="<%= pipeline_runs_project_path(@project) %>"
                                              data-action="click->pipeline-runs#showPipeline"
                                              onclick="event.stopPropagation();"
                                              title="<%= param_tooltip(key, h_method_attrs) %>">
                                          <span class="font-semibold text-blue-800"><%= key %>:</span>
                                          <span class="text-blue-600"><%= truncated_dataset %></span>
                                        </span>
                                      <% else %>
                                        <% value_str = value.to_json %>
                                        <% truncated_value = value_str.length > 20 ? value_str[0..16] + "..." : value_str %>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200 cursor-help" title="<%= param_tooltip(key, h_method_attrs) %>">
                                          <span class="font-semibold text-gray-800"><%= key %>:</span>
                                          <span class="text-gray-600"><%= truncated_value %></span>
                                        </span>
                                      <% end %>
                                    <% elsif value.is_a?(Array) && value.any? && value.first.is_a?(Hash) %>
                                      <% first_annot_id = value.first['annot_id'] || value.first[:annot_id] %>
                                      <% if first_annot_id.present? %>
                                        <% first_annot = @h_annots_for_params[first_annot_id.to_i] if defined?(@h_annots_for_params) %>
                                        <% if first_annot %>
                                          <% ori_run = @h_ori_runs_for_params[first_annot.ori_run_id] if first_annot.ori_run_id.present? && defined?(@h_ori_runs_for_params) %>
                                          <% ori_step = (ori_run && ori_run.step_id && defined?(@h_steps_for_params) && @h_steps_for_params[ori_run.step_id]) ? @h_steps_for_params[ori_run.step_id] : nil %>
                                          <% step_name = ori_step ? (ori_step.label.presence || ori_step.name.presence || 'N/A') : 'N/A' %>
                                          <% if ori_step && ori_step.multiple_runs && ori_run %>
                                            <% run_num = ori_run.num || ori_run.id %>
                                            <% dataset_display = "#{step_name} ##{run_num} #{first_annot.name}" %>
                                          <% else %>
                                            <% dataset_display = "#{step_name} #{first_annot.name}" %>
                                          <% end %>
                                          <% array_display = value.size > 1 ? "#{dataset_display} (+#{value.size - 1} more)" : dataset_display %>
                                          <% truncated_array = array_display.length > 30 ? array_display[0..26] + "..." : array_display %>
                                          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700 border border-blue-200 cursor-help" title="<%= param_tooltip(key, h_method_attrs) %>">
                                            <span class="font-semibold text-blue-800"><%= key %>:</span>
                                            <span class="text-blue-600"><%= truncated_array %></span>
                                          </span>
                                        <% else %>
                                          <% value_str = "[#{value.size} datasets]" %>
