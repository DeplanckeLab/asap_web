<%# Simplified attributes partial for rendering attribute fields %>
<% @h_attr_vals ||= {} %>

<%
  # Build compact constraint badges to display next to the field label
  # (required / min-max items / min-max values). Keeps the user informed of
  # field rules without stealing vertical space below the input.
  render_constraint_badges = lambda do |attr_name, attr|
    badges = []
    auto_filled_required_attrs = %w[group_ref group_comp]
    if attr['not_null'] && !auto_filled_required_attrs.include?(attr_name.to_s)
      badges << %(<span class="inline-flex items-center rounded-md bg-red-50 px-2 py-0.5 text-[10px] font-medium text-red-700 ring-1 ring-inset ring-red-200">required</span>)
    end

    widget = attr['widget']
    min_items = attr['min_nber_items']
    max_items = attr['max_nber_items']
    show_item_badges = widget == 'input_data' || attr['req_data_structure'] == 'array'
    if show_item_badges
      # Skip grey "exactly N items" when min == max: the input-data inline
      # messages already say "Please select exactly N" / "N items selected".
      exact_count = min_items && max_items && min_items.to_i > 0 && max_items.to_i > 0 && min_items.to_i == max_items.to_i
      unless exact_count
        if min_items && min_items.to_i > 0
          badges << %(<span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-[10px] font-medium text-gray-700 ring-1 ring-inset ring-gray-200">min #{min_items.to_i} item#{min_items.to_i > 1 ? 's' : ''}</span>)
        end
        if max_items && max_items.to_i > 0
          badges << %(<span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-[10px] font-medium text-gray-700 ring-1 ring-inset ring-gray-200">max #{max_items.to_i} item#{max_items.to_i > 1 ? 's' : ''}</span>)
        end
      end
    end

    # Numeric range applies to textfield/number inputs; for a select with a
    # min_val/max_val pair, the range is already rendered as the list of
    # options, so we skip badges there to avoid redundancy.
    if widget != 'select'
      unless attr['min_val_expression'].present? || attr['max_val_expression'].present?
        min_val = attr['min_val']
        max_val = attr['max_val']
        if min_val.present? && max_val.present?
          badges << %(<span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-[10px] font-medium text-gray-700 ring-1 ring-inset ring-gray-200">#{min_val} &le; value &le; #{max_val}</span>)
        elsif min_val.present?
          badges << %(<span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-[10px] font-medium text-gray-700 ring-1 ring-inset ring-gray-200">&ge; #{min_val}</span>)
        elsif max_val.present?
          badges << %(<span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-[10px] font-medium text-gray-700 ring-1 ring-inset ring-gray-200">&le; #{max_val}</span>)
        end
      end
    end

    badges.empty? ? '' : %(<span class="ml-2 inline-flex flex-wrap gap-1 align-middle">#{badges.join}</span>)
  end

  layout_title_for = lambda do |node|
    next nil unless node.is_a?(Hash)
    keys = %w[title card_title card-header header section_title subtitle label name]
    keys.each do |k|
      value = node[k]
      return value if value.present?
    end
    nil
  end
%>

<div class="attr-layout-host space-y-4">
  <% @attr_layout.each_with_index do |vertical_el, vertical_idx| %>
    <% vertical_class = vertical_el['class'].presence || '' %>
    <% vertical_title = layout_title_for.call(vertical_el) %>
    <div class="space-y-4 <%= vertical_class %>">
      <% if vertical_idx > 0 %><div class="pt-1"></div><% end %>
      <% if vertical_title.present? %>
        <h3 class="text-sm font-semibold text-gray-800"><%= vertical_title %></h3>
      <% end %>
      <div class="attr-layout-row">
      <% (vertical_el["horiz_elements"] || []).each_with_index do |horiz_element, horiz_idx| %>
        <% layout_col_class = attr_layout_column_class(horiz_element['container_class']) %>
        <% raw_custom_section_class = horiz_element['class'].to_s %>
        <% custom_section_class = raw_custom_section_class.split.reject { |klass| klass == 'h-100' || klass == 'card' }.join(' ') %>
        <% section_class = "bg-white border border-gray-200 rounded-lg shadow-sm p-4 space-y-4 h-full flex flex-col #{custom_section_class}".strip %>
        <% section_title = layout_title_for.call(horiz_element) %>
        <div class="attr-layout-col horiz_element <%= layout_col_class %>">
          <div class="<%= section_class %>">
            <% if section_title.present? %>
              <h4 class="text-sm font-medium text-gray-700"><%= section_title %></h4>
            <% end %>
            <% if horiz_element['attr_list'] %>
              <% horiz_element['attr_list'].each do |attr_name| %>
              <% attr = @h_attrs[attr_name] %>
              <% next unless attr && attr['widget'] && !attr['obsolete'] %>
              <% form_attr_name = "attrs[" + attr_name + "]" %>
              <% attr_val = @h_attr_vals[attr_name] %>
              <% scalar_value_for_field = if attr['default_expression'].present?
                   attr_val.nil? ? '' : attr_val
                 else
                   attr_val || attr['default'] || ''
                 end %>
              
              <div id="form-container_<%= attr_name %>" 
                   class="mb-4"
                   data-attr-name="<%= attr_name %>"
                   data-attr-widget="<%= attr['widget'] %>"
                   data-attr-not-null="<%= attr['not_null'] ? 'true' : 'false' %>"
                   data-attr-constraints="<%= h((attr['constraints'] || {}).to_json) %>"
                   data-attr-requires="<%= h(Array(attr['requires']).to_json) %>"
                   data-attr-requires-message="<%= h(attr['requires_message'].to_s) %>"
                   data-attr-min-items="<%= attr['min_nber_items'] || 0 %>"
                   data-attr-max-items="<%= attr['max_nber_items'] || '' %>"
                   data-attr-min-val="<%= attr['min_val'] || '' %>"
                   data-attr-max-val="<%= attr['max_val'] || '' %>"
                   data-attr-min-val-expression="<%= h(attr['min_val_expression'].to_s) %>"
                   data-attr-max-val-expression="<%= h(attr['max_val_expression'].to_s) %>"
                   data-attr-default-expression="<%= h(attr['default_expression'].to_s) %>">
                <% if attr['widget'] != 'checkbox' && attr['widget'] != 'hidden' %>
                  <label for="attrs_<%= attr_name %>" class="block text-sm font-medium text-gray-700 mb-2">
                    <%= raw(attr['label'] || attr_name.humanize) %>
                    <% if attr['description'].present? %>
                      <span class="text-gray-400 text-xs ml-1" title="<%= attr['description'] %>">?</span>
                    <% end %>
                    <%= raw(render_constraint_badges.call(attr_name, attr)) %>
                    <% if attr['widget'] == 'input_data' %>
                      <span data-input-data-validation-inline="<%= attr_name %>"
                            class="ml-2 hidden"
                            role="status"></span>
                    <% end %>
                  </label>
                <% end %>
                
                <div data-attr-input-wrap="1">
                <% case attr['widget'] %>
                <% when 'input_data' %>
                  <% if attr['valid_types'].present? && attr['source_steps'].present? %>
                    <% project_type_name = @project.project_type&.name %>
                    <% project_type_tag = @project.project_type&.tag %>
                    <% all_steps = (@h_steps.respond_to?(:values) ? @h_steps.values : Array(@h_steps)).compact %>
                    <% applicable_steps = all_steps.select { |step_record|
                         step_attrs = Basic.safe_parse_json(step_record.attrs_json, {})
                         step_project_types = step_attrs['project_types']
                         if project_type_name.present? && step_project_types.present? && step_project_types.any?
                           step_project_types.include?(project_type_name) || (project_type_tag.present? && step_project_types.include?(project_type_tag))
                         else
                           true
                         end
                       } %>
                    <% allowed_source_step_names = Array(attr['source_steps']).map(&:to_s) %>
                    <% h_steps_by_id = applicable_steps.index_by(&:id) %>
                    <% source_step_ids = allowed_source_step_names.map { |name| h_steps_by_id.values.find { |s| s.name == name }&.id }.compact %>
                    <% source_runs = @h_runs.values.select do |r|
                         step_name = h_steps_by_id[r.step_id]&.name
                         step_name.present? && allowed_source_step_names.include?(step_name)
                       end %>
                    <% source_run_ids = source_runs.map(&:id) %>
                    <% h_data_classes = {} %>
                    <% DataClass.all.each { |dc| h_data_classes[dc.id] = dc.name } %>
                    <%# Pipeline outputs plus imported data mapped via sim_step_id or ori_step_id. %>
                    <% candidate_annots = [] %>
                    <% if source_run_ids.any? %>
                      <% candidate_annots.concat(
                           Annot.where(project_id: @project.id, run_id: source_run_ids)
                                .order(:name, :id)
                                .to_a
                                .select do |annot|
                                  run = @h_runs[annot.run_id]
                                  next false unless run
                                  step_name = h_steps_by_id[run.step_id]&.name
                                  allowed_source_step_names.include?(step_name)
                                end
                         ) %>
                    <% end %>
                    <% if source_step_ids.any? %>
                      <% imported_annots = Annot.where(project_id: @project.id, imported: true)
                                                .order(:name, :id)
                                                .select { |annot| annot.matches_source_step_ids?(source_step_ids) } %>
                      <% candidate_annots.concat(imported_annots) %>
                    <% end %>
                    <% candidate_annots = candidate_annots.uniq(&:id) %>
                    <% if defined?(@selected_loom_file) && @selected_loom_file.present? %>
                      <% candidate_annots = candidate_annots.select { |annot| annot.filepath == @selected_loom_file } %>
                    <% end %>
                    <% source_methods_filter = attr['source_methods'] %>
                    <% excluded_source_methods_filter = attr['excluded_source_methods'] %>
                    <% if source_methods_filter.present? || excluded_source_methods_filter.present? %>
                      <% annot_run_ids_for_filter = candidate_annots.map(&:run_id).compact.uniq %>
                      <% h_runs_for_filter = Run.where(id: annot_run_ids_for_filter).index_by(&:id) %>
                      <% h_std_methods_for_filter = StdMethod.where(id: h_runs_for_filter.values.map(&:std_method_id).compact.uniq).index_by(&:id) %>
                      <% candidate_annots = candidate_annots.select do |annot|
                           run = h_runs_for_filter[annot.run_id] || @h_runs[annot.run_id]
                           next true unless run&.std_method_id
                           std_method = h_std_methods_for_filter[run.std_method_id]
                           next true unless std_method
                           source_step = h_steps_by_id[run.step_id]
                           next true unless source_step
                           step_name = source_step.name
                           if source_methods_filter.present? && source_methods_filter[step_name].present?
                             next source_methods_filter[step_name].include?(std_method.name)
                           end
                           if excluded_source_methods_filter.present? && excluded_source_methods_filter[step_name].present?
                             next !excluded_source_methods_filter[step_name].include?(std_method.name)
                           end
                           true
                         end %>
                    <% end %>
                    <% matching_annots = candidate_annots.select do |annot|
                         next false if annot.data_class_ids.blank?
                         annot_data_class_names = annot.data_class_ids.split(',').map { |dc_id| h_data_classes[dc_id.to_i] }.compact
                         attr['valid_types'].all? do |or_group|
                           Array(or_group).any? { |valid_type| annot_data_class_names.include?(valid_type) }
                         end
                       end %>
                    <% min_items = attr['min_nber_items'] || 0 %>
                    <% max_items = attr['max_nber_items'] %>
                    <% is_multiple = attr['req_data_structure'] == 'array' && (max_items.nil? || max_items > 1) %>
                    <% initial_hidden_value = if attr_val.present?
                                               attr_val.is_a?(String) ? attr_val : attr_val.to_json
                                             else
                                               ''
                                             end %>
                    <% annot_run_ids = matching_annots.flat_map { |a| [a.run_id, a.ori_run_id, a.store_run_id] }.compact.uniq %>
                    <% h_runs_by_id = Run.where(id: annot_run_ids).index_by(&:id) %>
                    <% input_data_dropdown_placeholder = (attr['dropdown_placeholder'].presence || attr['placeholder'].presence) %>
                    <% input_data_dropdown_text = input_data_dropdown_placeholder.presence || "-- Select #{attr['label'] || attr_name.humanize} --" %>

                    <% if matching_annots.any? %>
                      <div class="input_data_widget relative"
                           data-controller="input-data-selector"
                           data-input-data-selector-attr-name-value="<%= attr_name %>"
                           data-input-data-selector-is-array-value="<%= attr['req_data_structure'] == 'array' ? 'true' : 'false' %>"
                           data-input-data-selector-min-items-value="<%= min_items %>"
                           data-input-data-selector-max-items-value="<%= max_items || '' %>"
                           data-input-data-selector-is-multiple-value="<%= is_multiple ? 'true' : 'false' %>"
                           data-input-data-selector-dropdown-placeholder-value="<%= h(input_data_dropdown_placeholder.to_s) %>"
                           data-input-data-selector-selected-loom-file-value="<%= h((defined?(@selected_loom_file) && @selected_loom_file).to_s) %>">
                        <button type="button"
                                data-input-data-selector-target="dropdownButton"
                                data-action="click->input-data-selector#toggleDropdown"
                                class="w-full rounded-md border border-gray-300 px-3 py-2 text-left shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 bg-white flex items-center justify-between">
                          <span class="text-gray-500" data-input-data-selector-target="dropdownText"><%= input_data_dropdown_text %></span>
                          <span class="ml-2 text-gray-400">▼</span>
                        </button>
                        <div data-input-data-selector-target="dropdownMenu"
                             class="hidden absolute z-50 top-full left-0 w-full max-h-96 overflow-auto rounded-md border border-gray-300 bg-white shadow-lg">
                          <div class="py-1">
                            <% matching_annots.each do |annot| %>
                              <% run_id = annot.run_id || annot.ori_run_id || annot.store_run_id %>
                              <% run = run_id ? (@h_runs[run_id] || h_runs_by_id[run_id]) : nil %>
                              <% step = if annot.sim_step_id && h_steps_by_id[annot.sim_step_id]
                                          h_steps_by_id[annot.sim_step_id]
                                        elsif run
                                          h_steps_by_id[run.step_id]
                                        else
                                          h_steps_by_id[annot.step_id] || h_steps_by_id[annot.ori_step_id]
                                        end %>
                              <% categories = Basic.safe_parse_json(annot.categories_json, {}) %>
                              <% annot_data_class_names = annot.data_class_ids.to_s.split(',').map { |dc_id| h_data_classes[dc_id.to_i] }.compact %>
                              <% is_count_dataset = annot_data_class_names.include?('int_matrix') %>
                              <% from_asap_pipeline = !annot.imported %>
                              <% data_hash = {
                                   run_id: run_id,
                                   annot_id: annot.id,
                                   output_filename: annot.filepath,
                                   output_dataset: annot.name,
                                   output_attr_name: annot.attr_name,
                                   categories: categories,
                                   is_count: is_count_dataset,
                                   nber_rows: annot.nber_rows,
                                   nber_cols: annot.nber_cols,
                                   imported: annot.imported,
                                   from_asap_pipeline: from_asap_pipeline,
                                   step_name: step&.name,
                                   step_rank: step&.rank
                                 } %>
                              <% data_value = data_hash.to_json %>
                              <% display_label = [step&.label.presence || step&.name&.humanize, annot.display_name].compact.join(' - ') %>
                              <label class="flex items-start px-4 py-3 hover:bg-gray-50 cursor-pointer border-b border-gray-100 last:border-b-0"
                                     data-run-id="<%= run_id %>"
                                     data-annot-id="<%= annot.id %>"
                                     data-data-value="<%= data_value.to_json %>">
                                <input type="<%= is_multiple ? 'checkbox' : 'radio' %>"
                                       name="attrs_<%= attr_name %>_options"
                                       value="<%= data_value %>"
                                       class="mt-1 mr-3 h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
                                       data-input-data-selector-target="option"
                                       data-action="change->input-data-selector#optionChanged">
                                <div class="flex-1">
                                  <div class="font-medium text-gray-900"><%= display_label %></div>
                                  <div class="text-sm text-gray-600 mt-1">
                                    <span class="inline-block mr-3"><strong>Dataset:</strong> <%= annot.name %></span>
                                    <% if annot.nber_cats.to_i > 0 %>
                                      <span class="inline-block mr-3"><strong>Categories:</strong> <%= annot.nber_cats %></span>
                                    <% end %>
                                    <% if annot.filepath.present? %>
                                      <span class="inline-block text-gray-500 text-xs"><%= annot.filepath %></span>
                                    <% end %>
                                  </div>
                                </div>
                              </label>
                            <% end %>
                          </div>
                        </div>

                        <div data-input-data-selector-target="selectedDiv" class="mt-2 space-y-1 hidden"></div>
                        <%= hidden_field_tag form_attr_name, initial_hidden_value, { id: "attrs_#{attr_name}", data: { 'input-data-selector-target': 'hiddenField' } } %>
                      </div>
                    <% else %>
                      <% step_hint = attr['source_steps'].present? ? attr['source_steps'].to_sentence : 'the upstream steps' %>
                      <% if candidate_annots.empty? %>
                        <p class="text-sm italic text-gray-500">No metadata is available yet. Complete <%= step_hint %> first.</p>
                      <% else %>
                        <p class="text-sm italic text-gray-500">No metadata matches this field's requirements (expected data types are not present on datasets from <%= step_hint %>).</p>
                      <% end %>
                    <% end %>
                  <% else %>
                    <input type="text" id="attrs_<%= attr_name %>" name="<%= form_attr_name %>" 
                           value="<%= scalar_value_for_field %>" 
                           placeholder="<%= attr['placeholder'] || '' %>"
                           class="w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900">
                  <% end %>
                  
                <% when 'textfield' %>
                  <input type="text" id="attrs_<%= attr_name %>" name="<%= form_attr_name %>" 
                         value="<%= scalar_value_for_field %>" 
                         placeholder="<%= attr['placeholder'] || '' %>"
                         class="w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900">
                  <% if attr['description'].present? %>
                    <p class="mt-1 text-xs text-gray-500"><%= attr['description'] %></p>
                  <% end %>
                  
                <% when 'hidden' %>
                  <%= hidden_field_tag form_attr_name, scalar_value_for_field %>
                  
                <% when 'checkbox' %>
                  <div class="flex items-center">
                    <%= check_box_tag "checkbox-#{attr_name}", 'true', 
                        ((attr_val && attr_val != false) || (!attr_val && attr['default'] != false)),
                        { class: 'rounded border-gray-300 text-gray-900 focus:ring-gray-900 std_form_checkbox',
                          id: "checkbox-#{attr_name}" } %>
                    <%= hidden_field_tag form_attr_name, 
                        ((attr_val && attr_val != false) || (!attr_val && attr['default'] != false)) ? 'true' : 'false',
                        { id: "attrs_#{attr_name}" } %>
                    <label for="checkbox-<%= attr_name %>" class="ml-2 text-sm text-gray-700">
                      <%= raw(attr['label'] || attr_name.humanize) %>
                      <%= raw(render_constraint_badges.call(attr_name, attr)) %>
                    </label>
                  </div>
                  <% if attr['description'].present? %>
                    <p class="mt-1 ml-6 text-xs text-gray-500"><%= attr['description'] %></p>
                  <% end %>
                  
                <% when 'select' %>
                  <% l = [] %>
                  <% if attr['min_val'] && attr['max_val'] %>
                    <% l = (attr['min_val']..attr['max_val']).to_a.map { |e| [e.to_s, e.to_s] } %>
                  <% elsif attr['list'] %>
                    <% l = attr['list'] %>
                  <% end %>
                  <% l.unshift([attr['null_name'] || "None", '']) unless attr['not_null'] %>
                  <%= select_tag form_attr_name, 
                      options_for_select(l, scalar_value_for_field), 
                      { class: 'w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 bg-white',
                        id: "attrs_#{attr_name}" } %>
                  <% if attr['description'].present? %>
                    <p class="mt-1 text-xs text-gray-500"><%= attr['description'] %></p>
                  <% end %>

                <% when 'input_gene_set_item' %>
                  <div class="gene_set_item_widget relative"
                       data-controller="gene-set-item-selector"
                       data-gene-set-item-selector-project-id-value="<%= @project.id %>"
                       data-gene-set-item-selector-attr-name-value="<%= attr_name %>"
                       data-gene-set-item-selector-collection-attr-name-value="global_gene_set_collection_id"
                       data-gene-set-item-selector-matrix-attr-name-value="input_matrix">
                    <input type="text"
                           id="search_<%= attr_name %>"
                           data-gene-set-item-selector-target="searchInput"
                           data-action="input->gene-set-item-selector#searchInputChanged focus->gene-set-item-selector#searchInputChanged"
                           value=""
                           placeholder="<%= attr['placeholder'].presence || 'Search gene sets...' %>"
                           autocomplete="off"
                           class="w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900">
                    <div data-gene-set-item-selector-target="selectedDisplay"
                         class="mt-2 text-sm text-gray-700 hidden"></div>
                    <div data-gene-set-item-selector-target="results"
                         class="hidden absolute z-50 top-full left-0 w-full max-h-64 overflow-auto rounded-md border border-gray-300 bg-white shadow-lg mt-1"></div>
                    <%= hidden_field_tag form_attr_name, scalar_value_for_field, { id: "attrs_#{attr_name}", data: { 'gene-set-item-selector-target': 'hiddenField' } } %>
                  </div>
                  <% if attr['description'].present? %>
                    <p class="mt-1 text-xs text-gray-500"><%= attr['description'] %></p>
                  <% end %>
                  
                <% else %>
                  <%# Default: text field %>
                  <input type="text" id="attrs_<%= attr_name %>" name="<%= form_attr_name %>" 
                         value="<%= scalar_value_for_field %>" 
                         placeholder="<%= attr['placeholder'] || '' %>"
                         class="w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900">
                <% end %>
                
                <div id="validation_<%= attr_name %>" class="text-xs text-red-600 mt-1"></div>
                </div>
              </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
      </div>
    </div>
  <% end %>
</div>

<script>
  // Handle checkbox changes
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.std_form_checkbox').forEach(function(checkbox) {
      checkbox.addEventListener('change', function() {
        var attrName = this.id.replace('checkbox-', '');
        var hiddenField = document.getElementById('attrs_' + attrName);
        if (hiddenField) {
          hiddenField.value = this.checked ? 'true' : 'false';
        }
      });
    });
  });
</script>

