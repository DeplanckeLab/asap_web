<% if @step %>
  <div class="step-results h-full flex flex-col" 
       data-controller="slide-in-form"
       data-slide-in-form-form-url-value="<%= step_results_project_path(@project, step_id: @step.id, show_form: 1, format: :html) %>"
       data-slide-in-form-step-id-value="<%= @step.id %>"
       data-slide-in-form-project-id-value="<%= @project.id %>"
       data-step-id="<%= @step.id %>"
       data-project-id="<%= @project.id %>">
    <% unless @show_form %>
    <!-- Step Results Section -->
    <% if @step.has_std_view && @step.name == 'parsing' %>
      <!-- Render parsing-specific view -->
      <%= render 'projects/views/parsing' %>
    <% end %>
    <% end %>
    
    <!-- Standard Form (when no runs exist) -->
    <% if @show_form %>
      <%= render 'projects/views/std_form' %>
    <% end %>
    
    <% unless @show_form %>
    <!-- Custom Form (when std_form is false for single-run steps) -->
    <% if @show_custom_form %>
      <% custom_form_partial = "projects/views/#{@step.name}_form" %>
      <% begin %>
        <%= render custom_form_partial %>
      <% rescue ActionView::MissingTemplate => e %>
        <!-- Custom form partial not found: <%= custom_form_partial %> -->
      <% end %>
    <% end %>
    
    <!-- Standard Dashboard (for multiple runs) -->
    <% if @show_dashboard %>
      <%= render 'projects/views/std_dashboard' %>
    <% end %>
    
    <!-- Standard Run View (for single run) -->
    <% if @show_view %>
      <div class="bg-white rounded-lg shadow-sm flex flex-col" id="result_summary" style="max-height: calc(100vh - 200px); overflow-y: auto;">
        <div class="border-b border-gray-200 px-6 py-4 sticky top-0 z-10 flex-shrink-0" style="background: linear-gradient(to right, #eff6ff, #eef2ff); background-color: #ffffff;">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
              <%= @step.label.presence || @step.name %> results
            </h3>
            <div class="flex items-center gap-3">
              <!-- New Run Button -->
              <% if @step.has_std_form && @step.multiple_runs %>
                <button type="button" 
                        class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-medium transition-colors cursor-pointer" 
                        data-action="click->slide-in-form#open"
                        style="flex-shrink: 0;">
                  + New run
                </button>
              <% end %>
              <!-- Restart Button -->
              <% if @project_step && @step && !@step.multiple_runs && (@project_step.status_id == 3 || @project_step.status_id == 4) %>
                <button type="button" 
                        class="px-4 py-2 bg-orange-600 hover:bg-orange-700 text-white rounded-md font-medium transition-colors cursor-pointer" 
                        data-controller="restart-step"
                        data-restart-step-project-id-value="<%= @project.id %>"
                        data-restart-step-step-id-value="<%= @step.id %>"
                        data-restart-step-restart-url-value="<%= restart_step_project_path(@project) %>"
                        data-action="click->restart-step#restart"
                        style="flex-shrink: 0;">
                  Restart
                </button>
              <% end %>
            </div>
          </div>
        </div>
        <div class="px-6 py-5 space-y-6 flex-1">
          <%= render 'projects/views/std_run_view' %>
        </div>
      </div>
    <% end %>
    
    <!-- Debug info: Show what display mode is active -->
    <% if @show_dashboard || @show_view || @show_form || @show_custom_form %>
      <div class="mb-3">
        <div class="alert alert-secondary">
          <strong>Step Configuration:</strong> multiple_runs=<%= @step.multiple_runs %>, has_std_view=<%= @step.has_std_view %>, has_std_dashboard=<%= @step.has_std_dashboard %>, has_std_form=<%= @step.has_std_form %> | 
          <strong>Display Flags:</strong> show_dashboard=<%= @show_dashboard %>, show_view=<%= @show_view %>, show_form=<%= @show_form %>, show_custom_form=<%= @show_custom_form %> | 
          <strong>Runs:</strong> <%= @runs ? @runs.size : 0 %>
        </div>
      </div>
    <% end %>

    <!-- Runs Section (fallback if no standard dashboard/view) -->
    <% unless @show_dashboard || @show_view %>
      <div class="bg-white rounded-lg shadow-sm flex flex-col" style="max-height: calc(100vh - 200px); overflow-y: auto;">
        <div class="border-b border-gray-200 px-6 py-4 sticky top-0 z-10 flex-shrink-0" style="background: linear-gradient(to right, #eff6ff, #eef2ff); background-color: #ffffff;">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
              <%= @step.label.presence || @step.name %> results
            </h3>
            <div class="flex items-center gap-3">
              <!-- New Run Button -->
              <% if @step.has_std_form && @step.multiple_runs %>
                <button type="button" 
                        class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-medium transition-colors cursor-pointer" 
                        data-action="click->slide-in-form#open"
                        style="flex-shrink: 0;">
                  + New run
                </button>
              <% end %>
            </div>
          </div>
        </div>
        <div class="flex-1 flex flex-col min-h-0">
        
        <% if @runs.any? %>
          <%# Load std_methods for method labels %>
          <% unless defined?(@h_std_methods) && @h_std_methods %>
            <% std_method_ids = @runs.map(&:std_method_id).compact.uniq %>
            <% @h_std_methods = {} %>
            <% StdMethod.where(id: std_method_ids).each { |m| @h_std_methods[m.id] = m } if std_method_ids.any? %>
          <% end %>
          
          <%# Pre-load annots and their associated runs/steps for dataset parameters %>
          <% unless defined?(@h_annots_for_params) && @h_annots_for_params %>
            <% @h_annots_for_params = {} %>
            <% @h_ori_runs_for_params = {} %>
            <% @h_steps_for_params = {} %>
            <% annot_ids = [] %>
            <% @runs.each do |run| %>
              <% h_attrs = run.attrs_json.present? ? Basic.safe_parse_json(run.attrs_json, {}) : {} %>
              <% h_attrs.each_value do |v| %>
                <% if v.is_a?(Hash) && (v['annot_id'].present? || v[:annot_id].present?) %>
                  <% annot_ids << (v['annot_id'] || v[:annot_id]) %>
                <% elsif v.is_a?(Array) %>
                  <% v.each do |item| %>
                    <% if item.is_a?(Hash) && (item['annot_id'].present? || item[:annot_id].present?) %>
                      <% annot_ids << (item['annot_id'] || item[:annot_id]) %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
            <% if annot_ids.any? %>
              <% Annot.where(id: annot_ids.uniq).each do |annot| %>
                <% @h_annots_for_params[annot.id] = annot %>
                <% if annot.ori_run_id.present? && !@h_ori_runs_for_params[annot.ori_run_id] %>
                  <% ori_run = Run.find_by(id: annot.ori_run_id) %>
                  <% if ori_run %>
                    <% @h_ori_runs_for_params[annot.ori_run_id] = ori_run %>
                    <% if ori_run.step_id.present? && !@h_steps_for_params[ori_run.step_id] %>
                      <% step = Step.find_by(id: ori_run.step_id) %>
                      <% @h_steps_for_params[ori_run.step_id] = step if step %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
          
          <div class="flex-1 min-h-0 px-6 pb-5 overflow-x-auto">
            <table class="w-full divide-y divide-gray-200 bg-white" style="table-layout: auto;">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-16">#</th>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Method</th>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Parameters</th>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-24">Status</th>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-32">Created</th>
                  <th scope="col" class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider w-32">Actions</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @runs.each do |run| %>
                  <% run_status = case run.status_id
                                  when 1 then { name: 'waiting', class: 'warning', bg: 'bg-yellow-100', text: 'text-yellow-800' }
                                  when 2 then { name: 'running', class: 'info', bg: 'bg-blue-100', text: 'text-blue-800' }
                                  when 3 then { name: 'complete', class: 'success', bg: 'bg-green-100', text: 'text-green-800' }
                                  when 4 then { name: 'failed', class: 'danger', bg: 'bg-red-100', text: 'text-red-800' }
                                  else { name: 'unknown', class: 'secondary', bg: 'bg-gray-100', text: 'text-gray-800' }
                                  end %>
                  <% std_method = (@h_std_methods && run.std_method_id) ? @h_std_methods[run.std_method_id] : nil %>
                  <% method_label = std_method ? (std_method.label.presence || std_method.name.presence || 'N/A') : 'N/A' %>
                  <%# Parse run attributes for parameters %>
                  <% h_run_attrs = run.attrs_json.present? ? Basic.safe_parse_json(run.attrs_json, {}) : {} %>
                  <% params_array = h_run_attrs.to_a %>
                  <% params_display = params_array.map { |k, v| "#{k}: #{v}" }.join(", ") %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-3 py-4 whitespace-nowrap">
                      <div class="text-sm font-semibold text-gray-900">#<%= run.num || run.id %></div>
                      <% if admin? %>
                        <div class="text-xs text-gray-500 font-mono" style="font-size: 0.7rem;"><%= run.id %></div>
                      <% end %>
                    </td>
                    <td class="px-3 py-4" style="max-width: 0;">
                      <div class="text-sm text-gray-900 truncate" title="<%= method_label %>" style="width: 100%;"><%= method_label %></div>
                    </td>
                    <td class="px-3 py-4">
                      <% if params_array.any? %>
                        <div class="flex flex-wrap gap-1.5 items-center" title="<%= params_display %>" data-run-params-container="<%= run.id %>" data-controller="run-params-toggle">
                          <% max_visible = 3 %>
                          <% params_array.each_with_index do |(key, value), index| %>
                            <% is_hidden = index >= max_visible %>
                            <span class="<%= is_hidden ? 'hidden' : '' %> run-param-badge" data-run-id="<%= run.id %>">
                              <%# Check if value is a dataset (annot object) or array of datasets %>
                              <% annot_id = nil %>
                              <% if value.is_a?(Hash) %>
                                <% annot_id = value['annot_id'] || value[:annot_id] %>
                              <% end %>
                              <% if annot_id.present? %>
                                <% annot = @h_annots_for_params[annot_id] if defined?(@h_annots_for_params) %>
                                <% if annot %>
                                  <% ori_run = @h_ori_runs_for_params[annot.ori_run_id] if annot.ori_run_id.present? && defined?(@h_ori_runs_for_params) %>
                                  <% ori_step = (ori_run && ori_run.step_id && defined?(@h_steps_for_params) && @h_steps_for_params[ori_run.step_id]) ? @h_steps_for_params[ori_run.step_id] : nil %>
                                  <% step_name = ori_step ? (ori_step.label.presence || ori_step.name.presence || 'N/A') : 'N/A' %>
                                  <% if ori_step && ori_step.multiple_runs && ori_run %>
                                    <% run_num = ori_run.num || ori_run.id %>
                                    <% dataset_display = "#{step_name} ##{run_num} #{annot.name}" %>
                                  <% else %>
                                    <% dataset_display = "#{step_name} #{annot.name}" %>
                                  <% end %>
                                  <% truncated_dataset = dataset_display.length > 30 ? dataset_display[0..26] + "..." : dataset_display %>
                                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700 border border-blue-200">
                                    <span class="font-semibold text-blue-800"><%= key %>:</span>
                                    <span class="ml-1 text-blue-600" title="<%= dataset_display %>"><%= truncated_dataset %></span>
                                  </span>
                                <% else %>
                                  <% value_str = value.to_json %>
                                  <% truncated_value = value_str.length > 20 ? value_str[0..16] + "..." : value_str %>
                                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200">
                                    <span class="font-semibold text-gray-800"><%= key %>:</span>
                                    <span class="ml-1 text-gray-600"><%= truncated_value %></span>
                                  </span>
                                <% end %>
                              <% elsif value.is_a?(Array) && value.any? && value.first.is_a?(Hash) %>
                                <%# Array of datasets - show first dataset and count %>
                                <% first_annot_id = value.first['annot_id'] || value.first[:annot_id] %>
                                <% if first_annot_id.present? %>
                                  <% first_annot = @h_annots_for_params[first_annot_id] if defined?(@h_annots_for_params) %>
                                  <% if first_annot %>
                                    <% ori_run = @h_ori_runs_for_params[first_annot.ori_run_id] if first_annot.ori_run_id.present? && defined?(@h_ori_runs_for_params) %>
                                    <% ori_step = (ori_run && ori_run.step_id && defined?(@h_steps_for_params) && @h_steps_for_params[ori_run.step_id]) ? @h_steps_for_params[ori_run.step_id] : nil %>
                                    <% step_name = ori_step ? (ori_step.label.presence || ori_step.name.presence || 'N/A') : 'N/A' %>
                                    <% if ori_step && ori_step.multiple_runs && ori_run %>
                                      <% run_num = ori_run.num || ori_run.id %>
                                      <% dataset_display = "#{step_name} ##{run_num} #{first_annot.name}" %>
                                    <% else %>
                                      <% dataset_display = "#{step_name} #{first_annot.name}" %>
                                    <% end %>
                                    <% array_display = value.size > 1 ? "#{dataset_display} (+#{value.size - 1} more)" : dataset_display %>
                                    <% truncated_array = array_display.length > 30 ? array_display[0..26] + "..." : array_display %>
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700 border border-blue-200">
                                      <span class="font-semibold text-blue-800"><%= key %>:</span>
                                      <span class="ml-1 text-blue-600" title="<%= array_display %>"><%= truncated_array %></span>
                                    </span>
                                  <% else %>
                                    <% value_str = "[#{value.size} datasets]" %>
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200">
                                      <span class="font-semibold text-gray-800"><%= key %>:</span>
                                      <span class="ml-1 text-gray-600"><%= value_str %></span>
                                    </span>
                                  <% end %>
                                <% else %>
                                  <% value_str = value.to_s %>
                                  <% truncated_value = value_str.length > 20 ? value_str[0..16] + "..." : value_str %>
                                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200">
                                    <span class="font-semibold text-gray-800"><%= key %>:</span>
                                    <span class="ml-1 text-gray-600"><%= truncated_value %></span>
                                  </span>
                                <% end %>
                              <% else %>
                                <% value_str = value.to_s %>
                                <% truncated_value = value_str.length > 20 ? value_str[0..16] + "..." : value_str %>
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200">
                                  <span class="font-semibold text-gray-800"><%= key %>:</span>
                                  <span class="ml-1 text-gray-600"><%= truncated_value %></span>
                                </span>
                              <% end %>
                            </span>
                          <% end %>
                          <% if params_array.size > max_visible %>
                            <button type="button" 
                                    class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-200 text-gray-600 border border-gray-300 hover:bg-gray-300 cursor-pointer transition-colors run-params-more-btn" 
                                    data-run-id="<%= run.id %>"
                                    data-action="click->run-params-toggle#toggle">
                              +<%= params_array.size - max_visible %> more
                            </button>
                          <% end %>
                        </div>
                      <% else %>
                        <span class="text-gray-400 text-xs">-</span>
                      <% end %>
                    </td>
                    <td class="px-3 py-4 whitespace-nowrap">
                      <div class="flex flex-col gap-1">
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= run_status[:bg] %> <%= run_status[:text] %>">
                          <%= run_status[:name].humanize %>
                        </span>
                        <%# Duration/Timer below status %>
                        <% if run.status_id == 3 && run.duration %>
                          <%# Completed: show duration %>
                          <div class="text-xs text-gray-500 mt-0.5">
                            <i class="fas fa-clock text-gray-400 mr-1"></i>
                            <span><%= duration(run.duration.to_i) %></span>
                          </div>
                        <% elsif run.status_id == 2 && run.start_time %>
                          <%# Running: show live timer %>
                          <div class="text-xs text-gray-500 mt-0.5"
                               data-controller="run-timer"
                               data-run-timer-start-time-value="<%= run.start_time.iso8601 %>">
                            <i class="fas fa-clock text-gray-400 mr-1"></i>
                            <span data-run-timer-target="elapsedTime">--:--</span>
                          </div>
                        <% elsif run.status_id == 1 %>
                          <%# Waiting: show waiting timer and queue position %>
                          <div class="text-xs text-gray-500 mt-0.5 space-y-0.5">
                            <% if run.submitted_at %>
                              <div data-controller="run-timer"
                                   data-run-timer-submitted-at-value="<%= run.submitted_at.iso8601 %>">
                                <i class="fas fa-clock text-gray-400 mr-1"></i>
                                <span data-run-timer-target="elapsedTime">--:--</span>
                              </div>
                            <% end %>
                            <% if run.slurm_job_id %>
                              <div data-controller="queue-position"
                                   data-queue-position-run-id-value="<%= run.id %>"
                                   data-queue-position-slurm-job-id-value="<%= run.slurm_job_id %>"
                                   data-queue-position-project-id-value="<%= @project.id %>"
                                   <% if run.submitted_at %>
                                     data-queue-position-submitted-at-value="<%= run.submitted_at.iso8601 %>"
                                   <% end %>>
                                <span class="text-gray-400">Queue: </span>
                                <span data-queue-position-target="position" class="font-mono text-xs">
                                  <i class="fas fa-spinner fa-spin"></i>
                                </span>
                              </div>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    </td>
                    <td class="px-3 py-4 whitespace-nowrap">
                      <div class="text-xs text-gray-900">
                        <% if run.created_at %>
                          <%= run.created_at.strftime("%Y-%m-%d<br>%H:%M").html_safe %>
                        <% else %>
                          <span class="text-gray-400">N/A</span>
                        <% end %>
                      </div>
                    </td>
                    <td class="px-3 py-4 whitespace-nowrap text-right text-sm font-medium">
                      <div class="flex items-center justify-end gap-1.5">
                        <%= link_to run_path(run), class: 'inline-flex items-center px-2 py-1 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500', title: 'View' do %>
                          <i class="fas fa-eye"></i>
                        <% end %>
                        <% if editable?(@project) %>
                          <%= button_to run_path(run, format: :json), 
                              method: :delete,
                              remote: true,
                              form: {
                                data: {
                                  controller: 'delete-run',
                                  action: 'submit->delete-run#deleteRun',
                                  'delete-run-step-id-value': @step.id,
                                  'delete-run-run-num-value': (run.num || run.id).to_s
                                }
                              },
                              class: 'inline-flex items-center px-2 py-1 border border-red-300 shadow-sm text-xs font-medium rounded text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500', 
                              title: 'Delete' do %>
                            <i class="fas fa-trash"></i>
                          <% end %>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="flex-1 flex items-center justify-center">
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 text-center">
              <i class="fas fa-info-circle text-blue-600 mb-2"></i>
              <p class="text-blue-800 mb-0">No runs found for this step.</p>
            </div>
          </div>
        <% end %>
          </div>
        </div>
      </div>
    <% end %>
    <% end %>
    
    <!-- Slide-in Form Panel -->
    <div data-slide-in-form-target="overlay" 
         class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden transition-opacity duration-300"
         data-action="click->slide-in-form#overlayClick"
         style="display: none;"></div>
    
    <div data-slide-in-form-target="panel" 
         class="fixed top-0 right-0 h-full w-full max-w-2xl bg-white shadow-2xl z-50 hidden overflow-y-auto transition-transform duration-300 ease-out"
         style="display: none; transform: translateX(100%);">
      <div class="sticky top-0 bg-white border-b border-gray-200 px-6 py-4 z-10 flex items-center justify-between" style="background: linear-gradient(to right, #eff6ff, #eef2ff); background-color: #ffffff;">
        <h3 class="text-lg font-semibold text-gray-900">
          New <%= @step.label.presence || @step.name.humanize %>
        </h3>
        <button type="button" 
                class="text-gray-500 hover:text-gray-700 transition-colors"
                data-action="click->slide-in-form#close">
          <i class="fas fa-times text-xl"></i>
        </button>
      </div>
      <div data-slide-in-form-target="content" class="p-6">
        <!-- Form content will be loaded here -->
      </div>
    </div>
  </div>

<% else %>
  <div class="alert alert-warning">
    <i class="fas fa-exclamation-triangle me-2"></i>Step not found.
  </div>
<% end %>

<script>
  // Fallback handler for run params toggle
  (function() {
    var buttonsSetup = new WeakSet()
    
    function setupRunParamsToggle() {
      document.querySelectorAll('.run-params-more-btn').forEach(function(button) {
        // Skip if already setup
        if (buttonsSetup.has(button)) return
        buttonsSetup.add(button)
        
        button.addEventListener('click', function(event) {
          // Let Stimulus handle it first if it's connected
          // This will still fire but Stimulus should handle it
          event.stopPropagation()
          
          const runId = this.getAttribute('data-run-id')
          if (!runId) return
          
          const container = this.closest('[data-run-params-container]')
          if (!container) return
          
          const allBadges = Array.from(container.querySelectorAll('.run-param-badge[data-run-id="' + runId + '"]'))
          const hiddenBadges = allBadges.filter(function(badge) {
            return badge.classList.contains('hidden')
          })
          const maxVisible = 3
          
          if (hiddenBadges.length === 0) {
            // All parameters are visible, hide the ones beyond max_visible
            allBadges.forEach(function(badge, index) {
              if (index >= maxVisible) {
                badge.classList.add('hidden')
              }
            })
            const hiddenCount = allBadges.length - maxVisible
            this.textContent = hiddenCount > 0 ? '+' + hiddenCount + ' more' : ''
          } else {
            // Show all hidden parameters
            hiddenBadges.forEach(function(badge) {
              badge.classList.remove('hidden')
            })
            this.textContent = 'Show less'
          }
        })
      })
    }
    
    // Setup when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupRunParamsToggle)
    } else {
      setupRunParamsToggle()
    }
    
    // Also setup after delays in case content loads dynamically
    setTimeout(setupRunParamsToggle, 500)
    setTimeout(setupRunParamsToggle, 1000)
    
    // Use MutationObserver to catch dynamically added content
    if (typeof MutationObserver !== 'undefined') {
      var observer = new MutationObserver(function(mutations) {
        setupRunParamsToggle()
      })
      
      observer.observe(document.body, {
        childList: true,
        subtree: true
      })
    }
  })()
</script>

