<style>
:root {
/* Tier 1: Card & Section Titles - Scales from ~14px to ~22px */
--font-size-title: clamp(0.875rem, 1.2vw, 1.375rem);
/* Tier 2: Hero Numbers - Scales from ~28px to ~60px */
--font-size-hero: clamp(1.75rem, 4.5vw, 3.75rem);
/* Tier 3: General Body Text - Scales from ~13px to ~17px */
--font-size-body: clamp(0.8125rem, 0.9vw, 1.0625rem);
}

.adaptive-dashboard {
font-size: var(--font-size-body);
line-height: 1.5;
}

.dashboard-card-title {
font-size: var(--font-size-title) !important;
font-weight: 600;
}

.hero-stat {
font-size: var(--font-size-hero) !important;
line-height: 1;
font-weight: 700;
}

/* Ensure all standard elements follow the 3-tier scaling rules */
.adaptive-dashboard .text-xs,
.adaptive-dashboard .text-sm,
.adaptive-dashboard table,
.adaptive-dashboard p,
.adaptive-dashboard span:not(.hero-stat):not(.dashboard-card-title):not(.badge-text) {
font-size: inherit;
}

.adaptive-dashboard i { font-size: 1.1em; }
.adaptive-dashboard .badge-text { font-size: 0.82em; }
</style>

<%
  can_edit_project_title = editable?(@project) && !@project.public?
  summary_run_counts = project_run_counts(@project)
  summary_total_runs = summary_run_counts.values.sum
  summary_loom_file_count = @summary_loom_file_count || 0
  summary_loom_content_counts = @summary_loom_content_counts || { matrices: 0, col_attrs: 0, row_attrs: 0, global: 0 }
  summary_shared_users_count = @summary_shared_users_count || 0
  summary_embedding_count = @summary_embedding_count || 0
  summary_visual_annotation_count = @summary_visual_annotation_count || 0
  summary_visual_vote_count = @summary_visual_vote_count || 0
  summary_run_user_count = @summary_run_user_count || 0
  summary_checkpoint_count = @summary_checkpoint_count || 0
  summary_checkpoint_comment_count = @summary_checkpoint_comment_count || 0
  summary_compliance_schema_count = @project.compliance_schemas.size
  summary_compliance_result = @project.cxg_validation_result
  summary_compliance_valid = summary_compliance_result.present? ? summary_compliance_result['valid'] : nil
  summary_compliance_schema_config = @project.compliance_schemas.first&.to_config_hash
  summary_compliance_schema_name = summary_compliance_schema_config&.dig('name') || @project.compliance_schemas.first&.name || 'Schema'
  summary_compliance_schema_version = summary_compliance_result&.dig('schema_version') || summary_compliance_schema_config&.dig('version')
  summary_compliant_icon = summary_compliance_result&.dig('compliant_icon') || summary_compliance_schema_config&.dig('compliant_icon')
  summary_not_compliant_icon = summary_compliance_result&.dig('not_compliant_icon') || summary_compliance_schema_config&.dig('not_compliant_icon')
  summary_compliance_logo_icon = summary_compliant_icon || summary_not_compliant_icon
  summary_publication_count = @project.doi.to_s.split(/\s*,\s*/).reject(&:blank?).size
  summary_external_identifier_count = @h_exp_entries.present? ? @h_exp_entries.values.flatten.size : 0
  summary_provider_source_count = @project.provider_projects.size
  summary_owner_email_part = @project.user&.email.to_s.split('@').first
  summary_owner_display = if current_user&.email.present? && @project.user&.email.present? && current_user.email.casecmp(@project.user.email).zero?
    'me'
  else
    summary_owner_email_part
  end
  # Archive-state guard: when the project is not in the unarchived state (or its
  # files are missing locally) the buttons that need to read from the project
  # directory must be disabled, and an explicit Unarchive call-to-action shown
  # at the top of the page. Database-backed information stays visible so that
  # bots and humans can always read the project metadata.
  summary_archive_availability_state = @project.archive_availability_state
  summary_archive_currently_unarchiving = summary_archive_availability_state == :unarchiving
  summary_archive_currently_archiving = summary_archive_availability_state == :archiving
  summary_archive_on_storage = summary_archive_availability_state == :archived
  summary_archive_data_missing = summary_archive_availability_state == :missing
  summary_archive_data_unavailable = summary_archive_availability_state != :available
  summary_archive_disabled_tooltip = if summary_archive_currently_unarchiving
    'Project files are being unarchived. Downloads will be available once the data is restored.'
  elsif summary_archive_currently_archiving
    'Project files are being archived. Downloads are disabled while the archive is being created.'
  elsif summary_archive_data_missing
    'Project files are missing on this server. Downloads are unavailable until the project data is restored.'
  else
    'Project files are archived. Click the Unarchive button at the top of this page to restore the data and enable downloads.'
  end
downloaded_from_sources = @project.provider_projects.filter_map do |pp|
provider = pp.provider
next unless provider
if provider.url_mask.present?
link_to provider.name, provider.url_mask.gsub('#{id}', pp.key.to_s), target: '_blank', class: "text-blue-600 hover:text-blue-800 hover:underline"
else
content_tag(:span, provider.name, class: "text-gray-700")
end
end
summary_parsing_attrs = begin JSON.parse(@project.parsing_attrs_json.to_s); rescue; {}; end
summary_integration_source_keys = Basic.integration_source_keys(summary_parsing_attrs)
summary_integration_projects_by_key = summary_integration_source_keys.any? ? Project.where(key: summary_integration_source_keys).index_by(&:key) : {}
summary_clone_lineage_projects = []
summary_clone_lineage_deleted_parent_id = nil
if @project.cloned_project_id.present?
summary_lineage_current = @project
summary_lineage_visited_ids = [@project.id]
summary_clone_lineage_projects << @project
while summary_lineage_current.cloned_project_id.present?
summary_parent_id = summary_lineage_current.cloned_project_id
break if summary_lineage_visited_ids.include?(summary_parent_id)
summary_lineage_parent = Project.find_by(id: summary_parent_id)
if summary_lineage_parent
summary_clone_lineage_projects << summary_lineage_parent
summary_lineage_visited_ids << summary_lineage_parent.id
summary_lineage_current = summary_lineage_parent
else 
 summary_clone_lineage_deleted_parent_id = summary_parent_id
 break
 end
end
end

summary_embedding_records = Annot.where(project_id: @project.id, nber_rows: 2).includes(:user, run: [:user, :step]).order(:filepath, :name).to_a
summary_checkpoint_records = @project.checkpoints.includes(:user).order(created_at: :desc).to_a
summary_checkpoint_comments = []
summary_checkpoint_records.each do |cp|
cp.comments.each do |c|
summary_checkpoint_comments << { checkpoint_title: cp.title, body: (c['body'] || c[:body] || c['comment']).to_s, user_name: (c['user_name'] || c[:user_name]).to_s, created_at: (c['created_at'] || c[:created_at]).to_s }
end
end
summary_cla_records = Cla.active.where(project_id: @project.id).includes(:annot, :cell_set, :user, :cla_source, :ontology_term_type).order(created_at: :desc).to_a
summary_annotation_type_options = summary_cla_records.group_by(&:ontology_term_type_id).map do |tid, clas|
  ott = clas.first&.ontology_term_type
  label = if tid.nil?
            'Unspecified'
          else
            ott&.label.presence || ott&.name.presence || "Type #{tid}"
          end
  { id: tid.nil? ? '' : tid.to_s, label: label, count: clas.length, tag: ott&.name.to_s }
end.sort_by { |e| [e[:id].blank? ? 1 : 0, e[:label].to_s.downcase] }
summary_default_annotation_type_id = summary_annotation_type_options.find { |e| e[:id].present? }&.dig(:id) ||
                                     summary_annotation_type_options.first&.dig(:id)
summary_annotation_metadata_by_type = {}
summary_cla_records.group_by { |cla| cla.ontology_term_type_id.nil? ? '' : cla.ontology_term_type_id.to_s }.each do |type_id, clas|
  metadata_entries = clas.group_by(&:annot_id).filter_map do |aid, type_clas|
    annot = type_clas.first&.annot
    next unless annot
    { id: aid.to_s, label: (annot.display_name.presence || annot.name.to_s), count: type_clas.length }
  end
  summary_annotation_metadata_by_type[type_id] = metadata_entries.sort_by { |e| e[:label].to_s.downcase }
end
summary_default_annotation_id = ''
summary_gene_info_by_id = @summary_gene_info_by_stable_id || {}
summary_gene_symbol_by_id = @summary_gene_symbol_by_id || {}
summary_cot_info_by_id = @summary_cot_info_by_id || {}
summary_cot_label_by_id = @summary_cot_label_by_id || {}
summary_search_gene_url = search_gene_project_path(@project)
%>
<div class="adaptive-dashboard" data-guided-tour="project-summary-dashboard">
<% if summary_archive_data_unavailable %>
  <div class="mb-4 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3"
       data-guided-tour="summary-archive-banner">
    <div class="flex items-start gap-3">
      <i class="fas fa-file-zipper text-amber-700 mt-1"></i>
      <div class="text-sm text-amber-900">
        <p class="font-semibold">
          <% if summary_archive_currently_unarchiving %>
            This project is currently being unarchived
          <% elsif summary_archive_currently_archiving %>
            This project is currently being archived
          <% elsif summary_archive_data_missing %>
            This project's data is unavailable on this server
          <% else %>
            This project's data is archived
          <% end %>
        </p>
        <p class="mt-1">
          <% if summary_archive_data_missing %>
            The information below is read from the database and is still available, but the project files are currently missing from local storage.
            Visualization, analysis, data, compliance, and file downloads stay unavailable until the project data is restored on the server.
          <% else %>
            The information below is read from the database and is always available.
            To open the visualization, analysis, data or compliance views, or to download project files, the project data must first be unarchived.
          <% end %>
        </p>
      </div>
    </div>
    <% if summary_archive_currently_unarchiving %>
      <span class="inline-flex items-center gap-2 px-3 py-2 rounded-md text-sm font-medium bg-amber-200 text-amber-900 cursor-not-allowed opacity-80"
            aria-disabled="true"
            title="Unarchive already in progress">
        <i class="fas fa-spinner fa-spin"></i>
        <span>Unarchiving...</span>
      </span>
    <% elsif summary_archive_currently_archiving %>
      <span class="inline-flex items-center gap-2 px-3 py-2 rounded-md text-sm font-medium bg-amber-200 text-amber-900 cursor-not-allowed opacity-80"
            aria-disabled="true"
            title="Archive currently being created; data files are not available">
        <i class="fas fa-spinner fa-spin"></i>
        <span>Archiving...</span>
      </span>
    <% elsif summary_archive_data_missing %>
      <span class="inline-flex items-center gap-2 px-3 py-2 rounded-md text-sm font-medium bg-amber-200 text-amber-900 cursor-not-allowed opacity-80"
            aria-disabled="true"
            title="Project files are missing locally and cannot be restored automatically">
        <i class="fas fa-triangle-exclamation"></i>
        <span>Data unavailable</span>
      </span>
    <% else %>
      <%= link_to project_path(@project, view: 'summary', force_unarchive: 1),
          class: "inline-flex items-center gap-2 px-3 py-2 rounded-md text-sm font-medium bg-amber-600 text-white hover:bg-amber-700 transition-colors",
          title: "Restore project files from the archive. The page will reload and show the unarchive progress.",
          data: { turbo: false, guided_tour: "summary-archive-unarchive-button" } do %>
        <i class="fas fa-box-open"></i>
        <span>Unarchive project</span>
      <% end %>
    <% end %>
  </div>
<% end %>
<div class="mb-4">
<h2 class="font-bold text-gray-900 mb-2" style="font-size: clamp(1.5rem, 3.5vw, 2.75rem);">Summary</h2>
</div>
<div class="space-y-4">
<%# Row 1: Metrics
    When Compliance is shown (editable projects): 2+3 from sm, then 5-across from lg (fits typical 13").
    Without Compliance: 2x2 from sm, then 4-across from lg. %>
<% summary_metrics_show_compliance = editable?(@project) %>
<% summary_metrics_grid_class = summary_metrics_show_compliance ? 'grid grid-cols-1 sm:grid-cols-6 lg:grid-cols-5 gap-3' : 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3' %>
<% summary_metrics_span_half = summary_metrics_show_compliance ? 'sm:col-span-3 lg:col-span-1' : '' %>
<% summary_metrics_span_third = summary_metrics_show_compliance ? 'sm:col-span-2 lg:col-span-1' : '' %>
<div class="<%= summary_metrics_grid_class %>">
<div class="block bg-gray-50 rounded-lg border border-gray-200 px-4 py-3 hover:border-blue-300 hover:bg-blue-50 transition-colors cursor-pointer <%= summary_metrics_show_compliance ? summary_metrics_span_half : 'sm:col-span-2 lg:col-span-1' %>" data-guided-tour="summary-visualization-shortcut" data-summary-visualization-card-link data-url="<%= project_path(@project, view: 'visualization') %>" role="link" tabindex="0">
<p class="dashboard-card-title text-gray-900 flex items-center gap-2"><span class="inline-flex text-gray-500"><%= render 'shared/scatter_plot_icon' %></span><span>Visualization</span></p>
<div class="grid grid-cols-2 gap-2 mt-2">
<button type="button" data-summary-detail-trigger data-summary-detail-type="embeddings" data-guided-tour="summary-embeddings-trigger" class="badge-text inline-flex items-center justify-center rounded px-2 py-1 whitespace-nowrap <%= summary_embedding_count.to_i.positive? ? 'bg-blue-100 text-blue-800 hover:bg-blue-200' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %>"><span class="font-semibold mr-1"><%= number_with_delimiter(summary_embedding_count) %></span> embeddings</button>
<button type="button" data-summary-detail-trigger data-summary-detail-type="annotations" data-guided-tour="summary-annotations-trigger" class="badge-text inline-flex items-center justify-center rounded px-2 py-1 whitespace-nowrap <%= summary_visual_annotation_count.to_i.positive? ? 'bg-indigo-100 text-indigo-800 hover:bg-indigo-200' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %>"><span class="font-semibold mr-1"><%= number_with_delimiter(summary_visual_annotation_count) %></span> annotations</button>
<button type="button" data-summary-detail-trigger data-summary-detail-type="checkpoints" data-guided-tour="summary-checkpoints-trigger" class="badge-text inline-flex items-center justify-center rounded px-2 py-1 whitespace-nowrap <%= summary_checkpoint_count.to_i.positive? ? 'bg-emerald-100 text-emerald-800 hover:bg-emerald-200' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %>"><span class="font-semibold mr-1"><%= number_with_delimiter(summary_checkpoint_count) %></span> checkpoints</button>
<button type="button" data-summary-detail-trigger data-summary-detail-type="comments" data-guided-tour="summary-comments-trigger" class="badge-text inline-flex items-center justify-center rounded px-2 py-1 whitespace-nowrap <%= summary_checkpoint_comment_count.to_i.positive? ? 'bg-amber-100 text-amber-800 hover:bg-amber-200' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %>"><span class="font-semibold mr-1"><%= number_with_delimiter(summary_checkpoint_comment_count) %></span> comments</button>
</div>
</div>


<%= link_to project_path(@project, view: 'analysis'), class: "block bg-gray-50 rounded-lg border border-gray-200 px-4 py-3 hover:border-blue-300 hover:bg-blue-50 transition-colors #{summary_metrics_span_half}", data: { guided_tour: "summary-analysis-card" } do %>
    <p class="dashboard-card-title text-gray-900 flex items-center gap-2"><i class="fas fa-sitemap text-gray-500"></i><span>Analysis</span></p>
    <div class="mt-2 flex flex-wrap items-baseline gap-x-2"><span class="hero-stat text-gray-900"><%= number_with_delimiter(summary_total_runs) %></span><span class="font-semibold text-gray-600 uppercase tracking-wide badge-text">runs</span></div>
  <% end %>

  <%= link_to project_path(@project, view: 'data'), class: "block bg-gray-50 rounded-lg border border-gray-200 px-4 py-3 hover:border-blue-300 hover:bg-blue-50 transition-colors #{summary_metrics_span_third}", data: { guided_tour: "summary-data-card" } do %>
    <p class="dashboard-card-title text-gray-900 flex items-center justify-between gap-2 w-full">
      <span class="flex items-center gap-2 min-w-0">
        <i class="fas fa-database text-gray-500"></i>
        <span>Data</span>
      </span>
      <% summary_archive_icon = @project.archive_status_icon_class_for_display %>
      <% if summary_archive_icon.present? %>
        <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-gray-100 text-gray-700 shrink-0"
              title="Archive status: <%= @project.archive_status_label_for_display %>">
          <i class="<%= summary_archive_icon %> text-xs"></i>
        </span>
      <% end %>
    </p>
    <div class="mt-2 flex items-baseline gap-2"><span class="hero-stat text-gray-900"><%= number_with_delimiter(summary_loom_file_count) %></span><span class="font-semibold text-gray-600 uppercase tracking-wide badge-text">LOOM files</span></div>
  <% end %>

  <div class="block bg-gray-50 rounded-lg border border-gray-200 px-4 py-3 <%= summary_metrics_span_third %>" data-guided-tour="summary-settings-card">
    <p class="dashboard-card-title text-gray-900 flex items-center gap-2"><i class="fas fa-cog text-gray-500"></i><span>Settings</span></p>
    <div class="flex flex-col gap-2 mt-2">
      <span class="badge-text inline-flex items-center justify-center rounded px-2 py-1 whitespace-nowrap <%= @project.public? ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800' %>" data-guided-tour="summary-settings-visibility-badge"><%= @project.public? ? 'Public project' : 'Private project' %></span>
      <span class="badge-text inline-flex items-center justify-center rounded px-2 py-1 whitespace-nowrap <%= summary_shared_users_count.to_i.positive? ? 'bg-indigo-100 text-indigo-800' : 'bg-gray-100 text-gray-600' %>" data-guided-tour="summary-sharing-badge">Shared with <span class="font-semibold mx-1"><%= number_with_delimiter(summary_shared_users_count) %></span> users</span>
    </div>
  </div>
<% if summary_metrics_show_compliance %>
  <% if @project.compliance_schemas.any? %>
    <%= link_to project_path(@project, view: 'compliance'), class: "block bg-gray-50 rounded-lg border border-gray-200 px-4 py-3 hover:border-blue-300 hover:bg-blue-50 transition-colors #{summary_metrics_span_third}", data: { guided_tour: "summary-compliance-card" } do %>
      <p class="dashboard-card-title text-gray-900 flex items-center gap-2"><i class="fas fa-check-circle text-gray-500"></i><span>Compliance</span></p>
      <div class="mt-2 flex items-baseline gap-2" data-guided-tour="summary-compliance-schemas-stat"><span class="hero-stat text-gray-900"><%= number_with_delimiter(summary_compliance_schema_count) %></span><span class="font-semibold text-gray-600 uppercase tracking-wide badge-text">schemas</span></div>
    <% end %>
  <% else %>
    <div class="block bg-gray-50 rounded-lg border border-gray-200 px-4 py-3 <%= summary_metrics_span_third %>" data-guided-tour="summary-compliance-card"><p class="dashboard-card-title text-gray-900 flex items-center gap-2"><i class="fas fa-check-circle text-gray-500"></i><span>Compliance</span></p><p class="italic text-gray-500 mt-2">No available schema</p></div>
  <% end %>
<% end %>
</div>

<%# Row 2: Info Boxes %>
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-12 gap-3">
    <div class="bg-white rounded-lg border border-gray-200 p-3 xl:col-span-6" data-guided-tour="summary-identity-panel">
      <div class="flex items-center justify-between mb-2"><p class="dashboard-card-title text-gray-900 flex items-center gap-2"><i class="fas fa-fingerprint text-gray-500"></i><span>Identity</span></p><div class="flex items-center gap-1.5"><span class="badge-text px-2 py-0.5 rounded font-medium bg-blue-100 text-blue-800" data-guided-tour="summary-identity-key"><%= @project.key %></span></div></div>
      <div class="space-y-2.5">
        <div class="flex items-center gap-4 min-h-[1.5em]" data-guided-tour="summary-identity-name-row"><span class="w-24 shrink-0 text-gray-500">Project Name</span>
          <div id="project-title-editor" data-project-title="<%= @project.display_name %>" data-update-url="<%= project_path(@project, format: :json) %>" class="flex items-center gap-2 min-w-0 flex-1">
            <p id="project-title-text" class="text-gray-900 font-bold truncate"><%= @project.display_name %></p>
            <% if can_edit_project_title %><button id="project-title-edit-button" type="button" class="text-gray-400 hover:text-blue-600"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M16.862 3.487a2.1 2.1 0 113 2.97L8.4 17.92l-4.2 1.2 1.2-4.2L16.862 3.487z" /></svg></button>
            <div id="project-title-edit-controls" class="hidden flex items-center gap-2 w-full"><input id="project-title-input" type="text" value="<%= @project.display_name %>" class="w-full px-2 py-1 border rounded"><button id="project-title-save-button" type="button" class="badge-text px-2 py-1 rounded bg-blue-600 text-white">Save</button></div><% end %>
          </div>
        </div>
        <div class="flex items-center gap-4 min-h-[1.5em]" data-guided-tour="summary-identity-type-row"><span class="w-24 shrink-0 text-gray-500">Type</span><span class="text-gray-900 font-medium"><%= @project_type&.name || 'Unknown' %></span></div>
        <div class="flex items-start gap-4 min-h-[1.5em]" data-guided-tour="summary-identity-origin-row"><span class="w-24 shrink-0 text-gray-500 mt-0.5">Origin</span><div class="text-gray-700 flex-1">
          <% if @project.cloned_project_id.present? %>
            Cloned from <%= link_to Project.find_by(id: @project.cloned_project_id)&.key || 'deleted', project_path(id: @project.cloned_project_id), class: "text-blue-600 underline font-semibold" %>
            <% if summary_clone_lineage_projects.any? %>
              <button id="summary-lineage-toggle-button" type="button" class="badge-text bg-gray-200 text-gray-700 px-1.5 rounded ml-1">Full lineage</button>
            <% end %>
          <% elsif @project.from_scfair_validation? %>
            <%= @project.project_origin.display_label %>
          <% elsif @project.from_integration? %>
            <%= @project.project_origin.display_label %>
          <% elsif @project.project_origin.present? && !@project.from_upload? %>
            <%= @project.project_origin.display_label %>
          <% else %>
            New project
          <% end %>
        </div></div>
      </div>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 p-3 xl:col-span-3" data-guided-tour="summary-activity-panel">
      <p class="dashboard-card-title text-gray-900 flex items-center gap-2 mb-2"><i class="fas fa-history text-gray-500"></i><span>Activity</span></p>
      <div class="space-y-2.5">
        <div class="flex justify-between items-center min-h-[1.5em]" data-guided-tour="summary-activity-created"><span class="text-gray-500">Created</span><span class="text-gray-900 font-medium"><%= @project.created_at.strftime("%b %d, %Y") %></span></div>
        <div class="flex justify-between items-center min-h-[1.5em]" data-guided-tour="summary-activity-updated"><span class="text-gray-500">Updated</span><span class="text-gray-900 font-medium"><%= @project.updated_at.strftime("%b %d, %Y") %></span></div>
        <div class="flex justify-between items-center min-h-[1.5em]" data-guided-tour="summary-activity-views"><span class="text-gray-500">Views</span><span class="badge-text px-2 py-0.5 rounded bg-indigo-50 text-indigo-700 font-bold"><%= number_with_delimiter(@project.nber_views || 0) %></span></div>
      </div>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 p-3 xl:col-span-3" data-guided-tour="summary-reproducibility-panel">
      <p class="dashboard-card-title text-gray-900 flex items-center gap-2 mb-2"><i class="fas fa-file-alt text-gray-500"></i><span>Reproducibility</span></p>
      <div class="flex flex-col gap-2">
        <div class="flex flex-row gap-2">
          <%= link_to "Instructions", instructions_project_path(@project.key), target: "_blank", rel: "noopener noreferrer", class: "badge-text flex-1 min-w-0 px-2 py-1 rounded bg-blue-100 text-blue-800 font-medium text-center hover:bg-blue-200", data: { turbo: false, guided_tour: "summary-repro-instructions-link" } %>
          <%= link_to "List of commands", get_commands_project_path(@project.key), target: "_blank", rel: "noopener noreferrer", class: "badge-text flex-1 min-w-0 px-2 py-1 rounded bg-gray-100 text-gray-700 font-medium text-center hover:bg-gray-200", data: { turbo: false, guided_tour: "summary-repro-commands-link" } %>
        </div>
        <div class="flex flex-row gap-2">
          <% if @summary_show_submitted_file_link && @summary_input_file_get_file_query_param.present? %>
            <% if summary_archive_data_unavailable %>
              <span class="badge-text flex-1 min-w-0 inline-flex items-center justify-center gap-1.5 px-2 py-1 rounded bg-gray-100 text-gray-400 font-medium cursor-not-allowed"
                    aria-disabled="true"
                    title="<%= summary_archive_disabled_tooltip %>"
                    data-guided-tour="summary-repro-submitted-file-link"
                    aria-label="Input file download (disabled, project archived)">
                <i class="fas fa-download text-gray-400" aria-hidden="true"></i>
                <span>Input file</span>
              </span>
            <% else %>
              <%= link_to get_file_project_path(@project.key, filename: @summary_input_file_get_file_query_param), target: "_blank", rel: "noopener noreferrer", class: "badge-text flex-1 min-w-0 inline-flex items-center justify-center gap-1.5 px-2 py-1 rounded bg-gray-100 text-gray-700 font-medium hover:bg-gray-200", data: { guided_tour: "summary-repro-submitted-file-link" }, aria: { label: "Input file download" } do %>
                <i class="fas fa-download text-gray-500" aria-hidden="true"></i>
                <span>Input file</span>
              <% end %>
            <% end %>
          <% end %>
          <% if summary_archive_data_unavailable %>
            <button type="button" disabled
                    class="badge-text flex-1 min-w-0 inline-flex items-center justify-center gap-1.5 px-2 py-1 rounded bg-gray-100 text-gray-400 font-medium cursor-not-allowed"
                    aria-disabled="true"
                    title="<%= summary_archive_disabled_tooltip %>"
                    data-guided-tour="summary-repro-downloads-trigger"
                    aria-label="LOOM and H5AD downloads (disabled, project archived)">
              <i class="fas fa-download text-gray-400" aria-hidden="true"></i><span>LOOM/H5AD</span>
            </button>
          <% else %>
            <button type="button" id="summary-loom-downloads-open-button" class="badge-text flex-1 min-w-0 inline-flex items-center justify-center gap-1.5 px-2 py-1 rounded bg-gray-100 text-gray-700 font-medium hover:bg-gray-200" data-summary-loom-json-url="<%= get_loom_files_json_project_path(@project.key) %>" data-guided-tour="summary-repro-downloads-trigger" aria-label="LOOM and H5AD downloads"><i class="fas fa-download text-gray-500" aria-hidden="true"></i><span>LOOM/H5AD</span></button>
          <% end %>
        </div>
        <% if summary_archive_data_unavailable %>
          <span class="badge-text px-2 py-1 rounded bg-gray-100 text-gray-400 font-medium text-center cursor-not-allowed"
                aria-disabled="true"
                title="<%= summary_archive_disabled_tooltip %>"
                data-guided-tour="summary-repro-loom-json-link">List of Loom files (JSON)</span>
        <% else %>
          <%= link_to "List of Loom files (JSON)", get_loom_files_json_project_path(@project.key, download: 1), class: "badge-text px-2 py-1 rounded bg-gray-100 text-gray-700 font-medium text-center hover:bg-gray-200", data: { guided_tour: "summary-repro-loom-json-link" } %>
        <% end %>
      </div>
    </div>
</div>

<%# Tier 3: Repository & Publications %>
<div class="grid grid-cols-1 xl:grid-cols-3 gap-3">
  <div class="xl:col-span-2 bg-white rounded-lg border border-gray-200 p-4" data-guided-tour="summary-repository-panel">
    <p class="dashboard-card-title text-gray-900 flex items-center gap-2 mb-4"><i class="fas fa-link text-gray-500"></i><span>Source repository links</span></p>
    <% if @h_exp_entries && @h_exp_entries.keys.any? %>
      <div class="mt-3 space-y-4">
        <% @h_exp_entries.each do |type_id, exp_entries| %>
          <% next if exp_entries.empty? %>
          <% identifier_type = @h_identifier_types[type_id] %>
          <div>
            <h4 class="font-bold text-gray-700 mb-2" style="font-size: 0.9em;"><%= identifier_type&.name || 'Unknown Type' %></h4>
            <div class="overflow-x-auto rounded-lg border border-gray-100 bg-white">
              <table class="min-w-full divide-y divide-gray-100">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-3 py-1.5 text-left font-semibold text-gray-600">Identifier</th>
                    <th class="px-3 py-1.5 text-left font-semibold text-gray-600">Title</th>
                    <th class="px-3 py-1.5 text-left font-semibold text-gray-600">Other identifiers</th>
                    <th class="px-3 py-1.5 text-left font-semibold text-gray-600">Contributors</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                  <% exp_entries.each do |exp_entry| %>
                    <tr class="hover:bg-blue-50/50">
                      <td class="px-3 py-2 align-top whitespace-nowrap">
                        <% if identifier_type&.url_mask.present? %>
                          <%= link_to exp_entry.identifier, identifier_type.url_mask.gsub('#{id}', exp_entry.identifier.to_s), target: '_blank', class: "badge-text inline-flex items-center px-2 py-0.5 rounded font-bold bg-gray-100 text-blue-600 hover:bg-blue-100" %>
                        <% else %>
                          <span class="badge-text px-2 py-0.5 rounded font-bold bg-gray-100 text-gray-700"><%= exp_entry.identifier %></span>
                        <% end %>
                      </td>
                      <td class="px-3 py-2 align-top text-gray-900"><%= exp_entry.title %></td>
                      <td class="px-3 py-2 align-top">
                        <% h_ids = exp_entry.parsed_identifiers %>
                        <% if h_ids.any? %>
                          <div class="flex flex-wrap gap-1">
                            <% h_ids.each do |id_type_id, ids| %>
                              <% id_type = @h_identifier_types[id_type_id.to_i] %>
                              <% ids.uniq.each do |id| %>
                                <% if id_type&.url_mask.present? %>
                                  <%= link_to id, id_type.url_mask.gsub('#{id}', id.to_s), target: '_blank', class: "badge-text px-2 py-0.5 rounded bg-gray-50 text-gray-600 hover:text-blue-600" %>
                                <% else %><span class="badge-text px-2 py-0.5 rounded bg-gray-50 text-gray-500"><%= id %></span><% end %>
                              <% end %>
                            <% end %>
                          </div>
                        <% end %>
                      </td>
                      <td class="px-3 py-2 align-top text-gray-500">
                        <% if exp_entry.contributors.present? %>
                          <% names = exp_entry.contributors.split(";").map { |c| c.split(",").reject(&:blank?).join(" ").strip }.reject(&:blank?) %>
                          <div class="flex flex-wrap gap-1"><% names.each do |n| %><span class="badge-text px-2 py-0.5 rounded bg-blue-50 text-blue-700"><%= n %></span><% end %></div>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
    <% if downloaded_from_sources.any? %><p class="badge-text text-gray-600 mt-3">Downloaded from <%= safe_join(downloaded_from_sources, ', ') %></p><% end %>
  </div>

  <div class="bg-white rounded-lg border border-gray-200 p-4" data-guided-tour="summary-publications-panel">
    <p class="dashboard-card-title text-gray-900 flex items-center gap-2 mb-4"><i class="fas fa-book-open text-gray-500"></i><span>Publications</span></p>
    <div class="space-y-4">
      <% publication_dois = @project.doi.to_s.split(/\s*,\s*/).reject(&:blank?) %>
      <% if publication_dois.any? %><% publication_dois.each do |doi| %>
        <% article = @h_articles[doi] %>
        <div class="leading-snug">
          <% if article %>
            <p class="text-gray-900 font-medium"><%= link_to article.title.to_s.truncate(120), "https://doi.org/#{doi}", target: '_blank', class: "hover:text-blue-700 hover:underline" %></p>
            <% if article.authors.present? %>
              <p class="text-gray-500 flex flex-wrap items-center gap-x-2 gap-y-1">
                <span><%= sanitize(article.authors.to_s.truncate(120).gsub(/\bet al\.?/i) { |match| "<em>#{match}</em>" }, tags: %w[em]) %></span>
                <% if article.pmid.present? %><%= link_to "PubMed: #{article.pmid}", "https://pubmed.ncbi.nlm.nih.gov/#{article.pmid}/", target: '_blank', class: "badge-text px-2 py-0.5 rounded bg-green-100 text-green-800" %><% end %>
              </p>
            <% end %>
          <% else %><p class="text-gray-900 font-medium"><%= link_to doi, "https://doi.org/#{doi}", target: '_blank', class: "hover:text-blue-700 hover:underline" %></p><% end %>
        </div>
      <% end %><% else %><p class="italic text-gray-400">No publications.</p><% end %>
    </div>
  </div>
</div>

</div>

<%# Obsolete commented popover markup removed (ERB inside HTML comments still executes). %>
 <% if summary_clone_lineage_projects.any? %>
      <div id="summary-lineage-popover" class="hidden fixed z-50 w-[min(56rem,95vw)] max-h-[85vh] bg-white rounded-lg border border-gray-200 shadow-xl flex flex-col overflow-hidden">
        <div id="summary-lineage-header" class="flex items-center justify-between px-4 py-3 border-b border-gray-200 cursor-move select-none">
          <div class="flex items-center gap-2 min-w-0">
            <span id="summary-lineage-drag-handle" class="inline-flex items-center text-gray-400 cursor-move select-none" title="Drag">
              <i class="fas fa-grip-vertical" style="font-size: 14px;"></i>
            </span>
            <h3 class="text-sm font-semibold text-gray-900">Full lineage</h3>
          </div>
          <button id="summary-lineage-close-button" type="button" class="inline-flex items-center justify-center p-1 rounded text-gray-500 hover:bg-gray-200 hover:text-gray-700" title="Close" aria-label="Close">
            <i class="fas fa-times"></i>
          </button>
