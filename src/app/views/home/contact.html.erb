<% content_for :title, "Contact us - ASAP" %>
<div class="max-w-2xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="mb-8">
    <h1 class="text-3xl font-semibold text-gray-900">Contact us</h1>
    <p class="mt-2 text-gray-600">
      You can contact us directly by email at
      <a href="mailto:bioinfo.epfl@gmail.com" class="text-blue-600 hover:underline">bioinfo.epfl@gmail.com</a>.
    </p>
    <p class="mt-1 text-gray-600">
      Or you can fill in the form below:
    </p>
  </div>

  <% if flash[:notice].present? %>
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg">
      <p class="text-green-800"><%= flash[:notice] %></p>
    </div>
  <% end %>

  <% if flash[:alert].present? %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
      <p class="text-red-800"><%= flash[:alert] %></p>
    </div>
  <% end %>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <%= form_with url: contact_submit_home_index_path, method: :post, local: true, multipart: true, class: "space-y-5" do |f| %>

      <% unless user_signed_in? %>
        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Your email</label>
          <input type="email" name="email" id="email"
                 value="<%= params[:email] %>"
                 required
                 class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500"
                 placeholder="you@example.com">
        </div>
      <% end %>

      <div>
        <label for="subject" class="block text-sm font-medium text-gray-700 mb-1">Subject</label>
        <input type="text" name="subject" id="subject"
               value="<%= params[:subject] %>"
               required
               class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500"
               placeholder="Brief description of your message">
      </div>

      <div>
        <label for="body" class="block text-sm font-medium text-gray-700 mb-1">Message</label>
        <textarea name="body" id="body"
                  rows="8"
                  required
                  class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500"
                  placeholder="Describe your question, issue, or feedback..."><%= params[:body] %></textarea>
      </div>

      <div id="attachments-section">
        <label class="block text-sm font-medium text-gray-700 mb-1">Attachments (optional)</label>
        <div id="file-list" class="space-y-2"></div>
        <button type="button" id="add-file-btn"
                class="mt-2 inline-flex items-center px-3 py-1.5 text-sm font-medium text-blue-700 bg-blue-50 rounded-md border border-blue-200 hover:bg-blue-100 transition-colors cursor-pointer">
          <i class="fas fa-paperclip mr-1.5"></i> Add file
        </button>
        <p class="mt-1 text-xs text-gray-500">You can attach screenshots or log files. Max 10 MB per file.</p>
      </div>
      <script>
        (function() {
          var fileCounter = 0
          var addBtn = document.getElementById('add-file-btn')
          var fileList = document.getElementById('file-list')

          function addFileRow() {
            fileCounter++
            var row = document.createElement('div')
            row.className = 'flex items-center gap-2'
            row.id = 'file-row-' + fileCounter

            var input = document.createElement('input')
            input.type = 'file'
            input.name = 'attachments[]'
            input.className = 'block w-full text-sm text-gray-500 file:mr-4 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100'

            var removeBtn = document.createElement('button')
            removeBtn.type = 'button'
            removeBtn.className = 'flex-shrink-0 p-1.5 text-gray-400 hover:text-red-500 transition-colors cursor-pointer'
            removeBtn.title = 'Remove'
            removeBtn.innerHTML = '<i class="fas fa-times"></i>'
            removeBtn.addEventListener('click', function() {
              row.remove()
            })

            row.appendChild(input)
            row.appendChild(removeBtn)
            fileList.appendChild(row)
          }

          addBtn.addEventListener('click', addFileRow)
          addFileRow()
        })()
      </script>

      <div class="pt-2">
        <button type="submit"
                class="w-full px-4 py-2 bg-blue-600 text-white font-medium rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors">
          Send message
        </button>
      </div>

    <% end %>
  </div>
</div>
