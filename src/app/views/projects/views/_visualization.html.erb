      <!-- Right: toolbar actions wrap independently with a tight row gap -->
      <div class="viz-toolbar-actions" style="display: flex; flex-wrap: wrap; justify-content: flex-end; align-content: flex-start; align-items: flex-start; gap: 2px 8px; min-width: 0;">
