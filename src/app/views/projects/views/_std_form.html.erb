<%# Standard Form View - Shows form when no runs exist and has_std_form is true %>
<div id="std_form_<%= @step.id %>" class="std-form mb-6">
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 flex flex-col min-h-0 std-form-card max-h-[calc(100vh-260px)] lg:max-h-[calc(100vh-200px)]">
    <div class="border-b border-gray-200 px-6 py-4 flex-shrink-0 z-10" style="background: linear-gradient(to right, #eff6ff, #eef2ff); background-color: #ffffff;">
      <div class="flex items-center justify-between">
        <h3 class="text-base font-semibold text-gray-900 flex items-center gap-2">
          New <%= @step.label.presence || @step.name.humanize %>
        </h3>
      </div>
    </div>
    <%= render partial: 'projects/views/form_req' %>
  </div>
</div>



