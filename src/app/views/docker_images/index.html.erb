<% content_for :title, "Docker Images - ASAP" %>
<div class="max-w-5xl mx-auto py-10 px-4 sm:px-6 lg:px-8 space-y-6">
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-semibold text-gray-900 dark:text-white">Docker Images</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-300">
        Container images used by ASAP for analysis pipelines.
      </p>
    </div>
    <% if can_edit_synced_reference_data? %>
      <%= link_to 'New Docker Image', new_docker_image_path, class: 'inline-flex items-center px-3 py-2 rounded-md bg-gray-900 text-white text-sm font-medium hover:bg-gray-800 transition' %>
    <% end %>
  </div>

  <% if notice.present? %>
    <div class="rounded-md bg-green-100 px-4 py-3 text-sm text-green-700"><%= notice %></div>
  <% end %>

  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50 text-xs font-semibold uppercase tracking-wide text-gray-600">
        <tr>
          <th scope="col" class="px-3 py-2 text-left">ID</th>
          <th scope="col" class="px-3 py-2 text-left">Name</th>
          <th scope="col" class="px-3 py-2 text-left">Tag</th>
          <th scope="col" class="px-3 py-2 text-left">Tools</th>
          <th scope="col" class="px-3 py-2 text-right"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 text-sm text-gray-700">
        <% @docker_images.each do |docker_image| %>
          <% tools = docker_image_tool_versions(docker_image) %>
          <tr>
            <td class="px-3 py-2 text-gray-500">#<%= docker_image.id %></td>
            <td class="px-3 py-2 font-medium text-gray-900"><%= docker_image.name %></td>
            <td class="px-3 py-2 text-gray-700"><%= docker_image.tag %></td>
            <td class="px-3 py-2">
              <% if tools.present? %>
                <div class="flex flex-wrap gap-2">
                  <% tools.each do |tool_name, version| %>
                    <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-700">
                      <%= tool_name %>
                      <span class="ml-1 text-gray-500">(<%= version %>)</span>
                    </span>
                  <% end %>
                </div>
              <% else %>
                <span class="text-gray-400">–</span>
              <% end %>
            </td>
            <td class="px-3 py-2 text-right">
              <%= link_to 'Show', docker_image_path(docker_image), class: 'text-gray-600 hover:text-gray-800' %>
              <% if can_edit_synced_reference_data? %>
                <span class="mx-2 text-gray-300">|</span>
                <%= link_to 'Edit', edit_docker_image_path(docker_image), class: 'text-gray-600 hover:text-gray-800' %>
                <span class="mx-2 text-gray-300">|</span>
                <%= link_to 'Destroy', docker_image_path(docker_image),
                            method: :delete,
                            data: { confirm: 'Are you sure?' },
                            class: 'text-red-600 hover:text-red-700' %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @docker_images.empty? %>
    <div class="rounded-lg border border-dashed border-gray-300 bg-white px-6 py-10 text-center text-gray-500">
      No docker images have been recorded yet.
    </div>
  <% end %>
</div>

