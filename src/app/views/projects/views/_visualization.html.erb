<div id="checkpoint-save-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); z-index: 12000; justify-content: center; align-items: center;" onclick="if (window.visualizationController) window.visualizationController.checkpointSaveDialogBackdropClick(event)">
  <div style="background: white; border-radius: 10px; width: 520px; max-width: 94vw; overflow: hidden; display: flex; flex-direction: column;" onclick="event.stopPropagation()">
    <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-bottom: 1px solid #e5e7eb;">
      <div style="font-size: 15px; font-weight: 600; color: #111827;">Save checkpoint</div>
      <button type="button"
              style="background: none; border: none; font-size: 18px; color: #6b7280; cursor: pointer;"
              onclick="if (window.visualizationController) window.visualizationController.closeSaveCheckpointDialog()">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div style="padding: 14px 16px; display: flex; flex-direction: column; gap: 12px;">
      <label style="display: flex; align-items: flex-start; gap: 8px; font-size: 13px; color: #111827; cursor: pointer;">
        <input type="radio" name="checkpoint-save-mode" id="checkpoint-save-mode-new" value="new" checked
               onchange="if (window.visualizationController) window.visualizationController.onSaveCheckpointModeChanged()"
               style="margin-top: 2px;">
        <span>New checkpoint</span>
      </label>
      <div id="checkpoint-save-new-fields" style="display: flex; flex-direction: column; gap: 6px; padding-left: 24px;">
        <label for="checkpoint-save-new-title" style="font-size: 12px; color: #4b5563;">Name</label>
        <input id="checkpoint-save-new-title" type="text" maxlength="255"
               style="border: 1px solid #d1d5db; border-radius: 6px; padding: 7px 8px; font-size: 13px;">
      </div>
      <div id="checkpoint-save-existing-wrap">
        <label style="display: flex; align-items: flex-start; gap: 8px; font-size: 13px; color: #111827; cursor: pointer;">
          <input type="radio" name="checkpoint-save-mode" id="checkpoint-save-mode-existing" value="existing"
                 onchange="if (window.visualizationController) window.visualizationController.onSaveCheckpointModeChanged()"
                 style="margin-top: 2px;">
          <span>Update an existing checkpoint with no comments</span>
