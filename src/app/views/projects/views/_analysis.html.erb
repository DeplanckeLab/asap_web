<div class="flex flex-col h-full" data-controller="step-selector" data-step-selector-project-id-value="<%= @project.id %>">
  <!-- Header -->
  <div class="mb-4 flex-shrink-0">
    <div class="flex items-center gap-3 mb-2">
      <h2 class="text-2xl font-bold text-gray-900">Analysis</h2>
      <% if @project_type %>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800 border border-blue-200">
          <%= @project_type.name %>
        </span>
      <% end %>
    </div>
   <!-- <p class="text-gray-600">Data analysis tools and pipelines for single-cell transcriptomics</p>-->
  </div>

  <!-- Step Selector for Narrow Screens (Mobile/Tablet) -->
  <% # Calculate selected step info before the dropdown div %>
  <% selected_step_info = @steps_with_status&.find { |s| @selected_step_id && s[:step].id == @selected_step_id } %>
  <% selected_step = selected_step_info ? selected_step_info[:step] : (@steps_with_status&.first&.dig(:step)) %>
  <% selected_status = selected_step_info ? selected_step_info[:status] : (@steps_with_status&.first&.dig(:status)) %>
  <% selected_is_complete = selected_step_info ? selected_step_info[:is_complete] : (@steps_with_status&.first&.dig(:is_complete)) %>
  <% selected_is_available = selected_step_info ? selected_step_info[:is_available] : (@steps_with_status&.first&.dig(:is_available)) %>
  <% effective_selected_step_id = (@selected_step_id.present? ? @selected_step_id : (selected_step ? selected_step.id : nil)) %>
  
  <div class="mb-4 lg:hidden relative" data-controller="dropdown" data-selected-step-id="<%= effective_selected_step_id %>">
    
    <button type="button" 
            class="w-full bg-white rounded-lg shadow-sm border border-gray-200 px-4 py-3 text-left flex items-center justify-between"
            style="border-left: 4px solid #007bff !important; border-top-left-radius: 0.5rem; border-bottom-left-radius: 0.5rem;"
            data-action="click->dropdown#toggle"
            data-dropdown-target="button">
      <div class="flex items-center flex-1 min-w-0">
        <% if selected_step %>
          <div class="flex-shrink-0 mr-3 w-5 flex items-center justify-center">
            <% if !selected_is_available %>
              <i class="fas fa-lock text-base text-gray-400"></i>
            <% elsif selected_is_complete %>
              <i class="fas fa-check-circle text-base text-green-500"></i>
            <% elsif selected_status == 'running' %>
              <i class="fas fa-spinner fa-spin text-base text-blue-500"></i>
            <% elsif selected_status == 'waiting' %>
              <i class="fas fa-clock text-base text-yellow-500"></i>
            <% elsif selected_status == 'failed' %>
              <i class="fas fa-exclamation-circle text-base text-red-500"></i>
            <% else %>
              <i class="far fa-circle text-base text-gray-400"></i>
            <% end %>
          </div>
          <span class="<%= !selected_is_available ? 'text-gray-500' : (selected_is_complete ? 'text-green-600' : 'text-gray-900') %> font-semibold truncate">
            <%= selected_step.label.presence || selected_step.name %>
          </span>
        <% end %>
      </div>
      <i class="fas fa-chevron-down ml-3 text-gray-400 flex-shrink-0" data-dropdown-target="icon"></i>
    </button>
    
    <div class="hidden absolute top-full left-0 right-0 mt-1 bg-white rounded-lg shadow-lg border border-gray-200 max-h-96 overflow-y-auto z-50" 
         data-dropdown-target="menu">
      <div>
        <% if @steps_with_status && @steps_with_status.any? %>
          <% @steps_with_status.each do |step_info| %>
            <% step = step_info[:step] %>
            <% is_current = step_info[:is_current] %>
            <% is_available = step_info[:is_available] %>
            <% is_complete = step_info[:is_complete] %>
            <% status = step_info[:status] %>
            <% status_counts = step_info[:status_counts] || { waiting: 0, running: 0, completed: 0, failed: 0 } %>
            <% 
              # Compare using effective_selected_step_id or selected_step.id
              # Ensure we match what's shown in the button
              step_id_match = effective_selected_step_id.present? && effective_selected_step_id.to_i == step.id.to_i
              selected_step_match = selected_step && selected_step.id.to_i == step.id.to_i
              is_selected = step_id_match || selected_step_match
              
              item_classes = 'flex items-start px-4 py-3 border-b border-gray-200 step-item bg-white'
              # Always show blue border for selected step
              item_style = is_selected ? 'border-left: 4px solid #007bff !important;' : 'border-left: 4px solid transparent;'
              
              if !is_available
                item_classes += ' opacity-50 cursor-not-allowed disabled'
              else
                item_classes += ' cursor-pointer step-item-hover'
              end
              
              if is_selected
                item_classes += ' active'
              end
              
              text_class = if !is_available
                            'text-gray-500'
                          elsif is_complete
                            'text-green-600'
                          else
                            'text-gray-900'
                          end
              
              # Determine cursor style for locked steps
              cursor_style = if !is_available
                              'cursor: not-allowed !important;'
                            else
                              ''
                            end
              
              # Debug output for the parsing step
              debug_info = step.name == 'parsing' ? "<!-- DEBUG: step.id=#{step.id}, selected_step.id=#{selected_step ? selected_step.id : 'nil'}, effective_selected_step_id=#{effective_selected_step_id}, step_id_match=#{step_id_match}, selected_step_match=#{selected_step_match}, is_selected=#{is_selected}, item_style=#{item_style} -->" : ''
            %>
            
            <%= raw debug_info %>
            
            <div class="<%= item_classes %> <%= text_class %>" 
                 style="<%= item_style %> <%= cursor_style %>"
                 <% if is_available %>
                   data-action="click->step-selector#selectStep click->dropdown#close"
                   data-step-selector-step-id-param="<%= step.id %>"
                 <% else %>
                   data-step-locked="true"
                   onclick="event.preventDefault(); event.stopPropagation(); return false;"
                 <% end %>
                 data-step-id="<%= step.id %>">
              <div class="flex-shrink-0 mr-3" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                <% if !is_available %>
                  <div class="relative group">
                    <i class="fas fa-lock text-sm text-gray-400"></i>
                  </div>
                <% elsif !step.multiple_runs %>
                  <% 
                    # Single icon for steps with multiple_runs = false
                    tooltip_text = if is_complete
                                     status.present? ? status.humanize : "Complete"
                                   elsif status == 'running'
                                     "Running"
                                   elsif status == 'waiting'
                                     "Waiting"
                                   elsif status == 'failed'
                                     "Failed"
                                   else
                                     "Not started"
                                   end
                  %>
                  <div class="relative group">
                    <% if is_complete %>
                      <i class="fas fa-check-circle text-sm text-green-500"></i>
                    <% elsif status == 'running' %>
                      <i class="fas fa-spinner fa-spin text-sm text-blue-500"></i>
                    <% elsif status == 'waiting' %>
                      <i class="fas fa-clock text-sm text-yellow-500"></i>
                    <% elsif status == 'failed' %>
                      <i class="fas fa-exclamation-circle text-sm text-red-500"></i>
                    <% else %>
                      <i class="far fa-circle text-sm text-gray-400"></i>
                    <% end %>
                    <div class="absolute left-full top-full ml-2 mt-1 px-2 py-1 text-xs font-medium text-white bg-gray-900 rounded shadow-lg opacity-0 group-hover:opacity-100 transition-opacity duration-0 pointer-events-none whitespace-nowrap z-50">
                      <%= tooltip_text %>
                      <div class="absolute right-full top-1/2 -translate-y-1/2 w-0 h-0 border-t-4 border-b-4 border-r-4 border-transparent border-r-gray-900"></div>
                    </div>
                  </div>
                <% else %>
                  <div style="display: grid; grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(2, 1fr); gap: 2px; width: 100%; height: 100%;">
                    <% 
                      # Define status icons with their properties in 2x2 grid order
                      status_icons = [
                        { 
                          key: :waiting, 
                          icon_base: 'fas fa-clock', 
                          icon_spin: '',
                          active_color: 'text-yellow-500',
                          inactive_color: 'text-gray-300',
                          count: status_counts[:waiting],
                          tooltip_label: 'Waiting'
                        },
                        { 
                          key: :running, 
                          icon_base: 'fas fa-spinner', 
                          icon_spin: 'fa-spin',
                          active_color: 'text-blue-500',
                          inactive_color: 'text-gray-300',
                          count: status_counts[:running],
                          tooltip_label: 'Running'
                        },
                        { 
                          key: :completed, 
                          icon_base: 'fas fa-check-circle', 
                          icon_spin: '',
                          active_color: 'text-green-500',
                          inactive_color: 'text-gray-300',
                          count: status_counts[:completed],
                          tooltip_label: 'Completed'
                        },
                        { 
                          key: :failed, 
                          icon_base: 'fas fa-exclamation-circle', 
                          icon_spin: '',
                          active_color: 'text-red-500',
                          inactive_color: 'text-gray-300',
                          count: status_counts[:failed],
                          tooltip_label: 'Failed'
                        }
                      ]
                    %>
                    <% status_icons.each do |status_icon| %>
                      <% 
                        is_active = status_icon[:count] > 0
                        icon_class = status_icon[:icon_base]
                        icon_class += " #{status_icon[:icon_spin]}" if is_active && status_icon[:icon_spin].present?
                        color_class = is_active ? status_icon[:active_color] : status_icon[:inactive_color]
                        tooltip_text = "#{status_icon[:tooltip_label]} (#{status_icon[:count]})"
                      %>
                      <div class="relative group" style="display: flex; align-items: center; justify-content: center;">
                        <i class="<%= icon_class %> text-sm <%= color_class %>"></i>
                        <div class="absolute left-full top-full ml-2 mt-1 px-2 py-1 text-xs font-medium text-white bg-gray-900 rounded shadow-lg opacity-0 group-hover:opacity-100 transition-opacity duration-0 pointer-events-none whitespace-nowrap z-50">
                          <%= tooltip_text %>
                          <div class="absolute right-full top-1/2 -translate-y-1/2 w-0 h-0 border-t-4 border-b-4 border-r-4 border-transparent border-r-gray-900"></div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
              <div class="flex-grow">
                <div>
                  <strong class="block"><%= step.label.presence || step.name %></strong>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="text-center py-8 px-4">
            <p class="text-gray-500 mb-0">No steps available</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <script>
    console.log('[Dropdown Debug] Script starting');
    (function() {
      try {
        // Debug: Log step selection values (run immediately)
        const selectedStepId = <%= selected_step ? selected_step.id : 'null' %>;
        const effectiveSelectedStepId = <%= (effective_selected_step_id.present? ? effective_selected_step_id : 'null') %>;
        const selectedStepName = '<%= (selected_step ? (selected_step.label.presence || selected_step.name).to_s.gsub("'", "\\'").gsub("\n", " ") : 'none') %>';
        
        console.log('[Dropdown Debug] Selected Step ID:', selectedStepId);
        console.log('[Dropdown Debug] Effective Selected Step ID:', effectiveSelectedStepId);
        console.log('[Dropdown Debug] Selected Step Name:', selectedStepName);
        
        // Wait a bit for DOM, then check dropdown items
        setTimeout(function() {
          const dropdownMenu = document.querySelector('[data-dropdown-target="menu"]');
          console.log('[Dropdown Debug] Dropdown menu found:', !!dropdownMenu);
          if (dropdownMenu) {
            const stepItems = dropdownMenu.querySelectorAll('[data-step-id]');
            console.log('[Dropdown Debug] Number of step items:', stepItems.length);
            stepItems.forEach(item => {
              const stepId = item.getAttribute('data-step-id');
              const style = item.getAttribute('style') || '';
              const isSelected = style.includes('#007bff');
              const matchesSelected = stepId == selectedStepId;
              console.log('[Dropdown Debug] Step ID:', stepId, 'Matches Selected (' + selectedStepId + '):', matchesSelected, 'Style:', style, 'Has Blue Border:', isSelected);
            });
          }
          
          // Call updateDropdownListSelection to restore the correct border after page load
          const stepIdToUse = effectiveSelectedStepId || selectedStepId;
          if (stepIdToUse && typeof window.Stimulus !== 'undefined') {
            const stepSelectorElement = document.querySelector('[data-controller~="step-selector"]');
            if (stepSelectorElement) {
              try {
                const stepSelectorController = window.Stimulus.getControllerForElementAndIdentifier(stepSelectorElement, 'step-selector');
                if (stepSelectorController && typeof stepSelectorController.updateDropdownListSelection === 'function') {
                  console.log('[Dropdown Debug] Calling updateDropdownListSelection with stepId:', stepIdToUse);
                  stepSelectorController.updateDropdownListSelection(stepIdToUse);
                } else {
                  console.warn('[Dropdown Debug] updateDropdownListSelection method not found, using direct DOM manipulation');
                  // Fallback: Direct DOM manipulation
                  if (dropdownMenu) {
                    const allStepItems = dropdownMenu.querySelectorAll('[data-step-id]');
                    allStepItems.forEach(item => {
                      item.style.borderLeft = '4px solid transparent';
                    });
                    const selectedItem = dropdownMenu.querySelector(`[data-step-id="${stepIdToUse}"]`);
                    if (selectedItem) {
                      selectedItem.style.borderLeft = '4px solid #007bff';
                      console.log('[Dropdown Debug] Set blue border on item with stepId:', stepIdToUse);
                    }
                  }
                }
              } catch(e) {
                console.error('[Dropdown Debug] Error accessing step-selector controller:', e);
              }
            }
          }
        }, 100);
      } catch(e) {
        console.error('[Dropdown Debug] Error:', e);
      }
    })();
  </script>

  <!-- Two Column Layout: Steps Panel (Left) and Step Results (Right) -->
  <div class="flex flex-row gap-4 flex-1 min-h-0 w-full" style="width: 100%; max-width: 100%; min-width: 0; overflow-x: hidden;">
    <!-- Left Panel: Steps Navigation (Hidden on narrow screens) -->
    <div class="hidden lg:flex w-64 flex-shrink-0 flex flex-col min-h-0">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 flex flex-col h-full overflow-hidden">
        <%= render partial: 'projects/views/steps_panel' %>
      </div>
    </div>
    
    <!-- Right Panel: Step Results -->
    <div class="flex-1 flex flex-col min-h-0 min-w-0" style="min-width: 0; max-width: 100%; overflow-x: hidden;">
      <div data-step-selector-target="resultsContainer" class="bg-white rounded-lg shadow-sm border border-gray-200 flex flex-col h-full overflow-hidden w-full" style="width: 100%; max-width: 100%; min-width: 0; overflow-x: hidden;">
        <div class="overflow-y-auto overflow-x-hidden flex-1 min-w-0 w-full" style="width: 100%; max-width: 100%; min-width: 0; overflow-x: hidden;">
          <div class="text-center text-gray-500 py-12 px-6" data-step-selector-target="emptyState">
            <i class="fas fa-mouse-pointer text-5xl mb-4 opacity-30"></i>
            <p class="mb-0 lg:hidden">Select a step from the dropdown above to view its results</p>
            <p class="mb-0 hidden lg:block">Select a step from the left panel to view its results</p>
          </div>
          <div data-step-selector-target="loadingState" style="display: none;" class="text-center py-12 px-6">
            <i class="fas fa-spinner fa-spin text-3xl text-blue-600 mb-4"></i>
            <p class="text-gray-600 mb-0">Loading step results...</p>
          </div>
          <div data-step-selector-target="content" style="display: none; width: 100% !important; max-width: 100% !important; min-width: 0 !important; overflow-x: hidden !important; box-sizing: border-box !important;" class="w-full max-w-full min-w-0 overflow-x-hidden">
            <!-- Step results will be loaded here -->
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


<script>
  function loadFormInRightPanel(formUrl) {
    console.log('[loadFormInRightPanel] Loading form from:', formUrl)
    
    // Find the step-selector controller and its content target
    const stepSelectorElement = document.querySelector('[data-controller*="step-selector"]')
    if (!stepSelectorElement) {
      console.error('[loadFormInRightPanel] Step selector element not found')
      return
    }
    
    // Get the controller instance
    if (!window.Stimulus) {
      console.error('[loadFormInRightPanel] Stimulus not available')
      return
    }
    
    const controller = window.Stimulus.getControllerForElementAndIdentifier(stepSelectorElement, 'step-selector')
    if (!controller || !controller.hasContentTarget) {
      console.error('[loadFormInRightPanel] Step selector controller or content target not found')
      return
    }
    
    // Hide empty state and loading state, show content
    if (controller.hasEmptyStateTarget) {
      controller.emptyStateTarget.style.display = 'none'
    }
    if (controller.hasLoadingStateTarget) {
      controller.loadingStateTarget.style.display = 'block'
    }
    controller.contentTarget.style.display = 'none'
    
    // Fetch the form
    fetch(formUrl, {
      method: 'GET',
      headers: {
        'Accept': 'text/html',
        'X-Requested-With': 'XMLHttpRequest'
      },
      credentials: 'same-origin'
    })
    .then(response => {
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`)
      }
      return response.text()
    })
    .then(html => {
      console.log('[loadFormInRightPanel] Form loaded, length:', html.length)
      
      // Update content with form
      controller.contentTarget.innerHTML = html
      controller.contentTarget.style.display = 'block'
      
      // Hide loading state
      if (controller.hasLoadingStateTarget) {
        controller.loadingStateTarget.style.display = 'none'
      }
      
      // Trigger Stimulus to scan for new controllers in the form
      if (window.Stimulus && window.Stimulus.router && typeof window.Stimulus.router.scan === 'function') {
        setTimeout(() => {
          window.Stimulus.router.scan()
        }, 0)
        
        setTimeout(() => {
          window.Stimulus.router.scan()
        }, 100)
      }
    })
    .catch(error => {
      console.error('[loadFormInRightPanel] Error loading form:', error)
      if (controller.hasLoadingStateTarget) {
        controller.loadingStateTarget.style.display = 'none'
      }
      controller.contentTarget.innerHTML = `
        <div class="alert alert-danger p-4">
          <i class="fas fa-exclamation-triangle me-2"></i>
          Error loading form: ${error.message}
        </div>
      `
      controller.contentTarget.style.display = 'block'
    })
  }
</script>

<style>
  .step-item-hover:hover:not(.active) {
    background-color: #f0f4f8 !important;
    border-left-color: #9ca3af !important;
  }
</style>
