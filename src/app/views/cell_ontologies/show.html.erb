<% content_for :title, "#{@cell_ontology.name} - Cell Ontology - ASAP" %>
<div class="max-w-6xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to "Back to cell ontologies", cell_ontologies_path, class: "text-sm text-indigo-600 hover:text-indigo-800 dark:text-indigo-300 dark:hover:text-indigo-200" %>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
    <div class="border-b border-gray-100 px-6 py-4 dark:border-gray-800">
      <h1 class="text-2xl font-semibold text-gray-900 dark:text-white"><%= @cell_ontology.name %></h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Tag: <%= @cell_ontology.tag.presence || "—" %></p>
    </div>

    <div class="grid grid-cols-1 gap-6 px-6 py-6 md:grid-cols-2">
      <div class="space-y-2 text-sm text-gray-700 dark:text-gray-300">
        <p><span class="font-medium text-gray-900 dark:text-white">Version:</span> <%= @cell_ontology.latest_version.presence || "—" %></p>
        <p><span class="font-medium text-gray-900 dark:text-white">Format:</span> <%= @cell_ontology.format.presence || "—" %></p>
        <p>
          <span class="font-medium text-gray-900 dark:text-white">Obsolete:</span>
          <% if @cell_ontology.obsolete? %>
            <span class="text-amber-800 dark:text-amber-200">Yes</span>
          <% else %>
            No
          <% end %>
        </p>
        <p><span class="font-medium text-gray-900 dark:text-white">Organisms:</span> <%= @organism_names.join(", ") %></p>
        <p>
          <span class="font-medium text-gray-900 dark:text-white">Website:</span>
          <% if @cell_ontology.website_url.present? %>
            <%= link_to @cell_ontology.website_url, @cell_ontology.website_url, class: "text-indigo-600 hover:text-indigo-800 dark:text-indigo-300 dark:hover:text-indigo-200", target: "_blank", rel: "noopener" %>
          <% else %>
            —
          <% end %>
        </p>
        <p>
          <span class="font-medium text-gray-900 dark:text-white">File:</span>
          <% if @cell_ontology.file_download_url.present? %>
            <%= link_to @cell_ontology.file_download_url, @cell_ontology.file_download_url, class: "text-indigo-600 hover:text-indigo-800 dark:text-indigo-300 dark:hover:text-indigo-200", target: "_blank", rel: "noopener" %>
          <% else %>
            —
          <% end %>
        </p>
      </div>

      <div class="space-y-2 text-sm text-gray-700 dark:text-gray-300">
        <p><span class="font-medium text-gray-900 dark:text-white">Original terms:</span> <%= @original_terms %></p>
        <p><span class="font-medium text-gray-900 dark:text-white">Total terms:</span> <%= @total_terms %></p>
      </div>
    </div>

    <div class="border-t border-gray-100 px-6 py-4 dark:border-gray-800">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Original Terms (first 100)</h2>
      <% if @sample_terms.any? %>
        <div class="mt-3 overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-800">
            <thead>
              <tr class="text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">
                <th class="px-2 py-2">Identifier</th>
                <th class="px-2 py-2">Name</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-sm text-gray-700 dark:divide-gray-800 dark:text-gray-300">
              <% @sample_terms.each do |term| %>
                <tr>
                  <td class="px-2 py-2 font-mono text-xs"><%= term.identifier.presence || "—" %></td>
                  <td class="px-2 py-2"><%= term.name.presence || "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">No original terms found.</p>
      <% end %>
    </div>
  </div>
</div>
