<div class="p-2">
  <div class="mb-2 text-sm text-gray-600">
    <%= @nber_genesets %> gene set<%= @nber_genesets != 1 ? 's' : '' %> (FDR <= <%= @h_ge_filters['fdr_cutoff'] %>)
  </div>
  <% if @data.any? %>
  <div class="overflow-x-auto max-h-96 overflow-y-auto">
    <table class="min-w-full divide-y divide-gray-200 text-xs">
      <thead class="bg-gray-50 sticky top-0">
        <tr>
          <% @fields.each do |field| %>
            <th class="px-2 py-1.5 text-left text-xs font-medium text-gray-500 uppercase"><%= field %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-100">
        <% @data.each do |e| %>
          <tr class="hover:bg-gray-50">
            <% @fields.each_with_index do |field, i| %>
              <td class="px-2 py-1.5 whitespace-nowrap">
                <% if i == 0 %>
                  <span class="text-blue-600 font-medium"><%= e[i] %></span>
                <% elsif ['fdr', 'effect size', 'p-value'].include?(field) %>
                  <%= e[i].to_f.round(4) %>
                <% else %>
                  <%= e[i] %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% else %>
    <div class="text-gray-400 text-sm py-4 text-center">No enriched gene sets found.</div>
  <% end %>
</div>
