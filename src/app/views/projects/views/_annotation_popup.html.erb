    if (!apd.evidencesSort) apd.evidencesSort = { up: { col: 1, asc: false }, down: { col: 1, asc: true } }
    var st = apd.evidencesSort[sub]
    if (st.col === colIdx) st.asc = !st.asc
    else { st.col = colIdx; st.asc = true }
    var fn = window._annotPopupRenderPanel
    if (typeof fn === 'function') fn()
  }

