  <% heatmap_gs_options = Array(@heatmap_gene_set_collection_options) %>
  <template id="save-heatmap-gene-set-modal-template">
    <div id="heatmap-gene-set-modal-overlay" style="position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:13000;display:flex;align-items:center;justify-content:center;padding:20px;">
      <div style="background:#fff;border-radius:8px;padding:24px;max-width:560px;width:100%;max-height:80vh;overflow:auto;box-shadow:0 20px 25px -5px rgba(0,0,0,0.1);">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;">
          <h3 style="margin:0;font-size:18px;font-weight:600;color:#111827;">Create heatmap gene set</h3>
          <button type="button" data-role="heatmap-gene-set-close" style="background:none;border:none;font-size:22px;color:#6b7280;cursor:pointer;line-height:1;">x</button>
        </div>
        <form data-role="heatmap-gene-set-form" style="display:flex;flex-direction:column;gap:16px;">
          <div>
            <label style="display:block;font-size:14px;font-weight:500;color:#374151;margin-bottom:6px;">Gene set name <span style="color:#dc2626;">*</span></label>
            <input type="text" data-role="heatmap-gene-set-name" required placeholder="Enter gene set name"
                   style="width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;box-sizing:border-box;">
          </div>
          <div>
            <label style="display:block;font-size:14px;font-weight:500;color:#374151;margin-bottom:6px;">Gene set collection <span style="color:#dc2626;">*</span></label>
            <div data-role="heatmap-gene-set-collection-wrap" style="<%= heatmap_gs_options.empty? ? 'display:none;' : '' %>">
              <select data-role="heatmap-gene-set-collection"
                      style="width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;background:#fff;">
                <% heatmap_gs_options.each do |option| %>
                  <option value="<%= option[:id] %>"><%= option[:label] %></option>
                <% end %>
                <option value="<%= ProjectsController::HEATMAP_GENE_SET_COLLECTION_NEW_ID %>">Create new collection...</option>
              </select>
            </div>
            <div data-role="heatmap-gene-set-new-collection-wrap" style="<%= heatmap_gs_options.empty? ? '' : 'display:none;' %>margin-top:<%= heatmap_gs_options.empty? ? '0' : '10px' %>;">
              <label style="display:block;font-size:13px;font-weight:500;color:#374151;margin-bottom:6px;">New collection name <span style="color:#dc2626;">*</span></label>
              <input type="text" data-role="heatmap-gene-set-new-collection"
                     value="<%= ProjectsController::HEATMAP_GENE_SET_COLLECTION_LABEL %>"
                     placeholder="<%= ProjectsController::HEATMAP_GENE_SET_COLLECTION_LABEL %>"
                     style="width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;box-sizing:border-box;">
            </div>
            <div style="margin-top:6px;font-size:12px;color:#6b7280;">Collections of type &quot;Heatmap selection&quot; only.</div>
          </div>
          <div style="font-size:13px;color:#6b7280;">
            <span data-role="heatmap-gene-set-count">0</span> genes will be saved.
          </div>
          <div style="display:flex;justify-content:flex-end;gap:10px;">
            <button type="button" data-role="heatmap-gene-set-cancel"
