<% step_label = @step&.label.presence || @step&.name.to_s.humanize %>
<% run_attrs = run&.attrs_json.present? ? Basic.safe_parse_json(run.attrs_json, {}) : {} %>
<% displayed_error = @h_res.is_a?(Hash) ? @h_res['displayed_error'] : nil %>
<%
  error_messages =
    if displayed_error.is_a?(Array)
      displayed_error
    elsif displayed_error.present?
      [displayed_error.to_s]
    elsif run&.error.present?
      [run.error.to_s]
    else
      ["The #{step_label.downcase} run failed. Please review parameters and retry."]
    end
%>

<div class="bg-white rounded-lg shadow-sm flex flex-col" style="max-height: calc(100vh - 200px); overflow-y: auto;">
  <div class="border-b border-gray-200 px-6 py-4 sticky top-0 z-10 flex-shrink-0" style="background: linear-gradient(to right, #eff6ff, #eef2ff); background-color: #ffffff;">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900"><%= step_label %> failed</h3>
      <% parsing_reset_allowed = analyzable?(@project) && editable?(@project) && @step&.name == 'parsing' &&
           !single_run_step_locked_from_publication?(@project, @step, runs: run) &&
           ((@project_step && [3, 4].include?(@project_step.status_id)) || (run && [3, 4].include?(run.status_id))) %>
      <% reset_allowed = if @step&.name == 'parsing'
           parsing_reset_allowed
         else
           analyzable?(@project) && editable?(@project) && single_run_step_resettable?(@project, @step, project_step: @project_step, runs: run)
         end %>
      <% if reset_allowed %>
        <% if @step&.name == 'parsing' %>
          <%= reset_parsing_button(@project) %>
        <% else %>
          <button type="button"
                  class="px-3 py-1.5 bg-orange-600 hover:bg-orange-700 text-white rounded-md font-medium text-sm transition-colors cursor-pointer"
                  data-controller="restart-step"
                  data-restart-step-project-id-value="<%= @project.id %>"
                  data-restart-step-step-id-value="<%= @step.id %>"
                  data-restart-step-restart-url-value="<%= restart_step_project_path(@project, return_to_form: 1) %>"
                  data-action="click->restart-step#restart">
            <i class="fas fa-redo sm:mr-1"></i><span class="hidden sm:inline"> Reset</span>
          </button>
        <% end %>
      <% elsif analyzable?(@project) && editable?(@project) && single_run_step_locked_from_publication?(@project, @step, runs: run) %>
        <button type="button" disabled
                class="px-3 py-1.5 bg-gray-300 text-gray-500 rounded-md font-medium text-sm cursor-not-allowed"
                title="<%= publication_locked_step_message %>">
          <i class="fas fa-redo sm:mr-1"></i><span class="hidden sm:inline"> Reset</span>
        </button>
      <% elsif analyzable?(@project) %>
        <button type="button" disabled
                class="px-3 py-1.5 bg-gray-300 text-gray-500 rounded-md font-medium text-sm cursor-not-allowed"
                title="You need edit rights to reset this step">
          <i class="fas fa-redo sm:mr-1"></i><span class="hidden sm:inline"> Reset</span>
        </button>
      <% else %>
        <button type="button" disabled
                class="px-3 py-1.5 bg-gray-300 text-gray-500 rounded-md font-medium text-sm cursor-not-allowed"
                title="You need analysis rights to reset analyses">
          <i class="fas fa-redo sm:mr-1"></i><span class="hidden sm:inline"> Reset</span>
        </button>
      <% end %>
    </div>
  </div>

  <div class="px-6 py-5 space-y-6 flex-1">
    <%= render partial: 'projects/views/run_metadata', locals: { run: run, results: @h_res, queue_position: @queue_position, slurm_queue_hover: @slurm_queue_hover } if run %>

    <div class="bg-white rounded-lg shadow-sm border border-red-200">
      <div class="px-6 py-5">
        <h4 class="text-sm font-semibold text-red-700 uppercase tracking-wide mb-3">Error details</h4>
        <% error_messages.each do |msg| %>
          <div class="alert alert-danger flex items-start gap-3">
            <i class="fas fa-exclamation-circle text-red-600 mt-0.5"></i>
            <span><%= msg %></span>
          </div>
        <% end %>
      </div>
    </div>

    <%= render partial: 'projects/views/run_error_report_form', locals: { run: run } if run %>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-5">
        <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">Submitted parameters</h4>
        <% if run_attrs.present? %>
          <div class="space-y-2">
            <% run_attrs.each do |key, value| %>
              <div class="flex items-start gap-2 py-2 border-b border-gray-100 last:border-b-0">
                <span class="text-sm font-medium text-gray-700 w-40 flex-shrink-0"><%= key %></span>
                <span class="text-sm text-gray-700 break-all"><%= value.is_a?(String) ? value : value.to_json %></span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-600">No parameters available for this run.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

