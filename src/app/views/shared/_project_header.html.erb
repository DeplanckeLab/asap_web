<!-- Top Bar -->
<div class="bg-black shadow-sm border-b border-gray-200 sticky top-0 z-50">
  <div class="px-4 sm:px-6 lg:px-8 w-full">
    <div class="flex items-center justify-between h-16">
      <!-- Left side: Logo and Project Info -->
      <div class="flex items-center space-x-6">
        <!-- ASAP Logo -->
        <div class="flex-shrink-0">
          <%= link_to projects_browse_url,
                class: "inline-block rounded focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-gray-400" do %>
            <%= image_tag "ASAP_sansTagline_White.svg", 
                class: 'h-8 w-32 object-contain', 
                alt: 'ASAP Logo' %>
          <% end %>
        </div>
        
        <!-- Project Info -->
        <% version_label = @project.version_id.presence || '2.0.0' %>
        <% owner_user = @project.user %>
        <% organism = @project.organism %>
        <% owned_by_current_user = user_signed_in? && owner_user&.id == current_user.id %>
        <% share_record = user_signed_in? && !owned_by_current_user ? @project.shares.find_by(user_id: current_user.id) : nil %>
        <% owner_email = owner_user&.email.to_s
           owner_email_part = owner_email.split('@').first if owner_email.present?
           project_status_label =
            if owned_by_current_user
              'Owned by me'
            elsif share_record.present?
              "Shared by #{owner_email_part || 'unknown'}"
            elsif @project.public? && owner_user
              "Owned by #{owner_email_part || 'unknown'}"
            else
              'Read only access'
            end %>
        <% rights_summary = {
             'Edit' => editable?(@project),
             'Clone' => clonable?(@project),
             'Export' => exportable?(@project)
           } %>
        <%
          # Get run counts from project_steps (more efficient than counting runs)
          run_counts = project_run_counts(@project)
          
          # Only load actual runs for statuses that have runs (for dropdown lists)
          runs_by_status = {}
          [:waiting, :running, :completed, :failed].each do |key|
            status_id = { waiting: 1, running: 2, completed: 3, failed: 4 }[key]
            if run_counts[key] > 0
              runs_by_status[key] = @project.runs.includes(:step).where(status_id: status_id).order(created_at: :desc)
            else
              runs_by_status[key] = []
            end
          end
          
          # Get status icons from database with header-specific inactive color
          run_status_icons = [:waiting, :running, :completed, :failed].map do |key|
            config = status_icons_by_key[key].dup
            config[:inactive_color] = 'text-gray-500'
            config[:count] = run_counts[key]
            config
          end
        %>
        <div class="flex items-stretch space-x-4 min-w-0">
            <div class="flex flex-col justify-center min-w-0">
            <h1 class="text-base sm:text-lg font-semibold text-white flex items-center gap-2 min-w-0">
              <span class="block truncate max-w-[10rem] sm:max-w-[14rem] md:max-w-xs lg:max-w-sm xl:max-w-md" title="<%= @project.display_name %>"><%= @project.display_name %></span>
              <span class="inline-flex items-center px-2 py-0.5 text-xs font-semibold tracking-wide uppercase text-gray-100 bg-gray-700 rounded-full border border-gray-600">
                v<%= version_label %>
              </span>
              <% if @project.public? %>
                <span class="inline-flex items-center px-2 py-0.5 text-xs font-semibold tracking-wide uppercase text-emerald-200 bg-emerald-600/30 rounded-full border border-emerald-400/40">
                  Public
                </span>
              <% end %>
            </h1>
              <div class="flex items-center space-x-4 text-sm text-gray-300 min-w-0">
                <span class="flex items-center whitespace-nowrap"><i class="fas fa-circle text-gray-400 mr-1 flex-shrink-0"></i><%= number_with_delimiter(@project.cell_count) %> <%= col_label(@project) %></span>
                <span class="flex items-center min-w-0"><i class="fas fa-dna text-gray-400 mr-1 flex-shrink-0"></i><span class="truncate"><%= formatted_organism_name(@project) %></span></span>
              </div>
            </div>
            <!-- Run Status Icons Section -->
            <div class="hidden xl:flex items-stretch border-l border-gray-700 pl-6 text-sm text-gray-300"
                 data-controller="header-run-status"
                 data-header-run-status-project-id-value="<%= @project.id %>"
                 data-header-run-status-status-icons-value="<%= status_icons_json %>">
              <div class="flex items-center gap-3">
                  <% run_status_icons.each do |status_icon| %>
                    <% 
                      runs_list = runs_by_status[status_icon[:key]]
                      count = status_icon[:count]
                      is_active = count > 0
                      icon_class = status_icon[:icon_base]
                      icon_class += " #{status_icon[:icon_spin]}" if is_active && status_icon[:icon_spin].present?
                      color_class = is_active ? status_icon[:active_color] : status_icon[:inactive_color]
                    %>
                    <div class="relative" data-controller="nav-dropdown" data-status-key="<%= status_icon[:key] %>">
                      <button type="button"
                              class="flex flex-col items-center cursor-pointer hover:opacity-80 transition-opacity <%= is_active ? '' : 'cursor-default' %>"
                              data-nav-dropdown-toggle
                              data-header-run-status-target="statusButton"
                              data-status-key="<%= status_icon[:key] %>"
                              title="<%= status_icon[:label] %> (<%= count %>)"
                              <%= 'disabled' unless is_active %>>
                        <i class="<%= icon_class %> text-base <%= color_class %>" data-header-run-status-target="statusIcon" data-status-key="<%= status_icon[:key] %>"></i>
                        <span class="text-[9px] leading-tight text-gray-400 mt-0.5" data-header-run-status-target="statusCount" data-status-key="<%= status_icon[:key] %>"><%= count %></span>
                      </button>
                      <% if is_active %>
                        <div class="hidden absolute left-1/2 -translate-x-1/2 mt-2 w-56 bg-white text-gray-800 rounded-lg shadow-lg border border-gray-200 z-50 max-h-64 overflow-y-auto"
                             data-nav-menu>
                          <div class="py-1">
                            <div class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wide border-b border-gray-100">
                              <%= status_icon[:label] %> Runs (<%= count %>)
                            </div>
                            <% runs_list.limit(20).each do |run| %>
                              <%= link_to project_path(@project, view: 'analysis', step_id: run.step_id, run_id: run.id), 
                                  class: "block px-3 py-2 text-sm hover:bg-gray-100 transition-colors",
                                  data: { turbo: false } do %>
                                <div class="flex items-center justify-between">
                                  <span class="font-medium text-gray-700">
                                    <%= run.step&.label.presence || run.step&.name.presence || "Run" %> #<%= run.num || run.id %>
                                  </span>
                                  <span class="text-xs text-gray-400">
                                    <%= time_ago_in_words(run.created_at) %> ago
                                  </span>
                                </div>
                              <% end %>
                            <% end %>
                            <% if count > 20 %>
                              <div class="px-3 py-2 text-xs text-gray-400 text-center border-t border-gray-100">
                                ... and <%= count - 20 %> more
                              </div>
                            <% end %>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
              </div>
            </div>
            <div class="hidden xl:flex items-stretch border-l border-gray-700 pl-6 text-sm text-gray-300">
              <div class="flex flex-col justify-center">
                <span class="text-xs text-gray-300"><%= project_status_label %></span>
                <div class="flex items-center gap-3 mt-1">
                  <% icon_map = {
                    'Edit' => 'fa-edit',
                    'Clone' => 'fa-clone',
                    'Export' => 'fa-download'
                  } %>
                  <% rights_summary.each do |label, allowed| %>
                    <i class="fas <%= icon_map[label] %> text-base <%= allowed ? 'text-emerald-300' : 'text-gray-400' %>" 
                       title="<%= label %>: <%= allowed ? 'Allowed' : 'Not allowed' %>"></i>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      
      <!-- Center: ASAP Version -->
      <div class="flex-1 flex justify-center">
      </div>
      
      <!-- Right side: Navigation Icons -->
      <!-- Hamburger Menu Button (Mobile) -->
      <div class="lg:hidden relative" data-controller="mobile-menu">
        <button type="button" 
                class="p-2 rounded-lg text-gray-300 hover:bg-gray-700 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-gray-600 transition"
                aria-expanded="false" 
                aria-label="Toggle navigation"
                data-mobile-menu-target="toggle"
                data-action="click->mobile-menu#toggle">
          <svg class="shrink-0 size-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
        
        <!-- Mobile Dropdown Menu -->
        <div class="hidden absolute right-0 mt-2 w-64 bg-white shadow-lg rounded-lg border border-gray-200 z-[1000] max-h-[80vh] overflow-y-auto"
             data-mobile-menu-target="menu">
          <div class="py-2">
            <!-- Summary -->
            <%= link_to project_path(@project, view: 'summary'), 
                class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" do %>
              <i class="fas fa-info-circle text-lg mr-3"></i>
              Summary
            <% end %>
            
            <!-- Visualization -->
            <%= link_to project_path(@project, view: 'visualization'), 
                class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" do %>
              <i class="fas fa-chart-line text-lg mr-3"></i>
              Visualization
            <% end %>
            
            <!-- Analysis -->
            <%= link_to project_path(@project, view: 'analysis'), 
                class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" do %>
              <i class="fas fa-microscope text-lg mr-3"></i>
              Analysis
            <% end %>
            
            <!-- Data -->
            <%= link_to project_path(@project, view: 'data'), 
                class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" do %>
              <i class="fas fa-database text-lg mr-3"></i>
              Data
            <% end %>
            
            <!-- Settings -->
            <%= link_to project_path(@project, view: 'settings'), 
                class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" do %>
              <i class="fas fa-cog text-lg mr-3"></i>
              Settings
            <% end %>
            
            <div class="border-t border-gray-200 my-1"></div>
            
            <!-- Info Section -->
            <div class="px-4 py-2">
              <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1">Info</p>
            </div>
            <% info_menu_links.each do |link| %>
              <a class="flex items-start gap-3 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
                 href="<%= link[:path] %>">
                <div class="flex-1">
                  <p class="font-medium"><%= link[:label] %></p>
                  <% if link[:description].present? %>
                    <p class="text-xs text-gray-500 mt-0.5"><%= link[:description] %></p>
                  <% end %>
                </div>
              </a>
            <% end %>
            
            <% if admin? %>
              <div class="border-t border-gray-200 my-1"></div>
              
              <!-- Admin Section -->
              <div class="px-4 py-2">
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1">Admin</p>
              </div>
              <% admin_menu_links.each do |link| %>
                <a class="flex items-start gap-3 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
                   href="<%= link[:path] %>">
                  <div class="flex-1">
                    <p class="font-medium"><%= link[:label] %></p>
                    <% if link[:description].present? %>
                      <p class="text-xs text-gray-500 mt-0.5"><%= link[:description] %></p>
                    <% end %>
                  </div>
                </a>
              <% end %>
            <% end %>
            
            <div class="border-t border-gray-200 my-1"></div>
            
            <%= render "shared/user_menu_mobile" %>
            
            <div class="border-t border-gray-200 my-1"></div>
            
            <!-- Back to Projects -->
            <%= link_to projects_browse_url, 
                class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" do %>
              <i class="fas fa-arrow-left text-lg mr-3"></i>
              Back to Projects
            <% end %>
          </div>
        </div>
      </div>
      <!-- End Hamburger Menu Button -->
      
      <!-- Desktop Menu Items -->
      <div class="hidden lg:flex items-stretch gap-1">
        <%= link_to project_path(@project, view: 'summary'), 
            class: "p-2 rounded-lg text-gray-300 hover:bg-gray-700", title: "Summary" do %><i class="fas fa-info-circle text-lg"></i><% end %><%= link_to project_path(@project, view: 'visualization'), 
            class: "p-2 rounded-lg text-gray-300 hover:bg-gray-700", title: "Visualization" do %><i class="fas fa-chart-line text-lg"></i><% end %><%= link_to project_path(@project, view: 'analysis'), 
            class: "p-2 rounded-lg text-gray-300 hover:bg-gray-700", title: "Analysis" do %><i class="fas fa-microscope text-lg"></i><% end %><%= link_to project_path(@project, view: 'data'), 
            class: "p-2 rounded-lg bg-gray-700 text-white", title: "Data" do %><i class="fas fa-database text-lg"></i><% end %><%= link_to project_path(@project, view: 'settings'), 
            class: "p-2 rounded-lg text-gray-300 hover:bg-gray-700", title: "Settings" do %><i class="fas fa-cog text-lg"></i><% end %>
        
        <%= header_separator %>
        
        <!-- Info Dropdown -->
        <div class="relative"
             id="info-nav-dropdown"
             data-controller="nav-dropdown">
          <button type="button"
                  class="p-2 rounded-lg text-gray-300 hover:bg-gray-700 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-gray-600 transition flex items-center gap-2"
                  title="Open access resources"
                  data-nav-dropdown-toggle>
            <i class="fas fa-file-alt text-lg"></i>
            <span class="hidden sm:inline text-sm">Info</span>
            <i class="fas fa-chevron-down text-xs"></i>
          </button>
          <%= render "shared/info_menu",
                      wrapper_classes: "hidden absolute right-0 mt-2 min-w-56 bg-white text-gray-800 rounded-lg shadow-lg border border-gray-200 z-50",
                      data_attributes: { nav_menu: true } %>
        </div>
        
      <% if admin? %>
        <div class="relative"
             id="admin-tools-dropdown"
             data-controller="nav-dropdown">
          <button id="admin-tools-button"
                  class="p-2 rounded-lg text-gray-300 hover:bg-gray-700 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-gray-600 transition flex items-center gap-2"
                  title="Admin tools"
                  data-nav-dropdown-toggle>
              <i class="fas fa-tools text-lg"></i>
              <span class="hidden sm:inline text-sm">Admin</span>
              <i class="fas fa-chevron-down text-xs"></i>
            </button>
          <%= render "shared/admin_menu",
                      wrapper_classes: "hidden absolute right-0 mt-2 w-56 bg-white text-gray-800 rounded-lg shadow-lg border border-gray-200 z-50",
                      data_attributes: { nav_menu: true } %>
        </div>
        <% end %>
        
        <%= render "shared/user_menu", wrapper_classes: "relative ml-4" %>
        
        <!-- Back to Projects -->
        <%= link_to projects_browse_url, 
            class: "p-2 rounded-lg text-gray-300 hover:bg-gray-700",
            title: "Back to Projects" do %>
          <i class="fas fa-arrow-left text-lg"></i>
        <% end %>
      </div>
      <!-- End Desktop Menu Items -->
    </div>
  </div>
</div>

