      ens = String(row.ensembl_id).trim();
    } else if (row.gene_id != null && /^ENS[0-9A-Za-z._-]+/i.test(String(row.gene_id).trim())) {
      ens = String(row.gene_id).trim();
    }
    var symLookup = '';
    if (row.gene != null && String(row.gene).trim() !== '') {
      symLookup = String(row.gene).trim();
    } else if (row.gene_id != null && !/^ENS[0-9A-Za-z._-]+$/i.test(String(row.gene_id).trim())) {
      symLookup = String(row.gene_id).trim();
    }
    var remoteGid = '';
    var st = row.stable_id != null ? String(row.stable_id).trim() : '';
    var gidRaw = row.gene_id != null ? String(row.gene_id).trim() : '';
    if (/^\d+$/.test(st)) remoteGid = st;
