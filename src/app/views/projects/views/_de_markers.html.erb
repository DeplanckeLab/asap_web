        if (data.bookmark_status && typeof window.applyAnnotBookmarkButtonStatus === 'function') {
          var selector = '.category-annot-btn[data-metadata-id="' + String(metadataId) + '"][data-cat-idx="' + String(catIdx) + '"]';
          document.querySelectorAll(selector).forEach(function(btn) {
