<% if @step %>
  <%# Check if there's a step-specific partial first %>
  <% step_partial_path = "projects/views/#{@step.name}" %>
  <% partial_exists = lookup_context.template_exists?(step_partial_path, [], true) %>
  <% if partial_exists %>
    <%# Render step-specific partial if it exists %>
    <%= render partial: step_partial_path %>
  <% else %>
    <%# Otherwise render the standard step view %>
    <%= render 'projects/views/std_step' %>
  <% end %>
<% else %>
  <div class="alert alert-warning">
    <i class="fas fa-exclamation-triangle me-2"></i>Step not found.
  </div>
<% end %>

