                    style="border:1px solid #d1d5db; border-radius:6px; padding:7px 8px; font-size:13px; background:#fff;"></select>
            <div style="font-size:12px; color:#6b7280;">You can update your own uncommented checkpoints and uncommented checkpoints created by someone else. Checkpoints that already have comments stay unchanged.</div>
          </div>
          <div id="heatmap-checkpoint-save-existing-empty" style="display:none; padding:6px 0 0 24px; font-size:12px; color:#6b7280;">
