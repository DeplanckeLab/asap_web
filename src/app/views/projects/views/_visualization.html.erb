function submitNewAnnotation(confirmed) {
  var overlay = document.getElementById('annotation-popup-overlay')
  if (overlay && overlay.dataset.annotable !== 'true') {
    setNewAnnotationStatus('You should be logged in and associate your ORCID ID to your account to submit annotations.')
    return
  }

  var formState = _annotPopupData.newForm || {}
  if (formState.submitting) return

  var validation = newAnnotationFormValidation(formState)
  if (!validation.valid) {
    var messages = []
    if (validation.ontologyMissing) messages.push('Add at least one ontology term before submitting.')
    if (validation.ontologyTooMany) messages.push('This annotation type allows only one ontology term.')
    setNewAnnotationStatus(messages.join('\n'), { pendingConfirm: false })
    return
  }

  var upIds = {}
  ;(formState.upGenes || []).forEach(function(g) { upIds[String(g.stableId)] = true })
  var overlap = (formState.downGenes || []).some(function(g) { return upIds[String(g.stableId)] })
  if (overlap) {
    setNewAnnotationStatus('The same gene cannot be both up-regulated and down-regulated.', { pendingConfirm: false })
    return
  }

  var createUrl = overlay && overlay.dataset.createClaUrl
  if (!createUrl) {
    setNewAnnotationStatus('Create annotation endpoint is not configured.')
    return
  }

  var csrfToken = document.querySelector('meta[name="csrf-token"]') && document.querySelector('meta[name="csrf-token"]').getAttribute('content')
  var payload = {
    annot_id: _annotPopupData.metadataId,
    cat_idx: _annotPopupData.catIdx,
    cat_name: _annotPopupData.catName,
    name: formState.name || '',
    comment: formState.comment || '',
    ontology_term_type_id: formState.annotationTypeId || '',
    cell_ontology_term_ids: (formState.ontologyTerms || []).map(function(t) { return t.id }).join(','),
    up_gene_ids: (formState.upGenes || []).map(function(g) { return g.stableId }).join(','),
    down_gene_ids: (formState.downGenes || []).map(function(g) { return g.stableId }).join(','),
    confirm: confirmed ? '1' : '0'
  }

  setNewAnnotationStatus('Submitting annotation...', { submitting: true, pendingConfirm: !!formState.pendingConfirm })

  fetch(createUrl, {
    method: 'POST',
    headers: {
      'X-CSRF-Token': csrfToken || '',
      'Accept': 'application/json',
      'Content-Type': 'application/json'
    },
    credentials: 'same-origin',
    body: JSON.stringify(payload)
  })
    .then(function(r) {
      return r.json().then(function(data) {
        return { ok: r.ok, status: r.status, data: data || {} }
      }).catch(function() {
        throw new Error('HTTP ' + r.status)
      })
    })
    .then(function(res) {
      var data = res.data || {}
      if (data.status === 'ok') {
        reloadAnnotationClasAfterCreate()
        return
      }
      if (data.status === 'warning' && data.requires_confirm) {
        var warnings = Array.isArray(data.warnings) ? data.warnings : []
        setNewAnnotationStatus(
          (warnings.length ? warnings.join('\n') + '\n\n' : '') + 'Click Confirm submit to save this annotation anyway.',
          { pendingConfirm: true, submitting: false }
        )
        return
      }
      var errors = Array.isArray(data.errors) ? data.errors : []
      if (!errors.length && data.error) errors = [String(data.error)]
      if (!errors.length) errors = ['Failed to create annotation (HTTP ' + res.status + ').']
      setNewAnnotationStatus(errors.join('\n'), { pendingConfirm: false, submitting: false })
    })
    .catch(function(err) {
      setNewAnnotationStatus('Failed to create annotation: ' + err.message, { pendingConfirm: false, submitting: false })
    })
}
window.submitNewAnnotation = submitNewAnnotation
