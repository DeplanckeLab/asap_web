<% if editable?(@project) %>
<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
  <div class="mb-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Settings</h2>
    <p class="text-gray-600">Project configuration and management options</p>
  </div>

  <!-- Settings Sections -->
  <div class="space-y-6">
    <% if @project.project_type_id.nil? && @project.version_id.to_i < 8 %>
      <!-- Project Type (legacy ASAP < 8 with unknown type) -->
      <div class="bg-gray-50 rounded-lg p-6"
           data-controller="project-type-settings"
           data-project-type-settings-url-value="<%= project_path(@project) %>">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Project Type</h3>

        <div class="space-y-4">
          <div class="p-3 bg-amber-50 border border-amber-200 rounded-md">
            <p class="text-sm text-amber-800">
              This project was created with a version of ASAP lower than 8 and has no project type set.
              Choose Single-cell or Bulk so this project can be integrated with other projects of the same type.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-end gap-3">
            <div class="flex-1 max-w-md">
              <label for="settings_project_type_id" class="block text-sm font-medium text-gray-900 mb-2">
                Project Type
              </label>
              <select id="settings_project_type_id"
                      data-project-type-settings-target="select"
                      data-action="change->project-type-settings#onChange"
                      class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
                <option value="">Select project type</option>
                <% (@project_types || []).each do |project_type| %>
                  <option value="<%= project_type.id %>"><%= project_type.name %></option>
                <% end %>
              </select>
            </div>
            <button type="button"
                    data-project-type-settings-target="saveButton"
                    data-action="click->project-type-settings#save"
                    disabled
                    class="px-4 py-2 bg-blue-600 text-white text-sm rounded-md hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed">
              Save Project Type
            </button>
          </div>

          <div data-project-type-settings-target="message" class="hidden">
            <p class="text-sm px-3 py-2 rounded" data-project-type-settings-target="messageText"></p>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Project collection (umbrella) -->
    <div class="bg-gray-50 rounded-lg p-6"
         data-controller="project-collection-settings">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Project collection</h3>
      <p class="text-sm text-gray-600 mb-4">
        Group this project under one umbrella collection.
        A project can belong to only one collection.
        <% if @can_edit_any_project_collection %>
          As admin you can assign any collection and edit its title/description.
        <% else %>
          You can clear membership, create a new collection, or assign to a collection you created.
          Catalog-backed collections are managed by admins.
        <% end %>
      </p>

      <%= form_with url: project_path(@project), method: :patch, local: true, class: "space-y-4" do %>
        <%
          current_mode =
            if @current_project_collection.present?
              'existing'
            else
              'none'
            end
          assignable_collections = Array(@project_collections).select do |collection|
            @can_edit_any_project_collection || collection.owned_by?(current_user)
          end
        %>
        <div>
          <label for="project_collection_mode" class="block text-sm font-medium text-gray-900 mb-2">Membership</label>
          <select id="project_collection_mode"
                  name="project_collection_assignment[mode]"
                  data-project-collection-settings-target="mode"
                  data-action="change->project-collection-settings#onModeChange"
                  class="w-full max-w-md px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
            <option value="none" <%= 'selected' if current_mode == 'none' %>>No collection</option>
            <% if assignable_collections.any? || @can_edit_any_project_collection %>
              <option value="existing" <%= 'selected' if current_mode == 'existing' && (@can_edit_any_project_collection || @current_project_collection&.owned_by?(current_user)) %>>Existing collection</option>
            <% end %>
            <option value="new">Create new collection</option>
          </select>
          <% if @current_project_collection&.catalog_backed? && !@can_edit_any_project_collection %>
            <p class="mt-2 text-xs text-gray-500">
              Current: <%= @current_project_collection.display_title %> (<%= @current_project_collection.source %>).
              Choose "No collection" or create your own to change membership.
            </p>
          <% end %>
        </div>

        <div data-project-collection-settings-target="existingFields"
             class="<%= (current_mode == 'existing' && (@can_edit_any_project_collection || @current_project_collection&.owned_by?(current_user))) ? '' : 'hidden' %> space-y-4">
          <div>
            <label for="project_collection_id" class="block text-sm font-medium text-gray-900 mb-2">Collection</label>
            <select id="project_collection_id"
                    name="project_collection_assignment[project_collection_id]"
                    data-project-collection-settings-target="collectionSelect"
                    data-action="change->project-collection-settings#onCollectionChange"
                    class="w-full max-w-xl px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
              <option value="">Select a collection</option>
              <% assignable_collections.each do |collection| %>
                <option value="<%= collection.id %>"
                        data-title="<%= collection.title.to_s %>"
                        data-description="<%= collection.description.to_s %>"
                        <%= 'selected' if @current_project_collection&.id == collection.id %>>
                  <%= collection.display_title %>
                  <% if collection.source.present? && collection.source != 'manual' %>
                    (<%= collection.source %>)
                  <% end %>
                </option>
              <% end %>
            </select>
          </div>
        </div>

        <div data-project-collection-settings-target="metadataFields"
             class="<%= current_mode == 'none' ? 'hidden' : '' %> space-y-4">
          <div>
            <label for="project_collection_title" class="block text-sm font-medium text-gray-900 mb-2">Collection title</label>
            <input type="text"
                   id="project_collection_title"
                   name="project_collection_assignment[title]"
                   value="<%= @current_project_collection&.title %>"
                   data-project-collection-settings-target="title"
                   class="w-full max-w-xl px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                   placeholder="Umbrella title shared by member projects" />
          </div>
          <div>
            <label for="project_collection_description" class="block text-sm font-medium text-gray-900 mb-2">Collection description</label>
            <textarea id="project_collection_description"
                      name="project_collection_assignment[description]"
                      rows="3"
                      data-project-collection-settings-target="description"
                      class="w-full max-w-xl px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                      placeholder="Optional description"><%= @current_project_collection&.description %></textarea>
          </div>
        </div>

        <div>
          <button type="submit"
                  class="px-4 py-2 bg-blue-600 text-white text-sm rounded-md hover:bg-blue-700">
            Save collection
          </button>
        </div>
      <% end %>
    </div>

    <!-- Privacy Settings -->
    <div class="bg-gray-50 rounded-lg p-6" data-controller="public-toggle" 
         data-public-toggle-url-value="<%= toggle_public_project_path(@project) %>"
         data-public-toggle-current-value="<%= @project.is_public? %>"
         data-public-toggle-being-published-value="<%= @project.publishing? %>">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Privacy Settings</h3>
      
      <div class="space-y-4">
        <% if @project.sandbox? %>
          <div class="p-3 bg-amber-50 border border-amber-200 rounded-md">
            <p class="text-sm text-amber-800">
              Sandbox projects cannot be made public. Clone this project into a regular account project to enable public sharing.
            </p>
          </div>
        <% end %>

        <!-- Public Access -->
        <div class="flex items-center justify-between">
          <div>
            <h4 class="text-sm font-medium text-gray-900">Public Access</h4>
            <p class="text-sm text-gray-600">Allow other users to view and clone this project</p>
            <% if @project.publishing? %>
              <p class="text-xs text-blue-600 mt-1">
                Publishing in progress: exporting and validating H5AD files. Toggle off to cancel.
              </p>
            <% elsif !@project.compliance_valid? %>
              <%
                schema_label = @project.compliance_schemas.first&.name || 'compliance'
              %>
              <p class="text-xs text-amber-600 mt-1">
                <% if @project.cxg_validation_result.nil? %>
                  Requires <%= schema_label %> check before making public.
                <% else %>
                  Project must pass <%= schema_label %> check before making public.
                <% end %>
              </p>
            <% end %>
          </div>
          <label class="relative inline-flex items-center <%= @project.sandbox? ? 'cursor-not-allowed opacity-60' : 'cursor-pointer' %>">
            <input type="checkbox" 
                   id="public_toggle" 
                   <%= 'checked' if @project.is_public? || @project.publishing? %> 
                   <%= 'disabled' if @project.sandbox? %>
                   data-action="change->public-toggle#toggle"
                   data-public-toggle-target="checkbox"
                   class="sr-only peer">
            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
          </label>
        </div>
        
        <!-- Status message -->
        <div data-public-toggle-target="message" class="hidden">
          <p class="text-sm px-3 py-2 rounded" data-public-toggle-target="messageText"></p>
        </div>

        <% if @project.publishing? %>
          <div class="text-sm text-blue-700 bg-blue-50 border border-blue-200 rounded px-3 py-2">
            Publishing… H5AD export and scFAIR validation are running. The project stays private until they succeed.
          </div>
        <% elsif @project.publication_error.present? %>
          <div class="text-sm text-red-700 bg-red-50 border border-red-200 rounded px-3 py-2">
            Last publication attempt failed: <%= @project.publication_error %>
          </div>
        <% end %>

        <% if @project.is_public? %>
          <div class="text-sm text-gray-600">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800 mr-2">
              ASAP<%= @project.public_id %>
            </span>
            Published on <%= @project.public_at&.strftime("%B %d, %Y") %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- User Rights -->
    <div class="bg-gray-50 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">User Rights</h3>
      
      <div class="mb-4 p-3 bg-amber-50 border border-amber-200 rounded-md">
        <p class="text-sm text-amber-800">Please be aware that you have to comply with the usual ethical and legal rules for sharing this dataset. In the case of human data, you must ensure that the underlying personal data is not accessible.</p>
      </div>

      <!-- Batch Add Users -->
      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-2">Batch Add Users</label>
        <textarea id="batch_emails" rows="3" placeholder="Enter email addresses (one per line)" 
                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"></textarea>
        <div class="flex items-center gap-4 mt-2">
          <label class="flex items-center gap-2 text-sm text-gray-700">
            <input type="checkbox" id="batch_analyze_perm" checked class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
            Analyze
          </label>
          <label class="flex items-center gap-2 text-sm text-gray-700">
            <input type="checkbox" id="batch_export_perm" checked class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
            Export
          </label>
          <button type="button"
                  class="inline-flex items-center justify-center text-gray-500 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1 rounded-full"
                  data-rights-help="open"
                  aria-label="Explain user rights"
                  title="Explain user rights">
            <i class="far fa-question-circle text-base" aria-hidden="true"></i>
          </button>
          <button id="batch_upd_btn" class="px-3 py-1 bg-blue-600 text-white text-sm rounded-md hover:bg-blue-700">
            Batch Add
          </button>
        </div>
      </div>

      <!-- Users Table -->
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-100">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
              <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">View</th>
              <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
                <span class="inline-flex items-center justify-center gap-1">
                  Analyze
                  <button type="button"
                          class="inline-flex items-center justify-center text-gray-400 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1 rounded-full normal-case"
                          data-rights-help="open"
                          aria-label="Explain user rights"
                          title="Explain user rights">
                    <i class="far fa-question-circle text-sm" aria-hidden="true"></i>
                  </button>
                </span>
              </th>
              <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
                <span class="inline-flex items-center justify-center gap-1">
                  Export
                  <button type="button"
                          class="inline-flex items-center justify-center text-gray-400 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1 rounded-full normal-case"
                          data-rights-help="open"
                          aria-label="Explain user rights"
                          title="Explain user rights">
                    <i class="far fa-question-circle text-sm" aria-hidden="true"></i>
                  </button>
                </span>
              </th>
              <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <!-- Owner Row -->
            <tr class="bg-blue-50">
              <td class="px-4 py-3 text-sm font-medium text-gray-900">
                Me (Owner)
              </td>
              <td class="px-4 py-3 text-center">
                <input type="checkbox" checked disabled class="rounded border-gray-300 text-blue-600">
              </td>
              <td class="px-4 py-3 text-center">
                <input type="checkbox" checked disabled class="rounded border-gray-300 text-blue-600">
              </td>
              <td class="px-4 py-3 text-center">
                <input type="checkbox" checked disabled class="rounded border-gray-300 text-blue-600">
              </td>
              <td class="px-4 py-3 text-center">
                <span class="text-xs text-gray-400">Owner</span>
              </td>
            </tr>
            
            <!-- Shared Users -->
            <% if @shares.present? %>
              <% @shares.each do |share| %>
                <tr id="share_row_<%= share.id %>" class="hover:bg-gray-50">
                  <td class="px-4 py-3 text-sm text-gray-900">
                    <%= share.user&.email || share.email %>
                  </td>
                  <td class="px-4 py-3 text-center">
                    <input type="checkbox" <%= 'checked' if share.view_perm? %> disabled 
                           class="rounded border-gray-300 text-blue-600">
                  </td>
                  <td class="px-4 py-3 text-center">
                    <input type="checkbox" name="shares[<%= share.id %>][analyze_perm]" <%= 'checked' if share.analyze_perm? %> 
                           class="share-perm rounded border-gray-300 text-blue-600 focus:ring-blue-500"
                           data-share-id="<%= share.id %>" data-perm-type="analyze">
                  </td>
                  <td class="px-4 py-3 text-center">
                    <input type="checkbox" name="shares[<%= share.id %>][export_perm]" <%= 'checked' if share.export_perm? %> 
                           class="share-perm rounded border-gray-300 text-blue-600 focus:ring-blue-500"
                           data-share-id="<%= share.id %>" data-perm-type="export">
                  </td>
                  <td class="px-4 py-3 text-center">
                    <button type="button" class="delete-share text-red-600 hover:text-red-800 text-sm"
                            data-share-id="<%= share.id %>">
                      Remove
                    </button>
                  </td>
                </tr>
              <% end %>
            <% end %>
            
            <!-- Add New User Row -->
            <tr id="new_user_row" class="hidden bg-green-50">
              <td class="px-4 py-3">
                <input type="email" id="new_user_email" placeholder="Enter email address"
                       class="w-full px-2 py-1 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
              </td>
              <td class="px-4 py-3 text-center">
                <input type="checkbox" id="new_user_view_perm" checked disabled class="rounded border-gray-300 text-blue-600">
              </td>
              <td class="px-4 py-3 text-center">
                <input type="checkbox" id="new_user_analyze_perm" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
              </td>
              <td class="px-4 py-3 text-center">
                <input type="checkbox" id="new_user_export_perm" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
              </td>
              <td class="px-4 py-3 text-center">
                <button type="button" id="invite_user_btn" class="px-2 py-1 bg-green-600 text-white text-xs rounded hover:bg-green-700">
                  Invite
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Add User Button -->
      <div class="mt-4">
        <button type="button" id="add_user_btn" class="px-3 py-2 bg-gray-200 text-gray-700 text-sm rounded-md hover:bg-gray-300">
          Add New User
        </button>
      </div>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="mt-8 flex justify-between">
    <div class="flex space-x-3">
      <button class="px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700">
        <i class="fas fa-trash mr-2"></i>Delete Project
      </button>
    </div>
    
    <div class="flex space-x-3">
      <button class="px-4 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400">
        Cancel
      </button>
      <button class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">
        <i class="fas fa-save mr-2"></i>Save Changes
      </button>
    </div>
  </div>
</div>

<%= javascript_tag do %>
document.addEventListener('DOMContentLoaded', function() {
  // Add New User Button
  const addUserBtn = document.getElementById('add_user_btn');
  const newUserRow = document.getElementById('new_user_row');
  
  if (addUserBtn && newUserRow) {
    addUserBtn.addEventListener('click', function() {
      newUserRow.classList.remove('hidden');
      addUserBtn.classList.add('hidden');
      document.getElementById('new_user_email').focus();
    });
  }
  
  // Invite User Button
  const inviteUserBtn = document.getElementById('invite_user_btn');
  if (inviteUserBtn) {
    inviteUserBtn.addEventListener('click', function() {
      const email = document.getElementById('new_user_email').value.trim().toLowerCase();
      const analyzePerm = document.getElementById('new_user_analyze_perm').checked;
      const exportPerm = document.getElementById('new_user_export_perm').checked;
      
      if (!validateEmail(email)) {
        alert('Please enter a valid email address.');
        return;
      }
      
      // Send AJAX request to create share
      fetch('<%= shares_path %>', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({
          share: {
            email: email,
            view_perm: true,
            analyze_perm: analyzePerm,
            export_perm: exportPerm
          },
          project_key: '<%= @project.key %>'
        })
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          location.reload();
        } else {
          alert(data.error || 'Failed to add user.');
        }
      })
      .catch(error => {
        console.error('Error:', error);
        alert('Failed to add user.');
      });
    });
  }
  
  // Batch Add Users Button
  const batchUpdBtn = document.getElementById('batch_upd_btn');
  if (batchUpdBtn) {
    batchUpdBtn.addEventListener('click', function() {
      const emails = document.getElementById('batch_emails').value.trim().toLowerCase();
      const analyzePerm = document.getElementById('batch_analyze_perm').checked;
      const exportPerm = document.getElementById('batch_export_perm').checked;
      
      if (!emails) {
        alert('Please enter at least one email address.');
        return;
      }
      
      fetch('<%= batch_add_shares_path %>', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({
          batch_emails: emails,
          batch_analyze_perm: analyzePerm,
          batch_export_perm: exportPerm,
          project_key: '<%= @project.key %>'
        })
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          location.reload();
        } else {
          alert(data.error || 'Failed to add users.');
        }
      })
      .catch(error => {
        console.error('Error:', error);
        alert('Failed to add users.');
      });
    });
  }
  
  // Delete Share Buttons
  document.querySelectorAll('.delete-share').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const shareId = this.dataset.shareId;
      if (confirm('Are you sure you want to remove this user?')) {
        fetch('<%= shares_path %>/' + shareId, {
          method: 'DELETE',
          headers: {
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
          }
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            document.getElementById('share_row_' + shareId).remove();
          } else {
            alert(data.error || 'Failed to remove user.');
          }
        })
        .catch(error => {
          console.error('Error:', error);
          alert('Failed to remove user.');
        });
      }
    });
  });
  
  // Update Share Permissions
  document.querySelectorAll('.share-perm').forEach(function(checkbox) {
    checkbox.addEventListener('change', function() {
      const shareId = this.dataset.shareId;
      const permType = this.dataset.permType;
      const value = this.checked;
      
      fetch('<%= shares_path %>/' + shareId, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({
          share: {
            [permType + '_perm']: value
          }
        })
      })
      .then(response => response.json())
      .then(data => {
        if (!data.success) {
          alert(data.error || 'Failed to update permission.');
          this.checked = !value;
        }
      })
      .catch(error => {
        console.error('Error:', error);
        alert('Failed to update permission.');
        this.checked = !value;
      });
    });
  });
  
  function validateEmail(email) {
    const re = /^(([^<>()[\]\\.,;:\s@\"]+(\.[^<>()[\]\\.,;:\s@\"]+)*)|(\".+\"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
    return re.test(email);
  }
});
<% end %>

<% else %>
<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
  <div class="mb-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Settings</h2>
    <p class="text-gray-600">Read-only project settings</p>
  </div>

  <div class="space-y-6">
    <div class="bg-gray-50 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Privacy Settings</h3>
      <div class="space-y-2 text-sm text-gray-700">
        <div>
          <span class="font-medium">Public access:</span>
          <span><%= @project.is_public? ? 'Enabled' : 'Disabled' %></span>
        </div>
        <% if @project.is_public? %>
          <div>
            <span class="font-medium">Public ID:</span>
            <span>ASAP<%= @project.public_id %></span>
          </div>
          <div>
            <span class="font-medium">Published on:</span>
            <span><%= @project.public_at&.strftime("%B %d, %Y") || 'N/A' %></span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="bg-gray-50 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">User Rights</h3>
      <div class="mb-4 p-3 bg-blue-50 border border-blue-200 rounded-md">
        <p class="text-sm text-blue-800">You can view settings but cannot modify them with your current permissions.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-100">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
              <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">View</th>
              <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
                <span class="inline-flex items-center justify-center gap-1">
                  Analyze
                  <button type="button"
                          class="inline-flex items-center justify-center text-gray-400 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1 rounded-full normal-case"
                          data-rights-help="open"
                          aria-label="Explain user rights"
                          title="Explain user rights">
                    <i class="far fa-question-circle text-sm" aria-hidden="true"></i>
                  </button>
                </span>
              </th>
              <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
                <span class="inline-flex items-center justify-center gap-1">
                  Export
                  <button type="button"
                          class="inline-flex items-center justify-center text-gray-400 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1 rounded-full normal-case"
                          data-rights-help="open"
                          aria-label="Explain user rights"
                          title="Explain user rights">
                    <i class="far fa-question-circle text-sm" aria-hidden="true"></i>
                  </button>
                </span>
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <tr class="bg-blue-50">
              <td class="px-4 py-3 text-sm font-medium text-gray-900">Owner</td>
              <td class="px-4 py-3 text-center"><input type="checkbox" checked disabled class="rounded border-gray-300 text-blue-600"></td>
              <td class="px-4 py-3 text-center"><input type="checkbox" checked disabled class="rounded border-gray-300 text-blue-600"></td>
              <td class="px-4 py-3 text-center"><input type="checkbox" checked disabled class="rounded border-gray-300 text-blue-600"></td>
            </tr>
            <% (@shares || []).each do |share| %>
              <tr>
                <td class="px-4 py-3 text-sm text-gray-900"><%= share.user&.email || share.email %></td>
                <td class="px-4 py-3 text-center"><input type="checkbox" <%= 'checked' if share.view_perm? %> disabled class="rounded border-gray-300 text-blue-600"></td>
                <td class="px-4 py-3 text-center"><input type="checkbox" <%= 'checked' if share.analyze_perm? %> disabled class="rounded border-gray-300 text-blue-600"></td>
                <td class="px-4 py-3 text-center"><input type="checkbox" <%= 'checked' if share.export_perm? %> disabled class="rounded border-gray-300 text-blue-600"></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<% end %>

<div id="user-rights-help-modal"
     class="hidden fixed inset-0 z-50"
     role="dialog"
     aria-modal="true"
     aria-labelledby="user-rights-help-title">
  <div class="absolute inset-0 bg-black/50 cursor-default" data-rights-help="close"></div>
  <div class="absolute inset-0 overflow-y-auto pointer-events-none">
    <div class="flex min-h-full items-center justify-center p-4">
      <div class="bg-white rounded-lg shadow-xl max-w-lg w-full max-h-[85vh] overflow-hidden flex flex-col border border-gray-200 pointer-events-auto">
        <div class="px-5 py-4 border-b border-gray-200 flex items-center justify-between gap-3 flex-shrink-0">
          <h2 id="user-rights-help-title" class="text-base font-semibold text-gray-900 m-0 pr-2">
            User rights
          </h2>
          <button type="button"
                  class="flex-shrink-0 px-3 py-1.5 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1 cursor-pointer"
                  data-rights-help="close"
                  aria-label="Close">
            Close
          </button>
        </div>
        <div class="px-5 py-4 overflow-y-auto text-sm text-gray-700 flex-1 min-h-0 space-y-4">
          <p class="text-xs text-gray-500 mb-0">
            Shared users always receive View access. Analyze and Export can be granted independently. The project owner has all rights listed below.
          </p>
          <div>
            <h3 class="text-sm font-semibold text-gray-900 mb-2">Analyze</h3>
            <p class="text-xs text-gray-600 mb-2">Lets the user work inside this project and run analyses. It includes:</p>
            <ul class="list-disc list-inside space-y-1 text-xs text-gray-700">
              <li>Submit and run analysis pipeline steps</li>
              <li>Create and manage cell selections, and save them as metadata</li>
              <li>Use interactive analysis tools that require analysis rights (for example visualization and heatmap analysis controls)</li>
              <li>Create visualization and heatmap checkpoints</li>
              <li>Compute FindMarkers / marker evidences</li>
              <li>Create collaborative annotations and vote on them in private projects (also requires a linked ORCID)</li>
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-gray-900 mb-2">Export</h3>
            <p class="text-xs text-gray-600 mb-2">Lets the user take project data out of ASAP. It includes:</p>
            <ul class="list-disc list-inside space-y-1 text-xs text-gray-700">
              <li>Download loom files, logs, and analysis output files</li>
              <li>Clone the project (the user becomes the owner of the cloned project)</li>
              <li>Download differential expression and gene enrichment result tables when downloads are gated</li>
              <li>Download the original uploaded dataset when available</li>
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-gray-900 mb-2">Project owner</h3>
            <p class="text-xs text-gray-600 mb-2">The owner has full control of the project. In addition to Analyze and Export, this includes:</p>
            <ul class="list-disc list-inside space-y-1 text-xs text-gray-700">
              <li>Edit project settings (privacy, project type, collection, and user rights)</li>
              <li>Invite, update, and remove shared users</li>
              <li>Publish or unpublish the project</li>
              <li>Delete the project</li>
              <li>Restart, stop, and reset analysis runs and parsing</li>
              <li>Import, prepare, rename, and delete metadata and selections</li>
              <li>Create, import, rename, and delete gene set collections</li>
              <li>Build and validate consensus annotations</li>
              <li>Edit annot properties such as data type and manual step mapping</li>
              <li>See all runs and metadata after publication (not limited to the publication snapshot)</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%= javascript_tag do %>
function initUserRightsHelpModal() {
  const modal = document.getElementById('user-rights-help-modal');
  if (!modal || modal.dataset.bound === '1') return;
  modal.dataset.bound = '1';

  const openModal = function() {
    modal.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
  };
  const closeModal = function() {
    modal.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  };

  document.querySelectorAll('[data-rights-help="open"]').forEach(function(button) {
    button.addEventListener('click', function(event) {
      event.preventDefault();
      openModal();
    });
  });
  document.querySelectorAll('[data-rights-help="close"]').forEach(function(el) {
    el.addEventListener('click', function(event) {
      event.preventDefault();
      closeModal();
    });
  });
  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape' && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });
}

document.addEventListener('DOMContentLoaded', function() {
  initUserRightsHelpModal();
});
<% end %>
