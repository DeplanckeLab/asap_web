function parseGeneAutocompleteEntry(entry) {
  if (!entry) return null
  var match = String(entry).match(/^(.+?)\s+([A-Za-z0-9._:-]+)\s+\{(\d+)\}$/)
  if (!match) return null
  return {
    label: String(match[1]).trim(),
    symbol: String(match[1]).trim(),
    ensemblId: String(match[2]).trim(),
    stableId: String(match[3]).trim()
  }
}

function getGeneManager() {
  return (window.visualizationController && window.visualizationController.geneManager) || window.geneManager
}

function getGeneAutocompleteEntries() {
  var geneMgr = getGeneManager()
  var data = geneMgr && Array.isArray(geneMgr.autocompleteData) ? geneMgr.autocompleteData : []
  return data
}

function searchGeneAutocomplete(query) {
  var searchTerm = String(query || '').trim()
  if (!searchTerm) return []
  var searchLower = searchTerm.toLowerCase()
  var geneMgr = getGeneManager()
  var entries = getGeneAutocompleteEntries()
  var scored = []

  for (var i = 0; i < entries.length; i++) {
    var parsed = parseGeneAutocompleteEntry(entries[i])
    if (!parsed) continue

    var match = null
    if (geneMgr && typeof geneMgr.scoreGeneMatch === 'function') {
      match = geneMgr.scoreGeneMatch(parsed, searchTerm, searchLower)
    } else {
      var labelLower = parsed.label.toLowerCase()
      var ensLower = parsed.ensemblId.toLowerCase()
      if (labelLower.includes(searchLower) || ensLower.includes(searchLower) || parsed.stableId.includes(searchTerm)) {
        match = Object.assign({}, parsed, { rank: 0 })
      }
    }
    if (!match) continue
    scored.push(Object.assign({}, match, {
      label: match.symbol || parsed.label
    }))
  }

  scored.sort(function(a, b) {
    if (a.rank !== b.rank) return a.rank - b.rank
    return String(a.label).localeCompare(String(b.label))
  })

  var out = []
  var seen = {}
  for (var j = 0; j < scored.length; j++) {
    var key = String(scored[j].ensemblId || '').toLowerCase()
    if (!key || seen[key]) continue
    seen[key] = true
    out.push(scored[j])
    if (out.length >= 10) break
  }
  return out
}

function renderNewGeneSuggestions(kind, matches) {
  var list = document.getElementById('annot-new-' + kind + '-suggestions')
  if (!list) return
  if (!matches || matches.length === 0) {
    list.style.display = 'none'
    list.innerHTML = ''
    return
  }
  var html = ''
  matches.forEach(function(gene) {
    var safeLabel = escapeHtml(gene.label)
    var safeEns = escapeHtml(gene.ensemblId)
    var safeStable = escapeHtml(gene.stableId)
    var aliasNote = ''
    if (gene.matchedAlias) {
      aliasNote = '<div style="font-size:11px;color:#9ca3af;">matched via ' +
        escapeHtml(gene.matchSource || 'alias') + ': ' + escapeHtml(gene.matchedAlias) + '</div>'
    }
    html += '<div data-kind="' + kind + '" data-label="' + safeLabel + '" data-ensembl="' + safeEns + '" data-stable="' + safeStable + '" style="padding:8px 10px;cursor:pointer;border-bottom:1px solid #f3f4f6;">'
    html += '<div style="font-size:12px;color:#111827;font-weight:500;">' + safeLabel + '</div>'
    html += '<div style="font-size:11px;color:#6b7280;">' + safeEns + ' | Stable ID: ' + safeStable + '</div>'
    html += aliasNote
    html += '</div>'
  })
  list.innerHTML = html
  list.style.display = 'block'
}

function renderNewOntologySuggestions(results) {
  var list = document.getElementById('annot-new-ontology-suggestions')
  if (!list) return
  if (!results || results.length === 0) {
    list.style.display = 'none'
    list.innerHTML = ''
    return
  }
  var html = ''
  results.forEach(function(term) {
    var id = escapeHtml(term.id)
    var label = escapeHtml(term.label || (term.identifier + ' - ' + term.name))
    html += '<div data-id="' + id + '" data-label="' + label + '" style="padding:8px 10px;cursor:pointer;border-bottom:1px solid #f3f4f6;">' + label + '</div>'
  })
  list.innerHTML = html
  list.style.display = 'block'
}

function addNewOntologyTerm(termId, termLabel) {
  var exists = _annotPopupData.newForm.ontologyTerms.some(function(t) { return String(t.id) === String(termId) })
  if (exists) return
  if (!selectedAnnotTypeAllowsMultipleOntologyTerms() && _annotPopupData.newForm.ontologyTerms.length >= 1) {
    _annotPopupData.newForm.ontologyTerms = [{ id: String(termId), label: String(termLabel) }]
    clearNewAnnotationFeedback()
    renderAnnotationPanel()
    return
  }
  _annotPopupData.newForm.ontologyTerms.push({ id: String(termId), label: String(termLabel) })
  clearNewAnnotationFeedback()
  renderAnnotationPanel()
}

function removeNewOntologyTerm(termId) {
  _annotPopupData.newForm.ontologyTerms = _annotPopupData.newForm.ontologyTerms.filter(function(t) { return String(t.id) !== String(termId) })
  clearNewAnnotationFeedback()
  renderAnnotationPanel()
}

function addNewGene(kind, geneObj) {
  var upArr = _annotPopupData.newForm.upGenes
  var downArr = _annotPopupData.newForm.downGenes
  var targetArr = kind === 'up' ? upArr : downArr
  var otherArr = kind === 'up' ? downArr : upArr
  var stableId = String(geneObj.stableId)
  if (targetArr.some(function(g) { return String(g.stableId) === stableId })) return
  if (otherArr.some(function(g) { return String(g.stableId) === stableId })) {
    setNewAnnotationStatus('This gene is already listed as ' +
      (kind === 'up' ? 'down-regulated' : 'up-regulated') + '.')
    return
  }
  targetArr.push({
    label: String(geneObj.label),
    ensemblId: String(geneObj.ensemblId),
    stableId: stableId
  })
  clearNewAnnotationFeedback()
  renderAnnotationPanel()
}

function removeNewGene(kind, stableId) {
  if (kind === 'up') {
    _annotPopupData.newForm.upGenes = _annotPopupData.newForm.upGenes.filter(function(g) { return String(g.stableId) !== String(stableId) })
  } else {
    _annotPopupData.newForm.downGenes = _annotPopupData.newForm.downGenes.filter(function(g) { return String(g.stableId) !== String(stableId) })
  }
  clearNewAnnotationFeedback()
  renderAnnotationPanel()
}

function initNewAnnotationTab() {
  var nameInput = document.getElementById('annot-new-name-input')
  var commentInput = document.getElementById('annot-new-comment-input')
  var ontologyInput = document.getElementById('annot-new-ontology-input')
  var ontologySuggestions = document.getElementById('annot-new-ontology-suggestions')
  var upInput = document.getElementById('annot-new-up-input')
  var downInput = document.getElementById('annot-new-down-input')

  if (!nameInput || !commentInput || !ontologyInput || !upInput || !downInput) return
  var annotationTypeSelect = document.getElementById('annot-new-annotation-type')
  if (annotationTypeSelect) {
    annotationTypeSelect.addEventListener('change', function() {
      _annotPopupData.newForm.annotationTypeId = annotationTypeSelect.value
      _annotPopupData.newForm.ontologyTerms = []
      clearNewAnnotationFeedback()
      renderAnnotationPanel()
    })
  }

  nameInput.addEventListener('input', function() {
    _annotPopupData.newForm.name = nameInput.value
    _annotPopupData.newForm.status = ''
  })
  commentInput.addEventListener('input', function() {
    _annotPopupData.newForm.comment = commentInput.value
    _annotPopupData.newForm.status = ''
  })

  var ontologyTimer = null
  ontologyInput.addEventListener('input', function() {
    var query = ontologyInput.value.trim()
    if (ontologyTimer) clearTimeout(ontologyTimer)
    if (!query) {
      renderNewOntologySuggestions([])
      return
    }
    var prefixesCsv = selectedAnnotTypePrefixesCsv()
    if (!prefixesCsv) {
      renderNewOntologySuggestions([])
      return
    }
    ontologyTimer = setTimeout(function() {
      var url = '<%= compliance_ontology_autocomplete_path %>?term=' + encodeURIComponent(query) + '&prefixes=' + encodeURIComponent(prefixesCsv) + '&project_id=' + encodeURIComponent('<%= @project.id %>')
      fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
        .then(function(r) { return r.ok ? r.json() : { results: [] } })
        .then(function(data) { renderNewOntologySuggestions((data && data.results) || []) })
        .catch(function() { renderNewOntologySuggestions([]) })
    }, 120)
  })

  ontologySuggestions.addEventListener('click', function(e) {
    var item = e.target.closest('[data-id]')
    if (!item) return
    addNewOntologyTerm(item.dataset.id, item.dataset.label)
  })

  function attachGeneInput(inputEl, kind) {
    inputEl.addEventListener('input', function() {
      var query = inputEl.value.trim()
      renderNewGeneSuggestions(kind, searchGeneAutocomplete(query))
    })
    inputEl.addEventListener('keydown', function(e) {
      if (e.key !== 'Enter') return
      e.preventDefault()
      var matches = searchGeneAutocomplete(inputEl.value.trim())
      if (matches.length > 0) addNewGene(kind, matches[0])
    })
  }
  attachGeneInput(upInput, 'up')
  attachGeneInput(downInput, 'down')

  var upSuggestions = document.getElementById('annot-new-up-suggestions')
  var downSuggestions = document.getElementById('annot-new-down-suggestions')
  if (upSuggestions) {
    upSuggestions.addEventListener('click', function(e) {
      var item = e.target.closest('[data-stable]')
      if (!item) return
      addNewGene('up', { label: item.dataset.label, ensemblId: item.dataset.ensembl, stableId: item.dataset.stable })
    })
  }
  if (downSuggestions) {
    downSuggestions.addEventListener('click', function(e) {
      var item = e.target.closest('[data-stable]')
      if (!item) return
      addNewGene('down', { label: item.dataset.label, ensemblId: item.dataset.ensembl, stableId: item.dataset.stable })
    })
  }

  var panel = document.getElementById('annot-popup-panel')
  if (panel) {
    panel.querySelectorAll('[data-remove-ontology-id]').forEach(function(btn) {
      btn.addEventListener('click', function() { removeNewOntologyTerm(btn.dataset.removeOntologyId) })
    })
    panel.querySelectorAll('[data-remove-gene-kind]').forEach(function(btn) {
      btn.addEventListener('click', function() { removeNewGene(btn.dataset.removeGeneKind, btn.dataset.removeGeneStable) })
    })
  }
}

function renderNewAnnotationTab() {
  var formState = _annotPopupData.newForm
  var annotationTypeId = String(formState.annotationTypeId || defaultAnnotTypeId())
  var validation = newAnnotationFormValidation(formState)
  var annotationTypeOptions = (_annotOntologyTermTypes || []).map(function(t) {
    var id = String(t.id)
    var selected = id === annotationTypeId ? ' selected' : ''
    return '<option value="' + escapeHtml(id) + '"' + selected + '>' + escapeHtml(t.label) + '</option>'
  }).join('')
  var ontologyBadgeItems = (formState.ontologyTerms || []).map(function(term) {
    return '<span style="display:inline-flex;align-items:center;gap:6px;padding:2px 6px;background:#e0f2fe;color:#0c4a6e;border-radius:999px;font-size:11px;">' +
      escapeHtml(term.label) +
      '<button type="button" data-remove-ontology-id="' + escapeHtml(term.id) + '" style="background:none;border:none;color:#0c4a6e;cursor:pointer;padding:0;line-height:1;">x</button></span>'
  })
  var ontologyBadges = ontologyBadgeItems.length
    ? '<div style="margin-top:6px;display:flex;flex-wrap:wrap;gap:4px;">' + ontologyBadgeItems.join(' ') + '</div>'
    : ''
  var upBadgeItems = (formState.upGenes || []).map(function(gene) {
    return '<span style="display:inline-flex;align-items:center;gap:6px;padding:2px 6px;background:#dcfce7;color:#166534;border-radius:999px;font-size:11px;">' +
      escapeHtml(gene.label) + ' [' + escapeHtml(gene.ensemblId) + ']' +
      '<button type="button" data-remove-gene-kind="up" data-remove-gene-stable="' + escapeHtml(gene.stableId) + '" style="background:none;border:none;color:#166534;cursor:pointer;padding:0;line-height:1;">x</button></span>'
  })
  var upBadges = upBadgeItems.length
    ? '<div style="margin-top:6px;display:flex;flex-wrap:wrap;gap:4px;">' + upBadgeItems.join(' ') + '</div>'
    : ''
  var downBadgeItems = (formState.downGenes || []).map(function(gene) {
    return '<span style="display:inline-flex;align-items:center;gap:6px;padding:2px 6px;background:#fee2e2;color:#991b1b;border-radius:999px;font-size:11px;">' +
      escapeHtml(gene.label) + ' [' + escapeHtml(gene.ensemblId) + ']' +
      '<button type="button" data-remove-gene-kind="down" data-remove-gene-stable="' + escapeHtml(gene.stableId) + '" style="background:none;border:none;color:#991b1b;cursor:pointer;padding:0;line-height:1;">x</button></span>'
  })
  var downBadges = downBadgeItems.length
    ? '<div style="margin-top:6px;display:flex;flex-wrap:wrap;gap:4px;">' + downBadgeItems.join(' ') + '</div>'
    : ''

  var ontologyInvalid = validation.ontologyMissing || validation.ontologyTooMany
  var ontologyBorder = ontologyInvalid ? '#dc2626' : '#d1d5db'
  var ontologyShadow = ontologyInvalid ? '0 0 0 3px rgba(220, 38, 38, 0.15)' : 'none'
  var ontologyPlaceholder = validation.allowsMultiple
    ? 'Search ontology terms (one or more allowed)'
    : 'Search ontology term (exactly one required)'
  var ontologyHint = ''
  if (validation.ontologyMissing) {
    ontologyHint = '<div style="margin-top:4px;font-size:11px;color:#b91c1c;line-height:1.3;">At least one ontology term is required (scFAIR).</div>'
  } else if (validation.ontologyTooMany) {
    ontologyHint = '<div style="margin-top:4px;font-size:11px;color:#b91c1c;line-height:1.3;">This annotation type allows only one ontology term.</div>'
  } else if (validation.allowsMultiple) {
    ontologyHint = '<div style="margin-top:4px;font-size:11px;color:#6b7280;line-height:1.3;">Multiple ontology terms are allowed for this annotation type.</div>'
  } else {
    ontologyHint = '<div style="margin-top:4px;font-size:11px;color:#6b7280;line-height:1.3;">Only one ontology term is allowed for this annotation type.</div>'
  }

  var annotable = document.getElementById('annotation-popup-overlay') && document.getElementById('annotation-popup-overlay').dataset.annotable === 'true'
  var submitting = !!formState.submitting
  var pendingConfirm = !!formState.pendingConfirm
  var formInvalid = !validation.valid
  var submitDisabled = submitting || formInvalid
  var submitSection
  if (!annotable) {
    submitSection = '<button type="button" disabled style="background:#9ca3af;border:1px solid #9ca3af;color:#fff;cursor:not-allowed;padding:6px 12px;border-radius:6px;font-size:12px;font-weight:600;">Submit annotation</button><span style="font-size:12px;color:#92400e;">You should be logged in and associate your ORCID ID to your account to submit annotations.</span>'
  } else if (pendingConfirm) {
    submitSection =
      '<div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;">' +
      '<button type="button" onclick="submitNewAnnotation(true)"' + (submitDisabled ? ' disabled' : '') + ' style="background:' + (formInvalid ? '#9ca3af' : '#2563eb') + ';border:1px solid ' + (formInvalid ? '#9ca3af' : '#2563eb') + ';color:#fff;cursor:' + (submitDisabled ? 'not-allowed' : 'pointer') + ';padding:6px 12px;border-radius:6px;font-size:12px;font-weight:600;">' + (submitting ? 'Submitting...' : 'Confirm submit') + '</button>' +
      '<button type="button" onclick="cancelNewAnnotationConfirm()"' + (submitting ? ' disabled' : '') + ' style="background:#fff;border:1px solid #d1d5db;color:#374151;cursor:' + (submitting ? 'not-allowed' : 'pointer') + ';padding:6px 12px;border-radius:6px;font-size:12px;font-weight:600;">Cancel</button>' +
      '</div>'
  } else {
    submitSection = '<button type="button" onclick="submitNewAnnotation(false)"' + (submitDisabled ? ' disabled' : '') + ' style="background:' + (formInvalid ? '#9ca3af' : '#2563eb') + ';border:1px solid ' + (formInvalid ? '#9ca3af' : '#2563eb') + ';color:#fff;cursor:' + (submitDisabled ? 'not-allowed' : 'pointer') + ';padding:6px 12px;border-radius:6px;font-size:12px;font-weight:600;">' + (submitting ? 'Submitting...' : 'Submit annotation') + '</button>'
  }

  var html = templateHtml('annot-new-tab-template')
    .replace('__ANNOTATION_TYPE_OPTIONS__', annotationTypeOptions)
    .replace('__NAME__', escapeHtml(formState.name))
    .replace('__ONTOLOGY_PLACEHOLDER__', escapeHtml(ontologyPlaceholder))
    .replace('__ONTOLOGY_BORDER__', ontologyBorder)
    .replace('__ONTOLOGY_SHADOW__', ontologyShadow)
    .replace('__ONTOLOGY_BADGES__', ontologyBadges)
    .replace('__ONTOLOGY_HINT__', ontologyHint)
    .replace('__UP_BADGES__', upBadges)
    .replace('__DOWN_BADGES__', downBadges)
    .replace('__COMMENT__', escapeHtml(formState.comment))
    .replace('__SUBMIT_SECTION__', submitSection)
    .replace('__STATUS__', (formState.status || '').trim().length > 0 ? '<div style="margin-top:8px;padding:8px 10px;border:1px solid #fde68a;background:#fffbeb;color:#92400e;border-radius:6px;font-size:12px;white-space:pre-wrap;">' + escapeHtml(formState.status) + '</div>' : '')
  return html
}

function claProvenanceBadgeHtml(cla) {
  var overlay = document.getElementById('annotation-popup-overlay')
  var currentId = overlay && overlay.dataset.currentProjectId ? String(overlay.dataset.currentProjectId) : ''
  var pid = cla.project_id != null ? String(cla.project_id) : ''
  var p = cla.project || {}
  var titleBits = []
  if (p.name && String(p.name).trim()) titleBits.push(String(p.name).trim())
  if (p.key) titleBits.push(String(p.key))
  if (p.public_id !== null && p.public_id !== undefined && String(p.public_id).length > 0) {
    titleBits.push('ASAP' + String(p.public_id))
  }
  var titleAttr = titleBits.length ? escapeHtml(titleBits.join(' — ')) : ''
  var titlePart = titleAttr ? ' title="' + titleAttr + '"' : ''
  var isLocal = currentId && pid && currentId === pid
  var label = isLocal ? 'this project' : (p.key ? escapeHtml(String(p.key)) : ('id ' + escapeHtml(pid)))
  var cls = isLocal
    ? 'background:#ecfdf5;color:#047857;border:1px solid #a7f3d0;'
    : 'background:#f1f5f9;color:#0f172a;border:1px solid #e2e8f0;'
  return '<span' + titlePart + ' style="display:inline-flex;align-items:center;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:600;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;cursor:default;' + cls + '">' + label + '</span>'
}

function claProvenanceInlineHtml(cla) {
  var meta = (cla.metadata_name || '').trim()
  var cat = (cla.category_label || '').trim()
  var parts = []
  if (meta) parts.push(escapeHtml(meta))
  if (cat) parts.push(escapeHtml(cat))
  var tail = parts.length
    ? '<span style="font-size:11px;color:#64748b;font-weight:400;line-height:1.35;word-break:break-word;"> / ' + parts.join(' / ') + '</span>'
    : ''
  return '<span style="display:inline-flex;align-items:center;flex-wrap:wrap;gap:4px;line-height:1.35;max-width:100%;min-width:0;"><span style="font-size:11px;color:#64748b;flex-shrink:0;">from </span>' + claProvenanceBadgeHtml(cla) + tail + '</span>'
}

function claOntologyBadgesHtml(cla) {
  var terms = Array.isArray(cla.cell_ontology_terms) ? cla.cell_ontology_terms : []
  if (terms.length === 0) return ''
  var html = '<div class="flex flex-wrap gap-1 mt-1">'
  terms.forEach(function(term) {
    var identifier = term && term.identifier != null ? String(term.identifier).trim() : ''
    var name = term && term.name != null ? String(term.name).trim() : ''
    if (!identifier && !name) return
    html += '<span class="inline-flex items-center gap-1 px-2 py-1 text-xs rounded-full bg-blue-100 text-blue-800">'
    if (identifier) html += '<span class="font-mono">' + escapeHtml(identifier) + '</span>'
    if (name) html += '<span class="text-blue-600">' + escapeHtml(name) + '</span>'
    html += '</span>'
  })
  html += '</div>'
  return html
}

function renderExistingAnnotationsTab(clas) {
  var content = ''

  if (clas.length === 0) {
    content += '<div style="text-align: center; padding: 40px 20px; color: #9ca3af;">'
    content += '<i class="fas fa-clipboard" style="font-size: 32px; margin-bottom: 12px; display: block;"></i>'
    content += '<div style="font-size: 14px;">No annotations yet for this category.</div>'
    content += '</div>'
  } else {
    clas.forEach(function(cla) {
      var score = (cla.nber_agree || 0) - (cla.nber_disagree || 0)
      var scoreColor = score > 0 ? '#10b981' : (score < 0 ? '#ef4444' : '#9ca3af')
      var originRaw = (cla.origin != null && String(cla.origin).trim() !== '') ? String(cla.origin).trim() : ''

      content += '<div style="border: 1px solid #e5e7eb; border-radius: 8px; padding: 12px; margin-bottom: 8px; background:#fff;">'

      content += '<div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; margin-bottom: 6px;">'
      content += '<div style="display: flex; align-items: center; gap: 8px; flex: 1; min-width: 0; flex-wrap: wrap;">'
      content += '<span style="font-weight: 600; font-size: 13px; color: #374151; flex-shrink: 0;">#' + escapeHtml(String(cla.num || cla.id)) + '</span>'
      content += claProvenanceInlineHtml(cla)
      content += '</div>'
      content += '<div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">'
      content += '<span style="font-size: 11px; color: #9ca3af;">' + (cla.created_at || '') + '</span>'
      content += '<span style="font-weight: 600; font-size: 14px; color: ' + scoreColor + ';">' + score + '</span>'
      content += '</div></div>'

      if (cla.name) {
        content += '<div style="margin-bottom: 6px;"><span style="font-size: 12px; color: #6b7280; font-weight: 500;">Name: </span><span style="font-size: 12px; color: #374151;">' + escapeHtml(String(cla.name)) + '</span></div>'
      }

      if (cla.cell_ontology_terms && cla.cell_ontology_terms.length > 0) {
        content += '<div style="margin-bottom: 6px;"><span style="font-size: 12px; color: #6b7280; font-weight: 500;">Cell ontology: </span>' + claOntologyBadgesHtml(cla) + '</div>'
      }

      if (typeof claGeneBadgesRowHtml === 'function' && cla.up_genes && cla.up_genes.length > 0) {
        content += claGeneBadgesRowHtml(cla.up_genes, 'up')
      }

      if (typeof claGeneBadgesRowHtml === 'function' && cla.down_genes && cla.down_genes.length > 0) {
        content += claGeneBadgesRowHtml(cla.down_genes, 'down')
      }

      if (cla.comment) {
        content += '<div style="margin-bottom: 6px;"><span style="font-size: 12px; color: #6b7280; font-weight: 500;">Comment: </span><span style="font-size: 12px; color: #374151;">' + escapeHtml(String(cla.comment)) + '</span></div>'
      }

      content += '<div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 8px; flex-wrap: wrap;">'
      content += '<div style="display: flex; align-items: center; gap: 12px;">'
      content += '<span style="font-size: 12px; color: #10b981;"><i class="far fa-thumbs-up"></i> ' + (cla.nber_agree || 0) + '</span>'
      content += '<span style="font-size: 12px; color: #ef4444;"><i class="far fa-thumbs-down"></i> ' + (cla.nber_disagree || 0) + '</span>'
      content += '</div>'
      if (originRaw) {
        content += '<span style="display:inline-flex;align-items:center;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:600;background:#f1f5f9;color:#475569;border:1px solid #e2e8f0;flex-shrink:0;">' + escapeHtml(originRaw) + '</span>'
      }
      content += '</div>'

      content += '</div>'
    })
  }
  return templateHtml('annot-existing-tab-template')
    .replace('__TOTAL__', String(clas.length))
    .replace('__CONTENT__', content)
}

function formatEvidenceNumericCell(v) {
  if (v === null || v === undefined) return ''
  if (typeof v === 'number' && !Number.isFinite(v)) return ''
  return String(v)
}

function evidenceNumSortAttr(val) {
  if (val === null || val === undefined || val === '') return '0'
  var n = parseFloat(val)
  return Number.isFinite(n) ? String(n) : '0'
}

function evidenceGeneBadgeCellHtml(row, tone) {
  var symRaw = (row.gene != null && String(row.gene).trim() !== '') ? String(row.gene).trim() : (row.gene_id != null ? String(row.gene_id) : '-')
  var sym = escapeHtml(symRaw)
  var ens = ''
  if (row.ensembl_id != null && String(row.ensembl_id).trim() !== '') {
    ens = String(row.ensembl_id).trim()
  } else if (row.gene_id != null && /^ENS[0-9A-Za-z._-]+/i.test(String(row.gene_id).trim())) {
    ens = String(row.gene_id).trim()
  }
  var symLookup = ''
  if (row.gene != null && String(row.gene).trim() !== '') {
    symLookup = String(row.gene).trim()
  } else if (row.gene_id != null && !/^ENS[0-9A-Za-z._-]+$/i.test(String(row.gene_id).trim())) {
    symLookup = String(row.gene_id).trim()
  }
  var remoteGid = ''
  var st = row.stable_id != null ? String(row.stable_id).trim() : ''
  var gidRaw = row.gene_id != null ? String(row.gene_id).trim() : ''
  if (/^\d+$/.test(st)) remoteGid = st
  else if (/^\d+$/.test(gidRaw)) remoteGid = gidRaw
  var isUp = tone === 'up'
  var highlightCls = isUp ? 'bg-green-100 text-green-800 hover:bg-green-200' : 'bg-red-100 text-red-800 hover:bg-red-200'
  var canOpen = !!(remoteGid || ens || symLookup)
  var cls = highlightCls
  var curs = canOpen ? 'cursor-pointer' : 'cursor-default'
  var html = '<span class="annot-popup-gene-badge gene-badge ' + cls + ' ' + curs + ' inline-flex items-center px-2 py-0.5 rounded text-xs font-medium" style="max-width:11rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"'
  if (remoteGid) html += ' data-remote-gene-id="' + escapeAttr(remoteGid) + '"'
  if (ens) html += ' data-ensembl-id="' + escapeAttr(ens) + '"'
  if (symLookup) html += ' data-gene-symbol="' + escapeAttr(symLookup) + '"'
  html += ' title="' + escapeAttr(ens || symRaw || symLookup) + '">' + sym + '</span>'
  return html
}

function renderEvidenceBoxplotTab() {
  var addGenesVizBtnHtml = '<button type="button" style="border:1px solid #d1d5db;background:#fff;color:#374151;border-radius:6px;padding:6px 12px;font-size:12px;cursor:pointer;white-space:nowrap;" title="Adds genes selected for Plot in Identify markers to the main visualization gene panel" onclick="if(window.addAnnotEvidenceGenesToVisualizationBulk)window.addAnnotEvidenceGenesToVisualizationBulk()">Add genes to visualization</button>'
  var n = (typeof window.annotEvidenceSelectedCount === 'function') ? window.annotEvidenceSelectedCount() : 0
  if (typeof window.annotEvidenceBoxplotSupported === 'function' && !window.annotEvidenceBoxplotSupported()) {
    var html = '<div style="font-size:13px;font-weight:600;color:#111827;margin-bottom:10px;">Split violin plots</div>'
    html += '<p style="font-size:12px;color:#6b7280;line-height:1.5;">Open this project in the visualization view. Split violins compare this category to the rest of the dataset using the same metadata column as annotations.</p>'
    return html
  }
  var html = '<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:10px;">'
  html += '<div style="font-size:13px;font-weight:600;color:#111827;">Split violin plots</div>'
  if (n > 0) {
    html += '<div style="flex-shrink:0;">' + addGenesVizBtnHtml + '</div>'
  }
  html += '</div>'
  if (n === 0) {
    html += '<p style="font-size:12px;color:#6b7280;line-height:1.5;">Select genes in the Identify markers tab, then open this tab.</p>'
    return html
  }
  var layout = (window._annotPopupData && window._annotPopupData.violinLayoutMode === 'separate') ? 'separate' : 'combined'
  var sortBy = (window._annotPopupData && (window._annotPopupData.violinSortBy === 'mean' || window._annotPopupData.violinSortBy === 'max')) ? window._annotPopupData.violinSortBy : 'median'
  html += '<div id="annot-violin-controls" style="margin-bottom:12px;padding:10px;border:1px solid #e5e7eb;border-radius:8px;background:#f9fafb;">'
  html += '<label for="annot-violin-matrix-select" style="display:block;font-size:11px;color:#374151;margin-bottom:4px;font-weight:600;">Expression matrix</label>'
  html += '<select id="annot-violin-matrix-select" style="width:100%;padding:6px 8px;border:1px solid #d1d5db;border-radius:6px;font-size:12px;background:#fff;" onchange="if(window.onAnnotViolinMatrixSelectChange)window.onAnnotViolinMatrixSelectChange()"></select>'
  html += '<div style="margin-top:10px;font-size:11px;color:#374151;display:flex;flex-wrap:wrap;gap:12px;align-items:center;">'
  html += '<span style="font-weight:600;">Layout:</span>'
  html += '<label style="cursor:pointer;display:inline-flex;align-items:center;gap:4px;"><input type="radio" name="annot-violin-layout" value="combined"' + (layout === 'combined' ? ' checked' : '') + ' onchange="if(window.onAnnotViolinLayoutRadioChange)window.onAnnotViolinLayoutRadioChange()"/>Single combined plot</label>'
  html += '<label style="cursor:pointer;display:inline-flex;align-items:center;gap:4px;"><input type="radio" name="annot-violin-layout" value="separate"' + (layout === 'separate' ? ' checked' : '') + ' onchange="if(window.onAnnotViolinLayoutRadioChange)window.onAnnotViolinLayoutRadioChange()"/>One plot per gene</label>'
  html += '</div>'
  html += '<label for="annot-violin-sort-by" style="display:block;margin-top:10px;font-size:11px;color:#374151;margin-bottom:4px;font-weight:600;">Order genes by (category side, high to low)</label>'
  html += '<select id="annot-violin-sort-by" style="width:100%;padding:6px 8px;border:1px solid #d1d5db;border-radius:6px;font-size:12px;background:#fff;" onchange="if(window.onAnnotViolinSortChange)window.onAnnotViolinSortChange()">'
  html += '<option value="median"' + (sortBy === 'median' ? ' selected' : '') + '>Median</option>'
  html += '<option value="mean"' + (sortBy === 'mean' ? ' selected' : '') + '>Mean</option>'
  html += '<option value="max"' + (sortBy === 'max' ? ' selected' : '') + '>Max</option>'
  html += '</select></div>'
  html += '<div id="annot-evidence-boxplot-root"></div>'
  return html
}

function renderEvidenceGeneTableBlock(rows, tone, emptyMsg) {
  var borderColor = tone === 'up' ? '#bbf7d0' : '#fecaca'
  if (!rows || rows.length === 0) {
    return '<div style="text-align:center;padding:24px;border:1px dashed ' + borderColor + ';border-radius:8px;color:#6b7280;background:#fff;font-size:13px;">' + escapeHtml(emptyMsg) + '</div>'
  }
  var rowsToRender = (typeof window.annotEvidenceSortedRows === 'function')
    ? window.annotEvidenceSortedRows(rows, tone)
    : rows.slice()
  var thSticky = 'padding:6px 8px;border-bottom:1px solid #e5e7eb;text-align:left;font-weight:600;position:sticky;top:0;z-index:1;background:#fff;'
  var thStickyPlot = thSticky + 'text-align:center;'
  var apdSel = (typeof window.annotEvidenceEnsureSelectionStore === 'function') ? window.annotEvidenceEnsureSelectionStore() : null
  var html = ''
  html += '<div style="border:1px solid ' + borderColor + ';border-radius:8px;background:#fff;overflow:hidden;">'
  html += '<div style="max-height:280px;overflow:auto;">'
  html += '<table class="annot-evidence-sortable-table" style="width:100%;border-collapse:separate;border-spacing:0;font-size:12px;color:#4b5563;">'
  html += '<thead><tr>'
  html += '<th class="annot-marker-plot-th" style="' + thStickyPlot + '" title="Include in violin tab">Plot</th>'
  var thLabels = ['Gene', 'log2FC', 'FDR', 'P value']
  var hci
  for (hci = 0; hci < 4; hci++) {
    if (typeof window.annotEvidenceSortThHtml === 'function') {
      html += window.annotEvidenceSortThHtml(tone, hci, thLabels[hci], thSticky)
    } else {
      html += '<th style="' + thSticky + '">' + escapeHtml(thLabels[hci]) + '</th>'
    }
  }
  html += '<th style="' + thSticky + 'text-align:center;white-space:nowrap;" title="Add this gene to the main visualization gene panel">Add to visualization</th>'
  html += '</tr></thead><tbody>'
  rowsToRender.forEach(function(row) {
    var gsv = (typeof window.annotEvidenceGeneSortValue === 'function')
      ? window.annotEvidenceGeneSortValue(row)
      : (((row.gene != null && String(row.gene).trim() !== '') ? String(row.gene).trim() : String(row.gene_id || '-'))).toLowerCase()
    var selKey = (typeof window.annotEvidenceSelectionKey === 'function') ? window.annotEvidenceSelectionKey(tone, row) : ''
    var isChecked = apdSel && apdSel.evidencesSelectedRows && apdSel.evidencesSelectedRows[selKey]
    html += '<tr>'
    html += '<td class="annot-marker-plot-td" style="padding:4px 6px;border-top:1px solid #f3f4f6;vertical-align:middle;text-align:center;">'
    html += '<input type="checkbox" class="annot-marker-plot-cb"' + (isChecked ? ' checked' : '') + ' data-evidence-key="' + escapeAttr(selKey) + '" data-evidence-tone="' + escapeAttr(tone) + '" data-evidence-gene-id="' + escapeAttr(String(row.gene_id != null ? row.gene_id : '')) + '" data-evidence-gene-symbol="' + escapeAttr(String(row.gene != null ? row.gene : '')) + '" aria-label="Include in violin plot" onchange="annotEvidenceCheckboxChange(this)" onclick="event.stopPropagation()" />'
    html += '</td>'
    html += '<td data-sort-value="' + escapeAttr(gsv) + '" style="padding:6px 8px;border-top:1px solid #f3f4f6;color:#111827;vertical-align:middle;">' + evidenceGeneBadgeCellHtml(row, tone) + '</td>'
    html += '<td data-sort-value="' + escapeAttr(evidenceNumSortAttr(row.log2fc)) + '" style="padding:6px 8px;border-top:1px solid #f3f4f6;color:#111827;">' + escapeHtml(formatEvidenceNumericCell(row.log2fc)) + '</td>'
    html += '<td data-sort-value="' + escapeAttr(evidenceNumSortAttr(row.fdr)) + '" style="padding:6px 8px;border-top:1px solid #f3f4f6;color:#111827;">' + escapeHtml(formatEvidenceNumericCell(row.fdr)) + '</td>'
    html += '<td data-sort-value="' + escapeAttr(evidenceNumSortAttr(row.p_value)) + '" style="padding:6px 8px;border-top:1px solid #f3f4f6;color:#111827;">' + escapeHtml(formatEvidenceNumericCell(row.p_value)) + '</td>'
    html += '<td style="padding:4px 6px;border-top:1px solid #f3f4f6;vertical-align:middle;text-align:center;white-space:nowrap;">'
    html += '<button type="button" style="border:1px solid #d1d5db;background:#fff;color:#374151;border-radius:6px;padding:4px 8px;font-size:11px;cursor:pointer;" data-evidence-tone="' + escapeAttr(tone) + '" data-evidence-gene-id="' + escapeAttr(String(row.gene_id != null ? row.gene_id : '')) + '" data-evidence-gene-symbol="' + escapeAttr(String(row.gene != null ? row.gene : '')) + '" onclick="event.stopPropagation();if(window.addAnnotEvidenceGeneToVisualizationFromBtn)window.addAnnotEvidenceGeneToVisualizationFromBtn(this)">Add to visualization</button>'
    html += '</td>'
    html += '</tr>'
  })
  html += '</tbody></table></div></div>'
  return html
}

function renderEvidencesTab() {
  var ev = _annotPopupData.evidences || {}
  var content = ''

  if (ev.state === 'loading') {
    content += '<div style="display:flex;align-items:center;gap:8px;padding:12px;border:1px solid #e5e7eb;border-radius:8px;color:#6b7280;background:#fff;">'
    content += '<i class="fas fa-spinner fa-spin"></i><span>' + escapeHtml(ev.message || 'Loading evidences...') + '</span></div>'
    return templateHtml('annot-evidences-tab-template').replace('__CONTENT__', content)
  }

  if (ev.state === 'running') {
    content += '<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px;border:1px solid #bfdbfe;border-radius:8px;color:#1e3a8a;background:#fff;">'
    content += '<div><i class="fas fa-spinner fa-spin" style="margin-right:8px;"></i>' + escapeHtml(ev.message || 'FindMarkers is running for this metadata.') + '</div>'
    content += '<div style="display:flex;gap:6px;flex-shrink:0;">'
    if (ev.runId) {
      content += '<button type="button" onclick="stopAnnotationMarkers()" style="border:1px solid #fca5a5;background:#fff;color:#b91c1c;border-radius:6px;padding:5px 10px;font-size:12px;cursor:pointer;">Stop</button>'
    }
    content += '<button type="button" onclick="loadAnnotationEvidences()" style="border:1px solid #93c5fd;background:#fff;color:#1d4ed8;border-radius:6px;padding:5px 10px;font-size:12px;cursor:pointer;">Refresh</button>'
    content += '</div></div>'
    return templateHtml('annot-evidences-tab-template').replace('__CONTENT__', content)
  }

  if (ev.state === 'queued') {
    content += '<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:12px;border:1px solid #d1d5db;border-radius:8px;color:#374151;background:#fff;">'
    content += '<div style="flex:1;min-width:0;">'
    var qNote = (ev.markersQueueNote || '').toString()
    var qBase = (ev.markersQueueBase || '').toString()
    var qHover = (ev.slurmQueueHover || '').toString()
    var qp = ev.queuePosition
    if (qNote && qBase) {
      var mid = _annotPopupData.metadataId != null ? String(_annotPopupData.metadataId) : ''
      var rid = ev.runId != null ? String(ev.runId) : ''
      var iconWrapOpen = qHover ? ('<span data-slurm-queue-waiting-icon="true" title="' + escapeAttr(qHover) + '" aria-label="' + escapeAttr(qHover) + '" class="cursor-help">') : '<span>'
      var iconWrapClose = '</span>'
      content += '<div>' + iconWrapOpen + '<i class="fas fa-hourglass-half" style="margin-right:8px;" aria-hidden="true"></i>' + iconWrapClose + escapeHtml(qBase) + '</div>'
      if (qp != null && qp !== '' && Number(qp) > 0) {
        content += '<div style="margin-top:6px;font-size:12px;color:#374151;"><span data-slurm-queue-position-label>Slurm queue position:</span> <span data-slurm-queue-position="' + escapeAttr(String(qp)) + '">' + escapeHtml(String(qp)) + '</span></div>'
      }
      content += '<div style="margin-top:8px;font-size:12px;color:#6b7280;line-height:1.45;" data-slurm-queue-explanation data-markers-queue-live data-annot-id="' + escapeHtml(mid) + '" data-run-id="' + escapeHtml(rid) + '">' + escapeHtml(qNote) + '</div>'
    } else {
      var iconOnlyOpen = qHover ? ('<span data-slurm-queue-waiting-icon="true" title="' + escapeAttr(qHover) + '" aria-label="' + escapeAttr(qHover) + '" class="cursor-help">') : '<span>'
      content += '<div>' + iconOnlyOpen + '<i class="fas fa-hourglass-half" style="margin-right:8px;" aria-hidden="true"></i></span>' + escapeHtml(ev.message || 'FindMarkers is queued for execution.') + '</div>'
    }
    content += '</div>'
    content += '<div style="display:flex;gap:6px;flex-shrink:0;">'
    if (ev.runId) {
      content += '<button type="button" onclick="stopAnnotationMarkers()" style="border:1px solid #fca5a5;background:#fff;color:#b91c1c;border-radius:6px;padding:5px 10px;font-size:12px;cursor:pointer;">Stop</button>'
    }
    content += '<button type="button" onclick="loadAnnotationEvidences()" style="border:1px solid #d1d5db;background:#fff;color:#374151;border-radius:6px;padding:5px 10px;font-size:12px;cursor:pointer;">Refresh</button>'
    content += '</div></div>'
    return templateHtml('annot-evidences-tab-template').replace('__CONTENT__', content)
  }

  if (ev.state === 'unsupported') {
    content += '<div style="display:flex;align-items:flex-start;gap:8px;padding:12px;border:1px solid #d1d5db;border-radius:8px;color:#374151;background:#fff;">'
    content += '<i class="fas fa-info-circle" style="margin-top:2px;"></i>'
    content += '<div>' + escapeHtml(ev.message || 'FindMarkers evidences are not available for this metadata.') + '</div>'
    content += '</div>'
    return templateHtml('annot-evidences-tab-template').replace('__CONTENT__', content)
  }

  if (ev.state === 'analyze_forbidden') {
    content += '<div style="display:flex;align-items:flex-start;gap:8px;padding:12px;border:1px solid #d1d5db;border-radius:8px;color:#374151;background:#fff;">'
    content += '<i class="fas fa-info-circle" style="margin-top:2px;"></i>'
    content += '<div>' + escapeHtml(ev.message || 'FindMarkers requires analyze permission on this project.') + '</div>'
    content += '</div>'
    return templateHtml('annot-evidences-tab-template').replace('__CONTENT__', content)
  }

  if (ev.state === 'stopped') {
    content += '<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px;border:1px solid #e5e7eb;border-radius:8px;color:#374151;background:#fff;">'
    content += '<div>' + escapeHtml(ev.message || 'FindMarkers was stopped for this metadata.') + '</div>'
    content += '<button type="button" onclick="loadAnnotationEvidences(true, { restart: true })" style="border:1px solid #d1d5db;background:#fff;color:#374151;border-radius:6px;padding:5px 10px;font-size:12px;cursor:pointer;">Retry</button>'
    content += '</div>'
    return templateHtml('annot-evidences-tab-template').replace('__CONTENT__', content)
  }

  if (ev.state === 'failed' || ev.state === 'error') {
    content += '<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px;border:1px solid #fecaca;border-radius:8px;color:#991b1b;background:#fff;">'
    content += '<div>' + escapeHtml(ev.message || 'Failed to load evidences.') + '</div>'
    content += '<button type="button" onclick="loadAnnotationEvidences()" style="border:1px solid #fca5a5;background:#fff;color:#991b1b;border-radius:6px;padding:5px 10px;font-size:12px;cursor:pointer;">Retry</button>'
    content += '</div>'
    return templateHtml('annot-evidences-tab-template').replace('__CONTENT__', content)
  }

  if (ev.state === 'completed') {
    var upRows = Array.isArray(ev.rowsUp) ? ev.rowsUp : []
    var downRows = Array.isArray(ev.rowsDown) ? ev.rowsDown : []
    if (upRows.length === 0 && downRows.length === 0) {
      content += '<div style="text-align:center;padding:18px;border:1px solid #e5e7eb;border-radius:8px;color:#6b7280;background:#fff;">No marker evidence matched the current thresholds.</div>'
    } else {
      var sub = _annotPopupData.evidencesSubTab || 'up'
      if (sub !== 'up' && sub !== 'down') sub = 'up'
      var evidSubNavStyle = function(dir) {
        var active = sub === dir
        var accent = dir === 'up' ? '#16a34a' : '#dc2626'
        var color = active ? accent : '#6b7280'
        var border = active ? ('2px solid ' + accent) : '2px solid transparent'
        return 'background:none;border:none;border-bottom:' + border + ';color:' + color + ';font-size:12px;font-weight:600;padding:8px 12px;cursor:pointer;margin-bottom:-1px;'
      }
      content += '<div style="display:flex;gap:0;border-bottom:1px solid #e5e7eb;margin-bottom:10px;">'
      content += '<button type="button" onclick="setEvidencesSubTab(\'up\')" style="' + evidSubNavStyle('up') + '">Up-regulated genes (' + upRows.length + ')</button>'
      content += '<button type="button" onclick="setEvidencesSubTab(\'down\')" style="' + evidSubNavStyle('down') + '">Down-regulated genes (' + downRows.length + ')</button>'
      content += '</div>'
      if (sub === 'up') {
        content += renderEvidenceGeneTableBlock(upRows, 'up', 'No up-regulated genes for this category at the current thresholds.')
      } else {
        content += renderEvidenceGeneTableBlock(downRows, 'down', 'No down-regulated genes for this category at the current thresholds.')
      }
    }
    return templateHtml('annot-evidences-tab-template').replace('__CONTENT__', content)
  }

  content += '<div style="text-align:center;padding:18px;border:1px solid #e5e7eb;border-radius:8px;color:#6b7280;background:#fff;">No evidence request has been made yet.</div>'
  return templateHtml('annot-evidences-tab-template').replace('__CONTENT__', content)
}

function renderAnnotationPanel() {
  var panel = document.getElementById('annot-popup-panel')
  var clas = _annotPopupData.clas || []
  var activeTab = _annotPopupData.activeTab || 'existing'

  var navButtonStyle = function(tab) {
    var isActive = activeTab === tab
    var color = isActive ? '#1d4ed8' : '#6b7280'
    var border = isActive ? '2px solid #1d4ed8' : '2px solid transparent'
    return 'background:none;border:none;color:' + color + ';font-size:12px;font-weight:600;padding:8px 10px;cursor:pointer;border-bottom:' + border + ';'
  }

  var html = ''
  html += '<div style="display:flex;align-items:center;border-bottom:1px solid #e5e7eb;padding:0 12px;background:#fff;">'
  html += '<button type="button" onclick="setAnnotationTab(\'new\')" style="' + navButtonStyle('new') + '">New annotation</button>'
  html += '<button type="button" onclick="setAnnotationTab(\'existing\')" style="' + navButtonStyle('existing') + '">Existing annotations <span style="display:inline-flex;align-items:center;justify-content:center;min-width:18px;height:18px;padding:0 5px;margin-left:6px;border-radius:999px;background:#e5e7eb;color:#374151;font-size:11px;font-weight:600;line-height:1;">' + clas.length + '</span></button>'
  html += '<button type="button" onclick="setAnnotationTab(\'evidences\')" style="' + navButtonStyle('evidences') + '" title="' + escapeHtml(markersStatusTooltip((_annotPopupData.evidences && _annotPopupData.evidences.loading) ? 'loading' : ((_annotPopupData.evidences && _annotPopupData.evidences.state) || 'idle'))) + '">' + identifyMarkersTabLeadingIconHtml() + 'Identify markers</button>'
  var boxN = (typeof window.annotEvidenceSelectedCount === 'function') ? window.annotEvidenceSelectedCount() : 0
  html += '<button type="button" data-annot-tab="evidence_boxplot" onclick="setAnnotationTab(\'evidence_boxplot\')" style="' + navButtonStyle('evidence_boxplot') + '">Violin (' + boxN + ' selected)</button>'
  html += '</div>'
  html += '<div style="overflow-y:auto;flex:1;padding:12px 16px;">'
  if (activeTab === 'new') {
    html += renderNewAnnotationTab()
  } else if (activeTab === 'evidences') {
    html += renderEvidencesTab()
  } else if (activeTab === 'evidence_boxplot') {
    html += renderEvidenceBoxplotTab()
  } else {
    html += renderExistingAnnotationsTab(clas)
  }
  html += '</div>'
  panel.innerHTML = html
  if (activeTab === 'new') initNewAnnotationTab()
  if (activeTab === 'evidence_boxplot' && typeof window.scheduleAnnotEvidenceBoxplotRender === 'function') {
    window.scheduleAnnotEvidenceBoxplotRender()
  }
}

window._annotPopupRenderPanel = renderAnnotationPanel
</script>

<%= render 'projects/views/annotation_popup' if annotation_tool_available %>
<script>
window.scheduleAnnotEvidenceBoxplotRender = function() {
  requestAnimationFrame(function() {
    requestAnimationFrame(function() {
      var c = window.visualizationController
      if (c && typeof c.renderAnnotEvidenceBoxplotPanel === 'function') {
        c.renderAnnotEvidenceBoxplotPanel()
      }
    })
  })
}

window.scheduleAnnotEvidenceViolinResizeRedraw = function() {
  requestAnimationFrame(function() {
    var c = window.visualizationController
    if (c && typeof c.redrawAnnotEvidenceViolinsAfterResize === 'function') {
      c.redrawAnnotEvidenceViolinsAfterResize()
    }
  })
}
</script>
