<div class="<%= [local_assigns[:wrapper_classes] || 'py-2 text-sm', 'max-h-[90vh] overflow-y-auto overscroll-contain'].join(' ') %>"
     <%= (local_assigns[:data_attributes] || {}).map { |key, value| %(data-#{key.to_s.tr('_', '-')}="#{value}") }.join(' ') %>>
  <% if guided_tours_for_menu.any? %>
    <details class="info-menu-guided-tours-disclosure mb-1 border-b border-gray-200 pb-1 dark:border-gray-600">
      <summary class="info-menu-guided-tours-summary flex cursor-pointer items-center justify-between gap-2 rounded-lg px-3 py-2 hover:bg-gray-100 dark:hover:bg-gray-700/60">
        <span class="text-sm font-medium text-gray-900 dark:text-gray-100">Guided tours</span>
        <span class="info-menu-guided-tours-chevron shrink-0 text-gray-400 dark:text-gray-500" aria-hidden="true"></span>
      </summary>
      <div class="info-menu-guided-tours-nested mt-1 border-l-2 border-gray-200 py-1 pl-3 ml-3 dark:border-gray-600">
        <% guided_tours_for_menu.each do |tour| %>
          <%= link_to tour.name,
                      guided_tour_start_url(tour.id),
                      class: "block rounded-md px-2 py-1.5 text-sm text-gray-800 hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-gray-700/60",
                      data: { controller: "nav-item", action: "click->nav-item#navigate" } %>
        <% end %>
      </div>
    </details>
  <% end %>
  <% info_menu_links.each do |link| %>
    <%= link_to link[:path],
                class: ["flex items-start gap-3 rounded-lg px-3 py-2 hover:bg-gray-100 dark:hover:bg-gray-700/60", link[:class]].compact.join(" "),
                data: { controller: "nav-item", action: "click->nav-item#navigate" } do %>
      <% if link[:icon].present? %>
        <i class="<%= link[:icon] %> mt-1 text-xs text-gray-500 dark:text-gray-400"></i>
      <% end %>
      <div>
        <p class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= link[:label] %></p>
        <% if link[:description].present? %>
          <p class="text-xs text-gray-500 dark:text-gray-400"><%= link[:description] %></p>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>


