<% content_for :title do %><%= @project.display_name %> - ASAP<% end %>
<% meta_desc = if @project.description.present?
  strip_tags(@project.description.to_s).squish.truncate(160)
else
  "Project #{@project.display_name} on ASAP, the Automated Single-cell Analysis Pipeline for single-cell transcriptomics."
end %>
<% content_for :meta_description, meta_desc %>

<!-- Content Area: archive/unarchive pending overlays apply to file-backed tabs -->
<%# Metadata-only views (summary, settings, admin access) read only database-backed
    information, so they can render without local project files. Overlays are
    suppressed for them unless the user explicitly clicked Unarchive
    (force_unarchive=1). Archiving (status 2) must never reuse the unarchive overlay. %>
<% unarchive_state = @project_unarchive_state.to_s %>
<% suppress_unarchive_overlay = metadata_only_view_request? && %w[summary settings access annotations].include?(@view_type.to_s) %>
<% suppress_archiving_overlay = !force_unarchive_requested? && %w[summary settings access annotations].include?(@view_type.to_s) %>
<% show_clone_pending = @project.being_cloned %>
<% show_archiving_pending = !suppress_archiving_overlay && @project_being_archived %>
<% show_unarchive_pending = !suppress_unarchive_overlay && (@project_being_unarchived || (@project_files_missing && %w[queued in_progress archived_missing queue_failed].include?(unarchive_state))) %>
<% if show_clone_pending %>
  <div class="flex-1 min-h-0 overflow-hidden flex flex-col">
    <%= render 'projects/views/clone_pending_overlay' %>
  </div>
<% elsif show_archiving_pending %>
  <div class="flex-1 min-h-0 overflow-hidden flex flex-col">
    <%= render 'projects/views/archiving_pending_overlay' %>
  </div>
<% elsif show_unarchive_pending %>
  <div class="flex-1 min-h-0 overflow-hidden flex flex-col">
    <%= render 'projects/views/unarchive_pending_overlay' %>
  </div>
<% else %>
<% case @view_type %>
<% when 'summary' %>
  <div class="flex-1 min-h-0 overflow-y-auto px-4 sm:px-6 lg:px-8 py-6">
    <%= render 'projects/views/summary' %>
  </div>
<% when 'visualization' %>
  <div class="flex-1 min-h-0 overflow-hidden">
    <%= render 'projects/views/visualization' %>
  </div>
<% when 'heatmap' %>
  <div class="flex-1 min-h-0 overflow-hidden">
    <%= render 'projects/views/heatmap' %>
  </div>
<% when 'analysis' %>
  <div class="flex-1 flex flex-col min-h-0 px-4 sm:px-6 lg:px-8 py-6">
    <%= render 'projects/views/analysis' %>
  </div>
<% when 'data' %>
  <div class="flex-1 min-h-0 overflow-y-auto px-4 sm:px-6 lg:px-8 py-6">
    <%= render 'projects/views/data' %>
  </div>
<% when 'settings' %>
  <div class="flex-1 min-h-0 overflow-y-auto px-4 sm:px-6 lg:px-8 py-6">
    <%= render 'projects/views/settings' %>
  </div>
<% when 'compliance' %>
  <div class="flex-1 min-h-0 overflow-y-auto px-4 sm:px-6 lg:px-8 py-6">
    <%= render 'projects/views/compliance' %>
  </div>
<% when 'access' %>
  <div class="flex-1 min-h-0 overflow-y-auto px-4 sm:px-6 lg:px-8 py-6">
    <%= render 'projects/views/access' %>
  </div>
<% when 'annotations' %>
  <div class="flex-1 min-h-0 overflow-y-auto px-4 sm:px-6 lg:px-8 py-6">
    <%= render 'projects/views/annotations' %>
  </div>
<% else %>
  <div class="flex-1 min-h-0 overflow-y-auto px-4 sm:px-6 lg:px-8 py-6">
    <%= render 'projects/views/summary' %>
  </div>
<% end %>
<% end %>
