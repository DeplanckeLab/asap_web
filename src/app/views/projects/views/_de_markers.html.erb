      message: '',
      runId: null,
      rowsUp: [],
      rowsDown: [],
      markersQueueBase: '',
      markersQueueNote: '',
      slurmQueueHover: ''
    };
    titleEl.innerHTML = buildAnnotPopupTitleHtml(catName, metadataName, 'loading', _annotPopupData.categoryColor);
    peekAnnotationMarkersStatus(metadataId, catIdx, evidencesUrl || '');

    panel.innerHTML = '<div style="display: flex; align-items: center; justify-content: center; height: 100%; color: #9ca3af; font-size: 14px;"><i class="fas fa-spinner fa-spin" style="margin-right: 8px;"></i> Loading...</div>';
    overlay.style.display = 'block';
    if (dialog.dataset.positioned !== 'true') {
      var dw = dialog.offsetWidth || 720;
      var dh = dialog.offsetHeight || 500;
      dialog.style.position = 'fixed';
      dialog.style.margin = '0';
      dialog.style.transform = 'none';
      dialog.style.left = Math.max(16, Math.round((window.innerWidth - dw) / 2)) + 'px';
      dialog.style.top = Math.max(40, Math.round((window.innerHeight - dh) / 2)) + 'px';
      dialog.dataset.positioned = 'true';
    }

    var url = baseUrl + '?annot_id=' + encodeURIComponent(metadataId) + '&cat_idx=' + encodeURIComponent(catIdx) + '&cat_name=' + encodeURIComponent(catName);
    fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
      .then(function(r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      })
      .then(function(data) {
        if (String(_annotPopupData.metadataId) !== String(metadataId) || String(_annotPopupData.catIdx) !== String(catIdx)) return;
        _annotPopupData.clas = data.clas || [];
        _annotPopupData.activeTab = preferredTab || 'existing';
