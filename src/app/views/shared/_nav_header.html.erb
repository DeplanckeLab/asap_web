<!-- ========== HEADER ========== -->
<header class="flex flex-wrap md:justify-start md:flex-nowrap fixed left-0 top-0 z-50 w-full bg-black border-b border-gray-200 dark:bg-black dark:border-neutral-700">
  <nav class="relative max-w-[85rem] w-full mx-auto flex items-center justify-between gap-3 py-2 px-4 sm:px-6 lg:px-8">

    <div class="flex items-center gap-3">
      <a class="flex-none inline-block w-32 h-8 font-semibold text-xl text-white focus:outline-hidden focus:opacity-80 dark:text-white" 
        href="<%= root_path %>" 
        aria-label="Brand"
        data-controller="nav-item"
        data-action="click->nav-item#navigate">
        <%= image_tag "ASAP_sansTagline_White.svg", 
        class: 'h-full w-full object-contain', 
          style: '', 
          alt: 'ASAP Logo' %> 
      </a>
    </div>

    <div class="md:order-3 flex justify-end items-center gap-x-1">
      <!-- Hamburger Menu Button (Mobile) -->
      <div class="md:hidden relative" data-controller="mobile-menu">
        <button type="button" 
                class="relative p-2 flex items-center font-medium text-sm rounded-lg border border-gray-200 text-white hover:bg-gray-100 focus:outline-hidden focus:bg-gray-100 focus:text-black disabled:opacity-50 disabled:pointer-events-none dark:text-white dark:border-neutral-700 dark:hover:bg-neutral-700 dark:focus:bg-neutral-700" 
                aria-expanded="false" 
                aria-label="Toggle navigation"
                data-mobile-menu-target="toggle"
                data-action="click->mobile-menu#toggle">
          <svg class="shrink-0 size-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
        
        <!-- Mobile Dropdown Menu -->
        <div class="hidden absolute right-0 mt-2 w-64 bg-white shadow-lg rounded-lg border border-gray-200 dark:bg-gray-800 dark:border-gray-700 z-[1000] max-h-[80vh] overflow-y-auto"
             data-mobile-menu-target="menu">
          <div class="py-2">
            <!-- Import Project -->
            <a class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-700"
               href="<%= external_catalog_candidates_path %>"
               data-controller="nav-item"
               data-action="click->nav-item#navigate">
              <i class="fas fa-file-import w-4 text-center"></i>
              Import project
            </a>

            <!-- New Project -->
            <% if user_signed_in? %>
              <a class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-700"
                 href="<%= raw(new_project_path) %>"
                 data-controller="nav-item"
                 data-action="click->nav-item#navigate">
                <i class="fas fa-plus w-4 text-center"></i>
                New project
              </a>
            <% else %>
              <% sandbox = guest_sandbox_project %>
              <% if sandbox %>
                <a class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-700"
                   href="<%= project_path(sandbox) %>"
                   data-controller="nav-item"
                   data-action="click->nav-item#navigate">
                  Open sandbox
                </a>
                <a class="flex items-center gap-2 px-4 py-2 text-sm text-amber-800 hover:bg-amber-50 dark:text-amber-200 dark:hover:bg-amber-500/10"
                   href="<%= raw(new_project_path) %>"
                   data-controller="nav-item"
                   data-action="click->nav-item#navigate"
                   data-confirm="Creating a new sandbox project will permanently replace your current sandbox (<%= sandbox.display_name %>). Continue?"
                   data-turbo-confirm="Creating a new sandbox project will permanently replace your current sandbox (<%= sandbox.display_name %>). Continue?">
                  <i class="fas fa-plus w-4 text-center"></i>
                  New sandbox project
                </a>
              <% else %>
                <a class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-700"
                   href="<%= raw(new_project_path) %>"
                   data-controller="nav-item"
                   data-action="click->nav-item#navigate">
                  <i class="fas fa-plus w-4 text-center"></i>
                  New sandbox project
                </a>
              <% end %>
            <% end %>
            
            <!-- Search Projects -->
            <a class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-700"
               href="<%= projects_path %>"
               data-controller="nav-item"
               data-action="click->nav-item#navigate"
               data-guided-tour="welcome-search-projects-nav">
              <i class="fas fa-search w-4 text-center"></i>
              Search projects
            </a>

            <!-- News -->
            <a class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-700"
               href="<%= news_items_path %>"
               data-controller="nav-item"
               data-action="click->nav-item#navigate">
              <i class="fas fa-newspaper w-4 text-center"></i>
              News
            </a>
            
            <% if guided_tours_for_menu.any? %>
              <div class="px-4 py-2">
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1">Guided tours</p>
                <% guided_tours_for_menu.each do |tour| %>
                  <%= link_to tour.name,
                              guided_tour_start_url(tour.id),
                              class: "flex items-center gap-2 px-0 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-700 rounded-lg",
                              data: { controller: "nav-item", action: "click->nav-item#navigate", guided_tour_start_id: tour.id } %>
                <% end %>
              </div>
              <div class="border-t border-gray-200 dark:border-gray-700 my-1"></div>
            <% end %>
            
            <!-- Info Section -->
            <div class="px-4 py-2">
              <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1">Info</p>
            </div>
            <% info_menu_links.each do |link| %>
              <a class="flex items-start gap-3 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-700"
                 href="<%= link[:path] %>"
                 data-controller="nav-item"
                 data-action="click->nav-item#navigate">
                <div class="flex-1">
                  <p class="font-medium"><%= link[:label] %></p>
                  <% if link[:description].present? %>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5"><%= link[:description] %></p>
                  <% end %>
                </div>
              </a>
            <% end %>
            
            <% if admin? %>
              <div class="border-t border-gray-200 dark:border-gray-700 my-1"></div>
              
              <!-- Admin Section -->
              <div class="px-4 py-2">
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1">Admin</p>
              </div>
              <% admin_menu_links.each do |link| %>
                <a class="flex items-start gap-3 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-700"
                   href="<%= link[:path] %>"
                   data-controller="nav-item"
                   data-action="click->nav-item#navigate">
                  <div class="flex-1">
                    <p class="font-medium"><%= link[:label] %></p>
                    <% if link[:description].present? %>
                      <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5"><%= link[:description] %></p>
                    <% end %>
                  </div>
                </a>
              <% end %>
            <% end %>
            
            <div class="border-t border-gray-200 dark:border-gray-700 my-1"></div>

            <!-- Feedback -->
            <div class="px-4 py-2">
              <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1">Feedback</p>
            </div>
            <% feedback_menu_links.each do |link| %>
              <a class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-700"
                 href="<%= link[:path] %>"
                 <%= 'target="_blank" rel="noopener noreferrer"'.html_safe if link[:external] %>>
                <i class="<%= link[:icon] %> w-4 text-center text-orange-400"></i>
                <%= link[:label] %>
              </a>
            <% end %>

            <div class="border-t border-gray-200 dark:border-gray-700 my-1"></div>
            
            <%= render "shared/user_menu_mobile", show_signup: true, dark_mode: true %>
          </div>
        </div>
      </div>
      <!-- End Hamburger Menu Button -->
      
      <!-- Desktop Menu Items -->
      <div class="hidden md:flex items-center gap-x-1">
        <div class="hidden md:inline-block md:me-2">
          <div class="w-px h-4 bg-gray-300 dark:bg-neutral-700"></div>
        </div>

        <%= render "shared/guided_tour_nav_dropdown" %>

        <a class="<%= tw_menu_item %>"
           href="<%= news_items_path %>"
           data-controller="nav-item"
           data-action="click->nav-item#navigate"
           title="News">
          <i class="fas fa-newspaper me-1.5"></i>
          News
        </a>

        <!-- Info Dropdown -->
        <div class="relative inline-block text-left"
             id="info-nav-dropdown"
             data-controller="nav-dropdown"
             data-nav-dropdown>
          <button type="button"
                  class="<%= tw_menu_item %> nav-top-dropdown-button cursor-pointer"
                  title="Open access resources"
                  aria-expanded="false"
                  data-nav-dropdown-toggle>
            <i class="fas fa-file-alt me-1.5"></i>
            Info
            <svg class="duration-300 shrink-0 size-4 ms-1" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </button>

          <%= render "shared/info_menu",
                    wrapper_classes: "hidden absolute right-0 mt-2 w-56 bg-white shadow-md rounded-lg p-2 dark:bg-gray-800 dark:border dark:border-gray-700 z-[1000] top-full",
                    data_attributes: { nav_menu: true } %>
        </div>
        <!-- End Info Dropdown -->

        <% if admin? %>
          <!-- Admin Dropdown -->
          <div class="relative inline-block text-left"
               id="admin-nav-dropdown"
               data-controller="nav-dropdown"
               data-nav-dropdown>
            <button type="button" 
                    id="admin-nav-button"
                    class="<%= tw_menu_item %> nav-top-dropdown-button cursor-pointer"
                    title="Admin tools"
                    aria-expanded="false"
                    data-nav-dropdown-toggle>
              <i class="fas fa-tools me-1.5"></i>
              Admin
              <svg class="duration-300 shrink-0 size-4 ms-1" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </button>

            <!-- Dropdown Menu -->
            <%= render "shared/admin_menu",
                      wrapper_classes: "hidden absolute right-0 mt-2 w-56 bg-white shadow-md rounded-lg p-2 dark:bg-gray-800 dark:border dark:border-gray-700 z-[1000] top-full",
                      data_attributes: { nav_menu: true } %>
          </div>
          <!-- End Admin Dropdown -->
        <% end %>

        <!-- Feedback Dropdown -->
        <div class="relative inline-block text-left"
             data-controller="nav-dropdown">
          <button type="button"
                  class="inline-flex items-center justify-center size-9 rounded-lg border border-transparent hover:bg-gray-100 dark:hover:bg-neutral-700 focus:outline-hidden transition"
                  title="Feedback"
                  data-nav-dropdown-toggle>
            <i class="fas fa-comment text-lg text-orange-400"></i>
          </button>
          <%= render "shared/feedback_menu",
                      wrapper_classes: "hidden absolute right-0 mt-2 w-64 bg-white shadow-md rounded-lg p-2 dark:bg-gray-800 dark:border dark:border-gray-700 z-[1000] top-full",
                      data_attributes: { nav_menu: true } %>
        </div>

        <%= render "shared/user_menu", 
                   show_signup: true, 
                   dark_mode: true,
                   wrapper_classes: "relative inline-block text-left",
                   button_classes: "relative size-9 flex justify-center items-center text-sm font-semibold rounded-lg border border-transparent hover:bg-gray-100 focus:outline-hidden focus:bg-gray-100 disabled:opacity-50 disabled:pointer-events-none dark:border-transparent dark:hover:bg-neutral-700 dark:focus:bg-neutral-700" %>
      </div>
      <!-- End Desktop Menu Items -->
    </div>

    <!-- Collapse -->
    <div id="hs-header-base" class="hs-overlay [--auto-close:md] hs-overlay-open:translate-x-0 -translate-x-full fixed top-0 start-0 transition-all duration-300 transform h-full max-w-xs w-full z-60 bg-black border-e basis-full grow md:order-2 md:static md:block md:h-auto md:max-w-none md:w-auto md:border-e-transparent md:transition-none md:translate-x-0 md:z-40 md:basis-auto dark:bg-black dark:border-e-gray-700 md:dark:border-e-transparent hidden" role="dialog" tabindex="-1" aria-label="Sidebar" data-hs-overlay-close-on-resize >
      <div class="overflow-hidden overflow-y-auto max-h-[75vh] [&::-webkit-scrollbar]:w-2 [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-track]:bg-gray-100 [&::-webkit-scrollbar-thumb]:bg-gray-300 dark:[&::-webkit-scrollbar-track]:bg-neutral-700 dark:[&::-webkit-scrollbar-thumb]:bg-neutral-500">
        <div class="py-2 md:py-0 px-2 md:px-0 flex flex-col md:flex-row md:items-center gap-0.5 md:gap-1">
          <!-- Offcanvas Header -->
          <div class="md:hidden p-2 flex justify-between items-center">
            <h3 id="hs-header-base-label" class="font-bold text-white">
              Menu title
            </h3>
            <button type="button" class="size-8 inline-flex justify-center items-center gap-x-2 rounded-full border border-transparent bg-gray-100 text-gray-800 hover:bg-gray-200 focus:outline-hidden focus:bg-gray-200 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-700 dark:hover:bg-neutral-600 dark:text-neutral-400 dark:focus:bg-neutral-600" aria-label="Close" data-hs-overlay="#hs-header-base">
              <span class="sr-only">Close</span>
              <svg class="shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
          </div>
          <!-- End Offcanvas Header -->
          <div class="grow">
            <div class="flex flex-col md:flex-row md:justify-end md:items-center gap-0.5 md:gap-1">
              

              

              <a class="<%= tw_menu_item %>"
                 href="<%= external_catalog_candidates_path %>"
                 data-controller="nav-item"
                 data-action="click->nav-item#navigate"
                 title="Import a dataset from an external catalog">
                <i class="fas fa-file-import me-1.5"></i>
                Import project
              </a>

              <% if user_signed_in? %>
                <a class="<%= tw_menu_item %>" 
                   href="<%= raw(new_project_path) %>">
                  <i class="fas fa-plus me-1.5"></i>
                  New project
                </a>
              <% else %>
                <% sandbox = guest_sandbox_project %>
                <% if sandbox %>
                  <a class="<%= tw_menu_item %>"
                     href="<%= project_path(sandbox) %>"
                     data-controller="nav-item"
                     data-action="click->nav-item#navigate"
                     title="<%= sandbox.display_name %>">
                    Open sandbox
                  </a>
                  <a class="<%= tw_menu_item %>"
                     href="<%= raw(new_project_path) %>"
                     title="Replaces your current sandbox project"
                     data-confirm="Creating a new sandbox project will permanently replace your current sandbox (<%= sandbox.display_name %>). Continue?"
                     data-turbo-confirm="Creating a new sandbox project will permanently replace your current sandbox (<%= sandbox.display_name %>). Continue?">
                    <i class="fas fa-plus me-1.5"></i>
                    New sandbox project
                  </a>
                <% else %>
                  <a class="<%= tw_menu_item %>"
                     href="<%= raw(new_project_path) %>"
                     title="Creates a temporary sandbox project">
                    <i class="fas fa-plus me-1.5"></i>
                    New sandbox project
                  </a>
                <% end %>
              <% end %>

              <a class="<%= tw_menu_item %>" 
                 href="<%= projects_path %>"
                 data-controller="nav-item"              
                 data-action="click->nav-item#navigate"
                 data-guided-tour="welcome-search-projects-nav">
                <i class="fas fa-search me-1.5"></i>
                Search projects
              </a>

              <a class="<%= tw_menu_item %> md:hidden"
                 href="<%= news_items_path %>"
                 data-controller="nav-item"
                 data-action="click->nav-item#navigate">
                <i class="fas fa-newspaper me-1.5"></i>
                News
              </a>

              <% if guided_tours_for_menu.any? %>
                <div class="md:hidden mt-2 w-full rounded-lg border border-white/10 p-2 text-white/80">
                  <p class="px-2 text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500">
                    Guided tours
                  </p>
                  <div class="mt-1 flex flex-col">
                    <% guided_tours_for_menu.each do |tour| %>
                      <%= link_to tour.name,
                                  guided_tour_start_url(tour.id),
                                  class: "#{tw_menu_item} flex items-center",
                                  data: { controller: "nav-item", action: "click->nav-item#navigate", guided_tour_start_id: tour.id } %>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <div class="md:hidden mt-2 w-full rounded-lg border border-white/10 p-2 text-white/80">
                <p class="px-2 text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500">
                  Info
                </p>
                <div class="mt-1 flex flex-col">
                  <% info_menu_links.each do |link| %>
                    <a class="<%= tw_menu_item %>"
                       href="<%= link[:path] %>"
                       data-controller="nav-item"
                       data-action="click->nav-item#navigate">
                      <span><%= link[:label] %></span>
                      <% if link[:description].present? %>
                        <span class="block text-xs text-gray-500 dark:text-gray-400"><%= link[:description] %></span>
                      <% end %>
                    </a>
                  <% end %>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- End Collapse -->
  </nav>
</header>
<!-- ========== END HEADER ========== -->
