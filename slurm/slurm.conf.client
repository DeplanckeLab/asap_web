# SLURM configuration for client tools (website container)
# This file is used by SLURM client tools (sbatch, squeue, scancel) in the website container
# to connect to slurmctld running on the host machine

ClusterName=asap_cluster
# Use host.docker.internal to connect to host from Docker container
# Docker provides this hostname automatically
ControlMachine=host.docker.internal
SlurmUser=slurm
SlurmdUser=root
SlurmctldPort=6817
SlurmdPort=6818
AuthType=auth/munge
StateSaveLocation=/var/spool/slurmctld
SlurmdSpoolDir=/var/spool/slurmd
SwitchType=switch/none
MpiDefault=none
SlurmctldPidFile=/var/run/slurmctld.pid
SlurmdPidFile=/var/run/slurmd.pid
ProctrackType=proctrack/pgid
TaskPlugin=task/none
LaunchParameters=disable_cgroup
ReturnToService=1
SlurmctldTimeout=300
SlurmdTimeout=300
InactiveLimit=0
MinJobAge=300
KillWait=30
Waittime=0
SchedulerType=sched/backfill
SelectType=select/linear
PriorityType=priority/multifactor
PriorityWeightFairShare=1000
PriorityWeightAge=100
PriorityWeightPartition=1000
PriorityWeightJobSize=1000
PriorityWeightQOS=0
PriorityMaxAge=7-0
PriorityDecayHalfLife=7-0
PriorityFavorSmall=NO
PriorityFlags=FAIR_TREE
SlurmctldDebug=info
SlurmdDebug=info
JobCompType=jobcomp/none
JobAcctGatherType=jobacct_gather/none
JobAcctGatherFrequency=30
AccountingStorageType=accounting_storage/slurmdbd
AccountingStorageHost=host.docker.internal
AccountingStoragePort=6819

# Node definitions
# Hardware: 4 Sockets, 18 Cores per Socket, 2 Threads per Core = 144 CPUs total
# Host node (slurmd running on host)
NodeName=updeplasrv4-new.epfl.ch NodeAddr=128.178.238.41 CPUs=144 Boards=1 SocketsPerBoard=4 CoresPerSocket=18 ThreadsPerCore=2 RealMemory=694741 State=UNKNOWN

# Partition definitions
PartitionName=debug Nodes=updeplasrv4-new.epfl.ch Default=YES MaxTime=INFINITE State=UP

