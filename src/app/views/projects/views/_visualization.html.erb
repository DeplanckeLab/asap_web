          <button id="cells-tab"
                  data-guided-tour="visualization-cell-sets-tab"
                  style="padding: 8px 16px; border-bottom: 2px solid #3b82f6; font-weight: 500; font-size: 14px; color: #3b82f6; background: none; border-top: none; border-left: none; border-right: none; cursor: pointer;"
