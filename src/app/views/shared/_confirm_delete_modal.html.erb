<div data-confirm-delete-target="modal"
     class="hidden fixed inset-0 z-50 flex items-center justify-center"
     role="dialog"
     aria-modal="true"
     aria-labelledby="confirm-delete-modal-title"
     data-action="click->confirm-delete#closeOnBackdrop keydown@window->confirm-delete#closeOnEscape">
  <div class="absolute inset-0 bg-black/40"></div>
  <div class="relative bg-white rounded-lg shadow-xl max-w-md w-full mx-4 border border-gray-200"
       data-action="click->confirm-delete#stop">
    <div class="px-5 py-4 border-b border-gray-200">
      <h2 id="confirm-delete-modal-title" class="text-base font-semibold text-gray-900 m-0">
        Confirm deletion
      </h2>
    </div>
    <div class="px-5 py-4">
      <p data-confirm-delete-target="message" class="text-sm text-gray-700 m-0"></p>
    </div>
    <div class="px-5 py-4 border-t border-gray-200 flex justify-end gap-2">
      <button type="button"
              class="inline-flex items-center px-4 py-2 rounded-md border border-gray-200 text-sm text-gray-700 hover:bg-gray-50"
              data-action="click->confirm-delete#close">
        Cancel
      </button>
      <button type="button"
              class="inline-flex items-center px-4 py-2 rounded-md bg-red-600 text-white text-sm font-medium hover:bg-red-700"
              data-action="click->confirm-delete#confirm">
        Delete
      </button>
    </div>
  </div>
</div>

<%= form_with url: "#",
              method: :delete,
              html: {
                data: { confirm_delete_target: "form" },
                class: "hidden"
              } do %>
<% end %>
