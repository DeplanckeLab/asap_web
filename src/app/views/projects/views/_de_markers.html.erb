  function evidenceGeneBadgeCellHtml(row, tone) {
    var symRaw = (row.gene != null && String(row.gene).trim() !== '') ? String(row.gene).trim() : (row.gene_id != null ? String(row.gene_id) : '-');
    var sym = escapeHtml(symRaw);
