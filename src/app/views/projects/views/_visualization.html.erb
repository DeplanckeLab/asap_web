                <span id="selected-cells-view-warning"
                      data-action="mouseenter->visualization#showViewLimitedTooltip mouseleave->visualization#hideViewLimitedTooltip"
                      data-view-limited-tooltip="Zoom/pan is active. The current view does not show all visible cells. Double click on the plot in Pick or Pan mode to reset Zoom/Pan."
                      style="display: none; margin-left: 6px; font-size: 12px; color: #b45309; font-weight: 500; align-items: center; gap: 4px; cursor: help;">
                  <span>view limited</span>
                  <i class="far fa-question-circle" style="font-size: 12px;" aria-hidden="true"></i>
                </span>
              </div>
              
              <!-- Action buttons (icons only) -->
              <div style="display: flex; gap: 8px;">
                <!-- Save Selection Button (Icon Only) -->
                <% if can_analyze_project %>
                  <button id="save-selection-btn"
                          style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;padding:0;background-color:#2563eb;color:white;border-radius:6px;border:none;cursor:pointer;transition:background-color 0.2s;"
                          title="Save Selection"
                          data-action="click->visualization#saveSelection"
                          onmouseover="this.style.backgroundColor='#1d4ed8'"
                          onmouseout="this.style.backgroundColor='#2563eb'">
                    <i class="fas fa-save" style="font-size: 14px;"></i>
                  </button>
                <% end %>
                
                <!-- Cancel Selection Button (Icon Only) -->
                <button id="cancel-selection-btn"
                        style="display: none; padding: 6px; background-color: #d1d5db; color: #374151; border-radius: 4px; border: none; cursor: pointer; transition: background-color 0.2s;"
                        title="Cancel lasso selection"
                        data-action="click->visualization#cancelSelection"
                        onmouseover="this.style.backgroundColor='#9ca3af'"
                        onmouseout="this.style.backgroundColor='#d1d5db'">
                  <i class="fas fa-times" style="font-size: 14px;"></i>
                </button>
              </div>
            </div>
            <div id="selection-distribution-wrap" style="display: none; flex-direction: column; gap: 4px; margin: 2px 0 6px 0;">
              <div id="selection-distribution-row" style="display: flex; align-items: center; gap: 8px; min-width: 0;">
                <span id="selection-distribution-label"
                      style="flex-shrink: 0; width: 72px; font-size: 11px; color: #6b7280; line-height: 1.2;">selection</span>
                <canvas id="selection-distribution-canvas"
                        class="selection-distribution-canvas"
                        style="display: block; flex: 1; min-width: 0; width: 100%; height: 8px; border-radius: 2px;"></canvas>
              </div>
              <div id="complement-distribution-row" style="display: none; align-items: center; gap: 8px; min-width: 0;">
                <span id="complement-distribution-label"
                      style="flex-shrink: 0; width: 72px; font-size: 11px; color: #6b7280; line-height: 1.2;">complement</span>
                <canvas id="complement-distribution-canvas"
                        class="selection-distribution-canvas"
                        style="display: block; flex: 1; min-width: 0; width: 100%; height: 8px; border-radius: 2px;"></canvas>
              </div>
            </div>
            <div style="height: 1px; background-color: #e5e7eb; margin: 0 0 4px 0;"></div>

            <!-- Saved Cell Sets List -->
            <div style="display: flex; flex-direction: column; flex: 1; min-height: 0;">
              <div style="display: flex; align-items: center; justify-content: space-between; margin: 0 0 8px 0;">
                <input id="saved-selections-name-filter-input"
                       type="text"
                       placeholder="Filter by name"
                       style="flex:1;min-width:0;max-width:220px;padding:6px 8px;border:1px solid #d1d5db;border-radius:6px;font-size:12px;color:#111827;background:#fff;" />
                <div style="display:flex;align-items:center;gap:8px;position:relative;margin-left:8px;">
                  <button id="sort-saved-selections-btn"
                          type="button"
                          style="display:none;align-items:center;justify-content:center;width:28px;height:28px;padding:0;background-color:white;color:#374151;border:1px solid #d1d5db;border-radius:6px;cursor:pointer;"
                          title="Sort saved cell sets"
                          aria-label="Sort saved cell sets">
                    <i class="fas fa-sort" style="font-size:12px;"></i>
                  </button>
                  <div id="sort-saved-selections-menu"
                       style="display:none;position:absolute;top:34px;right:0;z-index:30;min-width:220px;background:#ffffff;border:1px solid #e5e7eb;border-radius:8px;box-shadow:0 8px 18px rgba(0,0,0,0.12);padding:10px;">
                    <div style="font-size:12px;font-weight:600;color:#111827;margin-bottom:8px;">Sort cell sets</div>
                    <label for="sort-saved-selections-by" style="display:block;font-size:11px;color:#6b7280;margin-bottom:4px;">Sort by</label>
                    <select id="sort-saved-selections-by"
                            style="width:100%;padding:6px 8px;border:1px solid #d1d5db;border-radius:6px;font-size:12px;color:#111827;background:#fff;margin-bottom:8px;">
                      <option value="created_at">By creation date</option>
                      <option value="name">By name</option>
                      <option value="selected_count">By number of cells</option>
                    </select>
                    <label for="sort-saved-selections-order" style="display:block;font-size:11px;color:#6b7280;margin-bottom:4px;">Order</label>
                    <select id="sort-saved-selections-order"
                            style="width:100%;padding:6px 8px;border:1px solid #d1d5db;border-radius:6px;font-size:12px;color:#111827;background:#fff;">
                      <option value="asc">Ascending</option>
                      <option value="desc">Descending</option>
                    </select>
                  </div>
                  <button id="filter-saved-selections-btn"
                          type="button"
                          style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;padding:0;background-color:white;color:#374151;border:1px solid #d1d5db;border-radius:6px;cursor:pointer;"
                          title="Filter saved cell sets"
                          aria-label="Filter saved cell sets">
                    <i class="fas fa-filter" style="font-size:12px;"></i>
                  </button>
                  <div id="filter-saved-selections-menu"
                       style="display:none;position:absolute;top:34px;right:0;z-index:30;min-width:220px;background:#ffffff;border:1px solid #e5e7eb;border-radius:8px;box-shadow:0 8px 18px rgba(0,0,0,0.12);padding:6px;">
                    <div style="font-size:12px;font-weight:600;color:#111827;margin-bottom:8px;">Filter cell sets</div>
                    <div style="display:flex;flex-direction:column;gap:0;border:1px solid #e5e7eb;border-radius:6px;overflow:hidden;">
                      <button type="button" data-filter-type-option="all" style="display:flex;align-items:center;justify-content:space-between;gap:8px;text-align:left;padding:7px 8px;border:none;border-bottom:1px solid #e5e7eb;background:#fff;color:#111827;font-size:12px;cursor:pointer;">
                        <span>All type sets</span>
                        <span data-filter-check="all" style="display:none;color:#16a34a;"><i class="fas fa-check" style="font-size:11px;"></i></span>
                      </button>
                      <button type="button" data-filter-type-option="lasso" style="display:flex;align-items:center;justify-content:space-between;gap:8px;text-align:left;padding:7px 8px;border:none;border-bottom:1px solid #e5e7eb;background:#fff;color:#111827;font-size:12px;cursor:pointer;">
                        <span>Lasso sets</span>
                        <span data-filter-check="lasso" style="display:none;color:#16a34a;"><i class="fas fa-check" style="font-size:11px;"></i></span>
                      </button>
                      <button type="button" data-filter-type-option="visible" style="display:flex;align-items:center;justify-content:space-between;gap:8px;text-align:left;padding:7px 8px;border:none;border-bottom:1px solid #e5e7eb;background:#fff;color:#111827;font-size:12px;cursor:pointer;">
                        <span>Visible cells sets</span>
                        <span data-filter-check="visible" style="display:none;color:#16a34a;"><i class="fas fa-check" style="font-size:11px;"></i></span>
                      </button>
                      <button type="button" data-filter-type-option="compose" style="display:flex;align-items:center;justify-content:space-between;gap:8px;text-align:left;padding:7px 8px;border:none;border-bottom:1px solid #e5e7eb;background:#fff;color:#111827;font-size:12px;cursor:pointer;">
                        <span>Composed sets</span>
                        <span data-filter-check="compose" style="display:none;color:#16a34a;"><i class="fas fa-check" style="font-size:11px;"></i></span>
                      </button>
                      <button type="button" data-filter-type-option="heatmap-rect" style="display:flex;align-items:center;justify-content:space-between;gap:8px;text-align:left;padding:7px 8px;border:none;background:#fff;color:#111827;font-size:12px;cursor:pointer;">
                        <span>Heatmap sets</span>
                        <span data-filter-check="heatmap-rect" style="display:none;color:#16a34a;"><i class="fas fa-check" style="font-size:11px;"></i></span>
                      </button>
                    </div>
                  </div>
                  <% if can_analyze_project %>
                    <button id="de-selection-btn"
                            type="button"
                            style="display:inline-flex;align-items:center;justify-content:center;min-width:28px;height:28px;padding:0 8px;background-color:#7c3aed;color:white;border:none;border-radius:6px;cursor:pointer;font-size:11px;font-weight:700;"
                            title="Differential expression (run new DE or browse existing results)"
                            aria-label="Differential expression"
                            data-action="click->visualization#openDeSelectionModal">
                      DE
                    </button>
                    <button id="compose-selection-btn"
                            type="button"
                            style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;padding:0;background-color:#2563eb;color:white;border:none;border-radius:6px;cursor:pointer;"
                            title="Compose selection"
                            aria-label="Compose selection"
                            data-action="click->visualization#openComposeSelectionModal">
                      <%= image_tag 'compose_icon.svg', alt: '', 'aria-hidden': true, style: 'width:14px;height:14px;display:block;' %>
                    </button>
                    <button id="delete-all-saved-selections-btn"
                            type="button"
                            style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;padding:0;background-color:#dc2626;color:white;border:none;border-radius:6px;cursor:pointer;"
                            title="Delete all saved cell sets"
                            aria-label="Delete all saved cell sets"
                            data-action="click->visualization#deleteAllSavedSelections">
                      <i class="fas fa-trash" style="font-size:12px;"></i>
                    </button>
                  <% end %>
                  <button type="button"
                          class="viz-panel-header-icon-btn viz-mobile-panel-close-btn"
                          data-action="click->visualization#closeMobilePanel"
                          onmouseover="this.style.backgroundColor='#f3f4f6'; this.style.borderColor='#9ca3af'; this.style.color='#374151';"
                          onmouseout="this.style.backgroundColor='#f9fafb'; this.style.borderColor='#d1d5db'; this.style.color='#6b7280';"
                          title="Close panel"
                          aria-label="Close panel">
                    <i class="fas fa-times" style="font-size: 12px;" aria-hidden="true"></i>
                  </button>
                </div>
              </div>
              <div id="de-run-feedback" style="display:none;font-size:12px;color:#1d4ed8;margin:0 0 8px 0;"></div>
              <div id="saved-selections-list" data-checkpoint-scroll-key="saved-selections-list" style="flex: 1; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; gap: 6px; padding-right: 2px; box-sizing: border-box;">
                <div style="font-size: 12px; color: #6b7280; font-style: italic; padding: 8px 0;">
                  No cell sets yet
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Gene Sets Tab Content -->
        <div id="gene-sets-tab-content" style="flex: 1; padding: 16px 0; min-height: 0; display: none; overflow: hidden;">
          <div style="display: flex; flex-direction: column; gap: 8px; height: 100%; min-height: 0; width: 100%;">
            <div id="gene-set-collections-list-view" data-guided-tour="visualization-gene-set-collections-list" style="display:flex;flex-direction:column;gap:8px;height:100%;min-height:0;width:100%;">
              <div style="display: flex; align-items: center; justify-content: space-between; margin: 0 0 8px 0; width: 100%; padding: 0 16px; box-sizing: border-box;">
                <input id="gene-set-collections-name-filter-input"
                       type="text"
                       placeholder="Filter by name"
                       style="flex:1;min-width:0;width:100%;padding:6px 8px;border:1px solid #d1d5db;border-radius:6px;font-size:12px;color:#111827;background:#fff;" />
                <div style="display:flex;align-items:center;gap:8px;margin-left:8px;">
                  <button id="gene-set-collections-add-btn"
                          type="button"
                          data-gene-set-add-trigger="true"
                          style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;padding:0;background-color:#2563eb;color:white;border:none;border-radius:6px;cursor:pointer;"
                          title="Add a new Gene Set Collection"
                          aria-label="Add a new Gene Set Collection"
                          onmouseover="this.style.backgroundColor='#1d4ed8'"
                          onmouseout="this.style.backgroundColor='#2563eb'">
                    <span style="font-size:14px;font-weight:700;line-height:1;">+</span>
                  </button>
                  <button type="button"
                          class="viz-panel-header-icon-btn viz-mobile-panel-close-btn"
                          data-action="click->visualization#closeMobilePanel"
                          onmouseover="this.style.backgroundColor='#f3f4f6'; this.style.borderColor='#9ca3af'; this.style.color='#374151';"
                          onmouseout="this.style.backgroundColor='#f9fafb'; this.style.borderColor='#d1d5db'; this.style.color='#6b7280';"
                          title="Close panel"
                          aria-label="Close panel">
                    <i class="fas fa-times" style="font-size: 12px;" aria-hidden="true"></i>
                  </button>
                </div>
              </div>
              <div id="gene-set-collections-list" data-checkpoint-scroll-key="gene-set-collections-list" style="flex: 1; min-height: 0; overflow-y: auto; box-sizing: border-box; width: 100%; padding: 0 16px;">
                <div id="gene-set-collections-table-body" style="display:flex;flex-direction:column;gap:4px;width:100%;">
                  <% collections = Array(@gene_set_collections) %>
                  <% if collections.any? %>
                    <% collections.each do |collection| %>
                      <% collection_id = collection[:id].to_s %>
                      <div id="gene-set-collection-row-<%= collection_id.gsub(/[^A-Za-z0-9\-_:\.]/, '_').gsub(/_+/, '_').gsub(/^_+|_+$/, '').presence || 'item' %>"
                           data-gene-set-collection-row="true"
                           data-collection-id="<%= collection[:id] %>"
                           data-collection-label="<%= collection[:label] %>"
                           data-collection-name="<%= collection[:label].to_s.downcase %>"
                           data-collection-count="<%= collection[:nb_items] %>"
                           data-collection-custom="<%= collection[:custom] ? 'true' : 'false' %>"
                           data-collection-locked="<%= collection[:locked] ? 'true' : 'false' %>"
                           data-collection-import-pending="<%= collection[:import_pending] ? 'true' : 'false' %>"
                           data-collection-type-key="<%= collection[:type_key].to_s %>"
                           data-collection-type-label="<%= collection[:type_label].to_s %>"
                           data-collection-type-icon="<%= collection[:type_icon].to_s %>"
                           data-collection-type-icon-color="<%= collection[:type_icon_color].to_s %>"
                           style="width:100%;display:flex;align-items:center;justify-content:space-between;padding:5px 8px;background-color:white;border-radius:6px;border:1px solid #e5e7eb;cursor:pointer;gap:8px;">
                        <div style="flex:1;min-width:0;">
                          <% renameable_collection = collection[:custom] && !collection[:locked] && collection_id.start_with?('local_collection:') %>
                          <% icon_class = collection[:type_icon].to_s %>
                          <% icon_color = collection[:type_icon_color].to_s.presence || '#6b7280' %>
                          <% type_label = collection[:type_label].to_s.presence || 'Collection type' %>
                          <% if can_edit_project && renameable_collection %>
                            <div style="display:flex;align-items:center;gap:4px;min-width:0;">
                              <span title="<%= type_label %>"
                                    aria-label="<%= type_label %>"
                                    style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;color:<%= icon_color %>;flex:0 0 auto;">
                                <% if icon_class == 'DE' %>
                                  <span style="font-size:10px;font-weight:700;line-height:1;">DE</span>
                                <% else %>
                                  <i class="<%= icon_class %>" style="font-size:10px;"></i>
                                <% end %>
                              </span>
                              <span style="display:block;max-width:calc(100% - 40px);min-width:0;font-size:13px;font-weight:600;color:#111827;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.2;">
                                <%= collection[:label] %>
                              </span>
                              <button type="button"
                                      data-gene-set-collection-rename-trigger="true"
                                      data-collection-id="<%= collection[:id] %>"
                                      style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;color:#374151;background:none;border:none;cursor:pointer;padding:0;flex:0 0 auto;"
                                      title="Rename imported gene set collection"
                                      aria-label="Rename imported gene set collection">
                                <i class="fas fa-pen" style="font-size:9px;"></i>
                              </button>
                            </div>
                          <% else %>
                            <div style="display:flex;align-items:center;gap:4px;min-width:0;">
                              <span title="<%= type_label %>"
                                    aria-label="<%= type_label %>"
                                    style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;color:<%= icon_color %>;flex:0 0 auto;">
                                <% if icon_class == 'DE' %>
                                  <span style="font-size:10px;font-weight:700;line-height:1;">DE</span>
                                <% else %>
                                  <i class="<%= icon_class %>" style="font-size:10px;"></i>
                                <% end %>
                              </span>
                              <div style="font-size:13px;font-weight:600;color:#111827;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.2;min-width:0;">
                                <%= collection[:label] %>
                              </div>
                            </div>
                          <% end %>
                          <div style="font-size:11px;color:#6b7280;line-height:1.2;margin-top:2px;">
                            <%= collection[:nb_items] %> <%= collection[:nb_items].to_i == 1 ? 'gene set' : 'gene sets' %>
                          </div>
                        </div>
                        <div data-role="collection-actions" style="display:flex;align-items:center;justify-content:flex-end;flex:0 0 auto;">
                          <% if collection[:locked] %>
                            <span style="display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;color:#6b7280;background:none;border:none;padding:0;"
                                  title="Created before publication; cannot be modified"
                                  aria-label="Created before publication; cannot be modified">
                              <i class="fas fa-lock" style="font-size:12px;"></i>
                            </span>
                          <% end %>
                          <% if can_edit_project && collection[:custom] && !collection[:locked] %>
                            <button type="button"
                                    data-gene-set-delete-btn="true"
                                    data-collection-id="<%= collection[:id] %>"
                                    style="display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;color:#dc2626;background:none;border:none;cursor:pointer;padding:0;"
                                    title="Delete custom gene set collection"
                                    aria-label="Delete custom gene set collection">
                              <i class="fas fa-trash" style="font-size:12px;"></i>
                            </button>
                          <% end %>
                          <button type="button"
                                  data-gene-set-download-btn="true"
                                  data-collection-id="<%= collection[:id] %>"
                                  data-collection-label="<%= collection[:label] %>"
                                  style="display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;padding:0;color:#374151;background:none;border:1px solid #d1d5db;border-radius:4px;cursor:pointer;line-height:1;margin-left:4px;"
                                  title="Download gene set collection"
                                  aria-label="Download gene set collection">
                            <i class="fas fa-download" style="font-size:11px;"></i>
                          </button>
                        </div>
                      </div>
                    <% end %>
                  <% end %>
                </div>
                <div id="gene-set-collections-empty-message"
                     style="<%= collections.any? ? 'display:none;' : 'display:block;' %>font-size:12px;color:#6b7280;font-style:italic;padding:8px 0;">
                  No gene set collections yet
                </div>
              </div>
            </div>

            <div id="gene-set-collection-detail-view" style="display:none;flex-direction:column;gap:8px;height:100%;min-height:0;width:100%;">
              <div style="display:flex;align-items:center;justify-content:space-between;padding:0 16px;box-sizing:border-box;">
                <div id="gene-set-collection-detail-title" style="font-size:14px;font-weight:600;color:#111827;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"></div>
                <button id="gene-set-collection-back-btn"
                        type="button"
                        style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;padding:0;background-color:white;color:#374151;border:1px solid #d1d5db;border-radius:6px;cursor:pointer;"
                        title="Back to gene set collections"
                        aria-label="Back to gene set collections">
                  <i class="fas fa-arrow-left" style="font-size:12px;"></i>
                </button>
              </div>
              <div style="display:flex;align-items:center;gap:8px;padding:0 16px;box-sizing:border-box;">
                <input id="gene-set-items-name-filter-input"
                       type="text"
                       placeholder="Filter gene sets by name"
                       style="flex:1;min-width:0;width:100%;padding:6px 8px;border:1px solid #d1d5db;border-radius:6px;font-size:12px;color:#111827;background:#fff;" />
                <button id="gene-set-items-filter-history-btn"
                        type="button"
                        style="display:none;flex:0 0 auto;align-items:center;justify-content:center;width:28px;height:28px;padding:0;background-color:white;color:#374151;border:1px solid #d1d5db;border-radius:6px;cursor:pointer;"
                        title="Restore previous filter"
                        aria-label="Restore previous filter">
                  <i class="fas fa-rotate-left" style="font-size:12px;"></i>
                </button>
                <span id="gene-set-items-count-label" style="display:none;font-size:11px;color:#6b7280;white-space:nowrap;"></span>
              </div>
              <div id="gene-set-items-list" style="flex:1;min-height:0;overflow-y:auto;box-sizing:border-box;width:100%;padding:0 16px;display:flex;flex-direction:column;gap:4px;"></div>
              <div id="gene-set-items-empty-message" style="display:none;font-size:12px;color:#6b7280;font-style:italic;padding:0 16px;">
                No gene sets found
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


<!-- Floating Settings Window -->
<div id="settings-window" class="settings-window" style="display: none;">
  
  <!-- Window Header -->
  <div id="settings-header" class="settings-window-header">
    <h3 style="margin: 0; font-size: 14px; font-weight: 600; color: #374151;">Plot Settings</h3>
    <button id="close-settings-btn" 
            style="background: none; border: none; color: #6b7280; cursor: pointer; padding: 4px; border-radius: 4px; transition: background-color 0.2s;"
            onmouseover="this.style.backgroundColor='#e5e7eb'"
            onmouseout="this.style.backgroundColor='transparent'">
      <i class="fas fa-times" style="font-size: 12px;"></i>
    </button>
  </div>
  
  <!-- Window Content -->
  <div class="settings-window-body">
    <div style="display: flex; flex-direction: column; gap: 16px;">
      <!-- Settings Tabs -->
      <div style="display: flex; gap: 8px; border-bottom: 1px solid #e5e7eb; padding-bottom: 10px; flex-wrap: wrap;">
        <button id="settings-tab-general"
