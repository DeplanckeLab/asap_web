<div id="annotation-popup-gene-modal-overlay" class="hidden fixed inset-0 flex items-center justify-center" style="background-color: rgba(0,0,0,0.5); z-index: 12300;">
  <div class="bg-white rounded-lg shadow-xl max-w-3xl w-full mx-4 overflow-hidden" style="max-height: 80vh;">
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200" style="background: linear-gradient(to right, #f0fdf4, #ecfdf5);">
      <h3 class="text-lg font-semibold text-gray-900" id="annotation-popup-gene-modal-title">Gene details</h3>
      <button type="button" onclick="closeAnnotationPopupGeneModal()" style="background: none; border: none; cursor: pointer; color: #6b7280; padding: 4px; border-radius: 4px; transition: color 0.2s;" onmouseover="this.style.color='#111827'" onmouseout="this.style.color='#6b7280'">
        <i class="fas fa-times" style="font-size: 18px;"></i>
      </button>
    </div>
    <div class="px-6 py-5 overflow-auto" style="max-height: calc(80vh - 60px);" id="annotation-popup-gene-modal-body">
      <div class="text-gray-500 text-sm">Loading...</div>
    </div>
  </div>
</div>

<script>
(function() {
  function escAttr(s) {
    return String(s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;')
  }

  window.claGeneBadgesRowHtml = function(genes, kind) {
    if (!genes || genes.length === 0) return ''
    var isUp = kind === 'up'
    var label = isUp ? 'Up genes: ' : 'Down genes: '
    var highlightCls = isUp ? 'bg-green-100 text-green-800 hover:bg-green-200' : 'bg-red-100 text-red-800 hover:bg-red-200'
    var html = ''
    html += '<div style="margin-bottom: 6px;">'
    html += '<span style="font-size: 12px; color: #6b7280; font-weight: 500;">' + escAttr(label) + '</span>'
    html += '<div class="flex flex-wrap gap-1 mt-1">'
    genes.forEach(function(g) {
      var symRaw = String(g.symbol != null ? g.symbol : (g.gene_id || '-')).trim()
      var sym = escAttr(symRaw)
      var ens = g.ensembl_id != null ? String(g.ensembl_id).trim() : ''
      var symLookup = (g.symbol != null && String(g.symbol).trim() !== '') ? String(g.symbol).trim() : ''
      if (!symLookup && g.gene_id != null && !/^ENS[0-9A-Za-z._-]+$/i.test(String(g.gene_id).trim())) {
        symLookup = String(g.gene_id).trim()
      }
      var remoteGid = ''
      var st = g.stable_id != null ? String(g.stable_id).trim() : ''
      var gidRaw = g.gene_id != null ? String(g.gene_id).trim() : ''
      if (/^\d+$/.test(st)) remoteGid = st
      else if (/^\d+$/.test(gidRaw)) remoteGid = gidRaw
      var canOpen = !!(remoteGid || ens || symLookup)
      var cls = highlightCls
      var curs = canOpen ? 'cursor-pointer' : 'cursor-default'
      html += '<span class="annot-popup-gene-badge gene-badge ' + cls + ' ' + curs + ' inline-flex items-center px-2 py-0.5 rounded text-xs font-medium"'
      if (remoteGid) html += ' data-remote-gene-id="' + escAttr(remoteGid) + '"'
      if (ens) html += ' data-ensembl-id="' + escAttr(ens) + '"'
      if (symLookup) html += ' data-gene-symbol="' + escAttr(symLookup) + '"'
      html += ' title="' + escAttr(ens || symRaw || symLookup) + '">' + sym + '</span>'
    })
    html += '</div></div>'
    return html
  }

  window.openAnnotationPopupGeneModal = function(ensemblId, searchUrl, geneSymbol, remoteGeneId, extras) {
    var overlay = document.getElementById('annotation-popup-gene-modal-overlay')
    var body = document.getElementById('annotation-popup-gene-modal-body')
    var title = document.getElementById('annotation-popup-gene-modal-title')
    if (!overlay || !body || !title) return
    extras = extras || {}
    var ens = ensemblId != null ? String(ensemblId).trim() : ''
    var sym = geneSymbol != null ? String(geneSymbol).trim() : ''
    var rid = remoteGeneId != null ? String(remoteGeneId).trim() : ''
    var featureName = extras.featureName != null ? String(extras.featureName).trim() : ''
    var stableId = extras.stableId != null ? String(extras.stableId).trim() : ''
    var loomFile = extras.loomFile != null ? String(extras.loomFile).trim() : ''
    var ensemblRelease = extras.ensemblRelease != null ? String(extras.ensemblRelease).trim() : ''
    var ensemblRe = /\b((?:ENS[A-Z]{0,4}G|MGP_[A-Za-z0-9]+_G)\d+)(?:\.\d+)?\b/i
    if (!ensemblRe.test(ens)) {
      var fromSym = sym.match(ensemblRe)
      if (fromSym) {
        ens = fromSym[1]
        sym = sym.replace(fromSym[0], ' ').replace(/\s+/g, ' ').trim()
      } else {
        ens = ''
      }
    } else {
      ens = ens.match(ensemblRe)[1]
    }
    if (sym.indexOf('[') >= 0) {
      sym = sym.replace(/\[.*?\]/g, ' ').replace(/\s+/g, ' ').trim()
    }
    var parts = []
    if (ens) parts.push('ensembl_id=' + encodeURIComponent(ens))
    if (sym) parts.push('gene_symbol=' + encodeURIComponent(sym))
    if (featureName) parts.push('feature_name=' + encodeURIComponent(featureName))
    if (stableId) parts.push('stable_id=' + encodeURIComponent(stableId))
    if (loomFile) parts.push('loom_file=' + encodeURIComponent(loomFile))
    if (ensemblRelease) parts.push('ensembl_release=' + encodeURIComponent(ensemblRelease))
    if (parts.length === 0) return
    if (sym) title.textContent = sym
    else if (ens) title.textContent = ens
    else title.textContent = rid
    body.textContent = ''
    var loadWrap = document.createElement('div')
    loadWrap.className = 'space-y-2'
    var headLine = document.createElement('p')
    headLine.className = 'text-gray-800 text-sm font-medium'
    headLine.textContent = sym || ens || rid
    var subLine = document.createElement('p')
    subLine.className = 'text-gray-500 text-sm'
    subLine.textContent = 'Loading reference gene details from the annotation database...'
    loadWrap.appendChild(headLine)
    loadWrap.appendChild(subLine)
    body.appendChild(loadWrap)
    overlay.classList.remove('hidden')
    var csrfMeta = document.querySelector('meta[name="csrf-token"]')
    var csrfToken = csrfMeta ? csrfMeta.getAttribute('content') : ''
    var url = searchUrl + (searchUrl.indexOf('?') >= 0 ? '&' : '?') + parts.join('&') + '&_ts=' + Date.now()
    var t0 = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now()
    console.info('[gene-details.timing] search_gene fetch start', { ens: ens, sym: sym, url: url })
    fetch(url, { headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'text/html', 'Cache-Control': 'no-cache' }, credentials: 'same-origin' })
      .then(function(r) { return r.text().then(function(html) { return { ok: r.ok, status: r.status, html: html } }) })
      .then(function(result) {
        var t1 = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now()
        console.info('[gene-details.timing] search_gene fetch done', {
          status: result.status,
          ms: Math.round(t1 - t0),
          html_bytes: result.html ? result.html.length : 0
        })
        body.innerHTML = result.html
        var afterMemberships = function() {
          var t3 = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now()
          console.info('[gene-details.timing] popup ready (details+memberships)', { ms_from_start: Math.round(t3 - t0) })
          if (window.bindGeneDetailsMembershipExpanders) {
            window.bindGeneDetailsMembershipExpanders(body)
          }
        }
        if (window.loadGeneDetailsMemberships) {
          window.loadGeneDetailsMemberships(body).then(afterMemberships).catch(afterMemberships)
        } else {
          afterMemberships()
        }
      })
      .catch(function(err) {
        var tErr = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now()
        console.warn('[gene-details.timing] search_gene fetch failed', { ms: Math.round(tErr - t0), error: String(err) })
        body.innerHTML = '<div class="text-red-600 text-sm">Failed to load gene details.</div>'
      })
  }

  window.loadGeneDetailsMemberships = async function(rootEl) {
    var root = rootEl || document.getElementById('annotation-popup-gene-modal-body')
    if (!root) return
    var slot = root.querySelector('[data-gene-details-memberships-root="true"]')
    if (!slot) return
    var geneId = String(slot.dataset.geneId || '').trim()
    var membershipsUrl = String(slot.dataset.membershipsUrl || '').trim()
    if (!geneId || !membershipsUrl) return
    var csrfMeta = document.querySelector('meta[name="csrf-token"]')
    var csrfToken = csrfMeta ? csrfMeta.getAttribute('content') : ''
    var url = membershipsUrl + (membershipsUrl.indexOf('?') >= 0 ? '&' : '?') +
      'gene_id=' + encodeURIComponent(geneId) + '&_ts=' + Date.now()
    var t0 = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now()
    console.info('[gene-details.timing] memberships fetch start', { geneId: geneId })
    var response = await fetch(url, {
      headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'text/html', 'Cache-Control': 'no-cache' },
      credentials: 'same-origin'
    })
    var html = await response.text()
    var t1 = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now()
    console.info('[gene-details.timing] memberships fetch done', {
      status: response.status,
      ms: Math.round(t1 - t0),
      html_bytes: html ? html.length : 0
    })
    if (!response.ok) {
      slot.innerHTML = '<div class="pt-2 border-t border-gray-200"><div class="mt-2 text-sm text-gray-500">Failed to load gene set collections.</div></div>'
      return
    }
    slot.outerHTML = html
  }

  window.bindGeneDetailsMembershipExpanders = function(rootEl) {
    var root = rootEl || document.getElementById('annotation-popup-gene-modal-body')
    if (!root) return
    Array.from(root.querySelectorAll('[data-gene-membership-collection="true"]')).forEach(function(detailsEl) {
      if (detailsEl.dataset.boundMembershipExpand === 'true') return
      detailsEl.dataset.boundMembershipExpand = 'true'
      detailsEl.addEventListener('toggle', function() {
        if (!detailsEl.open) return
        if (detailsEl.dataset.membershipItemsLoaded === 'true') return
        detailsEl.dataset.membershipItemsLoaded = 'true'
        window.loadGeneDetailsMembershipItems(detailsEl)
      })
    })
  }

  window.loadGeneDetailsMembershipItems = async function(detailsEl) {
    if (!detailsEl) return
    var itemsHost = detailsEl.querySelector('[data-gene-membership-items="true"]')
    if (!itemsHost) return
    var geneId = String(detailsEl.dataset.geneId || '').trim()
    var collectionId = String(detailsEl.dataset.collectionId || '').trim()
    var itemsUrl = String(detailsEl.dataset.itemsUrl || '').trim()
    if (!geneId || !collectionId || !itemsUrl) {
      itemsHost.innerHTML = '<div class="text-sm text-gray-500">Unable to load gene sets.</div>'
      return
    }
    itemsHost.innerHTML = '<div class="text-sm text-gray-500">Loading matching gene sets...</div>'
    var csrfMeta = document.querySelector('meta[name="csrf-token"]')
    var csrfToken = csrfMeta ? csrfMeta.getAttribute('content') : ''
    var url = itemsUrl + (itemsUrl.indexOf('?') >= 0 ? '&' : '?') +
      'gene_id=' + encodeURIComponent(geneId) +
      '&collection_id=' + encodeURIComponent(collectionId) +
      '&_ts=' + Date.now()
    var t0 = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now()
    try {
      var response = await fetch(url, {
        headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'text/html', 'Cache-Control': 'no-cache' },
        credentials: 'same-origin'
      })
      var html = await response.text()
      var t1 = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now()
      console.info('[gene-details.timing] membership items fetch done', {
        collectionId: collectionId,
        status: response.status,
        ms: Math.round(t1 - t0),
        html_bytes: html ? html.length : 0
      })
      if (!response.ok) {
        itemsHost.innerHTML = '<div class="text-sm text-gray-500">Failed to load gene sets.</div>'
        detailsEl.dataset.membershipItemsLoaded = 'false'
        return
      }
      itemsHost.innerHTML = html
      if (window.bindGeneDetailsGeneSetCardClicks) {
        window.bindGeneDetailsGeneSetCardClicks(itemsHost)
      }
    } catch (_err) {
      itemsHost.innerHTML = '<div class="text-sm text-gray-500">Failed to load gene sets.</div>'
      detailsEl.dataset.membershipItemsLoaded = 'false'
    }
  }

  window.bindGeneDetailsGeneSetCardClicks = function(rootEl) {
    var root = rootEl || document.getElementById('annotation-popup-gene-modal-body')
    if (!root) return
    Array.from(root.querySelectorAll('[data-gene-set-item-card="true"]')).forEach(function(card) {
      if (card.dataset.boundGeneSetCardClick === 'true') return
      card.dataset.boundGeneSetCardClick = 'true'
      card.addEventListener('click', async function(event) {
        event.preventDefault()
        event.stopPropagation()
        var collectionId = String(card.dataset.geneSetCollectionId || '').trim()
        var collectionLabel = String(card.dataset.geneSetCollectionLabel || '').trim()
        var targetItemId = String(card.dataset.geneSetItemId || '').trim()
        var cardTitleEl = card.querySelector('.text-sm.font-medium')
        var targetItemLabel = cardTitleEl ? String(cardTitleEl.textContent || '').trim() : ''
        var viz = window.visualizationController || null
        var gsc = viz ? viz.geneSetCollectionsController : null
        if (!viz || !gsc || !collectionId || !targetItemId) return
        try {
          if (typeof viz.setSelectionTab === 'function') viz.setSelectionTab('gene-sets')
          await gsc.openCollectionDetail(collectionId, collectionLabel)
          if (targetItemLabel && typeof gsc.fetchCollectionItems === 'function') {
            await gsc.fetchCollectionItems(collectionId, targetItemLabel)
          }
          var rowId = (typeof gsc.buildCollectionItemRowElementId === 'function') ? gsc.buildCollectionItemRowElementId(targetItemId) : ''
          var row = rowId ? document.getElementById(rowId) : null
          if (!row && gsc.itemsList) {
            row = gsc.itemsList.querySelector('[data-gene-set-item-row="true"][data-gene-set-item-id="' + targetItemId.replace(/"/g, '\\"') + '"]')
          }
          if (row && typeof row.scrollIntoView === 'function') {
            row.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'nearest' })
            var prevOutline = row.style.outline
            var prevBg = row.style.backgroundColor
            row.style.outline = '2px solid #3b82f6'
            row.style.backgroundColor = '#eff6ff'
            window.setTimeout(function() {
              row.style.outline = prevOutline
              row.style.backgroundColor = prevBg
            }, 1200)
          }
        } catch (_err) {
        }
      })
    })
  }

  // Kept for callers that still invoke the old name; no longer storms gene_set_item_genes.
  window.enhanceGeneDetailsGeneSetCards = async function(rootEl) {
    if (window.bindGeneDetailsMembershipExpanders) {
      window.bindGeneDetailsMembershipExpanders(rootEl)
    }
    if (window.bindGeneDetailsGeneSetCardClicks) {
      window.bindGeneDetailsGeneSetCardClicks(rootEl)
    }
  }

  window.closeAnnotationPopupGeneModal = function() {
    var overlay = document.getElementById('annotation-popup-gene-modal-overlay')
    if (overlay) overlay.classList.add('hidden')
  }

  function annotEvidenceSortGeneKey(row) {
    var s = (row.gene != null && String(row.gene).trim() !== '') ? String(row.gene).trim() : (row.gene_id != null ? String(row.gene_id) : '-')
    return s.toLowerCase()
  }

  window.annotEvidenceGeneSortValue = annotEvidenceSortGeneKey

  function annotEvidenceSortNumField(row, col) {
    var v
    if (col === 1) v = row.log2fc
    else if (col === 2) v = row.fdr
    else if (col === 3) v = row.p_value
    else return 0
    if (v === null || v === undefined || v === '') return 0
    var n = parseFloat(v)
    return Number.isFinite(n) ? n : 0
  }

  window.annotEvidenceSortedRows = function(rows, tone) {
    var apd = window._annotPopupData
    if (!apd || !rows || rows.length === 0) return (rows || []).slice()
    if (!apd.evidencesSort) apd.evidencesSort = { up: { col: 1, asc: false }, down: { col: 1, asc: true } }
    var st = apd.evidencesSort[tone === 'down' ? 'down' : 'up']
    if (!st || st.col === null || st.col === undefined) return rows.slice()
    var col = st.col
    var asc = st.asc !== false
    return rows.slice().sort(function(a, b) {
      var cmp = 0
      if (col === 0) {
        cmp = annotEvidenceSortGeneKey(a).localeCompare(annotEvidenceSortGeneKey(b))
      } else {
        cmp = annotEvidenceSortNumField(a, col) - annotEvidenceSortNumField(b, col)
      }
      return asc ? cmp : -cmp
    })
  }

  window.annotEvidenceSortColumnClick = function(colIdx) {
    var apd = window._annotPopupData
    if (!apd || apd.activeTab !== 'evidences') return
    var sub = apd.evidencesSubTab === 'down' ? 'down' : 'up'
    if (!apd.evidencesSort) apd.evidencesSort = { up: { col: 1, asc: false }, down: { col: 1, asc: true } }
    var st = apd.evidencesSort[sub]
    if (st.col === colIdx) st.asc = !st.asc
    else { st.col = colIdx; st.asc = true }
    var fn = window._annotPopupRenderPanel
    if (typeof fn === 'function') fn()
  }

  window.annotEvidenceSortThHtml = function(tone, colIdx, label, stickyStyle) {
    var apd = window._annotPopupData
    var ind = ''
    if (apd && apd.evidencesSort) {
      var st = apd.evidencesSort[tone === 'down' ? 'down' : 'up']
      if (st && st.col === colIdx) ind = st.asc ? ' \u25B2' : ' \u25BC'
    }
    var base = stickyStyle + 'cursor:pointer;user-select:none;'
    return '<th data-sort-col="' + colIdx + '" style="' + base + '" onclick="annotEvidenceSortColumnClick(' + colIdx + '); return false;" title="Sort">' + escAttr(label) + '<span class="sort-indicator">' + ind + '</span></th>'
  }

  window.annotEvidenceSelectionKey = function(tone, row) {
    var g = (row && row.gene_id != null) ? String(row.gene_id) : ''
    var s = (row && row.gene != null) ? String(row.gene) : ''
    return String(tone) + '|' + g + '|' + s
  }

  window.annotEvidenceEnsureSelectionStore = function() {
    var apd = window._annotPopupData
    if (!apd) return null
    if (!Array.isArray(apd.evidencesSelectedOrder)) apd.evidencesSelectedOrder = []
    if (!apd.evidencesSelectedRows || typeof apd.evidencesSelectedRows !== 'object') apd.evidencesSelectedRows = {}
    return apd
  }

  window.annotEvidenceSelectedCount = function() {
    var apd = window.annotEvidenceEnsureSelectionStore()
    return apd ? apd.evidencesSelectedOrder.length : 0
  }

  window.annotEvidenceCheckboxChange = function(el) {
    var apd = window.annotEvidenceEnsureSelectionStore()
    if (!apd || !el) return
    var key = el.getAttribute('data-evidence-key')
    var tone = el.getAttribute('data-evidence-tone') || 'up'
    var geneId = el.getAttribute('data-evidence-gene-id') || ''
    var gene = el.getAttribute('data-evidence-gene-symbol') || ''
    if (!key) return
    if (el.checked) {
      if (apd.evidencesSelectedOrder.indexOf(key) < 0) apd.evidencesSelectedOrder.push(key)
      apd.evidencesSelectedRows[key] = { tone: tone, gene_id: geneId, gene: gene }
    } else {
      var next = []
      apd.evidencesSelectedOrder.forEach(function(k) { if (k !== key) next.push(k) })
      apd.evidencesSelectedOrder = next
      delete apd.evidencesSelectedRows[key]
    }
    var upd = window._annotPopupUpdateBoxplotTabLabel
    if (typeof upd === 'function') upd()
    if (apd.activeTab === 'evidence_boxplot' && typeof window.scheduleAnnotEvidenceBoxplotRender === 'function') {
      window.scheduleAnnotEvidenceBoxplotRender()
    }
  }

  window.addAnnotEvidenceGeneToVisualizationFromBtn = function(btn) {
    if (!btn) return
    window.addAnnotEvidenceGeneToVisualization(
      btn.getAttribute('data-evidence-tone') || 'up',
      btn.getAttribute('data-evidence-gene-id') || '',
      btn.getAttribute('data-evidence-gene-symbol') || ''
    )
  }

  window.addAnnotEvidenceGeneToVisualization = function(tone, geneId, geneSymbol) {
    var vc = window.visualizationController
    var gm = window.geneManager
    if (!vc || typeof vc.resolveAnnotEvidenceRowToGeneSelectPayload !== 'function') {
      alert('Gene visualization is not available on this page.')
      return
    }
    if (!gm || typeof gm.selectGene !== 'function') {
      alert('Gene manager is not available.')
      return
    }
    var row = { gene_id: geneId, gene: geneSymbol }
    var payload = vc.resolveAnnotEvidenceRowToGeneSelectPayload(row)
    if (!payload) {
      alert('Could not resolve this gene in the project index.')
      return
    }
    gm.selectGene(payload)
  }

  window.addAnnotEvidenceGenesToVisualizationBulk = function() {
    var apd = window.annotEvidenceEnsureSelectionStore()
    if (!apd || !apd.evidencesSelectedOrder || apd.evidencesSelectedOrder.length === 0) {
      alert('Select genes for Plot in the Identify markers tab first.')
      return
    }
    var vc = window.visualizationController
    var gm = window.geneManager
    if (!vc || typeof vc.resolveAnnotEvidenceRowToGeneSelectPayload !== 'function') {
      alert('Gene visualization is not available on this page.')
      return
    }
    if (!gm || typeof gm.selectGene !== 'function') {
      alert('Gene manager is not available.')
      return
    }
    var failed = []
    apd.evidencesSelectedOrder.forEach(function(key) {
      var r = apd.evidencesSelectedRows[key]
      if (!r) return
      var row = { gene_id: r.gene_id, gene: r.gene }
      var payload = vc.resolveAnnotEvidenceRowToGeneSelectPayload(row)
      if (payload) {
        gm.selectGene(payload)
      } else {
        failed.push((r.gene && String(r.gene).trim()) || (r.gene_id && String(r.gene_id)) || key)
      }
    })
    if (failed.length > 0) {
      var msg = failed.slice(0, 10).join(', ')
      if (failed.length > 10) msg += ', ...'
      alert('Could not resolve some genes in the project index: ' + msg)
    }
  }

  window.annotEvidenceBoxplotSupported = function() {
    var c = window.visualizationController
    return !!(c && typeof c.renderAnnotEvidenceBoxplotPanel === 'function')
  }

  window.populateAnnotViolinMatrixSelect = function() {
    var sel = document.getElementById('annot-violin-matrix-select')
    if (!sel) return
    var apd = window._annotPopupData
    var gm = window.geneManager
    sel.innerHTML = ''
    function addOpt(value, label, annotId) {
      var o = document.createElement('option')
      o.value = value || '/matrix'
      o.textContent = label || value || '/matrix'
      if (annotId) o.setAttribute('data-annot-id', String(annotId))
      sel.appendChild(o)
    }
    var src = document.getElementById('gene-expression-matrix-select')
    if (src && src.options && src.options.length) {
      for (var i = 0; i < src.options.length; i++) {
        var opt = src.options[i]
        var aid = opt.getAttribute('data-annot-id') || ''
        addOpt(opt.value, opt.textContent || opt.value, aid)
      }
    } else {
      var menu = document.getElementById('matrix-selection-menu')
      if (menu) {
        menu.querySelectorAll('div[data-value]').forEach(function(el) {
          addOpt(el.getAttribute('data-value'), el.getAttribute('data-label') || el.getAttribute('data-value'), el.getAttribute('data-annot-id'))
        })
      }
      if (sel.options.length === 0) {
        addOpt('/matrix', '/matrix', '')
      }
    }
    if (gm && typeof gm.syncMatrixSelectionFromUI === 'function') gm.syncMatrixSelectionFromUI()
    var wantLayer = (apd && apd.violinMatrixLayer != null && apd.violinMatrixLayer !== '') ? apd.violinMatrixLayer : (gm ? gm.currentMatrixLayer : '/matrix')
    var wantAnnot = ''
    if (apd && apd.violinMatrixAnnotId != null && String(apd.violinMatrixAnnotId) !== '') {
      wantAnnot = String(apd.violinMatrixAnnotId)
    } else if (gm && gm.currentMatrixAnnotId) {
      wantAnnot = String(gm.currentMatrixAnnotId)
    }
    var matched = false
    for (var j = 0; j < sel.options.length; j++) {
      var o = sel.options[j]
      var oa = o.getAttribute('data-annot-id') ? String(o.getAttribute('data-annot-id')) : ''
      if (String(o.value) === String(wantLayer) && oa === wantAnnot) {
        sel.selectedIndex = j
        matched = true
        break
      }
    }
    if (!matched && sel.options.length) sel.selectedIndex = 0
    var cur = sel.options[sel.selectedIndex]
    if (cur && apd) {
      apd.violinMatrixLayer = cur.value
      apd.violinMatrixAnnotId = cur.getAttribute('data-annot-id') && cur.getAttribute('data-annot-id') !== '' ? cur.getAttribute('data-annot-id') : null
    }
    if (typeof window.populateAnnotViolinSortSelect === 'function') {
      window.populateAnnotViolinSortSelect()
    }
  }

  window.populateAnnotViolinSortSelect = function() {
    var sel = document.getElementById('annot-violin-sort-by')
    if (!sel || !window._annotPopupData) return
    var v = window._annotPopupData.violinSortBy
    if (v !== 'mean' && v !== 'max') v = 'median'
    sel.value = v
  }

  window.onAnnotViolinMatrixSelectChange = function() {
    var apd = window._annotPopupData
    var s = document.getElementById('annot-violin-matrix-select')
    if (!apd || !s || !s.options.length) return
    var opt = s.options[s.selectedIndex]
    apd.violinMatrixLayer = opt.value
    apd.violinMatrixAnnotId = opt.getAttribute('data-annot-id') && opt.getAttribute('data-annot-id') !== '' ? opt.getAttribute('data-annot-id') : null
    if (typeof window.scheduleAnnotEvidenceBoxplotRender === 'function') window.scheduleAnnotEvidenceBoxplotRender()
  }

  window.onAnnotViolinLayoutRadioChange = function() {
    var apd = window._annotPopupData
    var el = document.querySelector('input[name="annot-violin-layout"]:checked')
    if (!apd || !el) return
    apd.violinLayoutMode = el.value === 'combined' ? 'combined' : 'separate'
    if (typeof window.scheduleAnnotEvidenceBoxplotRender === 'function') window.scheduleAnnotEvidenceBoxplotRender()
  }

  window.onAnnotViolinSortChange = function() {
    var apd = window._annotPopupData
    var s = document.getElementById('annot-violin-sort-by')
    if (!apd || !s) return
    var v = s.value
    apd.violinSortBy = (v === 'mean' || v === 'max') ? v : 'median'
    if (typeof window.scheduleAnnotEvidenceBoxplotRender === 'function') window.scheduleAnnotEvidenceBoxplotRender()
  }

  window._annotPopupUpdateBoxplotTabLabel = function() {
    var btn = document.querySelector('[data-annot-tab="evidence_boxplot"]')
    if (!btn) return
    var n = window.annotEvidenceSelectedCount()
    btn.textContent = 'Violin (' + n + ' selected)'
  }

  function initAnnotationPopupGeneUi() {
    var panel = document.getElementById('annot-popup-panel')
    var popupOverlay = document.getElementById('annotation-popup-overlay')
    var geneOverlay = document.getElementById('annotation-popup-gene-modal-overlay')
    if (!panel || !popupOverlay || !geneOverlay) return
    var searchUrl = popupOverlay.getAttribute('data-search-gene-url')
    panel.addEventListener('click', function(e) {
      var badge = e.target.closest('.annot-popup-gene-badge')
      if (!badge || !panel.contains(badge)) return
      var ens = badge.getAttribute('data-ensembl-id')
      var sym = badge.getAttribute('data-gene-symbol')
      var rid = badge.getAttribute('data-remote-gene-id')
      if (searchUrl) {
        window.openAnnotationPopupGeneModal(ens || '', searchUrl, sym || '', rid || '')
      }
    })
    geneOverlay.addEventListener('click', function(e) {
      if (e.target === geneOverlay) window.closeAnnotationPopupGeneModal()
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAnnotationPopupGeneUi)
  } else {
    initAnnotationPopupGeneUi()
  }

  ;(function setupAnnotDialogResizeViolinRedraw() {
    var ptr = { active: false, w: 0, h: 0 }
    function overlayVisible() {
      var ov = document.getElementById('annotation-popup-overlay')
      if (!ov) return false
      return window.getComputedStyle(ov).display !== 'none'
    }
    document.addEventListener('mousedown', function(e) {
      var d = document.getElementById('annotation-popup-dialog')
      if (!d || !overlayVisible()) return
      if (!d.contains(e.target)) return
      ptr.active = true
      var r = d.getBoundingClientRect()
      ptr.w = r.width
      ptr.h = r.height
    }, true)
    document.addEventListener('mouseup', function() {
      if (!ptr.active) return
      ptr.active = false
      var d = document.getElementById('annotation-popup-dialog')
      if (!d || !overlayVisible()) return
      var apd = window._annotPopupData
      if (!apd || apd.activeTab !== 'evidence_boxplot') return
      var r = d.getBoundingClientRect()
      if (Math.abs(r.width - ptr.w) < 1 && Math.abs(r.height - ptr.h) < 1) return
      if (typeof window.scheduleAnnotEvidenceViolinResizeRedraw === 'function') {
        window.scheduleAnnotEvidenceViolinResizeRedraw()
      }
    })
  })()
})()
</script>
