<!-- Annotation Popup Overlay -->
<div id="annotation-popup-overlay" data-annotable="<%= annotable?(@project) %>" data-current-project-id="<%= @project.id %>" data-search-gene-url="<%= search_gene_project_path(@project) %>" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: rgba(0,0,0,0.15); z-index: 10000; align-items: center; justify-content: center;" onclick="if(event.target === this) closeAnnotationPopup()">
  <div id="annotation-popup-dialog" style="width: 560px; max-width: 90vw; height: 500px; max-height: 80vh; background-color: white; border-radius: 12px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); display: flex; flex-direction: column; overflow: hidden;">
    <div id="annotation-popup-header" style="display: flex; align-items: center; justify-content: space-between; padding: 12px 20px; border-bottom: 1px solid #e5e7eb; background-color: #f9fafb; cursor: grab; user-select: none; border-radius: 12px 12px 0 0;">
      <div id="annot-popup-title" style="font-size: 15px; font-weight: 600; color: #111827; display: flex; align-items: center; flex-wrap: wrap; gap: 8px; min-width: 0;">Annotations</div>
      <button onclick="closeAnnotationPopup()" style="background: none; border: none; cursor: pointer; color: #6b7280; padding: 4px; border-radius: 4px; transition: color 0.2s;" onmouseover="this.style.color='#111827'" onmouseout="this.style.color='#6b7280'">
        <i class="fas fa-times" style="font-size: 18px;"></i>
      </button>
    </div>
    <div id="annot-popup-panel" style="flex: 1; display: flex; flex-direction: column; overflow: hidden;"></div>
  </div>
</div>

<template id="annot-new-tab-template">
  <div style="border: 1px solid #e5e7eb; border-radius: 8px; padding: 10px; background: #fff;">
    <div style="font-size: 13px; font-weight: 600; color: #111827; margin-bottom: 8px;">New annotation</div>
    <div style="display: grid; grid-template-columns: 1fr; gap: 8px;">
      <div>
        <label style="display:block;font-size:12px;color:#374151;margin-bottom:4px;">Annotation type</label>
        <select id="annot-new-annotation-type" style="width:100%;padding: 6px 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px;background:#fff;">__ANNOTATION_TYPE_OPTIONS__</select>
      </div>
      <input type="text" id="annot-new-name-input" placeholder="Name of the annotation" value="__NAME__" style="padding: 6px 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px; background:#fff;" />
      <div style="position:relative;">
        <input type="text" id="annot-new-ontology-input" placeholder="Cell ontology term" style="width:100%;padding: 6px 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px; background:#fff;" />
        <div id="annot-new-ontology-suggestions" style="display:none;position:absolute;top:100%;left:0;right:0;background:#fff;border:1px solid #d1d5db;border-top:none;max-height:160px;overflow-y:auto;z-index:1001;"></div>
      </div>
      <div style="min-height:22px;">__ONTOLOGY_BADGES__</div>
      <div style="position:relative;">
        <input type="text" id="annot-new-up-input" placeholder="Up-regulated gene" style="width:100%;padding: 6px 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px; background:#fff;" />
        <div id="annot-new-up-suggestions" style="display:none;position:absolute;top:100%;left:0;right:0;background:#fff;border:1px solid #d1d5db;border-top:none;max-height:160px;overflow-y:auto;z-index:1001;"></div>
      </div>
      <div style="min-height:22px;">__UP_BADGES__</div>
      <div style="position:relative;">
        <input type="text" id="annot-new-down-input" placeholder="Down-regulated gene" style="width:100%;padding: 6px 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px; background:#fff;" />
        <div id="annot-new-down-suggestions" style="display:none;position:absolute;top:100%;left:0;right:0;background:#fff;border:1px solid #d1d5db;border-top:none;max-height:160px;overflow-y:auto;z-index:1001;"></div>
      </div>
      <div style="min-height:22px;">__DOWN_BADGES__</div>
    </div>
    <textarea id="annot-new-comment-input" placeholder="Comment" style="margin-top: 8px; width: 100%; min-height: 64px; padding: 6px 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px; background:#fff;">__COMMENT__</textarea>
    <!--<div style="margin-top: 8px; font-size: 11px; color: #6b7280;">Use this form as guidance with evidences in the dedicated tab.</div>
    <div style="margin-top: 8px; font-size: 11px; color: #6b7280;">Autocomplete uses the same gene index and ontology search as the original annotation workflow.</div>-->
    <div style="display:flex;flex-direction:column;align-items:flex-start;gap:8px;margin-top:10px;">
      __SUBMIT_SECTION__
    </div>
    __STATUS__
  </div>
</template>

<template id="annot-existing-tab-template">
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
    <div style="font-size: 13px; font-weight: 600; color: #111827;">Existing annotations</div>
    <div style="font-size: 12px; color: #6b7280;">__TOTAL__ total</div>
  </div>
  <p style="font-size: 11px; color: #6b7280; margin: 0 0 10px 0; line-height: 1.45;">One list for this cell set, best net votes first. Each row header shows from which project, metadata, and category. Local annotations use a green this project label. Hover the project pill for the full title.</p>
  __CONTENT__
</template>

<template id="annot-evidences-tab-template">
  <div style="font-size: 13px; font-weight: 600; color: #111827; margin-bottom: 8px;">Identify markers</div>
  __CONTENT__
</template>

<div id="annotation-popup-gene-modal-overlay" class="hidden fixed inset-0 flex items-center justify-center" style="background-color: rgba(0,0,0,0.5); z-index: 10050;">
  <div class="bg-white rounded-lg shadow-xl max-w-3xl w-full mx-4 overflow-hidden" style="max-height: 80vh;">
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200" style="background: linear-gradient(to right, #f0fdf4, #ecfdf5);">
      <h3 class="text-lg font-semibold text-gray-900" id="annotation-popup-gene-modal-title">Gene details</h3>
      <button type="button" onclick="closeAnnotationPopupGeneModal()" class="text-gray-400 hover:text-gray-600 text-xl font-bold cursor-pointer">&times;</button>
    </div>
    <div class="px-6 py-5 overflow-auto" style="max-height: calc(80vh - 60px);" id="annotation-popup-gene-modal-body">
      <div class="text-gray-500 text-sm">Loading...</div>
    </div>
  </div>
</div>

<script>
(function() {
  function escAttr(s) {
    return String(s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;')
  }

  window.claGeneBadgesRowHtml = function(genes, kind) {
    if (!genes || genes.length === 0) return ''
    var isUp = kind === 'up'
    var label = isUp ? 'Up genes: ' : 'Down genes: '
    var highlightCls = isUp ? 'bg-green-100 text-green-800 hover:bg-green-200' : 'bg-red-100 text-red-800 hover:bg-red-200'
    var html = ''
    html += '<div style="margin-bottom: 6px;">'
    html += '<span style="font-size: 12px; color: #6b7280; font-weight: 500;">' + escAttr(label) + '</span>'
    html += '<div class="flex flex-wrap gap-1 mt-1">'
    genes.forEach(function(g) {
      var sym = escAttr(String(g.symbol != null ? g.symbol : (g.gene_id || '-')))
      var ens = g.ensembl_id != null ? String(g.ensembl_id).trim() : ''
      var cls = ens ? highlightCls : 'bg-gray-100 text-gray-500 hover:bg-gray-200'
      var curs = ens ? 'cursor-pointer' : 'cursor-default'
      html += '<span class="annot-popup-gene-badge gene-badge ' + cls + ' ' + curs + ' inline-flex items-center px-2 py-0.5 rounded text-xs font-medium"'
      if (ens) html += ' data-ensembl-id="' + escAttr(ens) + '"'
      html += ' title="' + escAttr(ens || sym) + '">' + sym + '</span>'
    })
    html += '</div></div>'
    return html
  }

  window.openAnnotationPopupGeneModal = function(ensemblId, searchUrl) {
    var overlay = document.getElementById('annotation-popup-gene-modal-overlay')
    var body = document.getElementById('annotation-popup-gene-modal-body')
    var title = document.getElementById('annotation-popup-gene-modal-title')
    if (!overlay || !body || !title) return
    title.textContent = ensemblId
    body.innerHTML = '<div class="text-gray-500 text-sm">Loading...</div>'
    overlay.classList.remove('hidden')
    var csrfMeta = document.querySelector('meta[name="csrf-token"]')
    var csrfToken = csrfMeta ? csrfMeta.getAttribute('content') : ''
    var url = searchUrl + (searchUrl.indexOf('?') >= 0 ? '&' : '?') + 'ensembl_id=' + encodeURIComponent(ensemblId)
    fetch(url, { headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'text/html' }, credentials: 'same-origin' })
      .then(function(r) { return r.text() })
      .then(function(html) { body.innerHTML = html })
      .catch(function() { body.innerHTML = '<div class="text-red-600 text-sm">Failed to load gene details.</div>' })
  }

  window.closeAnnotationPopupGeneModal = function() {
    var overlay = document.getElementById('annotation-popup-gene-modal-overlay')
    if (overlay) overlay.classList.add('hidden')
  }

  function initAnnotationPopupGeneUi() {
    var panel = document.getElementById('annot-popup-panel')
    var popupOverlay = document.getElementById('annotation-popup-overlay')
    var geneOverlay = document.getElementById('annotation-popup-gene-modal-overlay')
    if (!panel || !popupOverlay || !geneOverlay) return
    var searchUrl = popupOverlay.getAttribute('data-search-gene-url')
    panel.addEventListener('click', function(e) {
      var badge = e.target.closest('.annot-popup-gene-badge')
      if (!badge || !panel.contains(badge)) return
      var ens = badge.getAttribute('data-ensembl-id')
      if (ens && searchUrl) window.openAnnotationPopupGeneModal(ens, searchUrl)
    })
    geneOverlay.addEventListener('click', function(e) {
      if (e.target === geneOverlay) window.closeAnnotationPopupGeneModal()
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAnnotationPopupGeneUi)
  } else {
    initAnnotationPopupGeneUi()
  }
})()
</script>
