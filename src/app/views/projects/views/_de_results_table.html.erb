<% completed_runs = @runs&.select { |r| r.status_id == 3 } || [] %>
<% if completed_runs.any? %>

<div data-de-filter-target="tableRoot" class="overflow-x-auto">
  <table class="min-w-full divide-y divide-gray-200 text-sm">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase whitespace-nowrap cursor-pointer hover:text-gray-700 select-none" data-action="click->de-filter#sort" data-col="0" data-numeric="true"># <span class="sort-indicator"></span></th>
        <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase whitespace-nowrap cursor-pointer hover:text-gray-700 select-none" data-action="click->de-filter#sort" data-col="1" data-numeric="false">Method <span class="sort-indicator"></span></th>
        <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">Parameters</th>
        <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase whitespace-nowrap cursor-pointer hover:text-gray-700 select-none" data-action="click->de-filter#sort" data-col="3" data-numeric="true">Up-regulated <span class="sort-indicator"></span></th>
        <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase whitespace-nowrap cursor-pointer hover:text-gray-700 select-none" data-action="click->de-filter#sort" data-col="4" data-numeric="true">Down-regulated <span class="sort-indicator"></span></th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% completed_runs.each do |run| %>
        <% run_id = run.id.to_s %>
        <% std_method = @h_std_methods && run.std_method_id ? @h_std_methods[run.std_method_id] : nil %>
        <% method_label = std_method ? (std_method.label.presence || std_method.name.presence || 'N/A') : 'N/A' %>
        <% h_attrs = run.attrs_json.present? ? Basic.safe_parse_json(run.attrs_json, {}) : {} %>
        <% up_count = (@h_stats && @h_stats[run_id]) ? @h_stats[run_id]['up'].to_i : -1 %>
        <% down_count = (@h_stats && @h_stats[run_id]) ? @h_stats[run_id]['down'].to_i : -1 %>
        <% up_display_count = up_count >= 0 ? up_count : 0 %>
        <% down_display_count = down_count >= 0 ? down_count : 0 %>
        <tr class="hover:bg-gray-50" data-de-run-id="<%= run.id %>">
          <td class="px-3 py-2 text-gray-900 font-semibold" data-sort-value="<%= run.num || run.id %>">#<%= run.num || run.id %></td>
          <td class="px-3 py-2 text-gray-900" data-sort-value="<%= method_label.downcase %>"><%= method_label %></td>
          <td class="px-3 py-2 text-gray-600 text-xs">
            <% h_method_attrs = (std_method && @step) ? (Basic.get_std_method_attrs(std_method, @step)[:h_attrs] rescue Basic.safe_parse_json(std_method.attrs_json, {})) : {} %>
            <% h_attrs.each do |k, v| %>
              <% if v.is_a?(Hash) %>
                <% annot_id = v['annot_id'] || v[:annot_id] %>
                <% run_id_ref = v['run_id'] || v[:run_id] %>
                <% display_label = k.to_s %>
                <% is_im = k.to_s.start_with?('input_matrix') %>
                <% dbg = is_im ? 'bg-blue-100 text-blue-700 border-blue-200 hover:bg-blue-200' : 'bg-purple-100 text-purple-700 border-purple-200 hover:bg-purple-200' %>
                <% dlc = is_im ? 'text-blue-800' : 'text-purple-800' %>
                <% dvc = is_im ? 'text-blue-600' : 'text-purple-600' %>
                <% if annot_id.present? %>
                  <% annot = Annot.find_by(id: annot_id) %>
                  <% if annot %>
                    <% ori_run = annot.ori_run_id.present? ? Run.find_by(id: annot.ori_run_id) : nil %>
                    <% ori_step = ori_run&.step_id.present? ? Step.find_by(id: ori_run.step_id) : nil %>
                    <% step_name = ori_step ? (ori_step.label.presence || ori_step.name.presence || 'N/A') : nil %>
                    <% if ori_step && ori_step.multiple_runs && ori_run %>
                      <% tooltip_h = "#{step_name} ##{ori_run.num || ori_run.id} #{annot.name}" %>
                    <% elsif step_name %>
                      <% tooltip_h = "#{step_name} #{annot.name}" %>
                    <% else %>
                      <% tooltip_h = annot.name %>
                    <% end %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border cursor-pointer transition-colors mr-1 mb-1 <%= dbg %>"
                          data-controller="pipeline-runs"
                          data-pipeline-runs-annot-id-value="<%= annot_id %>"
                          data-pipeline-runs-project-id-value="<%= @project.id %>"
                          data-pipeline-runs-url-value="<%= pipeline_runs_project_path(@project) %>"
                          data-action="click->pipeline-runs#showPipeline"
                          title="<%= tooltip_h %>">
                      <span class="font-semibold <%= dlc %>"><%= display_label %>:</span>
                      <span class="<%= dvc %>"><%= clean_metadata_path(annot.name) %></span>
                    </span>
                  <% end %>
                <% elsif run_id_ref.present? %>
                  <% ref_run = Run.find_by(id: run_id_ref) %>
                  <% if ref_run %>
                    <% ref_step = ref_run.step_id.present? ? Step.find_by(id: ref_run.step_id) : nil %>
                    <% step_name = ref_step ? (ref_step.label.presence || ref_step.name.presence || 'N/A') : 'N/A' %>
                    <% dataset_name = v['output_dataset'] || v[:output_dataset] || '' %>
                    <% if ref_step && ref_step.multiple_runs %>
                      <% tooltip_h = "#{step_name} ##{ref_run.num || ref_run.id} #{dataset_name}".strip %>
                    <% else %>
                      <% tooltip_h = "#{step_name} #{dataset_name}".strip %>
                    <% end %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border cursor-pointer transition-colors mr-1 mb-1 <%= dbg %>"
                          data-controller="pipeline-runs"
                          data-pipeline-runs-run-id-value="<%= run_id_ref %>"
                          data-pipeline-runs-project-id-value="<%= @project.id %>"
                          data-pipeline-runs-url-value="<%= pipeline_runs_project_path(@project) %>"
                          data-action="click->pipeline-runs#showPipeline"
                          title="<%= tooltip_h %>">
                      <span class="font-semibold <%= dlc %>"><%= display_label %>:</span>
                      <span class="<%= dvc %>"><%= clean_metadata_path(dataset_name) %></span>
                    </span>
                  <% end %>
                <% end %>
                <% next %>
              <% end %>
              <% if v.is_a?(Array) && v.any? && v.first.is_a?(Hash) %>
                <% first_item = v.first %>
                <% arr_annot_id = first_item['annot_id'] || first_item[:annot_id] %>
                <% arr_run_id = first_item['run_id'] || first_item[:run_id] %>
                <% arr_label = k.to_s %>
                <% is_im_a = k.to_s.start_with?('input_matrix') %>
                <% abg = is_im_a ? 'bg-blue-100 text-blue-700 border-blue-200 hover:bg-blue-200' : 'bg-purple-100 text-purple-700 border-purple-200 hover:bg-purple-200' %>
                <% alc = is_im_a ? 'text-blue-800' : 'text-purple-800' %>
                <% avc = is_im_a ? 'text-blue-600' : 'text-purple-600' %>
                <% arr_annot = arr_annot_id.present? ? Annot.find_by(id: arr_annot_id) : nil %>
                <% if arr_annot %>
                  <% arr_ori_run = arr_annot.ori_run_id.present? ? Run.find_by(id: arr_annot.ori_run_id) : nil %>
                  <% arr_ori_step = arr_ori_run&.step_id.present? ? Step.find_by(id: arr_ori_run.step_id) : nil %>
                  <% arr_step_name = arr_ori_step ? (arr_ori_step.label.presence || arr_ori_step.name.presence || 'N/A') : nil %>
                  <% if arr_ori_step && arr_ori_step.multiple_runs && arr_ori_run %>
                    <% arr_tooltip = "#{arr_step_name} ##{arr_ori_run.num || arr_ori_run.id} #{arr_annot.name}" %>
                  <% elsif arr_step_name %>
                    <% arr_tooltip = "#{arr_step_name} #{arr_annot.name}" %>
                  <% else %>
                    <% arr_tooltip = arr_annot.name %>
                  <% end %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border cursor-pointer transition-colors mr-1 mb-1 <%= abg %>"
                        data-controller="pipeline-runs"
                        data-pipeline-runs-annot-id-value="<%= arr_annot_id %>"
                        data-pipeline-runs-project-id-value="<%= @project.id %>"
                        data-pipeline-runs-url-value="<%= pipeline_runs_project_path(@project) %>"
                        data-action="click->pipeline-runs#showPipeline"
                        title="<%= arr_tooltip %>">
                    <span class="font-semibold <%= alc %>"><%= arr_label %>:</span>
                    <span class="<%= avc %>"><%= clean_metadata_path(arr_annot.name) %></span>
                  </span>
                <% elsif arr_run_id.present? %>
                  <% arr_ref_run = Run.find_by(id: arr_run_id) %>
                  <% if arr_ref_run %>
                    <% arr_ref_step = arr_ref_run.step_id.present? ? Step.find_by(id: arr_ref_run.step_id) : nil %>
                    <% arr_step_name = arr_ref_step ? (arr_ref_step.label.presence || arr_ref_step.name.presence || 'N/A') : 'N/A' %>
                    <% arr_dataset = first_item['output_dataset'] || first_item[:output_dataset] || '' %>
                    <% if arr_ref_step && arr_ref_step.multiple_runs %>
                      <% arr_tooltip = "#{arr_step_name} ##{arr_ref_run.num || arr_ref_run.id} #{arr_dataset}".strip %>
                    <% else %>
                      <% arr_tooltip = "#{arr_step_name} #{arr_dataset}".strip %>
                    <% end %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border cursor-pointer transition-colors mr-1 mb-1 <%= abg %>"
                          data-controller="pipeline-runs"
                          data-pipeline-runs-run-id-value="<%= arr_run_id %>"
                          data-pipeline-runs-project-id-value="<%= @project.id %>"
                          data-pipeline-runs-url-value="<%= pipeline_runs_project_path(@project) %>"
                          data-action="click->pipeline-runs#showPipeline"
                          title="<%= arr_tooltip %>">
                      <span class="font-semibold <%= alc %>"><%= arr_label %>:</span>
                      <span class="<%= avc %>"><%= clean_metadata_path(arr_dataset) %></span>
                    </span>
                  <% end %>
                <% end %>
                <% next %>
              <% end %>
              <% next if v.is_a?(Array) %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 mr-1 mb-1 cursor-help" title="<%= param_tooltip(k, h_method_attrs) %>">
                <span class="font-semibold"><%= k %>:</span><span><%= v.to_s.truncate(30) %></span>
              </span>
            <% end %>
          </td>
          <td class="px-3 py-2" data-sort-value="<%= up_count %>">
            <span id="de-up-badge-<%= run.id %>"
                  class="cursor-pointer inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= up_display_count > 0 ? 'bg-green-100 text-green-800 hover:bg-green-200' : 'bg-gray-100 text-gray-500' %>"
                  onclick="loadFormInRightPanel('<%= get_de_gene_list_run_path(run) %>?type=up')">
              <%= up_display_count %> genes
            </span>
          </td>
          <td class="px-3 py-2" data-sort-value="<%= down_count %>">
            <span id="de-down-badge-<%= run.id %>"
                  class="cursor-pointer inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= down_display_count > 0 ? 'bg-red-100 text-red-800 hover:bg-red-200' : 'bg-gray-100 text-gray-500' %>"
                  onclick="loadFormInRightPanel('<%= get_de_gene_list_run_path(run) %>?type=down')">
              <%= down_display_count %> genes
            </span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="flex items-center justify-between px-3 py-3 border-t border-gray-200 bg-gray-50 text-sm">
    <div class="flex items-center gap-2 text-gray-600">
      <span>Rows per page:</span>
      <select data-de-filter-target="pageSize" data-action="change->de-filter#changePage" class="border border-gray-300 rounded px-2 py-1 text-sm bg-white cursor-pointer">
        <option value="20">20</option>
        <option value="50">50</option>
        <option value="100">100</option>
        <option value="0">All</option>
      </select>
      <span data-de-filter-target="pageInfo" class="ml-2"></span>
    </div>
    <div class="flex items-center gap-1">
      <button data-action="click->de-filter#prevPage" data-de-filter-target="prevBtn" class="px-3 py-1 rounded border border-gray-300 bg-white text-gray-700 hover:bg-gray-100 disabled:opacity-40 disabled:cursor-default cursor-pointer">Prev</button>
      <span data-de-filter-target="pageNumbersContainer" class="flex items-center gap-1"></span>
      <button data-action="click->de-filter#nextPage" data-de-filter-target="nextBtn" class="px-3 py-1 rounded border border-gray-300 bg-white text-gray-700 hover:bg-gray-100 disabled:opacity-40 disabled:cursor-default cursor-pointer">Next</button>
    </div>
  </div>
</div>

<% else %>
<div class="text-gray-500 text-center py-4">No completed DE runs found.</div>
<% end %>

<% failed_runs = @runs&.select { |r| r.status_id == 4 } || [] %>
<% if failed_runs.any? %>
  <div class="mt-6">
    <div class="text-sm font-semibold text-gray-800 mb-2">Failed DE runs</div>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase whitespace-nowrap">#</th>
            <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase whitespace-nowrap">Method</th>
            <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">Parameters</th>
            <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase whitespace-nowrap">Status</th>
            <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase whitespace-nowrap">Run view</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% failed_runs.each do |run| %>
            <% std_method = @h_std_methods && run.std_method_id ? @h_std_methods[run.std_method_id] : nil %>
            <% method_label = std_method ? (std_method.label.presence || std_method.name.presence || 'N/A') : 'N/A' %>
            <% h_attrs = run.attrs_json.present? ? Basic.safe_parse_json(run.attrs_json, {}) : {} %>
            <tr class="hover:bg-gray-50">
              <td class="px-3 py-2 text-gray-900 font-semibold">#<%= run.num || run.id %></td>
              <td class="px-3 py-2 text-gray-900"><%= method_label %></td>
              <td class="px-3 py-2 text-gray-600 text-xs">
                <% h_attrs.each do |k, v| %>
                  <% next if v.is_a?(Array) || v.is_a?(Hash) %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 mr-1 mb-1">
                    <span class="font-semibold"><%= k %>:</span><span><%= v.to_s.truncate(30) %></span>
                  </span>
                <% end %>
              </td>
              <td class="px-3 py-2">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">Failed</span>
              </td>
              <td class="px-3 py-2">
                <button type="button"
                        class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 border border-gray-300 hover:bg-gray-200 cursor-pointer"
                        onclick="if (typeof loadRunInRightPanel === 'function') { loadRunInRightPanel('<%= run_path(run) %>', '<%= @step.id %>'); } else { window.location.href = '<%= run_path(run) %>'; }">
                  Open run view
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
