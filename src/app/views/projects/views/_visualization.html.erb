  co_id_to_tag = all_co_ids.any? ? CellOntology.where(id: all_co_ids).pluck(:id, :tag).to_h : {}
  otts.map do |ott|
    prefixes = ott.ontology_prefixes(co_id_to_tag)
    obs_field = Scfair::Rules.obs_field_name_from_path(ott.term_path)
