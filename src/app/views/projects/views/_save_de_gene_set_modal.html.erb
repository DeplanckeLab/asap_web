<template id="save-de-gene-set-modal-template">
  <div id="de-gene-set-modal-overlay" style="position:fixed;top:0;left:0;right:0;bottom:0;background-color:rgba(0,0,0,0.5);z-index:12200;display:flex;align-items:center;justify-content:center;padding:20px;">
    <div id="de-gene-set-modal-content" style="background:white;border-radius:8px;padding:24px;max-width:520px;width:100%;box-shadow:0 20px 25px -5px rgba(0,0,0,0.1);position:relative;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
        <h3 style="margin:0;font-size:18px;font-weight:600;color:#111827;">Export DE gene set</h3>
        <button type="button" id="close-de-gene-set-modal" style="background:none;border:none;font-size:24px;color:#6b7280;cursor:pointer;padding:0;width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:4px;"
                onmouseover="this.style.backgroundColor='#f3f4f6'; this.style.color='#374151'"
                onmouseout="this.style.backgroundColor=''; this.style.color='#6b7280'">x</button>
      </div>

      <form id="save-de-gene-set-form" style="display:flex;flex-direction:column;gap:16px;">
        <div>
          <label style="display:block;font-size:14px;font-weight:500;color:#374151;margin-bottom:8px;">
            Gene set name <span style="color:#dc2626;">*</span>
          </label>
          <input
            type="text"
            id="de-gene-set-name-input"
            required
            placeholder="Enter gene set name..."
            style="width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;outline:none;box-sizing:border-box;"
          />
        </div>

        <div>
          <label style="display:block;font-size:14px;font-weight:500;color:#374151;margin-bottom:8px;">
            Gene set collection <span style="color:#dc2626;">*</span>
          </label>
          <select id="de-gene-set-collection-select"
                  style="width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;outline:none;background:#fff;box-sizing:border-box;">
            <% de_options = Array(@de_gene_set_collection_options) %>
            <% de_options.each do |option| %>
              <option value="<%= option[:id] %>"><%= option[:label] %></option>
            <% end %>
            <option value="<%= ProjectsController::DE_GENE_SET_COLLECTION_NEW_ID %>">Create new collection...</option>
          </select>
          <div id="de-gene-set-new-collection-wrap" style="display:none;margin-top:10px;">
            <label style="display:block;font-size:13px;font-weight:500;color:#374151;margin-bottom:6px;">
              New collection name <span style="color:#dc2626;">*</span>
            </label>
            <input
              type="text"
              id="de-gene-set-new-collection-input"
              placeholder="<%= ProjectsController::DE_GENE_SET_COLLECTION_LABEL %>"
              value="<%= ProjectsController::DE_GENE_SET_COLLECTION_LABEL %>"
              style="width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;outline:none;box-sizing:border-box;"
            />
          </div>
          <div style="margin-top:6px;font-size:12px;color:#6b7280;">
            Collections of type &quot;From DE results&quot; only.
          </div>
        </div>

        <div style="display:flex;justify-content:flex-end;gap:12px;margin-top:8px;">
          <button
            type="button"
            id="cancel-de-gene-set-btn"
            style="padding:10px 20px;background-color:#e5e7eb;color:#374151;border:none;border-radius:6px;font-size:14px;font-weight:500;cursor:pointer;">
            Cancel
          </button>
          <button
            type="submit"
            id="submit-de-gene-set-btn"
            style="padding:10px 20px;background-color:#3b82f6;color:white;border:none;border-radius:6px;font-size:14px;font-weight:500;cursor:pointer;">
            Save
          </button>
        </div>
      </form>
    </div>
  </div>
</template>
