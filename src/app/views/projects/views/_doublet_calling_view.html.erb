<% run_for_view = @run || @current_run || (@runs.respond_to?(:first) ? @runs.first : nil) %>
<% run_status_id = run_for_view&.status_id.to_i if run_for_view %>
<% h_res = @h_res.is_a?(Hash) ? @h_res : {} %>
<% score_block = h_res["doublet_score"].is_a?(Hash) ? h_res["doublet_score"] : {} %>
<% call_block = h_res["doublet_call"].is_a?(Hash) ? h_res["doublet_call"] : {} %>
<% initial_doublets = call_block["n_doublets_called"].presence || score_block["n_doublets_called"] %>
<% initial_singlets = call_block["n_singlets_called"].presence || score_block["n_singlets_called"] %>
<% initial_rate = call_block["doublet_rate"].presence || score_block["doublet_rate"] %>
<% initial_threshold = call_block["threshold_used"] %>
<% histogram = @doublet_score_histogram.is_a?(Hash) ? @doublet_score_histogram : {} %>
<% doublet_scores = @doublet_scores.is_a?(Array) ? @doublet_scores : [] %>
<% can_filter = step_result_refinement_allowed?(@project, run_for_view) && run_status_id == 3 && @doublet_loom_path.present? %>
<% initial_method = call_block["method"].presence || "auto" %>
<% params_block = h_res["parameters"].is_a?(Hash) ? h_res["parameters"] : {} %>
<% form_param_context = {
     h_annots: @h_annots_for_params || {},
     h_runs: @h_ori_runs_for_params || {},
     h_steps: @h_steps_for_params || {}
   } %>

<div class="bg-white rounded-lg shadow-sm flex flex-col" id="result_summary" style="max-height: calc(100vh - 200px); overflow-y: auto; overflow-x: hidden; width: 100%;">
  <div class="border-b border-gray-200 px-6 py-4 sticky top-0 z-10 flex-shrink-0" style="background: linear-gradient(to right, #eff6ff, #eef2ff); background-color: #ffffff;">
    <div class="flex items-center justify-between min-w-0">
      <div class="flex items-center gap-3 min-w-0 flex-1">
        <h3 class="text-lg font-semibold text-gray-900 min-w-0 truncate">
          <%= @step.label.presence || @step.name %> results
        </h3>
        <% if run_for_view && run_for_view.status_id %>
          <% status_name = run_for_view.status&.name&.humanize || "Unknown" %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= case run_for_view.status_id
                                                                                                      when 1 then "bg-yellow-100 text-yellow-800"
                                                                                                      when 2 then "bg-blue-100 text-blue-800"
                                                                                                      when 3 then "bg-green-100 text-green-800"
                                                                                                      when 4 then "bg-red-100 text-red-800"
                                                                                                      else "bg-gray-100 text-gray-800"
                                                                                                      end %>">
            <%= status_name %>
          </span>
        <% end %>
      </div>
      <% reset_allowed = analyzable?(@project) && editable?(@project) && single_run_step_resettable?(@project, @step, project_step: @project_step, runs: run_for_view) %>
      <% if reset_allowed %>
        <button type="button"
                class="px-3 py-1.5 bg-orange-600 hover:bg-orange-700 text-white rounded-md font-medium text-sm transition-colors cursor-pointer"
                data-controller="restart-step"
                data-restart-step-project-id-value="<%= @project.id %>"
                data-restart-step-step-id-value="<%= @step.id %>"
                data-restart-step-restart-url-value="<%= restart_step_project_path(@project, return_to_form: 1) %>"
                data-action="click->restart-step#restart">
          Reset
        </button>
      <% elsif analyzable?(@project) && editable?(@project) && single_run_step_locked_from_publication?(@project, @step, runs: run_for_view) %>
        <button type="button" disabled
                class="px-3 py-1.5 bg-gray-300 text-gray-500 rounded-md font-medium text-sm cursor-not-allowed"
                title="<%= publication_locked_step_message %>">
          Reset
        </button>
      <% end %>
    </div>
  </div>

  <% if run_for_view %>
    <div id="run_metadata_sticky_doublet_calling" class="sticky z-10 flex-shrink-0 bg-white" style="top: 57px;">
      <%= render partial: "projects/views/run_metadata", locals: { run: run_for_view, results: h_res, queue_position: @queue_position, slurm_queue_hover: @slurm_queue_hover } %>
    </div>
  <% end %>

  <div class="px-6 py-5 space-y-6 flex-1 min-w-0 overflow-x-hidden">
    <% if run_for_view && run_status_id == 4 %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-8 text-center">
          <h3 class="text-xl font-semibold text-red-900 mb-2">Doublet calling failed</h3>
          <p class="text-gray-600 mb-4">
            <%= run_for_view.error.presence || "The doublet calling job failed. Please review the logs or restart this step." %>
          </p>
        </div>
      </div>
    <% elsif run_status_id == 3 %>
      <% if @doublet_score_path.present? %>
        <script src="https://cdn.plot.ly/plotly-2.26.0.min.js"></script>
        <div class="doublet-calling-layout-host"
             data-controller="doublet-calling"
             data-doublet-calling-filter-url-value="<%= filter_doublet_results_project_path(@project) %>"
             data-doublet-calling-can-filter-value="<%= can_filter %>"
             data-doublet-calling-scores-value='<%= doublet_scores.to_json %>'
             data-doublet-calling-initial-threshold-value="<%= initial_threshold.to_f if initial_threshold.present? %>"
             data-doublet-calling-initial-method-value="<%= initial_method %>"
             data-doublet-calling-run-id-value="<%= run_for_view.id %>">
          <div class="doublet-calling-layout">
          <div class="doublet-calling-controls-col">
          <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-4 sm:p-6 space-y-4">
            <% if @std_method %>
              <div class="space-y-3">
                <h5 class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Method</h5>
                <div class="text-sm text-gray-900"><%= @std_method.label.presence || @std_method.name %></div>
              </div>
            <% end %>

            <% (@doublet_param_sections || []).each do |section| %>
              <div class="space-y-3">
                <% if section[:header].present? %>
                  <h5 class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= section[:header] %></h5>
                <% end %>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
                  <% section[:keys].each do |attr_name| %>
                    <% value = @h_run_attrs[attr_name] %>
                    <div>
                      <div class="font-medium text-gray-700"><%= form_param_label(attr_name, @doublet_method_attrs || {}) %></div>
                      <div class="text-gray-900 mt-0.5">
                        <%= raw display_form_param_value(run_for_view, attr_name, value, @h_std_method_attrs || {}, form_param_context) %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>

          <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-4 sm:p-6 space-y-4">
            <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">Adjust calling</h4>
            <div class="space-y-3">
              <h5 class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Current calling</h5>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-sm" data-doublet-calling-target="paramsPanel">
                <div>
                  <div class="font-medium text-gray-700">Calling method</div>
                  <div class="text-gray-900 mt-0.5"><%= initial_method %></div>
                </div>
                <% if initial_threshold.present? %>
                  <div>
                    <div class="font-medium text-gray-700">Threshold used</div>
                    <div class="text-gray-900 mt-0.5"><%= sprintf("%.4f", initial_threshold.to_f) %></div>
                  </div>
                <% end %>
                <% if params_block["threshold"].present? %>
                  <div>
                    <div class="font-medium text-gray-700">Threshold</div>
                    <div class="text-gray-900 mt-0.5"><%= params_block["threshold"] %></div>
                  </div>
                <% end %>
                <% if params_block["n_doublets"].present? %>
                  <div>
                    <div class="font-medium text-gray-700">Number of doublets</div>
                    <div class="text-gray-900 mt-0.5"><%= number_with_delimiter(params_block["n_doublets"]) %></div>
                  </div>
                <% end %>
                <% if params_block["doublet_rate"].present? %>
                  <div>
                    <div class="font-medium text-gray-700">Doublet rate</div>
                    <div class="text-gray-900 mt-0.5"><%= "#{(params_block["doublet_rate"].to_f * 100).round(2)}%" %></div>
                  </div>
                <% end %>
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Calling method</label>
              <select data-doublet-calling-target="method"
                      data-action="change->doublet-calling#methodChanged"
                      class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm"
                      <%= "disabled" unless can_filter %>>
                <option value="auto" <%= "selected" if initial_method == "auto" %>>auto (skimage threshold_minimum)</option>
                <option value="valley" <%= "selected" if initial_method == "valley" %>>valley (histogram valley)</option>
                <option value="threshold" <%= "selected" if initial_method == "threshold" %>>threshold (fixed cutoff)</option>
                <option value="top_n" <%= "selected" if initial_method == "top_n" %>>top_n (fixed count)</option>
                <option value="top_pct" <%= "selected" if initial_method == "top_pct" %>>top_pct (fixed fraction)</option>
              </select>
            </div>
            <div data-doublet-calling-target="thresholdField" class="hidden">
              <label class="block text-sm font-medium text-gray-700 mb-1">Threshold</label>
              <input type="number" step="any" min="0" max="1"
                     data-doublet-calling-target="threshold"
                     value="<%= initial_threshold.to_f if initial_method == 'threshold' && initial_threshold.present? %>"
                     class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm"
                     <%= "disabled" unless can_filter %>>
            </div>
            <div data-doublet-calling-target="nDoubletsField" class="hidden">
              <label class="block text-sm font-medium text-gray-700 mb-1">Number of doublets</label>
              <input type="number" step="1" min="0"
                     data-doublet-calling-target="nDoublets"
                     class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm"
                     <%= "disabled" unless can_filter %>>
            </div>
            <div data-doublet-calling-target="doubletRateField" class="hidden">
              <label class="block text-sm font-medium text-gray-700 mb-1">Doublet rate</label>
              <input type="number" step="any" min="0" max="1"
                     data-doublet-calling-target="doubletRate"
                     class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm"
                     <%= "disabled" unless can_filter %>>
            </div>
          </div>
          <% if can_filter %>
            <div class="flex items-center gap-3">
              <button type="button"
                      class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-md text-sm font-medium"
                      data-action="click->doublet-calling#applyFilter">
                Apply calling
              </button>
              <span data-doublet-calling-target="spinner" class="hidden text-sm text-gray-500">Updating...</span>
            </div>
          <% else %>
            <p class="text-sm text-amber-700"><%= single_run_step_locked_from_publication?(@project, @step, runs: run_for_view) ? publication_locked_step_message : 'You need edit rights to re-run dynamic doublet calling on this project.' %></p>
          <% end %>
          <div data-doublet-calling-target="error" class="hidden text-sm text-red-700 bg-red-50 border border-red-200 rounded-md px-3 py-2"></div>
          </div>
          </div>

          <div class="doublet-calling-plots-col bg-white border border-gray-200 rounded-lg shadow-sm p-4 sm:p-6 space-y-6">
          <div>
            <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">Summary</h4>
            <div data-doublet-calling-target="statsPanel" class="flex flex-wrap gap-3">
              <div class="inline-flex items-center gap-2 px-4 py-2 bg-red-50 border border-red-200 rounded-lg">
                <span class="text-sm font-medium text-red-900">Doublets: <span class="font-bold"><%= initial_doublets.present? ? number_with_delimiter(initial_doublets) : "-" %></span></span>
              </div>
              <div class="inline-flex items-center gap-2 px-4 py-2 bg-green-50 border border-green-200 rounded-lg">
                <span class="text-sm font-medium text-green-900">Singlets: <span class="font-bold"><%= initial_singlets.present? ? number_with_delimiter(initial_singlets) : "-" %></span></span>
              </div>
              <div class="inline-flex items-center gap-2 px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg">
                <span class="text-sm font-medium text-gray-900">Doublet rate: <span class="font-bold"><%= initial_rate.present? ? "#{(initial_rate.to_f * 100).round(2)}%" : "-" %></span></span>
              </div>
              <% if initial_threshold.present? %>
                <div class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-50 border border-indigo-200 rounded-lg">
                  <span class="text-sm font-medium text-indigo-900">Threshold: <span class="font-bold"><%= sprintf("%.4f", initial_threshold.to_f) %></span></span>
                </div>
              <% end %>
            </div>
          </div>

          <p class="text-sm text-gray-600">
            Singlet cells are shown in <span class="text-green-700 font-medium">green</span>, doublets in <span class="text-red-700 font-medium">red</span>.
          </p>

          <div data-doublet-calling-target="histogramPlot" class="doublet-calling-plot-area bg-gray-50 border border-gray-200 rounded-md p-2 w-full"></div>
          <div class="doublet-calling-plot-grid">
            <div data-doublet-calling-target="scatterPlot" class="doublet-calling-plot-area bg-gray-50 border border-gray-200 rounded-md p-2 w-full"></div>
            <div data-doublet-calling-target="sortedPlot" class="doublet-calling-plot-area bg-gray-50 border border-gray-200 rounded-md p-2 w-full"></div>
          </div>
          </div>
          </div>
        </div>
      <% else %>
        <div class="alert alert-info">Doublet score metadata is not available for this run.</div>
      <% end %>
    <% else %>
      <%= render partial: "projects/views/single_run_intermediate_status", locals: { run: run_for_view } if run_for_view %>
    <% end %>
  </div>
</div>
