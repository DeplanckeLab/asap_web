<style>
:root {
/* Tier 1: Card & Section Titles - Scales from ~14px to ~22px */
--font-size-title: clamp(0.875rem, 1.2vw, 1.375rem);
/* Tier 2: Hero Numbers - Scales from ~28px to ~60px */
--font-size-hero: clamp(1.75rem, 4.5vw, 3.75rem);
/* Tier 3: General Body Text - Scales from ~13px to ~17px */
--font-size-body: clamp(0.8125rem, 0.9vw, 1.0625rem);
}

.adaptive-dashboard {
font-size: var(--font-size-body);
line-height: 1.5;
}

.dashboard-card-title {
font-size: var(--font-size-title) !important;
font-weight: 600;
}

.hero-stat {
font-size: var(--font-size-hero) !important;
line-height: 1;
font-weight: 700;
}

/* Ensure all standard elements follow the 3-tier scaling rules */
.adaptive-dashboard .text-xs,
.adaptive-dashboard .text-sm,
.adaptive-dashboard table,
.adaptive-dashboard p,
.adaptive-dashboard span:not(.hero-stat):not(.dashboard-card-title):not(.badge-text) {
font-size: inherit;
}

.adaptive-dashboard i { font-size: 1.1em; }
.adaptive-dashboard .badge-text { font-size: 0.82em; }
</style>

<%
can_edit_project_title = editable?(@project) && !@project.public?
summary_run_counts = project_run_counts(@project)
summary_total_runs = summary_run_counts.values.sum
summary_loom_file_count = @summary_loom_file_count || 0
summary_shared_users_count = @summary_shared_users_count || 0
summary_embedding_count = @summary_embedding_count || 0
summary_visual_annotation_count = @summary_visual_annotation_count || 0
summary_run_user_count = @summary_run_user_count || 0
summary_checkpoint_count = @summary_checkpoint_count || 0
summary_checkpoint_comment_count = @summary_checkpoint_comment_count || 0
summary_compliance_schema_count = @project.compliance_schemas.size
summary_owner_display = if current_user&.email.present? && @project.user&.email.present? && current_user.email.casecmp(@project.user.email).zero?
'me'
else
@project.user&.email.to_s.split('@').first
end
downloaded_from_sources = @project.provider_projects.filter_map do |pp|
provider = pp.provider
next unless provider
if provider.url_mask.present?
link_to provider.name, provider.url_mask.gsub('#{id}', pp.key.to_s), target: '_blank', class: "text-blue-600 hover:text-blue-800 hover:underline"
else
content_tag(:span, provider.name, class: "text-gray-700")
end
end
summary_parsing_attrs = begin JSON.parse(@project.parsing_attrs_json.to_s); rescue; {}; end
summary_integration_source_keys = summary_parsing_attrs['integrate_batch_paths'].is_a?(Hash) ? summary_parsing_attrs['integrate_batch_paths'].keys.reject(&:blank?) : []
summary_integration_projects_by_key = summary_integration_source_keys.any? ? Project.where(key: summary_integration_source_keys).index_by(&:key) : {}
summary_clone_lineage_projects = []
if @project.cloned_project_id.present?
summary_lineage_current = @project
summary_lineage_visited_ids = [@project.id]
summary_clone_lineage_projects << @project
while summary_lineage_current.cloned_project_id.present?
summary_parent_id = summary_lineage_current.cloned_project_id
break if summary_lineage_visited_ids.include?(summary_parent_id)
summary_lineage_parent = Project.find_by(id: summary_parent_id)
if summary_lineage_parent
summary_clone_lineage_projects << summary_lineage_parent
summary_lineage_visited_ids << summary_lineage_parent.id
summary_lineage_current = summary_lineage_parent
else break; end
end
end
summary_embedding_records = Annot.where(project_id: @project.id, nber_rows: 2).includes(:user, run: [:user, :step]).order(:filepath, :name).to_a
summary_checkpoint_records = @project.checkpoints.includes(:user).order(created_at: :desc).to_a
summary_checkpoint_comments = []
summary_checkpoint_records.each do |cp|
cp.comments.each do |c|
summary_checkpoint_comments << { checkpoint_title: cp.title, body: (c['body'] || c[:body] || c['comment']).to_s, user_name: (c['user_name'] || c[:user_name]).to_s, created_at: (c['created_at'] || c[:created_at]).to_s }
end
end
summary_cla_records = Cla.active.where(project_id: @project.id).includes(:annot, :cell_set, :user).order(created_at: :desc).to_a
summary_annotation_options = summary_cla_records.group_by(&:annot_id).map do |aid, clas|
annot = clas.first&.annot; next unless annot; { id: aid, label: (annot.display_name.presence || annot.name.to_s), count: clas.length }
end.compact.sort_by { |e| e[:label].to_s.downcase }
summary_default_annotation_id = summary_annotation_options.first&.dig(:id)
%>
<div class="adaptive-dashboard">
<div class="mb-4">
<h2 class="font-bold text-gray-900 mb-2" style="font-size: clamp(1.5rem, 3.5vw, 2.75rem);">Summary</h2>
</div>
<div class="space-y-4">
<%# Row 1: Metrics %>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-<%= (admin?) ? 3 : 2 %> xl:grid-cols-<%= (admin?) ? 5 : 4 %> gap-3">
<div class="block bg-gray-50 rounded-lg border border-gray-200 px-4 py-3 hover:border-blue-300 hover:bg-blue-50 transition-colors cursor-pointer sm:col-span-2 lg:col-span-1" data-summary-visualization-card-link data-url="<%= project_path(@project, view: 'visualization') %>" role="link" tabindex="0">
<p class="dashboard-card-title text-gray-900 flex items-center gap-2"><i class="fas fa-chart-line text-gray-500"></i><span>Visualization</span></p>
<div class="grid grid-cols-2 gap-2 mt-2">
<button type="button" data-summary-detail-trigger data-summary-detail-type="embeddings" class="badge-text inline-flex items-center justify-center rounded px-2 py-1 whitespace-nowrap <%= summary_embedding_count.to_i.positive? ? 'bg-blue-100 text-blue-800 hover:bg-blue-200' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %>"><span class="font-semibold mr-1"><%= number_with_delimiter(summary_embedding_count) %></span> embeddings</button>
<button type="button" data-summary-detail-trigger data-summary-detail-type="annotations" class="badge-text inline-flex items-center justify-center rounded px-2 py-1 whitespace-nowrap <%= summary_visual_annotation_count.to_i.positive? ? 'bg-indigo-100 text-indigo-800 hover:bg-indigo-200' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %>"><span class="font-semibold mr-1"><%= number_with_delimiter(summary_visual_annotation_count) %></span> annotations</button>
<button type="button" data-summary-detail-trigger data-summary-detail-type="checkpoints" class="badge-text inline-flex items-center justify-center rounded px-2 py-1 whitespace-nowrap <%= summary_checkpoint_count.to_i.positive? ? 'bg-emerald-100 text-emerald-800 hover:bg-emerald-200' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %>"><span class="font-semibold mr-1"><%= number_with_delimiter(summary_checkpoint_count) %></span> checkpoints</button>
<button type="button" data-summary-detail-trigger data-summary-detail-type="comments" class="badge-text inline-flex items-center justify-center rounded px-2 py-1 whitespace-nowrap <%= summary_checkpoint_comment_count.to_i.positive? ? 'bg-amber-100 text-amber-800 hover:bg-amber-200' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %>"><span class="font-semibold mr-1"><%= number_with_delimiter(summary_checkpoint_comment_count) %></span> comments</button>
</div>
</div>


<%= link_to project_path(@project, view: 'analysis'), class: "block bg-gray-50 rounded-lg border border-gray-200 px-4 py-3 hover:border-blue-300 hover:bg-blue-50 transition-colors" do %>
    <p class="dashboard-card-title text-gray-900 flex items-center gap-2"><i class="fas fa-sitemap text-gray-500"></i><span>Analysis</span></p>
    <div class="mt-2 flex flex-wrap items-baseline gap-x-2"><span class="hero-stat text-gray-900"><%= number_with_delimiter(summary_total_runs) %></span><span class="font-semibold text-gray-600 uppercase tracking-wide badge-text">runs</span></div>
  <% end %>

  <%= link_to project_path(@project, view: 'data'), class: "block bg-gray-50 rounded-lg border border-gray-200 px-4 py-3 hover:border-blue-300 hover:bg-blue-50 transition-colors" do %>
    <p class="dashboard-card-title text-gray-900 flex items-center gap-2"><i class="fas fa-database text-gray-500"></i><span>Data</span></p>
    <div class="mt-2 flex items-baseline gap-2"><span class="hero-stat text-gray-900"><%= number_with_delimiter(summary_loom_file_count) %></span><span class="font-semibold text-gray-600 uppercase tracking-wide badge-text">LOOM files</span></div>
  <% end %>

  <div class="block bg-gray-50 rounded-lg border border-gray-200 px-4 py-3">
    <p class="dashboard-card-title text-gray-900 flex items-center gap-2"><i class="fas fa-cog text-gray-500"></i><span>Settings</span></p>
    <div class="flex flex-col gap-2 mt-2">
      <span class="badge-text inline-flex items-center justify-center rounded px-2 py-1 whitespace-nowrap <%= @project.public? ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800' %>"><%= @project.public? ? 'Public project' : 'Private project' %></span>
      <span class="badge-text inline-flex items-center justify-center rounded px-2 py-1 whitespace-nowrap <%= summary_shared_users_count.to_i.positive? ? 'bg-indigo-100 text-indigo-800' : 'bg-gray-100 text-gray-600' %>">Shared with <span class="font-semibold mx-1"><%= number_with_delimiter(summary_shared_users_count) %></span> users</span>
    </div>
  </div>
<% if admin?%>
  <% if @project.compliance_schemas.any? %>
    <%= link_to project_path(@project, view: 'compliance'), class: "block bg-gray-50 rounded-lg border border-gray-200 px-4 py-3 hover:border-blue-300 hover:bg-blue-50 transition-colors" do %>
      <p class="dashboard-card-title text-gray-900 flex items-center gap-2"><i class="fas fa-check-circle text-gray-500"></i><span>Compliance</span></p>
      <div class="mt-2 flex items-baseline gap-2"><span class="hero-stat text-gray-900"><%= number_with_delimiter(summary_compliance_schema_count) %></span><span class="font-semibold text-gray-600 uppercase tracking-wide badge-text">schemas</span></div>
    <% end %>
  <% else %>
    <div class="block bg-gray-50 rounded-lg border border-gray-200 px-4 py-3"><p class="dashboard-card-title text-gray-900 flex items-center gap-2"><i class="fas fa-check-circle text-gray-500"></i><span>Compliance</span></p><p class="italic text-gray-500 mt-2">No available schema</p></div>
  <% end %>
    <% end %>
</div>

<%# Row 2: Info Boxes %>
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-12 gap-3">
    <div class="bg-white rounded-lg border border-gray-200 p-3 xl:col-span-6">
      <div class="flex items-center justify-between mb-2"><p class="dashboard-card-title text-gray-900 flex items-center gap-2"><i class="fas fa-fingerprint text-gray-500"></i><span>Identity</span></p><div class="flex items-center gap-1.5"><span class="badge-text px-2 py-0.5 rounded font-medium bg-blue-100 text-blue-800"><%= @project.key %></span></div></div>
      <div class="space-y-2.5">
        <div class="flex items-center gap-4 min-h-[1.5em]"><span class="w-24 shrink-0 text-gray-500">Project Name</span>
          <div id="project-title-editor" data-project-title="<%= @project.display_name %>" data-update-url="<%= project_path(@project, format: :json) %>" class="flex items-center gap-2 min-w-0 flex-1">
            <p id="project-title-text" class="text-gray-900 font-bold truncate"><%= @project.display_name %></p>
            <% if can_edit_project_title %><button id="project-title-edit-button" type="button" class="text-gray-400 hover:text-blue-600"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M16.862 3.487a2.1 2.1 0 113 2.97L8.4 17.92l-4.2 1.2 1.2-4.2L16.862 3.487z" /></svg></button>
            <div id="project-title-edit-controls" class="hidden flex items-center gap-2 w-full"><input id="project-title-input" type="text" value="<%= @project.display_name %>" class="w-full px-2 py-1 border rounded"><button id="project-title-save-button" type="button" class="badge-text px-2 py-1 rounded bg-blue-600 text-white">Save</button></div><% end %>
          </div>
        </div>
        <div class="flex items-center gap-4 min-h-[1.5em]"><span class="w-24 shrink-0 text-gray-500">Type</span><span class="text-gray-900 font-medium"><%= @project_type&.name || 'Unknown' %></span></div>
        <div class="flex items-start gap-4 min-h-[1.5em]"><span class="w-24 shrink-0 text-gray-500 mt-0.5">Origin</span><div class="text-gray-700 flex-1">
          <% if @project.cloned_project_id.present? %>Cloned from <%= link_to Project.find_by(id: @project.cloned_project_id)&.key || 'deleted', project_path(id: @project.cloned_project_id), class: "text-blue-600 underline font-semibold" %> <% if summary_clone_lineage_projects.any? %><button id="summary-lineage-toggle-button" type="button" class="badge-text bg-gray-200 text-gray-700 px-1.5 rounded ml-1">Full lineage</button><% end %>
          <% else %>New project<% end %>
        </div></div>
      </div>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 p-3 xl:col-span-3">
      <p class="dashboard-card-title text-gray-900 flex items-center gap-2 mb-2"><i class="fas fa-history text-gray-500"></i><span>Activity</span></p>
      <div class="space-y-2.5">
        <div class="flex justify-between items-center min-h-[1.5em]"><span class="text-gray-500">Created</span><span class="text-gray-900 font-medium"><%= @project.created_at.strftime("%b %d, %Y") %></span></div>
        <div class="flex justify-between items-center min-h-[1.5em]"><span class="text-gray-500">Updated</span><span class="text-gray-900 font-medium"><%= @project.updated_at.strftime("%b %d, %Y") %></span></div>
        <div class="flex justify-between items-center min-h-[1.5em]"><span class="text-gray-500">Views</span><span class="badge-text px-2 py-0.5 rounded bg-indigo-50 text-indigo-700 font-bold"><%= number_with_delimiter(@project.nber_views || 0) %></span></div>
      </div>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 p-3 xl:col-span-3">
      <p class="dashboard-card-title text-gray-900 flex items-center gap-2 mb-2"><i class="fas fa-file-alt text-gray-500"></i><span>Reproducibility</span></p>
      <div class="flex flex-col gap-2">
        <%= link_to "Instructions", instructions_project_path(@project.key), class: "badge-text px-2 py-1 rounded bg-blue-100 text-blue-800 font-medium text-center hover:bg-blue-200" %>
        <%= link_to "Commands", get_commands_project_path(@project.key), class: "badge-text px-2 py-1 rounded bg-gray-100 text-gray-700 font-medium text-center hover:bg-gray-200" %>
        <%= link_to "Loom List (JSON)", get_loom_files_json_project_path(@project.key, download: 1), class: "badge-text px-2 py-1 rounded bg-gray-100 text-gray-700 font-medium text-center hover:bg-gray-200" %>
      </div>
    </div>
</div>

<%# Tier 3: Repository & Publications %>
<div class="grid grid-cols-1 xl:grid-cols-3 gap-3">
  <div class="xl:col-span-2 bg-white rounded-lg border border-gray-200 p-4">
    <p class="dashboard-card-title text-gray-900 flex items-center gap-2 mb-4"><i class="fas fa-link text-gray-500"></i><span>Source repository links</span></p>
    <% if @h_exp_entries && @h_exp_entries.keys.any? %>
      <div class="mt-3 space-y-4">
        <% @h_exp_entries.each do |type_id, exp_entries| %>
          <% next if exp_entries.empty? %>
          <% identifier_type = @h_identifier_types[type_id] %>
          <div>
            <h4 class="font-bold text-gray-700 mb-2" style="font-size: 0.9em;"><%= identifier_type&.name || 'Unknown Type' %></h4>
            <div class="overflow-x-auto rounded-lg border border-gray-100 bg-white">
              <table class="min-w-full divide-y divide-gray-100">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-3 py-1.5 text-left font-semibold text-gray-600">Identifier</th>
                    <th class="px-3 py-1.5 text-left font-semibold text-gray-600">Title</th>
                    <th class="px-3 py-1.5 text-left font-semibold text-gray-600">Other identifiers</th>
                    <th class="px-3 py-1.5 text-left font-semibold text-gray-600">Contributors</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                  <% exp_entries.each do |exp_entry| %>
                    <tr class="hover:bg-blue-50/50">
                      <td class="px-3 py-2 align-top whitespace-nowrap">
                        <% if identifier_type&.url_mask.present? %>
                          <%= link_to exp_entry.identifier, identifier_type.url_mask.gsub('#{id}', exp_entry.identifier.to_s), target: '_blank', class: "badge-text inline-flex items-center px-2 py-0.5 rounded font-bold bg-gray-100 text-blue-600 hover:bg-blue-100" %>
                        <% else %>
                          <span class="badge-text px-2 py-0.5 rounded font-bold bg-gray-100 text-gray-700"><%= exp_entry.identifier %></span>
                        <% end %>
                      </td>
                      <td class="px-3 py-2 align-top text-gray-900"><%= exp_entry.title %></td>
                      <td class="px-3 py-2 align-top">
                        <% h_ids = exp_entry.parsed_identifiers %>
                        <% if h_ids.any? %>
                          <div class="flex flex-wrap gap-1">
                            <% h_ids.each do |id_type_id, ids| %>
                              <% id_type = @h_identifier_types[id_type_id.to_i] %>
                              <% ids.uniq.each do |id| %>
                                <% if id_type&.url_mask.present? %>
                                  <%= link_to id, id_type.url_mask.gsub('#{id}', id.to_s), target: '_blank', class: "badge-text px-2 py-0.5 rounded bg-gray-50 text-gray-600 hover:text-blue-600" %>
                                <% else %><span class="badge-text px-2 py-0.5 rounded bg-gray-50 text-gray-500"><%= id %></span><% end %>
                              <% end %>
                            <% end %>
                          </div>
                        <% end %>
                      </td>
                      <td class="px-3 py-2 align-top text-gray-500">
                        <% if exp_entry.contributors.present? %>
                          <% names = exp_entry.contributors.split(";").map { |c| c.split(",").reject(&:blank?).join(" ").strip }.reject(&:blank?) %>
                          <div class="flex flex-wrap gap-1"><% names.each do |n| %><span class="badge-text px-2 py-0.5 rounded bg-blue-50 text-blue-700"><%= n %></span><% end %></div>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
    <% if downloaded_from_sources.any? %><p class="badge-text text-gray-600 mt-3">Downloaded from <%= safe_join(downloaded_from_sources, ', ') %></p><% end %>
  </div>

  <div class="bg-white rounded-lg border border-gray-200 p-4">
    <p class="dashboard-card-title text-gray-900 flex items-center gap-2 mb-4"><i class="fas fa-book-open text-gray-500"></i><span>Publications</span></p>
    <div class="space-y-4">
      <% publication_dois = @project.doi.to_s.split(/\s*,\s*/).reject(&:blank?) %>
      <% if publication_dois.any? %><% publication_dois.each do |doi| %>
        <% article = @h_articles[doi] %>
        <div class="leading-snug">
          <% if article %>
            <p class="text-gray-900 font-medium"><%= link_to article.title.to_s.truncate(120), "https://doi.org/#{doi}", target: '_blank', class: "hover:text-blue-700 hover:underline" %></p>
            <% if article.authors.present? %>
              <p class="text-gray-500 flex flex-wrap items-center gap-x-2 gap-y-1">
                <span><%= sanitize(article.authors.to_s.truncate(120).gsub(/\bet al\.?/i) { |match| "<em>#{match}</em>" }, tags: %w[em]) %></span>
                <% if article.pmid.present? %><%= link_to "PubMed: #{article.pmid}", "https://pubmed.ncbi.nlm.nih.gov/#{article.pmid}/", target: '_blank', class: "badge-text px-2 py-0.5 rounded bg-green-100 text-green-800" %><% end %>
              </p>
            <% end %>
          <% else %><p class="text-gray-900 font-medium"><%= link_to doi, "https://doi.org/#{doi}", target: '_blank', class: "hover:text-blue-700 hover:underline" %></p><% end %>
        </div>
      <% end %><% else %><p class="italic text-gray-400">No publications.</p><% end %>
    </div>
  </div>
</div>

</div>

<%# Draggable Details Popover %>
<div id="summary-visual-details-popover" class="hidden fixed z-50 w-[min(64rem,95vw)] max-h-[85vh] bg-white rounded-lg border shadow-2xl flex flex-col overflow-hidden">
<div id="summary-visual-details-header" class="flex items-center justify-between px-4 py-3 border-b bg-gray-50 cursor-move"><h3 id="summary-visual-details-title" class="font-bold text-gray-900">Details</h3><button id="summary-visual-details-close-button" type="button" class="text-gray-400 hover:text-red-500"><i class="fas fa-times"></i></button></div>
<div class="p-4 flex-1 overflow-auto">
<div data-summary-detail-section="embeddings" class="hidden"><table class="min-w-full"><thead class="bg-gray-50"><tr><th class="px-2 py-2 text-left">File</th><th class="px-2 py-2 text-left">Name</th></tr></thead><tbody><% summary_embedding_records.each do |e| %><tr class="border-b"><td class="px-2 py-2 text-gray-500"><%= e.filepath.split('/').last %></td><td class="px-2 py-2 font-bold"><%= e.name %></td></tr><% end %></tbody></table></div>
<div data-summary-detail-section="annotations" class="hidden"><div id="summary-annotations-main-view"><select id="summary-annotations-metadata-select" class="w-full max-w-md p-2 border rounded mb-4"><% summary_annotation_options.each do |o| %><option value="<%= o[:id] %>"><%= o[:label] %> (<%= o[:count] %>)</option><% end %></select><table class="min-w-full"><thead><tr class="bg-gray-50 text-gray-500 font-bold"><th class="px-2 py-2 text-left">Label</th><th class="px-2 py-2 text-left">Votes</th></tr></thead><tbody><% summary_cla_records.each do |cla| %><tr data-summary-annotation-row data-annot-id="<%= cla.annot_id %>" class="border-b"><td class="px-2 py-2 font-bold"><%= cla.name || cla.cat %></td><td class="px-2 py-2 font-bold text-gray-500">+<%= cla.nber_agree %> / -<%= cla.nber_disagree %></td></tr><% end %></tbody></table></div></div>
<div data-summary-detail-section="checkpoints" class="hidden"><% summary_checkpoint_records.each do |cp| %><div class="border-b py-3"><p class="font-bold"><%= cp.title %></p></div><% end %></div>
<div data-summary-detail-section="comments" class="hidden"><% summary_checkpoint_comments.each do |com| %><div class="border-b py-3"><p class="font-medium">"<%= com[:body] %>"</p></div><% end %></div>
</div>
</div>
</div>
<script>
(function initDashboardJS() {
const makeDraggable = (el, handleId) => {
const handle = document.getElementById(handleId); if (!handle) return;
let x = 0, y = 0, nx = 0, ny = 0; handle.onmousedown = (e) => {
e.preventDefault(); nx = e.clientX; ny = e.clientY;
document.onmouseup = () => { document.onmouseup = null; document.onmousemove = null; };
document.onmousemove = (e) => { x = nx - e.clientX; y = ny - e.clientY; nx = e.clientX; ny = e.clientY; el.style.top = (el.offsetTop - y) + "px"; el.style.left = (el.offsetLeft - x) + "px"; };
};
};
const titleEditor = document.getElementById('project-title-editor');
if (titleEditor) {
const editBtn = document.getElementById('project-title-edit-button'); const text = document.getElementById('project-title-text'); const controls = document.getElementById('project-title-edit-controls'); const input = document.getElementById('project-title-input'); const saveBtn = document.getElementById('project-title-save-button');
editBtn?.addEventListener('click', () => { [text, editBtn].forEach(el => el.classList.add('hidden')); controls.classList.remove('hidden'); input.focus(); });
saveBtn?.addEventListener('click', async () => {
const val = input.value.trim(); const csrf = document.querySelector('meta[name="csrf-token"]')?.content;
const res = await fetch(titleEditor.dataset.updateUrl, { method: 'PATCH', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf }, body: JSON.stringify({ project: { name: val } }) });
if (res.ok) { text.textContent = val; controls.classList.add('hidden'); [text, editBtn].forEach(el => el.classList.remove('hidden')); }
});
}
const detailsPop = document.getElementById('summary-visual-details-popover');
document.querySelectorAll('[data-summary-detail-trigger]').forEach(t => {
t.addEventListener('click', (e) => {
e.stopPropagation(); const type = t.dataset.summaryDetailType;
document.getElementById('summary-visual-details-title').textContent = type.toUpperCase();
detailsPop.querySelectorAll('[data-summary-detail-section]').forEach(s => s.classList.add('hidden'));
detailsPop.querySelector(`[data-summary-detail-section="${type}"]`).classList.remove('hidden');
detailsPop.classList.remove('hidden'); detailsPop.style.top = '15%'; detailsPop.style.left = '20%';
});
});
document.getElementById('summary-visual-details-close-button')?.addEventListener('click', () => detailsPop.classList.add('hidden'));
makeDraggable(detailsPop, 'summary-visual-details-header');
const metaSelect = document.getElementById('summary-annotations-metadata-select');
if (metaSelect) {
const update = () => { const v = metaSelect.value; document.querySelectorAll('[data-summary-annotation-row]').forEach(r => r.classList.toggle('hidden', r.dataset.annotId !== v)); };
metaSelect.addEventListener('change', update); update();
}
const lineageBtn = document.getElementById('summary-lineage-toggle-button'); const lineagePop = document.getElementById('summary-lineage-popover');
lineageBtn?.addEventListener('click', (e) => { e.stopPropagation(); lineagePop?.classList.remove('hidden'); });
const cardLink = document.querySelector('[data-summary-visualization-card-link]');
cardLink?.addEventListener('click', () => window.location = cardLink.dataset.url);
})();
</script>