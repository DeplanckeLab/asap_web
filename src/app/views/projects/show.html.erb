<% content_for :title do %><%= @project.display_name %> - ASAP<% end %>
<% meta_desc = if @project.description.present?
  strip_tags(@project.description.to_s).squish.truncate(160)
else
  "Project #{@project.display_name} on ASAP, the Automated Single-cell Analysis Pipeline for single-cell transcriptomics."
end %>
<% content_for :meta_description, meta_desc %>

<!-- Content Area: unarchive-in-progress applies to every tab (same condition as visualization used to use alone) -->
<% unarchive_state = @project_unarchive_state.to_s %>
<% show_unarchive_pending = @project_archive_transitioning || (@project_files_missing && %w[queued in_progress archived_missing queue_failed].include?(unarchive_state)) %>
<% if show_unarchive_pending %>
  <div class="flex-1 min-h-0 overflow-hidden flex flex-col">
    <%= render 'projects/views/unarchive_pending_overlay' %>
  </div>
<% else %>
<% case @view_type %>
<% when 'summary' %>
  <div class="flex-1 overflow-y-auto px-4 sm:px-6 lg:px-8 py-6">
    <%= render 'projects/views/summary' %>
  </div>
<% when 'visualization' %>
  <div class="flex-1 min-h-0 overflow-hidden">
    <%= render 'projects/views/visualization' %>
  </div>
<% when 'analysis' %>
  <div class="flex-1 flex flex-col min-h-0 px-4 sm:px-6 lg:px-8 py-6">
    <%= render 'projects/views/analysis' %>
  </div>
<% when 'data' %>
  <div class="flex-1 overflow-y-auto px-4 sm:px-6 lg:px-8 py-6">
    <%= render 'projects/views/data' %>
  </div>
<% when 'settings' %>
  <div class="flex-1 overflow-y-auto px-4 sm:px-6 lg:px-8 py-6">
    <%= render 'projects/views/settings' %>
  </div>
<% when 'compliance' %>
  <div class="flex-1 overflow-y-auto px-4 sm:px-6 lg:px-8 py-6">
    <%= render 'projects/views/compliance' %>
  </div>
<% when 'access' %>
  <div class="flex-1 overflow-y-auto px-4 sm:px-6 lg:px-8 py-6">
    <%= render 'projects/views/access' %>
  </div>
<% else %>
  <div class="flex-1 overflow-y-auto px-4 sm:px-6 lg:px-8 py-6">
    <%= render 'projects/views/summary' %>
  </div>
<% end %>
<% end %>
