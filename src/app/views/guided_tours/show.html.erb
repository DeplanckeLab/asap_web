<% content_for :title, "#{@guided_tour.name} - Guided Tour" %>

<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8 space-y-6">
  <% if notice.present? %>
    <div class="rounded-md bg-green-100 px-4 py-3 text-sm text-green-700"><%= notice %></div>
  <% end %>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-4">
    <aside class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm lg:col-span-1">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900">All Tours</h2>
        <%= link_to "Manage", guided_tours_path, class: "text-xs text-gray-600 hover:text-gray-900" %>
      </div>
      <div class="space-y-2">
        <% @guided_tours.each do |tour| %>
          <%= link_to tour.name, guided_tour_path(tour), class: "block rounded-md border px-3 py-2 text-sm #{tour == @guided_tour ? 'border-gray-900 bg-gray-900 text-white' : 'border-gray-200 text-gray-700 hover:bg-gray-50'}" %>
        <% end %>
      </div>
    </aside>

    <section class="space-y-6 lg:col-span-3">
      <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
        <h1 class="text-2xl font-semibold text-gray-900 mb-4">Guided Tour Settings</h1>
        <%= form_with model: @guided_tour, class: "space-y-4" do |form| %>
          <% if @guided_tour.errors.any? %>
            <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
              <p class="font-semibold"><%= pluralize(@guided_tour.errors.count, "error") %> prevented saving:</p>
              <ul class="mt-2 list-disc space-y-1 pl-5">
                <% @guided_tour.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="grid gap-4 md:grid-cols-3">
            <div class="md:col-span-2">
              <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
              <%= form.text_field :name, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900" %>
            </div>
            <div>
              <%= form.label :duration_time, "Duration (seconds)", class: "block text-sm font-medium text-gray-700" %>
              <%= form.number_field :duration_time, min: 0, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900" %>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <%= form.submit "Update Tour", class: "inline-flex items-center rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-gray-800" %>
            <%= link_to "Delete Tour", guided_tour_path(@guided_tour), method: :delete, data: { confirm: "Delete this guided tour and all its steps?" }, class: "text-sm text-red-600 hover:text-red-700" %>
          </div>
        <% end %>
      </div>

      <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm space-y-6">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-xl font-semibold text-gray-900">Steps</h2>
            <p class="text-sm text-gray-600">Drag rows to reorder. Edit each step inline.</p>
          </div>
        </div>

        <div class="rounded-lg border border-gray-200 p-4">
          <h3 class="text-sm font-semibold text-gray-900 mb-3">Add Step</h3>
          <%= form_with model: [@guided_tour, @new_guided_tour_step], class: "space-y-4" do |form| %>
            <% if @new_guided_tour_step.errors.any? %>
              <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
                <ul class="list-disc space-y-1 pl-5">
                  <% @new_guided_tour_step.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="grid gap-4 md:grid-cols-3">
              <div>
                <%= form.label :title, class: "block text-sm font-medium text-gray-700" %>
                <%= form.text_field :title, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900", placeholder: "Chapter title" %>
              </div>
              <div>
                <%= form.label :page_url, class: "block text-sm font-medium text-gray-700" %>
                <%= form.text_field :page_url, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900", placeholder: "/projects/123?view=analysis" %>
              </div>
              <div>
                <%= form.label :focus_element, class: "block text-sm font-medium text-gray-700" %>
                <%= form.text_field :focus_element, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900", placeholder: "#analysis-panel" %>
              </div>
            </div>

            <div>
              <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <% description_input_id = "new_step_description_input" %>
              <%= form.hidden_field :description, id: description_input_id %>
              <trix-editor input="<%= description_input_id %>" class="trix-content"></trix-editor>
            </div>

            <div>
              <%= form.label :step_actions_json, "Step actions (JSON array)", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_area :step_actions_json, rows: 6, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 font-mono text-xs text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900", placeholder: '[\n  { "action": "wait_for_selector", "selector": "#panel" },\n  { "action": "scroll_to", "selector": "#panel" }\n]' %>
              <p class="mt-1 text-xs text-gray-500">Declarative steps: scroll_to, click, wait_for_selector (each object needs action and required fields).</p>
            </div>

            <div>
              <%= form.submit "Create Step", class: "inline-flex items-center rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-gray-800" %>
            </div>
          <% end %>
        </div>

        <div
          class="space-y-4"
          data-controller="sortable-list"
          data-sortable-list-url-value="<%= reorder_steps_guided_tour_path(@guided_tour) %>"
          data-sortable-list-item-selector-value="div[data-id]">
          <% @guided_tour_steps.each do |step| %>
            <div
              data-id="<%= step.id %>"
              draggable="true"
              data-action="dragstart->sortable-list#dragstart dragover->sortable-list#dragover drop->sortable-list#drop dragend->sortable-list#dragend"
              class="rounded-lg border border-gray-200 p-4">
              <div class="mb-3 flex items-center justify-between">
                <div class="text-sm font-semibold text-gray-900" data-rank-label>Step #<%= step.rank %></div>
              </div>

              <%= form_with model: [@guided_tour, step], class: "space-y-4" do |form| %>
                <div class="grid gap-4 md:grid-cols-3">
                  <div>
                    <%= form.label :title, class: "block text-sm font-medium text-gray-700" %>
                    <%= form.text_field :title, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900" %>
                  </div>
                  <div>
                    <%= form.label :page_url, class: "block text-sm font-medium text-gray-700" %>
                    <%= form.text_field :page_url, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900" %>
                  </div>
                  <div>
                    <%= form.label :focus_element, class: "block text-sm font-medium text-gray-700" %>
                    <%= form.text_field :focus_element, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900" %>
                  </div>
                </div>

                <div>
                  <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
                  <% description_input_id = "guided_tour_step_#{step.id}_description_input" %>
                  <%= form.hidden_field :description, id: description_input_id %>
                  <trix-editor input="<%= description_input_id %>" class="trix-content"></trix-editor>
                </div>

                <div>
                  <%= form.label :step_actions_json, "Step actions (JSON array)", class: "block text-sm font-medium text-gray-700 mb-1" %>
                  <%= form.text_area :step_actions_json, rows: 6, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 font-mono text-xs text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900" %>
                  <p class="mt-1 text-xs text-gray-500">Declarative steps: scroll_to, click, wait_for_selector.</p>
                </div>

                <div class="flex items-center gap-3">
                  <%= form.submit "Save Step", class: "inline-flex items-center rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-gray-800" %>
                  <%= link_to "Delete Step", guided_tour_guided_tour_step_path(@guided_tour, step), method: :delete, data: { confirm: "Delete this step?" }, class: "text-sm text-red-600 hover:text-red-700" %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <% if @guided_tour_steps.empty? %>
          <div class="rounded-lg border border-dashed border-gray-300 bg-white px-6 py-8 text-center text-gray-500">
            No steps yet for this guided tour.
          </div>
        <% end %>
      </div>
    </section>
  </div>
</div>
