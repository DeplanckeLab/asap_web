<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-6", data: { turbo: false } }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="space-y-2">
    <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email",
        class: "block w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition" %>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <p class="text-sm text-gray-500 bg-gray-100 border border-gray-200 rounded-lg px-4 py-3">
      Currently waiting confirmation for: <span class="font-medium text-gray-700"><%= resource.unconfirmed_email %></span>
    </p>
  <% end %>

  <div class="space-y-2">
    <div class="flex items-center justify-between">
      <%= f.label :password, class: "block text-sm font-medium text-gray-700" %>
      <span class="text-xs text-gray-500">Leave blank to keep the current password</span>
    </div>
    <%= f.password_field :password, autocomplete: "new-password",
        class: "block w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition" %>
    <% if @minimum_password_length %>
      <p class="text-xs text-gray-500"><%= @minimum_password_length %> characters minimum</p>
    <% end %>
  </div>

  <div class="space-y-2">
    <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password",
        class: "block w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition" %>
  </div>

  <div class="space-y-2">
    <div class="flex items-center justify-between">
      <%= f.label :current_password, class: "block text-sm font-medium text-gray-700" %>
      <span class="text-xs text-gray-500">Required to confirm updates</span>
    </div>
    <%= f.password_field :current_password, autocomplete: "current-password",
        class: "block w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition" %>
  </div>

  <div class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-4">
    <% orcid_client_id_present = Rails.application.credentials.dig(:orcid, :client_id).to_s.present? || ENV['ORCID_CLIENT_ID'].to_s.present? %>
    <% orcid_client_secret_present = Rails.application.credentials.dig(:orcid, :client_secret).to_s.present? || ENV['ORCID_CLIENT_SECRET'].to_s.present? %>
    <% orcid_configured = orcid_client_id_present && orcid_client_secret_present %>
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-sm font-semibold text-gray-800">ORCID integration</p>
        <% if current_user.orcid_user.present? %>
          <p class="mt-1 text-xs text-emerald-700">Connected</p>
          <p class="mt-1 text-sm text-gray-700"><%= current_user.orcid_user.name.presence || 'Unnamed ORCID profile' %></p>
          <p class="text-xs text-gray-500"><%= current_user.orcid_user.key %></p>
        <% else %>
          <p class="mt-1 text-xs text-amber-700">Not connected</p>
          <p class="mt-1 text-xs text-gray-600">Connect ORCID to enable annotation and comment permissions when required.</p>
          <% unless orcid_configured %>
            <% missing_items = [] %>
            <% missing_items << 'client_id' unless orcid_client_id_present %>
            <% missing_items << 'client_secret' unless orcid_client_secret_present %>
            <p class="mt-1 text-xs text-rose-700">ORCID is currently not configured on this deployment (missing: <%= missing_items.join(', ') %>).</p>
            <p class="mt-1 text-xs text-gray-500">Checked sources: Rails credentials (<code>orcid.client_id</code>, <code>orcid.client_secret</code>) and ENV (<code>ORCID_CLIENT_ID</code>, <code>ORCID_CLIENT_SECRET</code>).</p>
          <% end %>
        <% end %>
      </div>
      <%= link_to(orcid_configured ? orcid_authentication_path : '#',
          class: "inline-flex items-center gap-2 rounded-md border border-gray-300 #{orcid_configured ? 'bg-white text-gray-700 hover:bg-gray-100' : 'bg-gray-100 text-gray-400 cursor-not-allowed'} px-3 py-2 text-xs font-medium transition",
          title: (orcid_configured ? nil : 'ORCID client credentials are not fully configured')) do %>
        <i class="fas fa-pen text-[10px]"></i>
        <%= current_user.orcid_user.present? ? 'Reconnect ORCID' : 'Connect ORCID' %>
      <% end %>
    </div>
  </div>

  <%= f.submit "Update account",
      class: "w-full inline-flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition" %>
<% end %>

<div class="mt-8 space-y-3">
  <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
    Unhappy with your account? You can permanently remove it below.
  </div>
  <%= button_to "Cancel my account", registration_path(resource_name),
      method: :delete,
      data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" },
      class: "w-full inline-flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition" %>
  <%= link_to "Back to dashboard", main_app.root_path,
      class: "block text-center text-sm font-medium text-blue-600 hover:text-blue-500 transition" %>
</div>
