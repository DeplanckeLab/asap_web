        <select id="annot-new-annotation-type" style="width:100%;padding: 6px 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px;background:#fff;">__ANNOTATION_TYPE_OPTIONS__</select>
      </div>
      <div id="annot-new-ontology-wrap">
