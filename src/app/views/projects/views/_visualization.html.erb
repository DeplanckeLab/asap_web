              </div>
            </div>
          </div>
        </div>

        <!-- Gene Sets Tab Content -->
        <div id="gene-sets-tab-content" style="flex: 1; padding: 16px; overflow-y: auto; min-height: 0; display: none;">
          <div style="margin-bottom: 16px;">
            <div style="font-size: 14px; color: #6b7280; margin-bottom: 12px;">
              Manage gene sets for analysis
            </div>
            
            <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px;">
              <button style="width: 100%; padding: 8px 12px; background-color: #3b82f6; color: white; border-radius: 6px; border: none; cursor: pointer; font-size: 14px; transition: background-color 0.2s;"
