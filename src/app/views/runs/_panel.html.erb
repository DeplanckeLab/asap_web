                              <% display_name = annot_name == '/matrix' ? 'matrix' : format_annot_name(annot_name) %>
                              <%= link_to annot_path(annot, from: 'run', run_id: @run.id, step_id: @step&.id), class: 'inline-flex items-center gap-2 px-3 py-1.5 rounded-md text-sm font-medium bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 transition-colors' do %>
                                <span><%= display_name %></span>
                                <%= dimension_badge(annot.nber_rows, :row, @project) %>
                                <%= dimension_badge(annot.nber_cols, :col, @project) %>
                              <% end %>
                            <% end %>
                          </div>
                        </div>
                      <% end %>
                      <% if col_attrs.any? %>
                        <div>
                          <h6 class="text-xs font-medium text-gray-700 uppercase tracking-wide mb-2"><%= col_label(@project) %> Metadata</h6>
                          <div class="flex flex-wrap gap-1.5">
                            <% col_attrs.each do |annot| %>
                              <% annot_name = annot.name || '' %>
                              <% display_name = annot_name.gsub(/^\/col_attrs\//, '') %>
                              <%= link_to annot_path(annot, from: 'run', run_id: @run.id, step_id: @step&.id), class: 'inline-flex items-center gap-2 px-3 py-1.5 rounded-md text-sm font-medium bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 transition-colors' do %>
                                <span><%= display_name %></span>
                                <%= dimension_badge(1, :row, @project) %>
                                <%= dimension_badge(matrix_nber_cols, :col, @project) %>
                              <% end %>
                            <% end %>
                          </div>
                        </div>
                      <% end %>
                      <% if row_attrs.any? %>
                        <div>
                          <h6 class="text-xs font-medium text-gray-700 uppercase tracking-wide mb-2"><%= row_label(@project) %> Metadata</h6>
                          <div class="flex flex-wrap gap-1.5">
                            <% row_attrs.each do |annot| %>
                              <% annot_name = annot.name || '' %>
                              <% display_name = annot_name.gsub(/^\/row_attrs\//, '') %>
                              <button type="button" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md text-sm font-medium bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 transition-colors">
                                <span><%= display_name %></span>
                                <%= dimension_badge(matrix_nber_rows, :row, @project) %>
                                <%= dimension_badge(1, :col, @project) %>
                              </button>
                            <% end %>
                          </div>
                        </div>
                      <% end %>
                      <% if global_attrs.any? %>
                        <div>
                          <h6 class="text-xs font-medium text-gray-700 uppercase tracking-wide mb-2">Global Metadata</h6>
                          <div class="flex flex-wrap gap-1.5">
                            <% global_attrs.each do |annot| %>
                              <% annot_name = annot.name || '' %>
                              <% display_name = annot_name.gsub(/^\/attrs\//, '').gsub(/^\//, '') %>
                              <button type="button" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md text-sm font-medium bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 transition-colors">
                                <span><%= display_name %></span>
                              </button>
                            <% end %>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  <% else %>
                    <%= raw translate_bootstrap_in_html(@h_el['card-results'][:card_body]) %>
                  <% end %>
                </div>
              </div>
            <% end %>
            
            <% if @h_el['card-downloads'] %>
              <div class="<%= tw_class('card') %>">
                <% if @h_el['card-downloads'][:card_header] %>
                  <div class="<%= tw_class('card-header') %>">
                    <i class="fas fa-download text-gray-500"></i>
                    <%= raw translate_bootstrap_in_html(@h_el['card-downloads'][:card_header]) %>
                  </div>
                <% end %>
                <div class="<%= tw_class('card-body') %> space-y-1">
                  <%= raw translate_bootstrap_in_html(@h_el['card-downloads'][:card_body]) %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
      <%# End of std_view conditional - our improved sections are always shown above %>

      <!-- Additional Information (Admin only) -->
      <% if admin? %>
        <div class="pt-4 border-t border-gray-200 relative">
          <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3 flex items-center gap-2">
            <i class="fas fa-shield-alt text-gray-500"></i>
            Admin Information
          </h4>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-2">
              <div>
                <span class="text-xs font-medium text-gray-500 uppercase">Run ID</span>
                <p class="text-sm text-gray-900 font-mono mt-1"><%= @run.id %></p>
              </div>
              <div>
                <span class="text-xs font-medium text-gray-500 uppercase">Project ID</span>
                <p class="text-sm text-gray-900 font-mono mt-1"><%= @run.project_id %></p>
              </div>
              <div>
                <span class="text-xs font-medium text-gray-500 uppercase">Step ID</span>
                <p class="text-sm text-gray-900 font-mono mt-1"><%= @run.step_id %></p>
              </div>
              <div>
                <span class="text-xs font-medium text-gray-500 uppercase">Std Method ID</span>
                <p class="text-sm text-gray-900 font-mono mt-1"><%= @run.std_method_id || 'N/A' %></p>
              </div>
            </div>
            <div class="space-y-2">
              <div>
                <span class="text-xs font-medium text-gray-500 uppercase">Status ID</span>
                <p class="text-sm text-gray-900 font-mono mt-1"><%= @run.status_id %></p>
              </div>
              <% if @run.slurm_job_id %>
                <div>
                  <span class="text-xs font-medium text-gray-500 uppercase">SLURM Job ID</span>
                  <p class="text-sm text-gray-900 font-mono mt-1"><%= @run.slurm_job_id %></p>
                </div>
              <% end %>
              <% if @run.pid %>
                <div>
                  <span class="text-xs font-medium text-gray-500 uppercase">PID</span>
                  <p class="text-sm text-gray-900 font-mono mt-1"><%= @run.pid %></p>
                </div>
              <% end %>
              <div>
                <span class="text-xs font-medium text-gray-500 uppercase">Async</span>
                <p class="text-sm text-gray-900 mt-1"><%= @run.async ? 'Yes' : 'No' %></p>
              </div>
              <% if @run.waiting_duration %>
                <div>
                  <span class="text-xs font-medium text-gray-500 uppercase">Waiting Duration</span>
                  <p class="text-sm text-gray-900 font-mono mt-1"><%= duration(@run.waiting_duration.to_i) %></p>
                </div>
              <% end %>
            </div>
          </div>
          <% if @run.command_json.present? %>
            <div class="mt-4 pt-4 border-t border-gray-200">
              <span class="text-xs font-medium text-gray-500 uppercase block mb-2">Command JSON</span>
              <pre class="bg-gray-50 border border-gray-200 rounded-md p-3 text-xs font-mono text-gray-700 overflow-x-auto"><%= JSON.pretty_generate(Basic.safe_parse_json(@run.command_json, {})) %></pre>
            </div>
          <% end %>
        </div>
      <% end %>
      </div>
    </div>
  </div>
</div>


