<%# Renders a "History" button and a floating modal with past validation runs.
    Expects: project (a Project instance) %>
<% validation_history = ComplianceValidation.for_project(project.id).includes(:compliance_schema).limit(50) %>

<button type="button"
        onclick="document.getElementById('compliance-history-modal').classList.remove('hidden')"
        class="inline-flex items-center px-4 py-2 bg-gray-200 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-300 transition-colors">
  <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
  </svg>
  History
</button>

<div id="compliance-history-modal"
     class="hidden fixed inset-0 z-50 flex items-center justify-center"
     onclick="if(event.target===this)this.classList.add('hidden')">
  <div class="absolute inset-0 bg-black bg-opacity-30"></div>
  <div class="relative bg-white rounded-xl shadow-xl max-w-2xl w-full mx-4 max-h-[80vh] flex flex-col">
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-semibold text-gray-900">Validation History</h3>
      <button type="button"
              onclick="document.getElementById('compliance-history-modal').classList.add('hidden')"
              class="text-gray-400 hover:text-gray-600">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="overflow-y-auto px-6 py-4">
      <% if validation_history.any? %>
        <% history_list = validation_history.to_a %>
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead>
            <tr>
              <th class="pb-2 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
              <th class="pb-2 text-left text-xs font-medium text-gray-500 uppercase">Schema</th>
              <th class="pb-2 text-center text-xs font-medium text-gray-500 uppercase">Result</th>
              <th class="pb-2 text-center text-xs font-medium text-gray-500 uppercase">Errors</th>
              <th class="pb-2 text-center text-xs font-medium text-gray-500 uppercase">Warnings</th>
              <th class="pb-2 text-center text-xs font-medium text-gray-500 uppercase">Passed</th>
              <th class="pb-2 text-center text-xs font-medium text-gray-500 uppercase">Changed</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% history_list.each_with_index do |cv, idx| %>
              <%
                prev_cv = history_list[idx + 1]
                if cv.result_digest.present? && prev_cv&.result_digest.present?
                  changed = cv.result_digest != prev_cv.result_digest
                else
                  changed = nil
                end
              %>
              <tr class="hover:bg-gray-50 cursor-pointer"
                  onclick="window.location='<%= project_path(project, view: 'compliance', validation_id: cv.id) %>'">
                <td class="py-2 pr-3 text-gray-600 whitespace-nowrap"><%= cv.validated_at.strftime('%Y-%m-%d %H:%M') %></td>
                <td class="py-2 pr-3 text-gray-600 whitespace-nowrap">
                  <% if cv.compliance_schema %>
                    <%= cv.compliance_schema.name %> v<%= cv.compliance_schema.version %>
                  <% else %>
                    --
                  <% end %>
                </td>
                <td class="py-2 text-center">
                  <% if cv.passed %>
                    <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">Passed</span>
                  <% else %>
                    <span class="inline-flex items-center rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700">Failed</span>
                  <% end %>
                </td>
                <td class="py-2 text-center text-gray-600"><%= cv.errors_count %></td>
                <td class="py-2 text-center text-gray-600"><%= cv.warnings_count %></td>
                <td class="py-2 text-center text-gray-600"><%= cv.valid_checks_count %></td>
                <td class="py-2 text-center text-gray-600">
                  <% if changed.nil? %>
                    <span class="text-gray-400">--</span>
                  <% elsif changed %>
                    <span class="text-amber-600 font-medium">Yes</span>
                  <% else %>
                    <span class="text-gray-400">No</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-sm text-gray-500 text-center py-6">No validation history yet. Run a validation to start recording history.</p>
      <% end %>
    </div>
  </div>
</div>
