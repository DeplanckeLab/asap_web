<!-- SIMPLE TEST -->
<div style="display: flex; flex-direction: row; height: 100vh; width: 100vw; margin: 0; padding: 0;">
  <div style="width: 320px; height: 100vh; background-color: red; border: 2px solid black;">LEFT PANEL</div>
  <div style="flex: 1; height: 100vh; background-color: blue; border: 2px solid black;">MIDDLE PANEL</div>
  <div style="width: 320px; height: 100vh; background-color: green; border: 2px solid black;">RIGHT PANEL</div>
</div>

<div data-controller="visualization" 
     data-visualization-embeddings-by-loom-value="<%= @all_embeddings_by_loom.to_json %>"
     data-visualization-default-loom-file-value="<%= @default_loom_file %>"
     style="display: flex; flex-direction: row; height: 100vh; width: 100vw; margin: 0; padding: 0;">
  
  <!-- Left Panel: Metadata -->
  <div style="width: 320px; height: 100vh; background-color: red; border: 2px solid black;">
    <div style="padding: 20px; color: white; font-weight: bold;">LEFT PANEL CONTENT</div>
    <%# @h_metadata.keys.to_json %>
          <!-- Metadata Panels Container -->
      <div class="flex-1 flex flex-col min-h-0">
        <!-- Categorical Metadata Section -->
        <div id="discrete-panel" class="flex-shrink-0" style="height: 50%;">
          <div class="p-4 h-full flex flex-col">
            <h3 class="text-sm font-medium text-gray-900 mb-3">Categorical Metadata</h3>
            <div class="space-y-2 flex-1 overflow-y-auto">
              <% if @h_metadata[@default_loom_file] %>
              <% @h_metadata[@default_loom_file]['cell']['DISCRETE'].each do |metadata| %>
                <div class="metadata-item border border-gray-200 rounded-lg">
                  <div class="metadata-header flex items-center p-2 hover:bg-gray-50 cursor-pointer" 
                       data-action="click->visualization#toggleMetadata"
                       data-metadata-id="<%= metadata.id %>"
                       data-metadata-value="<%= metadata.id %>">
                    <div class="chevron mr-3 text-gray-400 transition-transform duration-200">
                      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                      </svg>
                    </div>
                     <div class="flex-1">
                       <div class="text-sm font-medium text-gray-900"><%= metadata.display_name %></div>
                       <div class="text-xs text-gray-500"><%= metadata.nber_cats || 0 %> categories</div>
                     </div>
                     <input type="radio" name="color_by" value="<%= metadata.id %>" class="hidden">
                     
                     <!-- Water Drop Button -->
                     <button class="p-1 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded transition-colors duration-200 ml-2" 
                             data-metadata-id="<%= metadata.id %>"
                             data-metadata-type="categorical"
                             onclick="event.stopPropagation()">
                       <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                         <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                       </svg>
                     </button>
                  </div>
                  <div class="metadata-categories hidden pl-8 pb-2">
                    <% if metadata.categories_json.present? %>
                      <% begin %>
                        <% categories = JSON.parse(metadata.categories_json) %>
                        <% if categories.is_a?(Hash) %>
                          <% categories.each do |category, count| %>
                            <div class="flex justify-between items-center py-1 px-2 text-xs">
                              <span class="text-gray-700"><%= category %></span>
                              <span class="text-gray-500 font-medium"><%= count %> cells</span>
                            </div>
                          <% end %>
                        <% elsif categories.is_a?(Array) %>
                          <% categories.each_with_index do |category, index| %>
                            <div class="flex justify-between items-center py-1 px-2 text-xs">
                              <span class="text-gray-700"><%= category %></span>
                              <span class="text-gray-500 font-medium">Category <%= index + 1 %></span>
                            </div>
                          <% end %>
                        <% end %>
                      <% rescue JSON::ParserError %>
                        <div class="text-xs text-gray-500 px-2 py-1">Unable to parse categories</div>
                      <% end %>
                    <% else %>
                      <div class="text-xs text-gray-500 px-2 py-1">No category data available</div>
                    <% end %>
                  </div>
                </div>
              <% end %>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Draggable Divider -->
        <div id="metadata-divider" class="h-1 bg-gray-300 hover:bg-gray-400 cursor-row-resize border-y border-gray-200 relative group">
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-8 h-0.5 bg-gray-400 group-hover:bg-gray-500 rounded"></div>
          </div>
        </div>

        <!-- Continuous Metadata Section -->
        <div id="continuous-panel" class="flex-1 min-h-0">
          <div class="p-4 h-full flex flex-col">
            <h3 class="text-sm font-medium text-gray-900 mb-3">Continuous Metadata</h3>
            <div class="space-y-2 flex-1 overflow-y-auto">
              <% if @h_metadata[@default_loom_file] %>
                <% @h_metadata[@default_loom_file]['cell']['NUMERIC'].each do |metadata| %>
                 <div class="flex items-center p-2 rounded-lg hover:bg-gray-50 cursor-pointer">
                   <label class="flex items-center flex-1 cursor-pointer">
                     <input type="radio" name="color_by" value="<%= metadata.id %>" class="mr-3 text-blue-600">
                     <div class="flex-1">
                       <div class="text-sm font-medium text-gray-900"><%= metadata.display_name %></div>
                       <div class="text-xs text-gray-500">
                         Range: <%= metadata.min_val&.round(2) || 'N/A' %> - <%= metadata.max_val&.round(2) || 'N/A' %>
                       </div>
                     </div>
                   </label>
                   
                   <!-- Water Drop Button -->
                   <button class="p-1 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded transition-colors duration-200 ml-2" 
                           data-metadata-id="<%= metadata.id %>"
                           data-metadata-type="continuous"
                           onclick="event.stopPropagation()">
                     <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                       <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                     </svg>
                   </button>
                 </div>
              <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content: UMAP Plot -->
  <div style="flex: 1; height: 100vh; background-color: blue; border: 2px solid black;">
    <div style="padding: 20px; color: white; font-weight: bold;">MIDDLE PANEL CONTENT</div>
      <div class="flex items-center justify-between px-4 py-2">
        <!-- Left side: Loom file and Embedding Selection -->
        <div class="flex items-center space-x-4">
          <div class="flex items-center space-x-2">
            <select data-visualization-target="loomFileSelect" 
                    data-action="change->visualization#updateEmbeddings"
                    class="text-sm border border-gray-300 rounded px-2 py-1">
              <% @available_loom_files.each do |filepath| %>
                <option value="<%= filepath %>">
                  <%= filepath.split('/').first.capitalize %>
                </option>
              <% end %>
            </select>
          </div>

          <!--
          <div class="flex items-center space-x-2">
           <%# @available_embeddings.to_json %>
            <select data-visualization-target="embeddingSelect" 
                    class="text-sm border border-gray-300 rounded px-2 py-1">
              <option selected>Select embedding...</option>             
              <%# @available_embeddings.each do |embedding| %>
                <option value="<%# embedding.id %>"><%# embedding.display_name %></option>
              <%# end %>
            </select>
          </div>
        </div>
        -->

        <!-- Right side: Actions -->
        <div class="flex items-center space-x-2">
          <!-- Lasso Selection Button -->
          <button id="lasso-button" 
                  class="px-3 py-1 text-sm bg-gray-100 text-gray-700 rounded hover:bg-gray-200 transition-colors duration-200" 
                  data-action="click->visualization#toggleLassoSelection"
                  title="Lasso Selection">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </button>
          
          <!-- Export Button (Icon Only) -->
          <button class="px-3 py-1 text-sm bg-gray-100 text-gray-700 rounded hover:bg-gray-200 transition-colors duration-200" 
                  title="Export">
            <i class="fas fa-download"></i>
          </button>
          
          <!-- Fullscreen Button (Icon Only) -->
          <button class="px-3 py-1 text-sm bg-gray-100 text-gray-700 rounded hover:bg-gray-200 transition-colors duration-200" 
                  title="Fullscreen">
            <i class="fas fa-expand"></i>
          </button>
          
          <!-- Refresh Button (Icon Only) -->
          <button class="px-3 py-1 text-sm bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors duration-200" 
                  title="Refresh">
            <i class="fas fa-sync"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Plot Area -->
    <div class="flex-1 bg-gray-50 p-4">
      <!-- UMAP Plot Container -->
      <div class="w-full h-full bg-white rounded-lg border border-gray-200 flex items-center justify-center">
        <div class="text-center text-gray-500">
          <div class="mb-4">
            <svg class="w-16 h-16 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-medium text-gray-900 mb-2">UMAP Visualization</h3>
          <p class="text-sm text-gray-600">Select metadata from the left panel to color the plot</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Right Panel: Gene Expression -->
  <div style="width: 320px; height: 100vh; background-color: green; border: 2px solid black;">
    <div style="padding: 20px; color: white; font-weight: bold;">RIGHT PANEL CONTENT</div>
      <h2 class="text-lg font-semibold text-gray-900">Gene Expression</h2>
      <p class="text-sm text-gray-600">Search and visualize gene expression</p>
    </div>

    <!-- Gene Search -->
    <div class="p-4 border-b border-gray-200">
      <div class="relative">
        <input type="text" placeholder="Search genes..." 
               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
        <div class="absolute right-3 top-2.5">
          <i class="fas fa-search text-gray-400"></i>
        </div>
      </div>
    </div>

    <!-- Recent Genes -->
    <div class="flex-1 flex flex-col min-h-0">
      <div class="p-4 border-b border-gray-200">
        <h3 class="text-sm font-medium text-gray-900 mb-3">Recent Genes</h3>
        <div class="space-y-2 max-h-48 overflow-y-auto">
          <div class="flex items-center justify-between p-2 rounded-lg hover:bg-gray-50 cursor-pointer">
            <div class="flex-1">
              <div class="text-sm font-medium text-gray-900">CD3D</div>
              <div class="text-xs text-gray-500">T cell marker</div>
            </div>
            <button class="text-blue-600 hover:text-blue-800">
              <i class="fas fa-plus text-sm"></i>
            </button>
          </div>
          
          <div class="flex items-center justify-between p-2 rounded-lg hover:bg-gray-50 cursor-pointer">
            <div class="flex-1">
              <div class="text-sm font-medium text-gray-900">CD8A</div>
              <div class="text-xs text-gray-500">CD8+ T cell marker</div>
            </div>
            <button class="text-blue-600 hover:text-blue-800">
              <i class="fas fa-plus text-sm"></i>
            </button>
          </div>
          
          <div class="flex items-center justify-between p-2 rounded-lg hover:bg-gray-50 cursor-pointer">
            <div class="flex-1">
              <div class="text-sm font-medium text-gray-900">CD4</div>
              <div class="text-xs text-gray-500">CD4+ T cell marker</div>
            </div>
            <button class="text-blue-600 hover:text-blue-800">
              <i class="fas fa-plus text-sm"></i>
            </button>
          </div>
          
          <div class="flex items-center justify-between p-2 rounded-lg hover:bg-gray-50 cursor-pointer">
            <div class="flex-1">
              <div class="text-sm font-medium text-gray-900">FOXP3</div>
              <div class="text-xs text-gray-500">Treg marker</div>
            </div>
            <button class="text-blue-600 hover:text-blue-800">
              <i class="fas fa-plus text-sm"></i>
            </button>
          </div>
          
          <div class="flex items-center justify-between p-2 rounded-lg hover:bg-gray-50 cursor-pointer">
            <div class="flex-1">
              <div class="text-sm font-medium text-gray-900">IL2RA</div>
              <div class="text-xs text-gray-500">IL-2 receptor</div>
            </div>
            <button class="text-blue-600 hover:text-blue-800">
              <i class="fas fa-plus text-sm"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- Selected Genes -->
      <div class="flex-1 p-4">
        <h3 class="text-sm font-medium text-gray-900 mb-3">Selected Genes</h3>
        <div class="space-y-2 max-h-48 overflow-y-auto">
          <div class="flex items-center justify-between p-2 bg-blue-50 rounded-lg">
            <div class="flex-1">
              <div class="text-sm font-medium text-gray-900">CD3D</div>
              <div class="text-xs text-gray-500">Expression: 0.2-4.5</div>
            </div>
            <button class="text-red-600 hover:text-red-800">
              <i class="fas fa-times text-sm"></i>
            </button>
          </div>
          
          <div class="flex items-center justify-between p-2 bg-blue-50 rounded-lg">
            <div class="flex-1">
              <div class="text-sm font-medium text-gray-900">CD8A</div>
              <div class="text-xs text-gray-500">Expression: 0.1-3.2</div>
            </div>
            <button class="text-red-600 hover:text-red-800">
              <i class="fas fa-times text-sm"></i>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Gene Expression Controls -->
    <div class="p-4 border-t border-gray-200">
      <h3 class="text-sm font-medium text-gray-900 mb-3">Expression Options</h3>
      <div class="space-y-3">
        <div>
          <label class="flex items-center">
            <input type="checkbox" checked class="mr-2 text-blue-600">
            <span class="text-sm text-gray-700">Show expression</span>
          </label>
        </div>
        <div>
          <label class="flex items-center">
            <input type="checkbox" class="mr-2 text-blue-600">
            <span class="text-sm text-gray-700">Log scale</span>
          </label>
        </div>
        <div class="pt-2">
          <button class="w-full px-3 py-2 bg-blue-600 text-white text-sm rounded-md hover:bg-blue-700">
            <i class="fas fa-eye mr-2"></i>Visualize Genes
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function toggleMetadata(headerElement) {
  console.log('toggleMetadata called with:', headerElement)
  
  const metadataItem = headerElement.closest('.metadata-item')
  const chevron = headerElement.querySelector('.chevron svg')
  const categoriesDiv = metadataItem.querySelector('.metadata-categories')
  const radioInput = metadataItem.querySelector('input[type="radio"]')
  
  console.log('Elements found:', { 
    metadataItem, 
    chevron, 
    categoriesDiv, 
    radioInput 
  })
  
  if (!chevron || !categoriesDiv || !radioInput) {
    console.error('Required elements not found')
    return
  }
  
  // Toggle the chevron rotation
  if (chevron.style.transform === '' || chevron.style.transform === 'rotate(0deg)') {
    console.log('Expanding metadata')
    chevron.style.transform = 'rotate(90deg)'
    categoriesDiv.classList.remove('hidden')
  } else {
    console.log('Collapsing metadata')
    chevron.style.transform = 'rotate(0deg)'
    categoriesDiv.classList.add('hidden')
  }
  
  // Select this metadata option
  radioInput.checked = true
  
  // Trigger change event to update visualization if needed
  const changeEvent = new Event('change', { bubbles: true })
  radioInput.dispatchEvent(changeEvent)
}

// Draggable divider functionality
document.addEventListener('DOMContentLoaded', function() {
  const divider = document.getElementById('metadata-divider')
  const discretePanel = document.getElementById('discrete-panel')
  const continuousPanel = document.getElementById('continuous-panel')
  const container = discretePanel.parentElement
  
  let isDragging = false
  let startY = 0
  let startHeight = 0
  
  // Minimum heights for panels (in pixels)
  const minPanelHeight = 100
  
  function startDrag(e) {
    isDragging = true
    startY = e.clientY
    startHeight = discretePanel.offsetHeight
    
    // Add visual feedback
    document.body.style.cursor = 'row-resize'
    divider.style.backgroundColor = '#6B7280' // darker gray
    
    // Prevent text selection during drag
    document.body.style.userSelect = 'none'
    
    e.preventDefault()
  }
  
  function doDrag(e) {
    if (!isDragging) return
    
    const deltaY = e.clientY - startY
    const newHeight = startHeight + deltaY
    
    // Calculate container height
    const containerHeight = container.offsetHeight - divider.offsetHeight
    
    // Apply constraints
    const constrainedHeight = Math.max(minPanelHeight, Math.min(newHeight, containerHeight - minPanelHeight))
    
    // Update discrete panel height
    const heightPercentage = (constrainedHeight / containerHeight) * 100
    discretePanel.style.height = heightPercentage + '%'
    
    // Continuous panel will automatically take remaining space due to flex-1
  }
  
  function stopDrag() {
    if (!isDragging) return
    
    isDragging = false
    
    // Remove visual feedback
    document.body.style.cursor = ''
    divider.style.backgroundColor = ''
    document.body.style.userSelect = ''
  }
  
  // Event listeners
  divider.addEventListener('mousedown', startDrag)
  document.addEventListener('mousemove', doDrag)
  document.addEventListener('mouseup', stopDrag)
  
  // Also handle mouse leave to stop dragging if mouse leaves window
  document.addEventListener('mouseleave', stopDrag)
  
  console.log('Draggable divider initialized')
})
</script>
