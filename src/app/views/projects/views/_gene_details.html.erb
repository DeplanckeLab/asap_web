<% if @gene %>
<div class="space-y-3">
  <div class="flex items-center gap-2">
    <span class="text-sm text-gray-500 w-36">Ensembl ID</span>
    <a href="http://www.ensembl.org/Gene/Summary?g=<%= @gene.ensembl_id %>" target="_blank"
       class="text-blue-600 hover:underline font-medium"><%= @gene.ensembl_id %></a>
  </div>
  <div class="flex items-center gap-2">
    <span class="text-sm text-gray-500 w-36">Gene symbol</span>
    <span class="font-semibold text-gray-900"><%= @gene.name %></span>
  </div>
  <% release_feature = @ensembl_release_feature %>
  <% release_feature_name = release_feature.is_a?(Hash) ? release_feature[:feature_name].to_s.strip : '' %>
  <% release_number = release_feature.is_a?(Hash) ? release_feature[:ensembl_release].to_i : 0 %>
  <% if release_feature_name.present? && release_number.positive? %>
    <div class="flex items-start gap-2">
      <span class="text-sm text-gray-500 w-36 flex-shrink-0">
        Gene symbol
        <span class="block text-xs text-gray-400 font-normal">in release <%= release_number %></span>
      </span>
      <div>
        <span class="font-semibold text-gray-900"><%= release_feature_name %></span>
        <% if release_feature[:ensembl_assembly].present? %>
          <div class="text-xs text-gray-500 mt-0.5"><%= release_feature[:ensembl_assembly] %></div>
        <% end %>
      </div>
    </div>
  <% end %>
  <% if @gene.respond_to?(:description) && @gene.description.present? %>
    <div class="flex items-start gap-2">
      <span class="text-sm text-gray-500 w-36 flex-shrink-0">Description</span>
      <span class="text-gray-800"><%= @gene.description %></span>
    </div>
  <% end %>
  <% if @gene.respond_to?(:biotype) && @gene.biotype.present? %>
    <div class="flex items-center gap-2">
      <span class="text-sm text-gray-500 w-36">Biotype</span>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800"><%= @gene.biotype %></span>
    </div>
  <% end %>
  <% if @gene.respond_to?(:function_description) && @gene.function_description.present? %>
    <div class="flex items-start gap-2">
      <span class="text-sm text-gray-500 w-36 flex-shrink-0">Function</span>
      <span class="text-gray-800"><%= @gene.function_description %></span>
    </div>
  <% end %>
  <% if @gene.respond_to?(:alt_names) && @gene.alt_names.present? %>
    <div class="flex items-start gap-2">
      <span class="text-sm text-gray-500 w-36 flex-shrink-0">Alt names</span>
      <div class="flex flex-wrap gap-1">
        <% @gene.alt_names.split(",").each do |name| %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700"><%= name.strip %></span>
        <% end %>
      </div>
    </div>
  <% end %>
  <% if @gene.respond_to?(:obsolete_alt_names) && @gene.obsolete_alt_names.present? %>
    <div class="flex items-start gap-2">
      <span class="text-sm text-gray-500 w-36 flex-shrink-0">Obsolete names</span>
      <div class="flex flex-wrap gap-1">
        <% @gene.obsolete_alt_names.split(",").each do |name| %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-50 text-gray-500"><%= name.strip %></span>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if defined?(@gene_set_collection_memberships) && !@gene_set_collection_memberships.nil? %>
    <%= render partial: 'projects/views/gene_details_memberships' %>
  <% else %>
    <div data-gene-details-memberships-root="true"
         data-gene-id="<%= @gene.id %>"
         data-memberships-url="<%= search_gene_memberships_project_path(@project) %>">
      <div class="pt-2 border-t border-gray-200">
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-500">Gene set collections</span>
          <span class="text-xs text-gray-500">Loading...</span>
        </div>
        <div class="mt-2 text-sm text-gray-500">Loading gene set collections...</div>
      </div>
    </div>
  <% end %>
</div>
<% else %>
<div class="text-gray-500 text-sm">Gene not found.</div>
<% end %>
