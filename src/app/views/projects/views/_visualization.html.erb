  <!-- Right Resizer -->
  <div id="right-resizer" style="width: 4px; height: 100%; background-color: #e5e7eb; cursor: col-resize; transition: background-color 0.2s;"
       onmouseover="this.style.backgroundColor='#3b82f6'"
       onmouseout="this.style.backgroundColor='#e5e7eb'"></div>

  <!-- Right Panel: Split into Gene Expression and Selections -->
  <div id="right-panel" data-guided-tour="visualization-right-panel" style="width: 320px; height: 100%; display: flex; flex-direction: column; overflow: hidden; min-height: 0;">
    
    <!-- Top Section: Gene Expression Panel -->
    <div id="gene-expression-panel" data-guided-tour="visualization-gene-expression-panel" style="flex: 1; background-color: white; border-left: 1px solid #e5e7eb; display: flex; flex-direction: column; min-height: 0; overflow: hidden;">
      <div style="padding: 20px; border-bottom: 1px solid #e5e7eb; display: flex; flex-direction: column; gap: 10px;">
        <div style="display:flex;align-items:center;gap:8px;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <h2 style="margin: 0; font-size: 18px; font-weight: 600;"><%= row_label(@project).to_s.pluralize.capitalize %></h2>
            <span id="gene-count-badge" style="display: inline-flex; align-items: center; padding: 4px 8px; background-color: #e5e7eb; color: #374151; border-radius: 12px; font-size: 12px; font-weight: 500;">-</span>
            <button type="button"
                    id="gene-list-revert-btn"
                    style="display: none; align-items: center; justify-content: center; width: 22px; height: 22px; padding: 0; background: white; color: #6b7280; border: 1px solid #d1d5db; border-radius: 4px; cursor: pointer; flex-shrink: 0;"
                    title="Previous gene list"
                    aria-label="Previous gene list"
                    onmouseover="this.style.backgroundColor='#f3f4f6'; this.style.color='#374151'"
                    onmouseout="this.style.backgroundColor='white'; this.style.color='#6b7280'">
              <i class="fas fa-rotate-left" style="font-size: 10px;" aria-hidden="true"></i>
            </button>
            <div style="position: relative; flex-shrink: 0;">
              <button type="button"
                      id="gene-list-history-btn"
                      style="display: none; align-items: center; justify-content: center; width: 22px; height: 22px; padding: 0; background: white; color: #6b7280; border: 1px solid #d1d5db; border-radius: 4px; cursor: pointer;"
                      title="Gene list history"
                      aria-label="Gene list history"
                      onmouseover="this.style.backgroundColor='#f3f4f6'; this.style.color='#374151'"
                      onmouseout="this.style.backgroundColor='white'; this.style.color='#6b7280'">
                <i class="fas fa-history" style="font-size: 10px;" aria-hidden="true"></i>
              </button>
              <div id="gene-list-history-menu"
                   style="display: none; position: absolute; top: 26px; left: 0; min-width: 200px; max-width: 320px; max-height: 260px; overflow-y: auto; background: white; border: 1px solid #d1d5db; border-radius: 6px; box-shadow: 0 6px 12px rgba(0,0,0,0.1); z-index: 3000;"></div>
            </div>
          </div>
          <button type="button"
                  class="viz-panel-header-icon-btn"
                  data-action="click->visualization#foldAllPanelItems"
                  data-panel-kind="gene-expression"
                  style="margin-left: auto;"
                  onmouseover="this.style.backgroundColor='#f3f4f6'; this.style.borderColor='#9ca3af'; this.style.color='#374151';"
                  onmouseout="this.style.backgroundColor='#f9fafb'; this.style.borderColor='#d1d5db'; this.style.color='#6b7280';"
                  title="Fold All"
                  aria-label="Fold All">
            <i class="fas fa-angles-up" style="font-size: 12px;"></i>
          </button>
          <button type="button"
                  class="viz-panel-header-icon-btn viz-mobile-panel-close-btn"
                  data-action="click->visualization#closeMobilePanel"
                  onmouseover="this.style.backgroundColor='#f3f4f6'; this.style.borderColor='#9ca3af'; this.style.color='#374151';"
                  onmouseout="this.style.backgroundColor='#f9fafb'; this.style.borderColor='#d1d5db'; this.style.color='#6b7280';"
                  title="Close panel"
                  aria-label="Close panel">
            <i class="fas fa-times" style="font-size: 12px;" aria-hidden="true"></i>
          </button>
        </div>
        <!-- Gene Tags Container with Input -->
        <div style="position: relative;">
          <div id="gene-tags-container" data-guided-tour="visualization-gene-search" style="display:flex;flex-wrap:wrap;gap:6px;padding:6px 8px;min-height:34px;border:1px solid #d1d5db;border-radius:6px;background-color:#fff;align-items:center;transition:border-color 0.2s;cursor:text;"
               onclick="document.getElementById('gene-autocomplete-input').focus()">
            <input 
              type="text" 
              id="gene-autocomplete-input" 
              placeholder="Type or paste gene names (comma, space, or Enter to add)..."
              style="flex:1;min-width:120px;padding:0;border:none;border-radius:0;font-size:12px;color:#111827;outline:none;background:transparent;"
              onfocus="document.getElementById('gene-tags-container').style.borderColor='#3b82f6'"
              onblur="document.getElementById('gene-tags-container').style.borderColor='#d1d5db'"
            />
          </div>
          <div id="gene-autocomplete-dropdown" style="display: none; position: absolute; top: 100%; left: 0; right: 0; background: white; border: 1px solid #d1d5db; border-top: none; border-radius: 0 0 6px 6px; max-height: 300px; overflow-y: auto; z-index: 1000; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-top: -1px;"></div>
        </div>
        <!-- Gene Input Status Message -->
        <div id="gene-input-status" style="display: none; margin-top: 8px; padding: 8px 12px; background-color: #f0f9ff; border: 1px solid #bae6fd; border-radius: 6px; font-size: 13px;">
          <div id="gene-input-status-text" style="color: #0369a1;"></div>
        </div>
        <!-- Matrix/Layer Selection Dropdown -->
        <% matrices = (@expression_matrices_by_loom[@default_loom_file] || []).sort_by(&:name) %>
        <% base_matrix = matrices.find { |annot| annot.name == '/matrix' } %>
        <% latest_matrix = matrices.max_by(&:id) %>
        <% default_matrix = latest_matrix || base_matrix %>
        <% default_layer = default_matrix&.name || '/matrix' %>
        <% default_annot_id = default_matrix&.id ? default_matrix.id.to_s : '' %>
        <% default_label = (default_matrix&.label.presence || default_matrix&.display_name || default_matrix&.name || '/matrix') %>
        <% default_run_id = default_matrix&.run_id ? default_matrix.run_id.to_s : '' %>
        <div style="margin-top: -6px; display:flex; align-items:center; justify-content:space-between; gap:8px; font-size: 11px; color: #6b7280;">
          <div style="display:flex; align-items:center; gap:6px; position:relative; min-width:0;">
            <span>Values from</span>
            <a href="#"
             id="matrix-selection-link"
             data-guided-tour="visualization-matrix-layer-picker"
             data-layer="<%= default_layer %>"
             data-annot-id="<%= default_annot_id %>"
             data-run-id="<%= default_run_id %>"
             style="font-weight: 600; color: #2563eb; text-decoration: none; cursor: pointer;"
             onclick="(function(event){
               event.preventDefault();
               event.stopPropagation();
               const menu = document.getElementById('matrix-selection-menu');
               if (!menu) return;
               const isVisible = menu.style.display === 'block';
               if (isVisible) {
                 menu.style.display = 'none';
                 if (window.__matrixOutsideHandler) {
                   document.removeEventListener('click', window.__matrixOutsideHandler);
                   window.__matrixOutsideHandler = null;
                 }
               } else {
                 menu.style.display = 'block';
                 window.__matrixOutsideHandler = function(evt) {
                   if (!menu.contains(evt.target) && evt.target !== event.currentTarget) {
                     menu.style.display = 'none';
                     document.removeEventListener('click', window.__matrixOutsideHandler);
                     window.__matrixOutsideHandler = null;
                   }
                 };
                 document.addEventListener('click', window.__matrixOutsideHandler);
               }
             })(event)">
              <%= default_label %>
            </a>
            <div id="matrix-selection-menu" style="display: none; position: absolute; top: 18px; left: 78px; background: white; border: 1px solid #d1d5db; border-radius: 6px; box-shadow: 0 6px 12px rgba(0,0,0,0.1); z-index: 2000; min-width: 200px;">
              <div style="max-height: 220px; overflow-y: auto;">
              <div data-value="/matrix" data-annot-id="<%= base_matrix&.id %>" data-run-id="<%= base_matrix&.run_id %>" data-label="/matrix" data-selected="<%= default_layer == '/matrix' %>" style="padding: 8px 12px; cursor: pointer; font-size: 12px; color: #374151; border-bottom: 1px solid #f3f4f6; <%= default_layer == '/matrix' ? 'background-color: #eff6ff; font-weight: 600;' : '' %>"
                   onmouseover="this.dataset.selected !== 'true' && (this.style.backgroundColor='#f3f4f6')"
                   onmouseout="this.dataset.selected !== 'true' ? this.style.backgroundColor='' : this.style.backgroundColor='#eff6ff'"
                   onclick="(function(item){
                     document.querySelectorAll('#matrix-selection-menu div[data-value]').forEach(function(el){
                       el.dataset.selected = 'false';
                       el.style.backgroundColor = '';
                       el.style.fontWeight = '';
                     });
                     item.dataset.selected = 'true';
                     item.style.backgroundColor = '#eff6ff';
                     item.style.fontWeight = '600';
                     const menu = document.getElementById('matrix-selection-menu');
                     if (menu) menu.style.display = 'none';
                     if (window.__matrixOutsideHandler) {
                       document.removeEventListener('click', window.__matrixOutsideHandler);
                       window.__matrixOutsideHandler = null;
                     }
                     const link = document.getElementById('matrix-selection-link');
                     if (link) {
                       link.textContent = item.dataset.label;
                       link.dataset.layer = item.dataset.value;
                       link.dataset.annotId = item.dataset.annotId || '';
                       link.dataset.runId = item.dataset.runId || '';
                     }
                     const annotId = item.dataset.annotId || null;
                     const geneMgr = (window.visualizationController && window.visualizationController.geneManager) || window.geneManager;
                     if (geneMgr && typeof geneMgr.onMatrixLayerChange === 'function') {
                       geneMgr.onMatrixLayerChange(item.dataset.value, annotId);
                     }
                   })(this)">
                /matrix
              </div>
              <% matrices.each do |matrix| %>
                <% next if matrix.name == '/matrix' %>
                <% label = matrix.label.presence || matrix.display_name || matrix.name %>
                <% selected = default_layer == matrix.name %>
                <div data-value="<%= matrix.name %>" data-annot-id="<%= matrix.id %>" data-run-id="<%= matrix.run_id %>" data-label="<%= label %>" data-selected="<%= selected %>" style="padding: 8px 12px; cursor: pointer; font-size: 12px; color: #374151; border-bottom: 1px solid #f3f4f6; <%= selected ? 'background-color: #eff6ff; font-weight: 600;' : '' %>"
                     onmouseover="this.dataset.selected !== 'true' && (this.style.backgroundColor='#f3f4f6')"
                     onmouseout="this.dataset.selected !== 'true' ? this.style.backgroundColor='' : this.style.backgroundColor='#eff6ff'"
                     onclick="(function(item){
                       document.querySelectorAll('#matrix-selection-menu div[data-value]').forEach(function(el){
                         el.dataset.selected = 'false';
                         el.style.backgroundColor = '';
                         el.style.fontWeight = '';
                       });
                       item.dataset.selected = 'true';
                       item.style.backgroundColor = '#eff6ff';
                       item.style.fontWeight = '600';
                       const menu = document.getElementById('matrix-selection-menu');
                       if (menu) menu.style.display = 'none';
                       if (window.__matrixOutsideHandler) {
                         document.removeEventListener('click', window.__matrixOutsideHandler);
                         window.__matrixOutsideHandler = null;
                       }
                       const link = document.getElementById('matrix-selection-link');
                       if (link) {
                         link.textContent = item.dataset.label;
                         link.dataset.layer = item.dataset.value;
                         link.dataset.annotId = item.dataset.annotId || '';
                         link.dataset.runId = item.dataset.runId || '';
                       }
                       const annotId = item.dataset.annotId || null;
                       const geneMgr = (window.visualizationController && window.visualizationController.geneManager) || window.geneManager;
                       if (geneMgr && typeof geneMgr.onMatrixLayerChange === 'function') {
                         geneMgr.onMatrixLayerChange(item.dataset.value, annotId);
                       }
                     })(this)">
                  <%= label %>
                  <span style="color: #9ca3af; font-size: 11px; margin-left: 4px;"><%= matrix.name %></span>
                </div>
              <% end %>
              </div>
            </div>
          </div>
          <div style="display:flex;justify-content:flex-end;align-items:center;gap:8px;flex-shrink:0;">
            <button id="gene-set-overlap-btn"
                    type="button"
                    style="display:none;align-items:center;justify-content:center;width:28px;height:28px;padding:0;background-color:#0f766e;color:white;border:none;border-radius:6px;cursor:pointer;transition:background-color 0.2s;"
                    onmouseover="this.style.backgroundColor='#0d9488'"
                    onmouseout="this.style.backgroundColor='#0f766e'"
                    title="Find gene sets overlapping selected genes"
                    aria-label="Find gene sets overlapping selected genes">
              <i class="fas fa-chart-pie" style="font-size:12px;" aria-hidden="true"></i>
            </button>
            <button id="add-gene-set-btn" data-gene-set-add-trigger="true" style="display:none;align-items:center;justify-content:center;width:28px;height:28px;padding:0;background-color:#2563eb;color:white;border:none;border-radius:6px;cursor:pointer;transition:background-color 0.2s;" 
                    onmouseover="this.style.backgroundColor='#1d4ed8'" 
                    onmouseout="this.style.backgroundColor='#2563eb'"
                    title="Add gene set">
              <i class="fas fa-plus" style="font-size:12px;"></i>
            </button>
            <button id="clear-genes-btn"
                    type="button"
                    style="display:none;align-items:center;justify-content:center;width:28px;height:28px;padding:0;background-color:#dc2626;color:white;border:none;border-radius:6px;cursor:pointer;"
                    title="Clear all genes"
                    aria-label="Clear all genes"
                    onmouseover="this.style.backgroundColor='#b91c1c'"
                    onmouseout="this.style.backgroundColor='#dc2626'">
              <i class="fas fa-trash" style="font-size:12px;"></i>
            </button>
          </div>
        </div>
        <script>
          document.addEventListener('DOMContentLoaded', function() {
            const link = document.getElementById('matrix-selection-link')
            if (!link) return
            const defaultLayer = link.dataset.layer || link.textContent?.trim() || '/matrix'
            const defaultAnnotId = link.dataset.annotId ? String(link.dataset.annotId) : null
            const geneMgr = (window.visualizationController && window.visualizationController.geneManager) || window.geneManager
            if (geneMgr) {
              geneMgr.currentMatrixLayer = defaultLayer
              geneMgr.currentMatrixAnnotId = defaultAnnotId
              geneMgr.matrixInitialized = true
            }
          })
        </script>
