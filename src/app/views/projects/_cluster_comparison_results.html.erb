<% if @res.present? && @list_cats.present? && @vals.present? %>

<div class="overflow-x-auto">
  <table id="cluster_comparison_table" class="min-w-full divide-y divide-gray-200 text-sm">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">A \ B</th>
        <% @list_cats[1].each_index do |i| %>
          <% if @vals[1][@list_cats[1][i]] %>
            <th class="px-3 py-2 text-left text-xs font-medium text-gray-500">
              <%= @h_runs[params['run_id1']]&.num %>.<%= @list_cats[1][i] %>
              <span class="ml-1 inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600">
                <% n = @vals[1][@list_cats[1][i]].size %><%= n %> cell<%= n > 1 ? 's' : '' %>
              </span>
            </th>
          <% end %>
        <% end %>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% @list_cats[0].each_index do |i| %>
        <% if @vals[0][@list_cats[0][i]] %>
          <tr>
            <td class="px-3 py-2 font-medium text-gray-900">
              <%= @h_runs[params['run_id2']]&.num %>.<%= @list_cats[0][i] %>
              <span class="ml-1 inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600">
                <% n = @vals[0][@list_cats[0][i]].size %><%= n %> cell<%= n > 1 ? 's' : '' %>
              </span>
            </td>
            <% @list_cats[1].each_index do |j| %>
              <% if @vals[1][@list_cats[1][j]] %>
                <% nb = @res[i] && @res[i][j] ? @res[i][j].size : 0 %>
                <td class="px-3 py-2">
                  <span id="cell-group_<%= i %>_<%= j %>"
                        class="cell-group cursor-pointer inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= nb > 0 ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-500' %>">
                    <%= nb %>
                  </span>
                </td>
              <% end %>
            <% end %>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>

<div id="popup_window" style="display:none; position:absolute; z-index:50;" class="bg-white border border-gray-300 rounded-lg shadow-lg p-4 max-h-64 overflow-y-auto">
  <div class="flex justify-between items-center mb-2">
    <span class="text-sm font-medium text-gray-700">Cells</span>
    <button onclick="document.getElementById('popup_window').style.display='none'" class="text-gray-400 hover:text-gray-600 text-sm">close</button>
  </div>
  <div id="popup_container" class="flex flex-wrap gap-1"></div>
</div>

<script>
(function() {
  var res = <%= raw @res.to_json %>;

  document.querySelectorAll('.cell-group').forEach(function(el) {
    el.addEventListener('click', function(e) {
      var t = this.id.split('_');
      var i = t[1];
      var j = t[2];
      var text = '';

      if (res[i] && res[i][j]) {
        for (var k = 0; k < res[i][j].length; k++) {
          text += "<span class='inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 mr-1 mb-1'>" + res[i][j][k] + "</span> ";
        }
      }

      document.getElementById('popup_container').innerHTML = text;
      var popup = document.getElementById('popup_window');
      popup.style.left = '200px';
      popup.style.width = (window.innerWidth - 250) + 'px';
      popup.style.top = (e.pageY + 10) + 'px';
      popup.style.display = 'block';
    });
  });

  if (typeof jQuery !== 'undefined' && jQuery.fn.DataTable) {
    jQuery('#cluster_comparison_table').DataTable();
  }
})();
</script>

<% elsif @list_cats.present? && @vals.present? %>
  <div class="text-gray-500 text-sm py-3">
    No comparable clusters found for the selected runs.
  </div>
<% end %>
