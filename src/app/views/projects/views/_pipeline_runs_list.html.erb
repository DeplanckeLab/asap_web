<% if @runs && @runs.any? %>
  <div class="space-y-3">
    <% @runs.each do |run| %>
      <% run_status = run_status_badge_for(run, @h_statuses) %>
      <% step = @h_steps[run.step_id] if defined?(@h_steps) %>
      <% std_method = (@h_std_methods && run.std_method_id) ? @h_std_methods[run.std_method_id] : nil %>
      <% h_method_attrs = (std_method && step) ? (Basic.get_std_method_attrs(std_method, step)[:h_attrs] rescue Basic.safe_parse_json(std_method.attrs_json, {})) : {} %>
      <% run_title = run_card_title(run, step, std_method) %>
      
      <%# Parse run attributes for parameters %>
      <% h_run_attrs = run.attrs_json.present? ? Basic.safe_parse_json(run.attrs_json, {}) : {} %>
      <% params_array = h_run_attrs.to_a %>
      
      <div class="border rounded-lg p-3 transition-colors cursor-pointer <%= run.id == @immediate_parent_run_id ? 'border-blue-500 bg-blue-50 hover:bg-blue-100' : 'border-gray-200 hover:bg-gray-50' %>"
           onclick="event.preventDefault(); window.location.href = '<%= run_view_url(run, @project, step) %>'; return false;"
           title="Click to view run details">
        <div class="flex items-center justify-between mb-2">
          <div class="flex-1">
            <div class="font-semibold text-gray-900 flex items-center gap-1 flex-wrap">
              <%= run_title %>
              <%= publication_visibility_badge(@project, run, full_read_access: !publication_snapshot_reader?(@project)) %>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="flex flex-col items-end gap-1">
              <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium <%= run_status[:bg] %> <%= run_status[:text] %>">
                <%= run_status[:ui_label] %>
              </span>
              <% if [1, 6].include?(run.status_id) && run.slurm_job_id.present? %>
                <div class="text-xs text-gray-500"
                     data-controller="queue-position"
                     data-queue-position-run-id-value="<%= run.id %>"
                     data-queue-position-slurm-job-id-value="<%= run.slurm_job_id %>"
                     data-queue-position-project-id-value="<%= @project.key %>"
                     <% if run.submitted_at %>
                       data-queue-position-submitted-at-value="<%= run.submitted_at.iso8601 %>"
                     <% end %>>
                  <span data-queue-position-target="queueLine">
                    <span data-slurm-queue-position-label class="text-gray-400">Slurm queue position:</span>
                    <span data-queue-position-target="position" class="font-mono text-xs ml-0.5 inline-block">
                      <i class="fas fa-spinner fa-spin"></i>
                    </span>
                  </span>
                </div>
              <% end %>
            </div>
            <% if run.created_at %>
              <span class="text-xs text-gray-500"><%= run.created_at.strftime("%Y-%m-%d %H:%M") %></span>
            <% end %>
          </div>
        </div>
        
        <%# Parameters section - same style as std_step %>
        <% if params_array.any? %>
          <div class="mt-2">
            <%= raw display_run_attrs(
              run,
              h_run_attrs,
              { run.std_method_id => h_method_attrs },
              {
                h_annots: (defined?(@h_annots_for_params) ? @h_annots_for_params : {}),
                h_runs: (defined?(@h_ori_runs_for_params) ? @h_ori_runs_for_params : {}),
                h_steps: (defined?(@h_steps_for_params) ? @h_steps_for_params : (defined?(@h_steps) ? @h_steps : {}))
              }
            ) %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center text-gray-500 py-8">
    <p>No runs found in this pipeline.</p>
  </div>
<% end %>

