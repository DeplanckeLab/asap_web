<script>
(function initDashboardJS() {
const makeDraggable = (el, handleId) => {
const handle = document.getElementById(handleId); if (!handle) return;
let x = 0, y = 0, nx = 0, ny = 0; handle.onmousedown = (e) => {
e.preventDefault(); nx = e.clientX; ny = e.clientY;
document.onmouseup = () => { document.onmouseup = null; document.onmousemove = null; };
document.onmousemove = (e) => { x = nx - e.clientX; y = ny - e.clientY; nx = e.clientX; ny = e.clientY; el.style.top = (el.offsetTop - y) + "px"; el.style.left = (el.offsetLeft - x) + "px"; };
};
};
const titleEditor = document.getElementById('project-title-editor');
if (titleEditor) {
const editBtn = document.getElementById('project-title-edit-button'); const text = document.getElementById('project-title-text'); const controls = document.getElementById('project-title-edit-controls'); const input = document.getElementById('project-title-input'); const saveBtn = document.getElementById('project-title-save-button');
editBtn?.addEventListener('click', () => { [text, editBtn].forEach(el => el.classList.add('hidden')); controls.classList.remove('hidden'); input.focus(); });
saveBtn?.addEventListener('click', async () => {
const val = input.value.trim(); const csrf = document.querySelector('meta[name="csrf-token"]')?.content;
const res = await fetch(titleEditor.dataset.updateUrl, { method: 'PATCH', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf }, body: JSON.stringify({ project: { name: val } }) });
if (res.ok) { text.textContent = val; controls.classList.add('hidden'); [text, editBtn].forEach(el => el.classList.remove('hidden')); }
});
}
const detailsPop = document.getElementById('summary-visual-details-popover');
document.querySelectorAll('[data-summary-detail-trigger]').forEach(t => {
t.addEventListener('click', (e) => {
e.stopPropagation(); const type = t.dataset.summaryDetailType;
document.getElementById('summary-visual-details-title').textContent = type.toUpperCase();
detailsPop.querySelectorAll('[data-summary-detail-section]').forEach(s => s.classList.add('hidden'));
detailsPop.querySelector(`[data-summary-detail-section="${type}"]`).classList.remove('hidden');
detailsPop.classList.remove('hidden'); detailsPop.style.top = '15%'; detailsPop.style.left = '20%';
});
});
document.getElementById('summary-visual-details-close-button')?.addEventListener('click', () => detailsPop.classList.add('hidden'));
makeDraggable(detailsPop, 'summary-visual-details-header');
const lineageBtn = document.getElementById('summary-lineage-toggle-button'); const lineagePop = document.getElementById('summary-lineage-popover');
lineageBtn?.addEventListener('click', (e) => { e.stopPropagation(); lineagePop?.classList.remove('hidden'); });
const cardLink = document.querySelector('[data-summary-visualization-card-link]');
cardLink?.addEventListener('click', () => window.location = cardLink.dataset.url);
})();
</script>

<% if can_edit_project_title %>
  <script>
    (function initializeProjectTitleEditor() {
      const editor = document.getElementById('project-title-editor')
      if (!editor || editor.dataset.initialized === 'true') return
      editor.dataset.initialized = 'true'

      const titleText = document.getElementById('project-title-text')
      const editButton = document.getElementById('project-title-edit-button')
      const editControls = document.getElementById('project-title-edit-controls')
      const input = document.getElementById('project-title-input')
      const saveButton = document.getElementById('project-title-save-button')
      const cancelButton = document.getElementById('project-title-cancel-button')
      if (!titleText || !editButton || !editControls || !input || !saveButton || !cancelButton) return

      let currentTitle = editor.dataset.projectTitle || titleText.textContent.trim()
      const updateUrl = editor.dataset.updateUrl

      const showEditMode = () => {
        titleText.classList.add('hidden')
        editButton.classList.add('hidden')
        editControls.classList.remove('hidden')
        input.value = currentTitle
        input.focus()
        input.select()
      }

      const showReadMode = () => {
        editControls.classList.add('hidden')
        titleText.classList.remove('hidden')
        editButton.classList.remove('hidden')
      }

      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content')

      const saveTitle = async () => {
        const nextTitle = input.value.trim()
        if (!nextTitle) {
          alert('Project title cannot be empty.')
          return
        }
        if (nextTitle === currentTitle) {
          showReadMode()
          return
        }

        saveButton.disabled = true
        try {
          const response = await fetch(updateUrl, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-CSRF-Token': csrfToken
            },
            body: JSON.stringify({ project: { name: nextTitle } })
          })

          if (!response.ok) {
            let message = 'Failed to update project title.'
            try {
              const payload = await response.json()
              if (payload && payload.error) message = payload.error
            } catch (_error) {}
            throw new Error(message)
          }

          currentTitle = nextTitle
          editor.dataset.projectTitle = nextTitle
          titleText.textContent = nextTitle
          document.title = `${nextTitle} - ASAP`
          showReadMode()
        } catch (error) {
          alert(error.message || 'Failed to update project title.')
        } finally {
          saveButton.disabled = false
        }
      }

      editButton.addEventListener('click', showEditMode)
      cancelButton.addEventListener('click', showReadMode)
      saveButton.addEventListener('click', saveTitle)
      input.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          event.preventDefault()
          saveTitle()
        }
        if (event.key === 'Escape') {
          event.preventDefault()
          showReadMode()
        }
      })
    })()
  </script>
<% end %>

<% if summary_clone_lineage_projects.any? %>
  <script>
    (function initializeSummaryLineagePanel() {
      const toggleButton = document.getElementById('summary-lineage-toggle-button')
      const lineagePopover = document.getElementById('summary-lineage-popover')
      const closeButton = document.getElementById('summary-lineage-close-button')
      const header = document.getElementById('summary-lineage-header')
      if (!toggleButton || !lineagePopover || !closeButton || !header || toggleButton.dataset.initialized === 'true') return
      toggleButton.dataset.initialized = 'true'
      let wasDragged = false
      let isDragging = false

      const closePopover = () => {
        lineagePopover.classList.add('hidden')
        toggleButton.setAttribute('aria-expanded', 'false')
      }

      const positionPopover = () => {
        const rect = toggleButton.getBoundingClientRect()
        const popoverWidth = Math.min(window.innerWidth * 0.95, 896)
        const left = Math.max(8, Math.min(rect.left, window.innerWidth - popoverWidth - 8))
        const top = rect.bottom + 8
        lineagePopover.style.left = `${left}px`
        lineagePopover.style.top = `${top}px`
      }

      const startDrag = (event) => {
        if (event.button !== 0) return
        if (closeButton.contains(event.target)) return
        event.preventDefault()
        event.stopPropagation()
        const rect = lineagePopover.getBoundingClientRect()
        const offsetX = event.clientX - rect.left
        const offsetY = event.clientY - rect.top
        isDragging = true

        const onMove = (moveEvent) => {
          if (!isDragging) return
          wasDragged = true
          const maxLeft = Math.max(8, window.innerWidth - rect.width - 8)
          const maxTop = Math.max(8, window.innerHeight - rect.height - 8)
          const left = Math.max(8, Math.min(moveEvent.clientX - offsetX, maxLeft))
          const top = Math.max(8, Math.min(moveEvent.clientY - offsetY, maxTop))
          lineagePopover.style.left = `${left}px`
          lineagePopover.style.top = `${top}px`
        }

        const endDrag = () => {
          isDragging = false
          document.removeEventListener('mousemove', onMove)
          document.removeEventListener('mouseup', endDrag)
        }

        document.addEventListener('mousemove', onMove)
        document.addEventListener('mouseup', endDrag)
      }

      toggleButton.addEventListener('click', (event) => {
        event.stopPropagation()
        if (lineagePopover.classList.contains('hidden')) {
          wasDragged = false
          positionPopover()
          lineagePopover.classList.remove('hidden')
          toggleButton.setAttribute('aria-expanded', 'true')
          return
        }
        closePopover()
      })

      closeButton.addEventListener('click', (event) => {
        event.stopPropagation()
        closePopover()
      })

      document.addEventListener('click', (event) => {
        if (lineagePopover.classList.contains('hidden')) return
        if (lineagePopover.contains(event.target) || toggleButton.contains(event.target)) return
        closePopover()
      })

      header.addEventListener('mousedown', startDrag)

      window.addEventListener('resize', () => {
        if (lineagePopover.classList.contains('hidden') || wasDragged) return
        positionPopover()
      })

      window.addEventListener('scroll', () => {
        if (lineagePopover.classList.contains('hidden') || wasDragged) return
        positionPopover()
      }, { passive: true })

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !lineagePopover.classList.contains('hidden')) closePopover()
      })

      if (!lineagePopover.classList.contains('hidden')) {
        positionPopover()
        toggleButton.setAttribute('aria-expanded', 'true')
      }
    })()
  </script>
<% end %>

<script>
  (function initializeSummaryLoomDownloadsModal() {
    const openButton = document.getElementById('summary-loom-downloads-open-button')
    const overlay = document.getElementById('summary-loom-downloads-overlay')
    const panel = document.getElementById('summary-loom-downloads-panel')
    const body = document.getElementById('summary-loom-downloads-body')
    const closeButton = document.getElementById('summary-loom-downloads-close-button')
    if (!openButton || !overlay || !panel || !body || !closeButton || openButton.dataset.initialized === 'true') return
    openButton.dataset.initialized = 'true'

    const escapeHtml = (value) => String(value == null ? '' : value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')

    const closeModal = () => {
      overlay.classList.add('hidden')
      openButton.setAttribute('aria-expanded', 'false')
    }

    const openModal = () => {
      overlay.classList.remove('hidden')
      openButton.setAttribute('aria-expanded', 'true')
    }

    const renderRows = (items) => {
      if (!Array.isArray(items) || items.length === 0) {
        body.innerHTML = '<p class="text-gray-500 italic">No Loom files listed.</p>'
        return
      }
      const rows = items.map((item) => {
        const loomLabel = escapeHtml(item.run_name || item.name || 'Loom file')
        const sub = item.file_size ? `<span class="block text-xs text-gray-500 mt-0.5">${escapeHtml(item.file_size)}</span>` : ''
        const attrs = item.run_attrs ? `<div class="mt-1">${item.run_attrs}</div>` : ''
        return `<tr class="border-b border-gray-100 align-top">
          <td class="py-2 pr-3"><a href="${escapeHtml(item.url)}" target="_blank" rel="noopener noreferrer" class="text-blue-700 hover:text-blue-900 hover:underline font-medium">${loomLabel}</a>${sub}</td>
          <td class="py-2 pr-3"><a href="${escapeHtml(item.url_h5ad)}" target="_blank" rel="noopener noreferrer" class="text-blue-700 hover:text-blue-900 hover:underline font-medium">H5AD export</a></td>
          <td class="py-2 text-gray-600">${attrs}</td>
        </tr>`
      }).join('')
      body.innerHTML = `<div class="overflow-x-auto"><table class="min-w-full text-left"><thead><tr class="border-b border-gray-200 text-xs font-medium text-gray-500 uppercase tracking-wide">
        <th class="pb-2 pr-3">Loom file</th>
        <th class="pb-2 pr-3">H5AD file</th>
        <th class="pb-2">Run attributes</th>
      </tr></thead><tbody>${rows}</tbody></table></div>`
    }

    const loadAndShow = async () => {
      const url = openButton.dataset.summaryLoomJsonUrl
      if (!url) {
        body.innerHTML = '<p class="text-red-600">Missing data URL.</p>'
        openModal()
        return
      }
      body.innerHTML = '<p class="text-gray-500">Loading</p>'
      openModal()
      try {
        const response = await fetch(url, { headers: { Accept: 'application/json' }, credentials: 'same-origin' })
        const data = await response.json()
        if (!response.ok) {
          const message = (data && data.error) ? data.error : 'Request failed.'
          body.innerHTML = `<p class="text-red-600">${escapeHtml(message)}</p>`
          return
        }
        if (data && data.error) {
          body.innerHTML = `<p class="text-red-600">${escapeHtml(data.error)}</p>`
          return
        }
        renderRows(data)
      } catch (_err) {
        body.innerHTML = '<p class="text-red-600">Unable to load file list.</p>'
      }
    }

    openButton.addEventListener('click', (event) => {
      event.preventDefault()
      event.stopPropagation()
      loadAndShow()
    })

    closeButton.addEventListener('click', (event) => {
      event.stopPropagation()
      closeModal()
    })

    panel.addEventListener('click', (event) => event.stopPropagation())

    overlay.addEventListener('click', () => closeModal())

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !overlay.classList.contains('hidden')) closeModal()
    })
  })()
</script>

<script>
  (function initializeSummaryVisualDetailsPopover() {
    const popover = document.getElementById('summary-visual-details-popover')
    const closeButton = document.getElementById('summary-visual-details-close-button')
    const header = document.getElementById('summary-visual-details-header')
    const title = document.getElementById('summary-visual-details-title')
    const triggers = Array.from(document.querySelectorAll('[data-summary-detail-trigger]'))
    if (!popover || !closeButton || !header || !title || triggers.length === 0 || popover.dataset.initialized === 'true') return
    popover.dataset.initialized = 'true'
    let wasDragged = false
    let isDragging = false

    const sectionByType = {
      embeddings: 'Embeddings',
      annotations: 'Annotations',
      checkpoints: 'Checkpoints',
      comments: 'Comments'
    }

    const allSections = Array.from(popover.querySelectorAll('[data-summary-detail-section]'))
    const annotationSelect = document.getElementById('summary-annotations-metadata-select')
    const annotationTypeSelect = document.getElementById('summary-annotations-type-select')
    const annotationTextFilter = document.getElementById('summary-annotations-text-filter')
    const annotationRows = Array.from(popover.querySelectorAll('[data-summary-annotation-row]'))
    const annotationEmpty = document.getElementById('summary-annotations-empty')
    const annotationsMainView = document.getElementById('summary-annotations-main-view')
    const annotationsCellSetView = document.getElementById('summary-annotations-cell-set-view')
    const annotationsCellSetBackButton = document.getElementById('summary-annotations-cell-set-back')
    const annotationsCellSetTbody = document.getElementById('summary-annotations-cell-set-tbody')
    const annotationsCellSetEmpty = document.getElementById('summary-annotations-cell-set-empty')
    const projectKey = popover.dataset.projectKey
    const currentProjectId = popover.dataset.currentProjectId ? String(popover.dataset.currentProjectId) : ''

    let annotationMetadataByType = {}
    try {
      annotationMetadataByType = JSON.parse(annotationsMainView?.dataset?.annotationMetadataByType || '{}') || {}
    } catch (_error) {
      annotationMetadataByType = {}
    }

    const renderSourceProjectCell = (row) => {
      const pid = row.project_id != null ? String(row.project_id) : ''
      const pk = row.project_key || ''
      const p = row.project || {}
      const bits = []
      if (p.public_id !== null && p.public_id !== undefined && String(p.public_id).length > 0) {
        bits.push('ASAP' + escapeHtml(String(p.public_id)))
      }
      if (pk) bits.push(escapeHtml(pk))
      if (p.name) {
        const nameEsc = escapeHtml(String(p.name))
        if (bits.indexOf(nameEsc) === -1) bits.push(nameEsc)
      }
      const detail = bits.length > 0 ? bits.join(' - ') : (pid ? 'Project id ' + escapeHtml(pid) : '-')
      const isLocal = currentProjectId && pid && currentProjectId === pid
      if (isLocal) {
        return `<div class="space-y-1"><span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">This project</span><div class="text-xs text-gray-600">${detail}</div></div>`
      }
      return `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-800 border border-slate-200 max-w-xs">${detail}</span>`
    }

    const syncAnnotationMetadataOptions = () => {
      if (!annotationSelect || !annotationTypeSelect) return
      const selectedTypeId = String(annotationTypeSelect.value || '')
      const metadataOptions = Array.isArray(annotationMetadataByType[selectedTypeId])
        ? annotationMetadataByType[selectedTypeId]
        : []
      const previousAnnotId = String(annotationSelect.value || '')
      annotationSelect.innerHTML = ''
      const allOption = document.createElement('option')
      allOption.value = ''
      allOption.textContent = 'All'
      annotationSelect.appendChild(allOption)
      metadataOptions.forEach((metadataOption) => {
        const option = document.createElement('option')
        option.value = metadataOption.id == null ? '' : String(metadataOption.id)
        const count = metadataOption.count != null ? Number(metadataOption.count) : 0
        option.textContent = `${metadataOption.label || 'Metadata'} (${count.toLocaleString()})`
        annotationSelect.appendChild(option)
      })
      const hasPrevious = previousAnnotId !== '' && metadataOptions.some((metadataOption) => String(metadataOption.id == null ? '' : metadataOption.id) === previousAnnotId)
      annotationSelect.value = hasPrevious ? previousAnnotId : ''
    }

    const refreshAnnotationMetadataColumn = () => {
      const showAllMetadata = !annotationSelect || String(annotationSelect.value || '') === ''
      popover.querySelectorAll('[data-summary-annotation-metadata-col]').forEach((el) => {
        el.classList.toggle('hidden', !showAllMetadata)
      })
    }

    const annotationRowSearchText = (row) => {
      if (!row.dataset.summarySearchText) {
        row.dataset.summarySearchText = String(row.textContent || '').replace(/\s+/g, ' ').trim().toLowerCase()
      }
      return row.dataset.summarySearchText
    }

    const refreshAnnotationRows = () => {
      if (!annotationTypeSelect || annotationRows.length === 0) return
      const selectedTypeId = String(annotationTypeSelect.value || '')
      const selectedAnnotId = annotationSelect ? String(annotationSelect.value || '') : ''
      const showAllMetadata = selectedAnnotId === ''
      const textQuery = annotationTextFilter
        ? String(annotationTextFilter.value || '').trim().toLowerCase()
        : ''
      let visibleCount = 0
      annotationRows.forEach((row) => {
        const typeMatch = String(row.dataset.ontologyTermTypeId || '') === selectedTypeId
        const annotMatch = showAllMetadata || String(row.dataset.annotId || '') === selectedAnnotId
        const textMatch = textQuery === '' || annotationRowSearchText(row).includes(textQuery)
        const isVisible = typeMatch && annotMatch && textMatch
        row.classList.toggle('hidden', !isVisible)
        if (isVisible) visibleCount += 1
      })
      if (annotationEmpty) annotationEmpty.classList.toggle('hidden', visibleCount > 0)
      refreshAnnotationMetadataColumn()
    }

    const refreshAnnotationFilters = () => {
      syncAnnotationMetadataOptions()
      refreshAnnotationRows()
    }

    const escapeHtml = (value) => {
      return String(value == null ? '' : value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;')
    }

    const escapeAttr = (value) => escapeHtml(value).replaceAll('`', '&#96;')

    const searchGeneUrl = popover.dataset.searchGeneUrl || ''
    const geneModalOverlay = document.getElementById('summary-gene-modal-overlay')
    const geneModalBody = document.getElementById('summary-gene-modal-body')
    const geneModalTitle = document.getElementById('summary-gene-modal-title')
    const geneModalClose = document.getElementById('summary-gene-modal-close')
    const ontologyModalOverlay = document.getElementById('summary-ontology-modal-overlay')
    const ontologyModalBody = document.getElementById('summary-ontology-modal-body')
    const ontologyModalTitle = document.getElementById('summary-ontology-modal-title')
    const ontologyModalClose = document.getElementById('summary-ontology-modal-close')

    const openSummaryGeneModal = (ensemblId, geneSymbol) => {
      if (!geneModalOverlay || !geneModalBody || !geneModalTitle || !searchGeneUrl) return
      const ens = String(ensemblId || '').trim()
      const sym = String(geneSymbol || '').trim()
      const parts = []
      if (ens) parts.push('ensembl_id=' + encodeURIComponent(ens))
      if (sym) parts.push('gene_symbol=' + encodeURIComponent(sym))
      if (parts.length === 0) return
      geneModalTitle.textContent = sym || ens
      geneModalBody.innerHTML = '<div class="text-gray-500 text-sm">Loading...</div>'
      geneModalOverlay.classList.remove('hidden')
      const csrf = document.querySelector('meta[name="csrf-token"]')?.content || ''
      const url = searchGeneUrl + (searchGeneUrl.indexOf('?') >= 0 ? '&' : '?') + parts.join('&')
      fetch(url, {
        headers: { 'X-CSRF-Token': csrf, Accept: 'text/html' },
        credentials: 'same-origin'
      })
        .then((response) => response.text())
        .then((html) => {
          geneModalBody.innerHTML = html
        })
        .catch(() => {
          geneModalBody.innerHTML = '<div class="text-red-600 text-sm">Failed to load gene details.</div>'
        })
    }

    const closeSummaryGeneModal = () => {
      if (geneModalOverlay) geneModalOverlay.classList.add('hidden')
    }

    const openSummaryOntologyModal = (identifier, name, url) => {
      if (!ontologyModalOverlay || !ontologyModalBody || !ontologyModalTitle) return
      const id = String(identifier || '').trim()
      const termName = String(name || '').trim()
      const termUrl = String(url || '').trim()
      ontologyModalTitle.textContent = termName || id || 'Ontology term'
      const rows = []
      if (termName) {
        rows.push(`<div class="mb-3"><div class="text-xs font-medium text-gray-500 mb-1">Name</div><div class="text-sm text-gray-900">${escapeHtml(termName)}</div></div>`)
      }
      if (id) {
        rows.push(`<div class="mb-3"><div class="text-xs font-medium text-gray-500 mb-1">Identifier</div><div class="text-sm text-gray-900 font-mono">${escapeHtml(id)}</div></div>`)
      }
      if (termUrl) {
        rows.push(`<div class="mt-4"><a href="${escapeAttr(termUrl)}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-3 py-1.5 rounded text-sm font-medium bg-violet-600 text-white hover:bg-violet-700">Open ontology term</a></div>`)
      } else if (!termName && !id) {
        rows.push('<div class="text-sm text-gray-500">No ontology term details available.</div>')
      }
      ontologyModalBody.innerHTML = rows.join('')
      ontologyModalOverlay.classList.remove('hidden')
    }

    const closeSummaryOntologyModal = () => {
      if (ontologyModalOverlay) ontologyModalOverlay.classList.add('hidden')
    }

    const renderGeneBadges = (genes, tone) => {
      const list = Array.isArray(genes) ? genes : []
      if (list.length === 0) return '<span class="text-gray-400">-</span>'
      const badgeClass = tone === 'up'
        ? 'summary-gene-badge gene-badge cursor-pointer inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800 hover:bg-green-200'
        : 'summary-gene-badge gene-badge cursor-pointer inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800 hover:bg-red-200'
      return `<div class="flex flex-wrap gap-1">${list.map((gene) => {
        const symbol = typeof gene === 'object' && gene != null
          ? String(gene.symbol || gene.gene_id || gene || '').trim()
          : String(gene || '').trim()
        const ensembl = typeof gene === 'object' && gene != null
          ? String(gene.ensembl_id || '').trim()
          : ''
        const attrs = [
          `class="${badgeClass}"`,
          `data-gene-symbol="${escapeAttr(symbol)}"`,
          ensembl ? `data-ensembl-id="${escapeAttr(ensembl)}"` : '',
          `title="${escapeAttr(ensembl || symbol)}"`
        ].filter(Boolean).join(' ')
        return `<button type="button" ${attrs}>${escapeHtml(symbol || '-')}</button>`
      }).join('')}</div>`
    }

    const showProjectAnnotationsView = () => {
      if (annotationsMainView) annotationsMainView.classList.remove('hidden')
      if (annotationsCellSetView) annotationsCellSetView.classList.add('hidden')
    }

    const showCellSetAnnotationsView = () => {
      if (annotationsMainView) annotationsMainView.classList.add('hidden')
      if (annotationsCellSetView) annotationsCellSetView.classList.remove('hidden')
    }

    const loadCellSetAnnotations = async (cellSetKey) => {
      if (!annotationsCellSetTbody || !projectKey || !cellSetKey) return
      showCellSetAnnotationsView()
      annotationsCellSetTbody.innerHTML = '<tr><td colspan="11" class="px-2 py-3 text-xs text-gray-500">Loading annotations...</td></tr>'
      if (annotationsCellSetEmpty) annotationsCellSetEmpty.classList.add('hidden')

      try {
        const response = await fetch(`/projects/${encodeURIComponent(projectKey)}/get_cell_set_annotations?cell_set_key=${encodeURIComponent(cellSetKey)}`, {
          headers: { Accept: 'application/json' },
          credentials: 'same-origin'
        })
        if (!response.ok) throw new Error('Failed to load cell set annotations')
        const payload = await response.json()
        const rows = Array.isArray(payload.annotations) ? payload.annotations : []

        if (rows.length === 0) {
          annotationsCellSetTbody.innerHTML = ''
          if (annotationsCellSetEmpty) annotationsCellSetEmpty.classList.remove('hidden')
          return
        }

        annotationsCellSetTbody.innerHTML = rows.map((row) => {
          const cellSetHash = String(row.cell_set_key || '')
          const shortHash = cellSetHash ? `${cellSetHash.slice(0, 10)}...` : '-'
          return `
            <tr>
              <td class="px-2 py-1.5 text-xs text-gray-700">${renderSourceProjectCell(row)}</td>
              <td class="px-2 py-1.5 text-xs text-gray-700 whitespace-nowrap">${escapeHtml(row.metadata_name || '-')}</td>
              <td class="px-2 py-1.5 text-xs text-gray-700 whitespace-nowrap">${escapeHtml(row.cluster_category || '-')}</td>
              <td class="px-2 py-1.5 text-xs text-gray-700 whitespace-nowrap">${escapeHtml(row.label || '-')}</td>
              <td class="px-2 py-1.5 text-xs text-gray-600 whitespace-nowrap">${escapeHtml(row.origin || '-')}</td>
              <td class="px-2 py-1.5 text-xs text-gray-600 font-mono whitespace-nowrap">${escapeHtml(shortHash)}</td>
              <td class="px-2 py-1.5 text-xs text-gray-600">${renderGeneBadges(row.up_genes, 'up')}</td>
              <td class="px-2 py-1.5 text-xs text-gray-600">${renderGeneBadges(row.down_genes, 'down')}</td>
              <td class="px-2 py-1.5 text-xs text-gray-600 whitespace-nowrap">+${escapeHtml(row.nber_agree || 0)} / -${escapeHtml(row.nber_disagree || 0)}</td>
              <td class="px-2 py-1.5 text-xs text-gray-600 whitespace-nowrap">${escapeHtml(row.created_by || '-')}</td>
              <td class="px-2 py-1.5 text-xs text-gray-600 whitespace-nowrap">${escapeHtml(row.created_at || '-')}</td>
            </tr>
          `
        }).join('')
      } catch (_error) {
        annotationsCellSetTbody.innerHTML = '<tr><td colspan="11" class="px-2 py-3 text-xs text-red-600">Unable to load annotations for this cell set.</td></tr>'
      }
    }

    if (annotationTypeSelect) {
      annotationTypeSelect.addEventListener('change', refreshAnnotationFilters)
      refreshAnnotationFilters()
    }
    if (annotationSelect) {
      annotationSelect.addEventListener('change', refreshAnnotationRows)
    }
    if (annotationTextFilter) {
      annotationTextFilter.addEventListener('input', refreshAnnotationRows)
      annotationTextFilter.addEventListener('search', refreshAnnotationRows)
    }
    if (annotationsCellSetBackButton) {
      annotationsCellSetBackButton.addEventListener('click', (event) => {
        event.preventDefault()
        event.stopPropagation()
        showProjectAnnotationsView()
        refreshAnnotationFilters()
      })
    }

    popover.addEventListener('click', (event) => {
      const geneBadge = event.target.closest('.summary-gene-badge, .gene-badge')
      if (geneBadge && popover.contains(geneBadge)) {
        event.preventDefault()
        event.stopPropagation()
        openSummaryGeneModal(
          geneBadge.getAttribute('data-ensembl-id') || '',
          geneBadge.getAttribute('data-gene-symbol') || ''
        )
        return
      }

      const ontologyBadge = event.target.closest('.summary-ontology-badge')
      if (ontologyBadge && popover.contains(ontologyBadge)) {
        event.preventDefault()
        event.stopPropagation()
        openSummaryOntologyModal(
          ontologyBadge.getAttribute('data-ontology-identifier') || '',
          ontologyBadge.getAttribute('data-ontology-name') || '',
          ontologyBadge.getAttribute('data-ontology-url') || ''
        )
        return
      }

      const trigger = event.target.closest('[data-summary-cell-set-key]')
      if (!trigger) return
      event.preventDefault()
      event.stopPropagation()
      loadCellSetAnnotations(trigger.dataset.summaryCellSetKey)
    })

    if (geneModalClose) {
      geneModalClose.addEventListener('click', (event) => {
        event.preventDefault()
        event.stopPropagation()
        closeSummaryGeneModal()
      })
    }
    if (geneModalOverlay) {
      geneModalOverlay.addEventListener('click', (event) => {
        event.stopPropagation()
        if (event.target === geneModalOverlay) closeSummaryGeneModal()
      })
    }
    if (ontologyModalClose) {
      ontologyModalClose.addEventListener('click', (event) => {
        event.preventDefault()
        event.stopPropagation()
        closeSummaryOntologyModal()
      })
    }
    if (ontologyModalOverlay) {
      ontologyModalOverlay.addEventListener('click', (event) => {
        event.stopPropagation()
        if (event.target === ontologyModalOverlay) closeSummaryOntologyModal()
      })
    }

    const closePopover = () => {
      popover.classList.add('hidden')
      triggers.forEach((trigger) => trigger.setAttribute('aria-expanded', 'false'))
      showProjectAnnotationsView()
    }

    const positionPopover = (trigger) => {
      const rect = trigger.getBoundingClientRect()
      const popoverWidth = Math.min(window.innerWidth * 0.95, 1024)
      const left = Math.max(8, Math.min(rect.left, window.innerWidth - popoverWidth - 8))
      const top = rect.bottom + 8
      popover.style.left = `${left}px`
      popover.style.top = `${top}px`
    }

    const startDrag = (event) => {
      if (event.button !== 0) return
      if (closeButton.contains(event.target)) return
      event.preventDefault()
      event.stopPropagation()
      const rect = popover.getBoundingClientRect()
      const offsetX = event.clientX - rect.left
      const offsetY = event.clientY - rect.top
      isDragging = true

      const onMove = (moveEvent) => {
        if (!isDragging) return
        wasDragged = true
        const maxLeft = Math.max(8, window.innerWidth - rect.width - 8)
        const maxTop = Math.max(8, window.innerHeight - rect.height - 8)
        const left = Math.max(8, Math.min(moveEvent.clientX - offsetX, maxLeft))
        const top = Math.max(8, Math.min(moveEvent.clientY - offsetY, maxTop))
        popover.style.left = `${left}px`
        popover.style.top = `${top}px`
      }

      const endDrag = () => {
        isDragging = false
        document.removeEventListener('mousemove', onMove)
        document.removeEventListener('mouseup', endDrag)
      }

      document.addEventListener('mousemove', onMove)
      document.addEventListener('mouseup', endDrag)
    }

    const openPopover = (trigger, type) => {
      allSections.forEach((section) => {
        section.classList.toggle('hidden', section.dataset.summaryDetailSection !== type)
      })
      title.textContent = sectionByType[type] || 'Details'
      wasDragged = false
      positionPopover(trigger)
      popover.classList.remove('hidden')
      triggers.forEach((otherTrigger) => otherTrigger.setAttribute('aria-expanded', otherTrigger === trigger ? 'true' : 'false'))
      if (type === 'annotations') {
        showProjectAnnotationsView()
        refreshAnnotationFilters()
      }
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', (event) => {
        event.preventDefault()
        event.stopPropagation()
        const type = trigger.dataset.summaryDetailType
        if (!type) return
        if (!popover.classList.contains('hidden') && trigger.getAttribute('aria-expanded') === 'true') {
          closePopover()
          return
        }
        openPopover(trigger, type)
      })
    })

    closeButton.addEventListener('click', (event) => {
      event.stopPropagation()
      closePopover()
    })

    header.addEventListener('mousedown', startDrag)

    const detailModalOpen = () => {
      const geneOpen = geneModalOverlay && !geneModalOverlay.classList.contains('hidden')
      const ontologyOpen = ontologyModalOverlay && !ontologyModalOverlay.classList.contains('hidden')
      return !!(geneOpen || ontologyOpen)
    }

    document.addEventListener('click', (event) => {
      if (popover.classList.contains('hidden')) return
      if (popover.contains(event.target)) return
      if (geneModalOverlay && geneModalOverlay.contains(event.target)) return
      if (ontologyModalOverlay && ontologyModalOverlay.contains(event.target)) return
      const clickedTrigger = triggers.some((trigger) => trigger.contains(event.target))
      if (clickedTrigger) return
      if (detailModalOpen()) return
      closePopover()
    })

    window.addEventListener('resize', () => {
      if (popover.classList.contains('hidden')) return
      if (wasDragged) return
      const activeTrigger = triggers.find((trigger) => trigger.getAttribute('aria-expanded') === 'true')
      if (activeTrigger) positionPopover(activeTrigger)
    })

    window.addEventListener('scroll', () => {
      if (popover.classList.contains('hidden')) return
      if (wasDragged) return
      const activeTrigger = triggers.find((trigger) => trigger.getAttribute('aria-expanded') === 'true')
      if (activeTrigger) positionPopover(activeTrigger)
    }, { passive: true })

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return
      if (geneModalOverlay && !geneModalOverlay.classList.contains('hidden')) {
        event.stopPropagation()
        closeSummaryGeneModal()
        return
      }
      if (ontologyModalOverlay && !ontologyModalOverlay.classList.contains('hidden')) {
        event.stopPropagation()
        closeSummaryOntologyModal()
        return
      }
      if (!popover.classList.contains('hidden')) closePopover()
    })
  })()
</script>