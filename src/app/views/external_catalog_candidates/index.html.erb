<% content_for :title, "External catalog - ASAP" %>
<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8 space-y-6">
  <div>
    <h1 class="text-3xl font-semibold text-gray-900 dark:text-white">External catalog</h1>
    <p class="mt-2 text-gray-600 dark:text-gray-300">
      Candidate datasets from CELLxGENE, Bgee, EBI single cell expression atlas, HCA, Broad Single Cell Portal, and GEO. Create an ASAP project from an entry that is not imported yet.
    </p>
    <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
      Broad SCP candidates are limited to public, non-embargoed studies under the
      <%= link_to "SCP Terms of Service",
                  ExternalCatalog::BroadScpCatalog::TERMS_OF_SERVICE_URL,
                  target: "_blank",
                  rel: "noopener",
                  class: "text-blue-600 hover:underline dark:text-blue-400" %>;
      redistributed data is for research use only.
    </p>
  </div>

  <% if notice.present? %>
    <div class="rounded-md bg-green-100 px-4 py-3 text-sm text-green-700 dark:bg-green-900/30 dark:text-green-200"><%= notice %></div>
  <% end %>
  <% if alert.present? %>
    <div class="rounded-md bg-red-100 px-4 py-3 text-sm text-red-700 dark:bg-red-900/30 dark:text-red-200"><%= alert %></div>
  <% end %>

  <%= form_with url: external_catalog_candidates_path, method: :get, local: true,
                html: {
                  class: "rounded-lg border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900",
                  data: { controller: "catalog-filters" }
                } do %>
    <div class="grid grid-cols-1 gap-3 md:grid-cols-4">
      <div>
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">Source</label>
        <%= select_tag :source,
                       options_for_select(
                         [['All sources', '']] + ExternalCatalogCandidate::SOURCES.map { |s|
                           [ExternalCatalog::Entry.new(source: s).provider_name, s]
                         },
                         @source
                       ),
                       class: "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm dark:border-gray-700 dark:bg-gray-950 dark:text-gray-100",
                       data: { action: "change->catalog-filters#submitNow" } %>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">Project type</label>
        <%= select_tag :project_type,
                       options_for_select([['All types', ''], ['Single-cell', 'sc'], ['Bulk', 'bulk']], @project_type),
                       class: "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm dark:border-gray-700 dark:bg-gray-950 dark:text-gray-100",
                       data: { action: "change->catalog-filters#submitNow" } %>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">In ASAP</label>
        <%= select_tag :in_asap,
                       options_for_select([['Any', ''], ['Already in ASAP', 'yes'], ['Not in ASAP', 'no']], @in_asap),
                       class: "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm dark:border-gray-700 dark:bg-gray-950 dark:text-gray-100",
                       data: { action: "change->catalog-filters#submitNow" } %>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">Search</label>
        <%= text_field_tag :q, @q,
                           placeholder: "Title, id, DOI, PMID, accession",
                           class: "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm dark:border-gray-700 dark:bg-gray-950 dark:text-gray-100",
                           data: { action: "input->catalog-filters#debouncedSubmit" } %>
      </div>
    </div>
    <% if @n_obs_bounds %>
      <% bound_min = @n_obs_bounds[:min] %>
      <% bound_max = @n_obs_bounds[:max] %>
      <% selected_min = @min_n_obs.presence || bound_min %>
      <% selected_max = @max_n_obs.presence || bound_max %>
      <div class="mt-4"
           data-controller="catalog-n-obs-range"
           data-catalog-n-obs-range-bound-min-value="<%= bound_min %>"
           data-catalog-n-obs-range-bound-max-value="<%= bound_max %>">
        <input type="hidden"
               name="min_n_obs"
               value="<%= selected_min %>"
               data-catalog-n-obs-range-target="minField">
        <input type="hidden"
               name="max_n_obs"
               value="<%= selected_max %>"
               data-catalog-n-obs-range-target="maxField">
        <div class="flex flex-wrap items-end justify-between gap-2 mb-2">
          <label class="block text-xs font-medium text-gray-600 dark:text-gray-400">
            <% if @project_type == 'bulk' %>
              Samples
            <% elsif @project_type == 'sc' %>
              Cells
            <% else %>
              Cells / samples
            <% end %>
          </label>
          <div class="text-xs text-gray-500 dark:text-gray-400">
            <span data-catalog-n-obs-range-target="minDisplay"><%= number_with_delimiter(selected_min) %></span>
            –
            <span data-catalog-n-obs-range-target="maxDisplay"><%= number_with_delimiter(selected_max) %></span>
          </div>
        </div>
        <div class="relative h-6">
          <div class="absolute left-0 right-0 top-1/2 h-1.5 -translate-y-1/2 rounded-full bg-gray-200 dark:bg-gray-700"></div>
          <div class="absolute top-1/2 h-1.5 -translate-y-1/2 rounded-full bg-gray-900 dark:bg-gray-100"
               data-catalog-n-obs-range-target="fill"
               style="left: 0%; width: 100%;"></div>
          <input type="range"
                 min="0"
                 max="1000"
                 value="0"
                 aria-label="Minimum cells or samples"
                 class="catalog-n-obs-range-input absolute inset-0 w-full appearance-none bg-transparent pointer-events-none [&::-webkit-slider-thumb]:pointer-events-auto [&::-moz-range-thumb]:pointer-events-auto"
                 data-catalog-n-obs-range-target="minRange"
                 data-action="input->catalog-n-obs-range#minRangeInput change->catalog-n-obs-range#commit">
          <input type="range"
                 min="0"
                 max="1000"
                 value="1000"
                 aria-label="Maximum cells or samples"
                 class="catalog-n-obs-range-input absolute inset-0 w-full appearance-none bg-transparent pointer-events-none [&::-webkit-slider-thumb]:pointer-events-auto [&::-moz-range-thumb]:pointer-events-auto"
                 data-catalog-n-obs-range-target="maxRange"
                 data-action="input->catalog-n-obs-range#maxRangeInput change->catalog-n-obs-range#commit">
        </div>
      </div>
      <style>
        .catalog-n-obs-range-input {
          height: 1.5rem;
          margin: 0;
          padding: 0;
        }
        .catalog-n-obs-range-input::-webkit-slider-runnable-track {
          background: transparent;
          height: 0.375rem;
        }
        .catalog-n-obs-range-input::-moz-range-track {
          background: transparent;
          height: 0.375rem;
        }
        .catalog-n-obs-range-input::-webkit-slider-thumb {
          -webkit-appearance: none;
          appearance: none;
          width: 1rem;
          height: 1rem;
          margin-top: -0.3125rem;
          border-radius: 9999px;
          border: 2px solid #fff;
          background: #111827;
          box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
          cursor: grab;
          position: relative;
          z-index: 2;
        }
        .catalog-n-obs-range-input::-moz-range-thumb {
          width: 1rem;
          height: 1rem;
          border-radius: 9999px;
          border: 2px solid #fff;
          background: #111827;
          box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
          cursor: grab;
          position: relative;
          z-index: 2;
        }
        .dark .catalog-n-obs-range-input::-webkit-slider-thumb {
          background: #f3f4f6;
          border-color: #111827;
        }
        .dark .catalog-n-obs-range-input::-moz-range-thumb {
          background: #f3f4f6;
          border-color: #111827;
        }
      </style>
    <% end %>
    <div class="mt-3 flex items-center gap-3">
      <%= link_to "Reset", external_catalog_candidates_path, class: "text-sm text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-200" %>
      <span class="text-xs text-gray-500 dark:text-gray-400"><%= @total_count %> candidates</span>
    </div>
  <% end %>

  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
    <table class="min-w-full divide-y divide-gray-200 text-sm dark:divide-gray-800">
      <thead class="bg-gray-50 text-xs font-semibold uppercase tracking-wide text-gray-600 dark:bg-gray-950 dark:text-gray-400">
        <tr>
          <th scope="col" class="px-3 py-2 text-left">Source</th>
          <th scope="col" class="px-3 py-2 text-left">Dataset</th>
          <th scope="col" class="px-3 py-2 text-left">Matrix</th>
          <th scope="col" class="px-3 py-2 text-left">Format</th>
          <th scope="col" class="px-3 py-2 text-left">ASAP</th>
          <th scope="col" class="px-3 py-2 text-left">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 text-gray-700 dark:divide-gray-800 dark:text-gray-200">
        <% @candidates.each do |candidate| %>
          <% asap_projects = @asap_projects_by_candidate_id[candidate.id] || [] %>
          <% dois = candidate.dois %>
          <% organism_title =
               if candidate.tax_id.to_i > 0
                 "NCBI Taxonomy ID #{candidate.tax_id}"
               end %>
          <tr>
            <td class="whitespace-nowrap px-3 py-2 text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">
              <% if candidate.source_page_url.present? %>
                <%= link_to candidate.source,
                            candidate.source_page_url,
                            target: "_blank",
                            rel: "noopener",
                            class: "text-blue-600 hover:underline dark:text-blue-400",
                            title: "Open on #{candidate.source}" %>
              <% else %>
                <%= candidate.source %>
              <% end %>
              <% if candidate.project_type_tag.present? %>
                <div class="mt-0.5 normal-case tracking-normal text-gray-400"><%= candidate.project_type_tag %></div>
              <% end %>
            </td>
            <td class="px-3 py-2">
              <div class="flex items-start gap-1.5">
                <%= link_to (candidate.title.presence || candidate.external_id).to_s.truncate(80),
                            external_catalog_candidate_path(candidate),
                            class: "font-medium text-blue-600 hover:underline dark:text-blue-400" %>
                <% if dois.any? %>
                  <%= link_to "https://doi.org/#{dois.first}",
                              target: "_blank",
                              rel: "noopener",
                              class: "mt-0.5 shrink-0 text-gray-400 hover:text-blue-600 dark:hover:text-blue-400",
                              title: (dois.size > 1 ? "#{dois.first} (+#{dois.size - 1})" : dois.first) do %>
                    <i class="fas fa-book-open text-xs" aria-hidden="true"></i>
                    <span class="sr-only">Publication DOI</span>
                  <% end %>
                <% end %>
              </div>
              <div class="mt-0.5 font-mono text-xs text-gray-500 dark:text-gray-400"><%= candidate.external_id %></div>
              <% if candidate.organism_label.present? %>
                <div class="mt-0.5 text-xs text-gray-500 dark:text-gray-400" title="<%= organism_title %>">
                  <%= candidate.organism_label %>
                </div>
              <% end %>
            </td>
            <td class="whitespace-nowrap px-3 py-2 text-xs">
              <% if candidate.n_obs.to_i.positive? && candidate.n_vars.to_i.positive? %>
                <%= number_with_delimiter(candidate.n_obs) %> <%= candidate.matrix_obs_unit %>
                <span class="text-gray-400">x</span>
                <%= number_with_delimiter(candidate.n_vars) %> genes
              <% elsif candidate.n_obs.to_i.positive? %>
                <%= number_with_delimiter(candidate.n_obs) %> <%= candidate.matrix_obs_unit %>
              <% elsif candidate.n_vars.to_i.positive? %>
                <%= number_with_delimiter(candidate.n_vars) %> genes
              <% else %>
                <span class="text-gray-400">—</span>
              <% end %>
            </td>
            <td class="whitespace-nowrap px-3 py-2 text-xs">
              <%= candidate.format_kind.presence || "—" %>
              <% if candidate.filesize.to_i > 0 %>
                <div class="text-gray-400"><%= number_to_human_size(candidate.filesize) %></div>
              <% end %>
            </td>
            <td class="px-3 py-2 text-xs">
              <% if candidate.importing? %>
                <span class="inline-flex rounded bg-amber-100 px-2 py-0.5 font-medium text-amber-800 dark:bg-amber-900/40 dark:text-amber-200">Importing</span>
              <% elsif asap_projects.any? %>
                <% asap_projects.first(3).each do |project| %>
                  <div>
                    <%= link_to (project.public_key.presence || project.key),
                                project_path(project),
                                class: "text-blue-600 hover:underline dark:text-blue-400" %>
                  </div>
                <% end %>
                <% if asap_projects.size > 3 %>
                  <div class="text-gray-400">+<%= asap_projects.size - 3 %> more</div>
                <% end %>
              <% elsif admin? && candidate.failed? %>
                <span class="inline-flex rounded bg-red-100 px-2 py-0.5 font-medium text-red-800 dark:bg-red-900/40 dark:text-red-200">Failed</span>
                <% if candidate.import_error.present? %>
                  <div class="mt-0.5 max-w-xs truncate text-red-500" title="<%= candidate.import_error %>"><%= candidate.import_error.to_s.truncate(80) %></div>
                <% end %>
              <% else %>
                <span class="text-gray-400">Not in ASAP</span>
              <% end %>
            </td>
            <td class="whitespace-nowrap px-3 py-2 text-xs">
              <%= link_to "Details", external_catalog_candidate_path(candidate), class: "text-gray-600 hover:text-gray-900 dark:text-gray-300" %>
              <% if candidate.can_create_project?(accessible_asap_projects: asap_projects) %>
                <% import_confirm =
                     if !user_signed_in? && guest_sandbox_project
                       "Importing will replace your current sandbox project (#{guest_sandbox_project.display_name}). Continue?"
                     end %>
                <%= button_to "Import",
                              create_project_external_catalog_candidate_path(candidate),
                              method: :post,
                              form: {
                                class: "inline ml-2",
                                data: {
                                  controller: "catalog-import",
                                  catalog_import_status_url_value: import_status_external_catalog_candidate_path(candidate),
                                  **(import_confirm ? { turbo_confirm: import_confirm } : {})
                                }
                              },
                              class: "inline-flex items-center rounded-md bg-gray-900 px-2 py-1 text-xs font-medium text-white hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-900" %>
              <% end %>
              <% if admin? && synced_reference_data_writable? && candidate.can_mark_obsolete? %>
                <%= button_to "Mark obsolete",
                              external_catalog_candidate_path(candidate),
                              method: :delete,
                              form: { class: "inline ml-2", data: { turbo_confirm: "Mark this candidate obsolete? It will stay out of the active catalog after syncing to production." } },
                              class: "inline-flex items-center rounded-md border border-red-200 px-2 py-1 text-xs font-medium text-red-700 hover:bg-red-50 dark:border-red-500/40 dark:text-red-300 dark:hover:bg-red-500/10" %>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @candidates.empty? %>
          <tr>
            <td colspan="6" class="px-3 py-10 text-center text-gray-500 dark:text-gray-400">
              No candidates match these filters.
              <% if admin? %>
                Sync with <code class="text-xs">rails external_catalog:sync_candidates</code>.
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @total_count > @per_page %>
    <% total_pages = (@total_count.to_f / @per_page).ceil %>
    <div class="flex items-center justify-between text-sm text-gray-600 dark:text-gray-400">
      <div>
        Page <%= @page %> of <%= total_pages %>
      </div>
      <div class="flex gap-2">
        <% if @page > 1 %>
          <%= link_to "Previous",
                      external_catalog_candidates_path(request.query_parameters.merge(page: @page - 1)),
                      class: "rounded-md border border-gray-300 px-3 py-1 hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800" %>
        <% end %>
        <% if @page < total_pages %>
          <%= link_to "Next",
                      external_catalog_candidates_path(request.query_parameters.merge(page: @page + 1)),
                      class: "rounded-md border border-gray-300 px-3 py-1 hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
