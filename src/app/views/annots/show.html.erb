<% unless @embedded %>
<!-- Fixed header for annot - positioned below project header -->
<div class="fixed top-16 left-0 right-0 z-40 flex-shrink-0 bg-white shadow-sm border-b border-gray-200">
  <div class="px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between py-4">
      <div class="flex items-center gap-3">
        <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
          <i class="fas fa-database text-blue-600"></i>
          <% if @annot.filepath.present? %>
            <%= loom_file_label(@annot.filepath) %> -
          <% end %>
          <%= annot_metadata_type_label(@annot, @project) %> -
          <%= @annot.label.presence || format_annot_name(@annot.name) %>
          <%= publication_visibility_badge(@project, @annot, full_read_access: !publication_snapshot_reader?(@project)) %>
          <% if @annot.imported %>
            <%= annot_imported_badge %>
          <% else %>
            <%= annot_asap_pipeline_badge %>
          <% end %>
          <% if annot_storage_type_label(@annot, @project).present? %>
            <%= annot_matrix_type_badge(@annot, @project) %>
          <% end %>
          <% if @annot.expression_matrix? %>
            <%= annot_data_transformation_badge(@annot) %>
          <% end %>
        </h3>
      </div>
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-1">
          <%= link_to download_annot_path(@annot, format_type: 'tsv.gz'),
                      class: 'inline-flex items-center px-2 py-1 text-xs font-medium text-gray-600 bg-white border border-gray-300 rounded hover:bg-gray-50 hover:text-gray-900 transition-colors',
                      title: 'Download as TSV.gz' do %>
            <i class="fas fa-download mr-1"></i>TSV
          <% end %>
          <%= link_to download_annot_path(@annot, format_type: 'json'),
                      class: 'inline-flex items-center px-2 py-1 text-xs font-medium text-gray-600 bg-white border border-gray-300 rounded hover:bg-gray-50 hover:text-gray-900 transition-colors',
                      title: 'Download as JSON' do %>
            <i class="fas fa-download mr-1"></i>JSON
          <% end %>
        </div>
        <% if @from == 'run' && @back_run_id && @back_step_id %>
          <% back_url = project_path(@project, view: 'analysis', step_id: @back_step_id, run_id: @back_run_id) %>
          <%= link_to back_url, class: 'inline-flex items-center px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-md font-medium transition-colors cursor-pointer' do %>
            <i class="fas fa-arrow-left mr-2"></i>Back
          <% end %>
        <% elsif @from == 'run' && @run %>
          <%= link_to run_path(@run), class: 'inline-flex items-center px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-md font-medium transition-colors cursor-pointer' do %>
            <i class="fas fa-arrow-left mr-2"></i>Back
          <% end %>
        <% elsif @from == 'visualization' %>
          <%= link_to project_path(@project, view: 'visualization'), class: 'inline-flex items-center px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-md font-medium transition-colors cursor-pointer' do %>
            <i class="fas fa-arrow-left mr-2"></i>Back
          <% end %>
        <% else %>
          <%= link_to project_path(@project, view: 'data', loom_file: @annot.filepath), class: 'inline-flex items-center px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-md font-medium transition-colors cursor-pointer' do %>
            <i class="fas fa-arrow-left mr-2"></i>Back
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
<% end %>

<!-- Scrollable content area -->
<div class="<%= @embedded ? '' : 'flex-1 overflow-y-auto' %>">
  <div class="px-4 sm:px-6 lg:px-8 py-6 <%= @embedded ? 'pt-4' : 'pt-24' %>">
    <% if !@embedded && (flash[:notice].present? || flash[:alert].present?) %>
      <div class="mb-4 space-y-2">
        <% if flash[:notice].present? %>
          <div class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800"><%= flash[:notice] %></div>
        <% end %>
        <% if flash[:alert].present? %>
          <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"><%= flash[:alert] %></div>
        <% end %>
      </div>
    <% end %>
    <div class="space-y-6">
      <!-- General Info Card -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <h4 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
          <i class="fas fa-info-circle text-blue-600"></i>
          General Information
        </h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% if @annot.dim != 3 %>
            <div>
              <span class="text-sm font-medium text-gray-500">Metadata type</span>
              <p class="mt-1 text-sm text-gray-900">
                <% if @annot.name.to_s.start_with?('/attrs/') %>
                  Global
                <% else %>
                  <%= (@annot.dim == 1) ? col_label(@project, plural: false).capitalize : row_label(@project, plural: false).capitalize %>
                <% end %>
              </p>
            </div>
          <% end %>
          <div>
            <span class="text-sm font-medium text-gray-500">Dimensions</span>
            <div class="mt-2 flex flex-wrap gap-2">
              <% if @annot.dim == 3 || @annot.name == '/matrix' || @annot.name.start_with?('/layers/') %>
                <%= dimension_badge(@annot.nber_rows, :row, @project) if @annot.nber_rows %>
                <%= dimension_badge_col_aligned_with_matrix(@annot.nber_cols, @annot.filepath, @project) if @annot.nber_cols %>
              <% elsif @annot.name.start_with?('/col_attrs/') %>
                <%= dimension_badge(@matrix_nber_cols, :col, @project) if @matrix_nber_cols %>
                <%= component_dimension_badge(@annot.nber_rows) %>
              <% elsif @annot.name.start_with?('/row_attrs/') %>
                <%= dimension_badge(@matrix_nber_rows, :row, @project) if @matrix_nber_rows %>
                <%= component_dimension_badge(@annot.nber_cols) %>
              <% elsif @annot.name.start_with?('/attrs/') %>
                <% if @annot.nber_rows.present? || @annot.nber_cols.present? %>
                  <%= dimension_badge(@annot.nber_rows, :row, @project) if @annot.nber_rows.present? %>
                  <%= dimension_badge_col_aligned_with_matrix(@annot.nber_cols, @annot.filepath, @project) if @annot.nber_cols.present? %>
                <% else %>
                  <%= annot_global_badge %>
                <% end %>
              <% else %>
                <%= annot_global_badge %>
              <% end %>
              <%= categorical_categories_badge(@annot) %>
            </div>
          </div>
          <div id="annot-data-type">
            <span class="text-sm font-medium text-gray-500">Data Type</span>
            <div class="mt-2 flex items-center gap-2">
              <% if @annot.data_type %>
                <%= annot_data_type_badge(@annot) %>
              <% else %>
                <span class="text-sm text-gray-500">N/A</span>
              <% end %>
              <% if @data_type_options %>
                <button type="button"
                        aria-label="Edit data type"
                        title="Edit data type"
                        class="inline-flex items-center justify-center w-7 h-7 rounded-md text-gray-500 hover:text-blue-600 hover:bg-blue-50 border border-gray-300 hover:border-blue-300 transition-colors cursor-pointer"
                        onclick="document.getElementById('edit-data-type-modal').classList.remove('hidden')">
                  <i class="fas fa-pen text-xs"></i>
                </button>
              <% elsif @data_type_edit_blocked %>
                <span class="text-xs text-gray-500" title="Editing is disabled while pipeline runs use this data as input">
                  Used as pipeline input
                </span>
              <% end %>
            </div>
          </div>
          <% if annot_storage_type_label(@annot, @project).present? %>
            <div>
              <span class="text-sm font-medium text-gray-500">Storage type</span>
              <div class="mt-2">
                <%= annot_matrix_type_badge(@annot, @project) %>
              </div>
            </div>
          <% end %>
          <% if @annot.expression_matrix? && @annot.data_transformation.present? %>
            <div>
              <span class="text-sm font-medium text-gray-500">Data transformation</span>
              <div class="mt-2 flex items-center gap-2">
                <%= annot_data_transformation_badge(@annot) %>
              </div>
              <% if @annot.data_transformation.description.present? %>
                <p class="mt-1 text-xs text-gray-500 mb-0"><%= @annot.data_transformation.description %></p>
              <% end %>
            </div>
          <% end %>
          <% if @annot.filepath.present? %>
            <div>
              <span class="text-sm font-medium text-gray-500">Loom File Path</span>
              <p class="mt-1 text-sm text-gray-900 font-mono break-all">
                <%= @annot.filepath %>
              </p>
            </div>
          <% end %>
          <% if @annot.name.present? %>
            <div>
              <span class="text-sm font-medium text-gray-500">Path in Loom File</span>
              <p class="mt-1 text-sm text-gray-900 font-mono break-all">
                <%= @annot.name %>
              </p>
            </div>
          <% end %>
          <div>
            <span class="text-sm font-medium text-gray-500">Created by</span>
            <p class="mt-1 text-sm text-gray-900">
              <%= user_display_name(@annot.user || @annot.run&.user, current_user: current_user) %>
            </p>
          </div>
          <div>
            <span class="text-sm font-medium text-gray-500">Created</span>
            <p class="mt-1 text-sm text-gray-900">
              <%= @annot.created_at ? @annot.created_at.strftime("%b %d, %Y %H:%M") : '-' %>
            </p>
          </div>
          <div>
            <span class="text-sm font-medium text-gray-500">Data origin</span>
            <div class="mt-2">
              <% if @annot.imported %>
                <%= annot_imported_badge %>
                <p class="mt-1 text-xs text-gray-500 mb-0">Present in the loom file before or outside the producing analysis run.</p>
              <% else %>
                <%= annot_asap_pipeline_badge %>
                <p class="mt-1 text-xs text-gray-500 mb-0">Registered from an analysis run in this project.</p>
              <% end %>
            </div>
          </div>
          <div>
            <span class="text-sm font-medium text-gray-500">Produced by Analysis</span>
            <p class="mt-1 text-sm text-gray-900">
              <% if @run %>
                <% analysis_run_url = project_path(@project, view: 'analysis', panel_mode: 'run_details', step_id: @run.step_id, run_id: @run.id, loom_file: '__all__') %>
                <%= link_to analysis_run_url, class: 'text-blue-600 hover:text-blue-800 hover:underline' do %>
                  <%= @run.step ? (@run.step.label.presence || @run.step.name.humanize) : 'Unknown' %>
                  <% if @run.step && @run.step.multiple_runs %>
                    #<%= @run.num || @run.id %>
                  <% end %>
                  <i class="fas fa-arrow-circle-right ml-1"></i>
                <% end %>
              <% else %>
                N/A
              <% end %>
            </p>
          </div>
          <% if @sim_step_options && @annot.imported? %>
            <div class="md:col-span-2">
              <span class="text-sm font-medium text-gray-500">Manual mapping to ASAP step</span>
              <p class="mt-1 text-xs text-gray-500 mb-2">
                Imported metadata and matrices can be associated with a pipeline step so they become available as input for downstream analyses.
              </p>
              <div class="flex items-center gap-2 max-w-md">
                <select id="annot-sim-step-id"
                        class="flex-1 rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 bg-white"
                        data-annot-id="<%= @annot.id %>"
                        data-update-url="<%= annot_path(@annot, from: @from) %>">
                  <option value="">Not defined</option>
                  <% @sim_step_options.each do |label, step_id| %>
                    <option value="<%= step_id %>" <%= 'selected' if @annot.sim_step_id == step_id %>><%= label %></option>
                  <% end %>
                </select>
                <span id="annot-sim-step-status" class="text-sm text-green-600 hidden" aria-live="polite">Saved</span>
              </div>
            </div>
          <% elsif @annot.imported? && @annot.sim_step_id.present? && @annot.sim_step %>
            <div>
              <span class="text-sm font-medium text-gray-500">Manual mapping to ASAP step</span>
              <p class="mt-1 text-sm text-gray-900">
                <%= @annot.sim_step.label.presence || @annot.sim_step.name.humanize %>
              </p>
            </div>
          <% end %>
          <% if @annot.mem_size %>
            <div>
              <span class="text-sm font-medium text-gray-500">Size</span>
              <p class="mt-1 text-sm text-gray-900">
                <%= display_mem(@annot.mem_size) %>
              </p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Categories Card (if available) -->
      <% if @categories && @categories.any? %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h4 class="text-lg font-semibold text-gray-900 mb-4">Categories</h4>
          <div class="flex flex-wrap gap-2">
            <% base_label = (@annot.dim == 1) ? col_label(@project, plural: false) : row_label(@project, plural: false) %>
            <% @categories.each do |cat, count| %>
              <span class="inline-flex items-center px-3 py-1 rounded-md text-sm font-medium bg-gray-100 text-gray-700 border border-gray-200">
                <%= cat %> <span class="ml-2 text-gray-500">(<%= count %> <%= count == 1 ? base_label : base_label.pluralize %>)</span>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Preview Card -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <h4 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
          <i class="fas fa-table text-blue-600"></i>
          Preview
        </h4>
        
        <% if @matrix_preview %>
          <%# 2D metadata matrix preview (e.g. /col_attrs/X_pca, /attrs/ DE table) %>
          <% mp = @matrix_preview %>
          <% ch = mp[:column_headers] %>
          <% attrs_global = mp[:attrs_global] %>
          <% is_col_attrs = @annot.name.start_with?('/col_attrs/') %>
          <% entry_label_singular = is_col_attrs ? col_label(@project, plural: false) : row_label(@project, plural: false) %>
          <% component_label_singular = 'component' %>
          <div class="mb-4">
            <p class="text-sm text-gray-600 mb-2">
              <% if attrs_global %>
                Sample: first <%= mp[:shown_rows] %> <%= row_label(@project, plural: true) %>
                × first <%= mp[:shown_cols] %> columns
                <% if mp[:shown_cols].to_i < mp[:nber_cols].to_i %>
                  <span class="text-gray-500">(table has <%= mp[:nber_cols] %> columns total)</span>
                <% end %>
              <% else %>
                Sample: first <%= mp[:shown_rows] %> <%= component_label_singular.pluralize(mp[:shown_rows]) %>
                × first <%= mp[:shown_cols] %> <%= entry_label_singular.pluralize(mp[:shown_cols]) %>
              <% end %>
            </p>
            <div class="overflow-x-auto border border-gray-200 rounded-lg">
              <table class="min-w-full divide-y divide-gray-200 text-sm">
                <thead class="bg-gray-50">
                  <tr>
                    <% unless attrs_global %>
                      <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-r border-gray-200">
                        <%= component_label_singular.capitalize %> \ <%= entry_label_singular.capitalize %>
                      </th>
                    <% end %>
                    <% (0...mp[:shown_cols]).each do |j| %>
                      <th class="px-3 py-2 text-center text-xs font-medium text-gray-500 tracking-wider">
                        <% if ch.is_a?(Array) && ch[j].present? %>
                          <%= ch[j].to_s %>
                        <% elsif attrs_global %>
                          <%= "Column #{j + 1}" %>
                        <% else %>
                          <%= entry_label_singular.capitalize %> <%= j + 1 %>
                        <% end %>
                      </th>
                    <% end %>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  <% mp[:rows].each_with_index do |row, i| %>
                    <tr class="hover:bg-gray-50">
                      <% unless attrs_global %>
                        <td class="px-3 py-2 text-xs font-medium text-gray-900 bg-gray-50 border-r border-gray-200">
                          <%= component_label_singular.capitalize %> <%= i + 1 %>
                        </td>
                      <% end %>
                      <% row.each do |cell| %>
                        <td class="px-3 py-2 text-xs text-gray-700 text-center">
                          <%= (number_with_precision(cell, precision: 3) rescue cell.to_s) %>
                        </td>
                      <% end %>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% elsif @annot.dim == 3 %>
          <%# Expression Matrix Preview %>
          <% if @preview_data && @preview_data.any? %>
            <div class="mb-4">
              <p class="text-sm text-gray-600 mb-2">
                Sample: 10 <%= row_label(@project, plural: false) %> × up to 10 <%= col_label(@project, plural: false) %>
                <span class="text-gray-500">(showing first 10 rows)</span>
              </p>
              <div class="overflow-x-auto border border-gray-200 rounded-lg">
                <table class="min-w-full divide-y divide-gray-200 text-sm">
                  <thead class="bg-gray-50">
                    <tr>
                      <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-r border-gray-200">
                        <%= row_label(@project, plural: false).capitalize %> \ <%= col_label(@project, plural: false).capitalize %>
                      </th>
                      <% (0..[@preview_data.first&.length.to_i - 1, 9].min).each do |j| %>
                        <th class="px-3 py-2 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
                          <%= col_label(@project, plural: false).capitalize %> <%= j + 1 %>
                        </th>
                      <% end %>
                    </tr>
                  </thead>
                  <tbody class="bg-white divide-y divide-gray-200">
                    <% @preview_data.first(10).each_with_index do |row, i| %>
                      <tr class="hover:bg-gray-50">
                        <td class="px-3 py-2 text-xs font-medium text-gray-900 bg-gray-50 border-r border-gray-200">
                          <%= row_label(@project, plural: false).capitalize %> <%= i + 1 %>
                        </td>
                        <% (0..[row.length - 1, 9].min).each do |j| %>
                          <td class="px-3 py-2 text-xs text-gray-700 text-center">
                            <%= number_with_precision(row[j], precision: 2) rescue row[j].to_s %>
                          </td>
                        <% end %>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          <% else %>
            <p class="text-sm text-gray-500">No preview data available</p>
          <% end %>
        <% else %>
          <%# Metadata Preview %>
          <% if @h_results['values'] && @h_results['values'].any? %>
            <div class="mb-4">
              <p class="text-sm text-gray-600 mb-2">
                <%= number_with_delimiter(@h_results['values'].size) %> values
                <% if @h_results['values'].uniq.size != @h_results['values'].size %>
                  (<%= number_with_delimiter(@h_results['values'].uniq.size) %> unique)
                <% end %>
              </p>
              <div class="overflow-x-auto border border-gray-200 rounded-lg max-h-96">
                <table class="min-w-full divide-y divide-gray-200 text-sm">
                  <thead class="bg-gray-50 sticky top-0">
                    <tr>
                      <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Index</th>
                      <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Value</th>
                    </tr>
                  </thead>
                  <tbody class="bg-white divide-y divide-gray-200">
                    <% @preview_data.each_with_index do |value, i| %>
                      <tr class="hover:bg-gray-50">
                        <td class="px-4 py-2 text-xs text-gray-500"><%= i %></td>
                        <td class="px-4 py-2 text-xs text-gray-900 font-mono">
                          <%= value.is_a?(Hash) ? value.to_json : value.to_s %>
                        </td>
                      </tr>
                    <% end %>
                    <% if @h_results['values'].size > 100 %>
                      <tr>
                        <td colspan="2" class="px-4 py-2 text-xs text-gray-500 text-center italic">
                          ... and <%= number_with_delimiter(@h_results['values'].size - 100) %> more values
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          <% else %>
            <p class="text-sm text-gray-500">No preview data available</p>
          <% end %>
        <% end %>
      </div>

      <!-- Distribution Plot Card -->
      <% if @annot.dim == 3 %>
        <%# Expression Matrix Distributions %>
        <% if @h_sums && @h_sums.any? %>
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="flex items-center justify-between mb-4">
              <h4 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
                <i class="fas fa-chart-bar text-blue-600"></i>
                Distribution
              </h4>
              <label class="flex items-center gap-2 text-sm text-gray-600">
                <span>X-axis scale</span>
                <select class="annot-scale-select border border-gray-300 rounded px-2 py-1 text-sm bg-white text-gray-700 cursor-pointer"
                        data-plot-group="expression"
                        data-scale-axis="x">
                  <option value="linear">Linear</option>
                  <option value="log" selected>Log</option>
                </select>
              </label>
            </div>
            <div class="space-y-6">
              <% @h_sums.each_key do |k| %>
                <% linear_bins = @h_sums[k].dig(:linear, :bin_counts) %>
                <% if linear_bins.present? %>
                  <div>
                    <h5 class="text-sm font-medium text-gray-700 mb-2">
                      <%= (k == :sum) ? 'Distribution of total counts by ' + row_label(@project, plural: false) : 'Distribution of total counts by ' + col_label(@project, plural: false) %>
                    </h5>
                    <canvas id="plotly_histo_<%= k %>" style="width: 100%; height: 300px;"></canvas>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% elsif @annot.data_type && (@annot.data_type.name == 'NUMERIC' || @annot.data_type_id == 1) && @histogram&.dig(:linear, :bin_counts).present? %>
        <%# Numerical Metadata Histogram %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <div class="flex items-center justify-between mb-4">
            <h4 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
              <i class="fas fa-chart-bar text-blue-600"></i>
              Distribution
            </h4>
            <label class="flex items-center gap-2 text-sm text-gray-600">
              <span>X-axis scale</span>
              <select class="annot-scale-select border border-gray-300 rounded px-2 py-1 text-sm bg-white text-gray-700 cursor-pointer"
                      data-plot-group="numeric"
                      data-scale-axis="x">
                <option value="linear">Linear</option>
                <option value="log" selected>Log</option>
              </select>
            </label>
          </div>
          <canvas id="plotly_histo" style="width: 100%; height: 400px;"></canvas>
        </div>
      <% elsif @annot.data_type && (@annot.data_type.name == 'CATEGORICAL' || @annot.data_type_id == 3) && @h_counts && @h_counts.any? %>
        <%# Categorical Metadata Bar Chart %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <div class="flex items-center justify-between mb-4">
            <h4 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
              <i class="fas fa-chart-bar text-blue-600"></i>
              Distribution
              <span class="text-sm font-normal text-gray-500">(Top 25 categories)</span>
            </h4>
            <label class="flex items-center gap-2 text-sm text-gray-600">
              <span>Y-axis scale</span>
              <select class="annot-scale-select border border-gray-300 rounded px-2 py-1 text-sm bg-white text-gray-700 cursor-pointer"
                      data-plot-group="categorical"
                      data-scale-axis="y">
                <option value="linear">Linear</option>
                <option value="log" selected>Log</option>
              </select>
            </label>
          </div>
          <canvas id="plotly_histo" style="width: 100%; height: 400px;"></canvas>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% if @data_type_options %>
  <div id="edit-data-type-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-black/40"
         onclick="document.getElementById('edit-data-type-modal').classList.add('hidden')"></div>
    <div class="relative bg-white rounded-lg shadow-xl w-full max-w-lg mx-4">
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900">Edit data type</h3>
        <button type="button"
                aria-label="Close"
                onclick="document.getElementById('edit-data-type-modal').classList.add('hidden')"
                class="text-gray-400 hover:text-gray-600 transition-colors cursor-pointer">
          <i class="fas fa-times text-lg"></i>
        </button>
      </div>
      <div class="px-6 py-5">
        <p class="text-sm text-gray-600 mb-4">
          Change the data type of <span class="font-mono text-gray-900"><%= @annot.name %></span>.
          The change is applied to every loom file in this project that contains an annotation with the same name.
          The storage type is updated automatically to match the new data type.
        </p>
        <%= render 'data_type_form',
                   annot: @annot,
                   data_type_options: @data_type_options,
                   disabled_data_type_ids: @disabled_data_type_ids,
                   back_params: { from: params[:from], run_id: params[:run_id], step_id: params[:step_id] }.compact %>
      </div>
    </div>
  </div>
<% end %>

<%= javascript_tag do %>
// Canvas-based chart rendering (matching CustomPlotManager style)
var annotPlotRegistry = {};

function formatTickValue(val, maxCount) {
  if (val === 0) return '0';
  if (val < 0.01) return val.toExponential(1);
  if (val === Math.floor(val)) return val.toString();
  if (maxCount <= 1) return val.toFixed(2);
  if (maxCount <= 10) return val.toFixed(1);
  return Math.round(val).toString();
}

function generateLogTicks(min, max, base) {
  if (!Number.isFinite(min) || !Number.isFinite(max) || min <= 0 || max <= 0 || min >= max) {
    return [min, max].filter(function(v) { return v > 0; });
  }
  var ticks = [];
  var startPower = Math.floor(Math.log(min) / Math.log(base));
  var endPower = Math.ceil(Math.log(max) / Math.log(base));
  for (var power = startPower; power <= endPower; power++) {
    var tick = Math.pow(base, power);
    if (tick >= min && tick <= max) {
      ticks.push(tick);
    }
  }
  if (ticks.length === 0) {
    ticks.push(min, max);
  }
  return ticks;
}

function valueToBarHeight(value, maxCount, plotHeight, yLogScale) {
  if (value <= 0) return 0;
  if (!yLogScale) {
    return (value / maxCount) * plotHeight;
  }
  if (maxCount <= 1) return plotHeight;
  return (Math.log10(value) / Math.log10(maxCount)) * plotHeight;
}

function getYTickValues(maxCount, yLogScale, numYTicks) {
  if (!yLogScale) {
    var linearTicks = [];
    for (var i = 0; i <= numYTicks; i++) {
      linearTicks.push((maxCount / numYTicks) * i);
    }
    return linearTicks;
  }
  return generateLogTicks(1, maxCount, 10);
}

function formatAxisValue(value) {
  if (typeof value !== 'number' || !Number.isFinite(value)) return String(value);
  if (value === 0) return '0';
  var abs = Math.abs(value);
  if (abs < 0.01 || abs >= 10000) return value.toExponential(1);
  if (abs >= 100) return Math.round(value).toString();
  if (abs >= 10) return value.toFixed(1);
  return value.toFixed(2);
}

function drawYAxis(ctx, options) {
  var leftPadding = options.leftPadding;
  var topPadding = options.topPadding;
  var height = options.height;
  var bottomPadding = options.bottomPadding;
  var plotHeight = options.plotHeight;
  var maxCount = options.maxCount;
  var yLogScale = options.yLogScale;
  var numYTicks = options.numYTicks || 5;
  var axisStroke = '#9ca3af';

  ctx.strokeStyle = axisStroke;
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(leftPadding, topPadding);
  ctx.lineTo(leftPadding, height - bottomPadding);
  ctx.stroke();

  ctx.fillStyle = '#374151';
  ctx.font = '11px sans-serif';
  ctx.textAlign = 'right';
  ctx.textBaseline = 'middle';

  var yTickValues = getYTickValues(maxCount, yLogScale, numYTicks);
  yTickValues.forEach(function(value) {
    var barHeight = valueToBarHeight(value, maxCount, plotHeight, yLogScale);
    var y = height - bottomPadding - barHeight;

    ctx.beginPath();
    ctx.moveTo(leftPadding, y);
    ctx.lineTo(leftPadding - 5, y);
    ctx.stroke();

    ctx.fillText(formatTickValue(value, maxCount), leftPadding - 8, y);
  });

  ctx.save();
  ctx.translate(15, height / 2);
  ctx.rotate(-Math.PI / 2);
  ctx.textAlign = 'center';
  ctx.fillStyle = '#374151';
  ctx.font = '13px sans-serif';
  ctx.fillText('Frequency' + (yLogScale ? ' (log)' : ''), 0, 0);
  ctx.restore();
}

function valueToXPosition(value, minVal, maxVal, plotWidth, xLogScale) {
  if (!Number.isFinite(value) || !Number.isFinite(minVal) || !Number.isFinite(maxVal)) return null;
  if (!xLogScale) {
    if (maxVal === minVal) return plotWidth / 2;
    return ((value - minVal) / (maxVal - minVal)) * plotWidth;
  }
  if (value <= 0 || minVal <= 0 || maxVal <= 0) return null;
  var logMin = Math.log10(minVal);
  var logMax = Math.log10(maxVal);
  if (logMax === logMin) return plotWidth / 2;
  return ((Math.log10(value) - logMin) / (logMax - logMin)) * plotWidth;
}

function selectHistogramSeries(plot, xLogScale) {
  if (xLogScale && plot.log && plot.log.binCounts && plot.log.binCounts.length > 0 && plot.log.min > 0) {
    return { series: plot.log, xLogScale: true };
  }
  return { series: plot.linear, xLogScale: false };
}

function renderHistogram(plot, xLogScale) {
  var canvas = document.getElementById(plot.canvasId);
  if (!canvas) return;

  var selected = selectHistogramSeries(plot, xLogScale);
  var series = selected.series;
  if (!series || !series.binCounts || !series.binCounts.length) return;
  xLogScale = selected.xLogScale;

  var binCounts = series.binCounts;
  var binRanges = series.binRanges || [];
  var xMin = series.min;
  var xMax = series.max;

  var ctx = canvas.getContext('2d');
  var width = canvas.width = canvas.offsetWidth;
  var height = canvas.height = canvas.offsetHeight || 400;

  ctx.clearRect(0, 0, width, height);
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(0, 0, width, height);

  var topPadding = 40;
  var bottomPadding = 60;
  var leftPadding = 60;
  var rightPadding = 20;
  var plotWidth = width - leftPadding - rightPadding;
  var plotHeight = height - topPadding - bottomPadding;

  var maxCount = Math.max.apply(null, binCounts);
  if (maxCount === 0) return;

  ctx.fillStyle = '#374151';
  ctx.font = '14px sans-serif';
  ctx.textAlign = 'center';
  ctx.fillText(plot.title, width / 2, 20);

  var axisStroke = '#9ca3af';
  ctx.strokeStyle = axisStroke;
  ctx.lineWidth = 1;

  // Match visualization: equal-width bars; log/linear only changes how bins were built and tick labels.
  drawYAxis(ctx, {
    leftPadding: leftPadding,
    topPadding: topPadding,
    height: height,
    bottomPadding: bottomPadding,
    plotHeight: plotHeight,
    maxCount: maxCount,
    yLogScale: false
  });

  ctx.beginPath();
  ctx.moveTo(leftPadding, height - bottomPadding);
  ctx.lineTo(width - rightPadding, height - bottomPadding);
  ctx.stroke();

  var barWidth = plotWidth / binCounts.length;
  ctx.fillStyle = '#3b82f6';
  ctx.strokeStyle = '#2563eb';
  ctx.lineWidth = 0.5;

  binCounts.forEach(function(count, i) {
    if (!(count > 0)) return;
    var barHeight = valueToBarHeight(count, maxCount, plotHeight, false);
    var x = leftPadding + i * barWidth;
    var y = height - bottomPadding - barHeight;
    ctx.fillRect(x, y, Math.max(1, barWidth - 1), barHeight);
    ctx.strokeRect(x, y, Math.max(1, barWidth - 1), barHeight);
  });

  ctx.fillStyle = '#374151';
  ctx.font = '13px sans-serif';
  ctx.textAlign = 'center';
  ctx.fillText(plot.xLabel + (xLogScale ? ' (log)' : ''), width / 2, height - bottomPadding + 40);

  ctx.font = '11px sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'top';
  ctx.strokeStyle = axisStroke;

  var xTickValues = xLogScale
    ? generateLogTicks(xMin, xMax, 10)
    : (function() {
        var ticks = [];
        var numXTicks = 6;
        for (var i = 0; i < numXTicks; i++) {
          ticks.push(xMin + (i / (numXTicks - 1)) * (xMax - xMin));
        }
        return ticks;
      })();

  xTickValues.forEach(function(value) {
    var xPos = valueToXPosition(value, xMin, xMax, plotWidth, xLogScale);
    if (xPos == null) return;
    var x = leftPadding + xPos;

    ctx.beginPath();
    ctx.moveTo(x, height - bottomPadding);
    ctx.lineTo(x, height - bottomPadding + 5);
    ctx.stroke();

    ctx.fillText(formatAxisValue(value), x, height - bottomPadding + 8);
  });
}

function renderBarChart(canvasId, categories, counts, title, xLabel, yLogScale) {
  var canvas = document.getElementById(canvasId);
  if (!canvas) return;

  var ctx = canvas.getContext('2d');
  var width = canvas.width = canvas.offsetWidth;
  var height = canvas.height = canvas.offsetHeight || 400;

  ctx.clearRect(0, 0, width, height);
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(0, 0, width, height);

  var topPadding = 40;
  var bottomPadding = 100;
  var leftPadding = 60;
  var rightPadding = 20;
  var plotWidth = width - leftPadding - rightPadding;
  var plotHeight = height - topPadding - bottomPadding;

  var maxCount = Math.max.apply(null, counts);
  if (maxCount === 0) return;

  ctx.fillStyle = '#374151';
  ctx.font = '14px sans-serif';
  ctx.textAlign = 'center';
  ctx.fillText(title, width / 2, 20);

  var axisStroke = '#9ca3af';
  ctx.strokeStyle = axisStroke;
  ctx.lineWidth = 1;

  drawYAxis(ctx, {
    leftPadding: leftPadding,
    topPadding: topPadding,
    height: height,
    bottomPadding: bottomPadding,
    plotHeight: plotHeight,
    maxCount: maxCount,
    yLogScale: yLogScale
  });

  ctx.beginPath();
  ctx.moveTo(leftPadding, height - bottomPadding);
  ctx.lineTo(width - rightPadding, height - bottomPadding);
  ctx.stroke();

  var barWidth = (plotWidth / categories.length) * 0.8;
  var barSpacing = (plotWidth / categories.length) * 0.2;
  ctx.fillStyle = '#3b82f6';
  ctx.strokeStyle = '#2563eb';
  ctx.lineWidth = 0.5;

  categories.forEach(function(category, i) {
    if (counts[i] > 0) {
      var barHeight = valueToBarHeight(counts[i], maxCount, plotHeight, yLogScale);
      var x = leftPadding + i * (barWidth + barSpacing) + barSpacing / 2;
      var y = height - bottomPadding - barHeight;

      ctx.fillRect(x, y, barWidth, barHeight);
      ctx.strokeRect(x, y, barWidth, barHeight);
    }
  });

  ctx.fillStyle = '#374151';
  ctx.font = '13px sans-serif';
  ctx.textAlign = 'center';
  ctx.fillText(xLabel, width / 2, height - bottomPadding + 28);

  ctx.font = '10px sans-serif';
  categories.forEach(function(category, i) {
    var x = leftPadding + i * (barWidth + barSpacing) + barSpacing / 2 + barWidth / 2;
    var y = height - bottomPadding + 8;

    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(-Math.PI / 4);
    ctx.textAlign = 'right';
    var label = category.length > 15 ? category.substring(0, 12) + '...' : category;
    ctx.fillText(label, 0, 0);
    ctx.restore();
  });
}

function registerAnnotPlot(group, plotConfig) {
  if (!annotPlotRegistry[group]) {
    annotPlotRegistry[group] = [];
  }
  annotPlotRegistry[group].push(plotConfig);
}

function renderAnnotPlotGroup(group, logScale) {
  var plots = annotPlotRegistry[group] || [];
  plots.forEach(function(plot) {
    if (plot.type === 'histogram') {
      // Continuous value distributions: switch between pre-binned linear/log series
      // (same approach as visualization range-slider histograms).
      renderHistogram(plot, logScale);
    } else if (plot.type === 'bar') {
      // Categorical bars: log belongs on the y (frequency) axis.
      renderBarChart(plot.canvasId, plot.categories, plot.counts, plot.title, plot.xLabel, logScale);
    }
  });
}

function initAnnotScaleControls() {
  document.querySelectorAll('.annot-scale-select').forEach(function(select) {
    var group = select.getAttribute('data-plot-group');
    renderAnnotPlotGroup(group, select.value === 'log');
    select.addEventListener('change', function() {
      renderAnnotPlotGroup(group, select.value === 'log');
    });
  });
}

<% if @annot.dim == 3 %>
  <%# Expression Matrix Distribution Plots %>
  <% @h_sums.each_key do |k| %>
    <% linear = @h_sums[k][:linear] %>
    <% log = @h_sums[k][:log] %>
    <% if linear && linear[:bin_counts].present? %>
      (function() {
        var title = '<%= (k == :sum) ? "Distribution of total counts by " + row_label(@project, plural: false) : "Distribution of total counts by " + col_label(@project, plural: false) %>';
        registerAnnotPlot('expression', {
          type: 'histogram',
          canvasId: 'plotly_histo_<%= k %>',
          title: title,
          xLabel: 'Count',
          linear: {
            binCounts: <%= raw linear[:bin_counts].to_json %>,
            binRanges: <%= raw (linear[:bin_ranges] || []).to_json %>,
            min: <%= raw linear[:min].to_json %>,
            max: <%= raw linear[:max].to_json %>
          },
          log: {
            binCounts: <%= raw (log && log[:bin_counts] ? log[:bin_counts] : []).to_json %>,
            binRanges: <%= raw (log && log[:bin_ranges] ? log[:bin_ranges] : []).to_json %>,
            min: <%= raw (log && log[:min] ? log[:min] : nil).to_json %>,
            max: <%= raw (log && log[:max] ? log[:max] : nil).to_json %>
          }
        });
      })();
    <% end %>
  <% end %>
<% elsif @annot.data_type && (@annot.data_type.name == 'NUMERIC' || @annot.data_type_id == 1) && @histogram&.dig(:linear, :bin_counts).present? %>
  <%# Numerical Metadata Histogram %>
  <% linear = @histogram[:linear] %>
  <% log = @histogram[:log] %>
  (function() {
    registerAnnotPlot('numeric', {
      type: 'histogram',
      canvasId: 'plotly_histo',
      title: 'Value Distribution',
      xLabel: '<%= format_annot_name(@annot.name) %>',
      linear: {
        binCounts: <%= raw linear[:bin_counts].to_json %>,
        binRanges: <%= raw (linear[:bin_ranges] || []).to_json %>,
        min: <%= raw linear[:min].to_json %>,
        max: <%= raw linear[:max].to_json %>
      },
      log: {
        binCounts: <%= raw (log && log[:bin_counts] ? log[:bin_counts] : []).to_json %>,
        binRanges: <%= raw (log && log[:bin_ranges] ? log[:bin_ranges] : []).to_json %>,
        min: <%= raw (log && log[:min] ? log[:min] : nil).to_json %>,
        max: <%= raw (log && log[:max] ? log[:max] : nil).to_json %>
      }
    });
  })();
<% elsif @annot.data_type && (@annot.data_type.name == 'CATEGORICAL' || @annot.data_type_id == 3) && @h_counts && @h_counts.any? %>
  <%# Categorical Metadata Bar Chart %>
  <% ordered_keys = @h_counts.keys.sort { |a, b| @h_counts[b] <=> @h_counts[a] }.first(25) %>
  (function() {
    var categories = <%= raw ordered_keys.to_json %>;
    var counts = <%= raw ordered_keys.map { |k| @h_counts[k] }.to_json %>;
    registerAnnotPlot('categorical', {
      type: 'bar',
      canvasId: 'plotly_histo',
      categories: categories,
      counts: counts,
      title: 'Category Distribution',
      xLabel: '<%= format_annot_name(@annot.name) %>'
    });
  })();
<% end %>

initAnnotScaleControls();

<% if @sim_step_options && @annot.imported? %>
(function() {
  var select = document.getElementById('annot-sim-step-id');
  if (!select) return;
  var status = document.getElementById('annot-sim-step-status');
  var csrfToken = document.querySelector('meta[name="csrf-token"]');
  select.addEventListener('change', function() {
    var url = select.getAttribute('data-update-url');
    if (!url) return;
    if (status) {
      status.classList.add('hidden');
      status.textContent = 'Saving...';
      status.classList.remove('hidden', 'text-green-600', 'text-red-600');
      status.classList.add('text-gray-500');
    }
    fetch(url, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-CSRF-Token': csrfToken ? csrfToken.content : ''
      },
      credentials: 'same-origin',
      body: JSON.stringify({ annot: { sim_step_id: select.value } })
    })
      .then(function(r) { return r.json().then(function(data) { return { ok: r.ok, data: data }; }); })
      .then(function(res) {
        if (!status) return;
        if (res.ok) {
          status.textContent = 'Saved';
          status.classList.remove('text-gray-500', 'text-red-600', 'hidden');
          status.classList.add('text-green-600');
          setTimeout(function() { status.classList.add('hidden'); }, 2000);
        } else {
          status.textContent = res.data.error || 'Save failed';
          status.classList.remove('text-gray-500', 'text-green-600', 'hidden');
          status.classList.add('text-red-600');
        }
      })
      .catch(function() {
        if (!status) return;
        status.textContent = 'Save failed';
        status.classList.remove('text-gray-500', 'text-green-600', 'hidden');
        status.classList.add('text-red-600');
      });
  });
})();
<% end %>
<% end %>
