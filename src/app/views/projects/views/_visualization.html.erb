<!-- Load PIXI.js globally -->
<script src="https://cdn.jsdelivr.net/npm/pixi.js@7.4.2/dist/pixi.min.js"></script>

<!-- Global color palette for visualization -->
<script>
  console.log('🎨 Visualization view script executing...');
  try {
    console.log('🎨 Attempting to load colors from server...');
    var colors = <%= raw category_colors.to_json %>;
    console.log('🎨 Raw colors from server:', colors);
    console.log('🎨 Colors type:', typeof colors);
    console.log('🎨 Colors length:', colors ? colors.length : 'null/undefined');
    
    window.CATEGORY_COLORS = colors;
    console.log('🎨 window.CATEGORY_COLORS set to:', window.CATEGORY_COLORS);
    
    if (!window.CATEGORY_COLORS || window.CATEGORY_COLORS.length === 0) {
      console.error('No colors loaded from server configuration!');
    } else {
      console.log('Colors loaded successfully in visualization view!');
    }
  } catch (error) {
    console.error('Error loading colors from server:', error);
    console.error('Error stack:', error.stack);
    window.CATEGORY_COLORS = null;
  }
</script>

<div data-controller="visualization" 
     data-visualization-embeddings-by-loom-value="<%= @all_embeddings_by_loom.to_json %>"
     data-visualization-default-loom-file-value="<%= @default_loom_file %>"
     style="display: flex; flex-direction: row; height: 100vh; width: 100vw; margin: 0; padding: 0;">
  
  <!-- Left Panel: Metadata -->
  <div style="width: 380px; height: 100vh; background-color: white; border-right: 1px solid #e5e7eb; display: flex; flex-direction: column;">
    
    <div style="padding: 20px; border-bottom: 1px solid #e5e7eb;">
      <h2 style="margin: 0; font-size: 18px; font-weight: 600;">Cell Metadata</h2>
      <p style="margin: 5px 0 0 0; font-size: 14px; color: #6b7280;">Select metadata to color the plot</p>
    </div>
    <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden;">
      <!-- Categorical Metadata Section -->
      <div style="height: 50%; display: flex; flex-direction: column; border-bottom: 1px solid #e5e7eb;">
        <div style="padding: 16px; border-bottom: 1px solid #e5e7eb;">
          <h3 style="margin: 0; font-size: 14px; font-weight: 500;">Categorical Metadata</h3>
        </div>
        <div style="flex: 1; padding: 16px; overflow-y: auto; min-height: 0;">
          <% if @h_metadata[@default_loom_file] %>
            <% @h_metadata[@default_loom_file]['cell']['DISCRETE'].each do |metadata| %>
              <div style="border: 1px solid #e5e7eb; border-radius: 8px; margin-bottom: 8px;" data-metadata-item="<%= metadata.id %>">
                <div style="display: flex; align-items: center; padding: 8px; cursor: pointer; transition: background-color 0.2s;" 
                     onmouseover="this.style.backgroundColor='#f9fafb'" 
                     onmouseout="this.style.backgroundColor=''"
                     data-action="click->visualization#toggleMetadata">
                  <!-- Chevron -->
                  <div style="margin-right: 12px; color: #9ca3af; transition: transform 0.2s;">
                    <svg style="width: 12px; height: 12px;" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                    </svg>
                  </div>
                <!-- Global Checkbox (hidden by default) -->
                <div class="metadata-checkbox" 
                     data-metadata-id="<%= metadata.id %>"
                     data-action="click->visualization#toggleMetadataSelection"
                     style="margin-right: 8px; cursor: pointer; display: none; align-items: center; justify-content: center; width: 20px; height: 20px; border: 2px solid #d1d5db; border-radius: 4px; background-color: #10b981; transition: all 0.2s;"
                     onmouseover="this.style.borderColor='#059669'"
                     onmouseout="this.style.borderColor='#d1d5db'">
                  <i class="fas fa-check" style="color: white; font-size: 12px; display: block;"></i>
                </div>
                <!-- Content -->
                <div style="flex: 1; min-width: 0; margin-right: 8px;">
                  <div style="font-size: 14px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= metadata.display_name %>"><%= metadata.display_name %></div>
                  <div style="font-size: 12px; color: #6b7280;"><%= metadata.nber_cats || 0 %> categories</div>
                </div>
                  <!-- Hidden Radio -->
                  <input type="radio" name="color_by" value="<%= metadata.id %>" style="display: none;">
                  <!-- Water Drop Button -->
                  <button style="padding: 4px; color: #9ca3af; background: none; border: none; border-radius: 4px; cursor: pointer; transition: all 0.2s;" 
                          onmouseover="if(this.dataset.active !== 'true') { this.style.color='#6b7280'; this.style.backgroundColor='#f3f4f6'; }" 
                          onmouseout="if(this.dataset.active !== 'true') { this.style.color='#9ca3af'; this.style.backgroundColor=''; }"
                          data-action="click->visualization#waterDropClicked mouseenter->visualization#preloadMetadataVector"
                          data-metadata-name="<%= metadata.display_name %>"
                          data-metadata-id="<%= metadata.id %>"
                          data-active="false"
                          onclick="event.stopPropagation()">
                    <i class="fas fa-palette" style="font-size: 16px;"></i>
                  </button>
                </div>
                <!-- Categories (initially hidden) -->
                <div style="padding-left: 32px; padding-bottom: 8px; display: none;">
                  <% if metadata.categories_json.present? %>
                    <% begin %>
                      <% categories = JSON.parse(metadata.categories_json) %>
                      <% if categories.is_a?(Hash) %>
                        <% 
                          # Sort categories by count (largest to smallest) to match plot ordering
                          sorted_categories = categories.sort_by { |category, count| -count }
                        %>
                        <% sorted_categories.each_with_index do |(category, count), index| %>
                          <% 
                            # Use the same color palette as the JavaScript plot
                            # Index is now based on sorted order (largest to smallest)
                            category_color = category_colors[index % category_colors.length]
                          %>
                          <div style="display: flex; justify-content: space-between; align-items: center; padding: 4px 8px; font-size: 12px;">
                            <div style="display: flex; align-items: center; gap: 6px;">
                              <!-- Category Checkbox -->
                              <div class="category-checkbox" 
                                   data-metadata-id="<%= metadata.id %>"
                                   data-category="<%= category %>"
                                   data-action="click->visualization#toggleCategorySelection"
                                   style="cursor: pointer; display: none; align-items: center; justify-content: center; width: 16px; height: 16px; border: 2px solid #d1d5db; border-radius: 3px; background-color: #10b981; transition: all 0.2s;"
                                   onmouseover="this.style.borderColor='#059669'"
                                   onmouseout="this.style.borderColor='#d1d5db'">
                                <i class="fas fa-check" style="color: white; font-size: 10px; display: block;"></i>
                              </div>
                              <span style="color: #374151;"><%= category %></span>
                            </div>
                            <span style="color: #6b7280; font-weight: 500;"><%= count %></span>
                          </div>
                        <% end %>
                      <% elsif categories.is_a?(Array) %>
                        <% categories.each_with_index do |category, index| %>
                          <% 
                            # Use the same color palette as the JavaScript plot
                            category_index = categories.index(category)
                            category_color = category_colors[category_index % category_colors.length]
                          %>
                          <div style="display: flex; justify-content: space-between; align-items: center; padding: 4px 8px; font-size: 12px;">
                            <div style="display: flex; align-items: center; gap: 6px;">
                              <!-- Category Checkbox -->
                              <div class="category-checkbox" 
                                   data-metadata-id="<%= metadata.id %>"
                                   data-category="<%= category %>"
                                   data-action="click->visualization#toggleCategorySelection"
                                   style="cursor: pointer; display: none; align-items: center; justify-content: center; width: 16px; height: 16px; border: 2px solid #d1d5db; border-radius: 3px; background-color: #10b981; transition: all 0.2s;"
                                   onmouseover="this.style.borderColor='#059669'"
                                   onmouseout="this.style.borderColor='#d1d5db'">
                                <i class="fas fa-check" style="color: white; font-size: 10px; display: block;"></i>
                              </div>
                              <span style="color: #374151;"><%= category %></span>
                            </div>
                            <span style="color: #6b7280; font-weight: 500;">Category <%= index + 1 %></span>
                          </div>
                        <% end %>
                      <% end %>
                    <% rescue JSON::ParserError %>
                      <div style="font-size: 12px; color: #6b7280; padding: 8px;">Unable to parse categories</div>
                    <% end %>
                  <% else %>
                    <div style="font-size: 12px; color: #6b7280; padding: 8px;">No category data available</div>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% else %>
            <p style="color: #6b7280; font-size: 14px;">No categorical metadata available</p>
          <% end %>
        </div>
      </div>

      <!-- Draggable Divider -->
      <div id="metadata-divider" style="height: 4px; background-color: #d1d5db; cursor: row-resize; border-top: 1px solid #e5e7eb; border-bottom: 1px solid #e5e7eb; position: relative; transition: background-color 0.2s;" 
           onmouseover="this.style.backgroundColor='#9ca3af'" 
           onmouseout="this.style.backgroundColor='#d1d5db'">
        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 32px; height: 2px; background-color: #9ca3af; border-radius: 1px;"></div>
      </div>

      <!-- Continuous Metadata Section -->
      <div style="height: 50%; display: flex; flex-direction: column;">
        <div style="padding: 16px; border-bottom: 1px solid #e5e7eb;">
          <h3 style="margin: 0; font-size: 14px; font-weight: 500;">Continuous Metadata</h3>
        </div>
        <div style="flex: 1; padding: 16px; overflow-y: auto; min-height: 0;">
          <% if @h_metadata[@default_loom_file] %>
            <% @h_metadata[@default_loom_file]['cell']['NUMERIC'].each do |metadata| %>
              <div style="display: flex; align-items: center; padding: 8px; border-radius: 8px; cursor: pointer; transition: background-color 0.2s; margin-bottom: 4px;"
                   onmouseover="this.style.backgroundColor='#f9fafb'" 
                   onmouseout="this.style.backgroundColor=''">
                <!-- Radio Button -->
                <!--<input type="radio" name="color_by" value="<%= metadata.id %>" style="margin-right: 12px;">-->
                <!-- Content -->
                <div style="flex: 1; min-width: 0; margin-right: 8px;">
                  <div style="font-size: 14px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= metadata.display_name %>"><%= metadata.display_name %></div>
                 <!-- <div style="font-size: 12px; color: #6b7280;">
                    Range: <%= metadata.min_val&.round(2) || 'N/A' %> - <%= metadata.max_val&.round(2) || 'N/A' %>
                  </div>-->
                </div>
                <!-- Water Drop Button -->
                <button style="padding: 4px; color: #9ca3af; background: none; border: none; border-radius: 4px; cursor: pointer; transition: all 0.2s;" 
                        onmouseover="this.style.color='#6b7280'; this.style.backgroundColor='#f3f4f6'" 
                        onmouseout="this.style.color='#9ca3af'; this.style.backgroundColor=''"
                        data-action="click->visualization#waterDropClicked"
                        data-metadata-name="<%= metadata.display_name %>">
                  <i class="fas fa-palette" style="font-size: 16px;"></i>
                </button>
              </div>
            <% end %>
          <% else %>
            <p style="color: #6b7280; font-size: 14px;">No continuous metadata available</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content: UMAP Plot -->
  <div style="flex: 1; height: 100vh; background-color: #f9fafb; display: flex; flex-direction: column;">
    <div style="padding: 15px; background-color: white; border-bottom: 1px solid #e5e7eb;">
      <h2 style="margin: 0; font-size: 18px; font-weight: 600;">UMAP Visualization</h2>
    </div>
    
    <!-- Menu Bar -->
    <div style="display: flex; align-items: center; gap: 16px;justify-content: space-between; padding: 16px; background-color: white; border-bottom: 1px solid #e5e7eb;">
      <!-- Left side: Loom file and Metadata Selection -->
      <div style="display: flex; align-items: center; gap: 16px;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <select data-visualization-target="loomFileSelect" 
                  data-action="change->visualization#updateEmbeddings"
                  style="font-size: 14px; border: 1px solid #d1d5db; border-radius: 4px; padding: 4px 8px;">
            <% @available_loom_files.each do |filepath| %>
              <option value="<%= filepath %>">
                <%= filepath.split('/').first.capitalize %>
              </option>
            <% end %>
          </select>
        </div>
        
        <div style="display: flex; align-items: center; gap: 8px;">
          <select data-visualization-target="metadataSelect" 
                  data-action="change->visualization#updateMetadata"
                  style="font-size: 14px; border: 1px solid #d1d5db; border-radius: 4px; padding: 4px 8px;">
            <option value="">Select metadata...</option>
            <% if @h_metadata[@default_loom_file] && @h_metadata[@default_loom_file]['cell'] && @h_metadata[@default_loom_file]['cell']['NUMERIC'] %>
              <% @h_metadata[@default_loom_file]['cell']['NUMERIC'].select { |metadata| 
                   metadata.nber_rows && metadata.nber_rows >= 2 && metadata.nber_rows <= 50 && 
                   metadata.nber_cols && metadata.nber_cols == @project.nber_cols 
                 }.each do |metadata| %>
                <option value="<%= metadata.id %>">
                  <%= metadata.display_name %> (<%= metadata.nber_rows %> rows)
                </option>
              <% end %>
            <% end %>
          </select>
        </div>
      </div>

      <!-- Right side: Actions -->
      <div style="display: flex; align-items: center; gap: 8px; ml-1">
        <!-- Interaction Mode Buttons -->
        <div style="display: flex; align-items: center; gap: 8px;">
                    <div style="display: flex; border: 1px solid #d1d5db; border-radius: 4px; overflow: hidden;">
            <!-- Pan/Zoom Button -->
            <button id="pan-mode-btn"
                    style="padding: 6px 12px; font-size: 14px; background-color: #3b82f6; color: white; border: none; cursor: pointer; transition: background-color 0.2s; border-right: 1px solid #d1d5db;"
                    title="Pan/Zoom Mode"
                    data-action="click->visualization#setPanMode"
                    data-mode="pan">
              <i class="fas fa-arrows-alt" style="font-size: 14px;"></i>
            </button>
            
            <!-- Pick Mode Button -->
            <button id="pick-mode-btn"
                    style="padding: 6px 12px; font-size: 14px; background-color: #f3f4f6; color: #374151; border: none; cursor: pointer; transition: background-color 0.2s; border-right: 1px solid #d1d5db;"
                    title="Pick Mode - Click points for details"
                    data-action="click->visualization#setPickMode"
                    data-mode="pick">
              <i class="fas fa-mouse-pointer" style="font-size: 14px;"></i>
            </button>
            
            <!-- Lasso Button -->
            <button id="lasso-mode-btn"
                    style="padding: 6px 12px; font-size: 14px; background-color: #f3f4f6; color: #374151; border: none; cursor: pointer; transition: background-color 0.2s;"
                    title="Lasso Selection Mode"
                    data-action="click->visualization#setLassoMode"
                    data-mode="lasso">
              <%= render 'shared/lasso_icon' %>
            </button>
          </div>
        </div>
        
        <!-- Save Button (Icon Only) -->
        <button style="padding: 6px 12px; font-size: 14px; background-color: #f3f4f6; color: #374151; border: 1px solid #d1d5db; border-radius: 4px; cursor: pointer; transition: background-color 0.2s;" 
                title="Save as SVG"
                data-action="click->visualization#saveAsSVG"
                onmouseover="this.style.backgroundColor='#e5e7eb'" 
                onmouseout="this.style.backgroundColor='#f3f4f6'">
          <i class="fas fa-save" style="font-size: 14px;"></i>
        </button>
        
        <!-- Settings Button (Icon Only) -->
        <button id="settings-btn"
                style="padding: 6px 12px; font-size: 14px; background-color: #f3f4f6; color: #374151; border: 1px solid #d1d5db; border-radius: 4px; cursor: pointer; transition: background-color 0.2s;" 
                title="Plot Settings"
                data-action="click->visualization#toggleSettingsWindow"
                onmouseover="this.style.backgroundColor='#e5e7eb'" 
                onmouseout="this.style.backgroundColor='#f3f4f6'">
          <i class="fas fa-cog" style="font-size: 14px;"></i>
        </button>
        
        <!-- Fullscreen Button (Icon Only) -->
        <!--<button style="padding: 6px 12px; font-size: 14px; background-color: #f3f4f6; color: #374151; border-radius: 4px; border: none; cursor: pointer; transition: background-color 0.2s;" 
                title="Fullscreen"
                onmouseover="this.style.backgroundColor='#e5e7eb'" 
                onmouseout="this.style.backgroundColor='#f3f4f6'">
          <i class="fas fa-expand"></i>
        </button>
        -->
        <!-- Refresh Button (Icon Only) -->
        <!--<button style="padding: 6px 12px; font-size: 14px; background-color: #2563eb; color: white; border-radius: 4px; border: none; cursor: pointer; transition: background-color 0.2s;" 
                title="Refresh"
                onmouseover="this.style.backgroundColor='#1d4ed8'" 
                onmouseout="this.style.backgroundColor='#2563eb'">
          <i class="fas fa-sync"></i>
        </button>-->
      </div>
    </div>
    <div style="flex: 1; padding: 20px; display: flex; flex-direction: column;">
      <!-- Plot Container -->
      <div class="plot-container" style="flex: 1; border: 1px solid #e5e7eb; border-radius: 8px; background-color: white; position: relative; min-height: 400px;">
        <div id="plot-placeholder" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; color: #6b7280;">
          <h3 style="margin: 0 0 10px 0;">UMAP Plot</h3>
          <p style="margin: 0;">Select metadata from the dropdown to visualize</p>
        </div>
        
        <!-- Tooltip for point hover -->
        <div id="point-tooltip" style="position: absolute; background-color: rgba(0, 0, 0, 0.9); color: white; padding: 8px 12px; border-radius: 6px; font-size: 12px; pointer-events: none; z-index: 10000; display: none; max-width: 200px; word-wrap: break-word; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3); border: 1px solid rgba(255, 255, 255, 0.2);">
          <div id="tooltip-content"></div>
        </div>
      </div>
      
      <!-- Plot Controls -->
      <div style="margin-top: 10px; display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: #6b7280;">
        <div>
          <span>Controls: </span>
          <span>Drag to pan • Scroll to zoom (mouse-centered)</span>
        </div>
        <div id="plot-info" style="display: none;">
          <span id="point-count">0</span> points
        </div>
      </div>
    </div>
  </div>

  <!-- Right Panel: Split into Gene Expression and Selections -->
  <div style="width: 320px; height: 100vh; display: flex; flex-direction: column;">
    
    <!-- Top Section: Gene Expression Panel -->
    <div style="flex: 1; background-color: white; border-left: 1px solid #e5e7eb; display: flex; flex-direction: column;">
      <div style="padding: 20px; border-bottom: 1px solid #e5e7eb;">
        <h2 style="margin: 0; font-size: 18px; font-weight: 600;">Gene Expression</h2>
        <p style="margin: 5px 0 0 0; font-size: 14px; color: #6b7280;">Search and visualize gene expression</p>
      </div>
      <div style="flex: 1; padding: 20px; overflow-y: auto;">
        <p>Gene expression content will go here</p>
      </div>
    </div>

    <!-- Draggable Divider -->
    <div id="right-panel-divider" style="height: 4px; background-color: #d1d5db; cursor: row-resize; border-top: 1px solid #e5e7eb; border-bottom: 1px solid #e5e7eb; position: relative; transition: background-color 0.2s;" 
         onmouseover="this.style.backgroundColor='#9ca3af'" 
         onmouseout="this.style.backgroundColor='#d1d5db'">
      <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 32px; height: 2px; background-color: #9ca3af; border-radius: 1px;"></div>
    </div>

    <!-- Bottom Section: Selections Panel -->
    <div style="flex: 1; background-color: #f9fafb; display: flex; flex-direction: column;">
      <div style="padding: 20px; border-bottom: 1px solid #e5e7eb;">
        <h2 style="margin: 0; font-size: 18px; font-weight: 600;">Selections</h2>
        <p style="margin: 5px 0 0 0; font-size: 14px; color: #6b7280;">Manage cell and gene set selections</p>
      </div>

      <!-- Selection Tabs -->
      <div style="border-bottom: 1px solid #e5e7eb;">
        <nav style="display: flex; padding: 0 16px;">
          <button id="cells-tab" 
                  style="padding: 8px 16px; border-bottom: 2px solid #3b82f6; font-weight: 500; font-size: 14px; color: #3b82f6; background: none; border-top: none; border-left: none; border-right: none; cursor: pointer;"
                  data-action="click->visualization#switchSelectionTab"
                  data-tab="cells">
            Cells
          </button>
          <button id="gene-sets-tab" 
                  style="padding: 8px 16px; border-bottom: 2px solid transparent; font-weight: 500; font-size: 14px; color: #6b7280; background: none; border-top: none; border-left: none; border-right: none; cursor: pointer; transition: all 0.2s;"
                  onmouseover="this.style.color='#374151'; this.style.borderBottomColor='#d1d5db'"
                  onmouseout="this.style.color='#6b7280'; this.style.borderBottomColor='transparent'"
                  data-action="click->visualization#switchSelectionTab"
                  data-tab="gene-sets">
            Gene Sets
          </button>
        </nav>
      </div>

      <!-- Tab Content -->
      <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden;">
        <!-- Cells Tab Content -->
        <div id="cells-tab-content" style="flex: 1; padding: 16px; overflow-y: auto;">
          <div style="margin-bottom: 16px;">
            <!-- Cell count with action buttons -->
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
              <div style="font-size: 14px; color: #6b7280;">
                <span id="selected-cells-count">0</span> cells selected
              </div>
              
              <!-- Action buttons (icons only) -->
              <div style="display: flex; gap: 8px;">
                <!-- Save Selection Button (Icon Only) -->
                <button id="save-selection-btn"
                        style="padding: 6px; background-color: #3b82f6; color: white; border-radius: 4px; border: none; cursor: pointer; transition: background-color 0.2s;"
                        title="Save Selection"
                        data-action="click->visualization#saveSelection"
                        onmouseover="this.style.backgroundColor='#2563eb'"
                        onmouseout="this.style.backgroundColor='#3b82f6'">
                  <i class="fas fa-save" style="font-size: 14px;"></i>
                </button>
                
                <!-- Cancel Selection Button (Icon Only) -->
                <button id="cancel-selection-btn"
                        style="padding: 6px; background-color: #d1d5db; color: #374151; border-radius: 4px; border: none; cursor: pointer; transition: background-color 0.2s;"
                        title="Cancel Selection"
                        data-action="click->visualization#cancelSelection"
                        onmouseover="this.style.backgroundColor='#9ca3af'"
                        onmouseout="this.style.backgroundColor='#d1d5db'">
                  <i class="fas fa-times" style="font-size: 14px;"></i>
                </button>
              </div>
            </div>

            <!-- Add all visible cells button -->
            <div style="margin-bottom: 16px;">
              <button id="add-all-visible-btn"
                      style="width: 100%; padding: 8px 12px; background-color: #10b981; color: white; border-radius: 6px; border: none; cursor: pointer; font-size: 14px; font-weight: 500; transition: all 0.2s;"
                      title="Add all currently visible cells to selection"
                      data-action="click->visualization#addAllVisibleCells"
                      onmouseover="this.style.backgroundColor='#059669'"
                      onmouseout="this.style.backgroundColor='#10b981'">
                <i class="fas fa-plus" style="margin-right: 6px;"></i>
                All visible cells to selection
              </button>
            </div>

            <!-- Saved Selections List -->
            <div>
              <h3 style="margin: 0 0 8px 0; font-size: 14px; font-weight: 500;">Saved Selections</h3>
