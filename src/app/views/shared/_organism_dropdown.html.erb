<%# Species dropdown of the organism-selector Stimulus controller (button + searchable menu grouped by domain).
   Used by the project form and by the external catalog import overlay (species choice).
   The caller renders the element with data-controller="organism-selector" and its hiddenInput target.
   Locals:
   - selected_id: organism id currently selected (nil: none)
   - selected_label: text shown on the button for it (nil: "Please select an organism")
   - grouped_organisms: { domain => [[display_name, id, tax_id, assembly_status], ...] }; empty when the
     controller loads the list itself (autoload)
   - disabled: read-only button. Default: false
%>
<% selected_id = local_assigns[:selected_id] %>
<% selected_label = local_assigns[:selected_label] %>
<% grouped_organisms = local_assigns[:grouped_organisms] %>
<% disabled = local_assigns.fetch(:disabled, false) %>
<!-- Dropdown button -->
<button type="button"
        class="w-full px-3 py-2 text-left border border-gray-300 dark:border-gray-600 rounded-md <%= disabled ? 'bg-gray-100 dark:bg-gray-600 text-gray-500 dark:text-gray-400 cursor-not-allowed' : 'bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500' %> flex items-center justify-between"
        data-organism-selector-target="dropdownButton"
        <%= 'disabled' if disabled %>
        data-action="click->organism-selector#toggleDropdown">
  <span data-organism-selector-target="selectedText"><%= selected_label.presence || "Please select an organism" %></span>
  <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-organism-selector-target="chevron">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
  </svg>
</button>

<!-- Dropdown menu -->
<div class="hidden absolute z-50 w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-md shadow-lg max-h-60 overflow-y-auto"
     style="top: calc(100% + 4px);"
     data-organism-selector-target="dropdownMenu">
  <div class="sticky top-0 z-10 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 p-2">
    <input type="text"
           class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
           placeholder="Search organisms..."
           autocomplete="off"
           data-organism-selector-target="searchInput"
           data-action="input->organism-selector#filterOptions click->organism-selector#preventDropdownCloseOnInput keydown->organism-selector#preventDropdownCloseOnInput">
  </div>
  <% (grouped_organisms || {}).each do |domain, organisms| %>
    <div class="organism-group">
      <!-- Group header (collapsible) -->
      <button type="button"
              class="w-full px-4 py-2 text-left text-sm font-semibold text-gray-700 dark:text-gray-300 bg-gray-50 dark:bg-gray-900 hover:bg-gray-100 dark:hover:bg-gray-800 flex items-center"
              data-organism-selector-target="groupHeader"
              data-action="click->organism-selector#toggleGroup">
        <div class="mr-3" style="color: #9ca3af;">
          <i class="fas fa-chevron-right" style="font-size: 14px; transition: transform 0.3s ease-out;" data-organism-selector-target="groupChevron"></i>
        </div>
        <span class="flex-1"><%= domain %></span>
        <span class="inline-flex items-center justify-center px-2 py-1 text-xs font-semibold rounded-full bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 ml-2"
              data-organism-selector-target="groupCount"
              data-total-count="<%= organisms.count %>">
          <%= organisms.count %>
        </span>
      </button>
      
      <!-- Group content (collapsible) -->
      <div class="hidden" data-organism-selector-target="groupContent">
        <% organisms.each do |organism_data| %>
          <% 
            # Handle array format: [display_name, organism_id, tax_id, assembly_status]
            display_name = organism_data[0]
            organism_id = organism_data[1]
            tax_id = organism_data[2]
            assembly_status = organism_data[3]
          %>
          <button type="button"
                  class="w-full px-6 py-2 text-left text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-900/30 transition-colors flex items-center gap-2 <%= 'bg-blue-50 dark:bg-blue-900/30 font-medium' if organism_id == selected_id %>"
                  data-organism-id="<%= organism_id %>"
                  data-display-name="<%= display_name %>"
                  data-search-text="<%= [display_name, tax_id].compact.join(' ').downcase %>"
                  data-organism-selector-target="option"
                  data-action="click->organism-selector#selectOrganism">
            <span class="min-w-0 truncate"><%= display_name %></span>
            <% if tax_id.present? %>
              <span class="text-gray-500 dark:text-gray-400 text-xs flex-shrink-0"><%= tax_id %></span>
            <% end %>
            <%= organism_assembly_status_tag(assembly_status) %>
          </button>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
