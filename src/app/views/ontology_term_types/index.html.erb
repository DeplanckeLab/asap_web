<% content_for :title, "Ontology Term Types - ASAP" %>
<div class="max-w-6xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="mb-8 space-y-4">
    <div>
      <h1 class="text-3xl font-semibold text-gray-900 dark:text-white">
        Cell metadata schema in ASAP (for single-cell datasets)
      </h1>
      <p class="mt-2 text-gray-600 dark:text-gray-300">
        Cell metadata used by ASAP to annotate single-cell datasets. This schema is mirroring the <a href="https://github.com/scFAIR/scFAIR/blob/main/schema/7.1.0/README.md" target="_blank">scFAIR metadata schema</a> 
        which is largely inspired from the <a href="https://github.com/chanzuckerberg/single-cell-curation/blob/main/schema/7.1.0/README.md" target="_blank">CELLxGENE metadata schema</a>.
      </p>
    </div>
    <% if can_edit_synced_reference_data? %>
      <div>
        <%= link_to "New metadata field",
                    new_ontology_term_type_path,
                    class: "inline-flex items-center rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-gray-800 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-gray-800 dark:bg-gray-100 dark:text-black dark:hover:bg-gray-200" %>
      </div>
    <% end %>
  </div>

  <% if admin? && !synced_reference_data_writable? %>
    <div class="mb-6 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-400/50 dark:bg-amber-950/30 dark:text-amber-100">
      Ontology term types are synced from development and are read-only on production.
    </div>
  <% end %>

  <% if @ontology_term_types.empty? %>
    <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-amber-900 dark:border-amber-400/50 dark:bg-amber-950/30 dark:text-amber-100">
      No ontology term types are configured yet.
    </div>
  <% else %>
    <div class="rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
      <!--<div class="border-b border-gray-100 px-6 py-4 dark:border-gray-800">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">
          <%= pluralize(@ontology_term_types.size, "configuration") %>
        </p>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          Ranks originate from the legacy pipeline and determine display priority in downstream tooling.
        </p>
      </div>
-->
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-800">
          <thead>
            <tr class="bg-gray-50 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:bg-gray-950 dark:text-gray-400">
              <% if admin? %>
                <th scope="col" class="px-6 py-3">ID</th>
              <% end %>
              <th scope="col" class="px-6 py-3">Name</th>
              <th scope="col" class="px-6 py-3">Label</th>
              <th scope="col" class="px-6 py-3">Metadata</th>
              <th scope="col" class="px-6 py-3">Ontologies</th>
             <!-- <th scope="col" class="px-6 py-3">Lineage terms</th>
              <th scope="col" class="px-6 py-3">Direct terms</th>
              <th scope="col" class="px-6 py-3">Free-text entries</th>-->
              <% if can_edit_synced_reference_data? %>
                <th scope="col" class="px-6 py-3 text-right">Actions</th>
              <% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white text-sm text-gray-900 dark:divide-gray-800 dark:bg-gray-900 dark:text-gray-100">
            <% @ontology_term_types.each do |record| %>
              <% ontology_entries = record.cell_ontology_ids_list.map { |id| [id, @cell_ontologies[id]&.tag || "##{id}"] } %>
              <tr>
                <% if admin? %>
                  <td class="px-6 py-4 text-gray-600 dark:text-gray-300">
                    <%= record.id %>
                  </td>
                <% end %>
                <td class="px-6 py-4 font-medium text-gray-900 dark:text-white">
                  <%= record.name %>
                </td>
                <td class="px-6 py-4 text-gray-600 dark:text-gray-300">
                  <%= record.label.presence || "—" %>
                </td>
                <td class="px-6 py-4 text-gray-600 dark:text-gray-300">
                  <div class="text-sm text-gray-600 dark:text-gray-300">
                    <span title="Ontology identifiers"><%= record.term_path.present? ? clean_metadata_path(record.term_path) : "—" %></span><br/>
                    <span title="Ontology terms"><%= record.label_path.present? ? clean_metadata_path(record.label_path) : "—" %></span>
                  </div>
                </td>
                <td class="px-6 py-4 text-gray-600 dark:text-gray-300">
                  <% if ontology_entries.present? %>
                    <span class="inline-flex flex-wrap gap-1">
                      <% ontology_entries.each do |ontology_id, ontology_tag| %>
                        <%= link_to ontology_tag,
                                    cell_ontology_path(ontology_id),
                                    class: "inline-flex items-center rounded-full border border-gray-200 px-2 py-0.5 text-xs text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800" %>
                      <% end %>
                    </span>
                  <% else %>
                    <span class="text-gray-400 dark:text-gray-500">—</span>
                  <% end %>
                </td>
                <% if can_edit_synced_reference_data? %>
                  <td class="px-6 py-4 text-right text-sm">
                    <%= link_to "Edit",
                                edit_ontology_term_type_path(record),
                                class: "text-indigo-600 hover:text-indigo-800 dark:text-indigo-300 dark:hover:text-indigo-200" %>
                    <%= button_to "Delete",
                                  ontology_term_type_path(record),
                                  method: :delete,
                                  form: { data: { turbo_confirm: "Delete #{record.name}?" }, class: "inline" },
                                  class: "ml-3 text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 bg-transparent p-0" %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
