    var isUp = tone === 'up';
    var highlightCls = isUp ? 'bg-green-100 text-green-800 hover:bg-green-200' : 'bg-red-100 text-red-800 hover:bg-red-200';
    var canOpen = !!(remoteGid || ens || symLookup);
    var cls = highlightCls;
    var curs = canOpen ? 'cursor-pointer' : 'cursor-default';
    var html = '<span class="annot-popup-gene-badge gene-badge ' + cls + ' ' + curs + ' inline-flex items-center px-2 py-0.5 rounded text-xs font-medium" style="max-width:11rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"';
    if (remoteGid) html += ' data-remote-gene-id="' + escapeAttr(remoteGid) + '"';
    if (ens) html += ' data-ensembl-id="' + escapeAttr(ens) + '"';
