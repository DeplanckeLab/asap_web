    _annotPopupData.evidencesSubTab = 'up';
    _annotPopupData.evidencesSort = { up: { col: 1, asc: false }, down: { col: 1, asc: true } };
    _annotPopupData.evidencesSelectedOrder = [];
    _annotPopupData.evidencesSelectedRows = {};
