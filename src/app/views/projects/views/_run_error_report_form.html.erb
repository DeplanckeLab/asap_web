<% return unless run&.status_id == 4 %>

<div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mt-4">
  <% if flash[:notice].present? %>
    <div class="mb-3 p-3 bg-green-50 border border-green-200 rounded-md">
      <p class="text-sm text-green-800"><%= flash[:notice] %></p>
    </div>
  <% end %>

  <% if flash[:alert].present? %>
    <div class="mb-3 p-3 bg-red-50 border border-red-200 rounded-md">
      <p class="text-sm text-red-800"><%= flash[:alert] %></p>
    </div>
  <% end %>

  <p class="text-sm text-blue-900 mb-3">
    <% if user_signed_in? %>
      If you think this is a bug, please report it and we will get back to you shortly.
    <% else %>
      If you think this is a bug, please leave your email and we will get back to you shortly.
    <% end %>
  </p>

  <%= form_with url: report_error_run_path(run), method: :post, local: true, class: "space-y-3" do %>
    <% unless user_signed_in? %>
      <div>
        <label for="run_error_report_email_<%= run.id %>" class="block text-sm font-medium text-gray-700 mb-1">Your email</label>
        <input type="email"
               name="email"
               id="run_error_report_email_<%= run.id %>"
               required
               class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500"
               placeholder="you@example.com">
      </div>
    <% end %>

    <div>
      <label for="run_error_report_message_<%= run.id %>" class="block text-sm font-medium text-gray-700 mb-1">Additional details (optional)</label>
      <textarea name="message"
                id="run_error_report_message_<%= run.id %>"
                rows="3"
                class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500"
                placeholder="Anything else that might help us reproduce the issue..."></textarea>
    </div>

    <button type="submit"
            class="inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors">
      Report this issue
    </button>
  <% end %>
</div>
