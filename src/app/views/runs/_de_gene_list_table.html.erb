<%# Shared DE gene list table. Locals: compact (boolean) for viz modal styling. %>
<% compact = local_assigns.fetch(:compact, false) %>
<% numeric_fields = ['Gene index', 'logFC', 'P-value', 'FDR', 'Avg group1', 'Avg group2'] %>
<% is_up_regulated = params[:type].to_s == 'up' %>
<% gene_badge_cls = is_up_regulated ? 'bg-green-100 text-green-800 hover:bg-green-200' : 'bg-red-100 text-red-800 hover:bg-red-200' %>
<% sort_onclick = "(function(th){var c=document.getElementById('de-genelist-container');if(!c)return;var tbody=c.querySelector('tbody');if(!tbody)return;var col=parseInt(th.dataset.col);var num=th.dataset.numeric==='true';var rows=Array.from(tbody.querySelectorAll('tr'));var cur=th.dataset.sortDir||'none';var asc=(cur!=='asc');th.dataset.sortDir=asc?'asc':'desc';c.querySelectorAll('th[data-col]').forEach(function(h){if(h!==th){h.dataset.sortDir='none';var si=h.querySelector('.sort-indicator');if(si)si.textContent='';}});var si=th.querySelector('.sort-indicator');if(si)si.textContent=asc?' \\u25B2':' \\u25BC';rows.sort(function(a,b){var ac=a.cells[col],bc=b.cells[col];var av=ac?(ac.getAttribute('data-sort-value')||ac.textContent.trim()):'';var bv=bc?(bc.getAttribute('data-sort-value')||bc.textContent.trim()):'';if(num){var an=parseFloat(av);if(isNaN(an))an=0;var bn=parseFloat(bv);if(isNaN(bn))bn=0;return asc?an-bn:bn-an;}return asc?av.localeCompare(bv):bv.localeCompare(av);});rows.forEach(function(r){tbody.appendChild(r);});})(this)" %>

<div id="de-genelist-container" class="<%= compact ? '' : 'flex-1 overflow-y-auto' %>"
     style="<%= compact ? 'flex: 1; overflow: auto; min-height: 0; border: 1px solid #e5e7eb; border-radius: 6px;' : '' %>">
  <table class="<%= compact ? '' : 'min-w-full divide-y divide-gray-200 text-sm' %>"
         style="<%= compact ? 'width: 100%; border-collapse: collapse; font-size: 12px;' : '' %>">
    <thead class="<%= compact ? '' : 'bg-gray-50 sticky top-0' %>"
           style="<%= compact ? 'background: #f9fafb; position: sticky; top: 0; z-index: 1;' : '' %>">
      <tr>
        <% @fields.each_with_index do |f, idx| %>
          <th class="<%= compact ? '' : 'px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase whitespace-nowrap cursor-pointer hover:text-gray-700 select-none' %>"
              style="<%= compact ? 'padding: 6px 8px; text-align: left; font-size: 11px; font-weight: 600; color: #6b7280; white-space: nowrap; cursor: pointer; user-select: none; border-bottom: 1px solid #e5e7eb;' : '' %>"
              data-col="<%= idx %>"
              data-numeric="<%= numeric_fields.include?(f) %>"
              onclick="<%= sort_onclick %>">
            <%= f %> <span class="sort-indicator"></span>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody class="<%= compact ? '' : 'bg-white divide-y divide-gray-200' %>">
      <% @data.each do |e| %>
        <tr class="<%= compact ? '' : 'hover:bg-gray-50' %>"
            style="<%= compact ? 'border-bottom: 1px solid #f3f4f6;' : '' %>">
          <% @fields.each_index do |i| %>
            <% cell_value = e[i] %>
            <% is_numeric_field = numeric_fields.include?(@fields[i]) && @fields[i] != 'Gene index' %>
            <% display_value = is_numeric_field ? format_de_table_value(cell_value) : cell_value %>
            <% sort_value = is_numeric_field ? cell_value.to_s.strip : nil %>
            <td class="<%= compact ? '' : 'px-3 py-1.5 text-gray-700 whitespace-nowrap' %>"
                style="<%= compact ? 'padding: 5px 8px; color: #374151; white-space: nowrap;' : '' %>"
                <% if sort_value.present? %>data-sort-value="<%= sort_value %>" title="<%= sort_value %>"<% end %>>
              <% if @fields[i] == 'EnsemblID' && e[i].present? %>
                <span class="text-blue-600 cursor-pointer hover:underline gene-link" data-ensembl-id="<%= e[i] %>"><%= e[i] %></span>
              <% elsif @fields[i] == 'Gene name' %>
                <% gene_name = e[i].presence || e[1] %>
                <% ensembl_id = e[1].to_s %>
                <span class="gene-badge cursor-pointer inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= gene_badge_cls %>"
                      data-ensembl-id="<%= ensembl_id %>"
                      <% if gene_name.present? && gene_name != ensembl_id %>data-gene-symbol="<%= gene_name %>"<% end %>
                      title="<%= ensembl_id.presence || gene_name %>"><%= gene_name %></span>
              <% else %>
                <%= display_value %>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
