<% content_for :title, "Rate ASAP" %>
<div class="max-w-2xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="mb-8">
    <h1 class="text-3xl font-semibold text-gray-900">Rate ASAP</h1>
    <p class="mt-2 text-gray-600">
      Your feedback helps us improve ASAP. Let us know what you think!
    </p>
  </div>

  <% if flash[:notice].present? %>
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg">
      <p class="text-green-800"><%= flash[:notice] %></p>
    </div>
  <% end %>

  <% if flash[:alert].present? %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
      <p class="text-red-800"><%= flash[:alert] %></p>
    </div>
  <% end %>

  <% if @rating %>
    <div class="mb-6 p-4 bg-blue-50 border border-blue-200 rounded-lg">
      <p class="text-blue-800">
        You previously rated ASAP <strong><%= @rating.stars %>/5</strong> on <%= @rating.created_at.strftime("%b %d, %Y") %>.
        You can submit a new rating below to update it.
      </p>
    </div>
  <% end %>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <%= form_with url: rate_submit_home_index_path, method: :post, local: true, class: "space-y-6" do |f| %>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-3">How would you rate ASAP?</label>
        <input type="hidden" name="stars" id="stars-input" value="">
        <div id="star-rating" class="flex items-center gap-1">
          <% (1..5).each do |i| %>
            <button type="button" data-star="<%= i %>"
                    class="star-btn text-3xl transition-colors focus:outline-none cursor-pointer text-gray-300 hover:text-yellow-400"
                    title="<%= i %> star<%= i > 1 ? 's' : '' %>">
              <i class="fas fa-star"></i>
            </button>
          <% end %>
          <span id="star-label" class="ml-3 text-sm text-gray-500"></span>
        </div>
      </div>

      <div>
        <label for="review" class="block text-sm font-medium text-gray-700 mb-1">Write a review (optional)</label>
        <textarea name="review" id="review"
                  rows="5"
                  class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500"
                  placeholder="Tell us what you like about ASAP, what could be improved, or how you use it..."><%= @rating&.review %></textarea>
      </div>

      <div class="space-y-3">
        <div class="flex items-start">
          <input type="checkbox" name="display_publicly" id="display_publicly" value="1"
                 class="h-4 w-4 mt-0.5 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
                 <%= 'checked' if @rating&.display_publicly %>>
          <label for="display_publicly" class="ml-2 text-sm text-gray-700">
            Autorize us to display your review publicly on the ASAP website anonymously
          </label>
        </div>
<!--
        <div class="flex items-start">
          <input type="checkbox" name="use_for_funding" id="use_for_funding" value="1"
                 class="h-4 w-4 mt-0.5 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
                 <%= 'checked' if @rating&.use_for_funding %>>
          <label for="use_for_funding" class="ml-2 text-sm text-gray-700">
            I agree that my review can be used as a basis for supporting our effort to obtain funding
          </label>
        </div>
      </div>
-->
      <div class="pt-2">
        <button type="submit" id="submit-btn"
                class="w-full px-4 py-2 bg-blue-600 text-white font-medium rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                disabled>
          Submit rating
        </button>
      </div>

    <% end %>
  </div>
</div>

<script>
  (function() {
    var starsInput = document.getElementById('stars-input')
    var starLabel = document.getElementById('star-label')
    var submitBtn = document.getElementById('submit-btn')
    var buttons = document.querySelectorAll('.star-btn')
    var labels = ['', 'Poor', 'Fair', 'Good', 'Very good', 'Excellent']
    var selected = 0

    function updateStars(rating, hover) {
      buttons.forEach(function(btn) {
        var val = parseInt(btn.getAttribute('data-star'))
        var icon = btn.querySelector('i')
        if (val <= rating) {
          btn.classList.remove('text-gray-300')
          btn.classList.add('text-yellow-400')
        } else {
          btn.classList.remove('text-yellow-400')
          btn.classList.add('text-gray-300')
        }
      })
      if (!hover) {
        starLabel.textContent = rating > 0 ? labels[rating] : ''
      } else {
        starLabel.textContent = labels[rating] || ''
      }
    }

    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        selected = parseInt(this.getAttribute('data-star'))
        starsInput.value = selected
        updateStars(selected, false)
        submitBtn.disabled = false
      })

      btn.addEventListener('mouseenter', function() {
        var val = parseInt(this.getAttribute('data-star'))
        updateStars(val, true)
      })

      btn.addEventListener('mouseleave', function() {
        updateStars(selected, false)
      })
    })

    <% if @rating %>
      selected = <%= @rating.stars %>
      starsInput.value = selected
      updateStars(selected, false)
      submitBtn.disabled = false
    <% end %>
  })()
</script>
