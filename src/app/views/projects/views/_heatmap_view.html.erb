<%# Interactive heatmap viewer card body (rendered into show_view_json card-heatmap). %>
<% project = local_assigns[:project] || @project %>
<% run = local_assigns[:run] || @run %>
<% can_analyze_heatmap = analyzable?(project) %>
<% heatmap_btn = "inline-flex items-center justify-center gap-2 px-3 py-1.5 bg-white hover:bg-gray-100 text-gray-700 rounded-md font-medium text-xs transition-colors cursor-pointer border border-gray-300 shadow-sm" %>
<% heatmap_toggle = "#{heatmap_btn} heatmap-toggle-btn" %>
<div class="heatmap-viewer"
     data-controller="heatmap"
     data-heatmap-project-key-value="<%= project.key %>"
     data-heatmap-run-id-value="<%= run.id %>"
     data-heatmap-can-analyze-value="<%= can_analyze_heatmap %>"
     data-heatmap-data-url-value="<%= heatmap_data_project_path(project, run_id: run.id) %>">
  <style>
    .heatmap-toggle-btn .heatmap-switch {
      position: relative;
      width: 28px;
      height: 16px;
      border-radius: 999px;
      background: #cbd5e1;
      border: 1px solid #94a3b8;
      flex-shrink: 0;
      transition: background-color 0.15s ease, border-color 0.15s ease;
    }
    .heatmap-toggle-btn .heatmap-switch::after {
      content: "";
      position: absolute;
      top: 1px;
      left: 1px;
      width: 12px;
      height: 12px;
      border-radius: 999px;
      background: #ffffff;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.25);
      transition: transform 0.15s ease;
    }
    .heatmap-toggle-btn[aria-pressed="true"] {
      background: #eff6ff;
      border-color: #93c5fd;
      color: #1e3a8a;
    }
    .heatmap-toggle-btn[aria-pressed="true"] .heatmap-switch {
      background: #2563eb;
      border-color: #1d4ed8;
    }
    .heatmap-toggle-btn[aria-pressed="true"] .heatmap-switch::after {
      transform: translateX(12px);
    }
    .heatmap-toggle-btn .heatmap-toggle-state {
      min-width: 1.6rem;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.02em;
      color: #64748b;
    }
    .heatmap-toggle-btn[aria-pressed="true"] .heatmap-toggle-state {
      color: #1d4ed8;
    }
    .heatmap-track-row {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 8px;
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      background: #f8fafc;
      cursor: grab;
      user-select: none;
    }
    .heatmap-track-row.heatmap-track-dragging {
      opacity: 0.55;
    }
    .heatmap-track-row.heatmap-track-drag-over {
      border-color: #2563eb;
      background: #eff6ff;
    }
    .heatmap-track-ref {
      flex-shrink: 0;
      min-width: 28px;
      text-align: center;
      font-size: 11px;
      font-weight: 700;
      color: #1e3a8a;
      background: #dbeafe;
      border: 1px solid #93c5fd;
      border-radius: 4px;
      padding: 2px 6px;
      font-variant-numeric: tabular-nums;
    }
    .heatmap-track-name {
      flex: 1;
      min-width: 0;
      font-size: 12px;
      color: #334155;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .heatmap-track-lists {
      container-type: inline-size;
    }
    @media (max-width: 720px) {
      .heatmap-track-lists {
        grid-template-columns: 1fr !important;
      }
    }
  </style>
  <div class="heatmap-toolbar" style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:10px; align-items:center;">
    <button type="button" class="<%= heatmap_btn %>" data-action="heatmap#reset">Reset view</button>
    <button type="button"
            class="<%= heatmap_toggle %>"
            data-heatmap-target="colTreeToggle"
            data-action="heatmap#toggleColTree"
            aria-pressed="true">
      <span class="heatmap-switch" aria-hidden="true"></span>
      <span>Column tree</span>
      <span class="heatmap-toggle-state" data-heatmap-target="colTreeState">On</span>
    </button>
    <button type="button"
            class="<%= heatmap_toggle %>"
            data-heatmap-target="rowTreeToggle"
            data-action="heatmap#toggleRowTree"
            aria-pressed="true">
      <span class="heatmap-switch" aria-hidden="true"></span>
      <span>Row tree</span>
      <span class="heatmap-toggle-state" data-heatmap-target="rowTreeState">On</span>
    </button>
    <button type="button"
            class="<%= heatmap_toggle %>"
            data-heatmap-target="labelsToggle"
            data-action="heatmap#toggleLabels"
            aria-pressed="true">
      <span class="heatmap-switch" aria-hidden="true"></span>
      <span>Labels</span>
      <span class="heatmap-toggle-state" data-heatmap-target="labelsState">On</span>
    </button>
    <button type="button"
            class="<%= heatmap_btn %>"
            data-action="heatmap#exportSvg"
            title="Download heatmap as SVG"
            aria-label="Download heatmap as SVG">
      <i class="fas fa-download" style="font-size: 14px;" aria-hidden="true"></i>
    </button>
    <% if can_analyze_heatmap %>
      <button type="button"
              class="<%= heatmap_btn %>"
              data-action="heatmap#openSaveCheckpointDialog"
              title="Save a checkpoint for this heatmap run"
              aria-label="Save checkpoint">
        <i class="fas fa-save" style="font-size: 14px;" aria-hidden="true"></i>
      </button>
    <% end %>
    <button type="button"
            class="<%= heatmap_btn %>"
            data-action="heatmap#openCheckpointHistory"
            data-heatmap-target="checkpointHistoryBtn"
            title="Load checkpoints for this heatmap run"
            aria-label="Checkpoints">
      <i class="fas fa-history" style="font-size: 14px;" aria-hidden="true"></i>
    </button>
    <button type="button"
            class="<%= heatmap_btn %>"
            data-action="heatmap#openCheckpointComments"
            data-heatmap-target="checkpointCommentsBtn"
            title="Comments on the loaded checkpoint"
            aria-label="Checkpoint comments">
      <i class="fas fa-comment" style="font-size: 14px;" aria-hidden="true"></i>
    </button>
    <div style="position:relative; display:inline-flex;">
      <button type="button"
              class="<%= heatmap_btn %>"
              data-action="heatmap#toggleSettingsMenu"
              data-heatmap-target="settingsBtn"
              title="Display settings"
              aria-label="Display settings"
              aria-haspopup="true">
        <i class="fas fa-cog" style="font-size: 14px;" aria-hidden="true"></i>
      </button>
      <div data-heatmap-target="settingsMenu"
           data-action="click->heatmap#stopModalPropagation"
           style="display:none; position:absolute; top:calc(100% + 6px); right:0; z-index:30; min-width:260px; background:#fff; border:1px solid #d1d5db; border-radius:8px; box-shadow:0 10px 15px -3px rgba(0,0,0,0.15); padding:12px;">
        <div style="font-size:12px; font-weight:600; color:#111827; margin-bottom:10px;">Display options</div>
        <label style="display:block; font-size:12px; color:#374151; margin-bottom:6px;">
          Legend width
          <span data-heatmap-target="legendWidthValue" style="float:right; color:#6b7280; font-variant-numeric:tabular-nums;">220px</span>
        </label>
        <input type="range"
               data-heatmap-target="legendWidthSlider"
               data-action="input->heatmap#legendWidthChanged"
               min="140"
               max="360"
               step="10"
               value="220"
               style="width:100%;">
      </div>
    </div>
  </div>
  <div class="heatmap-canvas-area" style="position:relative; width:100%; height:660px; background:#ffffff; border:1px solid #e2e8f0; border-radius:6px; overflow:hidden;">
    <canvas data-heatmap-target="webgl"></canvas>
    <canvas data-heatmap-target="overlay"></canvas>
    <button type="button"
            data-heatmap-target="addColTrackBtn"
            data-action="heatmap#openAddColTrackModal"
            title="Add cell metadata track"
            aria-label="Add cell metadata track"
            class="heatmap-add-track-btn"
            style="display:none; position:absolute; z-index:4; width:22px; height:22px; padding:0; line-height:20px; text-align:center; border:1px solid #94a3b8; border-radius:4px; background:rgba(255,255,255,0.92); color:#334155; font-size:16px; font-weight:600; cursor:pointer; box-shadow:0 1px 2px rgba(15,23,42,0.12); pointer-events:auto;">+</button>
    <button type="button"
            data-heatmap-target="addRowTrackBtn"
            data-action="heatmap#openAddRowTrackModal"
            title="Add gene metadata track"
            aria-label="Add gene metadata track"
            class="heatmap-add-track-btn"
            style="display:none; position:absolute; z-index:4; width:22px; height:22px; padding:0; line-height:20px; text-align:center; border:1px solid #94a3b8; border-radius:4px; background:rgba(255,255,255,0.92); color:#334155; font-size:16px; font-weight:600; cursor:pointer; box-shadow:0 1px 2px rgba(15,23,42,0.12); pointer-events:auto;">+</button>
    <div data-heatmap-target="tooltip"
         style="position:absolute; display:none; z-index:5; pointer-events:none; background:rgba(15,23,42,0.9); color:#fff; padding:4px 8px; border-radius:4px; font-size:12px; max-width:320px; white-space:normal;"></div>
    <div data-heatmap-target="status"
         style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; color:#64748b; font-size:14px;">Loading heatmap...</div>
  </div>
  <div class="heatmap-track-lists" style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:12px;">
    <div style="border:1px solid #e2e8f0; border-radius:8px; padding:10px 12px; background:#fff;">
      <div style="font-size:13px; font-weight:600; color:#111827; margin-bottom:8px;">Cell metadata tracks</div>
      <div data-heatmap-target="colTrackList"
           class="heatmap-track-list"
           style="display:flex; flex-direction:column; gap:6px; min-height:28px;"></div>
      <p data-heatmap-target="colTrackListEmpty" class="text-xs text-gray-400 mb-0" style="margin:0;">No cell metadata tracks yet. Use + on the plot to add one.</p>
    </div>
    <div style="border:1px solid #e2e8f0; border-radius:8px; padding:10px 12px; background:#fff;">
      <div style="font-size:13px; font-weight:600; color:#111827; margin-bottom:8px;">Gene metadata tracks</div>
      <div data-heatmap-target="rowTrackList"
           class="heatmap-track-list"
           style="display:flex; flex-direction:column; gap:6px; min-height:28px;"></div>
      <p data-heatmap-target="rowTrackListEmpty" class="text-xs text-gray-400 mb-0" style="margin:0;">No gene metadata tracks yet. Use + on the plot to add one.</p>
    </div>
  </div>
  <p class="text-xs text-gray-500 mt-2 mb-0">
    Shift+scroll to zoom, drag to pan, click a dendrogram branch to collapse/expand. Use the overlay + buttons to add cell or gene metadata tracks. Drag list rows to reorder (refs update). Click Edit to change track details. Save checkpoints per heatmap run to restore view, tracks, and comments later. Download SVG exports the plot without overlay controls.
  </p>

  <div data-heatmap-target="trackModal"
       data-action="click->heatmap#trackModalBackdropClick"
       class="heatmap-track-modal"
       style="display:none; position:fixed; inset:0; z-index:12000; background:rgba(15,23,42,0.45); align-items:center; justify-content:center;">
    <div style="background:#fff; border-radius:10px; width:min(420px,92vw); max-height:85vh; overflow:auto; box-shadow:0 20px 25px -5px rgba(0,0,0,0.15); padding:20px;"
         data-action="click->heatmap#stopModalPropagation">
      <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px;">
        <h3 data-heatmap-target="trackModalTitle" style="margin:0; font-size:16px; font-weight:600; color:#111827;">Add metadata track</h3>
        <button type="button" data-action="heatmap#closeTrackModal" class="<%= heatmap_btn %>" aria-label="Close">Close</button>
      </div>
      <div style="display:flex; flex-direction:column; gap:12px;">
        <div>
          <label for="heatmap-track-metadata" style="display:block; font-size:12px; font-weight:500; color:#374151; margin-bottom:4px;">Metadata</label>
          <select id="heatmap-track-metadata" data-heatmap-target="trackModalSelect" data-action="change->heatmap#trackModalMetadataChanged"
                  class="form-select form-select-sm" style="width:100%;"></select>
        </div>
        <div>
          <label for="heatmap-track-size" style="display:block; font-size:12px; font-weight:500; color:#374151; margin-bottom:4px;">Track size</label>
          <select id="heatmap-track-size" data-heatmap-target="trackModalSize" class="form-select form-select-sm" style="width:100%;">
            <option value="thin">Thin</option>
            <option value="normal" selected>Normal</option>
            <option value="thick">Thick</option>
          </select>
        </div>
        <label data-heatmap-target="trackModalLegendWrap" style="display:flex; align-items:center; gap:8px; font-size:12px; color:#374151; margin:0;">
          <input type="checkbox" data-heatmap-target="trackModalShowLegend" checked>
          Show legend when categories fit
        </label>
        <p data-heatmap-target="trackModalHint" class="text-xs text-gray-500 mb-0" style="margin:0;"></p>
      </div>
      <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:18px; padding-top:14px; border-top:1px solid #e5e7eb;">
        <button type="button" data-action="heatmap#closeTrackModal" class="<%= heatmap_btn %>">Cancel</button>
        <button type="button" data-action="heatmap#confirmAddTrack"
                class="inline-flex items-center justify-center px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-medium text-xs transition-colors cursor-pointer border border-blue-600 shadow-sm">
          Add track
        </button>
      </div>
    </div>
  </div>

  <div data-heatmap-target="editTrackModal"
       data-action="click->heatmap#editTrackModalBackdropClick"
       class="heatmap-edit-track-modal"
       style="display:none; position:fixed; inset:0; z-index:12000; background:rgba(15,23,42,0.45); align-items:center; justify-content:center;">
    <div style="background:#fff; border-radius:10px; width:min(440px,92vw); max-height:85vh; overflow:auto; box-shadow:0 20px 25px -5px rgba(0,0,0,0.15); padding:20px;"
         data-action="click->heatmap#stopModalPropagation">
      <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px;">
        <h3 data-heatmap-target="editTrackModalTitle" style="margin:0; font-size:16px; font-weight:600; color:#111827;">Edit track</h3>
        <button type="button" data-action="heatmap#closeEditTrackModal" class="<%= heatmap_btn %>" aria-label="Close">Close</button>
      </div>
      <div style="display:flex; flex-direction:column; gap:12px;">
        <div>
          <div style="font-size:11px; color:#6b7280; margin-bottom:2px;">Track</div>
          <div data-heatmap-target="editTrackModalName" style="font-size:13px; font-weight:500; color:#111827;"></div>
        </div>
        <div data-heatmap-target="editTrackTypeWrap">
          <label for="heatmap-edit-track-type" style="display:block; font-size:12px; font-weight:500; color:#374151; margin-bottom:4px;">Display type</label>
          <select id="heatmap-edit-track-type" data-heatmap-target="editTrackType" data-action="change->heatmap#editTrackFormChanged"
                  class="form-select form-select-sm" style="width:100%;">
            <option value="categorical">Categorical</option>
            <option value="numerical">Continuous</option>
          </select>
          <p data-heatmap-target="editTrackTypeHint" class="text-xs text-gray-500 mb-0" style="margin:4px 0 0 0;"></p>
        </div>
        <div data-heatmap-target="editTrackDisplayModeWrap">
          <label for="heatmap-edit-track-display-mode" style="display:block; font-size:12px; font-weight:500; color:#374151; margin-bottom:4px;">Continuous display</label>
          <select id="heatmap-edit-track-display-mode" data-heatmap-target="editTrackDisplayMode"
                  class="form-select form-select-sm" style="width:100%;">
            <option value="color">Colored track</option>
            <option value="barplot">Barplot</option>
          </select>
        </div>
        <div>
          <label for="heatmap-edit-track-size" style="display:block; font-size:12px; font-weight:500; color:#374151; margin-bottom:4px;">Track size</label>
          <select id="heatmap-edit-track-size" data-heatmap-target="editTrackSize" class="form-select form-select-sm" style="width:100%;">
            <option value="thin">Thin</option>
            <option value="normal">Normal</option>
            <option value="thick">Thick</option>
          </select>
        </div>
        <label data-heatmap-target="editTrackLegendWrap" style="display:flex; align-items:center; gap:8px; font-size:12px; color:#374151; margin:0;">
          <input type="checkbox" data-heatmap-target="editTrackShowLegend">
          Show legend when categories fit
        </label>
        <button type="button"
                data-heatmap-target="editTrackGradientBtn"
                data-action="heatmap#editTrackOpenGradient"
                class="<%= heatmap_btn %>"
                style="align-self:flex-start;">
          Edit gradient
        </button>
      </div>
      <div style="display:flex; justify-content:space-between; gap:8px; margin-top:18px; padding-top:14px; border-top:1px solid #e5e7eb;">
        <button type="button"
                data-action="heatmap#editTrackRemove"
                class="inline-flex items-center justify-center px-3 py-1.5 bg-white hover:bg-red-50 text-red-700 rounded-md font-medium text-xs transition-colors cursor-pointer border border-red-300 shadow-sm">
          Remove track
        </button>
        <div style="display:flex; gap:8px;">
          <button type="button" data-action="heatmap#closeEditTrackModal" class="<%= heatmap_btn %>">Cancel</button>
          <button type="button" data-action="heatmap#confirmEditTrack"
                  class="inline-flex items-center justify-center px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-medium text-xs transition-colors cursor-pointer border border-blue-600 shadow-sm">
            Apply
          </button>
        </div>
      </div>
    </div>
  </div>

  <div data-heatmap-target="checkpointHistoryOverlay"
       data-action="click->heatmap#checkpointHistoryBackdropClick"
       style="display:none; position:fixed; inset:0; z-index:12000; background:rgba(0,0,0,0.5); justify-content:center; align-items:center;">
    <div style="background:#fff; border-radius:10px; width:min(640px,94vw); max-height:80vh; overflow:hidden; display:flex; flex-direction:column; box-shadow:0 20px 25px -5px rgba(0,0,0,0.2);"
         data-action="click->heatmap#stopModalPropagation">
      <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px 16px; border-bottom:1px solid #e5e7eb;">
        <div>
          <div style="font-size:15px; font-weight:600; color:#111827;">Heatmap checkpoints</div>
          <div style="font-size:12px; color:#6b7280;">Run <%= run.id %> only</div>
        </div>
        <button type="button" data-action="heatmap#closeCheckpointHistory" class="<%= heatmap_btn %>">Close</button>
      </div>
      <div data-heatmap-target="checkpointHistoryList" style="flex:1; min-height:0; overflow:auto; padding:8px;"></div>
    </div>
  </div>

  <div data-heatmap-target="checkpointCommentsOverlay"
       data-action="click->heatmap#checkpointCommentsBackdropClick"
       style="display:none; position:fixed; inset:0; z-index:12000; background:rgba(15,23,42,0.35); justify-content:center; align-items:center;">
    <div style="background:#fff; border:1px solid #d1d5db; border-radius:10px; width:min(560px,94vw); max-height:75vh; overflow:hidden; display:flex; flex-direction:column;"
         data-action="click->heatmap#stopModalPropagation">
      <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px 16px; border-bottom:1px solid #e5e7eb;">
        <div data-heatmap-target="checkpointCommentsTitle" style="font-size:15px; font-weight:600; color:#111827;">Comments</div>
        <button type="button" data-action="heatmap#closeCheckpointComments" class="<%= heatmap_btn %>">Close</button>
      </div>
      <div style="padding:12px 16px; border-bottom:1px solid #f3f4f6;">
        <label style="display:block; font-size:12px; color:#4b5563; margin-bottom:4px;">Checkpoint</label>
        <select data-heatmap-target="checkpointCommentSelect"
                data-action="change->heatmap#checkpointCommentTargetChanged"
                class="form-select form-select-sm"
                style="width:100%;"></select>
      </div>
      <div data-heatmap-target="checkpointCommentsList" style="flex:1; min-height:0; overflow:auto;"></div>
      <% if can_analyze_heatmap %>
        <div style="padding:12px 16px; border-top:1px solid #e5e7eb; display:flex; flex-direction:column; gap:8px;">
          <textarea data-heatmap-target="checkpointCommentInput"
                    rows="3"
                    placeholder="Add a comment about this heatmap view"
                    style="width:100%; border:1px solid #d1d5db; border-radius:6px; padding:8px; font-size:13px;"></textarea>
          <div style="display:flex; justify-content:flex-end;">
            <button type="button"
                    data-action="heatmap#submitCheckpointComment"
                    class="inline-flex items-center justify-center px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-medium text-xs transition-colors cursor-pointer border border-blue-600 shadow-sm">
              Add comment
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div data-heatmap-target="checkpointLoadingOverlay"
       style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background-color:rgba(0,0,0,0.35); z-index:12500; justify-content:center; align-items:center;">
    <div style="background:white; border:1px solid #d1d5db; border-radius:10px; padding:18px 22px; min-width:220px; display:flex; align-items:center; justify-content:center; gap:10px;">
      <i class="fas fa-spinner fa-spin" style="font-size:15px; color:#374151;" aria-hidden="true"></i>
      <span data-heatmap-target="checkpointLoadingMessage" style="font-size:14px; color:#111827; font-weight:500;">Loading checkpoint</span>
    </div>
  </div>

  <%= render 'projects/views/gradient_editor_modal' %>
</div>
