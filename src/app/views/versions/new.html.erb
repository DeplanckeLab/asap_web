<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-gray-900">New Release</h1>
    <%= link_to 'Back to releases', versions_path, class: 'inline-flex items-center px-3 py-2 rounded-md border border-gray-200 text-sm text-gray-700 hover:bg-gray-50' %>
  </div>

  <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <%= render 'form', version: @version %>
  </div>
</div>

