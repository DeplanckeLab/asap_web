<%#
  Shared LOOM / H5AD / DNA accessibility downloads modal.
  Open with any element that has data-loom-downloads-open.
%>
<%
  downloads_label = local_assigns[:downloads_label] || 'LOOM/H5AD'
  downloads_aria_label = local_assigns[:downloads_aria_label] || 'LOOM and H5AD downloads'
%>
<div data-controller="loom-downloads"
     data-loom-downloads-json-url-value="<%= get_loom_files_json_project_path(@project.key) %>"
     data-loom-downloads-export-url-value="<%= export_h5ad_project_path(@project.key) %>"
     data-loom-downloads-status-icons-value="<%= status_icons_json %>"
     data-loom-downloads-aria-label="<%= downloads_aria_label %>">
  <div data-loom-downloads-target="overlay"
       data-action="click->loom-downloads#close"
       class="hidden fixed inset-0 z-[90] flex items-center justify-center bg-black/40 p-4"
       role="dialog"
       aria-modal="true"
       aria-labelledby="loom-downloads-title">
    <div data-loom-downloads-target="panel"
         data-action="click->loom-downloads#stopOverlayClick"
         class="bg-white rounded-lg border border-gray-200 shadow-xl max-w-4xl w-full max-h-[85vh] flex flex-col overflow-hidden">
      <div class="flex items-center justify-between px-4 py-3 border-b border-gray-200 shrink-0">
        <h3 id="loom-downloads-title" class="text-sm font-semibold text-gray-900 inline-flex items-center gap-1.5">
          <i class="fas fa-download text-gray-500" aria-hidden="true"></i>
          <span><%= downloads_label %></span>
        </h3>
        <button type="button"
                data-loom-downloads-target="closeButton"
                data-action="click->loom-downloads#closeFromButton"
                class="badge-text px-2 py-1 rounded border border-gray-300 text-gray-700 hover:bg-gray-100">Close</button>
      </div>
      <div data-loom-downloads-target="body" class="p-4 overflow-auto flex-1 min-h-0 text-sm text-gray-700"></div>
    </div>
  </div>
</div>
