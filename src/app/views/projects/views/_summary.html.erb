<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
  <div class="mb-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Summary</h2>
    <p class="text-gray-600">Project overview and resources</p>
  </div>

  <div class="space-y-6">
    <!-- General Information -->
    <div class="bg-gray-50 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">General Information</h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-medium text-gray-500 mb-1">Project Name</label>
          <p class="text-gray-900 font-medium"><%= @project.display_name %></p>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-500 mb-1">Project Key</label>
          <p class="text-gray-900"><span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800"><%= @project.key %></span></p>
        </div>
        <% if @project.public? %>
        <div>
          <label class="block text-sm font-medium text-gray-500 mb-1">Public ID</label>
          <p class="text-gray-900"><span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">ASAP<%= @project.public_id %></span></p>
        </div>
        <% end %>
        <% if @project.public_at.present? %>
        <div>
          <label class="block text-sm font-medium text-gray-500 mb-1">Published at</label>
          <p class="text-gray-900"><%= @project.public_at.strftime("%B %d, %Y") %></p>
        </div>
        <% end %>
        <% if @project.user&.email.present? %>
        <div>
          <label class="block text-sm font-medium text-gray-500 mb-1">Contact</label>
          <p class="text-gray-900"><%= mail_to @project.user.email, @project.user.email, class: "text-blue-600 hover:text-blue-800 hover:underline" %></p>
        </div>
        <% end %>
        <div>
          <label class="block text-sm font-medium text-gray-500 mb-1">Views</label>
          <p class="text-gray-900"><%= number_with_delimiter(@project.nber_views || 0) %></p>
        </div>
        <% if @project.nber_cloned && @project.nber_cloned > 0 %>
        <div>
          <label class="block text-sm font-medium text-gray-500 mb-1">Times Cloned</label>
          <p class="text-gray-900"><%= number_with_delimiter(@project.nber_cloned) %></p>
        </div>
        <% end %>
        <% if @project_type %>
        <div>
          <label class="block text-sm font-medium text-gray-500 mb-1">Project Type</label>
          <p class="text-gray-900"><%= @project_type.name %></p>
        </div>
        <% end %>
      </div>
    </div>

    <% if @project.cloned_project_id %>
      <% cloned_project = Project.find_by(id: @project.cloned_project_id) %>
      <% if cloned_project %>
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
          <p class="text-blue-800">This project has been cloned from <%= link_to "#{cloned_project.name} [#{cloned_project.key}]", project_path(cloned_project), class: "font-medium underline hover:text-blue-600" %></p>
        </div>
      <% else %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4">
          <p class="text-red-800">This project has been cloned from a deleted project</p>
        </div>
      <% end %>
    <% end %>

    <% if @project.replaced_by_project_key.present? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <p class="text-red-800 font-medium">This project is obsolete and replaced by 
          <%
            # replaced_by_project_key can be either a project key or "ASAPX" format (public_id)
            replacement_key = @project.replaced_by_project_key
            if replacement_key.match?(/^ASAP(\d+)$/i)
              public_id = replacement_key.gsub(/^ASAP/i, '').to_i
              replacement_project = Project.find_by(public_id: public_id)
            else
              replacement_project = Project.find_by(key: replacement_key)
            end
          %>
          <% if replacement_project %>
            <%= link_to replacement_key, project_path(replacement_project), class: "underline hover:text-red-600" %>
          <% else %>
            <span class="underline"><%= replacement_key %></span>
          <% end %>
        </p>
        <% if @project.replaced_by_comment.present? %>
          <p class="text-red-700 text-sm mt-2"><strong>Comment:</strong> <%= @project.replaced_by_comment %></p>
        <% end %>
      </div>
    <% end %>

    <!-- Publications -->
    <% if @project.doi.present? || @h_articles&.any? %>
      <div class="bg-gray-50 rounded-lg p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Publications</h3>
        
        <div class="space-y-4">
          <% @project.doi.to_s.split(/\s*,\s*/).each do |doi| %>
            <% article = @h_articles[doi] %>
            <div class="bg-white rounded-lg border border-gray-200 p-4">
              <% if article %>
                <p class="text-gray-900 font-medium mb-2"><%= article.title %></p>
                <% if article.authors.present? %>
                  <p class="text-gray-600 text-sm mb-2"><%= article.authors.truncate(200) %></p>
                <% end %>
                <div class="flex flex-wrap gap-2 mt-2">
                  <%= link_to "https://doi.org/#{doi}", "https://doi.org/#{doi}", target: '_blank', class: "inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-blue-100 text-blue-800 hover:bg-blue-200" %>
                  <% if article.pmid.present? %>
                    <%= link_to "PubMed: #{article.pmid}", "https://pubmed.ncbi.nlm.nih.gov/#{article.pmid}/", target: '_blank', class: "inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-green-100 text-green-800 hover:bg-green-200" %>
                  <% end %>
                </div>
              <% else %>
                <p class="text-gray-600 text-sm">DOI: 
                  <%= link_to doi, "https://doi.org/#{doi}", target: '_blank', class: "text-blue-600 hover:text-blue-800 hover:underline" %>
                </p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Experimental Data -->
    <% if @h_exp_entries && @h_exp_entries.keys.any? %>
      <div class="bg-gray-50 rounded-lg p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Experimental Data</h3>
        
        <% @h_exp_entries.each do |type_id, exp_entries| %>
          <% next if exp_entries.empty? %>
          <% identifier_type = @h_identifier_types[type_id] %>
          
          <div class="mb-6 last:mb-0">
            <h4 class="text-sm font-medium text-gray-700 mb-3"><%= identifier_type&.name || 'Unknown Type' %></h4>
            
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-100">
                  <tr>
                    <th scope="col" class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Identifier</th>
                    <th scope="col" class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
                    <th scope="col" class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Other Identifiers</th>
                    <th scope="col" class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Contributors</th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  <% exp_entries.each do |exp_entry| %>
                    <tr class="hover:bg-gray-50">
                      <td class="px-4 py-3 whitespace-nowrap">
                        <% if identifier_type&.url_mask.present? %>
                          <%= link_to exp_entry.identifier, 
                              identifier_type.url_mask.gsub('#{id}', exp_entry.identifier.to_s), 
                              target: '_blank', 
                              class: "inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium bg-gray-800 text-white hover:bg-gray-700" %>
                        <% else %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium bg-gray-800 text-white"><%= exp_entry.identifier %></span>
                        <% end %>
                      </td>
                      <td class="px-4 py-3">
                        <% if exp_entry.title.present? %>
                          <span class="text-sm text-gray-900"><%= exp_entry.title %></span>
                        <% else %>
                          <span class="text-gray-400 text-sm">-</span>
                        <% end %>
                      </td>
                      <td class="px-4 py-3">
                        <% h_ids = exp_entry.parsed_identifiers %>
                        <% if h_ids.any? %>
                          <div class="flex flex-wrap gap-1">
                            <% h_ids.each do |id_type_id, ids| %>
                              <% id_type = @h_identifier_types[id_type_id.to_i] %>
                              <% ids.each do |id| %>
                                <% if id_type&.url_mask.present? %>
                                  <%= link_to id, id_type.url_mask.gsub('#{id}', id.to_s), target: '_blank', class: "inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 hover:bg-gray-200" %>
                                <% else %>
                                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700"><%= id %></span>
                                <% end %>
                              <% end %>
                            <% end %>
                          </div>
                        <% else %>
                          <span class="text-gray-400 text-sm">-</span>
                        <% end %>
                      </td>
                      <td class="px-4 py-3">
                        <% if exp_entry.contributors.present? %>
                          <% names = exp_entry.contributors.split(";").map { |c| c.split(",").reject(&:blank?).join(" ").strip }.reject(&:blank?) %>
                          <% if names.any? %>
                            <div class="flex flex-wrap gap-1">
                              <% names.each do |name| %>
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800"><%= name %></span>
                              <% end %>
                            </div>
                          <% else %>
                            <span class="text-gray-400 text-sm">-</span>
                          <% end %>
                        <% else %>
                          <span class="text-gray-400 text-sm">-</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Data Downloaded From (Provider Projects) -->
    <% if @project.provider_projects.any? %>
      <div class="bg-gray-50 rounded-lg p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Data Downloaded From</h3>
        
        <div class="space-y-3">
          <% @project.provider_projects.each do |pp| %>
            <% provider = pp.provider %>
            <% if provider %>
              <div class="flex items-center gap-2">
                <span class="font-medium text-gray-700"><%= provider.name %>:</span>
                <% if provider.url_mask.present? %>
                  <%= link_to pp.key, provider.url_mask.gsub('#{id}', pp.key.to_s), target: '_blank', class: "text-blue-600 hover:text-blue-800 hover:underline" %>
                <% else %>
                  <span class="text-gray-900"><%= pp.key %></span>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Reproducibility -->
    <div class="bg-gray-50 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Reproducibility</h3>
      
      <p class="text-sm text-gray-600 mb-4">Access documentation and resources to reproduce this analysis.</p>
      
      <div class="flex flex-wrap gap-3">
        <%= link_to instructions_project_path(@project.key), target: "_blank", class: "inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors" do %>
          Instructions
        <% end %>
        
        <%= link_to get_commands_project_path(@project.key), class: "inline-flex items-center px-4 py-2 bg-gray-200 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-300 transition-colors" do %>
          List of Commands
        <% end %>
        
        <% if exportable?(@project) %>
          <%= link_to get_file_project_path(@project.key, step: 'parsing', filename: 'output.loom'), target: "_blank", class: "inline-flex items-center px-4 py-2 bg-gray-200 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-300 transition-colors" do %>
            Initial Loom File
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Compliance section (driven entirely by compliance schemas in env_json and validation results) -->
    <% if @project.compliance_requires_public? %>
    <%
      # All display data comes from the validation result (if available) or from the compliance config
      validation_result = @project.cxg_validation_result
      schema_config = @project.compliance_schemas.first || {}

      # Schema metadata: prefer what was stored in the result at validation time, fall back to current config
      c_name = schema_config['name'] || validation_result&.dig('schema_name')
      c_version = validation_result&.dig('schema_version') || schema_config['version']
      c_url = validation_result&.dig('url') || schema_config['url']
      c_source_url = validation_result&.dig('source_url') || schema_config['source_url']
      c_source_schema_name = validation_result&.dig('source_schema_name') || schema_config['source_schema_name']
      c_description = validation_result&.dig('description') || schema_config['description']
      c_compliant_icon = validation_result&.dig('compliant_icon') || schema_config['compliant_icon']
      c_not_compliant_icon = validation_result&.dig('not_compliant_icon') || schema_config['not_compliant_icon']
    %>
    <div class="bg-gray-50 rounded-lg p-6" 
         data-controller="metadata-validation" 
         data-metadata-validation-project-id-value="<%= @project.id %>"
         data-metadata-validation-status-url-value="<%= compliance_project_status_path(@project.id) %>"
         data-metadata-validation-validate-url-value="<%= compliance_project_validate_path(@project.id) %>">

      <h3 class="text-lg font-semibold text-gray-900 mb-4">Compliance to external data schemas</h3>

      <% badge_link = c_url %>

      <!-- Validation Result Display -->
      <div data-metadata-validation-target="result">
        <% if validation_result %>
          <div class="bg-white rounded-lg border border-gray-200 p-4">
            <!-- Schema header with badge -->
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-3">
                <span class="text-sm font-semibold text-gray-800"><%= c_name %><%= " v#{c_version}" if c_version.present? %></span>
                <% if c_source_schema_name.present? && c_source_url.present? %>
                  <a href="<%= c_source_url %>" target="_blank" rel="noopener noreferrer" class="text-xs text-blue-600 hover:text-blue-800 hover:underline">(<%= c_source_schema_name %><%= " v#{c_version}" if c_version.present? %>)</a>
                <% elsif c_source_url.present? %>
                  <a href="<%= c_source_url %>" target="_blank" rel="noopener noreferrer" class="text-xs text-blue-600 hover:text-blue-800 hover:underline">(source schema)</a>
                <% end %>
              </div>
              <% if validation_result['valid'] && c_compliant_icon.present? %>
                <% if badge_link.present? %>
                  <a href="<%= badge_link %>" target="_blank" rel="noopener noreferrer">
                    <%= image_tag c_compliant_icon, alt: 'Compliant', class: 'h-8' %>
                  </a>
                <% else %>
                  <%= image_tag c_compliant_icon, alt: 'Compliant', class: 'h-8' %>
                <% end %>
              <% elsif !validation_result['valid'] && c_not_compliant_icon.present? %>
                <% if badge_link.present? %>
                  <a href="<%= badge_link %>" target="_blank" rel="noopener noreferrer">
                    <%= image_tag c_not_compliant_icon, alt: 'Non-Compliant', class: 'h-8' %>
                  </a>
                <% else %>
                  <%= image_tag c_not_compliant_icon, alt: 'Non-Compliant', class: 'h-8' %>
                <% end %>
              <% end %>
            </div>

            <% if c_description.present? %>
              <p class="text-sm text-gray-600 mb-3"><%= c_description %></p>
            <% end %>

            <% if validation_result['error'] %>
              <!-- Job-level error (e.g., no loom file found) -->
              <div class="bg-red-50 border border-red-200 rounded p-3 mb-3">
                <div class="text-sm text-red-800"><%= validation_result['error'] %></div>
              </div>
            <% else %>
              <div class="grid grid-cols-3 gap-4 text-center mb-3">
                <div class="bg-red-50 rounded p-2">
                  <div class="text-2xl font-bold text-red-600"><%= validation_result['errors_count'] || validation_result['errors']&.count || 0 %></div>
                  <div class="text-xs text-red-700">Errors</div>
                </div>
                <div class="bg-yellow-50 rounded p-2">
                  <div class="text-2xl font-bold text-yellow-600"><%= validation_result['warnings_count'] || validation_result['warnings']&.count || 0 %></div>
                  <div class="text-xs text-yellow-700">Warnings</div>
                </div>
                <div class="bg-blue-50 rounded p-2">
                  <div class="text-2xl font-bold text-blue-600"><%= validation_result['info_count'] || validation_result['info']&.count || 0 %></div>
                  <div class="text-xs text-blue-700">Info</div>
                </div>
              </div>

              <% if validation_result['loom_file'] || validation_result['loom_path'] %>
                <div class="text-xs text-gray-500 mb-3">
                  File: <%= File.basename((validation_result['loom_file'] || validation_result['loom_path']).to_s) %>
                </div>
              <% end %>
            <% end %>

            <div class="flex items-center justify-between">
              <div class="flex flex-wrap gap-3">
                <%= link_to compliance_project_result_path(@project.id),
                    class: "inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors" do %>
                  View Full Report
                <% end %>

                <button type="button"
                        data-action="click->metadata-validation#runValidation"
                        data-metadata-validation-target="validateButton"
                        class="inline-flex items-center px-4 py-2 bg-gray-200 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-300 transition-colors">
                  Re-run Validation
                </button>

                <% unless validation_result['valid'] %>
                  <%= link_to compliance_project_fix_path(@project.id),
                      class: "inline-flex items-center px-4 py-2 bg-amber-500 text-white text-sm font-medium rounded-md hover:bg-amber-600 transition-colors" do %>
                    Fix Compliance Issues
                  <% end %>
                <% end %>
              </div>
              <% if validation_result['validated_at'] %>
                <span class="text-xs text-gray-500">
                  Last validated: <%= Time.parse(validation_result['validated_at']).strftime("%B %d, %Y at %H:%M") rescue validation_result['validated_at'] %>
                </span>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="bg-white rounded-lg border border-gray-200 p-4">
            <!-- Schema header -->
            <div class="flex items-center gap-3 mb-3">
              <span class="text-sm font-semibold text-gray-800"><%= c_name %><%= " v#{c_version}" if c_version.present? %></span>
              <% if c_source_schema_name.present? && c_source_url.present? %>
                <a href="<%= c_source_url %>" target="_blank" rel="noopener noreferrer" class="text-xs text-blue-600 hover:text-blue-800 hover:underline">(<%= c_source_schema_name %><%= " v#{c_version}" if c_version.present? %>)</a>
              <% elsif c_source_url.present? %>
                <a href="<%= c_source_url %>" target="_blank" rel="noopener noreferrer" class="text-xs text-blue-600 hover:text-blue-800 hover:underline">(source schema)</a>
              <% end %>
            </div>

            <% if c_description.present? %>
              <p class="text-sm text-gray-600 mb-3"><%= c_description %></p>
            <% end %>

            <p class="text-gray-500 text-sm mb-3">No validation has been performed yet.</p>

            <button type="button"
                    data-action="click->metadata-validation#runValidation"
                    data-metadata-validation-target="validateButton"
                    class="inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors">
              Run Validation
            </button>
          </div>
        <% end %>
      </div>

      <!-- Loading State -->
      <div data-metadata-validation-target="loading" class="hidden">
        <div class="bg-white rounded-lg border border-gray-200 p-4">
          <div class="flex items-center gap-3">
            <svg class="animate-spin h-5 w-5 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span class="text-gray-600">Validation in progress...</span>
          </div>
        </div>
      </div>
    </div>
    <% end %>

    <!-- Programmatic Access -->
    <div class="bg-gray-50 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Programmatic Access & Downloads</h3>
      
      <div class="flex flex-wrap gap-3">
        <%= link_to get_loom_files_json_project_path(@project.key, download: 1), class: "inline-flex items-center px-4 py-2 bg-gray-200 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-300 transition-colors" do %>
          List of Loom files (JSON)
        <% end %>
      </div>
    </div>
  </div>
</div>
