function pickBestClaFromList(clas) {
  if (!Array.isArray(clas) || clas.length === 0) return null
  return clas.slice().sort(function(a, b) {
    var scoreA = (a.nber_agree || 0) - (a.nber_disagree || 0)
    var scoreB = (b.nber_agree || 0) - (b.nber_disagree || 0)
    if (scoreB !== scoreA) return scoreB - scoreA
    return String(b.created_at || '').localeCompare(String(a.created_at || ''))
  })[0]
}

function bestAnnotationLabelFromCla(cla) {
  if (!cla) return '-'
  var terms = Array.isArray(cla.cell_ontology_terms) ? cla.cell_ontology_terms : []
  if (terms.length > 0) {
    var labels = terms.map(function(t) {
      return String((t && (t.name || t.identifier)) || '').trim()
    }).filter(function(s) { return s.length > 0 })
    if (labels.length > 0) return labels.join(', ')
  }
  var name = String(cla.name || '').trim()
  if (name) return name
  return 'Unnamed annotation'
}

function newAnnotationFormValidation(formState) {
  formState = formState || _annotPopupData.newForm || {}
  var ontologyTerms = formState.ontologyTerms || []
  var allowsMultiple = selectedAnnotTypeAllowsMultipleOntologyTerms()
  var ontologyMissing = ontologyTerms.length === 0
  var ontologyTooMany = !allowsMultiple && ontologyTerms.length > 1
  return {
    valid: !ontologyMissing && !ontologyTooMany,
    ontologyMissing: ontologyMissing,
    ontologyTooMany: ontologyTooMany,
    allowsMultiple: allowsMultiple
  }
}

function updateCategoryRowAnnotationSummary(metadataId, catIdx, clas) {
  if (metadataId == null || catIdx == null) return
  var list = Array.isArray(clas) ? clas : []
