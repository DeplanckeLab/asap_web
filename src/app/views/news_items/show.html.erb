<% content_for :title, "#{@news_item.title} - News - ASAP" %>
<div class="max-w-3xl mx-auto py-10 px-4 sm:px-6 lg:px-8 space-y-6">
  <div class="flex items-center justify-between gap-4 flex-wrap">
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">News item</h1>
    <div class="flex items-center gap-2">
      <%= link_to 'Back to news', news_items_path, class: 'inline-flex items-center px-3 py-2 rounded-md border border-gray-200 text-sm text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-800' %>
      <% if admin? %>
        <%= link_to 'Edit', edit_news_item_path(@news_item), class: 'inline-flex items-center px-3 py-2 rounded-md bg-gray-900 text-white text-sm font-medium hover:bg-gray-800 transition' %>
      <% end %>
    </div>
  </div>

  <% if notice.present? %>
    <div class="rounded-md bg-green-100 px-4 py-3 text-sm text-green-700"><%= notice %></div>
  <% end %>

  <%= render 'news_item', news_item: @news_item, show_actions: false %>
</div>
