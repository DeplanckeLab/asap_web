  var has = list.length > 0
  var label = has ? bestAnnotationLabelFromCla(best) : '-'
  var selector = '.category-annot-btn[data-metadata-id="' + String(metadataId) + '"][data-cat-idx="' + String(catIdx) + '"]'
  document.querySelectorAll(selector).forEach(function(btn) {
    btn.dataset.categoryHasAnnots = has ? 'true' : 'false'
    btn.style.color = has ? '#16a34a' : '#d1d5db'
    btn.title = has ? 'View annotations' : 'No annotations yet'
    var row = btn.closest('.metadata-category-row')
    if (!row) return
    var bestEl = row.querySelector('.metadata-category-best')
    if (bestEl) {
      bestEl.textContent = label
      bestEl.title = label
    }
  })
  if (String(metadataId) === String(_annotPopupData.metadataId) && String(catIdx) === String(_annotPopupData.catIdx)) {
    _annotPopupData.titleAnnotHint = has
    refreshAnnotPopupTitle()
  }
