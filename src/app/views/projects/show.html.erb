<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @project.display_name %> - ASAP</title>
  <%= csrf_meta_tags %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="bg-gray-50">
  <!-- Top Bar -->
  <div class="bg-black shadow-sm border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <!-- Left side: Logo and Project Info -->
        <div class="flex items-center space-x-6">
          <!-- ASAP Logo -->
          <div class="flex-shrink-0">
            <%= image_tag "ASAP_sansTagline_White.svg", 
                class: 'h-8 w-32 object-contain', 
                alt: 'ASAP Logo' %>
          </div>
          
          <!-- Project Info -->
        <% version_label = @project.version_id.presence || '2.0.0' %>
        <div class="flex items-center space-x-4">
            <div>
            <h1 class="text-lg font-semibold text-white flex items-center gap-2">
              <span><%= @project.display_name %></span>
              <span class="inline-flex items-center px-2 py-0.5 text-xs font-semibold tracking-wide uppercase text-gray-100 bg-gray-700 rounded-full border border-gray-600">
                v<%= version_label %>
              </span>
            </h1>
              <div class="flex items-center space-x-4 text-sm text-gray-300">
                <span><i class="fas fa-circle text-gray-400 mr-1"></i><%= number_with_delimiter(@project.cell_count) %> cells</span>
                <span><i class="fas fa-dna text-gray-400 mr-1"></i><%= @project.organism_display %></span>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Center: ASAP Version -->
        <div class="flex-1 flex justify-center">
          <!--<span class="text-sm text-gray-300">ASAP v<%= @project.version_id || '2.0.0' %></span>-->
        </div>
        
        <!-- Right side: Navigation Icons -->
        <div class="flex items-center space-x-2">
          <!-- Summary Icon -->
          <%= link_to project_path(@project, view: 'summary'), 
              class: "p-2 rounded-lg #{@view_type == 'summary' ? 'bg-gray-700 text-white' : 'text-gray-300 hover:bg-gray-700'}" do %>
            <i class="fas fa-info-circle text-lg"></i>
          <% end %>
          
          <!-- Visualization Icon (default selected) -->
          <%= link_to project_path(@project, view: 'visualization'), 
              class: "p-2 rounded-lg #{@view_type == 'visualization' ? 'bg-gray-700 text-white' : 'text-gray-300 hover:bg-gray-700'}" do %>
            <i class="fas fa-chart-line text-lg"></i>
          <% end %>
          
          <!-- Analysis Icon -->
          <%= link_to project_path(@project, view: 'analysis'), 
              class: "p-2 rounded-lg #{@view_type == 'analysis' ? 'bg-gray-700 text-white' : 'text-gray-300 hover:bg-gray-700'}" do %>
            <i class="fas fa-microscope text-lg"></i>
          <% end %>
          
          <!-- Data Icon -->
          <%= link_to project_path(@project, view: 'data'), 
              class: "p-2 rounded-lg #{@view_type == 'data' ? 'bg-gray-700 text-white' : 'text-gray-300 hover:bg-gray-700'}" do %>
            <i class="fas fa-database text-lg"></i>
          <% end %>
          
          <!-- Settings Icon -->
          <%= link_to project_path(@project, view: 'settings'), 
              class: "p-2 rounded-lg #{@view_type == 'settings' ? 'bg-gray-700 text-white' : 'text-gray-300 hover:bg-gray-700'}" do %>
            <i class="fas fa-cog text-lg"></i>
          <% end %>
          
          <% if admin? %>
            <div class="relative ml-4" id="admin-tools-dropdown">
              <button id="admin-tools-button"
                      class="p-2 rounded-lg text-gray-300 hover:bg-gray-700 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-gray-600 transition flex items-center gap-2"
                      title="Admin tools"
                      data-admin-tools-toggle>
                <i class="fas fa-tools text-lg"></i>
                <span class="hidden sm:inline text-sm">Admin</span>
                <i class="fas fa-chevron-down text-xs"></i>
              </button>
              <div class="hidden absolute right-0 mt-2 w-56 bg-white text-gray-800 rounded-lg shadow-lg border border-gray-200 z-50"
                   data-admin-tools-menu>
                <div class="py-2 text-sm">
                  <%= link_to versions_path, class: 'flex items-center gap-2 px-3 py-2 hover:bg-gray-100' do %>
                    <i class="fas fa-code-branch text-xs text-gray-500"></i>
                    <span>Versions</span>
                  <% end %>
                  <%= link_to tools_path, class: 'flex items-center gap-2 px-3 py-2 hover:bg-gray-100' do %>
                    <i class="fas fa-wrench text-xs text-gray-500"></i>
                    <span>Tools</span>
                  <% end %>
                  <%= link_to tool_types_path, class: 'flex items-center gap-2 px-3 py-2 hover:bg-gray-100' do %>
                    <i class="fas fa-tags text-xs text-gray-500"></i>
                    <span>Tool Types</span>
                  <% end %>
                  <%= link_to docker_images_path, class: 'flex items-center gap-2 px-3 py-2 hover:bg-gray-100' do %>
                    <i class="fas fa-cube text-xs text-gray-500"></i>
                    <span>Docker Images</span>
                  <% end %>
                  <%= link_to '#', class: 'flex items-center gap-2 px-3 py-2 hover:bg-gray-100' do %>
                    <i class="fas fa-sliders-h text-xs text-gray-500"></i>
                    <span>Project settings</span>
                  <% end %>
                  <%= link_to '#', class: 'flex items-center gap-2 px-3 py-2 hover:bg-gray-100' do %>
                    <i class="fas fa-user-shield text-xs text-gray-500"></i>
                    <span>Manage permissions</span>
                  <% end %>
                  <%= link_to '#', class: 'flex items-center gap-2 px-3 py-2 hover:bg-gray-100' do %>
                    <i class="fas fa-download text-xs text-gray-500"></i>
                    <span>Download logs</span>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
          
          <!-- Back to Projects -->
          <%= link_to projects_path, 
              class: "ml-4 p-2 rounded-lg text-gray-300 hover:bg-gray-700" do %>
            <i class="fas fa-arrow-left text-lg"></i>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Content Area -->
  <div>
    <% case @view_type %>
    <% when 'summary' %>
      <%# render 'projects/views/summary_test' %>
    <% when 'visualization' %>
      <%= render 'projects/views/visualization' %>
    <% when 'analysis' %>
      <%= render 'projects/views/analysis' %>
    <% when 'data' %>
      <%= render 'projects/views/data' %>
    <% when 'settings' %>
      <%= render 'projects/views/settings' %>
    <% else %>
      <%= render 'projects/views/visualization' %>
    <% end %>
  </div>
  
  <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  <script>
    (function() {
      function setupAdminToolsDropdown() {
        const container = document.getElementById('admin-tools-dropdown')
        if (!container) return

        const toggleButton = container.querySelector('[data-admin-tools-toggle]')
        const menu = container.querySelector('[data-admin-tools-menu]')
        if (!toggleButton || !menu) return

        // Remove previous listeners if they exist
        if (container._adminToggleHandler) {
          toggleButton.removeEventListener('click', container._adminToggleHandler)
        }
        if (container._adminOutsideHandler) {
          document.removeEventListener('click', container._adminOutsideHandler)
        }

        const openClass = 'hidden'

        function closeMenu() {
          menu.classList.add(openClass)
          toggleButton.setAttribute('aria-expanded', 'false')
        }

        const toggleHandler = function(event) {
          event.preventDefault()
          event.stopPropagation()
          const isHidden = menu.classList.contains(openClass)
          if (isHidden) {
            menu.classList.remove(openClass)
            toggleButton.setAttribute('aria-expanded', 'true')
          } else {
            closeMenu()
          }
        }

        const outsideHandler = function(event) {
          if (!container.contains(event.target)) {
            closeMenu()
          }
        }

        toggleButton.addEventListener('click', toggleHandler)
        document.addEventListener('click', outsideHandler)

        container._adminToggleHandler = toggleHandler
        container._adminOutsideHandler = outsideHandler
      }

      function init() {
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', setupAdminToolsDropdown, { once: true })
        } else {
          setupAdminToolsDropdown()
        }
      }

      init()
      document.addEventListener('turbo:load', setupAdminToolsDropdown)
    })()
  </script>
</body>
</html>