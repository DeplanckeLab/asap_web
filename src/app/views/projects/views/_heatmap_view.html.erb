          <div id="heatmap-checkpoint-save-existing-fields" style="display:none; flex-direction:column; gap:6px; padding:8px 0 0 24px;">
            <label for="heatmap-checkpoint-save-existing-select" style="font-size:12px; color:#4b5563;">Checkpoint</label>
