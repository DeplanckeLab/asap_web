<% content_for :title, "New project" %>

<div class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="mb-8">
    <h1 class="text-3xl font-semibold text-gray-900 dark:text-white">Create project</h1>
    <p class="mt-2 text-gray-600 dark:text-gray-300">
      Create a new project to analyze your single-cell RNA-seq data.
    </p>
  </div>

  <%= render "form", project: @project %>

  <div class="mt-6">
    <%= link_to "Back to projects", projects_path, class: "text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100 inline-flex items-center font-medium" %>
  </div>
</div>
