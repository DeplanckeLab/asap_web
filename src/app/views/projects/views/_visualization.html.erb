              <% option_name_candidate = nil %>
              <% if embedding.name.present? %>
                <% raw_name = embedding.name %>
                <% option_name_candidate = raw_name.include?('/') ? raw_name.split('/').last : raw_name %>
              <% elsif embedding.label.present? %>
                <% option_name_candidate = embedding.label %>
              <% elsif embedding.display_name.present? %>
                <% option_name_candidate = embedding.display_name %>
              <% end %>
              <% option_label = option_name_candidate.presence || "Embedding #{embedding.id}" %>
              <option value="<%= embedding.id %>" <%= (default_embedding_id.present? && embedding.id == default_embedding_id) ? 'selected' : '' %>>
