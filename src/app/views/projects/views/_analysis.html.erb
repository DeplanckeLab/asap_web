<div class="flex flex-col h-full" data-controller="step-selector" data-step-selector-project-id-value="<%= @project.id %>" data-step-selector-project-key-value="<%= @project.key %>" data-step-selector-status-icons-value="<%= status_icons_json %>" data-step-selector-load-run-panel-value="<%= @load_run_panel %>">
  <!-- Header -->
  <div class="mb-4 flex-shrink-0">
    <div class="flex items-center justify-between gap-3 mb-2">
      <div class="flex items-center gap-3">
        <h2 class="text-2xl font-bold text-gray-900">Analysis</h2>
        <% if @project_type %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800 border border-blue-200">
            <%= @project_type.name %>
          </span>
        <% end %>
      </div>
      <div class="flex items-center gap-3 flex-shrink-0">
        <button type="button" 
                class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-medium transition-colors cursor-pointer inline-block"
                onclick="loadFormInRightPanel('<%= graph_project_path(@project) %>')">
          Graph
        </button>
      </div>
    </div>
   <!-- <p class="text-gray-600">Data analysis tools and pipelines for single-cell transcriptomics</p>-->
  </div>

  <!-- Step Selector for Narrow Screens (Mobile/Tablet) -->
  <%= render partial: 'projects/views/steps_panel_mobile' %>

  <!-- Two Column Layout: Steps Panel (Left) and Step Results (Right) -->
  <div class="flex flex-row gap-4 flex-1 min-h-0 w-full overflow-hidden" style="width: 100%; max-width: 100%; min-width: 0;">
    <!-- Left Panel: Steps Navigation (Hidden on narrow screens) -->
    <div class="hidden lg:flex w-75 flex-shrink-0 flex flex-col min-h-0 h-full overflow-hidden" data-step-selector-target="stepsPanel">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 flex flex-col h-full overflow-hidden">
        <%= render partial: 'projects/views/steps_panel' %>
      </div>
    </div>
    
    <!-- Right Panel: Step Results -->
    <div class="flex-1 flex flex-col min-h-0 min-w-0" style="min-width: 0; max-width: 100%; overflow-x: hidden;">
      <div data-step-selector-target="resultsContainer" class="bg-white rounded-lg shadow-sm border border-gray-200 flex flex-col h-full overflow-hidden w-full" style="width: 100%; max-width: 100%; min-width: 0; overflow-x: hidden;">
        <div class="overflow-y-auto overflow-x-hidden flex-1 min-w-0 w-full" style="width: 100%; max-width: 100%; min-width: 0; overflow-x: hidden;">
          <div class="text-center text-gray-500 py-12 px-6" data-step-selector-target="emptyState">
            <i class="fas fa-mouse-pointer text-5xl mb-4 opacity-30"></i>
            <p class="mb-0 lg:hidden">Select a step from the dropdown above to view its results</p>
            <p class="mb-0 hidden lg:block">Select a step from the left panel to view its results</p>
          </div>
          <div data-step-selector-target="loadingState" style="display: none;" class="text-center py-12 px-6">
            <i class="fas fa-spinner fa-spin text-3xl text-blue-600 mb-4"></i>
            <p class="text-gray-600 mb-0">Loading step results...</p>
          </div>
          <div data-step-selector-target="content" style="display: none; width: 100% !important; max-width: 100% !important; min-width: 0 !important; overflow-x: hidden !important; box-sizing: border-box !important;" class="w-full max-w-full min-w-0 overflow-x-hidden">
            <!-- Step results will be loaded here -->
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


<script>
  function loadFormInRightPanel(formUrl) {
    console.log('[loadFormInRightPanel] Loading form from:', formUrl)
    
    // Find the step-selector controller and its content target
    const stepSelectorElement = document.querySelector('[data-controller*="step-selector"]')
    if (!stepSelectorElement) {
      console.error('[loadFormInRightPanel] Step selector element not found')
      return
    }
    
    // Get the controller instance
    if (!window.Stimulus) {
      console.error('[loadFormInRightPanel] Stimulus not available')
      return
    }
    
    const controller = window.Stimulus.getControllerForElementAndIdentifier(stepSelectorElement, 'step-selector')
    if (!controller || !controller.hasContentTarget) {
      console.error('[loadFormInRightPanel] Step selector controller or content target not found')
      return
    }
    
    // Save state to localStorage - for forms we save step state (not form state)
    // When user comes back, they'll see the step results, which includes the form if no runs exist
    if (controller.currentStepId && typeof controller.saveState === 'function') {
      controller.saveState(controller.currentStepId, 'step', null)
      console.log('[loadFormInRightPanel] State saved for step:', controller.currentStepId)
    }
    
    // Hide empty state and loading state, show content
    if (controller.hasEmptyStateTarget) {
      controller.emptyStateTarget.style.display = 'none'
    }
    if (controller.hasLoadingStateTarget) {
      controller.loadingStateTarget.style.display = 'block'
    }
    controller.contentTarget.style.display = 'none'
    
    // Fetch the form
    fetch(formUrl, {
      method: 'GET',
      headers: {
        'Accept': 'text/html',
        'X-Requested-With': 'XMLHttpRequest'
      },
      credentials: 'same-origin'
    })
    .then(response => {
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`)
      }
      return response.text()
    })
    .then(html => {
      console.log('[loadFormInRightPanel] Form loaded, length:', html.length)
      
      // Create a temporary container to parse HTML
      const tempDiv = document.createElement('div')
      tempDiv.innerHTML = html
      
      // Separate external scripts (with src) from inline scripts
      const externalScripts = []
      const inlineScripts = []
      const scripts = tempDiv.querySelectorAll('script')
      
      scripts.forEach(script => {
        if (script.src) {
          externalScripts.push(script.src)
        } else {
          inlineScripts.push(script.textContent)
        }
        script.remove()
      })
      
      // Update content with form (without script tags)
      controller.contentTarget.innerHTML = tempDiv.innerHTML
      controller.contentTarget.style.display = 'block'
      
      // Load external scripts first, then execute inline scripts
      const loadScripts = (index) => {
        if (index < externalScripts.length) {
          const script = document.createElement('script')
          script.src = externalScripts[index]
          script.onload = () => {
            console.log('[loadFormInRightPanel] External script loaded:', externalScripts[index])
            loadScripts(index + 1)
          }
          script.onerror = () => {
            console.error('[loadFormInRightPanel] Failed to load script:', externalScripts[index])
            loadScripts(index + 1) // Continue even if one fails
          }
          document.head.appendChild(script)
        } else {
          // All external scripts loaded, now execute inline scripts
          inlineScripts.forEach((scriptText, idx) => {
            const script = document.createElement('script')
            script.textContent = scriptText
            document.head.appendChild(script)
            document.head.removeChild(script) // Remove after execution
            console.log('[loadFormInRightPanel] Inline script executed:', idx)
          })
          
          // Hide loading state
          if (controller.hasLoadingStateTarget) {
            controller.loadingStateTarget.style.display = 'none'
          }
          
          // Trigger Stimulus to scan for new controllers in the form
          if (window.Stimulus && window.Stimulus.router && typeof window.Stimulus.router.scan === 'function') {
            setTimeout(() => {
              window.Stimulus.router.scan()
            }, 0)
            
            setTimeout(() => {
              window.Stimulus.router.scan()
            }, 100)
          }
        }
      }
      
      // Start loading scripts
      if (externalScripts.length > 0) {
        loadScripts(0)
      } else {
        // No external scripts, just execute inline scripts
        inlineScripts.forEach((scriptText) => {
          const script = document.createElement('script')
          script.textContent = scriptText
          document.head.appendChild(script)
          document.head.removeChild(script)
        })
        
        if (controller.hasLoadingStateTarget) {
          controller.loadingStateTarget.style.display = 'none'
        }
        
        if (window.Stimulus && window.Stimulus.router && typeof window.Stimulus.router.scan === 'function') {
          setTimeout(() => {
            window.Stimulus.router.scan()
          }, 0)
          
          setTimeout(() => {
            window.Stimulus.router.scan()
          }, 100)
        }
      }
    })
    .catch(error => {
      console.error('[loadFormInRightPanel] Error loading form:', error)
      if (controller.hasLoadingStateTarget) {
        controller.loadingStateTarget.style.display = 'none'
      }
      controller.contentTarget.innerHTML = `
        <div class="alert alert-danger p-4">
          <i class="fas fa-exclamation-triangle me-2"></i>
          Error loading form: ${error.message}
        </div>
      `
      controller.contentTarget.style.display = 'block'
    })
  }

  function loadRunInRightPanel(runUrl, stepId) {
    console.log('[loadRunInRightPanel] Loading run from:', runUrl, 'stepId:', stepId)
    
    // Find the step-selector controller and its content target
    const stepSelectorElement = document.querySelector('[data-controller*="step-selector"]')
    if (!stepSelectorElement) {
      console.error('[loadRunInRightPanel] Step selector element not found')
      return
    }
    
    // Get the controller instance
    if (!window.Stimulus) {
      console.error('[loadRunInRightPanel] Stimulus not available')
      return
    }
    
    const controller = window.Stimulus.getControllerForElementAndIdentifier(stepSelectorElement, 'step-selector')
    if (!controller || !controller.hasContentTarget) {
      console.error('[loadRunInRightPanel] Step selector controller or content target not found')
      return
    }
    
    // Extract run ID from URL for state persistence
    const runIdMatch = runUrl.match(/\/runs\/(\d+)/)
    const runId = runIdMatch ? runIdMatch[1] : null
    
    // Update the current step ID if provided (for highlighting in left panel)
    if (stepId) {
      controller.currentStepId = stepId.toString()
      controller.element.setAttribute('data-current-step-id', stepId.toString())
      console.log('[loadRunInRightPanel] Updated currentStepId to:', stepId)
    }
    
    // Save state to localStorage for when user returns from visualization view
    const effectiveStepId = stepId || controller.currentStepId
    if (runId && effectiveStepId && typeof controller.saveState === 'function') {
      controller.saveState(effectiveStepId, 'run', runId)
      console.log('[loadRunInRightPanel] State saved for run:', runId, 'step:', effectiveStepId)
    }
    
    // Refresh the steps panel to update the highlighting
    if (stepId && typeof controller.refreshStepsPanel === 'function') {
      controller.refreshStepsPanel()
    }
    
    // Hide empty state and loading state, show content
    if (controller.hasEmptyStateTarget) {
      controller.emptyStateTarget.style.display = 'none'
    }
    if (controller.hasLoadingStateTarget) {
      controller.loadingStateTarget.style.display = 'block'
    }
    controller.contentTarget.style.display = 'none'
    
    // Fetch the run content (with panel parameter to get panel version)
    const panelUrl = runUrl + (runUrl.includes('?') ? '&' : '?') + 'panel=1'
    fetch(panelUrl, {
      method: 'GET',
      headers: {
        'Accept': 'text/html',
        'X-Requested-With': 'XMLHttpRequest'
      },
      credentials: 'same-origin'
    })
    .then(response => {
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`)
      }
      return response.text()
    })
    .then(html => {
      console.log('[loadRunInRightPanel] Run loaded, length:', html.length)
      
      // Update content with run
      controller.contentTarget.innerHTML = html
      controller.contentTarget.style.display = 'block'
      
      // Hide loading state
      if (controller.hasLoadingStateTarget) {
        controller.loadingStateTarget.style.display = 'none'
      }
      
      // Trigger Stimulus to connect new controllers in the dynamically loaded content
      console.log('[loadRunInRightPanel] Triggering Stimulus to connect new controllers...')
      
      // Log what controllers are in the new content
      const newControllerElements = controller.contentTarget.querySelectorAll('[data-controller]')
      console.log('[loadRunInRightPanel] Found elements with data-controller:', newControllerElements.length)
      newControllerElements.forEach(el => {
        console.log('[loadRunInRightPanel] Controller element:', el.getAttribute('data-controller'), el)
      })
      
      // The MutationObserver in Stimulus should automatically detect new elements
      // But let's also try forcing a reconnection by temporarily removing and re-adding
      // the content to trigger the mutation
      setTimeout(() => {
        // Check if controllers are connected
        const pipelineRunsElements = controller.contentTarget.querySelectorAll('[data-controller*="pipeline-runs"]')
        console.log('[loadRunInRightPanel] pipeline-runs elements:', pipelineRunsElements.length)
        pipelineRunsElements.forEach(el => {
          if (window.Stimulus) {
            const ctrl = window.Stimulus.getControllerForElementAndIdentifier(el, 'pipeline-runs')
            console.log('[loadRunInRightPanel] pipeline-runs controller connected:', !!ctrl, el)
            if (!ctrl) {
              // Controller not connected - try to force it by cloning
              console.log('[loadRunInRightPanel] Attempting to force controller connection...')
              const clone = el.cloneNode(true)
              el.parentNode.replaceChild(clone, el)
            }
          }
        })
      }, 200)
    })
    .catch(error => {
      console.error('[loadRunInRightPanel] Error loading run:', error)
      if (controller.hasLoadingStateTarget) {
        controller.loadingStateTarget.style.display = 'none'
      }
      controller.contentTarget.innerHTML = `
        <div class="alert alert-danger p-4">
          <i class="fas fa-exclamation-triangle me-2"></i>
          Error loading run: ${error.message}
        </div>
      `
      controller.contentTarget.style.display = 'block'
    })
  }

  // Auto-load selected run if run_id is provided in URL
  // Only load in panel if the step uses standard view (has_std_view == true)
  // For custom view steps (has_std_view == false), the step_results partial shows the custom partial
  console.log('[Analysis] Debug: @selected_run_id=<%= @selected_run_id.inspect %>, @selected_step_id=<%= @selected_step_id.inspect %>, @load_run_panel=<%= @load_run_panel.inspect %>')
  
  // Debug: Check step selector state after DOM is ready
  document.addEventListener('DOMContentLoaded', function() {
    setTimeout(function() {
      const stepSelectorEl = document.querySelector('[data-controller*="step-selector"]')
      console.log('[Analysis] Step selector element:', stepSelectorEl)
      console.log('[Analysis] Step selector data-current-step-id:', stepSelectorEl?.getAttribute('data-current-step-id'))
      
      const stepElements = document.querySelectorAll('[data-step-id]')
      console.log('[Analysis] Found step elements:', stepElements.length)
      stepElements.forEach(el => {
        console.log('[Analysis] Step element:', el.getAttribute('data-step-id'), el.textContent.trim().substring(0, 30))
      })
      
      const targetStepEl = document.querySelector('[data-step-id="<%= @selected_step_id %>"]')
      console.log('[Analysis] Target step element (step_id=<%= @selected_step_id %>):', targetStepEl)
      
      const contentTarget = document.querySelector('[data-step-selector-target="content"]')
      console.log('[Analysis] Content target innerHTML length:', contentTarget?.innerHTML?.length)
      console.log('[Analysis] Content target preview:', contentTarget?.innerHTML?.substring(0, 200))
    }, 500)
  })
  
  <% if @load_run_panel %>
  console.log('[Analysis] @load_run_panel is TRUE - will auto-load run panel directly')
  // Load run panel directly - step_selector_controller is skipping step results for this case
  document.addEventListener('DOMContentLoaded', function() {
    // Small delay to ensure Stimulus controller is initialized
    setTimeout(function() {
      const runUrl = '<%= run_path(@selected_run_id) %>'
      const stepId = '<%= @selected_step_id %>'
      console.log('[Auto-load] Loading run panel directly:', runUrl, 'stepId:', stepId)
      loadRunInRightPanel(runUrl, stepId)
    }, 100)
  })
  <% else %>
  console.log('[Analysis] @load_run_panel is FALSE - will NOT auto-load run panel, step_results will show custom partial')
  <% end %>

</script>
