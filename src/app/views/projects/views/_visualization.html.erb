<script>
// Right Panel Draggable Divider functionality
document.addEventListener('DOMContentLoaded', function() {
  const rightPanelDivider = document.getElementById('right-panel-divider')
  const rightPanel = rightPanelDivider.parentElement
  const geneExpressionPanel = rightPanel.querySelector('div:first-child')
  const selectionsPanel = rightPanel.querySelector('div:last-child')
  
  let isDraggingRight = false
  let startYRight = 0
  let startHeightRight = 0
  
  // Minimum heights for panels (in pixels)
  const minPanelHeightRight = 150
  
  function startDragRight(e) {
    isDraggingRight = true
    startYRight = e.clientY
    startHeightRight = geneExpressionPanel.offsetHeight
    
    // Add visual feedback
    document.body.style.cursor = 'row-resize'
    rightPanelDivider.style.backgroundColor = '#6B7280' // darker gray
    
    // Prevent text selection during drag
    document.body.style.userSelect = 'none'
    
    e.preventDefault()
  }
  
  function doDragRight(e) {
    if (!isDraggingRight) return
    
    const deltaY = e.clientY - startYRight
    const newHeight = startHeightRight + deltaY
    
    // Calculate container height
    const containerHeight = rightPanel.offsetHeight - rightPanelDivider.offsetHeight
    
    // Apply constraints
    const constrainedHeight = Math.max(minPanelHeightRight, Math.min(newHeight, containerHeight - minPanelHeightRight))
    
    // Update gene expression panel height
    geneExpressionPanel.style.height = constrainedHeight + 'px'
    selectionsPanel.style.height = (containerHeight - constrainedHeight) + 'px'
  }
  
  function stopDragRight() {
    if (!isDraggingRight) return
    
    isDraggingRight = false
    
    // Remove visual feedback
    document.body.style.cursor = ''
    rightPanelDivider.style.backgroundColor = ''
    document.body.style.userSelect = ''
  }
  
  // Event listeners
  rightPanelDivider.addEventListener('mousedown', startDragRight)
  document.addEventListener('mousemove', doDragRight)
  document.addEventListener('mouseup', stopDragRight)
  document.addEventListener('mouseleave', stopDragRight)
  
  console.log('Right panel draggable divider initialized')
})
</script>

