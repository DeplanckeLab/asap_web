<div class="flex flex-col h-full" data-controller="step-selector" data-step-selector-project-id-value="<%= @project.id %>">
  <!-- Header -->
  <div class="mb-4 flex-shrink-0">
    <div class="flex items-center gap-3 mb-2">
      <h2 class="text-2xl font-bold text-gray-900">Analysis</h2>
      <% if @project_type %>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800 border border-blue-200">
          <%= @project_type.name %>
        </span>
      <% end %>
    </div>
   <!-- <p class="text-gray-600">Data analysis tools and pipelines for single-cell transcriptomics</p>-->
  </div>

  <!-- Two Column Layout: Steps Panel (Left) and Step Results (Right) -->
  <div class="flex flex-row gap-4 flex-1 min-h-0">
    <!-- Left Panel: Steps Navigation -->
    <div class="w-1/4 flex-shrink-0 flex flex-col min-h-0">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 flex flex-col h-full overflow-hidden">
        <%= render partial: 'projects/views/steps_panel' %>
      </div>
    </div>
    
    <!-- Right Panel: Step Results -->
    <div class="flex-1 flex flex-col min-h-0">
      <div data-step-selector-target="resultsContainer" class="bg-white rounded-lg shadow-sm border border-gray-200 flex flex-col h-full overflow-hidden">
        <div class="overflow-y-auto flex-1">
          <div class="text-center text-gray-500 py-12 px-6" data-step-selector-target="emptyState">
            <i class="fas fa-mouse-pointer text-5xl mb-4 opacity-30"></i>
            <p class="mb-0">Select a step from the left panel to view its results</p>
          </div>
          <div data-step-selector-target="loadingState" style="display: none;" class="text-center py-12 px-6">
            <i class="fas fa-spinner fa-spin text-3xl text-blue-600 mb-4"></i>
            <p class="text-gray-600 mb-0">Loading step results...</p>
          </div>
          <div data-step-selector-target="content" style="display: none;" class="w-full max-w-full">
            <!-- Step results will be loaded here -->
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
