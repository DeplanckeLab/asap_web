        </div>

        <div class="settings-field-row" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
          <label for="discrete-palette-select" style="font-size: 13px; font-weight: 500; color: #374151;">
            Discrete color palette
          </label>
          <select id="discrete-palette-select"
                  style="width: 200px; padding: 6px 8px; font-size: 12px; border: 1px solid #d1d5db; border-radius: 4px; background-color: white; color: #374151; cursor: pointer;">
            <option value="colorblind_friendly" selected>Colorblind friendly</option>
            <option value="high_contrast">High contrast</option>
          </select>
        </div>
        
        <!-- Point Order Options -->
        <div style="display: flex; flex-direction: column; gap: 12px;">
          
          <!-- Category Order -->
          <div class="settings-field-row" style="display: flex; align-items: center; justify-content: space-between;">
            <label style="font-size: 13px; font-weight: 500; color: #374151;">
              Category order
            </label>
            <select id="category-order-select"
                    style="width: 220px; padding: 6px 8px; font-size: 12px; border: 1px solid #d1d5db; border-radius: 4px; background-color: white; color: #374151; cursor: pointer;">
              <option value="largest-first" selected>Large to small</option>
              <option value="smallest-first">Small to large</option>
              <option value="random">Random categories</option>
              <option value="fixed">Random points (fixed) [fastest]</option>
            </select>
          </div>
          
          <!-- Numerical Order -->
          <div class="settings-field-row" style="display: flex; align-items: center; justify-content: space-between;">
            <label style="font-size: 13px; font-weight: 500; color: #374151;">
              Numerical order
            </label>
            <select id="numerical-order-select"
                    style="width: 160px; padding: 6px 8px; font-size: 12px; border: 1px solid #d1d5db; border-radius: 4px; background-color: white; color: #374151; cursor: pointer;">
              <option value="negative-to-positive">Negative to positive</option>
              <option value="positive-to-negative">Positive to negative</option>
              <option value="abs-min-to-max">Absolute min to max</option>
              <option value="abs-max-to-min">Absolute max to min</option>
              <option value="random">Random</option>
            </select>
          </div>
        </div>

        <p style="margin: 16px 0 0 0; padding-top: 14px; border-top: 1px solid #e5e7eb; color: #374151;">
          <span style="display: block; font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: #6b7280; margin-bottom: 10px;">
            Histograms
          </span>
          <span style="display: block; font-size: 12px; color: #6b7280; margin-bottom: 12px; line-height: 1.4;">
            Gene expression only
          </span>
          <span class="settings-field-row" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
            <label for="histogram-scale-select" style="font-size: 13px; font-weight: 500;">Scale</label>
            <select id="histogram-scale-select"
                    style="width: 160px; padding: 6px 8px; font-size: 12px; border: 1px solid #d1d5db; border-radius: 4px; background-color: white; color: #374151; cursor: pointer;">
              <option value="normal" selected>Normal</option>
              <option value="log">Log</option>
            </select>
          </span>
          <span style="display: flex; align-items: center; justify-content: space-between;">
            <label for="histogram-ignore-zeros-checkbox" style="font-size: 13px; font-weight: 500; cursor: pointer;">Ignore 0 values</label>
            <input type="checkbox"
                   id="histogram-ignore-zeros-checkbox"
                   checked
                   style="width: 16px; height: 16px; cursor: pointer;">
          </span>
        </p>

      </div>
      
      <!-- Main Plot Settings -->
      <div id="settings-tab-content-main-plot" style="display: none;">
        <div style="font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: #6b7280; margin-bottom: 12px;">
          Main plot settings
        </div>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          
          <!-- Show Grid -->
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <label style="font-size: 13px; font-weight: 500; color: #374151; cursor: pointer;">
              Show Grid
            </label>
            <input type="checkbox" 
                   id="show-grid-checkbox" 
                   checked 
                   style="width: 16px; height: 16px; cursor: pointer;"
                   data-action="change->visualization#toggleGrid">
          </div>
          
          <!-- Show Axes -->
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <label style="font-size: 13px; font-weight: 500; color: #374151; cursor: pointer;">
              Show Scale
            </label>
            <input type="checkbox" 
                   id="show-axes-checkbox" 
                   checked 
                   style="width: 16px; height: 16px; cursor: pointer;"
                   data-action="change->visualization#toggleAxes">
          </div>
        </div>
      </div>

      <!-- Label Settings -->
      <div id="settings-tab-content-labels" style="display: none;">
        <div style="font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: #6b7280; margin-bottom: 12px;">
          Label settings
        </div>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <!-- Show Categories -->
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <label style="font-size: 13px; font-weight: 500; color: #374151; cursor: pointer;">
              Show Category Labels
            </label>
            <input type="checkbox"
                   id="show-categories-checkbox"
                   style="width: 16px; height: 16px; cursor: pointer;"
                   data-action="change->visualization#toggleCategories">
          </div>

          <!-- Label Boxes -->
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <label style="font-size: 13px; font-weight: 500; color: #374151; cursor: pointer;">
              Label boxes
            </label>
            <input type="checkbox"
                   id="show-label-boxes-checkbox"
                   checked
                   style="width: 16px; height: 16px; cursor: pointer;">
          </div>

          <!-- Label Text Size -->
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <label for="label-font-size-select" style="font-size: 13px; font-weight: 500; color: #374151;">
              Label text size
            </label>
            <select id="label-font-size-select"
                    style="width: 160px; padding: 6px 8px; font-size: 12px; border: 1px solid #d1d5db; border-radius: 4px; background-color: white; color: #374151; cursor: pointer;">
              <option value="auto" selected>Auto</option>
              <option value="10">Small</option>
              <option value="12">Medium</option>
              <option value="14">Large</option>
              <option value="16">X-Large</option>
            </select>
          </div>

          <!-- Truncate Long Labels -->
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <label style="font-size: 13px; font-weight: 500; color: #374151; cursor: pointer;">
              Truncate long labels
            </label>
            <input type="checkbox"
                   id="truncate-labels-checkbox"
                   checked
                   style="width: 16px; height: 16px; cursor: pointer;">
          </div>

          <!-- Keep moved labels fixed -->
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <label style="font-size: 13px; font-weight: 500; color: #374151; cursor: pointer;">
              Keep moved labels fixed
            </label>
            <input type="checkbox"
                   id="freeze-moved-labels-checkbox"
                   checked
                   style="width: 16px; height: 16px; cursor: pointer;">
          </div>

          <!-- Reset Label Placement -->
          <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 2px;">
            <label for="label-placement-reset-select" style="font-size: 13px; font-weight: 500; color: #374151;">
              Reset label placement
            </label>
            <div style="display: flex; align-items: center; gap: 8px;">
              <select id="label-placement-reset-select"
                      style="flex: 1; padding: 6px 8px; font-size: 12px; border: 1px solid #d1d5db; border-radius: 4px; background-color: white; color: #374151; cursor: pointer;">
                <option value="avoid-collisions" selected>Avoiding collisions</option>
                <option value="centroid">At the centroid</option>
              </select>
              <button id="reset-label-placement-btn"
                      type="button"
                      style="padding: 6px 10px; font-size: 12px; border: 1px solid #d1d5db; border-radius: 4px; background: white; color: #374151; cursor: pointer;">
                Reset
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Custom Plot Settings -->
      <div id="settings-tab-content-custom-plot" style="display: none;">
        <div style="font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: #6b7280; margin-bottom: 12px;">
          Custom plot settings
        </div>
        <div id="custom-plot-settings-section" style="display: none;">
          <div style="display: flex; flex-direction: column; gap: 12px;">
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <label for="custom-plot-x-scale" style="font-size: 13px; font-weight: 500; color: #374151;">
              X-axis scale
            </label>
            <select id="custom-plot-x-scale"
                    style="width: 160px; padding: 6px 8px; font-size: 12px; border: 1px solid #d1d5db; border-radius: 4px; background-color: white; color: #374151; cursor: pointer;">
              <option value="normal">Normal</option>
              <option value="log2">Log2</option>
              <option value="log10">Log10</option>
            </select>
          </div>
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <label for="custom-plot-y-scale" style="font-size: 13px; font-weight: 500; color: #374151;">
              Y-axis scale
            </label>
            <select id="custom-plot-y-scale"
                    style="width: 160px; padding: 6px 8px; font-size: 12px; border: 1px solid #d1d5db; border-radius: 4px; background-color: white; color: #374151; cursor: pointer;">
              <option value="normal">Normal</option>
              <option value="log2">Log2</option>
              <option value="log10">Log10</option>
            </select>
          </div>
          </div>
        </div>
        <div id="custom-plot-settings-empty-state" style="display: none; font-size: 13px; color: #6b7280; line-height: 1.4;">
          Custom plot settings are available when a custom plot is active.
        </div>
      </div>
    </div>
  </div>
</div>

<div id="discrete-palette-confirm-overlay"
