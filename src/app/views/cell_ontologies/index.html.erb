<% content_for :title, "Cell Ontologies - ASAP" %>
<div class="max-w-6xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="mb-8 space-y-4">
    <div>
      <h1 class="text-3xl font-semibold text-gray-900 dark:text-white">
        Cell ontologies
      </h1>
      <p class="mt-2 text-gray-600 dark:text-gray-300">
        Browse the curated list of cell ontologies available in ASAP.
      </p>
    </div>
    <% if admin? %>
      <div>
        <%= link_to "New cell ontology",
                    new_cell_ontology_path,
                    class: "inline-flex items-center rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-gray-800 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-gray-800 dark:bg-gray-100 dark:text-black dark:hover:bg-gray-200" %>
      </div>
    <% end %>
  </div>

  <% if @cell_ontologies.empty? %>
    <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-amber-900 dark:border-amber-400/50 dark:bg-amber-950/30 dark:text-amber-100">
      No cell ontologies are available in the database yet.
    </div>
  <% else %>
    <div class="rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
      <div class="border-b border-gray-100 px-6 py-4 dark:border-gray-800">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">
          <%= pluralize(@cell_ontologies.size, "ontology") %>
        </p>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          Counts include both the number of original terms (matching the ontology tag) and the total number of terms stored in the database.
        </p>
      </div>

      <div class="overflow-x-auto">
        <% show_actions = admin? %>
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-800">
          <thead>
            <tr class="bg-gray-50 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:bg-gray-950 dark:text-gray-400">
              <th scope="col" class="px-6 py-3">ID</th>
              <th scope="col" class="px-6 py-3">Name</th>
              <th scope="col" class="px-6 py-3">Version</th>
              <th scope="col" class="px-6 py-3">Tag</th>
              <th scope="col" class="px-6 py-3">Obsolete</th>
              <th scope="col" class="px-6 py-3">Format</th>
              <th scope="col" class="px-6 py-3">Terms</th>
              <th scope="col" class="px-6 py-3">Organisms</th>
              <th scope="col" class="px-6 py-3">Links</th>
              <% if show_actions %>
                <th scope="col" class="px-6 py-3 text-right">Actions</th>
              <% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white text-sm text-gray-900 dark:divide-gray-800 dark:bg-gray-900 dark:text-gray-100">
            <% @cell_ontologies.each do |ontology| %>
              <% total_terms = @term_counts[:total][ontology.id].to_i %>
              <% original_terms = @term_counts[:original][ontology.id].to_i %>
              <% organism_names = if ontology.applies_to_all_organisms?
                                    ["All organisms"]
                                  else
                                    names = ontology.tax_id_list.map do |tax_id|
                                      record = @organisms_by_tax_id[tax_id]
                                      record&.name || "Tax ID #{tax_id}"
                                    end
                                    names.presence || ["No match"]
                                  end %>
              <tr>
                <td class="whitespace-nowrap px-6 py-4 font-mono text-xs text-gray-600 dark:text-gray-400">
                  <%= ontology.id %>
                </td>
                <td class="whitespace-nowrap px-6 py-4 font-medium text-gray-900 dark:text-white">
                  <div class="space-y-1">
                    <div><%= ontology.name %></div>
                    <% if ontology.website_url %>
                      <div class="text-xs text-gray-500 dark:text-gray-400">
                        <%= link_to ontology.website_url, ontology.website_url, class: "text-indigo-600 hover:text-indigo-800 dark:text-indigo-300 dark:hover:text-indigo-200", target: "_blank", rel: "noopener" %>
                      </div>
                    <% end %>
                  </div>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-gray-600 dark:text-gray-300">
                  <%= ontology.latest_version.presence || "—" %>
                </td>
                <td class="whitespace-nowrap px-6 py-4 font-mono text-xs text-gray-600 dark:text-gray-400">
                  <%= ontology.tag.presence || "—" %>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-gray-600 dark:text-gray-300">
                  <% if ontology.obsolete? %>
                    <span class="font-medium text-amber-800 dark:text-amber-200">Yes</span>
                  <% else %>
                    No
                  <% end %>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-gray-600 dark:text-gray-300">
                  <%= ontology.format.presence || "—" %>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-gray-600 dark:text-gray-300">
                  <span class="font-semibold text-gray-900 dark:text-white"><%= original_terms %></span>
                  <span class="text-gray-500 dark:text-gray-400">original</span>
                  <span class="text-gray-400 dark:text-gray-500">/</span>
                  <span class="font-semibold text-gray-900 dark:text-white"><%= total_terms %></span>
                  <span class="text-gray-500 dark:text-gray-400">total</span>
                </td>
                <td class="px-6 py-4 text-gray-600 dark:text-gray-300">
                  <%= organism_names.join(", ") %>
                </td>
                <td class="px-6 py-4 space-y-1">
                  <% if ontology.website_url %>
                    <%= link_to "Website", ontology.website_url, class: "inline-flex text-sm text-indigo-600 hover:text-indigo-800 dark:text-indigo-300 dark:hover:text-indigo-200", target: "_blank", rel: "noopener" %>
                  <% end %>
                  <% if ontology.file_download_url %>
                    <%= link_to "File", ontology.file_download_url, class: "block text-sm text-indigo-600 hover:text-indigo-800 dark:text-indigo-300 dark:hover:text-indigo-200", target: "_blank", rel: "noopener" %>
                  <% end %>
                  <% if ontology.website_url.blank? && ontology.file_download_url.blank? %>
                    <span class="text-gray-400 dark:text-gray-500">—</span>
                  <% end %>
                </td>
                <% if show_actions %>
                  <td class="whitespace-nowrap px-6 py-4 text-right text-sm">
                    <%= link_to "Edit",
                                edit_cell_ontology_path(ontology),
                                class: "text-indigo-600 hover:text-indigo-800 dark:text-indigo-300 dark:hover:text-indigo-200" %>
                    <%= button_to "Delete",
                                  cell_ontology_path(ontology),
                                  method: :delete,
                                  form: { data: { turbo_confirm: "Delete #{ontology.name}?" }, class: "inline" },
                                  class: "ml-3 text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 bg-transparent p-0" %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>

