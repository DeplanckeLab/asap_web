<%
  group = fg[:group]
  group_id = group[:id]
  is_paired = group[:label_path].present?
  is_auto_organism = group[:auto_from_project] == true && organism_info.present?
  is_auto_title = group[:auto_from_project] == :title && project_title.present?
  has_valid_values = group[:term_valid_values].present?
  has_ontology = group[:term_ontology_prefixes].present?

  # Check if this field group has a schema constraint forcing its value
  constraint = schema_constraints[group_id]
  is_constrained = constraint.present?
%>

<div class="border border-gray-200 rounded-lg p-4"
     data-compliance-fix-target="fieldRow"
     data-group-id="<%= group_id %>"
     data-term-has-error="<%= fg[:term_has_error] ? 'true' : 'false' %>"
     data-label-has-error="<%= (is_paired && fg[:label_has_error]) ? 'true' : 'false' %>"
     data-is-auto="<%= (is_auto_organism || is_auto_title || is_constrained) ? 'true' : 'false' %>">

  <!-- Group header -->
  <div class="flex items-start justify-between mb-3">
    <div>
      <span class="text-sm font-semibold text-gray-900"><%= group[:label] %></span>
      <p class="text-xs text-gray-500 mt-0.5"><%= group[:description] %></p>
    </div>
    <div class="flex items-center gap-2">
      <% if group[:multi_value] %>
        <span class="text-xs bg-purple-100 text-purple-700 px-2 py-0.5 rounded-full whitespace-nowrap">multi-value (|| separator)</span>
      <% end %>
      <% if is_paired %>
        <span class="text-xs bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full whitespace-nowrap">paired fields</span>
      <% end %>
      <span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full whitespace-nowrap hidden"
            data-compliance-fix-target="fixedBadge"
            data-group-id="<%= group_id %>">Fixed</span>
    </div>
  </div>

  <% if is_constrained %>
    <div class="mb-3 px-3 py-2 bg-indigo-50 border border-indigo-200 rounded-md"
         data-constraint-group="<%= group_id %>">
      <p class="text-xs text-indigo-700 font-medium">
        Schema constraint: <%= constraint[:reason] %>
      </p>
      <p class="text-xs text-indigo-600 mt-0.5">
        Value will be set to "<%= constraint[:forced_term_value] %>" automatically.
      </p>
    </div>
  <% end %>

  <!-- Constraint messages set dynamically by the frontend -->
  <div data-constraint-dynamic="<%= group_id %>" class="hidden mb-3 px-3 py-2 bg-indigo-50 border border-indigo-200 rounded-md">
    <p class="text-xs text-indigo-700 font-medium" data-constraint-message="<%= group_id %>"></p>
    <p class="text-xs text-indigo-600 mt-0.5" data-constraint-detail="<%= group_id %>"></p>
  </div>

  <!-- Show which paths have errors or pass validation -->
  <div class="mb-3 space-y-1">
    <% if fg[:term_has_error] %>
      <div class="flex items-center gap-2">
        <code class="text-xs bg-red-50 text-red-700 px-1.5 py-0.5 rounded"><%= group[:term_path] %></code>
        <span class="text-xs text-red-600"><%= fg[:term_error] %></span>
      </div>
    <% else %>
      <div class="flex items-center gap-2">
        <code class="text-xs bg-green-50 text-green-700 px-1.5 py-0.5 rounded"><%= group[:term_path] %></code>
        <span class="text-xs text-green-600">OK</span>
      </div>
    <% end %>
    <% if group[:label_path].present? %>
      <% if fg[:label_has_error] %>
        <div class="flex items-center gap-2">
          <code class="text-xs bg-red-50 text-red-700 px-1.5 py-0.5 rounded"><%= group[:label_path] %></code>
          <span class="text-xs text-red-600"><%= fg[:label_error] %></span>
        </div>
      <% else %>
        <div class="flex items-center gap-2">
          <code class="text-xs bg-green-50 text-green-700 px-1.5 py-0.5 rounded"><%= group[:label_path] %></code>
          <span class="text-xs text-green-600">OK</span>
        </div>
      <% end %>
    <% end %>
  </div>

  <%# Show current values for compliant fields that were fixed by the compliance tool %>
  <% cfv = compliant_field_values || {} %>
  <% cfr = compliant_field_resolved || {} %>
  <% term_vals = cfv[group[:term_path]] %>
  <% term_resolved = cfr[group[:term_path]] || {} %>
  <% label_vals = is_paired ? cfv[group[:label_path]] : nil %>
  <% label_resolved = is_paired ? (cfr[group[:label_path]] || {}) : {} %>
  <% if term_vals.present? || label_vals.present? %>
    <%
      # Resolution status: true=valid, 'mappable'=auto-mappable, false=invalid.
      # When the map is empty we have no data at all -> assume green (valid).
      # When the map is non-empty and the value is present -> use the status.
      # When the map is non-empty but the value is absent -> treat as invalid (red).
      badge_css_fix = lambda do |resolved_map, v|
        if resolved_map.empty?
          'bg-green-100 text-green-800 border border-green-200'
        elsif resolved_map.key?(v)
          case resolved_map[v].to_s
          when 'true'     then 'bg-green-100 text-green-800 border border-green-200'
          when 'mappable' then 'bg-orange-100 text-orange-800 border border-orange-300'
          else                 'bg-red-100 text-red-800 border border-red-300'
          end
        else
          'bg-red-100 text-red-800 border border-red-300'
        end
      end
      is_valid = lambda do |resolved_map, v|
        resolved_map.empty? || resolved_map[v] == true || resolved_map[v] == 'mappable'
      end

      term_ok = term_vals.present? ? term_vals.count { |v| is_valid.call(term_resolved, v) } : 0
      term_bad = (term_vals&.size || 0) - term_ok
      label_ok = label_vals.present? ? label_vals.count { |v| is_valid.call(label_resolved, v) } : 0
      label_bad = (label_vals&.size || 0) - label_ok
      has_issues = term_bad > 0 || label_bad > 0
      box_border = has_issues ? 'border-amber-200' : 'border-green-200'
      box_bg = has_issues ? 'bg-amber-50' : 'bg-green-50'
    %>
    <div class="<%= box_bg %> border <%= box_border %> rounded-md p-3 mb-3">
      <p class="text-xs font-medium <%= has_issues ? 'text-amber-800' : 'text-green-800' %> mb-2">
        Current field content
        <% if has_issues %>
          <span class="text-[10px] font-normal text-amber-600 ml-1">(<%= is_paired ? [term_bad, label_bad].max : term_bad %> unresolved)</span>
        <% end %>
      </p>
      <% if is_paired %>
        <%
          # Build a term->label mapping from co-occurrence pairs so we can assign
          # matching pair indices for hover-highlight.
          pair_key = "#{group[:term_path]}||#{group[:label_path]}"
          co_pairs = cfv[pair_key] || []
          term_to_idx = {}
          label_to_idx = {}
          co_pairs.each_with_index do |pair, idx|
            term_to_idx[pair[0]] ||= idx
            label_to_idx[pair[1]] ||= idx
          end
          pair_group = "cfv_#{group_id}"
        %>
        <div class="grid grid-cols-2 gap-4" data-pair-group="<%= pair_group %>">
          <div>
            <p class="text-[10px] text-gray-600 mb-1"><code class="bg-gray-100 px-1 rounded"><%= group[:term_path].split('/').last %></code> (<%= term_vals&.size || 0 %> unique)</p>
            <% if term_vals.present? %>
              <div class="flex flex-wrap gap-1 max-h-40 overflow-y-auto p-2">
                <% term_vals.sort_by { |v| co_pairs.any? ? (term_to_idx[v] || 9999) : v }.each do |v| %>
                  <span class="inline-flex items-center px-2 py-0.5 text-[10px] rounded-full font-mono cfv-pair-badge
                    <%= badge_css_fix.call(term_resolved, v) %>"
                    data-pair-group="<%= pair_group %>"
                    data-pair-idx="<%= term_to_idx[v] %>"
                    ><%= v %></span>
                <% end %>
              </div>
            <% end %>
          </div>
          <div>
            <p class="text-[10px] text-gray-600 mb-1"><code class="bg-gray-100 px-1 rounded"><%= group[:label_path].split('/').last %></code> (<%= label_vals&.size || 0 %> unique)</p>
            <% if label_vals.present? %>
              <div class="flex flex-wrap gap-1 max-h-40 overflow-y-auto p-2">
                <% label_vals.sort_by { |v| co_pairs.any? ? (label_to_idx[v] || 9999) : v }.each do |v| %>
                  <span class="inline-flex items-center px-2 py-0.5 text-[10px] rounded-full cfv-pair-badge
                    <%= badge_css_fix.call(label_resolved, v) %>"
                    data-pair-group="<%= pair_group %>"
                    data-pair-idx="<%= label_to_idx[v] %>"
                    ><%= v %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% else %>
        <p class="text-[10px] text-gray-600 mb-1"><code class="bg-gray-100 px-1 rounded"><%= group[:term_path].split('/').last %></code> (<%= term_vals&.size || 0 %> unique)</p>
        <% if term_vals.present? %>
          <div class="flex flex-wrap gap-1 max-h-40 overflow-y-auto p-2">
            <% term_vals.each do |v| %>
              <span class="inline-flex items-center px-2 py-0.5 text-[10px] rounded-full
                <%= badge_css_fix.call(term_resolved, v) %>"><%= v %></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if is_auto_organism %>
    <%# ── Organism: auto-fill from project ── %>
    <div class="bg-green-50 border border-green-200 rounded-lg p-3">
      <p class="text-sm text-green-800 font-medium mb-2">Auto-fill from project organism</p>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <span class="text-xs font-medium text-gray-600">organism_ontology_term_id</span>
          <p class="text-sm font-mono text-gray-900"><%= organism_info[:ontology_term_id] %></p>
        </div>
        <div>
          <span class="text-xs font-medium text-gray-600">organism</span>
          <p class="text-sm text-gray-900"><%= organism_info[:name] %></p>
        </div>
      </div>

      <input type="hidden" name="fixes[<%= group[:term_path] %>][action]" value="set_value">
      <input type="hidden" name="fixes[<%= group[:term_path] %>][value]" value="<%= organism_info[:ontology_term_id] %>">
      <% if group[:label_path] %>
        <input type="hidden" name="fixes[<%= group[:label_path] %>][action]" value="set_value">
        <input type="hidden" name="fixes[<%= group[:label_path] %>][value]" value="<%= organism_info[:name] %>">
      <% end %>
    </div>

  <% elsif is_auto_title %>
    <%# ── Title: auto-fill from project name ── %>
    <div class="bg-green-50 border border-green-200 rounded-lg p-3">
      <p class="text-sm text-green-800 font-medium mb-2">Auto-fill from project name</p>
      <div>
        <span class="text-xs font-medium text-gray-600">title</span>
        <p class="text-sm text-gray-900"><%= project_title %></p>
      </div>

      <input type="hidden" name="fixes[<%= group[:term_path] %>][action]" value="set_value">
      <input type="hidden" name="fixes[<%= group[:term_path] %>][value]" value="<%= project_title %>">
    </div>

  <% else %>
    <%# ── Regular field group ── %>
    <%
      # Determine prefill state
      pf = prefill || {}
      pf_source = pf[:source_annot_name]
      pf_terms = pf[:terms] || []
      pf_has_source = pf_source.present? && available_attrs.include?(pf_source.sub(%r{\A/col_attrs/}, '').sub(%r{\A/attrs/}, ''))
      pf_has_terms = pf_terms.any?
      pf_single_term = pf_terms.size == 1 && pf_terms.first[:identifier].present?
      # If neither field has a validation error the group is already compliant;
      # default to "skip" so it won't be re-processed (and won't accidentally
      # overwrite a previously applied fix with stale archived source data).
      group_has_no_errors = !fg[:term_has_error] && (!is_paired || !fg[:label_has_error])

      # Pre-select action:
      # - If already compliant: skip (don't re-process)
      # - If exactly 1 term with identifier: set_value (simpler, just write the constant)
      # - If source annotation with multiple terms: map_from
      # - If terms but no source: set_value
      pf_action = if is_constrained && group_has_no_errors then 'skip'
                  elsif is_constrained then 'set_value'
                  elsif group_has_no_errors then 'skip'
                  elsif pf_single_term then 'set_value'
                  elsif pf_has_source then 'map_from'
                  elsif pf_has_terms then 'set_value'
                  else 'skip'
                  end
    %>

    <% if pf_has_source || pf_has_terms %>
      <div class="bg-blue-50 border border-blue-200 rounded-md p-3 mb-3">
        <p class="text-xs font-medium text-blue-800 mb-1">Previous assignment found</p>
        <% if pf_has_source %>
          <p class="text-xs text-blue-700">Source metadata: <code class="bg-blue-100 px-1 rounded"><%= pf_source %></code></p>
        <% end %>
        <% if pf_has_terms %>
          <div class="flex flex-wrap gap-1 mt-1">
            <% pf_terms.first(10).each do |t| %>
              <span class="inline-flex items-center px-2 py-0.5 text-[10px] rounded-full bg-blue-100 text-blue-700 border border-blue-200">
                <% if t[:identifier] %>
                  <span class="font-mono"><%= t[:identifier] %></span> - <%= t[:name] %>
                <% else %>
                  <%= t[:name] %>
                <% end %>
              </span>
            <% end %>
            <% if pf_terms.size > 10 %>
              <span class="text-[10px] text-blue-500">... and <%= pf_terms.size - 10 %> more</span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="space-y-3">
      <% if is_constrained %>
        <!-- Constrained field: locked -->
        <div class="flex items-center gap-4">
          <% if group_has_no_errors %>
            <span class="text-sm text-green-700 font-medium">Value is already "<%= constraint[:forced_term_value] %>" -- no change needed.</span>
          <% else %>
            <span class="text-sm text-indigo-700 font-medium">Fixed by schema constraint: "<%= constraint[:forced_term_value] %>"</span>
          <% end %>
        </div>
      <% else %>
        <!-- Action selector -->
        <div class="flex items-center gap-4">
          <label class="inline-flex items-center gap-1.5 text-sm">
            <input type="radio"
                   name="group_action_<%= group_id %>"
                   value="skip"
                   <%= 'checked' if pf_action == 'skip' %>
                   data-action="change->compliance-fix#toggleGroupAction"
                   data-group-id="<%= group_id %>"
                   class="text-gray-400 focus:ring-gray-400">
            <span class="text-gray-500">Skip</span>
          </label>

          <% if available_attrs.any? %>
            <label class="inline-flex items-center gap-1.5 text-sm">
              <input type="radio"
                     name="group_action_<%= group_id %>"
                     value="map_from"
                     <%= 'checked' if pf_action == 'map_from' %>
                     data-action="change->compliance-fix#toggleGroupAction"
                     data-group-id="<%= group_id %>"
                     class="text-blue-600 focus:ring-blue-500">
              <span class="text-gray-700">Map from existing metadata</span>
            </label>
          <% end %>

          <label class="inline-flex items-center gap-1.5 text-sm">
            <input type="radio"
                   name="group_action_<%= group_id %>"
                   value="set_value"
                   <%= 'checked' if pf_action == 'set_value' %>
                   data-action="change->compliance-fix#toggleGroupAction"
                   data-group-id="<%= group_id %>"
                   class="text-blue-600 focus:ring-blue-500">
            <span class="text-gray-700">Set fixed value</span>
          </label>
        </div>
      <% end %>

      <%# ── Map from existing metadata ── %>
      <% if available_attrs.any? %>
        <div id="map_from_<%= group_id %>" class="<%= pf_action == 'map_from' ? '' : 'hidden' %> pl-6 space-y-3">
          <% prefix = group[:type] == :col_attr ? '/col_attrs/' : '/attrs/' %>

          <% if is_paired && has_ontology %>
            <%# ── Paired ontology field: select one source, show values, auto-resolve the other ── %>
            <p class="text-xs text-gray-500 mb-1">
              Select a source metadata for either field. The unique values will be shown as badges and the paired field will be resolved automatically from the ontology database.
            </p>

            <div class="grid grid-cols-2 gap-4">
              <%# Left: term ID side %>
              <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">
                  <code class="text-xs bg-gray-100 px-1 rounded"><%= group[:term_path].split('/').last %></code>
                  <% unless fg[:term_has_error] %>
                    <span class="text-[10px] text-green-600 ml-1">(exists)</span>
                  <% end %>
                </label>
                <select data-action="change->compliance-fix#onMapSourceSelect"
                        data-group-id="<%= group_id %>"
                        data-role="term"
                        data-prefixes="<%= group[:term_ontology_prefixes].join(',') %>"
                        data-compliance-fix-target="mapSelect"
                        name="fixes[<%= group[:term_path] %>][source]"
                        class="block w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500">
                  <option value="">-- select source metadata --</option>
                  <% available_attrs.each do |attr| %>
                    <option value="<%= prefix %><%= attr %>" <%= 'selected' if pf_action == 'map_from' && pf_has_source && pf_source == "#{prefix}#{attr}" %>><%= attr %></option>
                  <% end %>
                </select>
                <div data-compliance-fix-target="mapBadges" data-group-id="<%= group_id %>" data-role="term"
                     data-field-path="<%= group[:term_path] %>" data-has-error="<%= fg[:term_has_error] %>"
                     class="flex flex-wrap gap-1 mt-2 max-h-60 overflow-y-auto"></div>
              </div>

              <%# Right: label side %>
              <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">
                  <code class="text-xs bg-gray-100 px-1 rounded"><%= group[:label_path].split('/').last %></code>
                  <% unless fg[:label_has_error] %>
                    <span class="text-[10px] text-green-600 ml-1">(exists)</span>
                  <% end %>
                </label>
                <select data-action="change->compliance-fix#onMapSourceSelect"
                        data-group-id="<%= group_id %>"
                        data-role="label"
                        data-prefixes="<%= group[:term_ontology_prefixes].join(',') %>"
                        data-compliance-fix-target="mapSelect"
                        name="fixes[<%= group[:label_path] %>][source]"
                        class="block w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500">
                  <option value="">-- select source metadata --</option>
                  <% available_attrs.each do |attr| %>
                    <option value="<%= prefix %><%= attr %>" <%= 'selected' if pf_action == 'map_from' && pf_has_source && pf_source == "#{prefix}#{attr}" %>><%= attr %></option>
                  <% end %>
                </select>
                <div data-compliance-fix-target="mapBadges" data-group-id="<%= group_id %>" data-role="label"
                     data-field-path="<%= group[:label_path] %>" data-has-error="<%= fg[:label_has_error] %>"
                     class="flex flex-wrap gap-1 mt-2 max-h-60 overflow-y-auto"></div>
              </div>
            </div>

            <%# Inline autocomplete for fixing unresolved values (supports multiple terms) %>
            <div data-compliance-fix-target="mapFixPanel" data-group-id="<%= group_id %>"
                 class="hidden mt-2 p-3 bg-amber-50 border border-amber-200 rounded-md">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-medium text-amber-800">
                  Replace unresolved term: <code data-compliance-fix-target="mapFixOriginal"
                  data-group-id="<%= group_id %>" class="bg-amber-100 px-1 rounded"></code>
                </span>
                <button type="button" data-action="click->compliance-fix#closeMapFix"
                        data-group-id="<%= group_id %>"
                        class="text-xs text-amber-600 hover:text-amber-800">close</button>
              </div>
              <%# Accumulated selected terms shown as removable badges %>
              <div data-compliance-fix-target="mapFixSelected" data-group-id="<%= group_id %>"
                   class="hidden flex flex-wrap gap-1 mb-2"></div>
              <div class="relative">
                <input type="text" placeholder="Search ontology terms..."
                       data-compliance-fix-target="mapFixInput"
                       data-group-id="<%= group_id %>"
                       data-prefixes="<%= group[:term_ontology_prefixes].join(',') %>"
                       data-action="input->compliance-fix#onMapFixAutocomplete keydown->compliance-fix#onMapFixKeydown"
                       class="block w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500">
                <div data-compliance-fix-target="mapFixResults"
                     data-group-id="<%= group_id %>"
                     class="hidden absolute z-20 w-full mt-1 bg-white border border-gray-200 rounded-md shadow-lg max-h-48 overflow-y-auto"></div>
              </div>
              <div class="flex items-center gap-2 mt-2">
                <button type="button" data-action="click->compliance-fix#confirmMapFix"
                        data-compliance-fix-target="mapFixConfirm" data-group-id="<%= group_id %>"
                        class="hidden px-3 py-1 text-xs rounded bg-green-600 text-white hover:bg-green-700">
                  Confirm
                </button>
                <span data-compliance-fix-target="mapFixHint" data-group-id="<%= group_id %>"
                      class="text-[10px] text-gray-400">Select one or more ontology terms, then confirm.</span>
              </div>
            </div>

            <div data-compliance-fix-target="mapStatus" data-group-id="<%= group_id %>"
                 class="text-xs text-gray-500 italic hidden"></div>

          <% else %>
            <%# ── Non-paired or non-ontology field: simple source selector ── %>
            <% if fg[:term_has_error] %>
              <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">
                  <code class="text-xs bg-gray-100 px-1 rounded"><%= group[:term_path].split('/').last %></code>
                  -- select source metadata:
                </label>
                <div class="flex items-center gap-3">
                  <select name="fixes[<%= group[:term_path] %>][source]"
                          data-action="change->compliance-fix#previewSource"
                          data-group-id="<%= group_id %>"
                          data-role="term"
                          class="block w-64 rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500">
                    <option value="">-- select --</option>
                    <% available_attrs.each do |attr| %>
                      <option value="<%= prefix %><%= attr %>"><%= attr %></option>
                    <% end %>
                  </select>
                  <span data-compliance-fix-target="preview"
                        data-preview-for="<%= group_id %>_term"
                        class="text-xs text-gray-500 italic"></span>
                </div>
              </div>
            <% end %>

            <% if is_paired && fg[:label_has_error] %>
              <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">
                  <code class="text-xs bg-gray-100 px-1 rounded"><%= group[:label_path].split('/').last %></code>
                  -- select source metadata:
                </label>
                <div class="flex items-center gap-3">
                  <select name="fixes[<%= group[:label_path] %>][source]"
                          data-action="change->compliance-fix#previewSource"
                          data-group-id="<%= group_id %>"
                          data-role="label"
                          class="block w-64 rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500">
                    <option value="">-- select --</option>
                    <% available_attrs.each do |attr| %>
                      <option value="<%= prefix %><%= attr %>"><%= attr %></option>
                    <% end %>
                  </select>
                  <span data-compliance-fix-target="preview"
                        data-preview-for="<%= group_id %>_label"
                        class="text-xs text-gray-500 italic"></span>
                </div>
              </div>
            <% end %>
          <% end %>

        </div>
      <% end %>

      <%# ── Set fixed value ── %>
      <div id="set_value_<%= group_id %>" class="<%= (pf_action == 'set_value' && !is_constrained) ? '' : 'hidden' %> pl-6 space-y-3">
        <% if is_paired && has_ontology %>
          <%# Paired ontology field: autocomplete that fills both term ID and label %>
          <%
            # Prefill values for single-term assignment
            sv_term_prefill = pf_single_term ? pf_terms.first[:identifier] : ''
            sv_label_prefill = pf_single_term ? pf_terms.first[:name] : ''
          %>

          <div>
            <label class="block text-xs font-medium text-gray-700 mb-1">Search ontology term:</label>
            <div class="relative" data-compliance-fix-target="autocompleteWrapper">
              <input type="text"
                     placeholder="Type to search (e.g., <%= group[:term_format_hint] %>)"
                     autocomplete="off"
                     data-compliance-fix-target="autocompleteInput"
                     data-group-id="<%= group_id %>"
                     data-prefixes="<%= group[:term_ontology_prefixes].join(',') %>"
                     data-action="input->compliance-fix#onAutocompleteInput keydown->compliance-fix#onAutocompleteKeydown"
                     class="block w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500">
              <div data-compliance-fix-target="autocompleteResults"
                   data-group-id="<%= group_id %>"
                   class="hidden absolute z-50 w-full mt-1 bg-white border border-gray-200 rounded-md shadow-lg max-h-60 overflow-y-auto"></div>
            </div>
            <% if group[:multi_value] %>
              <p class="text-xs text-gray-400 mt-1">For multiple values, select one at a time. Values are separated with <code>||</code>.</p>
            <% end %>
          </div>

          <%# Selected terms display + hidden inputs %>
          <div data-compliance-fix-target="selectedTerms" data-group-id="<%= group_id %>" class="flex flex-wrap gap-2">
            <% if pf_single_term %>
              <span class="inline-flex items-center gap-1 px-2 py-1 text-xs rounded-full bg-blue-100 text-blue-700 border border-blue-200">
                <span class="font-mono"><%= sv_term_prefill %></span> - <%= sv_label_prefill %>
              </span>
            <% end %>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <%# Term ID (filled by autocomplete or prefill) %>
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-1">
                <code class="text-xs bg-gray-100 px-1 rounded"><%= group[:term_path].split('/').last %></code>
                <span class="text-gray-400 ml-1">(auto-filled)</span>
                <% unless fg[:term_has_error] %>
                  <span class="text-[10px] text-green-600 ml-1">(exists)</span>
                <% end %>
              </label>
              <input type="text"
                     name="fixes[<%= group[:term_path] %>][value]"
                     data-compliance-fix-target="termValue"
                     data-group-id="<%= group_id %>"
                     value="<%= sv_term_prefill %>"
                     readonly
                     placeholder="Filled by autocomplete selection"
                     class="block w-full rounded-md border-gray-200 bg-gray-50 shadow-sm text-sm text-gray-600">
            </div>

            <%# Label (filled by autocomplete or prefill) %>
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-1">
                <code class="text-xs bg-gray-100 px-1 rounded"><%= group[:label_path].split('/').last %></code>
                <span class="text-gray-400 ml-1">(auto-filled)</span>
                <% unless fg[:label_has_error] %>
                  <span class="text-[10px] text-green-600 ml-1">(exists)</span>
                <% end %>
              </label>
              <input type="text"
                     name="fixes[<%= group[:label_path] %>][value]"
                     data-compliance-fix-target="labelValue"
                     data-group-id="<%= group_id %>"
                     value="<%= sv_label_prefill %>"
                     readonly
                     placeholder="Filled by autocomplete selection"
                     class="block w-full rounded-md border-gray-200 bg-gray-50 shadow-sm text-sm text-gray-600">
            </div>
          </div>

          <p class="text-xs text-gray-400">
            Select a term from the autocomplete to fill both fields coherently.
            You can also edit the values manually if needed.
          </p>

        <% elsif is_paired %>
          <%# Paired non-ontology field: side by side inputs %>
          <div class="grid grid-cols-2 gap-4">
            <% if fg[:term_has_error] %>
              <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">
                  <code class="text-xs bg-gray-100 px-1 rounded"><%= group[:term_path].split('/').last %></code>
                  <span class="text-gray-400 ml-1">(ontology term ID)</span>
                </label>
                <% if has_valid_values %>
                  <select name="fixes[<%= group[:term_path] %>][value]"
                          class="block w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500">
                    <option value="">-- select --</option>
                    <% group[:term_valid_values].each do |val| %>
                      <option value="<%= val %>"><%= val %></option>
                    <% end %>
                  </select>
                <% else %>
                  <input type="text"
                         name="fixes[<%= group[:term_path] %>][value]"
                         placeholder="Enter value..."
                         class="block w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500">
                <% end %>
              </div>
            <% end %>
            <% if fg[:label_has_error] %>
              <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">
                  <code class="text-xs bg-gray-100 px-1 rounded"><%= group[:label_path].split('/').last %></code>
                  <span class="text-gray-400 ml-1">(human-readable label)</span>
                </label>
                <input type="text"
                       name="fixes[<%= group[:label_path] %>][value]"
                       placeholder="e.g., human-readable name"
                       class="block w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500">
              </div>
            <% end %>
          </div>
          <p class="text-xs text-gray-400">
            Both fields must be coherent: the label should be the human-readable name for the ontology term ID.
          </p>

        <% else %>
          <%# Standalone field (no pair) %>
          <% if has_valid_values %>
            <label class="block text-xs font-medium text-gray-700 mb-1">Select value:</label>
            <select name="fixes[<%= group[:term_path] %>][value]"
                    class="block w-64 rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500">
              <option value="">-- select --</option>
              <% group[:term_valid_values].each do |val| %>
                <option value="<%= val %>"><%= val %></option>
              <% end %>
            </select>
            <% if group_id == 'is_primary_data' %>
              <div class="mt-2 px-3 py-2 bg-gray-50 border border-gray-200 rounded-md">
                <p class="text-xs text-gray-600">
                  Per the CELLxGENE schema, this MUST be <strong>True</strong> if this is the canonical instance of this cellular observation
                  and <strong>False</strong> if not.
                </p>
                <p class="text-xs text-gray-600 mt-1">
                  This is commonly <strong>False</strong> for meta-analyses reusing data or for secondary views of data.
                </p>
              </div>
            <% end %>
          <% elsif has_ontology %>
            <%# Standalone ontology field with autocomplete %>
            <label class="block text-xs font-medium text-gray-700 mb-1">Search ontology term:</label>
            <div class="relative" data-compliance-fix-target="autocompleteWrapper">
              <input type="text"
                     placeholder="Type to search (e.g., <%= group[:term_format_hint] %>)"
                     autocomplete="off"
                     data-compliance-fix-target="autocompleteInput"
                     data-group-id="<%= group_id %>"
                     data-prefixes="<%= group[:term_ontology_prefixes].join(',') %>"
                     data-action="input->compliance-fix#onAutocompleteInput keydown->compliance-fix#onAutocompleteKeydown"
                     class="block w-80 rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500">
              <div data-compliance-fix-target="autocompleteResults"
                   data-group-id="<%= group_id %>"
                   class="hidden absolute z-50 w-80 mt-1 bg-white border border-gray-200 rounded-md shadow-lg max-h-60 overflow-y-auto"></div>
            </div>
            <div data-compliance-fix-target="selectedTerms" data-group-id="<%= group_id %>" class="flex flex-wrap gap-2 mt-2"></div>
            <input type="text"
                   name="fixes[<%= group[:term_path] %>][value]"
                   data-compliance-fix-target="termValue"
                   data-group-id="<%= group_id %>"
                   readonly
                   placeholder="Filled by autocomplete selection"
                   class="block w-80 mt-2 rounded-md border-gray-200 bg-gray-50 shadow-sm text-sm text-gray-600">
          <% else %>
            <label class="block text-xs font-medium text-gray-700 mb-1">Enter value:</label>
            <input type="text"
                   name="fixes[<%= group[:term_path] %>][value]"
                   placeholder="Enter value..."
                   class="block w-80 rounded-md border-gray-300 shadow-sm text-sm focus:border-blue-500 focus:ring-blue-500">
            <% if group_id == 'donor_id' %>
              <div class="mt-2 px-3 py-2 bg-gray-50 border border-gray-200 rounded-md">
                <p class="text-xs text-gray-600">
                  Per the CELLxGENE schema, this MUST be free-text that identifies a unique individual that data were derived from.
                  If <code class="bg-gray-100 px-0.5 rounded">tissue_type</code> is "cell line", this MUST be "na".
                </p>
                <p class="text-xs text-gray-600 mt-1">
                  It is STRONGLY RECOMMENDED that <strong>"pooled"</strong> be used for observations from a sample of multiple individuals
                  that were not confidently assigned to a single individual through demultiplexing.
                </p>
                <p class="text-xs text-gray-600 mt-1">
                  It is STRONGLY RECOMMENDED that <strong>"unknown"</strong> ONLY be used when it is not known which observations are from the same individual.
                </p>
              </div>
            <% end %>
          <% end %>
        <% end %>

      </div>

      <%# For constrained fields, emit hidden value inputs with the forced value %>
      <% if is_constrained %>
        <input type="hidden" name="fixes[<%= group[:term_path] %>][value]" value="<%= constraint[:forced_term_value] %>">
        <% if is_paired && constraint[:forced_label_value] %>
          <input type="hidden" name="fixes[<%= group[:label_path] %>][value]" value="<%= constraint[:forced_label_value] %>">
        <% end %>
      <% end %>

      <%# Single set of hidden action inputs (outside both panels to avoid duplicates) %>
      <%# Always emit for both fields so overrides of existing fields are possible %>
      <%
        term_initial_action = case pf_action
                              when 'map_from' then 'map_from'
                              when 'set_value' then 'set_value'
                              else 'skip'
                              end
      %>
      <input type="hidden" name="fixes[<%= group[:term_path] %>][action]" value="<%= term_initial_action %>"
             data-compliance-fix-target="hiddenAction" data-group-id="<%= group_id %>" data-role="term_action">
      <% if is_paired %>
        <%
          label_initial_action = case pf_action
                                 when 'map_from' then 'map_from'
                                 when 'set_value' then 'set_value'
                                 else 'skip'
                                 end
        %>
        <input type="hidden" name="fixes[<%= group[:label_path] %>][action]" value="<%= label_initial_action %>"
               data-compliance-fix-target="hiddenAction" data-group-id="<%= group_id %>" data-role="label_action">
      <% end %>
    </div>
  <% end %>
</div>
