        refreshAnnotPopupTitle();
        renderAnnotationPanel();
      })
      .catch(function(err) {
        if (String(_annotPopupData.metadataId) !== String(metadataId) || String(_annotPopupData.catIdx) !== String(catIdx)) return;
        _annotPopupData.uiReady = true;
