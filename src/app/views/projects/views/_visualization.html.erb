  var modal = document.getElementById('add-metadata-modal')
  if (!modal) return
  var content = modal.querySelector('#import-metadata-content')
  if (!content) return
  content.value = content.placeholder || ''
  checkModalForm()
}

function handlePreviewMetadata(btn) {
  if (btn.closest('[data-controller="data-view"]')) return
  btn.disabled = true
  btn.textContent = 'Processing...'

  var modal = document.getElementById('add-metadata-modal')
  var projectId = window.location.pathname.match(/\/projects\/([^\/]+)/)?.[1]
  var csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content')
  var inputMethod = modal.querySelector('#import-input-method-id')?.value
  var metadataTypeId = modal.querySelector('#import-metadata-type-id')?.value
  var inputTypeId = modal.querySelector('#import-input-type-id')?.value
  var delimiter = modal.querySelector('#import-delimiter')?.value
  var name = modal.querySelector('#import-metadata-name')?.value || ''
  var hasHeader = modal.querySelector('#import-has-header')?.checked ? '1' : '0'
  var loomFile = '<%= @default_loom_file %>'

  var fetchPromise
  if (inputMethod === '3') {
    var sel = window._crossProjectSelection
    if (!sel || !sel.sourceProjectId || !sel.sourceAnnotId) {
      btn.textContent = 'Preview'
      btn.disabled = false
      return
    }
    fetchPromise = fetch('/projects/' + projectId + '/prepare_metadata_from_project_annot', {
      method: 'POST',
      headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json', 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ source_project_id: sel.sourceProjectId, source_annot_id: sel.sourceAnnotId, loom_file: loomFile })
    })
  } else if (inputMethod === '2') {
    var fileInput = modal.querySelector('#import-metadata-file')
    if (!fileInput?.files?.[0]) return
    var formData = new FormData()
    formData.append('file', fileInput.files[0])
    formData.append('metadata_type_id', metadataTypeId)
    formData.append('input_type_id', inputTypeId)
    formData.append('delimiter', delimiter)
    formData.append('name', name)
    formData.append('has_header', hasHeader)
    formData.append('loom_file', loomFile)
    fetchPromise = fetch('/projects/' + projectId + '/prepare_metadata', { method: 'POST', headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' }, credentials: 'same-origin', body: formData })
  } else {
    var content = modal.querySelector('#import-metadata-content')?.value || ''
    fetchPromise = fetch('/projects/' + projectId + '/prepare_metadata', { method: 'POST', headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json', 'Content-Type': 'application/json' }, credentials: 'same-origin', body: JSON.stringify({ metadata_type_id: metadataTypeId, input_type_id: inputTypeId, delimiter: delimiter, name: name, has_header: hasHeader, content: content, loom_file: loomFile }) })
  }

  fetchPromise.then(function(r) {
    return r.json().catch(function() { return {} }).then(function(data) {
      if (!r.ok) {
        var msg = data.error || data.message || ('HTTP error ' + r.status)
        throw new Error(msg)
      }
      return data
    })
  })
  .then(function(data) {
    btn.textContent = 'Preview'
    window._importFuId = data.fu_id
    window._importCollisionResolution = ''
    window._vizLastImportValidation = data.import_validation || null
    if (inputMethod === '3' && data.metadata_type_id) {
      window._crossProjectPrepareMeta = { metadataTypeId: String(data.metadata_type_id), inputTypeId: String(data.input_type_id || '2') }
    } else {
      window._crossProjectPrepareMeta = null
    }
    var warnings = modal.querySelector('#import-warnings')
    var dupBlock = ''
    if (data.duplicates && data.duplicates.length > 0) {
      dupBlock = '<div class="p-3 bg-yellow-50 border border-yellow-200 rounded-md text-sm text-yellow-800">' + data.duplicates.length + ' duplicate(s) found (' + data.duplicates.map(function(x) { return escapeHtmlForImportMeta(x) }).join(', ') + '). Only first occurrence is kept.</div>'
    }
    warnings.innerHTML = dupBlock + buildImportValidationHtmlViz(data.import_validation)
    if (warnings.innerHTML.trim()) {
      warnings.classList.remove('hidden')
    } else {
      warnings.classList.add('hidden')
    }
    var preview = modal.querySelector('#import-preview')
    var previewContent = modal.querySelector('#import-preview-content')
    if (data.preview || (data.preview_lines && data.preview_lines.length > 0)) {
      previewContent.innerHTML = renderImportPreviewHtmlViz(data.preview, data.preview_lines)
      preview.classList.remove('hidden')
    } else if (preview) {
      preview.classList.add('hidden')
    }
    if (data.header_name && inputMethod !== '3') {
      var nameInput = modal.querySelector('#import-metadata-name')
      if (nameInput && !nameInput.value.trim()) nameInput.value = data.header_name
    }
    var submitBtn = modal.querySelector('#import-submit-btn')
    if (submitBtn) { submitBtn.classList.remove('hidden') }
    updateVizImportSubmitEnabled(modal)
    var formError = modal.querySelector('#import-form-error')
    if (formError) { formError.classList.add('hidden'); formError.innerHTML = '' }
    showImportReviewStep(modal)
  })
  .catch(function(err) {
    btn.textContent = 'Preview'; btn.disabled = false
    showImportFormStep(modal)
    var formError = modal.querySelector('#import-form-error')
    if (formError) {
      formError.innerHTML = '<div class="p-3 bg-red-50 border border-red-200 rounded-md text-sm text-red-800">Error: ' + escapeHtmlForImportMeta(err.message) + '</div>'
      formError.classList.remove('hidden')
    }
  })
}

function showImportFormStep(modal) {
  if (!modal) modal = document.getElementById('add-metadata-modal')
  if (!modal) return
  modal.querySelector('#import-form-step')?.classList.remove('hidden')
  modal.querySelector('#import-review-step')?.classList.add('hidden')
  modal.querySelector('#import-preview-btn')?.classList.remove('hidden')
  modal.querySelector('#import-submit-btn')?.classList.add('hidden')
  modal.querySelector('#import-back-btn')?.classList.add('hidden')
  modal.querySelector('#import-back-arrow-btn')?.classList.add('hidden')
}

function showImportReviewStep(modal) {
  if (!modal) modal = document.getElementById('add-metadata-modal')
  if (!modal) return
  modal.querySelector('#import-form-step')?.classList.add('hidden')
  modal.querySelector('#import-review-step')?.classList.remove('hidden')
  modal.querySelector('#import-preview-btn')?.classList.add('hidden')
  modal.querySelector('#import-submit-btn')?.classList.remove('hidden')
  modal.querySelector('#import-back-btn')?.classList.remove('hidden')
  modal.querySelector('#import-back-arrow-btn')?.classList.remove('hidden')
  var scrollRoot = modal.querySelector('.overflow-y-auto')
  if (scrollRoot) scrollRoot.scrollTop = 0
}

function handleBackToImportForm(btn) {
  if (btn && btn.closest('[data-controller="data-view"]')) return
  var modal = document.getElementById('add-metadata-modal')
  if (!modal) return
  showImportFormStep(modal)
  checkModalForm()
}

function handleSubmitMetadata(btn) {
  if (btn.closest('[data-controller="data-view"]')) return
  btn.disabled = true
  btn.textContent = 'Importing...'

  var modal = document.getElementById('add-metadata-modal')
  var projectId = window.location.pathname.match(/\/projects\/([^\/]+)/)?.[1]
  var csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content')
  var inputMethod = modal.querySelector('#import-input-method-id')?.value
  var metadataTypeId = modal.querySelector('#import-metadata-type-id')?.value
  var inputTypeId = modal.querySelector('#import-input-type-id')?.value || '1'
  if (inputMethod === '3' && window._crossProjectPrepareMeta) {
    metadataTypeId = window._crossProjectPrepareMeta.metadataTypeId
    inputTypeId = window._crossProjectPrepareMeta.inputTypeId
  }
  var name = modal.querySelector('#import-metadata-name')?.value || ''
  var hasHeader = modal.querySelector('#import-has-header')?.checked ? '1' : '0'
  var loomFile = '<%= @default_loom_file %>'

  fetch('/projects/' + projectId + '/do_import_metadata', {
    method: 'POST',
    headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json', 'Content-Type': 'application/json' },
    credentials: 'same-origin',
    body: JSON.stringify({
      fu_id: window._importFuId,
      metadata_type_id: metadataTypeId,
      loom_file: loomFile,
      input_type_id: inputTypeId,
      name: name,
      header_name: '',
      has_header: hasHeader,
      collision_resolution: window._importCollisionResolution || ''
    })
  })
  .then(function(r) {
    return r.json().then(function(data) {
      data.__httpOk = r.ok
      return data
    }).catch(function() {
      return { status: 'error', message: 'HTTP error ' + r.status, __httpOk: r.ok }
    })
  })
  .then(function(data) {
    if (data.status !== 'ok') {
      var msg = data.message || data.error || 'Import failed'
      var warnings = modal.querySelector('#import-warnings')
      warnings.innerHTML = '<div class="p-3 bg-red-50 border border-red-200 rounded-md text-sm text-red-800">' + escapeHtmlForImportMeta(msg) + '</div>'
      warnings.classList.remove('hidden')
      btn.textContent = 'Import'
      btn.disabled = false
      return
    }
    modal.classList.add('hidden')
    if (data.status === 'ok') {
      window.location.reload()
    }
  })
  .catch(function(err) {
    btn.textContent = 'Import'; btn.disabled = false
    var warnings = modal.querySelector('#import-warnings')
    warnings.innerHTML = '<div class="p-3 bg-red-50 border border-red-200 rounded-md text-sm text-red-800">Import error: ' + escapeHtmlForImportMeta(err.message) + '</div>'
    warnings.classList.remove('hidden')
  })
}

// --- Annotation Popup + Draggable ---

(function() {
  var isDragging = false, dragOffsetX = 0, dragOffsetY = 0, dragDialog = null
  document.addEventListener('mousedown', function(e) {
    var header = e.target.closest('#annotation-popup-header')
    if (!header) return
    if (e.target.closest('button')) return
    dragDialog = document.getElementById('annotation-popup-dialog')
    if (!dragDialog) return
    isDragging = true
    var rect = dragDialog.getBoundingClientRect()
    dragDialog.style.position = 'fixed'
    dragDialog.style.margin = '0'
    dragDialog.style.left = rect.left + 'px'
    dragDialog.style.top = rect.top + 'px'
    dragDialog.style.transform = 'none'
    dragOffsetX = e.clientX - rect.left
    dragOffsetY = e.clientY - rect.top
    e.preventDefault()
  })
  document.addEventListener('mousemove', function(e) {
    if (!isDragging || !dragDialog) return
    var nx = Math.max(0, Math.min(e.clientX - dragOffsetX, window.innerWidth - 100))
    var ny = Math.max(0, Math.min(e.clientY - dragOffsetY, window.innerHeight - 50))
    dragDialog.style.left = nx + 'px'
    dragDialog.style.top = ny + 'px'
  })
  document.addEventListener('mouseup', function() { isDragging = false; dragDialog = null })
})()

