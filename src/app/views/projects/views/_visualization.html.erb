    if (_annotPopupData.activeTab === 'evidences') renderAnnotationPanel()
    return
  }

  _annotPopupData.evidences.loading = true
  _annotPopupData.evidences.state = 'loading'
  _annotPopupData.evidences.message = 'Checking FindMarkers run...'
  updateMarkersStatusInMetadataPanel(_annotPopupData.metadataId, _annotPopupData.catIdx, 'loading', null)
  refreshAnnotPopupTitle()
  if (_annotPopupData.activeTab === 'evidences') renderAnnotationPanel()

  var url = _annotPopupData.evidencesUrl + '?annot_id=' + encodeURIComponent(_annotPopupData.metadataId) + '&cat_idx=' + encodeURIComponent(_annotPopupData.catIdx)
  if (opts && opts.restart) url += '&restart=1'
  fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
    .then(function(r) {
      if (!r.ok) throw new Error('HTTP ' + r.status)
      return r.json()
    })
    .then(function(data) {
      _annotPopupData.evidences = {
        state: data.state || 'error',
        loading: false,
        message: data.message || '',
        runId: data.run_id || null,
        rowsUp: Array.isArray(data.rows_up) ? data.rows_up : [],
        rowsDown: Array.isArray(data.rows_down) ? data.rows_down : [],
        markersQueueBase: data.markers_queue_base || '',
        markersQueueNote: data.markers_queue_note || '',
        slurmQueueHover: data.slurm_queue_hover || '',
        queuePosition: data.queue_position,
        queuePendingTotal: data.queue_pending_total,
        queuePartition: data.queue_partition
      }
      if ((_annotPopupData.evidences.state || '') === 'completed') {
        normalizeEvidencesSubTabAfterLoad(_annotPopupData.evidences.rowsUp, _annotPopupData.evidences.rowsDown)
      }
      syncMarkersStatusFromResponse(_annotPopupData.metadataId, _annotPopupData.catIdx, data)
    })
    .catch(function(err) {
      _annotPopupData.evidences = {
        state: 'error',
        loading: false,
        message: 'Error loading evidences: ' + err.message,
        runId: null,
        rowsUp: [],
        rowsDown: [],
        markersQueueBase: '',
        markersQueueNote: '',
        slurmQueueHover: ''
      }
      syncMarkersStatusFromResponse(_annotPopupData.metadataId, _annotPopupData.catIdx, { state: 'error' })
    })
}

function stopAnnotationMarkers() {
  var ev = _annotPopupData.evidences || {}
  var runId = ev.runId
  if (!runId) {
    alert('No FindMarkers run to stop.')
    return
  }
  if (!confirm('Stop FindMarkers for this metadata? Any running Docker container or SLURM job will be cancelled.')) {
    return
  }
  var csrfToken = document.querySelector('meta[name="csrf-token"]')
  var headers = { 'Accept': 'application/json' }
  if (csrfToken) headers['X-CSRF-Token'] = csrfToken.getAttribute('content')

  _annotPopupData.evidences = {
    state: 'loading',
    loading: true,
    message: 'Stopping FindMarkers...',
    runId: runId,
    rowsUp: [],
    rowsDown: [],
    markersQueueBase: '',
    markersQueueNote: '',
    slurmQueueHover: ''
  }
  updateMarkersStatusInMetadataPanel(_annotPopupData.metadataId, _annotPopupData.catIdx, 'loading', null)
  refreshAnnotPopupTitle()
  if (_annotPopupData.activeTab === 'evidences') renderAnnotationPanel()

  fetch('/runs/' + encodeURIComponent(String(runId)) + '/stop', {
    method: 'POST',
    headers: headers,
    credentials: 'same-origin'
  })
    .then(function(r) {
      return r.json().then(function(body) { return { ok: r.ok, body: body } })
    })
    .then(function(res) {
      if (!res.ok || !res.body || res.body.status !== 'ok') {
        var message = (res.body && res.body.message) ? res.body.message : 'Could not stop FindMarkers.'
        _annotPopupData.evidences = {
          state: 'error',
          loading: false,
          message: message,
          runId: runId,
          rowsUp: [],
          rowsDown: []
        }
        syncMarkersStatusFromResponse(_annotPopupData.metadataId, _annotPopupData.catIdx, { state: 'error' })
        return
      }
      loadAnnotationEvidences(true)
    })
    .catch(function(err) {
      _annotPopupData.evidences = {
        state: 'error',
        loading: false,
        message: 'Could not stop FindMarkers: ' + err.message,
        runId: runId,
        rowsUp: [],
        rowsDown: []
      }
      syncMarkersStatusFromResponse(_annotPopupData.metadataId, _annotPopupData.catIdx, { state: 'error' })
    })
}

