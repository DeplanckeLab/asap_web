<div class="flex flex-col h-full text-[13px] leading-snug"
     data-controller="step-selector"
     data-step-selector-project-id-value="<%= @project.id %>"
     data-step-selector-project-key-value="<%= @project.key %>"
     data-step-selector-status-icons-value="<%= status_icons_json %>"
     data-step-selector-run-status-badges-value="<%= run_status_badge_options_json %>"
     data-step-selector-load-run-panel-value="<%= @load_run_panel %>"
     data-step-selector-load-sub-view-value="<%= @load_sub_view %>"
     data-step-selector-sub-view-step-id-value="<%= @selected_step_id %>"
     data-step-selector-loom-file-value="<%= @selected_loom_file.to_s %>">
  <!-- Header -->
  <div class="mb-4 flex-shrink-0">
    <div class="flex items-center justify-between gap-3 mb-2">
      <div class="flex items-center gap-3">
        <h2 class="text-lg font-bold text-gray-900">Analysis</h2>
        <% if @project_type %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 border border-blue-200">
            <%= @project_type.name %>
          </span>
        <% end %>
      </div>
      <div class="flex items-center gap-3 flex-shrink-0">
        <div id="analysis-direct-link-container" class="relative">
          <button type="button"
                  class="h-9 px-3 bg-white hover:bg-gray-100 text-gray-700 rounded-md text-xs font-medium transition-colors cursor-pointer border border-gray-300 inline-flex items-center gap-2"
                  title="Show direct link"
                  onclick="toggleAnalysisDirectLinkPopover()">
            <i class="fas fa-link text-sm"></i>
            <span>Direct link</span>
          </button>
          <div id="analysis-direct-link-popover"
               class="hidden absolute right-0 top-full mt-2 w-[38rem] max-w-[85vw] z-[12000] bg-white border border-gray-300 rounded-md shadow-lg p-3">
            <div class="text-xs font-medium text-gray-600 mb-2">Share this URL</div>
            <div class="flex items-center gap-2">
              <div id="analysis-direct-link-value"
                   class="flex-1 min-w-0 text-xs text-gray-700 bg-gray-50 border border-gray-200 rounded px-2 py-2 break-all"></div>
              <button type="button"
                      class="h-8 px-3 bg-blue-600 hover:bg-blue-700 text-white rounded-md text-xs font-medium transition-colors cursor-pointer inline-flex items-center gap-2"
                      onclick="copyAnalysisDirectLinkFromPopover()"
                      title="Copy link">
                <i class="fas fa-copy text-xs"></i>
                <span>Copy</span>
              </button>
            </div>
            <div id="analysis-direct-link-copied"
                 class="hidden mt-2 text-xs font-medium text-green-700">
              Copied!
            </div>
          </div>
        </div>

        <% if defined?(@available_loom_files) && @available_loom_files.present? %>
          <div class="inline-flex items-center h-9">
            <div class="inline-flex h-9 items-center px-3 border border-gray-300 rounded-l-md bg-gray-50 text-xs font-medium text-gray-700">
              <i class="fa fa-filter mr-1"></i>
              <span>Filter runs</span>
              <span id="loom-filter-warning-icon"
                    class="ml-2 text-amber-600 cursor-help <%= (defined?(@loom_filter_hidden_runs_count) && @loom_filter_hidden_runs_count.to_i > 0) ? '' : 'hidden' %>"
                    title="<%= @loom_filter_warning_message %>"
                    data-global-hidden-runs-count="<%= @loom_filter_hidden_runs_count.to_i %>"
                    data-global-visible-runs-count="<%= @loom_filter_visible_runs_count.to_i %>"
                    data-global-total-runs-count="<%= @loom_filter_total_runs_count.to_i %>"
                    data-hidden-by-step-json="<%= (@loom_filter_hidden_runs_by_step || {}).to_json %>"
                    data-visible-by-step-json="<%= (@loom_filter_visible_runs_by_step || {}).to_json %>"
                    data-total-by-step-json="<%= (@loom_filter_total_runs_by_step || {}).to_json %>"
                    data-step-id-name-json="<%= (@analysis_step_id_to_name || {}).to_json %>"
                    data-hidden-by-step-name-json="<%= (@loom_filter_hidden_runs_by_step_name || {}).to_json %>"
                    data-visible-by-step-name-json="<%= (@loom_filter_visible_runs_by_step_name || {}).to_json %>"
                    data-total-by-step-name-json="<%= (@loom_filter_total_runs_by_step_name || {}).to_json %>">
                <i class="fa fa-exclamation-triangle"></i>
              </span>
              <span id="loom-filter-warning-count"
                    class="ml-1 text-amber-700 text-xs font-medium <%= (defined?(@loom_filter_hidden_runs_count) && @loom_filter_hidden_runs_count.to_i > 0) ? '' : 'hidden' %>">
                <%= @loom_filter_visible_runs_count.to_i %> of <%= @loom_filter_total_runs_count.to_i %>
              </span>
            </div>
            <label for="analysis-loom-select" class="sr-only">Loom file</label>
            <select id="analysis-loom-select"
                    class="-ml-px h-9 px-3 border border-gray-300 rounded-r-md text-xs bg-white text-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    onchange="onAnalysisLoomFilterChange(this.value)">
              <% all_url_params = { view: 'analysis', loom_file: '__all__' } %>
              <% all_url_params[:step_id] = @selected_step_id if defined?(@selected_step_id) && @selected_step_id.present? %>
              <% all_url_params[:run_id] = @selected_run_id if defined?(@selected_run_id) && @selected_run_id.present? %>
              <% all_url_params[:sub_view] = params[:sub_view] if params[:sub_view].present? %>
              <option value="<%= project_path(@project, all_url_params) %>" <%= @selected_loom_file.blank? ? 'selected' : '' %>>
                All LOOM files
              </option>
              <% @available_loom_files.each do |filepath| %>
                <% url_params = { view: 'analysis', loom_file: filepath } %>
                <% url_params[:step_id] = @selected_step_id if defined?(@selected_step_id) && @selected_step_id.present? %>
                <% url_params[:run_id] = @selected_run_id if defined?(@selected_run_id) && @selected_run_id.present? %>
                <% url_params[:sub_view] = params[:sub_view] if params[:sub_view].present? %>
                <% option_url = project_path(@project, url_params) %>
                <option value="<%= option_url %>" <%= (defined?(@selected_loom_file) && @selected_loom_file == filepath) ? 'selected' : '' %>>
                  <%= loom_file_label(filepath) %>
                </option>
              <% end %>
            </select>
          </div>
        <% end %>

        <button id="analysis-pipeline-toggle-button"
                type="button" 
                class="h-9 px-4 bg-blue-600 hover:bg-blue-700 text-white rounded-md text-xs font-medium transition-colors cursor-pointer inline-block"
                data-mode="graph"
                onclick="openPipelineGraphOrRunDetails()">
          Pipeline Graph
        </button>
      </div>
    </div>
   <!-- <p class="text-gray-600">Data analysis tools and pipelines for single-cell transcriptomics</p>-->
  </div>

  <!-- Step Selector for Narrow Screens (Mobile/Tablet) -->
  <%= render partial: 'projects/views/steps_panel_mobile' %>

  <!-- Two Column Layout: Steps Panel (Left) and Step Results (Right) -->
  <div class="flex flex-row gap-4 flex-1 min-h-0 w-full overflow-hidden" style="width: 100%; max-width: 100%; min-width: 0;">
    <!-- Left Panel: Steps Navigation (Hidden on narrow screens) -->
    <div class="hidden lg:flex w-75 flex-shrink-0 flex flex-col min-h-0 h-full overflow-hidden" data-step-selector-target="stepsPanel">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 flex flex-col h-full overflow-hidden">
        <%= render partial: 'projects/views/steps_panel' %>
      </div>
    </div>
    
    <!-- Right Panel: Step Results -->
    <div class="flex-1 flex flex-col min-h-0 min-w-0" style="min-width: 0; max-width: 100%; overflow-x: hidden;">
      <div data-step-selector-target="resultsContainer" class="bg-white rounded-lg shadow-sm border border-gray-200 flex flex-col h-full overflow-hidden w-full" style="width: 100%; max-width: 100%; min-width: 0; overflow-x: hidden;">
        <div class="overflow-y-auto overflow-x-hidden flex-1 min-w-0 w-full" style="width: 100%; max-width: 100%; min-width: 0; overflow-x: hidden;">
          <% has_server_content = (@load_sub_view && @sub_view_html.present?) || (@load_run_panel && @run_panel_html.present?) %>
          <div class="text-center text-gray-500 text-sm py-12 px-6" data-step-selector-target="emptyState" <% if has_server_content %>style="display: none;"<% end %>>
            <i class="fas fa-mouse-pointer text-5xl mb-4 opacity-30"></i>
            <p class="mb-0 lg:hidden">Select a step from the dropdown above to view its results</p>
            <p class="mb-0 hidden lg:block">Select a step from the left panel to view its results</p>
          </div>
          <div data-step-selector-target="loadingState" style="display: none;" class="text-center text-sm py-12 px-6">
            <i class="fas fa-spinner fa-spin text-2xl text-blue-600 mb-4"></i>
            <p class="text-gray-600 mb-0">Loading step...</p>
          </div>
          <% if has_server_content %>
            <div data-step-selector-target="content" style="display: block; width: 100% !important; max-width: 100% !important; min-width: 0 !important; overflow-x: hidden !important; box-sizing: border-box !important;" class="w-full max-w-full min-w-0 overflow-x-hidden">
              <% if @load_sub_view && @sub_view_html.present? %>
                <%= @sub_view_html.html_safe %>
              <% elsif @load_run_panel && @run_panel_html.present? %>
                <%= @run_panel_html.html_safe %>
              <% end %>
            </div>
          <% else %>
            <div data-step-selector-target="content" style="display: none; width: 100% !important; max-width: 100% !important; min-width: 0 !important; overflow-x: hidden !important; box-sizing: border-box !important;" class="w-full max-w-full min-w-0 overflow-x-hidden">
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div data-step-selector-target="stepHelpModal"
       class="hidden fixed inset-0 z-[12050]"
       role="dialog"
       aria-modal="true"
       aria-labelledby="step-help-modal-title"
       data-action="keydown@window->step-selector#closeStepHelpOnEscape">
    <div class="absolute inset-0 bg-black/50 z-0 cursor-default"
         data-action="click->step-selector#closeStepHelp"></div>
    <div class="absolute inset-0 z-10 overflow-y-auto pointer-events-none">
      <div class="flex min-h-full items-center justify-center p-4">
        <div class="bg-white rounded-lg shadow-xl max-w-lg w-full max-h-[85vh] overflow-hidden flex flex-col border border-gray-200 pointer-events-auto"
             data-action="click->step-selector#stopStepHelpPanelClick">
          <div class="px-5 py-4 border-b border-gray-200 flex items-center justify-between gap-3 flex-shrink-0">
            <h2 id="step-help-modal-title"
                data-step-selector-target="stepHelpTitle"
                class="text-base font-semibold text-gray-900 m-0 pr-2">
              Step
            </h2>
            <button type="button"
                    class="flex-shrink-0 px-3 py-1.5 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1 cursor-pointer"
                    data-action="click->step-selector#closeStepHelp"
                    aria-label="Close">
              Close
            </button>
          </div>
          <div data-step-selector-target="stepHelpBody"
               class="px-5 py-4 overflow-y-auto text-xs text-gray-700 flex-1 min-h-0">
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


<script>
  function updateAnalysisLoomFilterWarning() {
    const warningIcon = document.getElementById('loom-filter-warning-icon')
    const warningCount = document.getElementById('loom-filter-warning-count')
    if (!warningIcon) return

    const parseJsonMap = (raw) => {
      if (!raw) return {}
      try {
        const parsed = JSON.parse(raw)
        return parsed && typeof parsed === 'object' ? parsed : {}
      } catch (_e) {
        return {}
      }
    }

    const hiddenByStep = parseJsonMap(warningIcon.dataset.hiddenByStepJson)
    const visibleByStep = parseJsonMap(warningIcon.dataset.visibleByStepJson)
    const totalByStep = parseJsonMap(warningIcon.dataset.totalByStepJson)
    const stepIdToName = parseJsonMap(warningIcon.dataset.stepIdNameJson)
    const hiddenByStepName = parseJsonMap(warningIcon.dataset.hiddenByStepNameJson)
    const visibleByStepName = parseJsonMap(warningIcon.dataset.visibleByStepNameJson)
    const totalByStepName = parseJsonMap(warningIcon.dataset.totalByStepNameJson)

    const graphToggleButton = document.getElementById('analysis-pipeline-toggle-button')
    const mode = graphToggleButton && graphToggleButton.dataset ? graphToggleButton.dataset.mode : 'graph'
    const stepSelectorElement = document.querySelector('[data-controller*="step-selector"]')
    const currentStepId = stepSelectorElement ? stepSelectorElement.getAttribute('data-current-step-id') : null
    const renderedStepElement = document.querySelector('[data-step-selector-target="content"] .step-results[data-step-id]')
    const renderedStepId = renderedStepElement ? renderedStepElement.getAttribute('data-step-id') : null
    const renderedStepName = renderedStepElement ? renderedStepElement.getAttribute('data-step-name') : null
    const selectedStepMenuElement = currentStepId
      ? document.querySelector(`[data-step-selector-target="stepsPanel"] [data-step-id="${currentStepId}"], [data-dropdown-target="menu"] [data-step-id="${currentStepId}"]`)
      : null
    const selectedStepMenuName = selectedStepMenuElement ? selectedStepMenuElement.getAttribute('data-step-name') : null

    console.log('[Analysis][warning][debug] mode=', mode,
      'currentStepId=', currentStepId,
      'renderedStepId=', renderedStepId,
      'renderedStepName=', renderedStepName,
      'selectedStepMenuName=', selectedStepMenuName)

    // Button mode mapping:
    // - mode "details" => currently in Graph view (button says "Run details")
    // - mode "graph"   => currently in Run details view (button says "Pipeline Graph")
    // In run-details view, warning must be step-scoped.
    if (mode === 'graph' && (renderedStepId || currentStepId)) {
      const stepIdForWarning = renderedStepId || currentStepId
      let hiddenCount = Number(hiddenByStep[String(stepIdForWarning)] || 0)
      let visibleCount = Number(visibleByStep[String(stepIdForWarning)] || 0)
      let totalCount = Number(totalByStep[String(stepIdForWarning)] || 0)

      // Fallback to step-name aggregation when step-id mapping differs
      if (totalCount === 0) {
        const rawStepName = renderedStepName || selectedStepMenuName || stepIdToName[String(stepIdForWarning)]
        const stepName = rawStepName ? String(rawStepName).trim().toLowerCase() : ''
        if (stepName) {
          hiddenCount = Number(hiddenByStepName[String(stepName)] || 0)
          visibleCount = Number(visibleByStepName[String(stepName)] || 0)
          totalCount = Number(totalByStepName[String(stepName)] || 0)
        }
      }

      console.log('[Analysis][warning][debug] step-scope decision stepIdForWarning=', stepIdForWarning,
        'hiddenCount=', hiddenCount, 'visibleCount=', visibleCount, 'totalCount=', totalCount)

      if (hiddenCount > 0) {
        warningIcon.classList.remove('hidden')
        warningIcon.title = `${hiddenCount} run(s) are hidden by the current loom filter for this step. Showing ${visibleCount} of ${totalCount} run(s).`
        if (warningCount) {
          warningCount.classList.remove('hidden')
          warningCount.textContent = `${visibleCount} of ${totalCount}`
        }
      } else {
        warningIcon.classList.add('hidden')
        warningIcon.title = ''
        if (warningCount) {
          warningCount.classList.add('hidden')
          warningCount.textContent = ''
        }
      }
      console.log('[Analysis][warning][debug] step-scope iconHidden=', warningIcon.classList.contains('hidden'), 'title=', warningIcon.title)
      return
    }

    const globalHidden = Number(warningIcon.dataset.globalHiddenRunsCount || 0)
    const globalVisible = Number(warningIcon.dataset.globalVisibleRunsCount || 0)
    const globalTotal = Number(warningIcon.dataset.globalTotalRunsCount || 0)
    if (globalHidden > 0) {
      warningIcon.classList.remove('hidden')
      warningIcon.title = `${globalHidden} run(s) are hidden by the current loom filter. Showing ${globalVisible} of ${globalTotal} run(s).`
      if (warningCount) {
        warningCount.classList.remove('hidden')
        warningCount.textContent = `${globalVisible} of ${globalTotal}`
      }
    } else {
      warningIcon.classList.add('hidden')
      warningIcon.title = ''
      if (warningCount) {
        warningCount.classList.add('hidden')
        warningCount.textContent = ''
      }
    }
    console.log('[Analysis][warning][debug] global-scope hidden=', globalHidden, 'visible=', globalVisible, 'total=', globalTotal,
      'iconHidden=', warningIcon.classList.contains('hidden'), 'title=', warningIcon.title)
  }

  function buildAnalysisDirectLink() {
    const contentContainer = document.querySelector('[data-step-selector-target="content"]')
    if (contentContainer) {
      const explicitDirectLinkElement = contentContainer.querySelector('[data-analysis-direct-link-path]')
      const explicitDirectLinkPath = explicitDirectLinkElement && explicitDirectLinkElement.getAttribute('data-analysis-direct-link-path')
      if (explicitDirectLinkPath) {
        return new URL(explicitDirectLinkPath, window.location.origin).toString()
      }
    }

    const url = new URL(window.location.href)
    url.searchParams.set('view', 'analysis')

    const toggleButton = document.getElementById('analysis-pipeline-toggle-button')
    const buttonMode = toggleButton && toggleButton.dataset ? toggleButton.dataset.mode : 'graph'
    // Button mode mapping:
    // - "details" => currently in graph view
    // - "graph"   => currently in run-details view
    const currentPanelMode = buttonMode === 'details' ? 'graph' : 'run_details'
    url.searchParams.set('panel_mode', currentPanelMode)

    const stepSelectorElement = document.querySelector('[data-controller*="step-selector"]')
    const currentStepId = stepSelectorElement ? stepSelectorElement.getAttribute('data-current-step-id') : null
    if (currentStepId) {
      url.searchParams.set('step_id', String(currentStepId))
    } else {
      url.searchParams.delete('step_id')
    }

    const runPanel = document.getElementById('run_result_summary_panel')
    const runIdFromPanel = runPanel ? runPanel.getAttribute('data-run-id') : null
    const stepIdFromPanel = runPanel ? runPanel.getAttribute('data-step-id') : null
    const effectiveStepId = stepIdFromPanel || currentStepId
    if (effectiveStepId) {
      url.searchParams.set('step_id', String(effectiveStepId))
    }
    if (runIdFromPanel) {
      url.searchParams.set('run_id', String(runIdFromPanel))
      url.searchParams.set('panel_mode', 'run_details')
    } else {
      url.searchParams.delete('run_id')
    }

    const loomSelect = document.getElementById('analysis-loom-select')
    if (loomSelect && loomSelect.value) {
      try {
        const selectedUrl = new URL(loomSelect.value, window.location.origin)
        const selectedLoom = selectedUrl.searchParams.get('loom_file')
        if (selectedLoom) {
          url.searchParams.set('loom_file', selectedLoom)
        }
      } catch (_e) {
        // no-op
      }
    }

    return url.toString()
  }

  function buildRunDetailsDirectLink(stepId, runId) {
    const url = new URL(buildAnalysisDirectLink())
    if (stepId) {
      url.searchParams.set('step_id', String(stepId))
    }
    if (runId) {
      url.searchParams.set('run_id', String(runId))
    }
    url.searchParams.set('panel_mode', 'run_details')
    return url.toString()
  }

  function toggleAnalysisDirectLinkPopover(forceOpen) {
    const popover = document.getElementById('analysis-direct-link-popover')
    const valueEl = document.getElementById('analysis-direct-link-value')
    const copiedEl = document.getElementById('analysis-direct-link-copied')
    if (!popover || !valueEl) return

    const shouldOpen = forceOpen === true || (forceOpen !== false && popover.classList.contains('hidden'))
    if (!shouldOpen) {
      popover.classList.add('hidden')
      if (copiedEl) copiedEl.classList.add('hidden')
      return
    }

    valueEl.textContent = buildAnalysisDirectLink()
    popover.classList.remove('hidden')
    if (copiedEl) copiedEl.classList.add('hidden')
  }

  function copyAnalysisDirectLinkFromPopover() {
    const valueEl = document.getElementById('analysis-direct-link-value')
    const copiedEl = document.getElementById('analysis-direct-link-copied')
    if (!valueEl) return

    const url = (valueEl.textContent || '').trim()
    if (!url) return

    navigator.clipboard.writeText(url)
      .then(() => {
        if (!copiedEl) return
        copiedEl.classList.remove('hidden')
        setTimeout(() => {
          copiedEl.classList.add('hidden')
        }, 1500)
      })
      .catch((_e) => {
        if (!copiedEl) return
        copiedEl.textContent = 'Copy failed'
        copiedEl.classList.remove('hidden')
        setTimeout(() => {
          copiedEl.textContent = 'Copied!'
          copiedEl.classList.add('hidden')
        }, 1500)
      })
  }

  function onAnalysisLoomFilterChange(targetUrl) {
    if (!targetUrl) return

    try {
      const url = new URL(targetUrl, window.location.origin)
      const selectedLoom = url.searchParams.get('loom_file') || '__all__'
      const stepSelectorElement = document.querySelector('[data-controller*="step-selector"]')
      const currentStepId = stepSelectorElement ? stepSelectorElement.getAttribute('data-current-step-id') : null
      const toggleButton = document.getElementById('analysis-pipeline-toggle-button')
      const buttonMode = toggleButton && toggleButton.dataset ? toggleButton.dataset.mode : 'graph'
      const currentPanelMode = buttonMode === 'details' ? 'graph' : 'run_details'

      if (stepSelectorElement && window.Stimulus && currentStepId) {
        const controller = window.Stimulus.getControllerForElementAndIdentifier(stepSelectorElement, 'step-selector')
        if (controller && typeof controller.loadStepResults === 'function') {
          controller.loomFileValue = selectedLoom === '__all__' ? '' : selectedLoom
          const stepElement = stepSelectorElement.querySelector(`[data-step-id="${currentStepId}"]`) || { getAttribute: () => currentStepId }
          controller.loadStepResults(currentStepId, stepElement, false, `loom_file=${encodeURIComponent(selectedLoom)}`)

          const newUrl = new URL(window.location.href)
          newUrl.searchParams.set('view', 'analysis')
          newUrl.searchParams.set('step_id', String(currentStepId))
          newUrl.searchParams.set('loom_file', selectedLoom)
          newUrl.searchParams.set('panel_mode', currentPanelMode)
          newUrl.searchParams.delete('run_id')
          newUrl.searchParams.delete('sub_view')
          newUrl.searchParams.delete('show_form')
          newUrl.searchParams.delete('prefer_runs_list')
          window.history.replaceState({}, '', newUrl.pathname + newUrl.search + newUrl.hash)
          return
        }
      }

      // Fallback when step selector context is unavailable.
      if (currentStepId) url.searchParams.set('step_id', String(currentStepId))
      url.searchParams.set('panel_mode', currentPanelMode)
      url.searchParams.delete('run_id')
      url.searchParams.delete('sub_view')
      url.searchParams.delete('show_form')
      url.searchParams.delete('prefer_runs_list')
      window.location.href = url.pathname + url.search + url.hash
    } catch (_e) {
      window.location.href = targetUrl
    }
  }

  function setPipelineHeaderButtonMode(mode) {
    const button = document.getElementById('analysis-pipeline-toggle-button')
    if (!button) return

    if (mode === 'details') {
      button.dataset.mode = 'details'
      button.textContent = 'Run details'
    } else {
      button.dataset.mode = 'graph'
      button.textContent = 'Pipeline Graph'
    }
    updateAnalysisLoomFilterWarning()
  }

  function openPipelineGraphOrRunDetails() {
    const button = document.getElementById('analysis-pipeline-toggle-button')
    const mode = button && button.dataset ? button.dataset.mode : 'graph'
    console.log('[Analysis][debug] openPipelineGraphOrRunDetails mode=', mode)

    if (mode === 'details') {
      const stepSelectorElement = document.querySelector('[data-controller*="step-selector"]')
      if (!stepSelectorElement || !window.Stimulus) return

      const controller = window.Stimulus.getControllerForElementAndIdentifier(stepSelectorElement, 'step-selector')
      if (!controller || !controller.currentStepId || typeof controller.loadStepResults !== 'function') return

      const stepId = controller.currentStepId.toString()
      console.log('[Analysis][debug] run-details click currentStepId=', stepId, 'buttonMode=', mode)
      const stepElement = stepSelectorElement.querySelector(`[data-step-id="${stepId}"]`) || { getAttribute: () => stepId }
      controller.loadStepResults(stepId, stepElement, true, '&prefer_runs_list=1')
      return
    }

    loadFormInRightPanel('<%= graph_project_path(@project) %>')
  }

  function appendLoomContextToUrl(url) {
    try {
      const dropdown = document.getElementById('analysis-loom-select')
      if (!dropdown) return url

      const selectedOption = dropdown.options[dropdown.selectedIndex]
      if (!selectedOption || !selectedOption.value) return url

      const selectedUrl = new URL(selectedOption.value, window.location.origin)
      const selectedLoom = selectedUrl.searchParams.get('loom_file')
      if (!selectedLoom) return url

      const targetUrl = new URL(url, window.location.origin)
      if (!targetUrl.searchParams.get('loom_file')) {
        targetUrl.searchParams.set('loom_file', selectedLoom)
      }
      return targetUrl.pathname + targetUrl.search + targetUrl.hash
    } catch (e) {
      return url
    }
  }

  function loadFormInRightPanel(formUrl) {
    formUrl = appendLoomContextToUrl(formUrl)
    const isGraphRequest = /\/graph(\?|$)/.test(formUrl)
    console.log('[loadFormInRightPanel] Loading form from:', formUrl, 'isGraphRequest=', isGraphRequest)

    const stepSelectorElement = document.querySelector('[data-controller*="step-selector"]')
    if (!stepSelectorElement) {
      console.error('[loadFormInRightPanel] Step selector element not found')
      return
    }

    if (!window.Stimulus) {
      console.error('[loadFormInRightPanel] Stimulus not available')
      return
    }

    const controller = window.Stimulus.getControllerForElementAndIdentifier(stepSelectorElement, 'step-selector')
    if (!controller || !controller.hasContentTarget) {
      console.error('[loadFormInRightPanel] Step selector controller or content target not found')
      return
    }

    window.__analysisRightPanelOverlaySeq = (window.__analysisRightPanelOverlaySeq || 0) + 1
    const overlayTicket = window.__analysisRightPanelOverlaySeq
    const stepResultsSeqWhenFormFetchStarted = controller._stepResultsRequestSeq

    // Save state to localStorage - for forms we save step state (not form state)
    // When user comes back, they'll see the step results, which includes the form if no runs exist
    if (controller.currentStepId && typeof controller.saveState === 'function') {
      controller.saveState(controller.currentStepId, 'step', null)
      console.log('[loadFormInRightPanel] State saved for step:', controller.currentStepId)
    }
    
    // Hide empty state and loading state, show content
    if (controller.hasEmptyStateTarget) {
      controller.emptyStateTarget.style.display = 'none'
    }
    if (controller.hasLoadingStateTarget) {
      controller.loadingStateTarget.style.display = 'block'
    }
    controller.contentTarget.style.display = 'none'
    
    // Fetch the form
    fetch(formUrl, {
      method: 'GET',
      headers: {
        'Accept': 'text/html',
        'X-Requested-With': 'XMLHttpRequest'
      },
      credentials: 'same-origin'
    })
    .then(response => {
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`)
      }
      return response.text()
    })
    .then(html => {
      if (overlayTicket !== window.__analysisRightPanelOverlaySeq) {
        if (controller.hasLoadingStateTarget) {
          controller.loadingStateTarget.style.display = 'none'
        }
        controller.contentTarget.style.display = 'block'
        return
      }
      if (controller._stepResultsRequestSeq !== stepResultsSeqWhenFormFetchStarted) {
        if (controller.hasLoadingStateTarget) {
          controller.loadingStateTarget.style.display = 'none'
        }
        controller.contentTarget.style.display = 'block'
        return
      }
      
      // Create a temporary container to parse HTML
      const tempDiv = document.createElement('div')
      tempDiv.innerHTML = html
      
      // Separate external scripts (with src) from inline scripts
      const externalScripts = []
      const inlineScripts = []
      const scripts = tempDiv.querySelectorAll('script')
      
      scripts.forEach(script => {
        if (script.src) {
          externalScripts.push(script.src)
        } else {
          inlineScripts.push(script.textContent)
        }
        script.remove()
      })
      
      // Update content with form (without script tags)
      controller.contentTarget.innerHTML = tempDiv.innerHTML
      controller.contentTarget.style.display = 'block'
      
      // Load external scripts first, then execute inline scripts
      const loadScripts = (index) => {
        if (index < externalScripts.length) {
          const script = document.createElement('script')
          script.src = externalScripts[index]
          script.onload = () => {
            console.log('[loadFormInRightPanel] External script loaded:', externalScripts[index])
            loadScripts(index + 1)
          }
          script.onerror = () => {
            console.error('[loadFormInRightPanel] Failed to load script:', externalScripts[index])
            loadScripts(index + 1) // Continue even if one fails
          }
          document.head.appendChild(script)
        } else {
          // All external scripts loaded, now execute inline scripts
          inlineScripts.forEach((scriptText, idx) => {
            const script = document.createElement('script')
            script.textContent = scriptText
            document.head.appendChild(script)
            document.head.removeChild(script) // Remove after execution
            console.log('[loadFormInRightPanel] Inline script executed:', idx)
          })
          
          // Hide loading state
          if (controller.hasLoadingStateTarget) {
            controller.loadingStateTarget.style.display = 'none'
          }
          
          // Trigger Stimulus to scan for new controllers in the form
          if (window.Stimulus && window.Stimulus.router && typeof window.Stimulus.router.scan === 'function') {
            setTimeout(() => {
              window.Stimulus.router.scan()
            }, 0)
            
            setTimeout(() => {
              window.Stimulus.router.scan()
            }, 100)
          }

          if (isGraphRequest) {
            setPipelineHeaderButtonMode('details')
          } else {
            setPipelineHeaderButtonMode('graph')
          }
        }
      }
      
      // Start loading scripts
      if (externalScripts.length > 0) {
        loadScripts(0)
      } else {
        // No external scripts, just execute inline scripts
        inlineScripts.forEach((scriptText) => {
          const script = document.createElement('script')
          script.textContent = scriptText
          document.head.appendChild(script)
          document.head.removeChild(script)
        })
        
        if (controller.hasLoadingStateTarget) {
          controller.loadingStateTarget.style.display = 'none'
        }
        
        if (window.Stimulus && window.Stimulus.router && typeof window.Stimulus.router.scan === 'function') {
          setTimeout(() => {
            window.Stimulus.router.scan()
          }, 0)
          
          setTimeout(() => {
            window.Stimulus.router.scan()
          }, 100)
        }

        if (isGraphRequest) {
          setPipelineHeaderButtonMode('details')
        } else {
          setPipelineHeaderButtonMode('graph')
        }
      }
    })
    .catch(error => {
      console.error('[loadFormInRightPanel] Error loading form:', error)
      if (controller.hasLoadingStateTarget) {
        controller.loadingStateTarget.style.display = 'none'
      }
      controller.contentTarget.innerHTML = `
        <div class="alert alert-danger p-4">
          <i class="fas fa-exclamation-triangle me-2"></i>
          Error loading form: ${error.message}
        </div>
      `
      controller.contentTarget.style.display = 'block'
    })
  }

  function loadRunInRightPanel(runUrl, stepId) {
    setPipelineHeaderButtonMode('graph')
    console.log('[loadRunInRightPanel] Loading run from:', runUrl, 'stepId:', stepId)

    const stepSelectorElement = document.querySelector('[data-controller*="step-selector"]')
    if (!stepSelectorElement) {
      console.error('[loadRunInRightPanel] Step selector element not found')
      return
    }

    if (!window.Stimulus) {
      console.error('[loadRunInRightPanel] Stimulus not available')
      return
    }

    const controller = window.Stimulus.getControllerForElementAndIdentifier(stepSelectorElement, 'step-selector')
    if (!controller || !controller.hasContentTarget) {
      console.error('[loadRunInRightPanel] Step selector controller or content target not found')
      return
    }

    window.__analysisRightPanelOverlaySeq = (window.__analysisRightPanelOverlaySeq || 0) + 1
    const overlayTicket = window.__analysisRightPanelOverlaySeq
    const stepResultsSeqWhenRunFetchStarted = controller._stepResultsRequestSeq

    // Extract run ID from URL for state persistence
    const runIdMatch = runUrl.match(/\/runs\/(\d+)/)
    const runId = runIdMatch ? runIdMatch[1] : null
    
    // Update the current step ID if provided (for highlighting in left panel)
    if (stepId) {
      controller.currentStepId = stepId.toString()
      controller.element.setAttribute('data-current-step-id', stepId.toString())
      console.log('[loadRunInRightPanel] Updated currentStepId to:', stepId)
    }
    
    // Save state to localStorage for when user returns from visualization view
    const effectiveStepId = stepId || controller.currentStepId
    if (runId && effectiveStepId && typeof controller.saveState === 'function') {
      controller.saveState(effectiveStepId, 'run', runId)
      console.log('[loadRunInRightPanel] State saved for run:', runId, 'step:', effectiveStepId)
    }
    
    // Refresh the steps panel to update the highlighting
    if (stepId && typeof controller.refreshStepsPanel === 'function') {
      controller.refreshStepsPanel()
    }
    
    // Hide empty state and loading state, show content
    if (controller.hasEmptyStateTarget) {
      controller.emptyStateTarget.style.display = 'none'
    }
    if (controller.hasLoadingStateTarget) {
      controller.loadingStateTarget.style.display = 'block'
    }
    controller.contentTarget.style.display = 'none'
    
    // Fetch the run content (with panel parameter to get panel version). Cache-bust so status
    // transitions (running -> success) always reflect the latest server-rendered panel.
    const panelUrl = runUrl + (runUrl.includes('?') ? '&' : '?') + 'panel=1&_t=' + Date.now()
    fetch(panelUrl, {
      method: 'GET',
      headers: {
        'Accept': 'text/html',
        'X-Requested-With': 'XMLHttpRequest',
        'Cache-Control': 'no-cache'
      },
      credentials: 'same-origin',
      cache: 'no-store'
    })
    .then(response => {
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`)
      }
      return response.text()
    })
    .then(html => {
      if (overlayTicket !== window.__analysisRightPanelOverlaySeq) {
        if (controller.hasLoadingStateTarget) {
          controller.loadingStateTarget.style.display = 'none'
        }
        controller.contentTarget.style.display = 'block'
        return
      }
      if (controller._stepResultsRequestSeq !== stepResultsSeqWhenRunFetchStarted) {
        if (controller.hasLoadingStateTarget) {
          controller.loadingStateTarget.style.display = 'none'
        }
        controller.contentTarget.style.display = 'block'
        return
      }
      // Update content with run
      controller.contentTarget.innerHTML = html
      controller.contentTarget.style.display = 'block'
      
      // Hide loading state
      if (controller.hasLoadingStateTarget) {
        controller.loadingStateTarget.style.display = 'none'
      }
      
      // Trigger Stimulus to connect new controllers in the dynamically loaded content
      console.log('[loadRunInRightPanel] Triggering Stimulus to connect new controllers...')
      
      // Log what controllers are in the new content
      const newControllerElements = controller.contentTarget.querySelectorAll('[data-controller]')
      console.log('[loadRunInRightPanel] Found elements with data-controller:', newControllerElements.length)
      newControllerElements.forEach(el => {
        console.log('[loadRunInRightPanel] Controller element:', el.getAttribute('data-controller'), el)
      })
      
      // The MutationObserver in Stimulus should automatically detect new elements
      // But let's also try forcing a reconnection by temporarily removing and re-adding
      // the content to trigger the mutation
      setTimeout(() => {
        // Check if controllers are connected
        const pipelineRunsElements = controller.contentTarget.querySelectorAll('[data-controller*="pipeline-runs"]')
        console.log('[loadRunInRightPanel] pipeline-runs elements:', pipelineRunsElements.length)
        pipelineRunsElements.forEach(el => {
          if (window.Stimulus) {
            const ctrl = window.Stimulus.getControllerForElementAndIdentifier(el, 'pipeline-runs')
            console.log('[loadRunInRightPanel] pipeline-runs controller connected:', !!ctrl, el)
            if (!ctrl) {
              // Controller not connected - try to force it by cloning
              console.log('[loadRunInRightPanel] Attempting to force controller connection...')
              const clone = el.cloneNode(true)
              el.parentNode.replaceChild(clone, el)
            }
          }
        })
      }, 200)
    })
    .catch(error => {
      console.error('[loadRunInRightPanel] Error loading run:', error)
      if (controller.hasLoadingStateTarget) {
        controller.loadingStateTarget.style.display = 'none'
      }
      controller.contentTarget.innerHTML = `
        <div class="alert alert-danger p-4">
          <i class="fas fa-exclamation-triangle me-2"></i>
          Error loading run: ${error.message}
        </div>
      `
      controller.contentTarget.style.display = 'block'
    })
  }

  console.log('[Analysis] selected_run_id=<%= @selected_run_id.inspect %>, selected_step_id=<%= @selected_step_id.inspect %>, load_run_panel=<%= @load_run_panel.inspect %>, load_sub_view=<%= @load_sub_view.inspect %>')
  updateAnalysisLoomFilterWarning()

  ;(function restorePanelModeAfterLoomSwitch() {
    try {
      const params = new URLSearchParams(window.location.search)
      const panelMode = params.get('panel_mode')
      if (panelMode === 'graph') {
        // Keep graph mode after loom filter change
        setTimeout(() => {
          loadFormInRightPanel('<%= graph_project_path(@project) %>')
        }, 120)
      }
    } catch (_e) {
      // no-op
    }
  })()

  document.addEventListener('click', function(event) {
    const container = document.getElementById('analysis-direct-link-container')
    const popover = document.getElementById('analysis-direct-link-popover')
    if (!container || !popover || popover.classList.contains('hidden')) return
    if (!container.contains(event.target)) {
      toggleAnalysisDirectLinkPopover(false)
    }
  })

</script>
