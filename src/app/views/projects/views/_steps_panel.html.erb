<div class="flex flex-col h-full">
  <div class="bg-gray-600 text-white px-4 py-3 border-b-2 border-gray-700 flex-shrink-0">
    <h5 class="mb-0 font-bold text-lg">
      <i class="fas fa-list-ol me-2"></i>Pipeline Steps
    </h5>
  </div>
  <div class="flex-1 overflow-y-auto">
    <% if @steps_with_status && @steps_with_status.any? %>
      <% @steps_with_status.each do |step_info| %>
        <% step = step_info[:step] %>
        <% is_current = step_info[:is_current] %>
        <% is_available = step_info[:is_available] %>
        <% is_complete = step_info[:is_complete] %>
        <% status = step_info[:status] %>
        <% status_counts = step_info[:status_counts] || { waiting: 0, running: 0, completed: 0, failed: 0 } %>
        
        <% 
          # Determine if this step is selected (shown in right panel)
          is_selected = @selected_step_id && step.id == @selected_step_id
          
          # Determine CSS classes and styles
          # All steps have white background by default
          item_classes = 'flex items-center px-4 py-3 border-b border-gray-200 step-item bg-white'
          # Apply blue left border if this is the selected step
          item_style = is_selected ? 'border-left: 4px solid #007bff;' : 'border-left: 4px solid transparent;'
          
          if !is_available
            item_classes += ' opacity-50 cursor-not-allowed disabled'
          else
            item_classes += ' step-item-hover'
          end
          
          if is_selected
            item_classes += ' active'
          end
          
          # Determine text color
          # Unlocked steps always display in black, locked steps in gray
          text_class = if !is_available
                        'text-gray-500'
                      else
                        'text-gray-900'
                      end
          
          # Determine cursor style
          cursor_style = if !is_available
                          'cursor: not-allowed !important;'
                        else
                          'cursor: pointer;'
                        end
        %>
        
        <div class="<%= item_classes %> <%= text_class %>" 
             style="<%= item_style %> <%= cursor_style %>"
             <% if is_available %>
               data-action="click->step-selector#selectStep"
               data-step-selector-step-id-param="<%= step.id %>"
             <% else %>
               data-step-locked="true"
               onclick="event.preventDefault(); event.stopPropagation(); return false;"
             <% end %>
             data-step-id="<%= step.id %>">
          <div class="flex-shrink-0 mr-3" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; align-self: center;">
            <% if !is_available %>
              <div class="relative group">
                <i class="fas fa-lock text-sm text-gray-400"></i>
                <div class="absolute left-full top-full ml-2 mt-1 px-2 py-1 text-xs font-medium text-white bg-gray-900 rounded shadow-lg opacity-0 group-hover:opacity-100 transition-opacity duration-0 pointer-events-none whitespace-nowrap z-50">
                  Locked
                  <div class="absolute right-full top-1/2 -translate-y-1/2 w-0 h-0 border-t-4 border-b-4 border-r-4 border-transparent border-r-gray-900"></div>
                </div>
              </div>
            <% elsif !step.multiple_runs %>
              <% 
                # Single icon for steps with multiple_runs = false
                # Use status.humanize to display the database value directly
                tooltip_text = if status.present?
                                 status.humanize
                               else
                                 "Not started"
                               end
              %>
              <div class="relative group">
                <% if is_complete %>
                  <% completed_config = status_icons_by_key[:completed] %>
                  <i class="<%= completed_config[:icon_base] %> text-sm <%= completed_config[:active_color] %>"></i>
                <% elsif status == 'running' %>
                  <% running_config = status_icons_by_key[:running] %>
                  <i class="<%= running_config[:icon_base] %> <%= running_config[:icon_spin] %> text-sm <%= running_config[:active_color] %>"></i>
                <% elsif status == 'pending' %>
                  <% waiting_config = status_icons_by_key[:pending] %>
                  <i class="<%= waiting_config[:icon_base] %> text-sm <%= waiting_config[:active_color] %>"></i>
                <% elsif status == 'failed' %>
                  <% failed_config = status_icons_by_key[:failed] %>
                  <i class="<%= failed_config[:icon_base] %> text-sm <%= failed_config[:active_color] %>"></i>
                <% else %>
                  <i class="far fa-circle text-sm text-gray-400"></i>
                <% end %>
                <div class="absolute left-full top-full ml-2 mt-1 px-2 py-1 text-xs font-medium text-white bg-gray-900 rounded shadow-lg opacity-0 group-hover:opacity-100 transition-opacity duration-0 pointer-events-none whitespace-nowrap z-50">
                  <%= tooltip_text %>
                  <div class="absolute right-full top-1/2 -translate-y-1/2 w-0 h-0 border-t-4 border-b-4 border-r-4 border-transparent border-r-gray-900"></div>
                </div>
              </div>
            <% else %>
              <div style="display: grid; grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(2, 1fr); gap: 2px; width: 100%; height: 100%; align-content: center;">
                <% 
                  # Get status icons from database, add counts
                  grid_status_icons = [:waiting, :running, :completed, :failed].map do |key|
                    config = status_icons_by_key[key]
                    config.merge(count: status_counts[key] || 0)
                  end
                %>
                <% grid_status_icons.each do |status_icon| %>
                  <% 
                    is_active = status_icon[:count] > 0
                    icon_class = status_icon[:icon_base]
                    icon_class += " #{status_icon[:icon_spin]}" if is_active && status_icon[:icon_spin].present?
                    color_class = is_active ? status_icon[:active_color] : status_icon[:inactive_color]
                    tooltip_text = "#{status_icon[:tooltip_label]} (#{status_icon[:count]})"
                  %>
                  <div class="relative group" style="display: flex; align-items: center; justify-content: center;">
                    <i class="<%= icon_class %> text-sm <%= color_class %>"></i>
                    <div class="absolute left-full top-full ml-2 mt-1 px-2 py-1 text-xs font-medium text-white bg-gray-900 rounded shadow-lg opacity-0 group-hover:opacity-100 transition-opacity duration-0 pointer-events-none whitespace-nowrap z-50">
                      <%= tooltip_text %>
                      <div class="absolute right-full top-1/2 -translate-y-1/2 w-0 h-0 border-t-4 border-b-4 border-r-4 border-transparent border-r-gray-900"></div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
          <div class="flex-grow">
            <div>
              <strong class="block"><%= step.label.presence || step.name %></strong>
            </div>
          </div>
          <div class="flex-shrink-0 ml-3 flex items-center">
            <div class="w-3 h-3 rounded-full" style="background-color: <%= get_step_color(step.id) %>;"></div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-8 px-4">
        <p class="text-gray-500 mb-0">No steps available</p>
        <% if admin? %>
          <small class="text-gray-400 block mt-2 text-xs">
            Debug info:<br/>
            @steps_with_status present: <%= @steps_with_status.present? %><br/>
            @steps_with_status count: <%= @steps_with_status&.count || 0 %><br/>
            @pretreatment_steps count: <%= @pretreatment_steps&.count || 0 %><br/>
            @all_project_steps count: <%= @all_project_steps&.count || 0 %>
          </small>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<style>
  .step-item-hover:hover:not(.active) {
    background-color: #f0f4f8 !important;
    border-left-color: #9ca3af !important;
  }
</style>

