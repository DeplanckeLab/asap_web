<%# Parsing Status Section (when waiting or running, before results are available) %>
<%# Also show if status is complete but results are missing (after restart) %>
<%# Show status section if no results OR if results exist but have displayed_error (so we show status + error) %>
<%# Also show if parsing_run exists with status_id 4 (failed) even if @results is nil %>
<% if @step && @step.name == 'parsing' && (!@results || (@results && @results['displayed_error']) || (@parsing_run && @parsing_run.status_id == 4)) %>
  <%# Always show something when there are no results %>
  <%# Use ONLY the run's status_id, matching the left panel logic %>
  <% status_id = @parsing_run&.status_id %>
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-6 overflow-hidden">
    <div class="px-6 py-8 text-center">
      <% if status_id.nil? || status_id == 1 %>
        <div class="flex flex-col items-center justify-center"
             <% if @parsing_run && @parsing_run.slurm_job_id %>
               data-controller="queue-position"
               data-queue-position-run-id-value="<%= @parsing_run.id %>"
               data-queue-position-slurm-job-id-value="<%= @parsing_run.slurm_job_id %>"
               data-queue-position-project-id-value="<%= @project.id %>"
               <% if @parsing_run.submitted_at %>
                 data-queue-position-submitted-at-value="<%= @parsing_run.submitted_at.iso8601 %>"
               <% end %>
             <% end %>>
          <i class="fas fa-clock text-yellow-500 text-5xl mb-4"></i>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Parsing is waiting</h3>
          <p class="text-gray-600 mb-4">The parsing job is queued and will start shortly.</p>
          <% if @parsing_run && @parsing_run.slurm_job_id %>
            <% if @parsing_run.submitted_at %>
              <div class="text-sm text-gray-600 mb-3">
                <span class="font-medium">Waiting time:</span>
                <span data-queue-position-target="waitingTime" class="ml-2 font-mono">--:--</span>
              </div>
            <% end %>
            <div data-queue-position-target="queueInfo" class="text-gray-600">
              <span>Position in the queue: </span>
              <span data-queue-position-target="position" class="inline-block">
                <i class="fas fa-spinner fa-spin"></i>
              </span>
            </div>
            <div data-queue-position-target="emptyQueue" class="text-gray-600 hidden">
              Nothing in the queue, will start shortly...
            </div>
          <% end %>
        </div>
      <% elsif status_id == 2 %>
        <div class="flex flex-col items-center justify-center" 
             data-controller="parsing-timer"
             <% if @parsing_run&.start_time %>
               data-parsing-timer-start-time-value="<%= @parsing_run.start_time.iso8601 %>"
             <% end %>
             <% if @parsing_run&.pred_process_duration %>
               data-parsing-timer-expected-duration-value="<%= @parsing_run.pred_process_duration %>"
             <% end %>>
          <i class="fas fa-spinner fa-spin text-blue-500 text-5xl mb-4"></i>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Parsing is running</h3>
          <p class="text-gray-600 mb-4">The parsing job is currently processing your data. Results will appear here when complete.</p>
          
          <%# Time counter section %>
          <div class="mt-4 space-y-2">
            <div class="text-sm text-gray-700">
              <span class="font-medium">Elapsed time:</span>
              <span data-parsing-timer-target="elapsedTime" class="ml-2 font-mono">--:--:--</span>
            </div>
            <% if @parsing_run&.pred_process_duration %>
              <div class="text-sm text-gray-600">
                <span class="font-medium">Expected time:</span>
                <span data-parsing-timer-target="expectedTime" class="ml-2 font-mono"><%= duration(@parsing_run.pred_process_duration.to_i) %></span>
              </div>
            <% end %>
          </div>
        </div>
      <% elsif status_id == 3 %>
        <%# Status says complete but no results - likely after restart %>
        <div class="flex flex-col items-center justify-center">
          <i class="fas fa-clock text-yellow-500 text-5xl mb-4"></i>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Parsing is waiting</h3>
          <p class="text-gray-600 mb-4">The parsing job has been restarted and is queued. Results will appear here when complete.</p>
        </div>
      <% elsif status_id == 4 %>
        <%# Parsing failed - show error message %>
        <div class="flex flex-col items-center justify-center">
          <i class="fas fa-exclamation-circle text-red-500 text-5xl mb-4"></i>
          <h3 class="text-xl font-semibold text-red-900 mb-2">Parsing Failed</h3>
          <p class="text-gray-600 mb-4">
            <% if @results && @results['displayed_error'] %>
              <%# Show error from output.json if available %>
              <% if @results['displayed_error'].is_a?(Array) %>
                <%= @results['displayed_error'].first %>
              <% else %>
                <%= @results['displayed_error'] %>
              <% end %>
            <% elsif @parsing_run && @parsing_run.error.present? %>
              <%= @parsing_run.error %>
            <% else %>
              The parsing job failed. Please check the logs or try restarting the parsing step.
            <% end %>
          </p>
        </div>
      <% else %>
        <%# Fallback for any other status (including nil project_step) %>
        <div class="flex flex-col items-center justify-center">
          <i class="fas fa-clock text-yellow-500 text-5xl mb-4"></i>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Parsing is waiting</h3>
          <p class="text-gray-600 mb-4">The parsing step is being initialized. Results will appear here when ready.</p>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%# Parsing Results Section %>
<% if @step && @step.name == 'parsing' && @results && !@results['displayed_error'] && (@parsing_run.nil? || @parsing_run.status_id == 3) %>
  <div class="bg-white rounded-lg shadow-sm flex flex-col" id="result_summary" style="max-height: calc(100vh - 200px); overflow-y: auto;">
    <div class="border-b border-gray-200 px-6 py-4 sticky top-0 z-10 flex-shrink-0" style="background: linear-gradient(to right, #eff6ff, #eef2ff); background-color: #ffffff;">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
          Parsing results
        </h3>
        <div class="flex items-center gap-3">
          <!-- Reset Button -->
          <% if @project_step && @step && !@step.multiple_runs && (@project_step.status_id == 3 || @project_step.status_id == 4) %>
            <%= link_to reset_parsing_project_path(@project),
                  class: "px-4 py-2 bg-orange-600 hover:bg-orange-700 text-white rounded-md font-medium transition-colors cursor-pointer inline-block",
                  style: "flex-shrink: 0;" do %>
              Reset
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
    <div class="px-6 py-5 space-y-6 flex-1">

      <!-- Warnings and Errors -->
      <% if @results['warnings'] %>
        <% warnings = @results['warnings'].is_a?(Array) ? @results['warnings'] : [@results['warnings']].compact %>
        <% if warnings.any? %>
          <% warnings.each do |warning| %>
            <% next if warning.blank? %>
            <div class="alert alert-warning flex items-start gap-3">
              <i class="fas fa-exclamation-triangle text-yellow-600 mt-0.5"></i>
              <span><%= warning %></span>
            </div>
          <% end %>
        <% end %>
      <% end %>

      <% if @results['errors'] %>
        <% errors = @results['errors'].is_a?(Array) ? @results['errors'] : [@results['errors']].compact %>
        <% if errors.any? %>
          <% errors.each do |error| %>
            <% next if error.blank? %>
            <div class="alert alert-danger flex items-start gap-3">
              <i class="fas fa-exclamation-circle text-red-600 mt-0.5"></i>
              <span><%= error %></span>
            </div>
          <% end %>
        <% end %>
      <% end %>
      
      <!-- Also check for any error messages that might be stored in other fields -->
      <% if @results['error'] && @results['error'].present? && !@results['displayed_error'] %>
        <div class="alert alert-danger flex items-start gap-3">
          <i class="fas fa-exclamation-circle text-red-600 mt-0.5"></i>
          <span><%= @results['error'] %></span>
        </div>
      <% end %>
      
      <% if @results['warning'] && @results['warning'].present? %>
        <div class="alert alert-warning flex items-start gap-3">
          <i class="fas fa-exclamation-triangle text-yellow-600 mt-0.5"></i>
          <span><%= @results['warning'] %></span>
        </div>
      <% end %>

      <!-- Parameters (for non-LOOM/H5_10x/MEX formats) -->
      <% if @results && !['LOOM', 'H5_10x', 'MEX'].include?(@results["detected_format"]) && @project.parsing_attrs_json %>
        <% h_attrs = Basic.safe_parse_json(@project.parsing_attrs_json, {}) %>
        <div class="pt-4 relative">
          <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3 flex items-center gap-2">
            <i class="fas fa-cog text-gray-500"></i>
            Parameters
          </h4>
          <!-- File Format - Right Floating -->
          <div class="absolute top-4 right-0">
            <% if @h_formats && @results && @results["detected_format"] && @h_formats[@results["detected_format"]] %>
              <%= raw display_file_format(@h_formats[@results["detected_format"]]) %>
            <% elsif @results && @results["detected_format"] %>
              <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-md text-sm font-medium"><%= @results["detected_format"] %></span>
            <% end %>
          </div>
          <div class="flex flex-wrap gap-2 items-center">
            <% h_delimiter = {"\\t" => 'Tab', "\t" => "Tab", " " => "Space", "," => "Comma", ":" => "Colon"} %>
            <% if h_attrs['delimiter'] && h_attrs['delimiter'] != '' %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                Delimiter: <%= h_delimiter[h_attrs['delimiter']] || h_attrs['delimiter'] %>
              </span>
            <% end %>
            <% h_gene_name_col = {"0" => "First", "first" => "First", "-1" => "Last", "last" => "Last", "NA" => "None", 'none' => "None"} %>
            <% if h_attrs['gene_name_col'] %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                Gene name column: <%= h_gene_name_col[h_attrs['gene_name_col']] || h_attrs['gene_name_col'] %>
              </span>
            <% end %>
            <% if h_attrs['skip_line'] %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                Skip lines: <%= h_attrs['skip_line'] %>
              </span>
            <% end %>
            <% if h_attrs['has_header'] %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                Has header: <%= (h_attrs['has_header'] == "1" || h_attrs['has_header'] == true) ? 'Yes' : 'No' %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Integration section (if applicable) -->
      <% if @project.parsing_attrs_json %>
        <% h_attrs = Basic.safe_parse_json(@project.parsing_attrs_json, {}) %>
        <% if h_attrs['integrate_batch_paths'] %>
          <div class="border-t border-gray-200 pt-4">
            <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-4 flex items-center gap-2">
              <i class="fas fa-layer-group text-gray-500"></i>
              Integration
            </h4>
            <% integrated_projects = Project.where(key: h_attrs['integrate_batch_paths'].keys).all %>
            <div class="bg-gray-50 rounded-lg p-4 space-y-4">
              <div class="flex items-center justify-between py-2 border-b border-gray-200">
                <span class="text-sm font-medium text-gray-700">Number of PCs taken into account</span>
                <span class="text-sm text-gray-900 font-semibold"><%= h_attrs["integrate_n_pcs"] %></span>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-700 mb-3">Integrated projects</p>
                <div class="overflow-x-auto">
                  <table id="integration_projects" class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-100">
                      <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Project key</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Project name</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Batch metadata</th>
                      </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                      <% integrated_projects.each do |p| %>
                        <tr class="hover:bg-gray-50">
                          <td class="px-4 py-3 text-sm text-gray-900"><%= p.key %></td>
                          <td class="px-4 py-3 text-sm text-gray-900"><%= p.name %></td>
                          <td class="px-4 py-3 text-sm text-gray-900">
                            <%= (h_attrs['integrate_batch_paths'][p.key] == 'null') ? 'None' : h_attrs['integrate_batch_paths'][p.key] %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>

      <!-- Output Summary -->
      <div class="border-t border-gray-200 pt-4">
        <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-2 flex items-center gap-2">
          <i class="fas fa-chart-bar text-gray-500"></i>
          Output summary
        </h4>
        <div class="flex flex-wrap gap-3">
          <% if @results['nber_rows'] %>
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-blue-50 border border-blue-200 rounded-lg">
              <i class="fas fa-dna text-blue-600"></i>
              <span class="text-sm font-medium text-blue-900"><%= row_label(@project).capitalize %>: <span class="font-bold"><%= @results['nber_rows'] %></span></span>
            </div>
          <% end %>
          <% if @results['nber_cols'] %>
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-purple-50 border border-purple-200 rounded-lg">
              <i class="fas fa-circle text-purple-600"></i>
              <span class="text-sm font-medium text-purple-900"><%= col_label(@project).capitalize %>: <span class="font-bold"><%= @results['nber_cols'] %></span></span>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Validation Warnings -->
      <% 
        nber_not_found_genes = @results['nber_not_found_genes'] if @results
        has_validation_alerts = false
        # Check if any alerts will be displayed
        if (@results['nber_rows'] && @results['nber_rows'] < 3) ||
           (@results['nber_cols'] && @results['nber_cols'] == 0) ||
           (@results['nber_cols'] && @results['nber_cols'] < 3) ||
           @results.key?('is_count_table') ||
           (@results['nber_zeros'] && @results['nber_rows'] && @results['nber_cols'] && (@results['nber_rows'].to_f * @results['nber_cols'].to_f > 0)) ||
           (nber_not_found_genes && nber_not_found_genes > 0) ||
           @results['nber_rows']
          has_validation_alerts = true
        end
      %>
      <% if has_validation_alerts %>
        <div class="pt-4 space-y-3">
          <% if @results['nber_rows'] && @results['nber_rows'] < 3 %>
            <div class="alert alert-danger flex items-start gap-3">
              <i class="fas fa-exclamation-triangle text-red-600 mt-0.5"></i>
              <span>For many steps of the pipeline at least three <%= row_label(@project) %> are required</span>
            </div>
          <% end %>

          <% if @results['nber_cols'] && @results['nber_cols'] == 0 %>
            <div class="alert alert-danger flex items-start gap-3">
              <i class="fas fa-exclamation-triangle text-red-600 mt-0.5"></i>
              <span>You may have selected wrong parameters for the parsing, in particular not the appropriated delimiter</span>
            </div>
          <% elsif @results['nber_cols'] && @results['nber_cols'] < 3 %>
            <div class="alert alert-danger flex items-start gap-3">
              <i class="fas fa-exclamation-triangle text-red-600 mt-0.5"></i>
              <div class="flex-1">
                <p class="mb-1">Original dataset has less than 3 <%= col_label(@project) %></p>
                <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-red-200 text-red-800">
                  For many steps of the pipeline at least three <%= col_label(@project) %> are required
                </span>
              </div>
            </div>
          <% end %>

          <!-- Count Matrix Status -->
          <% if @results['is_count_table'] == 1 || @results['is_count_table'] == true %>
            <div class="alert alert-success flex items-start gap-3">
              <i class="fas fa-check-circle text-green-600 mt-0.5"></i>
              <span>The original matrix contains only counts</span>
            </div>
          <% else %>
            <div class="alert alert-danger flex items-start gap-3">
              <i class="fas fa-exclamation-triangle text-red-600 mt-0.5"></i>
              <div class="flex-1">
                <p class="mb-1">The original matrix contains floats</p>
                <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-red-200 text-red-800">
                  Many methods will NOT be available if your original file is not a count matrix
                </span>
              </div>
            </div>
          <% end %>

          <!-- Zero Values Percentage -->
          <% if @results['nber_zeros'] && @results['nber_rows'] && @results['nber_cols'] %>
            <% total_values = @results['nber_rows'].to_f * @results['nber_cols'].to_f %>
            <% if total_values > 0 %>
              <% zero_percentage = ((@results['nber_zeros'].to_f * 100) / total_values).round(2) %>
              <div class="alert alert-info flex items-start gap-3">
                <i class="fas fa-info-circle text-blue-600 mt-0.5"></i>
                <span><%= zero_percentage %>% of values are zeros</span>
              </div>
            <% end %>
          <% end %>

          <!-- Ensembl Mapping Status -->
          <% if nber_not_found_genes && nber_not_found_genes > 0 %>
            <% total_genes = @results['nber_rows'] || 1 %>
            <% not_found_percentage = (nber_not_found_genes.to_f * 100 / total_genes).round(2) %>
            <div class="alert alert-danger flex items-start gap-3">
              <i class="fas fa-exclamation-triangle text-red-600 mt-0.5"></i>
              <div class="flex-1">
                <p class="mb-2"><%= nber_not_found_genes %> (<%= not_found_percentage %>%) <%= row_label(@project) %> were not found in Ensembl</p>
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-red-50 border border-red-200">
                  <i class="fas fa-lightbulb text-red-600"></i>
                  <span class="text-sm text-red-800">Did you select the right species (now <strong><%= @project.organism&.name || 'Unknown' %></strong>)? If not, create a new project</span>
                </div>
              </div>
            </div>
          <% else %>
            <% if @results['nber_rows'] %>
              <div class="alert alert-success flex items-start gap-3">
                <i class="fas fa-check-circle text-green-600 mt-0.5"></i>
                <span>All <strong><%= @results['nber_rows'] %></strong> <%= row_label(@project) %> were found in Ensembl</span>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <!-- Results Files -->
      <div class="border-t border-gray-200 pt-4">
        <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3 flex items-center gap-2">
          <i class="fas fa-download text-gray-500"></i>
          Download Results
        </h4>
        <div class="flex flex-wrap gap-3">
          <% project_dir = Pathname.new(ENV.fetch('USER_DATA_DIR')) + @project.user_id.to_s + @project.key %>
          <% loom_file = project_dir + 'parsing' + 'output.loom' %>
          <% if File.exist?(loom_file) && exportable?(@project) %>
            <%= link_to(get_file_project_path(@project, step: 'parsing', filename: 'output.loom'), 
                target: '_blank',
                class: 'inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors') do %>
              <i class="fas fa-file"></i>
              <span>Loom file</span>
              <i class="fas fa-external-link-alt text-xs"></i>
            <% end %>
            <span class="link_to_loom_tuto inline-flex items-center justify-center w-6 h-6 rounded-full bg-blue-100 text-blue-600 hover:bg-blue-200 cursor-pointer transition-colors">
              <i class="fas fa-info-circle text-xs"></i>
            </span>
          <% end %>
          <% if admin? %>
            <% json_file = project_dir + 'parsing' + 'output.json' %>
            <% if File.exist?(json_file) && exportable?(@project) %>
              <%= link_to(get_file_project_path(@project, step: 'parsing', filename: 'output.json'), 
                  target: '_blank',
                  class: 'inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors') do %>
                <i class="fas fa-file"></i>
                <span>JSON file</span>
                <i class="fas fa-external-link-alt text-xs"></i>
              <% end %>
            <% end %>
            <% log_file = project_dir + 'parsing' + 'output.log' %>
            <% if File.exist?(log_file) && exportable?(@project) %>
              <%= link_to(get_file_project_path(@project, step: 'parsing', filename: 'output.log'), 
                  target: '_blank',
                  class: 'inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors') do %>
                <i class="fas fa-file-alt"></i>
                <span>Log file</span>
                <i class="fas fa-external-link-alt text-xs"></i>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
      <% if @parsing_run %>
        <div class="bg-gray-50 border-t border-gray-200 px-6 py-3">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-600">
          <% metadata_parts = [] %>
          <% if admin? %>
            <% metadata_parts << "<span class='font-medium text-gray-700'>Run ##{@parsing_run.id}</span>" %>
          <% end %>
          <% if @parsing_run.created_at %>
            <% metadata_parts << "<span class='nowrap'>#{display_date_short(@parsing_run.created_at)}</span>" %>
          <% end %>
          <%# Waiting time - show if waiting_duration is set, or calculate from submitted_at to start_time, or show ongoing wait if status is waiting %>
          <% if @parsing_run.waiting_duration %>
            <% metadata_parts << "<span class='nowrap'><i class='fas fa-clock text-gray-400 mr-1'></i>Wait #{duration(@parsing_run.waiting_duration.round)}</span>" %>
          <% elsif @parsing_run.submitted_at && @parsing_run.start_time %>
            <%# Calculate waiting time from submitted_at to start_time %>
            <% wait_time = (@parsing_run.start_time - @parsing_run.submitted_at).round %>
            <% metadata_parts << "<span class='nowrap'><i class='fas fa-clock text-gray-400 mr-1'></i>Wait #{duration(wait_time)}</span>" %>
          <% elsif @parsing_run.status_id == 1 && @parsing_run.submitted_at %>
            <%# Ongoing wait - calculate from submitted_at to now %>
            <% wait_time = (Time.now - @parsing_run.submitted_at).round %>
            <% wait_text = "Wait #{duration(wait_time)}" %>
            <% if @queue_position %>
              <% wait_text += " (queue position: #{@queue_position})" %>
            <% end %>
            <% metadata_parts << "<span id='ongoing_wait_#{@parsing_run.id}' class='nowrap'><i class='fas fa-clock text-gray-400 mr-1'></i>#{wait_text}</span>" %>
          <% end %>
          <%# Running time - use duration if available, otherwise calculate from start_time %>
          <% run_time_display = nil %>
          <% is_running = false %>
          <% if @parsing_run.duration %>
            <% run_time_display = duration(@parsing_run.duration.to_i) %>
          <% elsif @parsing_run.process_duration %>
            <%# Use process_duration as fallback if duration is not set %>
            <% run_time_display = duration(@parsing_run.process_duration.to_i) %>
          <% elsif @parsing_run.status_id == 2 && @parsing_run.start_time %>
            <%# Running - show live time %>
            <% run_time = (Time.now - @parsing_run.start_time).to_i %>
            <% run_time_display = duration(run_time) %>
            <% is_running = true %>
          <% end %>
          
          <% if run_time_display %>
            <% run_time_text = "<i class='fas fa-play-circle text-gray-400 mr-1'></i>Run #{run_time_display}" %>
            <% if @parsing_run.pred_process_duration %>
              <% run_time_text += " <span class='text-gray-500'>(expected #{duration(@parsing_run.pred_process_duration.to_i)})</span>" %>
            <% end %>
            <% if is_running %>
              <% metadata_parts << "<span id='ongoing_run_#{@parsing_run.id}' class='nowrap'>#{run_time_text}</span>" %>
            <% else %>
              <% metadata_parts << "<span class='nowrap'>#{run_time_text}</span>" %>
            <% end %>
          <% end %>
          <%# Idle time - check both @results['time_idle'] and @parsing_run.process_idle_duration %>
          <% idle_time_display = nil %>
          <% if @results && @results['time_idle'] %>
            <% idle_time_display = @results['time_idle'] %>
          <% elsif @parsing_run.process_idle_duration %>
            <% idle_time_display = duration(@parsing_run.process_idle_duration.to_i) %>
          <% end %>
          <% if idle_time_display %>
            <% metadata_parts << "<span class='nowrap'><i class='fas fa-pause-circle text-gray-400 mr-1'></i>Idle #{idle_time_display}</span>" %>
          <% end %>
          <%# Max RAM - max_ram is stored in MB (from Basic.finish_run or SlurmJobMonitorJob) %>
          <%# display_mem expects bytes, so convert MB to bytes: MB * 1024 * 1024 %>
          <% if @parsing_run.max_ram %>
            <%# max_ram is in MB, convert to bytes for display_mem helper %>
            <% ram_bytes = @parsing_run.max_ram * 1024 * 1024 %>
            <% ram_display = display_mem(ram_bytes) %>
            <% ram_text = "<i class='fas fa-memory text-gray-400 mr-1'></i>Max. RAM #{ram_display}" %>
            <% if @parsing_run.pred_max_ram %>
              <%# pred_max_ram is stored in KB (from prediction script output), convert to bytes using binary conversion (1024) to match system standard %>
              <% pred_ram_bytes = @parsing_run.pred_max_ram.to_f * 1024 %>
              <% pred_ram_display = display_mem(pred_ram_bytes) %>
              <% ram_text += " <span class='text-gray-500'>(expected #{pred_ram_display})</span>" %>
            <% end %>
            <% metadata_parts << "<span class='nowrap'>#{ram_text}</span>" %>
          <% end %>
          <%= raw metadata_parts.compact.join(" <span class='text-gray-300'>•</span> ") %>
          <%# Hidden spans for JavaScript - add separately after visible metadata to avoid extra separators %>
          <% if @parsing_run.submitted_at %>
            <span id="created_time_<%= @parsing_run.id %>" class="hidden"><%= @parsing_run.submitted_at.strftime('%Y-%m-%d %H:%M:%S') %></span>
          <% end %>
          <% if @parsing_run.start_time %>
            <span id="start_time_<%= @parsing_run.id %>" class="hidden"><%= @parsing_run.start_time.strftime('%Y-%m-%d %H:%M:%S') %></span>
          <% end %>
        </div>
      </div>
      
      <%# Admin debug card - show run data in JSON format %>
      <% if admin? && @parsing_run %>
        <div class="bg-yellow-50 border-t border-yellow-200 px-6 py-4 mt-4">
          <div class="mb-2">
            <h4 class="text-sm font-semibold text-yellow-900 mb-2">Debug: Run Data (Admin Only)</h4>
            <div class="bg-white border border-yellow-300 rounded p-3 overflow-auto max-h-96">
              <pre class="text-xs text-gray-800 whitespace-pre-wrap break-words"><code><%= JSON.pretty_generate(@parsing_run.as_json) %></code></pre>
            </div>
          </div>
        </div>
      <% end %>
      <% end %>
    </div>
  </div>
  
  <%= javascript_tag do %>
    <% project_dir = Pathname.new(ENV.fetch('USER_DATA_DIR')) + @project.user_id.to_s + @project.key %>
    <% loom_file = project_dir + 'parsing' + 'output.loom' %>
    <% if File.exist?(loom_file) && exportable?(@project) %>
      $(".link_to_loom_tuto").click(function(e){
        var url = '<%= tutorial_home_index_path(t: 'loom') rescue '#' %>'
        var win = window.open(url, '_blank');
        if (win) win.focus();
        e.stopPropagation();
        e.preventDefault();
        return false;
      })
    <% end %>
    
    <% if @project.parsing_attrs_json %>
      <% h_attrs = Basic.safe_parse_json(@project.parsing_attrs_json, {}) %>
      <% if h_attrs['integrate_batch_paths'] %>
        if (typeof $.fn.DataTable !== 'undefined') {
          $("#integration_projects").DataTable()
        }
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%# Parsing Error Display (separate conditional so it always shows when there's an error) %>
<% if @step && @step.name == 'parsing' && @results && @results['displayed_error'] %>
  <!-- Parsing Error Display -->
  <div class="bg-white rounded-lg shadow-sm border border-red-200 mb-6 overflow-hidden">
    <div class="bg-gradient-to-r from-red-50 to-pink-50 border-b border-red-200 px-6 py-4">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-semibold text-red-900 flex items-center gap-2">
          <i class="fas fa-exclamation-circle text-red-600"></i>
          Parsing Error
        </h3>
        <% if @project_step && @step && !@step.multiple_runs && (@project_step.status_id == 3 || @project_step.status_id == 4) %>
          <%= link_to reset_parsing_project_path(@project),
                class: "px-4 py-2 bg-orange-600 hover:bg-orange-700 text-white rounded-md font-medium transition-colors cursor-pointer inline-block",
                style: "flex-shrink: 0;" do %>
            Reset
          <% end %>
        <% end %>
      </div>
    </div>
    <div class="px-6 py-5">
      <div class="bg-red-50 border border-red-200 rounded-md p-4">
        <% if @results['displayed_error'].is_a?(Array) %>
          <% @results['displayed_error'].each do |error| %>
            <p class="text-red-800 mb-2" title="<%= error %>"><%= error %></p>
          <% end %>
        <% else %>
          <p class="text-red-800"><%= @results['displayed_error'] %></p>
        <% end %>
        <% if admin? && @results['original_error'] %>
          <div class="mt-3 pt-3 border-t border-red-300">
            <p class="text-sm text-red-600 font-mono"><%= @results['original_error'] %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

