<div class="bg-white rounded-lg shadow-sm border border-gray-200 flex flex-col" id="run_show">
  <!-- Header with gradient background -->
  <div class="border-b border-gray-200 px-6 py-4 sticky top-0 z-10 flex-shrink-0" style="background: linear-gradient(to right, #eff6ff, #eef2ff); background-color: #ffffff;">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
          <% if @step %>
            <i class="fas fa-cog text-blue-600"></i>
            <%= @step.label.presence || @step.name.humanize %>
          <% end %>
          - Run #<%= @run.num || @run.id %>
        </h3>
        <% if @status %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= case @run.status_id
                                                                                                      when 1 then 'bg-yellow-100 text-yellow-800'
                                                                                                      when 2 then 'bg-blue-100 text-blue-800'
                                                                                                      when 3 then 'bg-green-100 text-green-800'
                                                                                                      when 4 then 'bg-red-100 text-red-800'
                                                                                                      else 'bg-gray-100 text-gray-800'
                                                                                                      end %>">
            <%= @status.name.humanize %>
          </span>
        <% end %>
      </div>
      <div class="flex items-center gap-3">
        <%= link_to project_path(@project, view: 'data'), class: 'inline-flex items-center px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-md font-medium transition-colors cursor-pointer' do %>
          <i class="fas fa-arrow-left mr-2"></i>Back
        <% end %>
        <% if admin? %>
          <%= link_to edit_run_path(@run), class: 'inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-medium transition-colors cursor-pointer' do %>
            <i class="fas fa-edit mr-2"></i>Edit
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="px-6 py-5 space-y-6 flex-1">
    <%# Always show our improved sections first %>
    <!-- Run Information Section -->
    <div class="pt-4 relative">
      <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3 flex items-center gap-2">
        <i class="fas fa-info-circle text-gray-500"></i>
        Run Information
      </h4>
      <div class="space-y-4">
        <% if @std_method %>
          <div>
            <span class="text-xs font-medium text-gray-500 uppercase">Method</span>
            <p class="text-sm text-gray-900 mt-1"><%= @std_method.label.presence || @std_method.name %></p>
          </div>
        <% end %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <span class="text-xs font-medium text-gray-500 uppercase">Created</span>
            <p class="text-sm text-gray-900 mt-1"><%= @run.created_at ? @run.created_at.strftime("%Y-%m-%d %H:%M:%S") : 'N/A' %></p>
          </div>
          <% if @run.start_time %>
            <div>
              <span class="text-xs font-medium text-gray-500 uppercase">Started</span>
              <p class="text-sm text-gray-900 mt-1"><%= @run.start_time.strftime("%Y-%m-%d %H:%M:%S") %></p>
            </div>
          <% end %>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% if @run.waiting_duration %>
            <div>
              <span class="text-xs font-medium text-gray-500 uppercase">Waiting Time</span>
              <div class="text-xs text-gray-500 mt-1">
                <i class="fas fa-hourglass-half text-gray-400 mr-1"></i>
                <span><%= duration(@run.waiting_duration.to_i) %></span>
              </div>
            </div>
          <% elsif @run.submitted_at && @run.start_time %>
            <% wait_time = (@run.start_time - @run.submitted_at).round %>
            <div>
              <span class="text-xs font-medium text-gray-500 uppercase">Waiting Time</span>
              <div class="text-xs text-gray-500 mt-1">
                <i class="fas fa-hourglass-half text-gray-400 mr-1"></i>
                <span><%= duration(wait_time) %></span>
              </div>
            </div>
          <% elsif @run.status_id == 1 && @run.submitted_at %>
            <% wait_time = (Time.now - @run.submitted_at).round %>
            <div>
              <span class="text-xs font-medium text-gray-500 uppercase">Waiting Time</span>
              <div class="text-xs text-gray-500 mt-1">
                <i class="fas fa-hourglass-half text-gray-400 mr-1"></i>
                <span><%= duration(wait_time) %></span>
              </div>
            </div>
          <% end %>
          <% if @run.duration %>
            <div>
              <span class="text-xs font-medium text-gray-500 uppercase">Duration</span>
              <div class="text-xs text-gray-500 mt-1">
                <i class="fas fa-clock text-gray-400 mr-1"></i>
                <span><%= duration(@run.duration.to_i) %></span>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Error Display -->
    <% if @run.status_id == 4 && (@run.error.present? || (@h_res && @h_res['displayed_error'])) %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <div class="flex items-start gap-3">
          <i class="fas fa-exclamation-circle text-red-600 mt-0.5"></i>
          <div class="flex-1">
            <h4 class="text-sm font-semibold text-red-800 mb-2">Error</h4>
            <% 
              error_messages = []
              if @h_res && @h_res['displayed_error']
                displayed_errors = @h_res['displayed_error'].is_a?(Array) ? @h_res['displayed_error'] : [@h_res['displayed_error']]
                error_messages.concat(displayed_errors.compact)
              end
              if @run.error.present?
                run_error = @run.error.strip
                unless error_messages.any? { |msg| msg.to_s.strip == run_error }
                  error_messages << run_error
                end
              end
              error_messages.uniq.each do |error_msg|
            %>
              <p class="text-red-800 mb-1" title="<%= error_msg %>"><%= error_msg %></p>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Parameters Section -->
    <% if @h_run_attrs.any? %>
      <div class="pt-4 relative">
        <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3 flex items-center gap-2">
          <i class="fas fa-cog text-gray-500"></i>
          Parameters
        </h4>
        <div class="flex flex-wrap gap-1.5 items-center">
          <% params_array = @h_run_attrs.to_a %>
          <% params_array.each do |key, value| %>
            <% annot_id = nil %>
            <% if value.is_a?(Hash) %>
              <% annot_id = value['annot_id'] || value[:annot_id] %>
            <% end %>
            <% if annot_id.present? %>
              <% annot = @h_annots_for_params[annot_id] if defined?(@h_annots_for_params) %>
              <% if annot %>
                <% ori_run = @h_ori_runs_for_params[annot.ori_run_id] if annot.ori_run_id.present? && defined?(@h_ori_runs_for_params) %>
                <% ori_step = (ori_run && ori_run.step_id && defined?(@h_steps_for_params) && @h_steps_for_params[ori_run.step_id]) ? @h_steps_for_params[ori_run.step_id] : nil %>
                <% step_name = ori_step ? (ori_step.label.presence || ori_step.name.presence || 'N/A') : 'N/A' %>
                <% if ori_step && ori_step.multiple_runs && ori_run %>
                  <% run_num = ori_run.num || ori_run.id %>
                  <% dataset_display = "#{step_name} ##{run_num} #{annot.name}" %>
                <% else %>
                  <% dataset_display = "#{step_name} #{annot.name}" %>
                <% end %>
                <% truncated_dataset = dataset_display.length > 30 ? dataset_display[0..26] + "..." : dataset_display %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700 border border-blue-200">
                  <span class="font-semibold text-blue-800"><%= key %>:</span>
                  <span class="ml-1 text-blue-600" title="<%= dataset_display %>"><%= truncated_dataset %></span>
                </span>
              <% else %>
                <% value_str = value.to_json %>
                <% truncated_value = value_str.length > 20 ? value_str[0..16] + "..." : value_str %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200">
                  <span class="font-semibold text-gray-800"><%= key %>:</span>
                  <span class="ml-1 text-gray-600"><%= truncated_value %></span>
                </span>
              <% end %>
            <% elsif value.is_a?(Array) && value.any? && value.first.is_a?(Hash) %>
              <% first_annot_id = value.first['annot_id'] || value.first[:annot_id] %>
              <% if first_annot_id.present? %>
                <% first_annot = @h_annots_for_params[first_annot_id] if defined?(@h_annots_for_params) %>
                <% if first_annot %>
                  <% ori_run = @h_ori_runs_for_params[first_annot.ori_run_id] if first_annot.ori_run_id.present? && defined?(@h_ori_runs_for_params) %>
                  <% ori_step = (ori_run && ori_run.step_id && defined?(@h_steps_for_params) && @h_steps_for_params[ori_run.step_id]) ? @h_steps_for_params[ori_run.step_id] : nil %>
                  <% step_name = ori_step ? (ori_step.label.presence || ori_step.name.presence || 'N/A') : 'N/A' %>
                  <% if ori_step && ori_step.multiple_runs && ori_run %>
                    <% run_num = ori_run.num || ori_run.id %>
                    <% dataset_display = "#{step_name} ##{run_num} #{first_annot.name}" %>
                  <% else %>
                    <% dataset_display = "#{step_name} #{first_annot.name}" %>
                  <% end %>
                  <% array_display = value.size > 1 ? "#{dataset_display} (+#{value.size - 1} more)" : dataset_display %>
                  <% truncated_array = array_display.length > 30 ? array_display[0..26] + "..." : array_display %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700 border border-blue-200">
                    <span class="font-semibold text-blue-800"><%= key %>:</span>
                    <span class="ml-1 text-blue-600" title="<%= array_display %>"><%= truncated_array %></span>
                  </span>
                <% else %>
                  <% value_str = "[#{value.size} datasets]" %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200">
                    <span class="font-semibold text-gray-800"><%= key %>:</span>
                    <span class="ml-1 text-gray-600"><%= value_str %></span>
                  </span>
                <% end %>
              <% else %>
                <% value_str = value.to_s %>
                <% truncated_value = value_str.length > 20 ? value_str[0..16] + "..." : value_str %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200">
                  <span class="font-semibold text-gray-800"><%= key %>:</span>
                  <span class="ml-1 text-gray-600"><%= truncated_value %></span>
                </span>
              <% end %>
            <% else %>
              <% value_str = value.to_s %>
              <% truncated_value = value_str.length > 20 ? value_str[0..16] + "..." : value_str %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200">
                <span class="font-semibold text-gray-800"><%= key %>:</span>
                <span class="ml-1 text-gray-600"><%= truncated_value %></span>
              </span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Output Summary -->
    <% if @run.status_id == 3 && @h_res %>
      <div class="pt-4 relative">
        <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-2 flex items-center gap-2">
          <i class="fas fa-chart-bar text-gray-500"></i>
          Output summary
        </h4>
        <div class="flex flex-wrap gap-3">
          <% if @h_res['nber_rows'] %>
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-blue-50 border border-blue-200 rounded-lg">
              <i class="fas fa-dna text-blue-600"></i>
              <span class="text-sm font-medium text-blue-900"><%= row_label(@project).capitalize %>: <span class="font-bold"><%= @h_res['nber_rows'] %></span></span>
            </div>
          <% end %>
          <% if @h_res['nber_cols'] %>
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-purple-50 border border-purple-200 rounded-lg">
              <i class="fas fa-circle text-purple-600"></i>
              <span class="text-sm font-medium text-purple-900"><%= col_label(@project).capitalize %>: <span class="font-bold"><%= @h_res['nber_cols'] %></span></span>
            </div>
          <% end %>
          <% if @step && @h_dashboard_card[@step.id] && @h_dashboard_card[@step.id]["output_values"] && @h_dashboard_card[@step.id]["output_values"].any? %>
            <% @h_dashboard_card[@step.id]["output_values"].each do |output| %>
              <% if @h_res[output["key"]] && output["key"] != 'nber_rows' && output["key"] != 'nber_cols' %>
                <div class="inline-flex items-center gap-2 px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg">
                  <span class="text-sm font-medium text-gray-900"><%= output["label"] %>: <span class="font-bold"><%= @h_res[output["key"]] %></span></span>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Warnings -->
    <% if @run.status_id == 3 && @h_res && @h_res['warnings'] && @h_res['warnings'].any? %>
      <div class="alert alert-warning flex items-start gap-3">
        <i class="fas fa-exclamation-triangle text-yellow-600 mt-0.5"></i>
        <div class="flex-1">
          <h4 class="text-sm font-semibold text-yellow-800 mb-2">Warnings</h4>
          <% @h_res['warnings'].each do |warning| %>
            <% if warning.is_a?(Hash) %>
              <p class="text-yellow-800 mb-1">
                <strong><%= warning['name'] %></strong>
                <% if warning['description'] %>
                  <span class="block text-sm mt-1"><%= warning['description'] %></span>
                <% end %>
              </p>
            <% else %>
              <p class="text-yellow-800 mb-1"><%= warning %></p>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Output Files and Metadata -->
    <% if @h_outputs && @h_outputs.any? %>
      <div class="pt-4 relative">
        <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3 flex items-center gap-2">
          <i class="fas fa-file-alt text-gray-500"></i>
          Output Files and Metadata
        </h4>
        <div class="space-y-4">
          <% h_unique_files = {} %>
          <% @h_outputs.each do |output_key, output_data| %>
            <% if output_data.is_a?(Hash) %>
              <% output_data.each do |file_key, file_info| %>
                <% if file_info.is_a?(Hash) %>
                  <% relative_path = file_key.split(":").first %>
                  <% unless h_unique_files[relative_path] %>
                    <% h_unique_files[relative_path] = file_info.dup %>
                  <% else %>
                    <% h_unique_files[relative_path]['filename'] ||= file_info['filename'] %>
                    <% h_unique_files[relative_path]['filesize'] ||= file_info['filesize'] %>
                    <% h_unique_files[relative_path]['size'] ||= file_info['size'] %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
          <% h_unique_files.each do |relative_path, file_info| %>
            <% is_loom = relative_path.end_with?('.loom') %>
            <% file_annots = [] %>
            <% if is_loom %>
              <% file_annots = Annot.where(project_id: @project.id, filepath: relative_path).order(:name) %>
            <% end %>
            <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-4">
              <h5 class="text-sm font-semibold text-gray-900 mb-3">
                <%= relative_path %>
                <% if file_info['filesize'] || file_info['size'] %>
                  <span class="text-gray-500 font-normal">(<%= display_mem(file_info['filesize'] || file_info['size']) %>)</span>
                <% end %>
              </h5>
              <% if is_loom && file_annots.any? %>
                <div class="mt-3 pt-3 border-t border-gray-200">
                  <h6 class="text-xs font-medium text-gray-700 uppercase tracking-wide mb-2">Metadata</h6>
                  <div class="flex flex-wrap gap-1.5">
                    <% file_annots.each do |annot| %>
                      <% annot_name = annot.name || '' %>
                      <% badge_class = 'bg-gray-100 text-gray-700 border-gray-200' %>
                      <% if annot_name.start_with?('/row_attrs/') %>
                        <% badge_class = 'bg-blue-50 text-blue-700 border-blue-200' %>
                        <% display_name = annot_name.gsub(/^\/row_attrs\//, '') %>
                      <% elsif annot_name.start_with?('/col_attrs/') %>
                        <% badge_class = 'bg-purple-50 text-purple-700 border-purple-200' %>
                        <% display_name = annot_name.gsub(/^\/col_attrs\//, '') %>
                      <% elsif annot_name == '/matrix' %>
                        <% badge_class = 'bg-green-50 text-green-700 border-green-200' %>
                        <% display_name = 'matrix' %>
                      <% else %>
                        <% badge_class = 'bg-gray-100 text-gray-700 border-gray-200' %>
                        <% display_name = annot_name.gsub(/^\//, '') %>
                      <% end %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= badge_class %> border">
                        <%= display_name %>
                      </span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @step && @step.has_std_view %>
      <%# Use std_view structure for additional content %>
      <% if @layout && @layout.any? %>
        <% @layout.each do |vertical_el| %>
          <% if (!vertical_el['admin'] || admin?) %>
            <div class="vert_element <%= tw_class('row') %>">
              <% vertical_el["horiz_elements"].each do |horiz_element| %>
                <% id = horiz_element['id'].to_s %>
                <% container_class_str = horiz_element['container_class'] || '' %>
                <% container_classes = container_class_str.present? ? tw_class(container_class_str) : 'w-full flex-[1_1_100%] min-w-full' %>
                <div class="horiz_element <%= container_classes %>">
                  <% if horiz_element['type'] == 'card' && (@h_el[id] || (horiz_element['partial'] && @h_outputs && @h_outputs[horiz_element['output_name']] && (!horiz_element['admin'] || admin?))) %>
                    <% card_class_str = horiz_element['class'] || '' %>
                    <% card_classes = card_class_str.present? ? tw_class(card_class_str) : '' %>
                    <div class="<%= tw_class('card') %> <%= card_classes %>">
                      <% if @h_el[id] %>
                        <% if @h_el[id][:card_header] %>
                          <div class="<%= tw_class('card-header') %>">
                            <%= raw translate_bootstrap_in_html(@h_el[id][:card_header]) %>
                          </div>
                        <% end %>
                        <div class="<%= tw_class('card-body') %>">
                          <%= raw translate_bootstrap_in_html(@h_el[id][:card_body]) %>
                        </div>
                      <% elsif horiz_element['partial'] && @h_outputs && @h_outputs[horiz_element['output_name']] && (!horiz_element['admin'] || admin?) %>
                        <% begin %>
                          <% partial_path = horiz_element['partial'] %>
                          <%# Try the specified path first, then try projects/ prefix if it's just a name %>
                          <% partial_found = lookup_context.template_exists?(partial_path, [], true) %>
                          <% unless partial_found && !partial_path.include?('/') %>
                            <% projects_path = "projects/#{partial_path}" %>
                            <% if lookup_context.template_exists?(projects_path, [], true) %>
                              <% partial_path = projects_path %>
                              <% partial_found = true %>
                            <% end %>
                          <% end %>
                          <% if partial_found %>
                            <%= render partial: partial_path, locals: { horiz_element: horiz_element } %>
                          <% else %>
                            <div class="<%= tw_class('card-body') %>">
                              <p class="<%= tw_class('text-muted') %>">Partial '<%= horiz_element['partial'] %>' not found</p>
                            </div>
                          <% end %>
                        <% rescue => e %>
                          <div class="<%= tw_class('card-body') %>">
                            <p class="<%= tw_class('text-danger') %>">Error rendering partial: <%= e.message %></p>
                          </div>
                        <% end %>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <%# Default layout if no layout specified %>
        <div class="space-y-4">
          <% if @h_el['card-params'] %>
            <div class="<%= tw_class('card') %>">
              <% if @h_el['card-params'][:card_header] %>
                <div class="<%= tw_class('card-header') %>">
                  <%= raw translate_bootstrap_in_html(@h_el['card-params'][:card_header]) %>
                </div>
              <% end %>
              <div class="<%= tw_class('card-body') %>">
                <%= raw translate_bootstrap_in_html(@h_el['card-params'][:card_body]) %>
              </div>
            </div>
          <% end %>
          
          <% if @h_el['card-results'] %>
            <div class="<%= tw_class('card') %>">
              <% if @h_el['card-results'][:card_header] %>
                <div class="<%= tw_class('card-header') %>">
                  <%= raw translate_bootstrap_in_html(@h_el['card-results'][:card_header]) %>
                </div>
              <% end %>
              <div class="<%= tw_class('card-body') %>">
                <%= raw translate_bootstrap_in_html(@h_el['card-results'][:card_body]) %>
              </div>
            </div>
          <% end %>
          
          <% if @h_el['card-downloads'] %>
            <div class="<%= tw_class('card') %>">
              <% if @h_el['card-downloads'][:card_header] %>
                <div class="<%= tw_class('card-header') %>">
                  <%= raw translate_bootstrap_in_html(@h_el['card-downloads'][:card_header]) %>
                </div>
              <% end %>
              <div class="<%= tw_class('card-body') %>">
                <%= raw translate_bootstrap_in_html(@h_el['card-downloads'][:card_body]) %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
    <%# End of std_view conditional - our improved sections are always shown above %>

    <!-- Additional Information (Admin only) -->
    <% if admin? %>
      <div class="pt-4 border-t border-gray-200 relative">
        <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3 flex items-center gap-2">
          <i class="fas fa-shield-alt text-gray-500"></i>
          Admin Information
        </h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="space-y-2">
            <div>
              <span class="text-xs font-medium text-gray-500 uppercase">Run ID</span>
              <p class="text-sm text-gray-900 font-mono mt-1"><%= @run.id %></p>
            </div>
            <div>
              <span class="text-xs font-medium text-gray-500 uppercase">Project ID</span>
              <p class="text-sm text-gray-900 font-mono mt-1"><%= @run.project_id %></p>
            </div>
            <div>
              <span class="text-xs font-medium text-gray-500 uppercase">Step ID</span>
              <p class="text-sm text-gray-900 font-mono mt-1"><%= @run.step_id %></p>
            </div>
            <div>
              <span class="text-xs font-medium text-gray-500 uppercase">Std Method ID</span>
              <p class="text-sm text-gray-900 font-mono mt-1"><%= @run.std_method_id || 'N/A' %></p>
            </div>
          </div>
          <div class="space-y-2">
            <div>
              <span class="text-xs font-medium text-gray-500 uppercase">Status ID</span>
              <p class="text-sm text-gray-900 font-mono mt-1"><%= @run.status_id %></p>
            </div>
            <% if @run.slurm_job_id %>
              <div>
                <span class="text-xs font-medium text-gray-500 uppercase">SLURM Job ID</span>
                <p class="text-sm text-gray-900 font-mono mt-1"><%= @run.slurm_job_id %></p>
              </div>
            <% end %>
            <% if @run.pid %>
              <div>
                <span class="text-xs font-medium text-gray-500 uppercase">PID</span>
                <p class="text-sm text-gray-900 font-mono mt-1"><%= @run.pid %></p>
              </div>
            <% end %>
            <div>
              <span class="text-xs font-medium text-gray-500 uppercase">Async</span>
              <p class="text-sm text-gray-900 mt-1"><%= @run.async ? 'Yes' : 'No' %></p>
            </div>
            <% if @run.max_ram %>
              <div>
                <span class="text-xs font-medium text-gray-500 uppercase">Max RAM</span>
                <p class="text-sm text-gray-900 mt-1"><%= display_mem(@run.max_ram * 1000) %></p>
              </div>
            <% end %>
            <% if @run.waiting_duration %>
              <div>
                <span class="text-xs font-medium text-gray-500 uppercase">Waiting Duration</span>
                <p class="text-sm text-gray-900 font-mono mt-1"><%= duration(@run.waiting_duration.to_i) %></p>
              </div>
            <% end %>
          </div>
        </div>
        <% if @run.command_json.present? %>
          <div class="mt-4 pt-4 border-t border-gray-200">
            <span class="text-xs font-medium text-gray-500 uppercase block mb-2">Command JSON</span>
            <pre class="bg-gray-50 border border-gray-200 rounded-md p-3 text-xs font-mono text-gray-700 overflow-x-auto"><%= JSON.pretty_generate(Basic.safe_parse_json(@run.command_json, {})) %></pre>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
