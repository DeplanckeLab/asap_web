      </div>
      <div style="display:flex; justify-content:flex-end; gap:8px; padding:12px 16px; border-top:1px solid #e5e7eb;">
        <button type="button" data-action="heatmap#closeSaveCheckpointDialog" class="<%= heatmap_btn %>">Cancel</button>
        <button type="button" data-action="heatmap#confirmSaveCheckpoint"
                class="inline-flex items-center justify-center px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-medium text-xs transition-colors cursor-pointer border border-blue-600 shadow-sm">
