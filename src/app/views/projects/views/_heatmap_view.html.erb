        <div id="heatmap-checkpoint-save-new-fields" style="display:flex; flex-direction:column; gap:6px; padding-left:24px;">
          <label for="heatmap-checkpoint-save-new-title" style="font-size:12px; color:#4b5563;">Name</label>
