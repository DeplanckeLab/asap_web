                      <%= raw authors.first + ((authors.size > 1) ? '<i> et al.</i> ' : '. ') + "<b>#{a.title}</b>" + " " + ((j = a.journal) ? "<i>#{j.name}</i>" : '') + ". " + a.year.to_s + "."  %>
                      <%= link_to raw("<span class='badge badge-info'><i class='fas fa-external-link-alt me-1'></i>DOI link</span>"), "https://doi.org/" + doi.to_s, {:class => 'ml-2', target: '_blank'} %>
                    </div>
                  <% end %>
                <% end %>
              </div>
            <% end %>

