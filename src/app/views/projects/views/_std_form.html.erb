<%# Standard Form View - Shows form when no runs exist and has_std_form is true %>
<div id="std_form_<%= @step.id %>" class="std-form">
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 flex flex-col mb-6">
    <div class="border-b border-gray-200 px-6 py-4 sticky top-0 z-10 flex-shrink-0" style="background: linear-gradient(to right, #eff6ff, #eef2ff); background-color: #ffffff;">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
          New <%= @step.label.presence || @step.name.humanize %>
        </h3>
      </div>
    </div>
    <div class="px-6 py-5 space-y-6 flex-1">
      <%= render partial: 'projects/views/form_req' %>
    </div>
  </div>
</div>



