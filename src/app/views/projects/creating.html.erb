<% content_for :title, "Creating project" %>

<div class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8" data-controller="project-creation" data-project-creation-project-id-value="<%= @project.id %>">
  <div class="text-center mb-8">
    <h1 class="text-3xl font-semibold text-gray-900 dark:text-white mb-2">Creating the project...</h1>
    <p class="text-gray-600 dark:text-gray-300">Please wait while we set up your project</p>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-8">
    <!-- Spinner -->
    <div class="flex justify-center mb-8">
      <div class="relative">
        <svg class="animate-spin h-16 w-16 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </div>
    </div>

    <!-- Progress Steps -->
    <div class="space-y-6">
      <!-- Step 1: Project Created -->
      <div class="flex items-start" data-project-creation-target="step1">
        <div class="flex-shrink-0">
          <div class="flex items-center justify-center h-10 w-10 rounded-full bg-green-500 text-white font-semibold" data-project-creation-target="step1Icon">
            <span class="text-lg">1</span>
          </div>
        </div>
        <div class="ml-4 flex-1">
          <h3 class="text-lg font-medium text-gray-900 dark:text-white">
            Project created with key <span class="font-mono text-blue-600 dark:text-blue-400" data-project-creation-target="projectKey"><%= @project.key %></span>
          </h3>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400" data-project-creation-target="step1Status">Completed</p>
        </div>
      </div>

      <!-- Step 2: Parsing Data -->
      <div class="flex items-start" data-project-creation-target="step2">
        <div class="flex-shrink-0">
          <div class="flex items-center justify-center h-10 w-10 rounded-full bg-gray-300 dark:bg-gray-600 text-gray-700 dark:text-gray-300 font-semibold" data-project-creation-target="step2Icon">
            <span class="text-lg">2</span>
          </div>
        </div>
        <div class="ml-4 flex-1">
          <h3 class="text-lg font-medium text-gray-900 dark:text-white">Parsing data</h3>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400" data-project-creation-target="step2Status">Waiting...</p>
          <div class="mt-2 hidden" data-project-creation-target="step2Spinner">
            <svg class="animate-spin h-5 w-5 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </div>
        </div>
      </div>

      <!-- Step 3: Copying Metadata -->
      <div class="flex items-start" data-project-creation-target="step3">
        <div class="flex-shrink-0">
          <div class="flex items-center justify-center h-10 w-10 rounded-full bg-gray-300 dark:bg-gray-600 text-gray-700 dark:text-gray-300 font-semibold" data-project-creation-target="step3Icon">
            <span class="text-lg">3</span>
          </div>
        </div>
        <div class="ml-4 flex-1">
          <h3 class="text-lg font-medium text-gray-900 dark:text-white">Copying metadata</h3>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400" data-project-creation-target="step3Status">Waiting...</p>
          <div class="mt-2 hidden" data-project-creation-target="step3Spinner">
            <svg class="animate-spin h-5 w-5 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .animate-spin {
    animation: spin 1s linear infinite;
  }
</style>



