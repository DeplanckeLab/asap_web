<%= form_with model: guided_tour, class: "space-y-6" do |form| %>
  <% if guided_tour.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <p class="font-semibold"><%= pluralize(guided_tour.errors.count, "error") %> prevented saving:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% guided_tour.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-4 md:grid-cols-3">
    <div class="md:col-span-2">
      <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :name, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900", placeholder: "Tour name" %>
    </div>

    <div>
      <%= form.label :duration_time, "Duration (seconds)", class: "block text-sm font-medium text-gray-700" %>
      <%= form.number_field :duration_time, min: 0, class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900", placeholder: "300" %>
    </div>
  </div>

  <div>
    <%= form.label :rank, class: "block text-sm font-medium text-gray-700" %>
    <%= form.number_field :rank, min: 1, class: "mt-1 block w-40 rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:ring-gray-900" %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit class: "inline-flex items-center rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-gray-800" %>
    <%= link_to "Cancel", guided_tours_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>
<% end %>
