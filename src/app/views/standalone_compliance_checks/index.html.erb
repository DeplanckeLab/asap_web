<% content_for :title, "Standalone scFAIR checks - ASAP" %>
<div class="max-w-6xl mx-auto py-10 px-4 sm:px-6 lg:px-8 space-y-6">
  <div>
    <h1 class="text-3xl font-semibold text-gray-900 dark:text-white">Standalone scFAIR checks</h1>
    <p class="mt-2 text-gray-600 dark:text-gray-300">
      History of file-check requests (results only; uploaded files are not retained in this log).
    </p>
  </div>

  <%= form_with url: standalone_compliance_checks_path, method: :get, local: true, class: "rounded-lg border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900" do %>
    <div class="flex flex-wrap items-end gap-3">
      <div>
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">Origin</label>
        <%= select_tag :origin,
                       options_for_select(
                         [
                           ["User only (guest + non-admin)", "user"],
                           ["Admin only", "admin"],
                           ["All results", "all"]
                         ],
                         @origin_filter
                       ),
                       class: "rounded-md border border-gray-300 bg-white px-3 py-2 text-sm dark:border-gray-700 dark:bg-gray-950 dark:text-gray-100",
                       onchange: "this.form.requestSubmit()" %>
      </div>
      <span class="text-xs text-gray-500 dark:text-gray-400 pb-2">
        <%= @user_count %> user · <%= @admin_count %> admin · <%= @all_count %> all
      </span>
    </div>
  <% end %>

  <p class="text-sm text-gray-600 dark:text-gray-300">
    <% if @total_count.zero? %>
      0 results
    <% else %>
      Showing <%= (@page - 1) * @per_page + 1 %>-<%= [@page * @per_page, @total_count].min %> of <%= @total_count %>
    <% end %>
    · <%= @passed_count %> passed
    · <%= @failed_status_count %> job failures
  </p>

  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
    <table class="min-w-full divide-y divide-gray-200 text-sm dark:divide-gray-800">
      <thead class="bg-gray-50 text-xs font-semibold uppercase tracking-wide text-gray-600 dark:bg-gray-950 dark:text-gray-400">
        <tr>
          <th scope="col" class="px-3 py-2 text-left">Date</th>
          <th scope="col" class="px-3 py-2 text-left">User</th>
          <th scope="col" class="px-3 py-2 text-left">Filename</th>
          <th scope="col" class="px-3 py-2 text-left">Format</th>
          <th scope="col" class="px-3 py-2 text-left">Schema</th>
          <th scope="col" class="px-3 py-2 text-left">Outcome</th>
          <th scope="col" class="px-3 py-2 text-left">Source URL</th>
          <th scope="col" class="px-3 py-2 text-right"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 text-gray-700 dark:divide-gray-800 dark:text-gray-200">
        <% @standalone_compliance_checks.each do |check| %>
          <tr>
            <td class="whitespace-nowrap px-3 py-2 text-xs text-gray-500 dark:text-gray-400">
              <%= display_timestamp(check, :checked_at) %>
            </td>
            <td class="whitespace-nowrap px-3 py-2" title="<%= standalone_compliance_check_user_title(check) %>">
              <%= standalone_compliance_check_user_label(check) %>
              <% if check.admin_run? %>
                <span class="ml-1 inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300">admin</span>
              <% end %>
            </td>
            <td class="px-3 py-2 max-w-xs truncate" title="<%= check.filename %>">
              <%= check.filename.presence || '—' %>
            </td>
            <td class="whitespace-nowrap px-3 py-2">
              <%= check.format.presence || '—' %>
            </td>
            <td class="whitespace-nowrap px-3 py-2 text-xs">
              <%= check.schema_id.presence || '—' %>
            </td>
            <td class="whitespace-nowrap px-3 py-2">
              <% if check.status == 'failed' %>
                <span class="inline-flex items-center rounded px-2 py-0.5 text-xs font-medium bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-200">
                  Job failed
                </span>
              <% elsif check.passed %>
                <span class="inline-flex items-center rounded px-2 py-0.5 text-xs font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-200">
                  Passed
                </span>
              <% else %>
                <span class="inline-flex items-center rounded px-2 py-0.5 text-xs font-medium bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200">
                  Issues found
                </span>
              <% end %>
            </td>
            <td class="px-3 py-2 max-w-xs truncate text-xs" title="<%= check.source_url %>">
              <% if check.source_url.present? %>
                <%= link_to check.source_url, check.source_url, target: '_blank', rel: 'noopener noreferrer', class: 'text-sky-700 hover:underline dark:text-sky-300' %>
              <% else %>
                <span class="text-gray-400">Upload</span>
              <% end %>
            </td>
            <td class="whitespace-nowrap px-3 py-2 text-right">
              <%= link_to 'Details', standalone_compliance_check_path(check), class: 'text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @total_count.zero? %>
    <div class="rounded-lg border border-dashed border-gray-300 bg-white px-6 py-10 text-center text-gray-500 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-400">
      No standalone compliance checks match this filter.
    </div>
  <% elsif @total_count > @per_page %>
    <% total_pages = (@total_count.to_f / @per_page).ceil %>
    <% pagination_params = { origin: @origin_filter } %>
    <div class="flex items-center justify-between text-sm text-gray-600 dark:text-gray-400">
      <div>
        Page <%= @page %> of <%= total_pages %>
      </div>
      <div class="flex gap-2">
        <% if @page > 1 %>
          <%= link_to "Previous",
                      standalone_compliance_checks_path(pagination_params.merge(page: @page - 1)),
                      class: "rounded-md border border-gray-300 px-3 py-1 hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800" %>
        <% end %>
        <% if @page < total_pages %>
          <%= link_to "Next",
                      standalone_compliance_checks_path(pagination_params.merge(page: @page + 1)),
                      class: "rounded-md border border-gray-300 px-3 py-1 hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
