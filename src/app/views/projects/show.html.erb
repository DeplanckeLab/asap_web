<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @project.display_name %> - ASAP</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="bg-gray-50">
  <!-- Top Bar -->
  <div class="bg-black shadow-sm border-b border-gray-200">
    <div class="px-4 sm:px-6 lg:px-8 w-full">
      <div class="flex items-center justify-between h-16">
        <!-- Left side: Logo and Project Info -->
        <div class="flex items-center space-x-6">
          <!-- ASAP Logo -->
          <div class="flex-shrink-0">
            <%= link_to projects_path,
                  class: "inline-block rounded focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-gray-400" do %>
              <%= image_tag "ASAP_sansTagline_White.svg", 
                  class: 'h-8 w-32 object-contain', 
                  alt: 'ASAP Logo' %>
            <% end %>
          </div>
          
          <!-- Project Info -->
        <% version_label = @project.version_id.presence || '2.0.0' %>
        <% owner_user = @project.user %>
        <% organism = @project.organism %>
        <% owned_by_current_user = user_signed_in? && owner_user&.id == current_user.id %>
        <% share_record = user_signed_in? && !owned_by_current_user ? @project.shares.find_by(user_id: current_user.id) : nil %>
        <% owner_email = owner_user&.email.to_s
           owner_email_part = owner_email.split('@').first if owner_email.present?
           project_status_label =
            if owned_by_current_user
              'Owned by me'
            elsif share_record.present?
              "Shared by #{owner_email_part || 'unknown'}"
            elsif @project.public? && owner_user
              "Owned by #{owner_email_part || 'unknown'}"
            else
              'Read only access'
            end %>
        <% rights_summary = {
             'Edit' => editable?(@project),
             'Clone' => clonable?(@project),
             'Export' => exportable?(@project)
           } %>
        <% account_status = if user_signed_in?
                              email = current_user.email.to_s
                              email_part = email.split('@').first
                              "Logged in as #{current_user.displayed_name.presence || email_part}"
                            else
                              'GUEST'
                            end %>
        <div class="flex items-center space-x-4">
            <div>
            <h1 class="text-base sm:text-lg font-semibold text-white flex items-center gap-2">
              <span class="truncate max-w-[14rem] sm:max-w-sm lg:max-w-md" title="<%= @project.display_name %>"><%= @project.display_name %></span>
              <span class="inline-flex items-center px-2 py-0.5 text-xs font-semibold tracking-wide uppercase text-gray-100 bg-gray-700 rounded-full border border-gray-600">
                v<%= version_label %>
              </span>
              <% if @project.public? %>
                <span class="inline-flex items-center px-2 py-0.5 text-xs font-semibold tracking-wide uppercase text-emerald-200 bg-emerald-600/30 rounded-full border border-emerald-400/40">
                  Public
                </span>
              <% end %>
            </h1>
              <div class="flex items-center space-x-4 text-sm text-gray-300">
                <span><i class="fas fa-circle text-gray-400 mr-1"></i><%= number_with_delimiter(@project.cell_count) %> cells</span>
                <span><i class="fas fa-dna text-gray-400 mr-1"></i><%= formatted_organism_name(@project) %></span>
              </div>
            </div>
            <div class="hidden lg:flex items-stretch space-x-6 border-l border-gray-700 pl-6 text-sm text-gray-300">
              <div class="flex flex-col justify-center">
                <span class="text-xs text-gray-300"><%= project_status_label %></span>
                <div class="flex items-center gap-3 mt-1">
                  <% icon_map = {
                    'Edit' => 'fa-edit',
                    'Clone' => 'fa-clone',
                    'Export' => 'fa-download'
                  } %>
                  <% rights_summary.each do |label, allowed| %>
                    <i class="fas <%= icon_map[label] %> text-base <%= allowed ? 'text-emerald-300' : 'text-gray-400' %>" 
                       title="<%= label %>: <%= allowed ? 'Allowed' : 'Not allowed' %>"></i>
                  <% end %>
                </div>
              </div>
              <div class="w-px h-10 bg-gray-700 self-center"></div>
              <div class="flex flex-col justify-center">
                <span class="text-xs text-gray-300"><%= account_status %></span>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Center: ASAP Version -->
        <div class="flex-1 flex justify-center">
          <!--<span class="text-sm text-gray-300">ASAP v<%= @project.version_id || '2.0.0' %></span>-->
        </div>
        
        <!-- Right side: Navigation Icons -->
        <div class="flex items-center space-x-2">
          <!-- Summary Icon -->
          <%= link_to project_path(@project, view: 'summary'), 
              class: "p-2 rounded-lg #{@view_type == 'summary' ? 'bg-gray-700 text-white' : 'text-gray-300 hover:bg-gray-700'}" do %>
            <i class="fas fa-info-circle text-lg"></i>
          <% end %>
          
          <!-- Visualization Icon (default selected) -->
          <%= link_to project_path(@project, view: 'visualization'), 
              class: "p-2 rounded-lg #{@view_type == 'visualization' ? 'bg-gray-700 text-white' : 'text-gray-300 hover:bg-gray-700'}" do %>
            <i class="fas fa-chart-line text-lg"></i>
          <% end %>
          
          <!-- Analysis Icon -->
          <%= link_to project_path(@project, view: 'analysis'), 
              class: "p-2 rounded-lg #{@view_type == 'analysis' ? 'bg-gray-700 text-white' : 'text-gray-300 hover:bg-gray-700'}" do %>
            <i class="fas fa-microscope text-lg"></i>
          <% end %>
          
          <!-- Data Icon -->
          <%= link_to project_path(@project, view: 'data'), 
              class: "p-2 rounded-lg #{@view_type == 'data' ? 'bg-gray-700 text-white' : 'text-gray-300 hover:bg-gray-700'}" do %>
            <i class="fas fa-database text-lg"></i>
          <% end %>
          
          <!-- Settings Icon -->
          <%= link_to project_path(@project, view: 'settings'), 
              class: "p-2 rounded-lg #{@view_type == 'settings' ? 'bg-gray-700 text-white' : 'text-gray-300 hover:bg-gray-700'}" do %>
            <i class="fas fa-cog text-lg"></i>
          <% end %>
          
          <!-- Info Dropdown -->
          <div class="relative ml-4"
               id="info-nav-dropdown"
               data-controller="nav-dropdown">
            <button type="button"
                    class="p-2 rounded-lg text-gray-300 hover:bg-gray-700 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-gray-600 transition flex items-center gap-2"
                    title="Open access resources"
                    data-nav-dropdown-toggle>
              <i class="fas fa-info-circle text-lg"></i>
              <span class="hidden sm:inline text-sm">Info</span>
              <i class="fas fa-chevron-down text-xs"></i>
            </button>
            <%= render "shared/info_menu",
                        wrapper_classes: "hidden absolute right-0 mt-2 min-w-56 bg-white text-gray-800 rounded-lg shadow-lg border border-gray-200 z-50",
                        data_attributes: { nav_menu: true } %>
          </div>
          
        <% if admin? %>
          <div class="relative ml-4"
               id="admin-tools-dropdown"
               data-controller="nav-dropdown">
            <button id="admin-tools-button"
                    class="p-2 rounded-lg text-gray-300 hover:bg-gray-700 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-gray-600 transition flex items-center gap-2"
                    title="Admin tools"
                    data-nav-dropdown-toggle>
                <i class="fas fa-tools text-lg"></i>
                <span class="hidden sm:inline text-sm">Admin</span>
                <i class="fas fa-chevron-down text-xs"></i>
              </button>
            <%= render "shared/admin_menu",
                        wrapper_classes: "hidden absolute right-0 mt-2 w-56 bg-white text-gray-800 rounded-lg shadow-lg border border-gray-200 z-50",
                        data_attributes: { nav_menu: true } %>
          </div>
          <% end %>
          
          <!-- Back to Projects -->
          <%= link_to projects_path, 
              class: "ml-4 p-2 rounded-lg text-gray-300 hover:bg-gray-700" do %>
            <i class="fas fa-arrow-left text-lg"></i>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Content Area -->
  <div>
    <% case @view_type %>
    <% when 'summary' %>
      <%# render 'projects/views/summary_test' %>
    <% when 'visualization' %>
      <%= render 'projects/views/visualization' %>
    <% when 'analysis' %>
      <%= render 'projects/views/analysis' %>
    <% when 'data' %>
      <%= render 'projects/views/data' %>
    <% when 'settings' %>
      <%= render 'projects/views/settings' %>
    <% else %>
      <%= render 'projects/views/visualization' %>
    <% end %>
  </div>
  
  <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
</body>
</html>