<% content_for :title, "Atlases" %>
<% content_for :meta_description, "Explore curated references for Fly Cell Atlas and Human Cell Atlas and browse matching public projects in ASAP." %>

<div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="max-w-4xl">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100">Atlases</h1>
    <p class="mt-2 text-sm sm:text-base text-gray-600 dark:text-gray-400">
      Explore curated references related to major atlas initiatives and jump directly to matching public projects in ASAP.
    </p>
  </div>

  <div class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-6">
    <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-900">
      <div class="flex items-center gap-3">
        <%= image_tag "fca_logo.png",
                      alt: "Fly Cell Atlas logo",
                      class: "h-12 w-12 object-contain shrink-0" %>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100">Fly Cell Atlas (FCA)</h2>
      </div>
      <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
        Reference projects and annotations derived from the Fly Cell Atlas initiative.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <%= link_to atlas_projects_path(atlas: "fca"),
                    class: "#{tw_btn(:primary)}" do %>
          Browse FCA projects
        <% end %>
        <%= link_to "https://flycellatlas.org",
                    target: "_blank",
                    rel: "noopener noreferrer",
                    class: "#{tw_btn(:light)}" do %>
          Visit FCA website
        <% end %>
      </div>
    </section>

    <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-900">
      <div class="flex items-center gap-3">
        <%= image_tag "hca_logo.jpg",
                      alt: "Human Cell Atlas logo",
                      class: "h-12 w-auto max-w-[12rem] object-contain shrink-0" %>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100">Human Cell Atlas (HCA)</h2>
      </div>
      <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
        Reference projects and annotations linked to Human Cell Atlas resources.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <%= link_to atlas_projects_path(atlas: "hca"),
                    class: "#{tw_btn(:primary)}" do %>
          Browse HCA projects
        <% end %>
        <%= link_to "https://www.humancellatlas.org",
                    target: "_blank",
                    rel: "noopener noreferrer",
                    class: "#{tw_btn(:light)}" do %>
          Visit HCA website
        <% end %>
      </div>
    </section>
  </div>
</div>
