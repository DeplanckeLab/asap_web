<% if @step %>
  <% show_form_requested = params[:show_form].to_s == '1' %>
  <% single_run_status_run = if !@step.multiple_runs
       @run || @current_run || (@runs.respond_to?(:first) ? @runs.first : nil)
     end %>
  <% single_run_status_id = single_run_status_run&.status_id.to_i if single_run_status_run %>
  <% show_single_run_intermediate = @step.name != 'parsing' && single_run_status_run && [1, 2, 6].include?(single_run_status_id) %>
  <% show_single_run_failed_summary = @step.name != 'parsing' && single_run_status_run && single_run_status_id == 4 && !show_form_requested %>
  <%# If show_form or show_custom_form is true, always use std_step (which handles the form display) %>
  <%# Otherwise, check for step-specific partial %>
  <% if show_single_run_intermediate %>
    <%= render partial: 'projects/views/single_run_intermediate_status', locals: { run: single_run_status_run } %>
    <%= render partial: 'projects/views/run_metadata', locals: { run: single_run_status_run, results: @h_res, queue_position: @queue_position } %>
  <% elsif show_single_run_failed_summary %>
    <%= render partial: 'projects/views/single_run_failed_summary', locals: { run: single_run_status_run } %>
  <% elsif !@step.multiple_runs && !@step.has_std_view && single_run_status_run %>
    <% specific_view_partial = "projects/views/#{@step.name}_view" %>
    <% if lookup_context.template_exists?(specific_view_partial, [], true) %>
      <%= render partial: specific_view_partial %>
    <% else %>
      <%= render 'projects/views/std_step' %>
    <% end %>
  <% elsif @show_form || @show_custom_form %>
    <%= render 'projects/views/std_step' %>
  <% else %>
    <% if @show_specific_view %>
      <% specific_view_partial = "projects/views/#{@step.name}_view" %>
      <% if lookup_context.template_exists?(specific_view_partial, [], true) %>
        <%= render partial: specific_view_partial %>
      <% else %>
        <%= render 'projects/views/std_step' %>
      <% end %>
    <% else %>
    <%# Check if there's a step-specific partial first %>
    <% step_partial_path = "projects/views/#{@step.name}" %>
    <% partial_exists = lookup_context.template_exists?(step_partial_path, [], true) %>
    <% if partial_exists %>
      <%# Render step-specific partial if it exists %>
      <%= render partial: step_partial_path %>
    <% else %>
      <%# Otherwise render the standard step view %>
      <%= render 'projects/views/std_step' %>
    <% end %>
    <% end %>
  <% end %>
<% else %>
  <div class="alert alert-warning">
    <i class="fas fa-exclamation-triangle me-2"></i>Step not found.
  </div>
<% end %>

