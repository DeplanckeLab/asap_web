<%# Standard Dashboard View - Shows multiple runs %>
<div id="std_dashboard_<%= @step.id %>" class="std-dashboard">
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 flex flex-col">
    <div class="border-b border-gray-200 px-6 py-4 sticky top-0 z-10 flex-shrink-0" style="background: linear-gradient(to right, #eff6ff, #eef2ff); background-color: #ffffff;">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
          <%= @step.name.humanize %> results
        </h3>
        <div class="flex items-center gap-3">
          <% if @step.has_std_form %>
            <button type="button" 
                    class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-medium transition-colors cursor-pointer" 
                    onclick="loadFormInRightPanel('<%= step_results_project_path(@project, step_id: @step.id, show_form: 1, format: :html) %>')"
                    style="flex-shrink: 0;">
              + New run
            </button>
          <% end %>
          <!-- Delete All Button -->
          <% if editable?(@project) && @runs && @runs.any? %>
            <%= button_to delete_all_runs_from_step_project_path(@project, step_id: @step.id), 
                method: :post,
                form: {
                  data: {
                    controller: 'delete-all-runs',
                    action: 'submit->delete-all-runs#deleteAllRuns',
                    'delete-all-runs-step-id-value': @step.id,
                    'delete-all-runs-project-id-value': @project.id
                  }
                },
                class: 'px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-md font-medium transition-colors cursor-pointer',
                style: 'flex-shrink: 0;',
                data: { 
                  confirm: "Are you sure you want to delete all runs from this step? This will delete all subsequent analyses down the pipeline. This action cannot be undone."
                } do %>
              Delete all
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
    <div class="px-6 py-5 space-y-6 flex-1">
      <div class="mb-3">
        <div class="alert alert-info flex items-start gap-3">
          <i class="fas fa-info-circle text-blue-600 mt-0.5"></i>
          <div>
            <strong>Display Mode:</strong> Standard Dashboard (multiple_runs: <%= @step.multiple_runs %>, has_std_dashboard: <%= @step.has_std_dashboard %>, runs: <%= @runs ? @runs.size : 0 %>)
          </div>
        </div>
      </div>
      <% if @runs && @runs.any? %>
        <div class="border-b border-gray-200 pb-4">
          <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3 flex items-center gap-2">
            Runs
          </h4>
          <div class="text-sm text-gray-600">
            <%= @runs.size %> run<%= (@runs.size > 1) ? 's' : '' %> found.
          </div>
        </div>
        
        <% if @h_cards && @h_cards[:run_cards] && @h_cards[:run_cards].any? %>
          <div class="space-y-4">
            <%= render partial: 'projects/views/display_card_deck', locals: { cards: @h_cards[:run_cards], card_type: 'run' } %>
          </div>
        <% else %>
          <div class="alert alert-warning flex items-start gap-3">
            <i class="fas fa-exclamation-triangle text-yellow-600 mt-0.5"></i>
            <span>No run cards available.</span>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-8">
          <i class="fas fa-inbox text-gray-400 text-4xl mb-3"></i>
          <p class="text-gray-600">No runs found for this step.</p>
        </div>
      <% end %>
      
      <%# Debug info section (hidden by default, can be toggled if needed) %>
      <div class="border-t border-gray-200 pt-4 mt-6">
        <div class="bg-gray-50 rounded-lg p-3">
          <div class="text-xs text-gray-600">
            <strong>Display Mode:</strong> Standard Dashboard | 
            <strong>Config:</strong> multiple_runs=<%= @step.multiple_runs %>, has_std_dashboard=<%= @step.has_std_dashboard %> | 
            <strong>Runs:</strong> <%= @runs ? @runs.size : 0 %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

