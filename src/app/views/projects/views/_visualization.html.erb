function defaultAnnotTypeId() {
  var types = _annotOntologyTermTypes || []
  if (types.length === 0) return ''
  var cellType = types.find(function(t) { return String(t.name) === 'cell_type' })
  return String((cellType || types[0]).id)
}

function selectedAnnotTypeEntry() {
  var selectedId = String((_annotPopupData.newForm && _annotPopupData.newForm.annotationTypeId) || '')
  return (_annotOntologyTermTypes || []).find(function(t) { return String(t.id) === selectedId }) || null
}

function selectedAnnotTypeAllowsMultipleOntologyTerms() {
  var entry = selectedAnnotTypeEntry()
  return !!(entry && entry.multiValue)
}

function selectedAnnotTypePrefixesCsv() {
  var entry = selectedAnnotTypeEntry()
  if (!entry || !Array.isArray(entry.prefixes)) return ''
  var prefixes = entry.prefixes.filter(function(p) { return String(p || '').trim().length > 0 })
  return prefixes.join(',')
}

function escapeHtml(value) {
  return String(value || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;')
}

function escapeAttr(value) {
  return String(value || '')
    .replace(/&/g, '&amp;')
    .replace(/"/g, '&quot;')
    .replace(/</g, '&lt;')
}

function templateHtml(templateId) {
  var tpl = document.getElementById(templateId)
  return tpl ? tpl.innerHTML : ''
}

// Same bookmark as category rows (fa-bookmark, green when this category has annotations).
function annotationCategoryLeadingIconMarkup(hasAnnotations) {
  var has = !!hasAnnotations
  var color = has ? '#16a34a' : '#d1d5db'
  var tip = has ? 'View annotations' : 'No annotations yet'
  return '<span style="display:inline-flex;align-items:center;justify-content:center;margin-right:8px;flex-shrink:0;" title="' + escapeAttr(tip) + '" aria-label="' + escapeAttr(tip) + '">' +
    '<i class="fas fa-bookmark" style="font-size:11px;color:' + color + ';"></i></span>'
}

function effectiveAnnotTitleHasAnnotations() {
  if (_annotPopupData.uiReady) {
    return (_annotPopupData.clas && _annotPopupData.clas.length > 0)
  }
  if (_annotPopupData.titleAnnotHint === true || _annotPopupData.titleAnnotHint === false) {
    return _annotPopupData.titleAnnotHint
  }
  return false
}

// Leading icon for Identify markers tab (FindMarkers / Slurm state).
function markersStateLeadingIconMarkup(state, loading, slurmQueueHover) {
  var st = loading ? 'loading' : (state || 'idle').toString()
  var wrapStart = '<span style="display:inline-flex;align-items:center;justify-content:center;margin-right:8px;flex-shrink:0;" aria-hidden="true">'
  var wrapEnd = '</span>'
  if (st === 'completed') {
    return wrapStart + '<i class="fas fa-check-circle" style="color:#16a34a;font-size:13px;"></i>' + wrapEnd
  }
  if (st === 'queued') {
    var tip = (slurmQueueHover && String(slurmQueueHover).trim() !== '') ? String(slurmQueueHover) : markersStatusTooltip('queued')
    return '<span data-slurm-queue-waiting-icon="true" title="' + escapeAttr(tip) + '" aria-label="' + escapeAttr(tip) + '" class="cursor-help" style="display:inline-flex;align-items:center;justify-content:center;margin-right:8px;flex-shrink:0;">' +
      '<i class="fas fa-hourglass-half" style="color:#2563eb;font-size:13px;" aria-hidden="true"></i></span>'
  }
  if (st === 'running' || st === 'loading') {
    return wrapStart + '<span style="position:relative;width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center;">' +
      '<i class="fas fa-circle-notch fa-spin" style="position:absolute;color:#9ca3af;font-size:15px;"></i>' +
      '<i class="fas fa-check" style="position:relative;color:#d1d5db;font-size:8px;"></i>' +
      '</span>' + wrapEnd
  }
  if (st === 'stopped') {
    return wrapStart + '<i class="fas fa-stop-circle" style="color:#6b7280;font-size:13px;"></i>' + wrapEnd
  }
  if (st === 'failed' || st === 'error') {
    return wrapStart + '<i class="fas fa-times-circle" style="color:#dc2626;font-size:13px;"></i>' + wrapEnd
  }
  if (st === 'unsupported' || st === 'analyze_forbidden') {
    return wrapStart + '<i class="fas fa-minus-circle" style="color:#9ca3af;font-size:13px;"></i>' + wrapEnd
  }
  return wrapStart + '<i class="fas fa-check-circle" style="color:#d1d5db;font-size:13px;"></i>' + wrapEnd
}

function safeHexCategoryColorForTitle(cssColor) {
  var s = String(cssColor || '').trim()
  if (/^#[0-9A-Fa-f]{6}$/.test(s) || /^#[0-9A-Fa-f]{3}$/.test(s)) return s
  return ''
}

function annotPopupCategoryColorDotMarkup(hex) {
  var c = safeHexCategoryColorForTitle(hex)
  if (!c) return ''
  return '<span style="display:inline-flex;align-items:center;justify-content:center;margin-right:8px;flex-shrink:0;" title="' + escapeAttr('Category color') + '" aria-hidden="true">' +
    '<span style="width:10px;height:10px;border-radius:9999px;background-color:' + c + ';border:1px solid rgba(15,23,42,0.15);"></span></span>'
}

function buildAnnotPopupTitleHtml(catName, metadataName, hasAnnotations, categoryColor) {
  var prefix = annotationCategoryLeadingIconMarkup(hasAnnotations)
  var colorDot = annotPopupCategoryColorDotMarkup(categoryColor)
  var sep = '<span style="color:#64748b;font-weight:500;display:inline-block;padding:0 0.45em;flex-shrink:0;">/</span>'
  var metaTrim = (metadataName != null && String(metadataName).trim() !== '') ? String(metadataName).trim() : ''
  var catStr = String(catName || '')

  function textTwoPart(left, right) {
    return '<span style="display:inline-flex;align-items:baseline;flex-wrap:wrap;min-width:0;max-width:100%;">' +
      '<span style="min-width:0;word-break:break-word;">' + escapeHtml(left) + '</span>' +
      sep +
      '<span style="min-width:0;word-break:break-word;">' + escapeHtml(right) + '</span>' +
      '</span>'
  }

  var textHtml
  if (metaTrim) {
    textHtml = textTwoPart(metaTrim, catStr)
  } else {
    var slashIdx = catStr.indexOf('/')
    if (slashIdx > 0 && slashIdx < catStr.length - 1) {
      var left = catStr.slice(0, slashIdx).trim()
      var right = catStr.slice(slashIdx + 1).trim()
      textHtml = (left !== '' && right !== '') ? textTwoPart(left, right) : ('<span style="min-width:0;word-break:break-word;max-width:100%;">' + escapeHtml(catStr) + '</span>')
    } else {
      textHtml = '<span style="min-width:0;word-break:break-word;max-width:100%;">' + escapeHtml(catStr) + '</span>'
    }
  }
  return '<span style="display:flex;align-items:center;flex-wrap:wrap;min-width:0;max-width:100%;">' + prefix + colorDot + textHtml + '</span>'
}

function refreshAnnotPopupTitle() {
  var titleEl = document.getElementById('annot-popup-title')
  if (!titleEl || _annotPopupData.metadataId == null) return
  titleEl.innerHTML = buildAnnotPopupTitleHtml(_annotPopupData.catName, _annotPopupData.metadataName, effectiveAnnotTitleHasAnnotations(), _annotPopupData.categoryColor || '')
}
window.refreshAnnotPopupTitle = refreshAnnotPopupTitle

function markersStatusTooltip(state) {
  var s = (state || 'idle').toString()
  if (s === 'completed') return 'Markers computed for this metadata'
  if (s === 'queued') return 'FindMarkers is queued on the cluster for this metadata'
  if (s === 'running') return 'FindMarkers is running for this metadata'
  if (s === 'loading') return 'Checking FindMarkers status for this metadata'
  if (s === 'stopped') return 'FindMarkers was stopped for this metadata'
  if (s === 'failed' || s === 'error') return 'Markers computation failed for this metadata'
  if (s === 'unsupported') return 'Markers are not available for this metadata'
  if (s === 'analyze_forbidden') return 'FindMarkers requires analyze permission on this project'
  return 'Markers not yet computed for this metadata'
}

function applyMarkersStatusToElement(el, state, slurmQueueHoverOverride) {
  if (!el) return
  var s = (state || 'idle').toString()
  var iconClass = 'fas fa-circle'
  var color = '#d1d5db'
  var size = '11px'
  if (s === 'completed') {
    iconClass = 'fas fa-check-circle'
    color = '#16a34a'
  } else if (s === 'queued') {
    iconClass = 'fas fa-hourglass-half'
    color = '#2563eb'
  } else if (s === 'running' || s === 'loading') {
    iconClass = 'fas fa-spinner fa-spin'
    color = '#2563eb'
  } else if (s === 'stopped') {
    iconClass = 'fas fa-stop-circle'
    color = '#6b7280'
  } else if (s === 'failed' || s === 'error') {
    iconClass = 'fas fa-times-circle'
    color = '#dc2626'
  } else if (s === 'unsupported' || s === 'analyze_forbidden') {
    iconClass = 'fas fa-minus-circle'
    color = '#9ca3af'
  } else {
    iconClass = 'fas fa-check-circle'
    size = '13px'
    color = '#d1d5db'
  }
  var mid = el.dataset ? el.dataset.metadataId : null
  var store = window._annotSlurmQueueHover || {}
  var tip = markersStatusTooltip(s)
  if (s === 'queued') {
    tip = (slurmQueueHoverOverride != null && String(slurmQueueHoverOverride).trim() !== '') ? String(slurmQueueHoverOverride) : (mid != null && store[String(mid)] ? store[String(mid)] : tip)
    el.setAttribute('data-slurm-queue-waiting-icon', 'true')
    el.classList.add('cursor-help')
  } else {
    el.removeAttribute('data-slurm-queue-waiting-icon')
    el.classList.remove('cursor-help')
  }
  el.innerHTML = '<i class="' + iconClass + '" style="font-size:' + size + ';color:' + color + ';" aria-hidden="true"></i>'
  el.setAttribute('title', tip)
  el.setAttribute('aria-label', tip)
  el.dataset.markersState = s
}

function updateMarkersStatusInMetadataPanel(metadataId, catIdx, state, slurmQueueHover) {
  var el = document.querySelector('.metadata-markers-status[data-metadata-id="' + String(metadataId) + '"]')
  applyMarkersStatusToElement(el, state, slurmQueueHover)
}

function syncMarkersStatusFromResponse(metadataId, catIdx, data) {
  var state = 'idle'
  if (!data) {
    state = 'error'
  } else if (data.error && !data.state) {
    state = 'error'
  } else {
    state = (data.state || 'idle').toString()
  }
  window._annotMarkersStatus = window._annotMarkersStatus || {}
  window._annotMarkersStatus[String(metadataId)] = state
  window._annotSlurmQueueHover = window._annotSlurmQueueHover || {}
  var hoverForRow = null
  if (state === 'queued' && data && data.slurm_queue_hover != null && String(data.slurm_queue_hover).trim() !== '') {
    window._annotSlurmQueueHover[String(metadataId)] = data.slurm_queue_hover
    hoverForRow = data.slurm_queue_hover
  } else if (state !== 'queued') {
    delete window._annotSlurmQueueHover[String(metadataId)]
