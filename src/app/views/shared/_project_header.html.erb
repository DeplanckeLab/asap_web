<!-- Top Bar -->
<%
  show_compliance_nav_hint =
    @project.from_scfair_validation? &&
    editable?(@project) &&
    @project.compliance_schemas.any? &&
    !@project.compliance_validation_run?
  compliance_hint_parsing_complete = false
  if show_compliance_nav_hint
    asap_docker_image = Basic.get_asap_docker(@project.version)
    hint_parsing_step =
      if asap_docker_image
        Step.where(docker_image_id: asap_docker_image.id, name: 'parsing').first
      else
        Step.where(name: 'parsing').order(:id).last
      end
    hint_project_step =
      hint_parsing_step && ProjectStep.find_by(project_id: @project.id, step_id: hint_parsing_step.id)
    compliance_hint_parsing_complete = hint_project_step.present? && hint_project_step.status_id.to_i == 3
  end
%>
<div id="project-page-header"
     class="bg-black shadow-sm border-b border-gray-200 sticky top-0 z-[80] overflow-visible"
     <% if show_compliance_nav_hint %>
       data-controller="compliance-nav-hint"
       data-compliance-nav-hint-active-value="true"
       data-compliance-nav-hint-project-id-value="<%= @project.id %>"
       data-compliance-nav-hint-parsing-complete-value="<%= compliance_hint_parsing_complete %>"
       data-compliance-nav-hint-icon-url-value="<%= asset_path('scfair.svg') %>"
     <% end %>>
  <div class="px-4 sm:px-6 lg:px-8 w-full overflow-visible">
    <div class="flex items-center justify-between h-16 overflow-visible">
      <!-- Left side: Logo and Project Info -->
      <div class="flex items-center space-x-6 overflow-visible">
        <!-- ASAP Logo: mark+SIB on mobile, full wordmark on desktop -->
        <div class="flex-shrink-0">
          <%= link_to projects_browse_url,
                class: "inline-block rounded focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-gray-400" do %>
            <%= image_tag "ASAP_logoOnly_White.svg",
                class: 'h-8 w-auto object-contain lg:hidden',
                alt: 'ASAP Logo' %>
            <%= image_tag "ASAP_sansTagline_White.svg",
                class: 'hidden lg:block h-8 w-32 object-contain',
                alt: 'ASAP Logo' %>
          <% end %>
        </div>
        
        <!-- Project Info -->
        <% version_label = @project.version_id.presence || '2.0.0' %>
        <% owner_user = @project.user %>
        <% organism = @project.organism %>
        <% owned_by_current_user = user_signed_in? && owner_user&.id == current_user.id %>
        <% owned_by_sandbox_session = !user_signed_in? && @project.sandbox? && session[:sandbox] == @project.key %>
        <% owned_by_me = owned_by_current_user || owned_by_sandbox_session %>
        <% share_record = user_signed_in? && !owned_by_me ? @project.shares.find_by(user_id: current_user.id) : nil %>
        <% owner_email = owner_user&.email.to_s
           owner_email_part = owner_email.split('@').first if owner_email.present?
           project_status_label =
            if owned_by_me
              'Owned by me'
            elsif share_record.present?
              "Shared by #{owner_email_part || 'unknown'}"
            elsif @project.public? && owner_user
              "Owned by #{owner_email_part || 'unknown'}"
            elsif admin?
              'Admin access'
            else
              'Read only access'
            end %>
        <% rights_summary = {
             'Analyze' => analyzable?(@project),
             'Annotate/Comment' => annotable?(@project),
             'Clone' => clonable?(@project),
             'Edit' => editable?(@project)
           } %>
        <%# Match projects#show: any embedding coordinates in @all_embeddings_by_loom (not only Annot nber_rows==2). %>
        <% has_visualization_embeddings = if defined?(@all_embeddings_by_loom) && @all_embeddings_by_loom.is_a?(Hash)
              @all_embeddings_by_loom.any? { |_filepath, embeddings| embeddings.present? }
            else
              Annot.where(project_id: @project.id, nber_rows: 2).exists?
            end %>
        <%
          # Get run counts from project_steps (more efficient than counting runs)
          run_counts = project_run_counts(@project)
          visible_step_ids = visible_step_ids_for_run_counts
          
          # Only load actual runs for statuses that have runs (for dropdown lists).
          # The failed bucket aggregates both failed and stopped runs (see
          # run_summary_tooltip_label / project_run_counts) so the icon shows
          # a consolidated list.
          runs_by_status = {}
          h_status_ids = Status.where(name: %w[pending running success failed stopped]).pluck(:name, :id).to_h.symbolize_keys
          status_id_scopes = {
            pending: [h_status_ids[:pending]].compact,
            running: [h_status_ids[:running]].compact,
            success: [h_status_ids[:success]].compact,
            failed: [h_status_ids[:failed], h_status_ids[:stopped]].compact
          }
          [:pending, :running, :success, :failed].each do |key|
            scope_ids = status_id_scopes[key]
            if run_counts[key] > 0 && scope_ids.any?
              scope = @project.runs.includes(:step, :std_method).where(status_id: scope_ids, step_id: visible_step_ids)
              scope = scope.where('runs.created_at < ?', @project.public_at) if publication_snapshot_reader?(@project)
              runs_by_status[key] = scope.order(created_at: :desc)
            else
              runs_by_status[key] = []
            end
          end

          # Pre-load data for dataset parameter display
          # Collect all run_ids and annot_ids from attrs_json of all runs
          all_runs = runs_by_status.values.flatten
          header_annot_ids = []
          header_run_ids = []
          all_runs.each do |run|
            next unless run.attrs_json.present?
            h_attrs = Basic.safe_parse_json(run.attrs_json, {})
            h_attrs.each_value do |v|
              if v.is_a?(Hash)
                header_annot_ids << v['annot_id'] if v['annot_id']
                header_run_ids << v['run_id'] if v['run_id']
              elsif v.is_a?(Array)
                v.each do |item|
                  if item.is_a?(Hash)
                    header_annot_ids << item['annot_id'] if item['annot_id']
                    header_run_ids << item['run_id'] if item['run_id']
                  end
                end
              end
            end
          end
          
          # Load annots and their origin runs
          header_h_annots = {}
          header_h_ori_runs = {}
          header_h_steps = {}
          if header_annot_ids.any?
            Annot.where(id: header_annot_ids.uniq).each do |a|
              header_h_annots[a.id] = a
              header_run_ids << a.ori_run_id if a.ori_run_id
            end
          end
          if header_run_ids.any?
            Run.includes(:step).where(id: header_run_ids.uniq).each do |r|
              header_h_ori_runs[r.id] = r
              header_h_steps[r.step_id] = r.step if r.step
            end
          end
          
          # Get status icons from database with header-specific inactive color
          run_status_icons = [:pending, :running, :success, :failed].map do |key|
            config = status_icons_by_key[key].dup
            config[:inactive_color] = 'text-gray-500'
            config[:count] = run_counts[key]
            config
          end

          # Used by run_status_badge_for to show the per-run status (e.g.
          # "Failed" vs "Stopped") inside the consolidated dropdown list.
          header_h_statuses = Status.all.index_by(&:id)
        %>
        <div class="flex items-stretch space-x-4 min-w-0"
             data-controller="header-run-status"
             data-header-run-status-project-id-value="<%= @project.id %>"
             data-header-run-status-publication-snapshot-value="<%= publication_snapshot_reader?(@project) %>">
            <div class="flex flex-col justify-center min-w-0">
            <h1 class="text-base sm:text-lg font-semibold text-white flex items-center gap-2 min-w-0">
              <span class="block truncate max-w-[10rem] sm:max-w-[14rem] md:max-w-xs lg:max-w-sm xl:max-w-md" title="<%= @project.display_name %>"><%= @project.display_name %></span>
              <% if @project.public? %>
                <span class="inline-flex items-center px-2 py-0.5 text-xs font-semibold tracking-wide text-emerald-200 bg-emerald-600/30 rounded-full border border-emerald-400/40"
                      title="Public project key">
                  ASAP<%= @project.public_id %>
                </span>
              <% end %>
              <%= link_to (@project.version ? version_path(@project.version) : versions_path), class: "inline-flex items-center px-2 py-0.5 text-xs font-semibold tracking-wide text-gray-100 bg-gray-700 rounded-full border border-gray-600 hover:bg-gray-600 transition-colors", title: "ASAP release" do %>
                v<%= version_label %>
              <% end %>
            </h1>
              <div class="flex items-center space-x-4 text-sm text-gray-300 min-w-0">
                <span class="flex items-center whitespace-nowrap" data-header-run-status-target="cellCount"><i class="fas fa-circle text-gray-400 mr-1 flex-shrink-0"></i><%= number_with_delimiter(@project.cell_count) %> <%= col_label(@project) %></span>
                <span class="flex items-center min-w-0"><i class="fas fa-dna text-gray-400 mr-1 flex-shrink-0"></i><span class="truncate"><%= formatted_organism_name(@project) %></span></span>
              </div>
            </div>
            <!-- Run Status Icons Section -->
            <div class="hidden xl:flex items-stretch border-l border-gray-700 pl-6 text-sm text-gray-300 overflow-visible">
              <div class="flex items-center gap-3 overflow-visible">
                  <% run_status_icons.each do |status_icon| %>
                    <% 
                      runs_list = runs_by_status[status_icon[:key]]
                      count = status_icon[:count]
                      is_active = count > 0
                      icon_class = status_icon[:icon_base]
                      icon_class += " #{status_icon[:icon_spin]}" if is_active && status_icon[:icon_spin].present?
                      color_class = is_active ? status_icon[:active_color] : status_icon[:inactive_color]
                      summary_label = run_summary_tooltip_label(status_icon[:key])
                    %>
                    <div class="relative overflow-visible" data-controller="nav-dropdown" data-status-key="<%= status_icon[:key] %>">
                      <button type="button"
                              class="flex flex-col items-center cursor-pointer hover:opacity-80 transition-opacity <%= is_active ? '' : 'cursor-default' %>"
                              data-nav-dropdown-toggle
                              data-header-run-status-target="statusButton"
                              data-status-key="<%= status_icon[:key] %>"
                              title="<%= summary_label %> (<%= count %>)"
                              <%= 'disabled' unless is_active %>>
                        <i class="<%= icon_class %> text-base <%= color_class %>"
                           data-header-run-status-target="statusIcon"
                           data-status-key="<%= status_icon[:key] %>"
                           data-icon-base="<%= status_icon[:icon_base] %>"
                           data-icon-spin="<%= status_icon[:icon_spin] %>"
                           data-active-color="<%= status_icon[:active_color] %>"
                           data-inactive-color="<%= status_icon[:inactive_color] %>"
                           data-ui-label="<%= summary_label %>"></i>
                        <span class="text-[9px] leading-tight text-gray-400 mt-0.5" data-header-run-status-target="statusCount" data-status-key="<%= status_icon[:key] %>"><%= count %></span>
                      </button>
                      <div class="hidden w-max max-h-96 flex flex-col bg-white text-gray-800 rounded-lg shadow-lg border border-gray-200 z-[9999]"
                           data-nav-menu
                           data-refresh-url="<%= run_list_project_path(@project, status: status_icon[:key]) %>">
                          <%= render partial: 'shared/run_status_dropdown_list',
                                     locals: {
                                       run_list: runs_list,
                                       count: count,
                                       summary_label: summary_label,
                                       header_h_statuses: header_h_statuses,
                                       header_h_annots: header_h_annots,
                                       header_h_ori_runs: header_h_ori_runs,
                                       header_h_steps: header_h_steps
                                     } %>
                        </div>
                    </div>
                  <% end %>
              </div>
            </div>
            <div class="hidden xl:flex items-stretch border-l border-gray-700 pl-6 text-sm text-gray-300">
              <div class="flex flex-col justify-center">
                <span class="text-xs text-gray-300"><%= project_status_label %></span>
                <div class="flex items-center gap-3 mt-1">
                  <% icon_map = {
                    'Edit' => 'fa-edit',
                    'Clone' => 'fa-clone',
                    'Analyze' => 'fa-chart-bar',
                    'Annotate/Comment' => 'fa-bookmark'
                  } %>
                  <% tooltip_label_map = {
                    'Analyze' => 'Analyze',
                    'Annotate/Comment' => 'Annotate/Comment',
                    'Clone' => 'Clone/Download',
                    'Edit' => 'Edit'
                  } %>
                  <% clone_allowed = clonable?(@project) %>
                  <% clone_solution_text = clone_allowed ? ' Another solution is to clone the project.' : '' %>
                  <% rights_summary.each do |label, allowed| %>
                    <% remediation_text = case label
                      when 'Analyze'
                        if @project.public?
                          "Sign in and ask the project owner for Analyze permission in project sharing settings.#{clone_solution_text}"
                        else
                          "Sign in and ask the project owner for Analyze permission in project sharing settings for this private project.#{clone_solution_text}"
                        end
                      when 'Annotate/Comment'
                        if !@project.single_cell?
                          "Annotation is available only for single-cell transcriptomics projects.#{clone_solution_text}"
                        elsif @project.public?
                          "Sign in and use an account linked to ORCID.#{clone_solution_text}"
                        else
                          "Sign in and use an account linked to ORCID, then ask the project owner for Analyze permission in project sharing settings for this private project.#{clone_solution_text}"
                        end
                      when 'Clone'
                        if @project.public?
                          "Sign in and, if access is still blocked, ask the project owner for Export permission in project sharing settings.#{clone_solution_text}"
                        else
                          "Sign in and ask the project owner for Export permission in project sharing settings for this private project.#{clone_solution_text}"
                        end
                      when 'Edit'
                        if @project.public?
                          "Sign in and ask the owner to make the change. Editing is limited to project owners.#{clone_solution_text}"
                        else
                          "Sign in and ask the owner to make the change. Editing this private project is limited to project owners.#{clone_solution_text}"
                        end
                      end %>
                    <% blocked_reasons = [] %>
                    <% unless allowed %>
                      <% blocked_reasons << 'Not signed in.' unless user_signed_in? %>
                      <% case label
                        when 'Analyze'
                          blocked_reasons << (@project.public? ? 'Analyze permission was not granted by the project owner.' : 'Project is private and Analyze permission was not granted by the project owner.')
                        when 'Annotate/Comment'
                          blocked_reasons << 'Annotation is available only for single-cell transcriptomics projects.' unless @project.single_cell?
                          blocked_reasons << 'ORCID ID missing in the user profile.' if @project.single_cell? && user_signed_in? && current_user&.orcid_user_id.blank?
                          blocked_reasons << 'Project is private and Analyze permission is required for annotation.' if @project.single_cell? && !@project.public? && !analyzable?(@project)
                        when 'Clone'
                          blocked_reasons << (@project.public? ? 'Clone/Download permission was not granted by the project owner.' : 'Project is private and Export permission was not granted by the project owner.')
                        when 'Edit'
                          blocked_reasons << 'Editing is restricted to project owners.'
                        end %>
                      <% blocked_reasons << 'Access constraints are not satisfied for this permission.' if blocked_reasons.empty? %>
                    <% end %>
                    <% granted_reasons = [] %>
                    <% if allowed %>
                      <% case label
                        when 'Analyze'
                          granted_reasons << (admin? ? 'Admin access.' : (@project.public? ? 'Project access is available with current sharing rights.' : 'Analyze permission is granted for this private project.'))
                        when 'Annotate/Comment'
                          granted_reasons << 'Project type is single-cell transcriptomics.'
                          granted_reasons << 'ORCID ID is linked in the user profile.' if user_signed_in? && current_user&.orcid_user_id.present?
                          granted_reasons << (@project.public? ? 'Project is public.' : 'Analyze permission is granted for this private project.')
                        when 'Clone'
                          granted_reasons << (@project.public? ? 'Project is public.' : 'Export permission is granted for this private project.')
                        when 'Edit'
                          granted_reasons << 'You are the project owner.'
                        end %>
                      <% granted_reasons << 'Access constraints are satisfied for this permission.' if granted_reasons.empty? %>
                    <% end %>
                    <div class="relative group flex items-center">
                      <i class="fas <%= icon_map[label] %> text-base <%= allowed ? 'text-emerald-300' : 'text-gray-400' %>"
                         title="<%= "#{tooltip_label_map[label]}: #{allowed ? 'Allowed' : 'Not allowed'}" %>"></i>
                      <div class="hidden group-hover:block absolute left-1/2 -translate-x-1/2 top-full mt-2 w-80 p-3 rounded-lg border <%= allowed ? 'border-emerald-300/60' : 'border-rose-300/60' %> bg-gray-900 text-gray-100 shadow-xl z-[10000]">
                        <p class="text-xs font-semibold <%= allowed ? 'text-emerald-200' : 'text-rose-200' %>"><%= tooltip_label_map[label] %> <%= allowed ? 'allowed' : 'not allowed' %></p>
                        <p class="mt-2 text-[11px] uppercase tracking-wide text-gray-400"><%= allowed ? 'Granted by' : 'Blocked by' %></p>
                        <div class="mt-1 space-y-1">
                          <% (allowed ? granted_reasons : blocked_reasons).each do |reason| %>
                            <p class="text-[11px] leading-4 <%= allowed ? 'text-emerald-100' : 'text-rose-100' %>"><%= reason %></p>
                          <% end %>
                        </div>
                        <% unless allowed %>
                          <p class="mt-2 text-[11px] leading-4 text-emerald-100"><%= remediation_text %></p>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
            <% if @sandbox_self_destruct_at.present? %>
              <% sandbox_idle_days = ENV.fetch('SANDBOX_DELETE_IDLE_DAYS', '1').to_i %>
              <% countdown = sandbox_self_destruct_countdown(@sandbox_self_destruct_at) %>
              <div class="hidden xl:flex items-stretch border-l border-gray-700 pl-6 text-sm text-gray-300">
                <div class="flex flex-col justify-center">
                  <span class="text-xs text-gray-300">Sandbox</span>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-amber-500/20 text-amber-200 border border-amber-400/40 text-xs mt-1 w-fit"
                        data-controller="countdown"
                        data-countdown-end-ms-value="<%= (@sandbox_self_destruct_at.to_f * 1000).to_i %>"
                        data-countdown-idle-days-value="<%= sandbox_idle_days %>"
                        data-countdown-lock-title-value="true"
                        title="Sandbox projects self-destroy after <%= sandbox_idle_days %> days of inactivity">
                    <i class="fas fa-bomb text-[11px]"></i>
                    <span class="font-mono tabular-nums" data-countdown-target="display"><%= countdown %></span>
                  </span>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      
      <!-- Center: ASAP Version -->
      <div class="flex-1 flex justify-center">
      </div>
      
      <!-- Right side: Navigation Icons -->
      <div class="flex items-stretch gap-1 shrink-0" data-guided-tour="project-view-nav">
      <!-- Hamburger Menu Button (Mobile) -->
      <div class="lg:hidden relative" data-controller="mobile-menu">
        <button type="button" 
                class="p-2 rounded-lg text-gray-300 hover:bg-gray-700 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-gray-600 transition"
                aria-expanded="false" 
                aria-label="Toggle navigation"
                data-mobile-menu-target="toggle"
                data-action="click->mobile-menu#toggle">
          <svg class="shrink-0 size-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
        
        <!-- Mobile Dropdown Menu -->
        <div class="hidden absolute right-0 mt-2 w-64 bg-white shadow-lg rounded-lg border border-gray-200 z-[10000] max-h-[80vh] overflow-y-auto"
             data-mobile-menu-target="menu">
          <div class="py-2">
            <!-- Summary -->
            <%= link_to project_path(@project, view: 'summary'), 
                class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{@view_type == 'summary' ? 'bg-gray-100 font-medium' : ''}",
                data: { guided_tour: "project-nav-summary" } do %>
              <i class="fas fa-info-circle text-lg mr-3"></i>
              Summary
            <% end %>
            
            <!-- Visualization -->
            <%= link_to project_path(@project, view: 'visualization'),
                class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{@view_type == 'visualization' ? 'bg-gray-100 font-medium' : ''}",
                data: { guided_tour: "project-nav-visualization" } do %>
              <span class="inline-flex text-lg mr-3 <%= has_visualization_embeddings ? 'text-emerald-500' : 'text-white' %>"><%= render 'shared/scatter_plot_icon' %></span>
              Visualization
            <% end %>

            <!-- Annotations -->
            <%= link_to project_path(@project, view: 'annotations'),
                class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{@view_type == 'annotations' ? 'bg-gray-100 font-medium' : ''}",
                data: { guided_tour: "project-nav-annotations" } do %>
              <i class="fas fa-bookmark text-lg mr-3 text-emerald-500"></i>
              Annotations
            <% end %>
            
            <!-- Analysis -->
              <%= link_to project_path(@project, view: 'analysis'),
                class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{@view_type == 'analysis' ? 'bg-gray-100 font-medium' : ''}",
                data: { guided_tour: "project-nav-analysis" } do %>
              <i class="fas fa-sitemap text-lg mr-3 text-emerald-500"></i>
              Analysis
            <% end %>
            
            <!-- Data -->
            <%= link_to project_path(@project, view: 'data'), 
                class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{@view_type == 'data' ? 'bg-gray-100 font-medium' : ''}",
                data: { guided_tour: "project-nav-data" } do %>
              <i class="fas fa-database text-lg mr-3 text-emerald-500"></i>
              Data
            <% end %>
            
            <!-- Settings -->
            <% if editable?(@project) %>
              <%= link_to project_path(@project, view: 'settings'), 
                  class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{@view_type == 'settings' ? 'bg-gray-100 font-medium' : ''}",
                  data: { guided_tour: "project-nav-settings" } do %>
                <i class="fas fa-cog text-lg mr-3 text-emerald-500"></i>
                Settings
              <% end %>
            <% end %>
            
            <!-- Compliance -->
            <% if editable?(@project) && @project.compliance_schemas.any? %>
              <%= link_to project_path(@project, view: 'compliance'), 
                  class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{@view_type == 'compliance' ? 'bg-gray-100 font-medium' : ''}",
                  data: { guided_tour: "project-nav-compliance", compliance_nav_hint_target: "navLink" } do %>
                <i class="fas fa-check-circle text-lg mr-3 text-emerald-500"></i>
                Compliance
              <% end %>
            <% end %>
            <% if admin? %>
              <%= link_to project_path(@project, view: 'access'),
                  class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{@view_type == 'access' ? 'bg-gray-100 font-medium' : ''}" do %>
                <i class="fas fa-chart-area text-lg mr-3 text-emerald-500"></i>
                Access analytics
              <% end %>
            <% end %>
            
            <% if clonable?(@project) %>
              <!-- Clone -->
              <%= button_to clone_project_path(@project), 
                  method: :post,
                  class: "flex items-center w-full px-4 py-2 text-sm text-gray-700 hover:bg-gray-100",
                  data: {
                    controller: "clone-overlay",
                    action: "click->clone-overlay#handleClick",
                    clone_overlay_confirm_value: "Clone project \"#{@project.name.presence || @project.key}\"?"
                  },
                  form: { data: { skip_visualization_leave_guard: "true" } } do %>
                <i class="fas fa-clone text-lg mr-3 text-emerald-500"></i>
                Clone
              <% end %>
            <% end %>
            
            <div class="border-t border-gray-200 my-1"></div>

            <a class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
               href="<%= news_items_path %>">
              <i class="fas fa-newspaper w-4 text-center"></i>
              News
            </a>
            
            <% if guided_tours_for_menu.any? %>
              <div class="px-4 py-2">
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1">Guided tours</p>
                <% guided_tours_for_menu.each do |tour| %>
                  <%= link_to tour.name,
                              guided_tour_start_url(tour.id),
                              class: "flex items-center gap-2 px-0 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg",
                              data: { guided_tour_start_id: tour.id } %>
                <% end %>
              </div>
              <div class="border-t border-gray-200 my-1"></div>
            <% end %>
            
            <!-- Info Section -->
            <div class="px-4 py-2">
              <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1">Info</p>
            </div>
            <% info_menu_links.each do |link| %>
              <a class="flex items-start gap-3 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
                 href="<%= link[:path] %>">
                <div class="flex-1">
                  <p class="font-medium"><%= link[:label] %></p>
                  <% if link[:description].present? %>
                    <p class="text-xs text-gray-500 mt-0.5"><%= link[:description] %></p>
                  <% end %>
                </div>
              </a>
            <% end %>
            
            <% if admin? %>
              <div class="border-t border-gray-200 my-1"></div>
              
              <!-- Admin Section -->
              <div class="px-4 py-2">
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1">Admin</p>
              </div>
              <% admin_menu_links.each do |link| %>
                <a class="flex items-start gap-3 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
                   href="<%= link[:path] %>">
                  <div class="flex-1">
                    <p class="font-medium"><%= link[:label] %></p>
                    <% if link[:description].present? %>
                      <p class="text-xs text-gray-500 mt-0.5"><%= link[:description] %></p>
                    <% end %>
                  </div>
                </a>
              <% end %>
            <% end %>
            
            <div class="border-t border-gray-200 my-1"></div>
            
            <%= render "shared/user_menu_mobile" %>
            
            <div class="border-t border-gray-200 my-1"></div>
            
            <!-- Feedback -->
            <div class="px-4 py-2">
              <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1">Feedback</p>
            </div>
            <% feedback_menu_links.each do |link| %>
              <a class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
                 href="<%= link[:path] %>"
                 <%= 'target="_blank" rel="noopener noreferrer"'.html_safe if link[:external] %>>
                <i class="<%= link[:icon] %> text-lg mr-3 text-orange-400"></i>
                <%= link[:label] %>
              </a>
            <% end %>

            <div class="border-t border-gray-200 my-1"></div>

            <!-- Back to Projects -->
            <%= link_to projects_browse_url, 
                class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" do %>
              <i class="fas fa-arrow-left text-lg mr-3"></i>
              Back to Projects
            <% end %>
          </div>
        </div>
      </div>
      <!-- End Hamburger Menu Button -->
      
      <!-- Desktop Menu Items -->
      <div class="hidden lg:flex items-stretch gap-1">
        <% nav_available_icon_class = 'text-emerald-300' %>
        <% nav_visualization_icon_class = has_visualization_embeddings ? 'text-emerald-300' : 'text-white' %>
        <%= link_to project_path(@project, view: 'summary'),
            class: "p-2 rounded-lg hover:bg-gray-700 #{nav_available_icon_class} #{@view_type == 'summary' ? 'bg-gray-700' : ''}", title: "Summary", data: { guided_tour: "project-nav-summary" } do %><i class="fas fa-info-circle text-lg"></i><% end %>
        <%= link_to project_path(@project, view: 'visualization'),
            class: "p-2 rounded-lg hover:bg-gray-700 #{nav_visualization_icon_class} #{@view_type == 'visualization' ? 'bg-gray-700' : ''}", title: "Visualization", data: { guided_tour: "project-nav-visualization" } do %><span class="inline-flex text-lg"><%= render 'shared/scatter_plot_icon' %></span><% end %>
        <%= link_to project_path(@project, view: 'annotations'),
            class: "p-2 rounded-lg hover:bg-gray-700 #{nav_available_icon_class} #{@view_type == 'annotations' ? 'bg-gray-700' : ''}", title: "Annotations", data: { guided_tour: "project-nav-annotations" } do %><i class="fas fa-bookmark text-lg"></i><% end %>
        <%= link_to project_path(@project, view: 'analysis'),
            class: "p-2 rounded-lg hover:bg-gray-700 #{nav_available_icon_class} #{@view_type == 'analysis' ? 'bg-gray-700' : ''}", title: "Analysis", data: { guided_tour: "project-nav-analysis" } do %><i class="fas fa-sitemap text-lg"></i><% end %>
        <%= link_to project_path(@project, view: 'data'),
            class: "p-2 rounded-lg hover:bg-gray-700 #{nav_available_icon_class} #{@view_type == 'data' ? 'bg-gray-700' : ''}", title: "Data", data: { guided_tour: "project-nav-data" } do %><i class="fas fa-database text-lg"></i><% end %>
        <% if editable?(@project) %>
          <%= link_to project_path(@project, view: 'settings'),
              class: "p-2 rounded-lg hover:bg-gray-700 #{nav_available_icon_class} #{@view_type == 'settings' ? 'bg-gray-700' : ''}", title: "Settings", data: { guided_tour: "project-nav-settings" } do %><i class="fas fa-cog text-lg"></i><% end %>
        <% end %>
        <% if editable?(@project) && @project.compliance_schemas.any? %>
          <%= link_to project_path(@project, view: 'compliance'),
              class: "p-2 rounded-lg hover:bg-gray-700 #{nav_available_icon_class} #{@view_type == 'compliance' ? 'bg-gray-700' : ''}", title: "Compliance", data: { guided_tour: "project-nav-compliance", compliance_nav_hint_target: "navLink" }, id: "project-nav-compliance" do %><i class="fas fa-check-circle text-lg"></i><% end %>
        <% end %>
        <% if admin? %>
          <%= link_to project_path(@project, view: 'access'),
              class: "p-2 rounded-lg hover:bg-gray-700 #{nav_available_icon_class} #{@view_type == 'access' ? 'bg-gray-700' : ''}", title: "Access analytics" do %><i class="fas fa-chart-area text-lg"></i><% end %>
        <% end %>
        <% if clonable?(@project) %>
          <%= button_to clone_project_path(@project),
              method: :post,
              class: "p-2 rounded-lg #{nav_available_icon_class} hover:bg-gray-700",
              title: "Clone Project",
              data: {
                controller: "clone-overlay",
                action: "click->clone-overlay#handleClick",
                clone_overlay_confirm_value: "Clone project \"#{@project.name.presence || @project.key}\"?"
              },
              form: { data: { skip_visualization_leave_guard: "true" } } do %><i class="fas fa-clone text-lg"></i><% end %>
        <% end %>
        
        <%= header_separator %>

        <%= link_to news_items_path,
            class: "p-2 rounded-lg text-gray-300 hover:bg-gray-700",
            title: "News" do %>
          <i class="fas fa-newspaper text-lg"></i>
        <% end %>
        
        <!-- Info Dropdown -->
        <div class="relative"
             id="info-nav-dropdown"
             data-controller="nav-dropdown">
          <button type="button"
                  class="p-2 rounded-lg text-gray-300 hover:bg-gray-700 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-gray-600 transition"
                  title="Info"
                  data-nav-dropdown-toggle>
            <i class="fas fa-file-alt text-lg"></i>
          </button>
          <%= render "shared/info_menu",
                      wrapper_classes: "hidden absolute right-0 mt-2 w-56 bg-white text-gray-800 rounded-lg shadow-lg border border-gray-200 z-50",
                      data_attributes: { nav_menu: true } %>
        </div>
        
      <% if admin? %>
        <div class="relative"
             id="admin-tools-dropdown"
             data-controller="nav-dropdown">
          <button id="admin-tools-button"
                  class="p-2 rounded-lg text-gray-300 hover:bg-gray-700 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-gray-600 transition"
                  title="Admin"
                  data-nav-dropdown-toggle>
            <i class="fas fa-tools text-lg"></i>
          </button>
          <%= render "shared/admin_menu",
                      wrapper_classes: "hidden absolute right-0 mt-2 w-56 bg-white text-gray-800 rounded-lg shadow-lg border border-gray-200 z-50",
                      data_attributes: { nav_menu: true } %>
        </div>
        <% end %>
        
        <!-- Feedback Dropdown -->
        <div class="relative"
             data-controller="nav-dropdown">
          <button type="button"
                  class="p-2 rounded-lg hover:bg-gray-700 focus:outline-hidden transition"
                  title="Feedback"
                  data-nav-dropdown-toggle>
            <i class="fas fa-comment text-lg text-orange-400"></i>
          </button>
          <%= render "shared/feedback_menu",
                      wrapper_classes: "hidden absolute right-0 mt-2 w-64 bg-white text-gray-800 rounded-lg shadow-lg border border-gray-200 z-50",
                      data_attributes: { nav_menu: true } %>
        </div>

        <%= render "shared/user_menu", wrapper_classes: "relative ml-4" %>

        <!-- Back to Projects -->
        <%= link_to projects_browse_url, 
            class: "p-2 rounded-lg text-gray-300 hover:bg-gray-700",
            title: "Back to Projects" do %>
          <i class="fas fa-arrow-left text-lg"></i>
        <% end %>
      </div>
      <!-- End Desktop Menu Items -->
      </div>
    </div>
  </div>
</div>

