<% completed_runs = @runs&.select { |r| r.status_id == 3 } || [] %>
<% unless @h_std_methods %>
  <% asap_docker_image = Basic.get_asap_docker(@project.version) %>
  <% @h_std_methods = {} %>
  <% StdMethod.where(docker_image_id: asap_docker_image.id).each { |s| @h_std_methods[s.id] = s } if asap_docker_image %>
<% end %>
<% catalog = de_viz_results_catalog(runs: completed_runs, h_stats: @h_stats || {}, h_std_methods: @h_std_methods) %>

<% if catalog.empty? %>
  <div style="color: #9ca3af; font-size: 13px; text-align: center; padding: 24px 0;">No completed DE runs found.</div>
<% else %>
  <div id="de-viz-results-browser"
       data-catalog="<%= ERB::Util.html_escape(catalog.to_json) %>">
    <div style="display: flex; justify-content: flex-end; margin-bottom: 8px;">
      <button type="button"
              onclick="if (window.visualizationController) window.visualizationController.resetDeVizCatalogSelectors()"
              style="padding: 4px 10px; font-size: 12px; font-weight: 500; color: #374151; background: #fff; border: 1px solid #d1d5db; border-radius: 6px; cursor: pointer;">
        Reset filters to All
      </button>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px;">
      <div>
        <label for="de-viz-sel-reference" style="display: block; font-size: 12px; color: #6b7280; margin-bottom: 4px;">Reference group</label>
        <select id="de-viz-sel-reference"
                onchange="if (window.visualizationController) window.visualizationController.onDeVizCatalogSelectorChanged('reference')"
                style="width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px;"></select>
      </div>
      <div>
        <label for="de-viz-sel-compared" style="display: block; font-size: 12px; color: #6b7280; margin-bottom: 4px;">Compared group</label>
        <select id="de-viz-sel-compared"
                onchange="if (window.visualizationController) window.visualizationController.onDeVizCatalogSelectorChanged('compared')"
                style="width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px;"></select>
      </div>
    </div>

    <div style="margin-bottom: 10px;">
      <label for="de-viz-sel-method" style="display: block; font-size: 12px; color: #6b7280; margin-bottom: 4px;">Method</label>
      <select id="de-viz-sel-method"
              onchange="if (window.visualizationController) window.visualizationController.onDeVizCatalogSelectorChanged('method')"
              style="width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px;"></select>
    </div>

    <div style="margin-bottom: 12px;">
      <label for="de-viz-sel-params" style="display: block; font-size: 12px; color: #6b7280; margin-bottom: 4px;">Parameters (including cell universe)</label>
      <select id="de-viz-sel-params"
              onchange="if (window.visualizationController) window.visualizationController.onDeVizCatalogSelectorChanged('params')"
              style="width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px;"></select>
    </div>

    <div id="de-viz-selected-result"
         style="border: 1px solid #e5e7eb; border-radius: 8px; background: #f9fafb; padding: 12px;">
      <div style="font-size: 12px; color: #6b7280;">Select a DE contrast above to view results.</div>
    </div>
  </div>
<% end %>
