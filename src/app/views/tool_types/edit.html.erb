<div class="max-w-4xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-gray-900">Editing Tool Type</h1>
    <div class="flex items-center gap-2">
      <%= link_to 'Show', @tool_type, class: 'inline-flex items-center px-3 py-2 rounded-md border border-gray-200 text-sm text-gray-700 hover:bg-gray-50' %>
      <%= link_to 'Back to list', tool_types_path, class: 'inline-flex items-center px-3 py-2 rounded-md border border-gray-200 text-sm text-gray-700 hover:bg-gray-50' %>
    </div>
  </div>

  <%= render 'form', tool_type: @tool_type %>
</div>

